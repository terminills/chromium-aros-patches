diff --git a/BUILD.gn b/BUILD.gn
index d07704e..bece259 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1439,6 +1439,14 @@ config("toolchain") {
   if (target_os == "aros") {
     defines += [ "V8_HAVE_TARGET_OS" ]
     defines += [ "V8_TARGET_OS_AROS" ]
+    if (v8_monolithic && current_toolchain != host_toolchain) {
+      # libv8_monolith.a becomes the resident v8.library, whose writable
+      # image is shared by every process, so the current platform must live
+      # in per-process task storage (provided by the library's engine glue).
+      # An in-process V8 keeps the ordinary static -- and so do the host
+      # mksnapshot/torque binaries, which link no engine glue.
+      defines += [ "V8_AROS_RESIDENT_PLATFORM" ]
+    }
   } else if (target_os == "android") {
     defines += [ "V8_HAVE_TARGET_OS" ]
     defines += [ "V8_TARGET_OS_ANDROID" ]
