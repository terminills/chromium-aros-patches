From c3523a8917ed2b31e4cc27cf111eeb8d4635c2fe Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 13:17:17 -0500
Subject: [PATCH 01/43] cef: omit unsupported AROS crash handler

Keep the first AROS CEF library boundary independent of Crashpad's unported exception-handler server while preserving Crashpad client and minidump dependencies used by the framework.

AI_PHASE: chromium-aros-cef

AI_STATUS: compile-boundary-advanced

AI_ASSUMPTION: AROS crash reporting remains disabled until it has a native exception capture backend

AI_VALIDATION: CEF graph regenerated from 40780 to 33450 edges and compiled past every prior Crashpad failure to the libcef_dll_wrapper platform boundary

AI_LIMITATIONS: CEF has not linked; embedded crash-handler process requests return -1 on AROS

AI_DECISION_CHAIN:
---
 BUILD.gn                      | 5 ++++-
 libcef/browser/main_runner.cc | 7 +++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/BUILD.gn b/BUILD.gn
index d80fb667..397a45c6 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1057,7 +1057,6 @@ source_set("libcef_static") {
     "//third_party/blink/public:blink",
     "//third_party/brotli:dec",
     "//third_party/cld_3/src/src:cld_3",
-    "//third_party/crashpad/crashpad/handler",
     "//third_party/hunspell",
     "//third_party/leveldatabase",
     "//third_party/libxml:libxml",
@@ -1082,6 +1081,10 @@ source_set("libcef_static") {
     "//v8",
   ]
 
+  if (!is_aros) {
+    deps += [ "//third_party/crashpad/crashpad/handler" ]
+  }
+
   if (is_win) {
     sources += includes_win + [
       "libcef/browser/alloy/alloy_browser_main_win.cc",
diff --git a/libcef/browser/main_runner.cc b/libcef/browser/main_runner.cc
index 26ab9b84..4523eef6 100644
--- a/libcef/browser/main_runner.cc
+++ b/libcef/browser/main_runner.cc
@@ -29,7 +29,9 @@
 #include "content/public/app/content_main_runner.h"
 #include "content/public/browser/render_process_host.h"
 #include "content/public/common/content_switches.h"
+#if !BUILDFLAG(IS_AROS)
 #include "third_party/crashpad/crashpad/handler/handler_main.h"
+#endif
 
 #if BUILDFLAG(IS_WIN)
 #include <Objbase.h>
@@ -74,6 +76,10 @@ std::unique_ptr<CefMainRunnerDelegate> MakeDelegate(
 // platforms so we define the function here instead of using the existing
 // target (because we can't use that target on macOS).
 int RunAsCrashpadHandler(const base::CommandLine& command_line) {
+#if BUILDFLAG(IS_AROS)
+  LOG(ERROR) << "The embedded Crashpad handler is not available on AROS";
+  return -1;
+#else
   base::CommandLine::StringVector argv = command_line.argv();
   const base::CommandLine::StringType process_type =
       FILE_PATH_LITERAL("--type=");
@@ -107,6 +113,7 @@ int RunAsCrashpadHandler(const base::CommandLine& command_line) {
   argv.clear();
   return crashpad::HandlerMain(static_cast<int>(storage.size()),
                                argv_as_utf8.get(), nullptr);
+#endif
 }
 
 }  // namespace
