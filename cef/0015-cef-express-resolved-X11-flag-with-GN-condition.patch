From f87802704fc515e93a04e81dcea70b876e2a048e Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 16:46:54 -0500
Subject: [PATCH 15/43] cef: express resolved X11 flag with GN condition

Replace the unsupported C-style ternary with GN if/else while preserving the resolved boolean passed to the config generator.

AI_PHASE: chromium-cef-bootstrap

AI_STATUS: gn-syntax-corrected-after-preserved-failure

AI_VALIDATION: build 22 rejected the ternary at BUILD.gn:1494 before compilation

AI_EVIDENCE: ../test-artifacts/-cef-bootstrap-20260724/22-libcef-static-after-resolved-x11-config.log

AI_DECISION_CHAIN:; 41f982c7
---
 BUILD.gn | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/BUILD.gn b/BUILD.gn
index 82fd9bb5..8480fa4a 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -1491,7 +1491,11 @@ action("make_config_header") {
   outputs = [ "$root_out_dir/includes/include/cef_config.h" ]
 
   args = rebase_path(outputs + [ "$root_out_dir/args.gn" ], root_build_dir)
-  args += [ ozone_platform_x11 ? "true" : "false" ]
+  if (ozone_platform_x11) {
+    args += [ "true" ]
+  } else {
+    args += [ "false" ]
+  }
 }
 
 # Generate pack files and associated CEF header files.
