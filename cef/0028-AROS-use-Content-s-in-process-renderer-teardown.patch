From c7a8da5940b4904dd70c2e5f3cf830eb5e452944 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 25 Jul 2026 18:24:24 -0500
Subject: [PATCH 28/43] AROS: use Content's in-process renderer teardown

AI_PHASE: cef-osr-browser

AI_STATUS: corrected-shutdown-contract-under-validation

ROOT_CAUSE: Clearing run_renderer_in_process before generic Cleanup fixed observer deletion ordering but made Content take its multiprocess path, where GetChildTerminationInfo requires a ChildProcessLauncher that single-process AROS intentionally never creates.

FIX_REASON: Use RenderProcessHost::ShutDownInProcessRenderer while the single-process flag remains set; Content then emits InProcessRendererExiting and RenderProcessHostDestroyed before deleting the host, after which CEF clears the flag.

SCOPE: libcef/renderer/alloy/alloy_content_renderer_client.cc; AROS-only behavior, upstream non-AROS cleanup restored

VALIDATION: coherent prior archive and native library rendered centered 960x540 content and closed the browser, then isolated the new child_process_launcher_ fatal at render_process_host_impl.cc:4873; rebuild and clean-shutdown replay pending.

RISK: Assumes Content's dedicated in-process teardown destroys the renderer thread and triggers CEF WillDestroyCurrentMessageLoop, matching its documented contract.

AI_DECISION_CHAIN:; 20e45d86 observer-order hypothesis; visual PASS; launcher fatal; existing Content in-process teardown API discovered

Evidence:-cef-shutdown-order-runtime-20260725

Job:
---
 .../alloy/alloy_content_renderer_client.cc    | 30 +++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/libcef/renderer/alloy/alloy_content_renderer_client.cc b/libcef/renderer/alloy/alloy_content_renderer_client.cc
index 5853d66d..afccb95f 100644
--- a/libcef/renderer/alloy/alloy_content_renderer_client.cc
+++ b/libcef/renderer/alloy/alloy_content_renderer_client.cc
@@ -569,21 +569,34 @@ void AlloyContentRendererClient::RunSingleProcessCleanupOnUIThread() {
 
   // Clean up the single existing RenderProcessHost.
   content::RenderProcessHost* host = nullptr;
+#if BUILDFLAG(IS_AROS)
+  bool destroyed_host = false;
+#endif
   content::RenderProcessHost::iterator iterator(
       content::RenderProcessHost::AllHostsIterator());
   if (!iterator.IsAtEnd()) {
     host = iterator.GetCurrentValue();
+#if BUILDFLAG(IS_AROS)
+    iterator.Advance();
+    DCHECK(iterator.IsAtEnd());
 
-    // RenderProcessHostImpl::Cleanup() deliberately returns without observer
-    // teardown while the in-process renderer flag is set. Clear the flag
-    // first so Cleanup() reaches RenderProcessHostDestroyed notifications
-    // before the host and its AgentSchedulingGroupHost are deleted.
-    content::RenderProcessHost::SetRunRendererInProcess(false);
+    // Keep the single-process flag set while Content performs its dedicated
+    // in-process teardown. This notifies observers before deleting the host
+    // without querying the nonexistent ChildProcessLauncher.
+    content::RenderProcessHost::ShutDownInProcessRenderer();
+    host = nullptr;
+    destroyed_host = true;
+#else
     host->Cleanup();
     iterator.Advance();
     DCHECK(iterator.IsAtEnd());
+#endif
   }
+#if BUILDFLAG(IS_AROS)
+  DCHECK(destroyed_host);
+#else
   DCHECK(host);
+#endif
 
   // Deletion of the RenderProcessHost object will stop the render thread and
   // result in a call to WillDestroyCurrentMessageLoop.
@@ -591,9 +604,16 @@ void AlloyContentRendererClient::RunSingleProcessCleanupOnUIThread() {
   // this task will only execute when running in multi-threaded message loop
   // mode (because otherwise the UI message loop has already stopped). Therefore
   // we need to explicitly delete the object when not running in this mode.
+#if BUILDFLAG(IS_AROS)
+  content::RenderProcessHost::SetRunRendererInProcess(false);
+#else
+  // Clear the run_renderer_in_process() flag to avoid a DCHECK in the
+  // RenderProcessHost destructor.
+  content::RenderProcessHost::SetRunRendererInProcess(false);
   if (!CefContext::Get()->settings().multi_threaded_message_loop) {
     delete host;
   }
+#endif
 }
 
