From 819050844abb986e776495e9a275aa842d80d01e Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 11 Jul 2026 08:00:11 -0500
Subject: [PATCH 05/28] base: describe AROS allocator capabilities precisely

AI_PHASE: chromium-headless-phase-3

AI_STATUS: complete

ROOT_CAUSE: V8 treated every non-Darwin POSIX target as if it provided glibc malloc.h and malloc_usable_size, neither of which exists on AROS.

FIX_REASON: Keep standard malloc and posix_memalign through cstdlib, omit the unavailable malloc header, and make AllocateAtLeast conservatively report the requested size on AROS.

SCOPE: src/base/platform/memory.h

VALIDATION: AROS target compiler probe for cstdlib posix_memalign; ninja -C out/aros-headless -j4 obj/v8/v8_heap_base/worklist.o

RISK: low; AROS loses only optional allocator-size introspection and retains the existing aligned allocation/free path.

AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
---
 src/base/platform/memory.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/base/platform/memory.h b/src/base/platform/memory.h
index 77e3fe9..5d8b538 100644
--- a/src/base/platform/memory.h
+++ b/src/base/platform/memory.h
@@ -19,13 +19,13 @@
 
 #if V8_OS_DARWIN
 #include <malloc/malloc.h>
-#else  // !V8_OS_DARWIN
+#elif !V8_OS_AROS
 #include <malloc.h>
-#endif  // !V8_OS_DARWIN
+#endif
 
-#if (V8_OS_POSIX && !V8_OS_AIX && !V8_OS_SOLARIS) || V8_OS_WIN
+#if (V8_OS_POSIX && !V8_OS_AIX && !V8_OS_AROS && !V8_OS_SOLARIS) || V8_OS_WIN
 #define V8_HAS_MALLOC_USABLE_SIZE 1
-#endif  // (V8_OS_POSIX && !V8_OS_AIX && !V8_OS_SOLARIS) || V8_OS_WIN
+#endif
 
 namespace v8::base {
 
