     switch (flag->type()) {
@@ -681,6 +702,12 @@ int FlagList::SetFlagsFromCommandLine(int* argc, char** argv, bool remove_flags,
         break;
     }
 
+#if V8_OS_AROS
+    if (aros_refused_changes.load() != aros_refused) {
+      __aros_v8_flag_refused(arg);
+    }
+#endif
+
     // Handle errors.
     bool is_bool_type = flag->type() == Flag::TYPE_BOOL ||
                         flag->type() == Flag::TYPE_MAYBE_BOOL;
@@ -994,6 +1021,11 @@ uint32_t FlagList::Hash() {
   return hash;
 }
 
+#if V8_OS_AROS
+// static
+void FlagList::NoteRefusedChange() { aros_refused_changes.fetch_add(1); }
+#endif
+
 // static
 void FlagList::ResetFlagHash() {
   // If flags are frozen, we should not need to reset the hash since we cannot
diff --git a/src/flags/flags.h b/src/flags/flags.h
index f1b0d1b..45a4414 100644
--- a/src/flags/flags.h
+++ b/src/flags/flags.h
@@ -144,6 +144,12 @@ class V8_EXPORT_PRIVATE FlagList {
   // This hash is calculated during V8::Initialize and cached.
   static uint32_t Hash();
 
+#if V8_OS_AROS
+  // AROS runs one resident V8 for every program and cannot write-protect
+  // v8_flags, so a frozen flag refuses a new value instead of being trapped.
+  static void NoteRefusedChange();
+#endif
+
  private:
   // Reset the flag hash on flag changes. This is a private method called from
   // {FlagValue<T>::operator=}; there should be no need to call it from any
@@ -158,6 +164,12 @@ class V8_EXPORT_PRIVATE FlagList {
 template <typename T>
 FlagValue<T>& FlagValue<T>::operator=(T new_value) {
   if (new_value != value_) {
+#if V8_OS_AROS
+    if (FlagList::IsFrozen()) {
+      FlagList::NoteRefusedChange();
+      return *this;
+    }
+#endif
     FlagList::ResetFlagHash();
     value_ = new_value;
   }
