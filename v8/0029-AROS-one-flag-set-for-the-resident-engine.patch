 src/flags/flags.cc           | 32 ++++++++++++++++++++++++++++++++
 src/flags/flags.h            | 12 ++++++++++++
 src/heap/mark-compact.cc     |  5 +++++
 src/heap/scavenger.cc        |  5 +++++
 5 files changed, 59 insertions(+)

