+++ b/src/heap/mark-compact.cc
@@ -211,7 +211,12 @@ class FullMarkingVerifier : public MarkingVerifierBase {
 namespace {
 
 int NumberOfAvailableCores() {
+#if V8_OS_AROS
+  // One resident engine serves programs with different platforms.
+  int num_cores = V8::GetCurrentPlatform()->NumberOfWorkerThreads() + 1;
+#else
   static int num_cores = V8::GetCurrentPlatform()->NumberOfWorkerThreads() + 1;
+#endif
   // This number of cores should be greater than zero and never change.
   DCHECK_GE(num_cores, 1);
   DCHECK_EQ(num_cores, V8::GetCurrentPlatform()->NumberOfWorkerThreads() + 1);
