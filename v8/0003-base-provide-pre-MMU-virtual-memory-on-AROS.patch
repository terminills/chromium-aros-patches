 namespace {
 
+#if V8_OS_AROS
+struct ArosMapping {
+  ArosMapping* next;
+  void* raw;
+  size_t raw_size;
+  uintptr_t mapping_start;
+  size_t mapping_size;
+  uintptr_t live_start;
+  uintptr_t live_end;
+  int fd;
+  off_t offset;
+  bool write_back;
+};
+
+ArosMapping* g_aros_mappings = nullptr;
+volatile unsigned char g_aros_mappings_lock = 0;
+
+void LockArosMappings() {
+  while (__atomic_test_and_set(&g_aros_mappings_lock, __ATOMIC_ACQUIRE)) {
+    __asm__ __volatile__("pause");
+  }
+}
+
+void UnlockArosMappings() {
+  __atomic_clear(&g_aros_mappings_lock, __ATOMIC_RELEASE);
+}
+
+bool TransferArosFile(int fd, off_t offset, void* data, size_t size,
+                      bool write_back) {
+  LockArosMappings();
+  off_t previous = ::lseek(fd, 0, SEEK_CUR);
+  bool ok = previous != static_cast<off_t>(-1) &&
+            ::lseek(fd, offset, SEEK_SET) != static_cast<off_t>(-1);
+  size_t transferred = 0;
+  while (ok && transferred < size) {
+    char* cursor = static_cast<char*>(data) + transferred;
+    ssize_t result = write_back ? ::write(fd, cursor, size - transferred)
+                                : ::read(fd, cursor, size - transferred);
+    if (result > 0) {
+      transferred += static_cast<size_t>(result);
+    } else if (!write_back && result == 0) {
+      memset(cursor, 0, size - transferred);
+      transferred = size;
+    } else if (result < 0 && errno == EINTR) {
+      continue;
+    } else {
+      ok = false;
+    }
+  }
+  if (previous != static_cast<off_t>(-1) &&
+      ::lseek(fd, previous, SEEK_SET) == static_cast<off_t>(-1)) {
+    ok = false;
+  }
+  UnlockArosMappings();
+  return ok;
+}
+
+void* ArosMmap(void* address, size_t size, int prot, int flags, int fd,
+               off_t offset) {
+  if (size == 0) {
+    errno = EINVAL;
+    return MAP_FAILED;
+  }
+
+  if (flags & MAP_FIXED) {
+    if (address == nullptr || address == MAP_FAILED) {
+      errno = EINVAL;
+      return MAP_FAILED;
+    }
+    if (fd >= 0) {
+      if (!TransferArosFile(fd, offset, address, size, false)) {
+        return MAP_FAILED;
+      }
+    } else {
+      memset(address, 0, size);
+    }
+    return address;
+  }
+
+  constexpr size_t kPageSize = 4096;
+  if (size > SIZE_MAX - (kPageSize - 1)) {
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
+  size_t raw_size = size + kPageSize - 1;
+  void* raw = AllocMem(raw_size, MEMF_PUBLIC | MEMF_CLEAR);
+  if (!raw) {
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
+  uintptr_t mapping_start =
+      (reinterpret_cast<uintptr_t>(raw) + kPageSize - 1) &
+      ~(static_cast<uintptr_t>(kPageSize) - 1);
+
+  if (fd >= 0 &&
+      !TransferArosFile(fd, offset, reinterpret_cast<void*>(mapping_start),
+                        size, false)) {
+    FreeMem(raw, raw_size);
+    return MAP_FAILED;
+  }
+
+  auto* mapping = static_cast<ArosMapping*>(
+      AllocMem(sizeof(ArosMapping), MEMF_PUBLIC | MEMF_CLEAR));
+  if (!mapping) {
+    FreeMem(raw, raw_size);
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
+  mapping->raw = raw;
+  mapping->raw_size = raw_size;
+  mapping->mapping_start = mapping_start;
+  mapping->mapping_size = size;
+  mapping->live_start = mapping_start;
+  mapping->live_end = mapping_start + size;
+  mapping->fd = fd;
+  mapping->offset = offset;
+  mapping->write_back =
+      fd >= 0 && (flags & MAP_SHARED) != 0 && (prot & PROT_WRITE) != 0;
+
+  LockArosMappings();
+  mapping->next = g_aros_mappings;
+  g_aros_mappings = mapping;
+  UnlockArosMappings();
+  return reinterpret_cast<void*>(mapping_start);
+}
+
+int ArosMunmap(void* address, size_t size) {
+  if (!address || address == MAP_FAILED || size == 0) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  uintptr_t start = reinterpret_cast<uintptr_t>(address);
+  uintptr_t end = start + size;
+  if (end < start) end = UINTPTR_MAX;
+
+  LockArosMappings();
+  ArosMapping** link = &g_aros_mappings;
+  while (*link) {
+    ArosMapping* mapping = *link;
+    if (start >= mapping->live_start && start < mapping->live_end) {
+      if (start == mapping->live_start) {
+        mapping->live_start = end < mapping->live_end ? end : mapping->live_end;
+      } else if (end >= mapping->live_end) {
+        mapping->live_end = start;
+      } else {
+        UnlockArosMappings();
+        return 0;
+      }
+
+      if (mapping->live_start < mapping->live_end) {
+        UnlockArosMappings();
+        return 0;
+      }
+
+      *link = mapping->next;
+      UnlockArosMappings();
+      if (mapping->write_back) {
+        TransferArosFile(mapping->fd, mapping->offset,
+                         reinterpret_cast<void*>(mapping->mapping_start),
+                         mapping->mapping_size, true);
+      }
+      FreeMem(mapping->raw, mapping->raw_size);
+      FreeMem(mapping, sizeof(ArosMapping));
+      return 0;
+    }
+    link = &mapping->next;
+  }
+  UnlockArosMappings();
+  return 0;
+}
+
+int ArosMprotect(void* address, size_t size, int prot) {
+  USE(address);
+  USE(size);
+  USE(prot);
+  return 0;
+}
+
+int ArosMadvise(void* address, size_t size, int advice) {
+  if (advice == MADV_DONTNEED || advice == MADV_FREE) {
+    memset(address, 0, size);
+  }
+  return 0;
+}
+
+#define mmap ArosMmap
+#define munmap ArosMunmap
+#define mprotect ArosMprotect
+#define madvise ArosMadvise
+#endif
+
 // 0 is never a valid thread id.
 const pthread_t kNoThread = static_cast<pthread_t>(0);
 
