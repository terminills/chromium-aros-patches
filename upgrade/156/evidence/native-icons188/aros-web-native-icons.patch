From 24b0ddc5fae0eb7bbe518410034ce21fbaadcec4 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 19 Nov 2026 13:43:49 -0600
Subject: [PATCH] Fix native icon launch defaults and drawer layout

---
 tools/Chromium/README.md                     | 12 ++++++++++++
 tools/Chromium/StartChromium                 | 17 +++++++++++++----
 tools/Chromium/build-icons.py                | 17 +++++++++++++++++
 tools/Chromium/icons/ChromiumDrawer.info.src |  3 +++
 4 files changed, 45 insertions(+), 4 deletions(-)
 create mode 100644 tools/Chromium/build-icons.py

diff --git a/tools/Chromium/README.md b/tools/Chromium/README.md
index 72e958f..84bb1b9 100644
--- a/tools/Chromium/README.md
+++ b/tools/Chromium/README.md
@@ -16,6 +16,18 @@ its native PROJECT icon uses `C:IconX`. The containing drawer also needs its
 own DRAWER icon. The native executable has a TOOL icon when exposed directly.
 Both the script and icon specify a 1 MiB stack.
 
+Generate the three native icon files using the matching AROS build's host
+converter:
+
+```
+python3 build-icons.py --ilbmtoicon /path/to/aros-build/bin/linux-x86_64/tools/ilbmtoicon --output /path/to/package-icons
+```
+
+Use `Start Chromium.info` beside the installed launcher script (renamed to
+`Chromium.info`), `ChromiumDrawer.info` beside its containing drawer (also
+renamed to `Chromium.info`), and the generated TOOL `Chromium.info` beside
+the executable. The drawer opens tall enough to display the icon and label.
+
 The script starts the shared host if its ready port is absent, waits for
 readiness, then opens Chromium. The host keeps running when the last window
 closes so another application can reuse the same engine. Host registration
diff --git a/tools/Chromium/StartChromium b/tools/Chromium/StartChromium
index e1feefa..847ecd9 100644
--- a/tools/Chromium/StartChromium
+++ b/tools/Chromium/StartChromium
@@ -1,6 +1,4 @@
 .KEY URL,PROFILE
-.DEF URL "chrome://newtab/"
-.DEF PROFILE "default"
 .BRA {
 .KET }
 FailAt 21
@@ -18,5 +16,16 @@ If WARN
     Echo "Chromium: the shared engine did not become ready. Check its installation and profile drawer."
     Quit 20
 EndIf
-SYS:System/Chromium "{URL}" "{PROFILE}"
-
+If "{URL}" EQ ""
+    If "{PROFILE}" EQ ""
+        SYS:System/Chromium
+    Else
+        SYS:System/Chromium chrome://newtab/ "{PROFILE}"
+    EndIf
+Else
+    If "{PROFILE}" EQ ""
+        SYS:System/Chromium "{URL}"
+    Else
+        SYS:System/Chromium "{URL}" "{PROFILE}"
+    EndIf
+EndIf
diff --git a/tools/Chromium/build-icons.py b/tools/Chromium/build-icons.py
new file mode 100644
index 0000000..94f7b56
--- /dev/null
+++ b/tools/Chromium/build-icons.py
@@ -0,0 +1,17 @@
+#!/usr/bin/env python3
+"""Generate native .info files with the matching AROS host ilbmtoicon tool."""
+import argparse
+from pathlib import Path
+import subprocess
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--ilbmtoicon', required=True, type=Path)
+parser.add_argument('--output', required=True, type=Path)
+args = parser.parse_args()
+source = Path(__file__).resolve().parent / 'icons'
+args.output.mkdir(parents=True, exist_ok=True)
+for name in ['Chromium', 'Start Chromium', 'ChromiumDrawer']:
+    subprocess.run([str(args.ilbmtoicon.resolve()),
+                    str(source / (name + '.info.src')),
+                    str(source / 'Chromium.png'),
+                    str(args.output / (name + '.info'))], check=True)
diff --git a/tools/Chromium/icons/ChromiumDrawer.info.src b/tools/Chromium/icons/ChromiumDrawer.info.src
index 045d67c..720a010 100644
--- a/tools/Chromium/icons/ChromiumDrawer.info.src
+++ b/tools/Chromium/icons/ChromiumDrawer.info.src
@@ -1 +1,4 @@
 TYPE = DRAWER
+DRAWERWIDTH = 440
+DRAWERHEIGHT = 250
+DRAWERSHOW = ICONS
-- 
