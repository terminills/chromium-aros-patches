From 6499b2e26854c3b55f2109daabca8ef9135deb20 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 19 Nov 2026 15:14:57 -0600
Subject: [PATCH] Allow CEFHost resources in the installed System directory

Add --resources-dir with native directory validation and canonicalization,
and derive the locale directory from it. The Chromium launcher uses
SYS:System/CEF so installed users do not need a Developer assign.
Direct diagnostic invocations retain the Developer:CEF default.

Both architectures cross-link. Native x64 tests reject missing and duplicate
option values with return 10; test191 loads the installed resources and
renders four New Tab pages with Developer removed. Subsequent multi-tab
navigation hits a separate compositor assertion, so this is not RC or
complete browser acceptance. Resource contents match the old layout exactly.
---
 tools/CEFHost/CEFHost.c    | 37 +++++++++++++++++++++++++++++++++----
 tools/Chromium/CEFHost-Run |  3 +--
 tools/Chromium/README.md   |  6 +++++-
 3 files changed, 39 insertions(+), 7 deletions(-)

diff --git a/tools/CEFHost/CEFHost.c b/tools/CEFHost/CEFHost.c
index c7b7d5a..004a1ba 100644
--- a/tools/CEFHost/CEFHost.c
+++ b/tools/CEFHost/CEFHost.c
@@ -23,7 +23,7 @@ static struct Task *owner;
 static cef_task_t dispatch_task;
 static cef_task_runner_t *ui_runner;
 static int allow_stop;
-static cef_char_t root[1024], resources[] = u"Developer:CEF", locales[] = u"Developer:CEF/locales";
+static cef_char_t root[1024], resources[1024], locales[1024];
 static char root_ascii[768];
 static ULONG session_count;
 static IPTR next_session = 1;
@@ -214,14 +214,25 @@ int main(int argc, char **argv)
     cef_settings_t settings = {0};
     cef_char_t subprocess_path[1024];
     char subprocess_ascii[1024];
+    char resources_ascii[1024], locales_ascii[1024];
     int native_children = 0, debug_native = 0, root_supplied = 0;
     const char *profile_root = "ENVARC:CEF/Profiles";
+    const char *resource_root = "Developer:CEF";
+    int resource_supplied = 0;
     for (int i = 1; i < argc; ++i) {
         if (!strcmp(argv[i], "--native-children")) native_children = 1;
         else if (!strcmp(argv[i], "--debug-native")) debug_native = 1;
         else if (!strcmp(argv[i], "--allow-stop")) allow_stop = 1;
+        else if (!strcmp(argv[i], "--resources-dir")) {
+            if (resource_supplied || i + 1 >= argc || !argv[i + 1][0]) {
+                Printf("CEF host: --resources-dir requires one directory\n");
+                return RETURN_ERROR;
+            }
+            resource_root = argv[++i];
+            resource_supplied = 1;
+        }
         else if (!strcmp(argv[i], "--help") || !strcmp(argv[i], "?")) {
-            Printf("Usage: CEFHost [profile-root] [--native-children] [--debug-native] [--allow-stop]\n");
+            Printf("Usage: CEFHost [profile-root] [--native-children] [--debug-native] [--allow-stop] [--resources-dir directory]\n");
             return RETURN_OK;
         } else if (!argv[i][0] || argv[i][0] == '-' || root_supplied) {
             Printf("CEF host: invalid argument; use --help\n");
@@ -231,6 +242,24 @@ int main(int argc, char **argv)
             root_supplied = 1;
         }
     }
+    {
+        struct FileInfoBlock info;
+        BPTR lock = Lock(resource_root, ACCESS_READ);
+        int ok = lock && Examine(lock, &info) && info.fib_DirEntryType > 0 &&
+            NameFromLock(lock, resources_ascii, sizeof(resources_ascii));
+        if (lock) UnLock(lock);
+        if (!ok) {
+            Printf("CEF host: cannot find the browser resource directory\n");
+            return RETURN_ERROR;
+        }
+        strcpy(locales_ascii, resources_ascii);
+        if (!AddPart(locales_ascii, "locales", sizeof(locales_ascii)) ||
+            !to_utf16(resources, sizeof(resources) / sizeof(*resources), resources_ascii) ||
+            !to_utf16(locales, sizeof(locales) / sizeof(*locales), locales_ascii)) {
+            Printf("CEF host: browser resource path is too long\n");
+            return RETURN_ERROR;
+        }
+    }
     if (debug_native) {
         /* Retain INFO/error diagnostics on AROS DEBUG: for native test runs. */
         args[4] = "--enable-logging=system";
@@ -269,8 +298,8 @@ int main(int argc, char **argv)
         text(&settings.browser_subprocess_path, subprocess_path, strlen(subprocess_ascii));
         KPrintF("[CEF-HOST] native child executable=%s\n", subprocess_ascii);
     }
-    text(&settings.resources_dir_path, resources, sizeof(resources) / sizeof(*resources) - 1);
-    text(&settings.locales_dir_path, locales, sizeof(locales) / sizeof(*locales) - 1);
+    text(&settings.resources_dir_path, resources, strlen(resources_ascii));
+    text(&settings.locales_dir_path, locales, strlen(locales_ascii));
     text(&settings.root_cache_path, root, strlen(root_ascii));
     result = CEFExecuteProcess(&main_args, NULL, NULL);
     KPrintF("[CEF-HOST] execute=%ld\n", (LONG)result);
diff --git a/tools/Chromium/CEFHost-Run b/tools/Chromium/CEFHost-Run
index d228d60..3ce9f30 100644
--- a/tools/Chromium/CEFHost-Run
+++ b/tools/Chromium/CEFHost-Run
@@ -1,3 +1,2 @@
 Stack 1048576
-SYS:System/CEFHost ENVARC:CEF/Profiles --native-children
-
+SYS:System/CEFHost ENVARC:CEF/Profiles --native-children --resources-dir SYS:System/CEF
diff --git a/tools/Chromium/README.md b/tools/Chromium/README.md
index 84bb1b9..1fe7c94 100644
--- a/tools/Chromium/README.md
+++ b/tools/Chromium/README.md
@@ -35,10 +35,14 @@ arbitrates concurrent startup attempts; only the registered owner initializes
 CEF. The regular startup script does not enable diagnostic host shutdown.
 
 The host requires matching `cef.library`, `cef-blink.library`, `v8.library`,
-CEF resources under `Developer:CEF`, and writable persistent profiles under
+CEF resources under `SYS:System/CEF`, and writable persistent profiles under
 `ENVARC:CEF/Profiles`. Browser profiles provide storage separation in AROS's
 shared address space; they are not an OS security sandbox.
 
+The release startup supplies `--resources-dir SYS:System/CEF`; no `Developer:`
+assign is required. Direct diagnostic invocations retain the older
+`Developer:CEF` default unless a resource directory is explicitly supplied.
+
 The timed diagnostic clients still use the same callback/reference lifecycle
 implementation. This launcher removes their automatic close timers; closing
 a window before navigation finishes is an ordinary close, not a test failure.
-- 
