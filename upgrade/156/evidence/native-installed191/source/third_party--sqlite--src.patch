+    pNew->lockingContext=chromiumArosLockOpen(zFilename);
+    if(!pNew->lockingContext)rc=SQLITE_CANTOPEN_BKPT;
+  }
+#endif
+
   if( pLockingStyle == &posixIoMethods
 #if defined(__APPLE__) && SQLITE_ENABLE_LOCKING_STYLE
     || pLockingStyle == &nfsIoMethods
@@ -47195,6 +47228,10 @@ static int unixFullPathname(
   int nOut,                     /* Size of output buffer in bytes */
   char *zOut                    /* Output buffer */
 ){
+#ifdef SQLITE_AROS_FULL_PATHNAME
+  UNUSED_PARAMETER(pVfs);
+  return SQLITE_AROS_FULL_PATHNAME(zPath, nOut, zOut);
+#else
   DbPath path;
   UNUSED_PARAMETER(pVfs);
   path.rc = 0;
@@ -47214,6 +47251,7 @@ static int unixFullPathname(
   if( path.rc || path.nUsed<2 ) return SQLITE_CANTOPEN_BKPT;
   if( path.nSymlink ) return SQLITE_OK_SYMLINK;
   return SQLITE_OK;
+#endif
 }
 
