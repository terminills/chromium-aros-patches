--- a/amalgamation/sqlite3.c
+++ b/amalgamation/sqlite3.c
@@ -46033,6 +46033,32 @@ static const sqlite3_io_methods *(*const FINDER)(const char*,unixFile *p)    \
 ** locking strategies.  Functions that return pointers to these methods
 ** are also created.
 */
+#ifdef SQLITE_AROS_NATIVE_LOCKS
+static int arosLock(sqlite3_file *id, int level) {
+  unixFile *p=(unixFile*)id;
+  int rc=chromiumArosLock(p->lockingContext,level);
+  p->eFileLock=chromiumArosLockLevel(p->lockingContext);
+  return rc;
+}
+static int arosUnlock(sqlite3_file *id, int level) {
+  unixFile *p=(unixFile*)id;
+  int rc=chromiumArosUnlock(p->lockingContext,level);
+  p->eFileLock=chromiumArosLockLevel(p->lockingContext);
+  return rc;
+}
+static int arosReserved(sqlite3_file *id,int *result) {
+  return chromiumArosReserved(((unixFile*)id)->lockingContext,result);
+}
+static int arosClose(sqlite3_file *id) {
+  unixFile *p=(unixFile*)id;
+  chromiumArosLockClose(p->lockingContext);
+  p->lockingContext=0;p->eFileLock=NO_LOCK;
+  return closeUnixFile(id);
+}
+IOMETHODS(arosIoFinder, arosIoMethods, 1, arosClose, arosLock,
+          arosUnlock, arosReserved, 0)
+#endif
+
 IOMETHODS(
   posixIoFinder,            /* Finder function name */
   posixIoMethods,           /* sqlite3_io_methods object name */
@@ -46313,6 +46339,13 @@ static int fillInUnixFile(
 #endif
   }
 
