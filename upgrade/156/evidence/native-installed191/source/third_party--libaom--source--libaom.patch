 }
 
+#elif defined(__AROS__)
+
+static int arm_get_cpu_caps(void) {
+  // The native port guarantees Armv8 NEON. AROS currently has no public
+  // runtime feature mask for optional ISA extensions or saved SVE state;
+  // do not select those kernels merely because the assembler supports them.
+  int flags = 0;
+#if HAVE_NEON
+  flags |= HAS_NEON;
+#endif
+#if HAVE_ARM_CRC32 && defined(__ARM_FEATURE_CRC32)
+  flags |= HAS_ARM_CRC32;
+#endif
+  return flags;
+}
+
 #elif defined(__APPLE__)  // end !CONFIG_RUNTIME_CPU_DETECT
 
