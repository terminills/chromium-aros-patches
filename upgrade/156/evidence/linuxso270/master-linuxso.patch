diff --git a/compiler/linuxso/linuxso.h b/compiler/linuxso/linuxso.h
new file mode 100644
index 00000000..f53e87c1
--- /dev/null
+++ b/compiler/linuxso/linuxso.h
@@ -0,0 +1,57 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso -- load a Linux x86-64 ELF shared object (ET_DYN) into an AROS
+    process and run it against a glibc-ABI shim.
+
+    The loader maps the PT_LOAD segments into exec memory, applies the
+    dynamic relocations, resolves every undefined symbol against the shim
+    table (glibc/libpthread/libm/libdl/libgcc_s entry points implemented
+    on top of stdc/posixc/pthread), registers the object's .eh_frame with
+    the program's libgcc unwinder and runs the ELF constructors.  It is a
+    linklib, not a library: the shim must reach posixc/pthread through the
+    calling program's own bases from any thread the guest object creates,
+    which is exactly what a statically linked linklib gets for free.
+
+    Raw `syscall` instructions in the guest are trapped as #UD on native
+    x86-64 (IA32_EFER.SCE is off) and emulated by linuxso_syscall(); on
+    hosted AROS they reach the host kernel unchanged.
+*/
+
+#ifndef LINUXSO_H
+#define LINUXSO_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct LinuxSO;
+
+/*
+ * Load `path` (an AROS or unix-style path, opened through posixc).  On
+ * failure NULL is returned and, if errbuf is non-NULL, a one-line reason is
+ * copied into it (unresolved symbols are listed).
+ */
+struct LinuxSO *linuxso_open(const char *path, char *errbuf, size_t errlen);
+
+/* Look up an exported (defined, global or weak) symbol; NULL if absent. */
+void *linuxso_sym(struct LinuxSO *so, const char *name);
+
+/* Run the destructors, unregister the unwind info and free the mapping. */
+int linuxso_close(struct LinuxSO *so);
+
+/*
+ * Debug channel.  Set the LINUXSO_DEBUG environment variable (any value;
+ * a value naming a file, i.e. containing ':' or '/', also appends there)
+ * before linuxso_open() to get loader, shim and syscall-emulation traces on
+ * the kernel debug output (serial on native, stderr on hosted).
+ */
+int linuxso_debug_enabled(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* LINUXSO_H */
diff --git a/compiler/linuxso/linuxso_cli.c b/compiler/linuxso/linuxso_cli.c
new file mode 100644
index 00000000..66231f41
--- /dev/null
+++ b/compiler/linuxso/linuxso_cli.c
@@ -0,0 +1,97 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    LinuxSO -- load a Linux x86-64 shared object and call an exported symbol.
+
+    Usage: LinuxSO <path> [symbol ...]
+
+    Every named symbol is looked up and, if found, called as
+    `const char *fn(void)` with the result printed as a string; a
+    `void:` prefix calls it as `void fn(void)` instead.  Symbols may also
+    be given space-separated in one argument.  The default symbol list
+    is the Widevine CDM's GetCdmVersion, which is the smallest end-to-end
+    proof: the object mapped, relocated, ran its constructors and
+    returned through the shim.
+*/
+
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <linuxso.h>
+
+int main(int argc, char **argv)
+{
+    const char *syms[64];
+    int nsyms = 0;
+    char err[512];
+    struct LinuxSO *so;
+    int i, rc = 0;
+
+    if (argc < 2)
+    {
+        fprintf(stderr, "usage: %s <path> [symbol ...]\n", argv[0]);
+        return 20;
+    }
+    for (i = 2; i < argc; i++)
+    {
+        char *tok = strtok(argv[i], " ");
+        while (tok && nsyms < 63)
+        {
+            syms[nsyms++] = tok;
+            tok = strtok(NULL, " ");
+        }
+    }
+    if (!nsyms)
+        syms[nsyms++] = "GetCdmVersion";
+    syms[nsyms] = NULL;
+
+    printf("LinuxSO: loading %s%s\n", argv[1], linuxso_debug_enabled() ? " (debug on)" : "");
+    fflush(stdout);
+    so = linuxso_open(argv[1], err, sizeof(err));
+    if (!so)
+    {
+        fprintf(stderr, "LinuxSO: %s: %s\n", argv[1], err);
+        return 10;
+    }
+    printf("LinuxSO: loaded\n");
+    fflush(stdout);
+
+    for (i = 0; syms[i]; i++)
+    {
+        const char *name = syms[i];
+        int isvoid = strncmp(name, "void:", 5) == 0;
+        const char *(*fn)(void);
+
+        if (isvoid)
+            name += 5;
+        fn = linuxso_sym(so, name);
+        if (!fn)
+        {
+            printf("LinuxSO: %s: not exported\n", name);
+            rc = 5;
+            continue;
+        }
+        printf("LinuxSO: calling %s at %p\n", name, (void *)fn);
+        fflush(stdout);
+        if (isvoid)
+        {
+            ((void (*)(void))fn)();
+            printf("LinuxSO: %s() returned\n", name);
+        }
+        else
+        {
+            const char *r = fn();
+            printf("LinuxSO: %s() = %p", name, (const void *)r);
+            if (r && (size_t)(uintptr_t)r > 0x10000)
+                printf(" \"%.80s\"", r);
+            printf("\n");
+        }
+        fflush(stdout);
+    }
+
+    linuxso_close(so);
+    printf("LinuxSO: closed\n");
+    return rc;
+}
diff --git a/compiler/linuxso/linuxso_intern.h b/compiler/linuxso/linuxso_intern.h
new file mode 100644
index 00000000..7917e7a7
--- /dev/null
+++ b/compiler/linuxso/linuxso_intern.h
@@ -0,0 +1,251 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso internals shared by the ELF mapper and the glibc ABI shim.
+*/
+
+#ifndef LINUXSO_INTERN_H
+#define LINUXSO_INTERN_H
+
+#include <exec/types.h>
+#include <exec/lists.h>
+#include <exec/nodes.h>
+#include <exec/tasks.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <time.h>
+
+#include "linuxso.h"
+
+/* Loader/shim trace: LINUXSO_DEBUG in the environment turns it on. */
+void lso_log(const char *fmt, ...);
+#define LSO_DEBUG(...) do { if (linuxso_debug_enabled()) lso_log(__VA_ARGS__); } while (0)
+
+/* ---- ELF64 (only what the mapper needs) ---------------------------------- */
+
+typedef struct {
+    unsigned char e_ident[16];
+    uint16_t e_type, e_machine;
+    uint32_t e_version;
+    uint64_t e_entry, e_phoff, e_shoff;
+    uint32_t e_flags;
+    uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx;
+} lso_Ehdr;
+
+typedef struct {
+    uint32_t p_type, p_flags;
+    uint64_t p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align;
+} lso_Phdr;
+
+typedef struct {
+    uint32_t sh_name, sh_type;
+    uint64_t sh_flags, sh_addr, sh_offset, sh_size;
+    uint32_t sh_link, sh_info;
+    uint64_t sh_addralign, sh_entsize;
+} lso_Shdr;
+
+typedef struct {
+    int64_t d_tag;
+    uint64_t d_val;
+} lso_Dyn;
+
+typedef struct {
+    uint32_t st_name;
+    unsigned char st_info, st_other;
+    uint16_t st_shndx;
+    uint64_t st_value, st_size;
+} lso_Sym;
+
+typedef struct {
+    uint64_t r_offset, r_info;
+    int64_t r_addend;
+} lso_Rela;
+
+#define LSO_ET_DYN        3
+#define LSO_EM_X86_64     62
+#define LSO_PT_LOAD       1
+#define LSO_PT_DYNAMIC    2
+#define LSO_PT_TLS        7
+#define LSO_PF_X          1
+#define LSO_PF_W          2
+#define LSO_PF_R          4
+#define LSO_SHN_UNDEF     0
+#define LSO_STB_WEAK      2
+#define LSO_STT_TLS       6
+#define LSO_STT_FUNC      2
+#define LSO_STT_OBJECT    1
+#define LSO_STT_GNU_IFUNC 10
+
+#define LSO_DT_NULL       0
+#define LSO_DT_NEEDED     1
+#define LSO_DT_PLTRELSZ   2
+#define LSO_DT_PLTGOT     3
+#define LSO_DT_HASH       4
+#define LSO_DT_STRTAB     5
+#define LSO_DT_SYMTAB     6
+#define LSO_DT_RELA       7
+#define LSO_DT_RELASZ     8
+#define LSO_DT_RELAENT    9
+#define LSO_DT_INIT       12
+#define LSO_DT_FINI       13
+#define LSO_DT_SONAME     14
+#define LSO_DT_JMPREL     23
+#define LSO_DT_INIT_ARRAY 25
+#define LSO_DT_FINI_ARRAY 26
+#define LSO_DT_INIT_ARRAYSZ 27
+#define LSO_DT_FINI_ARRAYSZ 28
+#define LSO_DT_FLAGS      30
+
+#define LSO_R_X86_64_NONE      0
+#define LSO_R_X86_64_64        1
+#define LSO_R_X86_64_GLOB_DAT  6
+#define LSO_R_X86_64_JUMP_SLOT 7
+#define LSO_R_X86_64_RELATIVE  8
+#define LSO_R_X86_64_DTPMOD64  16
+#define LSO_R_X86_64_DTPOFF64  17
+#define LSO_R_X86_64_TPOFF64   18
+#define LSO_R_X86_64_IRELATIVE 37
+
+#define LSO_PAGE 4096UL
+
+/* ---- loaded object -------------------------------------------------------- */
+
+struct lso_atexit {
+    struct MinNode node;
+    void (*fn)(void *);
+    void *arg;
+    void *dso;
+};
+
+struct lso_segment {
+    uintptr_t start, end;   /* absolute, page rounded */
+    uint32_t flags;         /* PF_* */
+    uint64_t offset;        /* file offset */
+};
+
+struct LinuxSO {
+    struct MinNode node;            /* on lso_objects */
+    char *path;
+    char *unixpath;                 /* as reported in /proc/self/maps */
+    APTR alloc;                     /* AllocMem block */
+    size_t allocsize;
+    uintptr_t base;                 /* load bias (page aligned) */
+    size_t mapsize;
+    struct lso_segment seg[8];
+    int nseg;
+
+    /* dynamic section, absolute addresses */
+    const char *strtab;
+    const lso_Sym *symtab;
+    const uint32_t *hash;           /* DT_HASH: nbucket, nchain, buckets, chains */
+    void (*init)(void);
+    void (*fini)(void);
+    void (**init_array)(void);
+    size_t init_array_n;
+    void (**fini_array)(void);
+    size_t fini_array_n;
+
+    /* PT_TLS */
+    const void *tls_image;
+    size_t tls_filesz, tls_memsz, tls_align;
+    unsigned int tls_modid;         /* 1-based, index into the per-task DTV */
+
+    /* .eh_frame registration with the program's libgcc */
+    void *eh_frame;
+    void *eh_object;                /* libgcc's opaque struct object */
+
+    struct MinList atexit;          /* struct lso_atexit, newest first */
+    int refcount;
+};
+
+/* Registry of loaded objects (for /proc/self/maps and dlsym) */
+extern struct MinList lso_objects;
+extern struct SignalSemaphore lso_lock;
+
+/* glibc x86-64 time structures (AROS time_t is 32-bit, so these differ) */
+struct lx_timespec { int64_t tv_sec, tv_nsec; };
+struct lx_timeval { int64_t tv_sec, tv_usec; };
+
+/* ---- per-task shim state ------------------------------------------------- */
+
+#define LSO_MAX_TLS_MODULES 8
+
+struct lso_task {
+    int lx_errno;                   /* glibc-numbered errno for __errno_location */
+    void *tls[LSO_MAX_TLS_MODULES]; /* per-module TLS blocks, lazily created */
+    struct Task *task;
+    char thread_name[32];
+};
+
+struct lso_task *lso_task_get(void);   /* create on first use */
+void lso_task_free(struct Task *task); /* at thread exit */
+void lso_tls_release(struct lso_task *lt);
+
+/* ---- shim table ---------------------------------------------------------- */
+
+struct lso_symbol {
+    const char *name;
+    void *addr;
+};
+
+/* Sorted by name; lso_shim_lookup() binary-searches it. */
+void *lso_shim_lookup(const char *name);
+void lso_shim_init(void);                   /* once, before the first object loads */
+int lso_clock_gettime(int lx_clock, struct timespec *ts);
+unsigned int lso_ncpus(void);
+
+/* errno plumbing */
+int lso_errno_to_linux(int aros_errno);
+void lso_set_errno_from_aros(void);         /* copy the task's AROS errno, translated */
+void lso_set_errno(int lx_errno);
+int lso_pthread_ret(int aros_ret);          /* translate a pthread-style return code */
+
+/* Linux x86-64 errno numbers used by the shim */
+#define LX_EPERM   1
+#define LX_ENOENT  2
+#define LX_ESRCH   3
+#define LX_EINTR   4
+#define LX_EIO     5
+#define LX_EBADF   9
+#define LX_EAGAIN  11
+#define LX_ENOMEM  12
+#define LX_EACCES  13
+#define LX_EFAULT  14
+#define LX_EBUSY   16
+#define LX_EEXIST  17
+#define LX_ENOTDIR 20
+#define LX_EISDIR  21
+#define LX_EINVAL  22
+#define LX_ENFILE  23
+#define LX_EMFILE  24
+#define LX_ENOSPC  28
+#define LX_ESPIPE  29
+#define LX_EPIPE   32
+#define LX_ERANGE  34
+#define LX_EDEADLK 35
+#define LX_ENOSYS  38
+#define LX_ENOTSUP 95
+#define LX_ETIMEDOUT 110
+
+/* Linux syscall emulation (native #UD trap path and the syscall() wrapper) */
+long lso_syscall(long nr, long a1, long a2, long a3, long a4, long a5, long a6);
+int lso_syscall_trap_install(void);
+long lso_getrandom(void *buf, size_t len);       /* rdrand-backed, never short */
+void lso_syscall_trap_remove(void);
+
+/* memory (mmap emulation) */
+void *lso_mmap(void *addr, size_t len, int prot, int flags, int fd, int64_t off);
+int lso_munmap(void *addr, size_t len);
+
+/* files: Linux <-> AROS open flags, glibc struct stat, synthetic /proc */
+int lso_open_flags_to_aros(int lxflags);
+int lso_open(const char *path, int lxflags, int mode);
+int lso_stat_to_glibc(const char *path, int fd, void *lxstat);
+void lso_procfs_maps(char *buf, size_t len);
+
+/* the loaded-object side of dlsym/__cxa_atexit */
+void *lso_objects_sym(const char *name);
+void lso_atexit_push(void (*fn)(void *), void *arg, void *dso);
+void lso_atexit_run(void *dso);
+
+#endif /* LINUXSO_INTERN_H */
diff --git a/compiler/linuxso/lso_elf.c b/compiler/linuxso/lso_elf.c
new file mode 100644
index 00000000..0b418729
--- /dev/null
+++ b/compiler/linuxso/lso_elf.c
@@ -0,0 +1,705 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso ELF ET_DYN mapper: PT_LOAD into exec memory, dynamic
+    relocation against the shim table, .eh_frame registration and the
+    ELF constructor/destructor protocol.
+*/
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <exec/memory.h>
+#include <aros/debug.h>
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "linuxso_intern.h"
+
+struct MinList lso_objects;
+struct SignalSemaphore lso_lock;
+static int lso_initialised;
+static int lso_debug = -1;
+static char *lso_debug_path;             /* LINUXSO_DEBUG=<file>: also append there */
+static unsigned int lso_next_tls_modid = 1;
+
+/* libgcc's frame registry (unwind-dw2-fde.c) */
+extern void __register_frame_info(const void *begin, void *ob);
+extern void *__deregister_frame_info(const void *begin);
+
+int linuxso_debug_enabled(void)
+{
+    if (lso_debug < 0)
+    {
+        const char *v = getenv("LINUXSO_DEBUG");
+
+        /* a value with a volume or directory separator names a log file:
+           on native there is no host stderr to read kprintf from */
+        if (v && (strchr(v, ':') || strchr(v, '/')))
+            lso_debug_path = strdup(v);
+        lso_debug = v != NULL;
+    }
+    return lso_debug;
+}
+
+void lso_log(const char *fmt, ...)
+{
+    char line[512];
+    struct timespec now;
+    va_list ap;
+    int n;
+
+    /* monotonic seconds first, so the trace answers "where did the time go" */
+    lso_clock_gettime(1, &now);
+    n = snprintf(line, sizeof(line), "%lu.%03lu ", (unsigned long)now.tv_sec,
+                 (unsigned long)(now.tv_nsec / 1000000));
+    va_start(ap, fmt);
+    vsnprintf(line + n, sizeof(line) - n, fmt, ap);
+    va_end(ap);
+    kprintf("[linuxso] %s\n", line);
+    if (lso_debug_path && FindTask(NULL)->tc_Node.ln_Type == NT_PROCESS)
+    {
+        /* open per line: a trap right after leaves the file complete */
+        BPTR fh = Open(lso_debug_path, MODE_READWRITE);
+        if (fh)
+        {
+            Seek(fh, 0, OFFSET_END);
+            Write(fh, "[linuxso] ", 10);
+            Write(fh, line, strlen(line));
+            Write(fh, "\n", 1);
+            Close(fh);
+        }
+    }
+}
+
+static void lso_init_once(void)
+{
+    int first;
+
+    Forbid();
+    first = !lso_initialised;
+    if (first)
+    {
+        NEWLIST(&lso_objects);
+        InitSemaphore(&lso_lock);
+        lso_initialised = 1;
+    }
+    Permit();
+    if (first)
+    {
+        lso_shim_init();
+        lso_syscall_trap_install();
+    }
+}
+
+static void seterr(char *errbuf, size_t errlen, const char *fmt, ...)
+{
+    va_list ap;
+
+    if (!errbuf || !errlen)
+        return;
+    va_start(ap, fmt);
+    vsnprintf(errbuf, errlen, fmt, ap);
+    va_end(ap);
+}
+
+static int read_at(int fd, void *buf, size_t len, uint64_t off)
+{
+    size_t done = 0;
+
+    while (done < len)
+    {
+        ssize_t n = pread(fd, (char *)buf + done, len - done, (off_t)(off + done));
+        if (n <= 0)
+            return -1;
+        done += n;
+    }
+    return 0;
+}
+
+static uint32_t elf_hash(const char *name)
+{
+    uint32_t h = 0, g;
+
+    while (*name)
+    {
+        h = (h << 4) + (unsigned char)*name++;
+        g = h & 0xf0000000;
+        if (g)
+            h ^= g >> 24;
+        h &= ~g;
+    }
+    return h;
+}
+
+/* Find a defined symbol in one object via DT_HASH. */
+static const lso_Sym *find_defined(struct LinuxSO *so, const char *name)
+{
+    uint32_t nbucket, nchain, i;
+    const uint32_t *bucket, *chain;
+
+    if (!so->hash)
+        return NULL;
+    nbucket = so->hash[0];
+    nchain = so->hash[1];
+    bucket = so->hash + 2;
+    chain = bucket + nbucket;
+    if (!nbucket)
+        return NULL;
+
+    for (i = bucket[elf_hash(name) % nbucket]; i && i < nchain; i = chain[i])
+    {
+        const lso_Sym *s = &so->symtab[i];
+        if (s->st_shndx != LSO_SHN_UNDEF && strcmp(so->strtab + s->st_name, name) == 0)
+            return s;
+    }
+    return NULL;
+}
+
+void *linuxso_sym(struct LinuxSO *so, const char *name)
+{
+    const lso_Sym *s;
+
+    if (!so || !name)
+        return NULL;
+    s = find_defined(so, name);
+    if (!s)
+        return NULL;
+    if ((s->st_info & 0xf) == LSO_STT_TLS)
+        return NULL;
+    LSO_DEBUG("sym %s -> %p", name, (void *)(so->base + s->st_value));
+    return (void *)(so->base + s->st_value);
+}
+
+void *lso_objects_sym(const char *name)
+{
+    struct LinuxSO *so;
+    void *p = NULL;
+
+    ObtainSemaphoreShared(&lso_lock);
+    ForeachNode(&lso_objects, so)
+    {
+        p = linuxso_sym(so, name);
+        if (p)
+            break;
+    }
+    ReleaseSemaphore(&lso_lock);
+    return p;
+}
+
+void lso_atexit_push(void (*fn)(void *), void *arg, void *dso)
+{
+    struct lso_atexit *a = AllocMem(sizeof(*a), MEMF_ANY | MEMF_CLEAR);
+    struct LinuxSO *so;
+
+    if (!a)
+        return;
+    a->fn = fn;
+    a->arg = arg;
+    a->dso = dso;
+
+    ObtainSemaphore(&lso_lock);
+    /* the CDM passes its own __dso_handle, which lives inside its mapping */
+    ForeachNode(&lso_objects, so)
+    {
+        if ((uintptr_t)dso >= so->base && (uintptr_t)dso < so->base + so->mapsize)
+        {
+            AddHead((struct List *)&so->atexit, (struct Node *)&a->node);
+            a = NULL;
+            break;
+        }
+    }
+    if (a)
+    {
+        /* unknown owner: attach to the most recently loaded object */
+        so = (struct LinuxSO *)GetHead(&lso_objects);
+        if (so)
+            AddHead((struct List *)&so->atexit, (struct Node *)&a->node);
+        else
+            FreeMem(a, sizeof(*a));
+    }
+    ReleaseSemaphore(&lso_lock);
+}
+
+static void run_atexit(struct LinuxSO *so)
+{
+    struct lso_atexit *a;
+
+    while ((a = (struct lso_atexit *)RemHead((struct List *)&so->atexit)))
+    {
+        LSO_DEBUG("atexit %p(%p)", a->fn, a->arg);
+        a->fn(a->arg);
+        FreeMem(a, sizeof(*a));
+    }
+}
+
+void lso_atexit_run(void *dso)
+{
+    struct LinuxSO *so;
+
+    ObtainSemaphore(&lso_lock);
+    ForeachNode(&lso_objects, so)
+    {
+        if (!dso || ((uintptr_t)dso >= so->base && (uintptr_t)dso < so->base + so->mapsize))
+            run_atexit(so);
+    }
+    ReleaseSemaphore(&lso_lock);
+}
+
+static const char *sym_name(struct LinuxSO *so, uint32_t idx)
+{
+    return so->strtab + so->symtab[idx].st_name;
+}
+
+/*
+ * Resolve the symbol of one relocation.  Defined symbols bind inside the
+ * object; undefined ones go to the shim.  Returns 0 and records the name
+ * when a non-weak symbol is missing.
+ */
+static int resolve(struct LinuxSO *so, uint32_t idx, uintptr_t *value,
+                   char *missing, size_t missinglen)
+{
+    const lso_Sym *s = &so->symtab[idx];
+    const char *name = sym_name(so, idx);
+    void *p;
+
+    if (s->st_shndx != LSO_SHN_UNDEF)
+    {
+        *value = so->base + s->st_value;
+        return 1;
+    }
+    p = lso_shim_lookup(name);
+    if (p)
+    {
+        *value = (uintptr_t)p;
+        return 1;
+    }
+    if ((s->st_info >> 4) == LSO_STB_WEAK)
+    {
+        LSO_DEBUG("weak undefined %s -> 0", name);
+        *value = 0;
+        return 1;
+    }
+    if (missing[0])
+        strncat(missing, " ", missinglen - strlen(missing) - 1);
+    strncat(missing, name, missinglen - strlen(missing) - 1);
+    *value = 0;
+    return 0;
+}
+
+static int apply_relocs(struct LinuxSO *so, const lso_Rela *rela, size_t n,
+                        char *missing, size_t missinglen)
+{
+    size_t i;
+    int failed = 0;
+
+    for (i = 0; i < n; i++)
+    {
+        uint32_t type = (uint32_t)rela[i].r_info;
+        uint32_t sym = (uint32_t)(rela[i].r_info >> 32);
+        uint64_t *where = (uint64_t *)(so->base + rela[i].r_offset);
+        uintptr_t S = 0;
+
+        switch (type)
+        {
+        case LSO_R_X86_64_NONE:
+            break;
+        case LSO_R_X86_64_RELATIVE:
+            *where = so->base + rela[i].r_addend;
+            break;
+        case LSO_R_X86_64_64:
+            if (!resolve(so, sym, &S, missing, missinglen)) failed++;
+            *where = S + rela[i].r_addend;
+            break;
+        case LSO_R_X86_64_GLOB_DAT:
+            if (!resolve(so, sym, &S, missing, missinglen)) failed++;
+            *where = S + rela[i].r_addend;
+            break;
+        case LSO_R_X86_64_JUMP_SLOT:
+            if (!resolve(so, sym, &S, missing, missinglen)) failed++;
+            *where = S;
+            break;
+        case LSO_R_X86_64_DTPMOD64:
+            /* module id of the TLS block; only our own module is supported */
+            *where = so->tls_modid;
+            break;
+        case LSO_R_X86_64_DTPOFF64:
+            *where = so->symtab[sym].st_value + rela[i].r_addend;
+            break;
+        case LSO_R_X86_64_TPOFF64:
+            /* initial-exec TLS needs a %fs-based block we do not own */
+            if (missing[0]) strncat(missing, " ", missinglen - strlen(missing) - 1);
+            strncat(missing, "<R_X86_64_TPOFF64>", missinglen - strlen(missing) - 1);
+            failed++;
+            break;
+        default:
+            LSO_DEBUG("unsupported relocation type %u at %p", type, where);
+            if (missing[0]) strncat(missing, " ", missinglen - strlen(missing) - 1);
+            strncat(missing, "<reloc-type>", missinglen - strlen(missing) - 1);
+            failed++;
+            break;
+        }
+    }
+    return failed;
+}
+
+static char *dupstr(const char *s)
+{
+    size_t n = strlen(s) + 1;
+    char *d = AllocVec(n, MEMF_ANY);
+    if (d)
+        memcpy(d, s, n);
+    return d;
+}
+
+/* "SYS:Applications/x/y.so" -> "/SYS/Applications/x/y.so" for /proc/self/maps */
+static char *unix_path(const char *p)
+{
+    const char *colon = strchr(p, ':');
+    char *u;
+    size_t n = strlen(p);
+
+    if (!colon || p[0] == '/')
+        return dupstr(p);
+    u = AllocVec(n + 2, MEMF_ANY);
+    if (!u)
+        return NULL;
+    u[0] = '/';
+    memcpy(u + 1, p, colon - p);
+    u[1 + (colon - p)] = '/';
+    strcpy(u + 2 + (colon - p), colon + 1);
+    return u;
+}
+
+static void free_object(struct LinuxSO *so)
+{
+    if (so->alloc)
+        FreeMem(so->alloc, so->allocsize);
+    if (so->eh_object)
+        FreeMem(so->eh_object, 64);
+    FreeVec(so->path);
+    FreeVec(so->unixpath);
+    FreeMem(so, sizeof(*so));
+}
+
+struct LinuxSO *linuxso_open(const char *path, char *errbuf, size_t errlen)
+{
+    struct LinuxSO *so;
+    lso_Ehdr eh;
+    lso_Phdr *ph = NULL;
+    lso_Shdr *sh = NULL;
+    char *shstr = NULL;
+    int fd = -1, i;
+    uintptr_t lo = ~(uintptr_t)0, hi = 0;
+    const lso_Dyn *dyn = NULL;
+    const lso_Rela *rela = NULL, *jmprel = NULL;
+    size_t relasz = 0, pltrelsz = 0;
+    char missing[1024];
+
+    lso_init_once();
+    if (errbuf && errlen)
+        errbuf[0] = 0;
+
+    so = AllocMem(sizeof(*so), MEMF_ANY | MEMF_CLEAR);
+    if (!so)
+    {
+        seterr(errbuf, errlen, "out of memory");
+        return NULL;
+    }
+    NEWLIST(&so->atexit);
+    so->refcount = 1;
+    so->path = dupstr(path);
+    so->unixpath = unix_path(path);
+
+    fd = open(path, O_RDONLY);
+    if (fd < 0)
+    {
+        seterr(errbuf, errlen, "cannot open %s", path);
+        goto fail;
+    }
+    if (read_at(fd, &eh, sizeof(eh), 0) < 0 || memcmp(eh.e_ident, "\177ELF\002\001", 6) != 0)
+    {
+        seterr(errbuf, errlen, "%s: not an ELF64 little-endian object", path);
+        goto fail;
+    }
+    if (eh.e_type != LSO_ET_DYN || eh.e_machine != LSO_EM_X86_64)
+    {
+        seterr(errbuf, errlen, "%s: not an x86-64 ET_DYN object (type %u machine %u)",
+               path, eh.e_type, eh.e_machine);
+        goto fail;
+    }
+    if (eh.e_phentsize != sizeof(lso_Phdr) || eh.e_phnum == 0 || eh.e_phnum > 64)
+    {
+        seterr(errbuf, errlen, "%s: bad program header table", path);
+        goto fail;
+    }
+
+    ph = AllocVec(eh.e_phnum * sizeof(lso_Phdr), MEMF_ANY);
+    if (!ph || read_at(fd, ph, eh.e_phnum * sizeof(lso_Phdr), eh.e_phoff) < 0)
+    {
+        seterr(errbuf, errlen, "%s: cannot read program headers", path);
+        goto fail;
+    }
+
+    /* extent of the image */
+    for (i = 0; i < eh.e_phnum; i++)
+    {
+        if (ph[i].p_type != LSO_PT_LOAD)
+            continue;
+        if (ph[i].p_vaddr < lo)
+            lo = ph[i].p_vaddr & ~(LSO_PAGE - 1);
+        if (ph[i].p_vaddr + ph[i].p_memsz > hi)
+            hi = ph[i].p_vaddr + ph[i].p_memsz;
+    }
+    if (hi == 0)
+    {
+        seterr(errbuf, errlen, "%s: no PT_LOAD segments", path);
+        goto fail;
+    }
+    hi = (hi + LSO_PAGE - 1) & ~(LSO_PAGE - 1);
+    so->mapsize = hi - lo;
+    so->allocsize = so->mapsize + LSO_PAGE;
+    /* Plain exec memory is executable on every AROS target LoadSeg works on. */
+    so->alloc = AllocMem(so->allocsize, MEMF_ANY | MEMF_CLEAR);
+    if (!so->alloc)
+    {
+        seterr(errbuf, errlen, "%s: cannot allocate %lu bytes for the image",
+               path, (unsigned long)so->allocsize);
+        goto fail;
+    }
+    so->base = (((uintptr_t)so->alloc + LSO_PAGE - 1) & ~(LSO_PAGE - 1)) - lo;
+    LSO_DEBUG("%s: image %lu bytes at %p (bias %p)", path,
+              (unsigned long)so->mapsize, (void *)(so->base + lo), (void *)so->base);
+
+    /* map the segments */
+    for (i = 0; i < eh.e_phnum; i++)
+    {
+        lso_Phdr *p = &ph[i];
+
+        switch (p->p_type)
+        {
+        case LSO_PT_LOAD:
+            if (p->p_filesz &&
+                read_at(fd, (void *)(so->base + p->p_vaddr), p->p_filesz, p->p_offset) < 0)
+            {
+                seterr(errbuf, errlen, "%s: short read on segment %d", path, i);
+                goto fail;
+            }
+            if (so->nseg < (int)(sizeof(so->seg) / sizeof(so->seg[0])))
+            {
+                so->seg[so->nseg].start = (so->base + p->p_vaddr) & ~(LSO_PAGE - 1);
+                so->seg[so->nseg].end = (so->base + p->p_vaddr + p->p_memsz + LSO_PAGE - 1) & ~(LSO_PAGE - 1);
+                so->seg[so->nseg].flags = p->p_flags;
+                so->seg[so->nseg].offset = p->p_offset & ~(LSO_PAGE - 1);
+                so->nseg++;
+            }
+            LSO_DEBUG("  PT_LOAD %c%c%c vaddr %p filesz %lx memsz %lx",
+                      (p->p_flags & LSO_PF_R) ? 'r' : '-', (p->p_flags & LSO_PF_W) ? 'w' : '-',
+                      (p->p_flags & LSO_PF_X) ? 'x' : '-', (void *)(so->base + p->p_vaddr),
+                      (unsigned long)p->p_filesz, (unsigned long)p->p_memsz);
+            break;
+        case LSO_PT_DYNAMIC:
+            dyn = (const lso_Dyn *)(so->base + p->p_vaddr);
+            break;
+        case LSO_PT_TLS:
+            so->tls_image = (const void *)(so->base + p->p_vaddr);
+            so->tls_filesz = p->p_filesz;
+            so->tls_memsz = p->p_memsz;
+            so->tls_align = p->p_align ? p->p_align : 16;
+            break;
+        default:
+            break;
+        }
+    }
+    if (!dyn)
+    {
+        seterr(errbuf, errlen, "%s: no PT_DYNAMIC", path);
+        goto fail;
+    }
+    if (so->tls_memsz)
+    {
+        if (lso_next_tls_modid > LSO_MAX_TLS_MODULES)
+        {
+            seterr(errbuf, errlen, "%s: too many TLS modules", path);
+            goto fail;
+        }
+        so->tls_modid = lso_next_tls_modid++;
+        LSO_DEBUG("  PT_TLS image %p filesz %lx memsz %lx align %lx -> module %u",
+                  so->tls_image, (unsigned long)so->tls_filesz, (unsigned long)so->tls_memsz,
+                  (unsigned long)so->tls_align, so->tls_modid);
+    }
+
+    /* dynamic section */
+    for (; dyn->d_tag != LSO_DT_NULL; dyn++)
+    {
+        switch (dyn->d_tag)
+        {
+        case LSO_DT_STRTAB:     so->strtab = (const char *)(so->base + dyn->d_val); break;
+        case LSO_DT_SYMTAB:     so->symtab = (const lso_Sym *)(so->base + dyn->d_val); break;
+        case LSO_DT_HASH:       so->hash = (const uint32_t *)(so->base + dyn->d_val); break;
+        case LSO_DT_RELA:       rela = (const lso_Rela *)(so->base + dyn->d_val); break;
+        case LSO_DT_RELASZ:     relasz = dyn->d_val; break;
+        case LSO_DT_JMPREL:     jmprel = (const lso_Rela *)(so->base + dyn->d_val); break;
+        case LSO_DT_PLTRELSZ:   pltrelsz = dyn->d_val; break;
+        case LSO_DT_INIT:       so->init = (void (*)(void))(so->base + dyn->d_val); break;
+        case LSO_DT_FINI:       so->fini = (void (*)(void))(so->base + dyn->d_val); break;
+        case LSO_DT_INIT_ARRAY: so->init_array = (void (**)(void))(so->base + dyn->d_val); break;
+        case LSO_DT_INIT_ARRAYSZ: so->init_array_n = dyn->d_val / sizeof(void *); break;
+        case LSO_DT_FINI_ARRAY: so->fini_array = (void (**)(void))(so->base + dyn->d_val); break;
+        case LSO_DT_FINI_ARRAYSZ: so->fini_array_n = dyn->d_val / sizeof(void *); break;
+        case LSO_DT_NEEDED:
+            LSO_DEBUG("  NEEDED %s (provided by the shim)", so->strtab ? so->strtab + dyn->d_val : "?");
+            break;
+        default:
+            break;
+        }
+    }
+    if (!so->strtab || !so->symtab)
+    {
+        seterr(errbuf, errlen, "%s: no dynamic symbol table", path);
+        goto fail;
+    }
+    if (!so->hash)
+    {
+        seterr(errbuf, errlen, "%s: no DT_HASH (DT_GNU_HASH only is not supported)", path);
+        goto fail;
+    }
+
+    /* relocate */
+    missing[0] = 0;
+    if (apply_relocs(so, rela, relasz / sizeof(lso_Rela), missing, sizeof(missing)) +
+        apply_relocs(so, jmprel, pltrelsz / sizeof(lso_Rela), missing, sizeof(missing)))
+    {
+        seterr(errbuf, errlen, "%s: unresolved symbols: %s", path, missing);
+        goto fail;
+    }
+    LSO_DEBUG("  relocated %lu + %lu entries", (unsigned long)(relasz / sizeof(lso_Rela)),
+              (unsigned long)(pltrelsz / sizeof(lso_Rela)));
+
+    /* .eh_frame: let the program's libgcc unwind through the object */
+    if (eh.e_shoff && eh.e_shentsize == sizeof(lso_Shdr) && eh.e_shnum && eh.e_shnum < 512 &&
+        eh.e_shstrndx < eh.e_shnum)
+    {
+        sh = AllocVec(eh.e_shnum * sizeof(lso_Shdr), MEMF_ANY);
+        if (sh && read_at(fd, sh, eh.e_shnum * sizeof(lso_Shdr), eh.e_shoff) == 0)
+        {
+            shstr = AllocVec(sh[eh.e_shstrndx].sh_size + 1, MEMF_ANY | MEMF_CLEAR);
+            if (shstr && read_at(fd, shstr, sh[eh.e_shstrndx].sh_size, sh[eh.e_shstrndx].sh_offset) == 0)
+            {
+                for (i = 0; i < eh.e_shnum; i++)
+                {
+                    if (sh[i].sh_name < sh[eh.e_shstrndx].sh_size &&
+                        strcmp(shstr + sh[i].sh_name, ".eh_frame") == 0 && sh[i].sh_addr)
+                    {
+                        so->eh_frame = (void *)(so->base + sh[i].sh_addr);
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    if (so->eh_frame)
+    {
+        so->eh_object = AllocMem(64, MEMF_ANY | MEMF_CLEAR);
+        if (so->eh_object)
+            __register_frame_info(so->eh_frame, so->eh_object);
+        LSO_DEBUG("  .eh_frame at %p registered", so->eh_frame);
+    }
+    else
+        LSO_DEBUG("  no .eh_frame section found; C++ exceptions inside the object will terminate");
+
+    FreeVec(shstr);
+    FreeVec(sh);
+    FreeVec(ph);
+    close(fd);
+    shstr = NULL; sh = NULL; ph = NULL; fd = -1;
+
+    ObtainSemaphore(&lso_lock);
+    AddHead((struct List *)&lso_objects, (struct Node *)&so->node);
+    ReleaseSemaphore(&lso_lock);
+
+    /* constructors */
+    if (so->init)
+    {
+        LSO_DEBUG("  DT_INIT %p", so->init);
+        so->init();
+    }
+    for (i = 0; i < (int)so->init_array_n; i++)
+    {
+        if (so->init_array[i] && (uintptr_t)so->init_array[i] != ~(uintptr_t)0)
+        {
+            LSO_DEBUG("  init_array[%d] %p", i, so->init_array[i]);
+            so->init_array[i]();
+        }
+    }
+    LSO_DEBUG("%s: loaded", path);
+    return so;
+
+fail:
+    FreeVec(shstr);
+    FreeVec(sh);
+    FreeVec(ph);
+    if (fd >= 0)
+        close(fd);
+    if (so->tls_modid && so->tls_modid == lso_next_tls_modid - 1)
+        lso_next_tls_modid--;
+    free_object(so);
+    return NULL;
+}
+
+int linuxso_close(struct LinuxSO *so)
+{
+    int i;
+
+    if (!so)
+        return -1;
+    if (--so->refcount > 0)
+        return 0;
+
+    for (i = (int)so->fini_array_n - 1; i >= 0; i--)
+        if (so->fini_array[i] && (uintptr_t)so->fini_array[i] != ~(uintptr_t)0)
+            so->fini_array[i]();
+    if (so->fini)
+        so->fini();
+    run_atexit(so);
+
+    ObtainSemaphore(&lso_lock);
+    Remove((struct Node *)&so->node);
+    ReleaseSemaphore(&lso_lock);
+
+    if (so->eh_frame && so->eh_object)
+        __deregister_frame_info(so->eh_frame);
+    LSO_DEBUG("%s: unloaded", so->path);
+    free_object(so);
+    return 0;
+}
+
+/* /proc/self/maps as the guest expects it: one line per mapped segment. */
+void lso_procfs_maps(char *buf, size_t len)
+{
+    struct LinuxSO *so;
+    size_t used = 0;
+    int i;
+
+    buf[0] = 0;
+    ObtainSemaphoreShared(&lso_lock);
+    ForeachNode(&lso_objects, so)
+    {
+        for (i = 0; i < so->nseg && used < len; i++)
+        {
+            used += snprintf(buf + used, len - used, "%08lx-%08lx %c%c%cp %08lx 00:00 0 %s\n",
+                             (unsigned long)so->seg[i].start, (unsigned long)so->seg[i].end,
+                             (so->seg[i].flags & LSO_PF_R) ? 'r' : '-',
+                             (so->seg[i].flags & LSO_PF_W) ? 'w' : '-',
+                             (so->seg[i].flags & LSO_PF_X) ? 'x' : '-',
+                             (unsigned long)so->seg[i].offset,
+                             so->unixpath ? so->unixpath : "");
+        }
+    }
+    ReleaseSemaphore(&lso_lock);
+}
diff --git a/compiler/linuxso/lso_file.c b/compiler/linuxso/lso_file.c
new file mode 100644
index 00000000..f075b9df
--- /dev/null
+++ b/compiler/linuxso/lso_file.c
@@ -0,0 +1,356 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso file ABI: Linux open flags and struct stat64 layout on top of
+    posixc, plus the handful of /proc and /sys files the guest reads
+    (synthesised into T: so the ordinary read/close path serves them).
+*/
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "linuxso_intern.h"
+#include "lso_lx.h"
+
+
+/* Linux x86-64 open(2) flags */
+#define LX_O_ACCMODE   03
+#define LX_O_WRONLY    01
+#define LX_O_RDWR      02
+#define LX_O_CREAT     0100
+#define LX_O_EXCL      0200
+#define LX_O_TRUNC     01000
+#define LX_O_APPEND    02000
+#define LX_O_NONBLOCK  04000
+#define LX_O_DIRECTORY 0200000
+#define LX_O_NOFOLLOW  0400000
+#define LX_O_CLOEXEC   02000000
+
+int lso_open_flags_to_aros(int lx)
+{
+    int f;
+
+    switch (lx & LX_O_ACCMODE)
+    {
+    case LX_O_WRONLY: f = O_WRONLY; break;
+    case LX_O_RDWR:   f = O_RDWR; break;
+    default:          f = O_RDONLY; break;
+    }
+    if (lx & LX_O_CREAT)     f |= O_CREAT;
+    if (lx & LX_O_EXCL)      f |= O_EXCL;
+    if (lx & LX_O_TRUNC)     f |= O_TRUNC;
+    if (lx & LX_O_APPEND)    f |= O_APPEND;
+    if (lx & LX_O_NONBLOCK)  f |= O_NONBLOCK;
+    if (lx & LX_O_DIRECTORY) f |= O_DIRECTORY;
+    if (lx & LX_O_NOFOLLOW)  f |= O_NOFOLLOW;
+    if (lx & LX_O_CLOEXEC)   f |= O_CLOEXEC;
+    return f;
+}
+
+/* ---- synthetic /proc and /sys ------------------------------------------- */
+
+static int synth_counter;
+
+/*
+ * Returns a T: path holding the content of a /proc or /sys file the guest
+ * asked for, or NULL when the name is not one we serve.  buf receives the
+ * path.
+ */
+static const char *synth_path(const char *path, char *buf, size_t buflen)
+{
+    char *content = NULL;
+    size_t len = 0;
+    BPTR fh;
+    char small[64];
+
+    if (strcmp(path, "/proc/self/maps") == 0)
+    {
+        content = AllocVec(8192, MEMF_ANY | MEMF_CLEAR);
+        if (!content)
+            return NULL;
+        lso_procfs_maps(content, 8192);
+        len = strlen(content);
+    }
+    else if (strcmp(path, "/sys/devices/system/cpu/present") == 0 ||
+             strcmp(path, "/sys/devices/system/cpu/online") == 0 ||
+             strcmp(path, "/sys/devices/system/cpu/possible") == 0)
+    {
+        unsigned int n = lso_ncpus();
+        snprintf(small, sizeof(small), n > 1 ? "0-%u\n" : "0\n", n - 1);
+        content = small;
+        len = strlen(small);
+    }
+    else if (strcmp(path, "/proc/self/cmdline") == 0)
+    {
+        content = small;
+        len = snprintf(small, sizeof(small), "chromium") + 1;
+    }
+    else
+        return NULL;
+
+    snprintf(buf, buflen, "T:linuxso.%p.%d", FindTask(NULL), __sync_add_and_fetch(&synth_counter, 1));
+    fh = Open(buf, MODE_NEWFILE);
+    if (fh)
+    {
+        Write(fh, content, len);
+        Close(fh);
+    }
+    if (content != small)
+        FreeVec(content);
+    LSO_DEBUG("synthesised %s -> %s (%lu bytes)", path, buf, (unsigned long)len);
+    return fh ? buf : NULL;
+}
+
+static int is_proc_or_sys(const char *path)
+{
+    return strncmp(path, "/proc/", 6) == 0 || strncmp(path, "/sys/", 5) == 0 ||
+           strcmp(path, "/proc") == 0 || strcmp(path, "/sys") == 0 ||
+           (strncmp(path, "/dev/", 5) == 0 && strcmp(path, "/dev/null") != 0);
+}
+
+/* ---- /dev/urandom ---------------------------------------------------------
+ * A real fd number (NIL: underneath) whose reads are answered with random
+ * bytes for as long as the guest keeps asking; BoringSSL aborts on a short
+ * read, so a file snapshot would not do.
+ */
+#define LSO_MAX_RANDOM_FDS 8
+static int random_fds[LSO_MAX_RANDOM_FDS];   /* fd + 1, 0 = free */
+
+static int random_open(void)
+{
+    int fd = open("NIL:", O_RDONLY), i;
+
+    if (fd < 0)
+        return -1;
+    Forbid();
+    for (i = 0; i < LSO_MAX_RANDOM_FDS; i++)
+        if (!random_fds[i])
+        {
+            random_fds[i] = fd + 1;
+            break;
+        }
+    Permit();
+    if (i == LSO_MAX_RANDOM_FDS)
+    {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+static int random_slot(int fd)
+{
+    int i;
+
+    for (i = 0; i < LSO_MAX_RANDOM_FDS; i++)
+        if (random_fds[i] == fd + 1)
+            return i;
+    return -1;
+}
+
+int lso_open(const char *path, int lxflags, int mode)
+{
+    char tmp[64];
+    int fd;
+
+    if (strcmp(path, "/dev/urandom") == 0 || strcmp(path, "/dev/random") == 0)
+    {
+        fd = random_open();
+        LSO_DEBUG("open(%s) -> random fd %d", path, fd);
+        if (fd < 0)
+            lso_set_errno(LX_EMFILE);
+        return fd;
+    }
+    if (is_proc_or_sys(path))
+    {
+        const char *p = synth_path(path, tmp, sizeof(tmp));
+        if (!p)
+        {
+            LSO_DEBUG("open(%s) -> ENOENT (not synthesised)", path);
+            lso_set_errno(LX_ENOENT);
+            return -1;
+        }
+        fd = open(p, O_RDONLY);
+    }
+    else
+        fd = open(path, lso_open_flags_to_aros(lxflags), mode);
+
+    if (fd < 0)
+    {
+        LSO_DEBUG("open(%s, %#o) -> errno %d", path, lxflags, errno);
+        lso_set_errno_from_aros();
+        return -1;
+    }
+    LSO_DEBUG("open(%s, %#o) -> %d", path, lxflags, fd);
+    return fd;
+}
+
+FILE *lso_fopen(const char *path, const char *fmode)
+{
+    char tmp[64];
+    FILE *f;
+
+    if (is_proc_or_sys(path))
+    {
+        const char *p = synth_path(path, tmp, sizeof(tmp));
+        if (!p)
+        {
+            LSO_DEBUG("fopen(%s) -> ENOENT (not synthesised)", path);
+            lso_set_errno(LX_ENOENT);
+            return NULL;
+        }
+        f = fopen(p, "r");
+    }
+    else
+        f = fopen(path, fmode);
+    if (!f)
+        lso_set_errno_from_aros();
+    LSO_DEBUG("fopen(%s, %s) -> %p", path, fmode, f);
+    return f;
+}
+
+/* ---- struct stat64 -------------------------------------------------------- */
+
+struct lx_stat64 {
+    uint64_t st_dev;
+    uint64_t st_ino;
+    uint64_t st_nlink;
+    uint32_t st_mode;
+    uint32_t st_uid;
+    uint32_t st_gid;
+    uint32_t pad0;
+    uint64_t st_rdev;
+    int64_t st_size;
+    int64_t st_blksize;
+    int64_t st_blocks;
+    int64_t lx_atime, lx_atime_nsec;   /* glibc's st_atime is a macro */
+    int64_t lx_mtime, lx_mtime_nsec;
+    int64_t lx_ctime, lx_ctime_nsec;
+    int64_t reserved[3];
+};
+
+static void stat_convert(const struct stat *s, struct lx_stat64 *l)
+{
+    memset(l, 0, sizeof(*l));
+    l->st_dev = s->st_dev;
+    l->st_ino = s->st_ino;
+    l->st_nlink = s->st_nlink;
+    l->st_mode = s->st_mode;        /* S_IF* bits are the traditional octal values on both */
+    l->st_uid = s->st_uid;
+    l->st_gid = s->st_gid;
+    l->st_rdev = s->st_rdev;
+    l->st_size = s->st_size;
+    l->st_blksize = s->st_blksize ? s->st_blksize : 4096;
+    l->st_blocks = (s->st_size + 511) / 512;
+    l->lx_atime = s->st_atime;
+    l->lx_mtime = s->st_mtime;
+    l->lx_ctime = s->st_ctime;
+}
+
+int lso_stat_to_glibc(const char *path, int fd, void *out)
+{
+    struct stat s;
+    int r;
+
+    if (path)
+    {
+        if (is_proc_or_sys(path))
+        {
+            lso_set_errno(LX_ENOENT);
+            return -1;
+        }
+        r = stat(path, &s);
+    }
+    else
+        r = fstat(fd, &s);
+    if (r < 0)
+    {
+        LSO_DEBUG("stat(%s/%d) -> errno %d", path ? path : "-", fd, errno);
+        lso_set_errno_from_aros();
+        return -1;
+    }
+    stat_convert(&s, (struct lx_stat64 *)out);
+    return 0;
+}
+
+int lx_xstat64(int ver, const char *path, void *buf)   { (void)ver; return lso_stat_to_glibc(path, -1, buf); }
+int lx_lxstat64(int ver, const char *path, void *buf)  { (void)ver; return lso_stat_to_glibc(path, -1, buf); }
+int lx_fxstat64(int ver, int fd, void *buf)            { (void)ver; return lso_stat_to_glibc(NULL, fd, buf); }
+int lx_stat64(const char *path, void *buf)             { return lso_stat_to_glibc(path, -1, buf); }
+int lx_fstat64(int fd, void *buf)                      { return lso_stat_to_glibc(NULL, fd, buf); }
+
+/* ---- fd calls with errno translation ------------------------------------- */
+
+int lx_open64(const char *path, int flags, ...)
+{
+    int mode = 0;
+
+    if (flags & LX_O_CREAT)
+    {
+        __builtin_va_list ap;
+        __builtin_va_start(ap, flags);
+        mode = __builtin_va_arg(ap, int);
+        __builtin_va_end(ap);
+    }
+    return lso_open(path, flags, mode);
+}
+
+int lx_creat64(const char *path, int mode)
+{
+    return lso_open(path, LX_O_WRONLY | LX_O_CREAT | LX_O_TRUNC, mode);
+}
+
+int lx_close(int fd)
+{
+    int r, slot = random_slot(fd);
+
+    if (slot >= 0)
+        random_fds[slot] = 0;
+    r = close(fd);
+    if (r < 0)
+        lso_set_errno_from_aros();
+    return r;
+}
+
+long lx_read(int fd, void *buf, size_t n)
+{
+    ssize_t r;
+
+    if (random_slot(fd) >= 0)
+        return lso_getrandom(buf, n);
+    r = read(fd, buf, n);
+    if (r < 0)
+        lso_set_errno_from_aros();
+    return r;
+}
+
+long lx_write(int fd, const void *buf, size_t n)
+{
+    ssize_t r = write(fd, buf, n);
+    if (r < 0)
+        lso_set_errno_from_aros();
+    return r;
+}
+
+long lx_pread64(int fd, void *buf, size_t n, int64_t off)
+{
+    ssize_t r = pread(fd, buf, n, (off_t)off);
+    if (r < 0)
+        lso_set_errno_from_aros();
+    return r;
+}
+
+int64_t lx_lseek64(int fd, int64_t off, int whence)
+{
+    off_t r = lseek(fd, (off_t)off, whence);
+    if (r < 0)
+        lso_set_errno_from_aros();
+    return r;
+}
