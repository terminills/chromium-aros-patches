+static long lx_syscall(long nr, ...)
+{
+    va_list ap;
+    long a[6], i, r;
+
+    va_start(ap, nr);
+    for (i = 0; i < 6; i++)
+        a[i] = va_arg(ap, long);
+    va_end(ap);
+    r = lso_syscall(nr, a[0], a[1], a[2], a[3], a[4], a[5]);
+    if (r < 0 && r > -4096)
+    {
+        lso_set_errno((int)-r);
+        return -1;
+    }
+    return r;
+}
