+/* GNU strerror_r: returns a string, not necessarily buf */
+static char *lx_strerror_r(int lx, char *buf, size_t len)
+{
+    const char *t = lx_strerror_text(lx);
+
+    if (t)
+        return (char *)t;
+    snprintf(buf, len, "Unknown error %d", lx);
+    return buf;
+}
