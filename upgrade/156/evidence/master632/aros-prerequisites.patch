+
+/* lso_shim.c */
+int lx_clock_gettime(int lx_clock, struct lx_timespec *ts);
+int lx_gettimeofday(struct lx_timeval *tv, void *tz);
+int lx_nanosleep(const struct lx_timespec *req, struct lx_timespec *rem);
+int lx_getrlimit64(int resource, void *r);
+int lx_uname(void *u);
+int lx_prctl(int option, unsigned long a2, unsigned long a3, unsigned long a4, unsigned long a5);
+
+/* lso_task.c */
+int *lso_errno_location(void);
+struct lso_tls_index;
+void *lso_tls_get_addr(struct lso_tls_index *ti);
+
+#endif /* LSO_LX_H */
diff --git a/compiler/linuxso/lso_mem.c b/compiler/linuxso/lso_mem.c
new file mode 100644
index 0000000000000000000000000000000000000000..6e4f8811a16c7ee810121ee9a330f37212f000b3
--- /dev/null
+++ b/compiler/linuxso/lso_mem.c
@@ -0,0 +1,750 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso mmap(2) family on exec memory.
+
+    Ordinary anonymous mappings come from AllocMem (page aligned) and
+    private file mappings are read in with pread; for those, protection
+    changes are accepted and ignored (AROS memory is RWX and the guest
+    only uses mprotect for W^X hygiene).
+
+    Address-space reservations are different: a guest allocator such as
+    PartitionAlloc reserves tens of GiB PROT_NONE up front and commits
+    small pieces later with mprotect(PROT_READ|PROT_WRITE), decommitting
+    them again with madvise(MADV_DONTNEED).  No amount of exec memory
+    satisfies that literally, so a reservation is a window that is backed
+    on demand:
+
+      hosted  - the host kernel does it; the window is a real host mmap
+                and mprotect/madvise/munmap on it go to the host too.
+      native  - the window lives above the kernel's identity map
+                (>= LSO_WINDOW_BASE, nothing else maps there) and each
+                2 MiB chunk is backed the first time it is committed,
+                with physical memory from AllocMem mapped in through
+                KrnMapGlobal.  Decommit zeroes the chunk (the MADV_DONTNEED
+                contract) but keeps it mapped: unmapping would need a TLB
+                shootdown on the other CPUs, and the address space is
+                reused by the allocator soon anyway.
+
+    Windows are handed out from a cursor shared by every process on the
+    machine (a named public semaphore), so no window is ever given out
+    twice per boot: a stale TLB entry left on another CPU by a finished
+    process can then never alias a live window.  At process exit the
+    windows still held are unmapped and their backing chunks returned.
+*/
+
+#include <proto/exec.h>
+#include <proto/kernel.h>
+#include <exec/memory.h>
+#include <exec/semaphores.h>
+#include <aros/symbolsets.h>
+
+#define __HOSTLIB_NOLIBBASE__
+#define __HOSTLIB_LIBBASE HostLibBase
+#include <proto/hostlib.h>
+
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "linuxso_intern.h"
+#include "lso_lx.h"
+
+#define LX_PROT_NONE    0
+#define LX_MAP_SHARED   0x01
+#define LX_MAP_PRIVATE  0x02
+#define LX_MAP_FIXED    0x10
+#define LX_MAP_ANON     0x20
+#define LX_MAP_FAILED   ((void *)-1)
+#define LX_MADV_DONTNEED 4
+
+/* anonymous PROT_NONE mappings at least this big are reservations */
+#define LSO_RESERVE_MIN   (64UL << 20)
+
+/* native windows: 2 MiB chunks (KrnMapGlobal's page size) carved from
+   arenas so that every chunk is physically 2 MiB aligned */
+#define LSO_CHUNK_SHIFT   21
+#define LSO_CHUNK         (1UL << LSO_CHUNK_SHIFT)
+#define LSO_ARENA_CHUNKS  16
+#define LSO_WINDOW_BASE   (2UL << 40)     /* 2 TiB: above the identity map and 64-bit BARs */
+#define LSO_WINDOW_LIMIT  (64UL << 40)    /* 64 TiB: stay well inside canonical space */
+
+struct lso_mapping {
+    struct MinNode node;
+    APTR alloc;
+    size_t allocsize;
+    uintptr_t start;
+    size_t len;
+};
+
+struct lso_reserve {
+    struct MinNode node;
+    uintptr_t start;        /* current extent, trimmed by partial munmap */
+    size_t len;
+    uintptr_t base;         /* the window as handed out (native) */
+    size_t span;
+    int hosted;
+    APTR *chunks;           /* native: backing of chunk i of the window, NULL = uncommitted */
+    unsigned nchunks;
+};
+
+/* one per arena of chunks, so they can be given back at exit */
+struct lso_arena {
+    struct MinNode node;
+    APTR raw;
+    size_t size;
+};
+
+/* the machine-wide window cursor, a named public semaphore */
+#define LSO_WINDOWS_NAME "linuxso.windows"
+struct lso_windows {
+    struct SignalSemaphore sem;
+    char name[sizeof(LSO_WINDOWS_NAME)];
+    uintptr_t next;
+};
+
+static struct MinList mappings;
+static struct MinList reserves;
+static struct MinList arenas;
+static struct SignalSemaphore map_lock;
+static int map_ready;
+
+static struct lso_windows *windows;
+
+/* host mmap family (hosted only) */
+static APTR HostLibBase;
+static void *host_libc;
+static struct {
+    void *(*mmap)(void *, size_t, int, int, int, long);
+    int (*munmap)(void *, size_t);
+    int (*mprotect)(void *, size_t, int);
+    int (*madvise)(void *, size_t, int);
+} host;
+
+/* free chunk pool (native) */
+static APTR *chunk_free;
+static unsigned chunk_free_n, chunk_free_cap;
+static APTR mem_KernelBase;
+
+static void map_init(void)
+{
+    Forbid();
+    if (!map_ready)
+    {
+        NEWLIST(&mappings);
+        NEWLIST(&reserves);
+        NEWLIST(&arenas);
+        InitSemaphore(&map_lock);
+        map_ready = 1;
+    }
+    Permit();
+}
+
+/* the shared window cursor, created by the first process that needs it */
+static struct lso_windows *windows_get(void)
+{
+    struct lso_windows *w;
+
+    if (windows)
+        return windows;
+    Forbid();
+    w = (struct lso_windows *)FindSemaphore(LSO_WINDOWS_NAME);
+    if (!w)
+    {
+        /* outlives this process, so the name lives inside it */
+        w = AllocMem(sizeof(*w), MEMF_PUBLIC | MEMF_CLEAR);
+        if (w)
+        {
+            strcpy(w->name, LSO_WINDOWS_NAME);
+            w->sem.ss_Link.ln_Name = w->name;
+            w->next = LSO_WINDOW_BASE;
+            AddSemaphore(&w->sem);
+        }
+    }
+    Permit();
+    windows = w;
+    return w;
+}
+
+/* ---- hosted: host mmap through hostlib.resource --------------------------- */
+
+static int host_init(void)
+{
+    char *err = NULL;
+
+    if (host.mmap)
+        return 1;
+    if (!HostLibBase)
+        HostLibBase = OpenResource("hostlib.resource");
+    if (!HostLibBase)
+        return 0;
+    host_libc = HostLib_Open("libc.so.6", &err);
+    if (!host_libc)
+    {
+        LSO_DEBUG("HostLib_Open(libc.so.6) failed: %s", err ? err : "?");
+        if (err)
+            HostLib_FreeErrorStr(err);
+        return 0;
+    }
+    host.munmap = HostLib_GetPointer(host_libc, "munmap", NULL);
+    host.mprotect = HostLib_GetPointer(host_libc, "mprotect", NULL);
+    host.madvise = HostLib_GetPointer(host_libc, "madvise", NULL);
+    host.mmap = HostLib_GetPointer(host_libc, "mmap", NULL);
+    if (!host.munmap || !host.mprotect || !host.madvise || !host.mmap)
+    {
+        LSO_DEBUG("host libc lacks the mmap family");
+        host.mmap = NULL;
+        return 0;
+    }
+    return 1;
+}
+
+/* ---- native: on-demand backed windows ------------------------------------- */
+
+static APTR chunk_alloc(void)
+{
+    APTR chunk = NULL;
+
+    Forbid();
+    if (chunk_free_n)
+        chunk = chunk_free[--chunk_free_n];
+    Permit();
+    if (chunk)
+        return chunk;
+
+    /* a new arena: LSO_ARENA_CHUNKS aligned chunks plus alignment slack;
+       the first aligned chunk is returned, the rest go to the pool */
+    {
+        size_t size = (LSO_ARENA_CHUNKS + 1) * LSO_CHUNK;
+        APTR raw = AllocMem(size, MEMF_ANY | MEMF_CLEAR);
+        struct lso_arena *arena;
+        uintptr_t first, i;
+
+        if (!raw)
+            return NULL;
+        arena = AllocMem(sizeof(*arena), MEMF_ANY);
+        if (!arena)
+        {
+            FreeMem(raw, size);
+            return NULL;
+        }
+        arena->raw = raw;
+        arena->size = size;
+        first = ((uintptr_t)raw + LSO_CHUNK - 1) & ~(LSO_CHUNK - 1);
+
+        Forbid();
+        if (chunk_free_n + LSO_ARENA_CHUNKS - 1 > chunk_free_cap)
+        {
+            unsigned cap = chunk_free_cap ? chunk_free_cap * 2 : 64;
+            APTR *n;
+            while (cap < chunk_free_n + LSO_ARENA_CHUNKS - 1)
+                cap *= 2;
+            n = AllocMem(cap * sizeof(APTR), MEMF_ANY);
+            if (!n)
+            {
+                Permit();
+                FreeMem(arena, sizeof(*arena));
+                FreeMem(raw, size);
+                return NULL;
+            }
+            if (chunk_free)
+            {
+                memcpy(n, chunk_free, chunk_free_n * sizeof(APTR));
+                FreeMem(chunk_free, chunk_free_cap * sizeof(APTR));
+            }
+            chunk_free = n;
+            chunk_free_cap = cap;
+        }
+        for (i = 1; i < LSO_ARENA_CHUNKS; i++)
+            chunk_free[chunk_free_n++] = (APTR)(first + i * LSO_CHUNK);
+        AddTail((struct List *)&arenas, (struct Node *)&arena->node);
+        Permit();
+        LSO_DEBUG("chunk arena %p (+%lu MiB)", raw, (unsigned long)(size >> 20));
+        return (APTR)first;
+    }
+}
+
+static void chunk_release(APTR chunk)
+{
+    /* the chunk stays mapped in its window; it only returns to the pool
+       when the whole window goes away, and then it is zeroed first */
+    memset(chunk, 0, LSO_CHUNK);
+    Forbid();
+    if (chunk_free_n < chunk_free_cap)
+        chunk_free[chunk_free_n++] = chunk;
+    Permit();
+}
+
+/* back every chunk of the window touching [addr, addr+len) */
+static int window_commit(struct lso_reserve *r, uintptr_t addr, size_t len)
+{
+    uintptr_t first = (addr - r->base) >> LSO_CHUNK_SHIFT;
+    uintptr_t last = (addr + len - 1 - r->base) >> LSO_CHUNK_SHIFT;
+    uintptr_t i;
+    APTR KernelBase;
+
+    if (!mem_KernelBase)
+        mem_KernelBase = OpenResource("kernel.resource");
+    KernelBase = mem_KernelBase;
+    if (!KernelBase)
+        return -1;
+
+    for (i = first; i <= last && i < r->nchunks; i++)
+    {
+        APTR chunk, phys;
+        void *virt = (void *)(r->base + (i << LSO_CHUNK_SHIFT));
+
+        if (r->chunks[i])
+            continue;
+        chunk = chunk_alloc();
+        if (!chunk)
+        {
+            LSO_DEBUG("window %p: no memory for chunk %lu", (void *)r->base, (unsigned long)i);
+            return -1;
+        }
+        phys = KrnVirtualToPhysical(chunk);
+        if (KrnMapGlobal(virt, phys, LSO_CHUNK, MAP_Readable | MAP_Writable | MAP_Executable) != 0)
+        {
+            LSO_DEBUG("window %p: KrnMapGlobal(%p <- %p) failed", (void *)r->base, virt, phys);
+            chunk_release(chunk);
+            return -1;
+        }
+        r->chunks[i] = chunk;
+    }
+    return 0;
+}
+
+/* MADV_DONTNEED: the pages read as zero afterwards */
+static void window_discard(struct lso_reserve *r, uintptr_t addr, size_t len)
+{
+    uintptr_t end = addr + len, cur = addr;
+
+    while (cur < end)
+    {
+        uintptr_t i = (cur - r->base) >> LSO_CHUNK_SHIFT;
+        uintptr_t cend = r->base + ((i + 1) << LSO_CHUNK_SHIFT);
+        size_t n = (cend < end ? cend : end) - cur;
+
+        if (i < r->nchunks && r->chunks[i])
+            memset((void *)cur, 0, n);
+        cur += n;
+    }
+}
+
+static void *reserve_alloc(size_t len, int prot, int flags)
+{
+    struct lso_reserve *r = AllocMem(sizeof(*r), MEMF_ANY | MEMF_CLEAR);
+
+    if (!r)
+    {
+        lso_set_errno(LX_ENOMEM);
+        return LX_MAP_FAILED;
+    }
+
+    if (host_init())
+    {
+        void *p;
+
+        HostLib_Lock();
+        p = host.mmap(NULL, len, prot, flags & ~LX_MAP_FIXED, -1, 0);
+        HostLib_Unlock();
+        if (p == LX_MAP_FAILED)
+        {
+            FreeMem(r, sizeof(*r));
+            LSO_DEBUG("host mmap(%lx) failed", (unsigned long)len);
+            lso_set_errno(LX_ENOMEM);
+            return LX_MAP_FAILED;
+        }
+        r->hosted = 1;
+        r->start = r->base = (uintptr_t)p;
+        r->len = r->span = len;
+        LSO_DEBUG("reserve(%lx) -> host %p", (unsigned long)len, p);
+    }
+    else
+    {
+        /* hand out windows aligned to their own size (up to 64 GiB) so an
+           allocator's aligned-reservation dance succeeds first time */
+        size_t span = (len + LSO_CHUNK - 1) & ~(LSO_CHUNK - 1);
+        size_t align = LSO_CHUNK;
+        struct lso_windows *w = windows_get();
+        uintptr_t base;
+
+        if (!w)
+        {
+            FreeMem(r, sizeof(*r));
+            lso_set_errno(LX_ENOMEM);
+            return LX_MAP_FAILED;
+        }
+        while (align < span && align < (64UL << 30))
+            align <<= 1;
+
+        ObtainSemaphore(&w->sem);
+        base = (w->next + align - 1) & ~(align - 1);
+        if (base + span > LSO_WINDOW_LIMIT)
+        {
+            ReleaseSemaphore(&w->sem);
+            FreeMem(r, sizeof(*r));
+            LSO_DEBUG("reserve(%lx): window space exhausted", (unsigned long)len);
+            lso_set_errno(LX_ENOMEM);
+            return LX_MAP_FAILED;
+        }
+        w->next = base + span;
+        ReleaseSemaphore(&w->sem);
+
+        r->nchunks = span >> LSO_CHUNK_SHIFT;
+        r->chunks = AllocMem(r->nchunks * sizeof(APTR), MEMF_ANY | MEMF_CLEAR);
+        if (!r->chunks)
+        {
+            FreeMem(r, sizeof(*r));
+            lso_set_errno(LX_ENOMEM);
+            return LX_MAP_FAILED;
+        }
+        r->start = r->base = base;
+        r->len = r->span = span;
+        LSO_DEBUG("reserve(%lx) -> window %p (%u chunks)", (unsigned long)len, (void *)base, r->nchunks);
+
+        if (prot != LX_PROT_NONE && window_commit(r, base, span) != 0)
+        {
+            FreeMem(r->chunks, r->nchunks * sizeof(APTR));
+            FreeMem(r, sizeof(*r));
+            lso_set_errno(LX_ENOMEM);
+            return LX_MAP_FAILED;
+        }
+    }
+
+    ObtainSemaphore(&map_lock);
+    AddHead((struct List *)&reserves, (struct Node *)&r->node);
+    ReleaseSemaphore(&map_lock);
+    return (void *)r->start;
+}
+
+/* the reservation containing [addr, addr+len), or NULL; map_lock held */
+static struct lso_reserve *reserve_find(uintptr_t addr, size_t len)
+{
+    struct lso_reserve *r;
+
+    ForeachNode(&reserves, r)
+        if (addr >= r->start && addr + len <= r->start + r->len)
+            return r;
+    return NULL;
+}
+
+static void reserve_free(struct lso_reserve *r)
+{
+    if (r->hosted)
+    {
+        HostLib_Lock();
+        host.munmap((void *)r->start, r->len);
+        HostLib_Unlock();
+    }
+    else
+    {
+        unsigned i;
+        for (i = 0; i < r->nchunks; i++)
+            if (r->chunks[i])
+                chunk_release(r->chunks[i]);
+        FreeMem(r->chunks, r->nchunks * sizeof(APTR));
+    }
+    FreeMem(r, sizeof(*r));
+}
+
+/* ---- mmap ----------------------------------------------------------------- */
+
+void *lso_mmap(void *addr, size_t len, int prot, int flags, int fd, int64_t off)
+{
+    struct lso_mapping *m;
+    size_t rlen = (len + LSO_PAGE - 1) & ~(LSO_PAGE - 1);
+
+    map_init();
+    if (!len)
+    {
+        lso_set_errno(LX_EINVAL);
+        return LX_MAP_FAILED;
+    }
+    if ((flags & LX_MAP_FIXED) && addr)
+    {
+        /* MAP_FIXED over our own anonymous mapping is what a guest allocator
+           does to commit/decommit; the memory is there already */
+        struct lso_mapping *n;
+        struct lso_reserve *r;
+        int inside = 0;
+
+        ObtainSemaphoreShared(&map_lock);
+        r = reserve_find((uintptr_t)addr, rlen);
+        ForeachNode(&mappings, n)
+        {
+            if ((uintptr_t)addr >= n->start && (uintptr_t)addr + rlen <= n->start + n->len)
+            {
+                inside = 1;
+                break;
+            }
+        }
+        ReleaseSemaphore(&map_lock);
+        if (r && (flags & LX_MAP_ANON))
+        {
+            if (r->hosted)
+            {
+                void *p;
+                HostLib_Lock();
+                p = host.mmap(addr, rlen, prot, flags, -1, 0);
+                HostLib_Unlock();
+                LSO_DEBUG("mmap(FIXED %p, %lx) in host reservation -> %p", addr, (unsigned long)rlen, p);
+                if (p == LX_MAP_FAILED)
+                    lso_set_errno(LX_ENOMEM);
+                return p;
+            }
+            if (prot != LX_PROT_NONE && window_commit(r, (uintptr_t)addr, rlen) != 0)
+            {
+                lso_set_errno(LX_ENOMEM);
+                return LX_MAP_FAILED;
+            }
+            window_discard(r, (uintptr_t)addr, rlen);
+            LSO_DEBUG("mmap(FIXED %p, %lx) in window", addr, (unsigned long)rlen);
+            return addr;
+        }
+        if (inside && (flags & LX_MAP_ANON))
+        {
+            memset(addr, 0, rlen);
+            LSO_DEBUG("mmap(FIXED %p, %lx) inside existing mapping", addr, (unsigned long)rlen);
+            return addr;
+        }
+        LSO_DEBUG("mmap(FIXED %p, %lx) refused", addr, (unsigned long)rlen);
+        lso_set_errno(LX_EINVAL);
+        return LX_MAP_FAILED;
+    }
+    if (!(flags & LX_MAP_ANON) && (flags & LX_MAP_SHARED))
+    {
+        LSO_DEBUG("mmap(fd %d, MAP_SHARED) unsupported", fd);
+        lso_set_errno(LX_ENOTSUP);
+        return LX_MAP_FAILED;
+    }
+    if ((flags & LX_MAP_ANON) && prot == LX_PROT_NONE && rlen >= LSO_RESERVE_MIN)
+        return reserve_alloc(rlen, prot, flags);
+
+    m = AllocMem(sizeof(*m), MEMF_ANY | MEMF_CLEAR);
+    if (!m)
+    {
+        lso_set_errno(LX_ENOMEM);
+        return LX_MAP_FAILED;
+    }
+    m->allocsize = rlen + LSO_PAGE;
+    m->alloc = AllocMem(m->allocsize, MEMF_ANY | MEMF_CLEAR);
+    if (!m->alloc)
+    {
+        FreeMem(m, sizeof(*m));
+        LSO_DEBUG("mmap(%lx) out of memory", (unsigned long)rlen);
+        lso_set_errno(LX_ENOMEM);
+        return LX_MAP_FAILED;
+    }
+    m->start = ((uintptr_t)m->alloc + LSO_PAGE - 1) & ~(LSO_PAGE - 1);
+    m->len = rlen;
+
+    if (!(flags & LX_MAP_ANON))
+    {
+        size_t done = 0;
+        while (done < len)
+        {
+            ssize_t n = pread(fd, (char *)m->start + done, len - done, (off_t)(off + done));
+            if (n < 0)
+            {
+                lso_set_errno_from_aros();
+                FreeMem(m->alloc, m->allocsize);
+                FreeMem(m, sizeof(*m));
+                return LX_MAP_FAILED;
+            }
+            if (n == 0)
+                break;
+            done += n;
+        }
+        LSO_DEBUG("mmap(fd %d, off %lx, %lx) -> %p (%lu bytes read)", fd, (unsigned long)off,
+                  (unsigned long)rlen, (void *)m->start, (unsigned long)done);
+    }
+    else
+        LSO_DEBUG("mmap(anon %lx, prot %x, flags %x) -> %p", (unsigned long)rlen, prot, flags, (void *)m->start);
+
+    ObtainSemaphore(&map_lock);
+    AddHead((struct List *)&mappings, (struct Node *)&m->node);
+    ReleaseSemaphore(&map_lock);
+    return (void *)m->start;
+}
+
+int lso_munmap(void *addr, size_t len)
+{
+    struct lso_mapping *m, *found = NULL;
+    struct lso_reserve *r, *rfree = NULL;
+    uintptr_t a = (uintptr_t)addr;
+    size_t rlen = (len + LSO_PAGE - 1) & ~(LSO_PAGE - 1);
+
+    map_init();
+    ObtainSemaphore(&map_lock);
+    r = reserve_find(a, rlen);
+    if (r)
+    {
+        if (a == r->start && rlen >= r->len)
+        {
+            Remove((struct Node *)&r->node);
+            rfree = r;
+        }
+        else if (a == r->start)
+        {
+            /* head trim (an allocator aligning its reservation) */
+            r->start += rlen;
+            r->len -= rlen;
+        }
+        else if (a + rlen == r->start + r->len)
+            r->len -= rlen;       /* tail trim */
+        /* a hole in the middle: the range stays reserved, nothing lost */
+        if (!rfree && r->hosted)
+        {
+            HostLib_Lock();
+            host.munmap(addr, rlen);
+            HostLib_Unlock();
+        }
+        ReleaseSemaphore(&map_lock);
+        LSO_DEBUG("munmap(%p, %lx) %s reservation", addr, (unsigned long)rlen, rfree ? "frees" : "trims");
+        if (rfree)
+            reserve_free(rfree);
+        return 0;
+    }
+    ForeachNode(&mappings, m)
+    {
+        if (m->start == a)
+        {
+            found = m;
+            break;
+        }
+    }
+    if (found)
+    {
+        if (len < found->len)
+        {
+            /* partial unmap at the front: keep the block, nothing to give back */
+            LSO_DEBUG("munmap(%p, %lx) partial of %lx: kept", addr, (unsigned long)len, (unsigned long)found->len);
+            found = NULL;
+        }
+        else
+            Remove((struct Node *)&found->node);
+    }
+    ReleaseSemaphore(&map_lock);
+
+    if (found)
+    {
+        LSO_DEBUG("munmap(%p, %lx)", addr, (unsigned long)len);
+        FreeMem(found->alloc, found->allocsize);
+        FreeMem(found, sizeof(*found));
+        return 0;
+    }
+    /* unmapping a tail or the middle of a mapping: accepted, memory stays */
+    return 0;
+}
+
+void *lx_mmap64(void *addr, size_t len, int prot, int flags, int fd, int64_t off)
+{
+    return lso_mmap(addr, len, prot, flags, fd, off);
+}
+
+int lx_munmap(void *addr, size_t len)
+{
+    return lso_munmap(addr, len);
+}
+
+int lx_mprotect(void *addr, size_t len, int prot)
+{
+    struct lso_reserve *r;
+    int ret = 0;
+
+    map_init();
+    ObtainSemaphore(&map_lock);
+    r = reserve_find((uintptr_t)addr, len);
+    if (r)
+    {
+        if (r->hosted)
+        {
+            HostLib_Lock();
+            ret = host.mprotect(addr, len, prot);
+            HostLib_Unlock();
+        }
+        else if (prot != LX_PROT_NONE)
+            ret = window_commit(r, (uintptr_t)addr, len);
+    }
+    ReleaseSemaphore(&map_lock);
+    if (ret != 0)
+    {
+        LSO_DEBUG("mprotect(%p, %lx, %x) failed", addr, (unsigned long)len, prot);
+        lso_set_errno(LX_ENOMEM);
+        return -1;
+    }
+    return 0;
+}
+
+int lx_madvise(void *addr, size_t len, int advice)
+{
+    struct lso_reserve *r;
+
+    map_init();
+    ObtainSemaphore(&map_lock);
+    r = reserve_find((uintptr_t)addr, len);
+    if (r)
+    {
+        if (r->hosted)
+        {
+            HostLib_Lock();
+            host.madvise(addr, len, advice);
+            HostLib_Unlock();
+        }
+        else if (advice == LX_MADV_DONTNEED)
+            window_discard(r, (uintptr_t)addr, len);
+    }
+    ReleaseSemaphore(&map_lock);
+    return 0;
+}
+
+/* ---- process exit --------------------------------------------------------- */
+
+/*
+ * Whatever the guest still holds goes back: windows are unmapped (the
+ * present bit cleared; the address range is never handed out again this
+ * boot, so no shootdown is needed) before their arenas return to exec.
+ */
+static void lso_mem_exit(void)
+{
+    struct lso_reserve *r, *r2;
+    struct lso_mapping *m, *m2;
+    struct lso_arena *a, *a2;
+    APTR KernelBase = mem_KernelBase;
+
+    if (!map_ready)
+        return;
+
+    ForeachNodeSafe(&reserves, r, r2)
+    {
+        if (!r->hosted && KernelBase)
+        {
+            unsigned i;
+            for (i = 0; i < r->nchunks; i++)
+                if (r->chunks[i])
+                    KrnMapGlobal((void *)(r->base + (i << LSO_CHUNK_SHIFT)), NULL, LSO_CHUNK, 0);
+        }
+        Remove((struct Node *)&r->node);
+        reserve_free(r);
+    }
+    ForeachNodeSafe(&mappings, m, m2)
+    {
+        Remove((struct Node *)&m->node);
+        if (m->alloc)
+            FreeMem(m->alloc, m->allocsize);
+        FreeMem(m, sizeof(*m));
+    }
+    ForeachNodeSafe(&arenas, a, a2)
+    {
+        Remove((struct Node *)&a->node);
+        FreeMem(a->raw, a->size);
+        FreeMem(a, sizeof(*a));
+    }
+    if (chunk_free)
+        FreeMem(chunk_free, chunk_free_cap * sizeof(APTR));
+    chunk_free = NULL;
+    chunk_free_n = chunk_free_cap = 0;
+}
+
+ADD2EXIT(lso_mem_exit, 0);
diff --git a/compiler/linuxso/lso_pthread.c b/compiler/linuxso/lso_pthread.c
new file mode 100644
index 0000000000000000000000000000000000000000..5a9718ecebbb8dea6ffc3180c400bd7ee276fd84
--- /dev/null
+++ b/compiler/linuxso/lso_pthread.c
@@ -0,0 +1,605 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso glibc pthread/semaphore ABI on top of the AROS pthread linklib.
+
+    glibc's synchronisation objects are much smaller than AROS's (mutex 40
+    vs 248 bytes, cond 48 vs 264, rwlock 56 vs 232, sem_t 32 vs 552), so
+    every guest object carries a pointer to a heap-allocated AROS object in
+    its first word.  Static initialisers are all-zero on glibc; the pointer
+    is created on first use under one global semaphore.
+*/
+
+#include <proto/exec.h>
+#include <exec/memory.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <string.h>
+#include <time.h>
+
+#include "linuxso_intern.h"
+#include "lso_lx.h"
+
+/* Linux values */
+#define LX_CLOCK_REALTIME  0
+#define LX_CLOCK_MONOTONIC 1
+#define LX_PTHREAD_CREATE_DETACHED 1
+#define LX_CPU_SETSIZE 1024
+
+
+static struct SignalSemaphore lazy_lock;
+static int lazy_lock_ready;
+
+static void lazy_init(void)
+{
+    Forbid();
+    if (!lazy_lock_ready)
+    {
+        InitSemaphore(&lazy_lock);
+        lazy_lock_ready = 1;
+    }
+    Permit();
+}
+
+/* ---- guest object layouts ------------------------------------------------ */
+
+struct lx_mutex {            /* 40 bytes on glibc */
+    pthread_mutex_t *impl;
+    uint32_t magic;
+    uint32_t pad;
+    int kind;                /* glibc __kind offset 16: static recursive initialiser sets 1 */
+    int pad2[3];
+};
+
+struct lx_cond {             /* 48 bytes */
+    pthread_cond_t *impl;
+    uint32_t magic;
+    int clock;               /* Linux clock id, set by pthread_cond_init */
+    uint64_t pad[4];
+};
+
+struct lx_rwlock {           /* 56 bytes */
+    pthread_rwlock_t *impl;
+    uint32_t magic;
+    uint32_t pad;
+    uint64_t pad2[5];
+};
+
+struct lx_sem {              /* 32 bytes */
+    sem_t *impl;
+    uint32_t magic;
+    uint32_t pad;
+    uint64_t pad2[2];
+};
+
+struct lx_attr {             /* 56 bytes */
+    uint32_t magic;
+    int detachstate;
+    size_t stacksize;
+    uint64_t pad[5];
+};
+
+struct lx_mutexattr { int kind; };
+struct lx_condattr { int value; };   /* (clock << 1) | 1 */
+
+#define LX_MAGIC_MUTEX 0x4d4f534c
+#define LX_MAGIC_COND  0x434f534c
+#define LX_MAGIC_RW    0x574f534c
+#define LX_MAGIC_SEM   0x534f534c
+#define LX_MAGIC_ATTR  0x414f534c
+
+/* ---- lazy creation -------------------------------------------------------- */
+
+static pthread_mutex_t *mutex_impl(struct lx_mutex *m)
+{
+    pthread_mutex_t *impl = *(pthread_mutex_t *volatile *)&m->impl;
+
+    if (impl)
+        return impl;
+    lazy_init();
+    ObtainSemaphore(&lazy_lock);
+    impl = m->impl;
+    if (!impl)
+    {
+        impl = AllocMem(sizeof(*impl), MEMF_ANY | MEMF_CLEAR);
+        if (impl)
+        {
+            pthread_mutexattr_t a;
+            pthread_mutexattr_init(&a);
+            pthread_mutexattr_settype(&a, m->kind == 1 ? PTHREAD_MUTEX_RECURSIVE :
+                                          m->kind == 2 ? PTHREAD_MUTEX_ERRORCHECK : PTHREAD_MUTEX_NORMAL);
+            pthread_mutex_init(impl, &a);
+            pthread_mutexattr_destroy(&a);
+            m->magic = LX_MAGIC_MUTEX;
+            __sync_synchronize();
+            m->impl = impl;
+        }
+    }
+    ReleaseSemaphore(&lazy_lock);
+    return impl;
+}
+
+static pthread_cond_t *cond_impl(struct lx_cond *c)
+{
+    pthread_cond_t *impl = *(pthread_cond_t *volatile *)&c->impl;
+
+    if (impl)
+        return impl;
+    lazy_init();
+    ObtainSemaphore(&lazy_lock);
+    impl = c->impl;
+    if (!impl)
+    {
+        impl = AllocMem(sizeof(*impl), MEMF_ANY | MEMF_CLEAR);
+        if (impl)
+        {
+            pthread_cond_init(impl, NULL);
+            c->magic = LX_MAGIC_COND;
+            __sync_synchronize();
+            c->impl = impl;
+        }
+    }
+    ReleaseSemaphore(&lazy_lock);
+    return impl;
+}
+
+static pthread_rwlock_t *rw_impl(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = *(pthread_rwlock_t *volatile *)&r->impl;
+
+    if (impl)
+        return impl;
+    lazy_init();
+    ObtainSemaphore(&lazy_lock);
+    impl = r->impl;
+    if (!impl)
+    {
+        impl = AllocMem(sizeof(*impl), MEMF_ANY | MEMF_CLEAR);
+        if (impl)
+        {
+            pthread_rwlock_init(impl, NULL);
+            r->magic = LX_MAGIC_RW;
+            __sync_synchronize();
+            r->impl = impl;
+        }
+    }
+    ReleaseSemaphore(&lazy_lock);
+    return impl;
+}
+
+/* ---- mutex ---------------------------------------------------------------- */
+
+int lx_pthread_mutexattr_init(struct lx_mutexattr *a)    { a->kind = 0; return 0; }
+int lx_pthread_mutexattr_destroy(struct lx_mutexattr *a) { (void)a; return 0; }
+int lx_pthread_mutexattr_settype(struct lx_mutexattr *a, int kind) { a->kind = kind; return 0; }
+
+int lx_pthread_mutex_init(struct lx_mutex *m, const struct lx_mutexattr *a)
+{
+    memset(m, 0, sizeof(*m));
+    m->kind = a ? a->kind : 0;
+    return mutex_impl(m) ? 0 : LX_ENOMEM;
+}
+
+int lx_pthread_mutex_destroy(struct lx_mutex *m)
+{
+    pthread_mutex_t *impl = m->impl;
+
+    if (impl)
+    {
+        m->impl = NULL;
+        pthread_mutex_destroy(impl);
+        FreeMem(impl, sizeof(*impl));
+    }
+    m->magic = 0;
+    return 0;
+}
+
+int lx_pthread_mutex_lock(struct lx_mutex *m)
+{
+    pthread_mutex_t *impl = mutex_impl(m);
+    return impl ? lso_pthread_ret(pthread_mutex_lock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_mutex_trylock(struct lx_mutex *m)
+{
+    pthread_mutex_t *impl = mutex_impl(m);
+    return impl ? lso_pthread_ret(pthread_mutex_trylock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_mutex_unlock(struct lx_mutex *m)
+{
+    pthread_mutex_t *impl = m->impl;
+    return impl ? lso_pthread_ret(pthread_mutex_unlock(impl)) : LX_EPERM;
+}
+
+/* ---- condition variables -------------------------------------------------- */
+
+int lx_pthread_condattr_init(struct lx_condattr *a)    { a->value = 1; return 0; }
+int lx_pthread_condattr_destroy(struct lx_condattr *a) { (void)a; return 0; }
+int lx_pthread_condattr_setclock(struct lx_condattr *a, int clock)
+{
+    if (clock != LX_CLOCK_REALTIME && clock != LX_CLOCK_MONOTONIC)
+        return LX_EINVAL;
+    a->value = (clock << 1) | 1;
+    return 0;
+}
+
+int lx_pthread_cond_init(struct lx_cond *c, const struct lx_condattr *a)
+{
+    memset(c, 0, sizeof(*c));
+    c->clock = a ? (a->value >> 1) : LX_CLOCK_REALTIME;
+    return cond_impl(c) ? 0 : LX_ENOMEM;
+}
+
+int lx_pthread_cond_destroy(struct lx_cond *c)
+{
+    pthread_cond_t *impl = c->impl;
+
+    if (impl)
+    {
+        c->impl = NULL;
+        pthread_cond_destroy(impl);
+        FreeMem(impl, sizeof(*impl));
+    }
+    c->magic = 0;
+    return 0;
+}
+
+int lx_pthread_cond_signal(struct lx_cond *c)
+{
+    pthread_cond_t *impl = cond_impl(c);
+    return impl ? lso_pthread_ret(pthread_cond_signal(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_cond_broadcast(struct lx_cond *c)
+{
+    pthread_cond_t *impl = cond_impl(c);
+    return impl ? lso_pthread_ret(pthread_cond_broadcast(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_cond_wait(struct lx_cond *c, struct lx_mutex *m)
+{
+    pthread_cond_t *impl = cond_impl(c);
+    pthread_mutex_t *mi = mutex_impl(m);
+
+    if (!impl || !mi)
+        return LX_ENOMEM;
+    return lso_pthread_ret(pthread_cond_wait(impl, mi));
+}
+
+int lx_pthread_cond_timedwait(struct lx_cond *c, struct lx_mutex *m, const struct lx_timespec *abstime)
+{
+    pthread_cond_t *impl = cond_impl(c);
+    pthread_mutex_t *mi = mutex_impl(m);
+    struct timespec now, rel;
+
+    if (!impl || !mi)
+        return LX_ENOMEM;
+    if (!abstime)
+        return lso_pthread_ret(pthread_cond_wait(impl, mi));
+    if (abstime->tv_nsec < 0 || abstime->tv_nsec >= 1000000000L)
+        return LX_EINVAL;
+
+    /* the guest's abstime is on the cond's clock; AROS wants a relative delay */
+    lso_clock_gettime(c->clock, &now);
+    rel.tv_sec = (time_t)(abstime->tv_sec - now.tv_sec);
+    rel.tv_nsec = abstime->tv_nsec - now.tv_nsec;
+    if (rel.tv_nsec < 0)
+    {
+        rel.tv_nsec += 1000000000L;
+        rel.tv_sec--;
+    }
+    if (rel.tv_sec < 0)
+        return LX_ETIMEDOUT;
+    return lso_pthread_ret(pthread_cond_timedwait_relative_np(impl, mi, &rel));
+}
+
+/* ---- rwlock --------------------------------------------------------------- */
+
+int lx_pthread_rwlock_init(struct lx_rwlock *r, const void *attr)
+{
+    (void)attr;
+    memset(r, 0, sizeof(*r));
+    return rw_impl(r) ? 0 : LX_ENOMEM;
+}
+
+int lx_pthread_rwlock_destroy(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = r->impl;
+
+    if (impl)
+    {
+        r->impl = NULL;
+        pthread_rwlock_destroy(impl);
+        FreeMem(impl, sizeof(*impl));
+    }
+    r->magic = 0;
+    return 0;
+}
+
+int lx_pthread_rwlock_rdlock(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = rw_impl(r);
+    return impl ? lso_pthread_ret(pthread_rwlock_rdlock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_rwlock_wrlock(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = rw_impl(r);
+    return impl ? lso_pthread_ret(pthread_rwlock_wrlock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_rwlock_tryrdlock(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = rw_impl(r);
+    return impl ? lso_pthread_ret(pthread_rwlock_tryrdlock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_rwlock_trywrlock(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = rw_impl(r);
+    return impl ? lso_pthread_ret(pthread_rwlock_trywrlock(impl)) : LX_ENOMEM;
+}
+
+int lx_pthread_rwlock_unlock(struct lx_rwlock *r)
+{
+    pthread_rwlock_t *impl = r->impl;
+    return impl ? lso_pthread_ret(pthread_rwlock_unlock(impl)) : LX_EPERM;
+}
+
+/* ---- once ----------------------------------------------------------------- */
+
+static pthread_mutex_t once_lock;
+static int once_lock_ready;
+
+int lx_pthread_once(int *once, void (*init_routine)(void))
+{
+    if (*(volatile int *)once == 2)
+        return 0;
+    Forbid();
+    if (!once_lock_ready)
+    {
+        pthread_mutexattr_t a;
+        pthread_mutexattr_init(&a);
+        pthread_mutexattr_settype(&a, PTHREAD_MUTEX_RECURSIVE);
+        pthread_mutex_init(&once_lock, &a);
+        pthread_mutexattr_destroy(&a);
+        once_lock_ready = 1;
+    }
+    Permit();
+    pthread_mutex_lock(&once_lock);
+    if (*once != 2)
+    {
+        *once = 1;
+        init_routine();
+        __sync_synchronize();
+        *once = 2;
+    }
+    pthread_mutex_unlock(&once_lock);
+    return 0;
+}
+
+/* ---- keys ----------------------------------------------------------------- */
+
+int lx_pthread_key_create(unsigned int *key, void (*dtor)(void *))
+{
+    pthread_key_t k;
+    int r = pthread_key_create(&k, dtor);
+    if (r == 0)
+        *key = k;
+    return lso_pthread_ret(r);
+}
+
+int lx_pthread_key_delete(unsigned int key)
+{
+    return lso_pthread_ret(pthread_key_delete((pthread_key_t)key));
+}
+
+void *lx_pthread_getspecific(unsigned int key)
+{
+    return pthread_getspecific((pthread_key_t)key);
+}
+
+int lx_pthread_setspecific(unsigned int key, const void *value)
+{
+    return lso_pthread_ret(pthread_setspecific((pthread_key_t)key, value));
+}
+
+/* ---- attributes ----------------------------------------------------------- */
+
+int lx_pthread_attr_init(struct lx_attr *a)
+{
+    memset(a, 0, sizeof(*a));
+    a->magic = LX_MAGIC_ATTR;
+    return 0;
+}
+
+int lx_pthread_attr_destroy(struct lx_attr *a)    { a->magic = 0; return 0; }
+int lx_pthread_attr_setdetachstate(struct lx_attr *a, int s) { a->detachstate = s; return 0; }
+int lx_pthread_attr_getdetachstate(const struct lx_attr *a, int *s) { *s = a->detachstate; return 0; }
+int lx_pthread_attr_setstacksize(struct lx_attr *a, size_t s)
+{
+    if (s < 16384)
+        return LX_EINVAL;
+    a->stacksize = s;
+    return 0;
+}
+int lx_pthread_attr_getstacksize(const struct lx_attr *a, size_t *s) { *s = a->stacksize; return 0; }
+
+/* ---- threads -------------------------------------------------------------- */
+
+struct lx_thread_start {
+    void *(*fn)(void *);
+    void *arg;
+};
+
+static void *thread_trampoline(void *p)
+{
+    struct lx_thread_start s = *(struct lx_thread_start *)p;
+    void *ret;
+
+    FreeMem(p, sizeof(s));
+    ret = s.fn(s.arg);
+    lso_task_free(FindTask(NULL));
+    return ret;
+}
+
+int lx_pthread_create(unsigned long *thread, const struct lx_attr *a,
+                      void *(*fn)(void *), void *arg)
+{
+    pthread_attr_t attr;
+    pthread_t t = 0;
+    struct lx_thread_start *s;
+    int r;
+
+    s = AllocMem(sizeof(*s), MEMF_ANY);
+    if (!s)
+        return LX_EAGAIN;
+    s->fn = fn;
+    s->arg = arg;
+
+    pthread_attr_init(&attr);
+    if (a && a->magic == LX_MAGIC_ATTR)
+    {
+        if (a->stacksize)
+            pthread_attr_setstacksize(&attr, a->stacksize);
+        if (a->detachstate == LX_PTHREAD_CREATE_DETACHED)
+            pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    }
+    r = pthread_create(&t, &attr, thread_trampoline, s);
+    pthread_attr_destroy(&attr);
+    if (r)
+    {
+        FreeMem(s, sizeof(*s));
+        return lso_pthread_ret(r);
+    }
+    *thread = t;
+    LSO_DEBUG("pthread_create -> %lu (stack %lu)", (unsigned long)t,
+              (unsigned long)((a && a->magic == LX_MAGIC_ATTR) ? a->stacksize : 0));
+    return 0;
+}
+
+int lx_pthread_join(unsigned long thread, void **ret)
+{
+    return lso_pthread_ret(pthread_join((pthread_t)thread, ret));
+}
+
+int lx_pthread_detach(unsigned long thread)
+{
+    return lso_pthread_ret(pthread_detach((pthread_t)thread));
+}
+
+unsigned long lx_pthread_self(void)
+{
+    return (unsigned long)pthread_self();
+}
+
+int lx_pthread_equal(unsigned long a, unsigned long b)
+{
+    return a == b;
+}
+
+void lx_pthread_exit(void *ret)
+{
+    lso_task_free(FindTask(NULL));
+    pthread_exit(ret);
+}
+
+int lx_pthread_setname_np(unsigned long thread, const char *name)
+{
+    return lso_pthread_ret(pthread_setname_np((pthread_t)thread, name));
+}
+
+int lx_pthread_getaffinity_np(unsigned long thread, size_t setsize, unsigned long *set)
+{
+    unsigned int n = lso_ncpus(), i;
+
+    (void)thread;
+    if (setsize < sizeof(unsigned long))
+        return LX_EINVAL;
+    memset(set, 0, setsize);
+    for (i = 0; i < n && i < setsize * 8; i++)
+        set[i / 64] |= 1UL << (i % 64);
+    return 0;
+}
+
+int lx_sched_getaffinity(int pid, size_t setsize, unsigned long *set)
+{
+    (void)pid;
+    if (lx_pthread_getaffinity_np(0, setsize, set))
+    {
+        lso_set_errno(LX_EINVAL);
+        return -1;
+    }
+    return 0;
+}
+
+int lx_sched_cpucount(size_t setsize, const unsigned long *set)
+{
+    size_t i;
+    int n = 0;
+
+    for (i = 0; i < setsize / sizeof(unsigned long); i++)
+        n += __builtin_popcountl(set[i]);
+    return n;
+}
+
+/* ---- semaphores ----------------------------------------------------------- */
+
+int lx_sem_init(struct lx_sem *s, int pshared, unsigned int value)
+{
+    sem_t *impl;
+
+    (void)pshared;
+    memset(s, 0, sizeof(*s));
+    impl = AllocMem(sizeof(*impl), MEMF_ANY | MEMF_CLEAR);
+    if (!impl)
+    {
+        lso_set_errno(LX_ENOMEM);
+        return -1;
+    }
+    if (sem_init(impl, 0, value))
+    {
+        FreeMem(impl, sizeof(*impl));
+        lso_set_errno_from_aros();
+        return -1;
+    }
+    s->impl = impl;
+    s->magic = LX_MAGIC_SEM;
+    return 0;
+}
+
+int lx_sem_destroy(struct lx_sem *s)
+{
+    sem_t *impl = s->impl;
+
+    if (impl)
+    {
+        s->impl = NULL;
+        sem_destroy(impl);
+        FreeMem(impl, sizeof(*impl));
+    }
+    s->magic = 0;
+    return 0;
+}
+
+static int sem_call(struct lx_sem *s, int (*fn)(sem_t *))
+{
+    if (!s->impl)
+    {
+        lso_set_errno(LX_EINVAL);
+        return -1;
+    }
+    if (fn(s->impl))
+    {
+        lso_set_errno_from_aros();
+        return -1;
