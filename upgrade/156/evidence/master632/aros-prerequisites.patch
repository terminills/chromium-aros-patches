+#define SYS_getegid         108
+#define SYS_getppid         110
+#define SYS_sigaltstack     131
+#define SYS_prctl           157
+#define SYS_arch_prctl      158
+#define SYS_gettid          186
+#define SYS_futex           202
+#define SYS_sched_getaffinity 204
+#define SYS_clock_gettime   228
+#define SYS_clock_getres    229
+#define SYS_clock_nanosleep 230
+#define SYS_exit_group      231
+#define SYS_tgkill          234
+#define SYS_openat          257
+#define SYS_newfstatat      262
+#define SYS_set_robust_list 273
+#define SYS_prlimit64       302
+#define SYS_getrandom       318
+#define SYS_membarrier      324
+#define SYS_statx           332
+#define SYS_rseq            334
+
+#define LX_AT_FDCWD       (-100)
+#define LX_AT_EMPTY_PATH  0x1000
+#define LX_TIMER_ABSTIME  1
+#define LX_SIGABRT        6
+#define LX_SIGKILL        9
+#define LX_ARCH_GET_FS    0x1003
+
+static long ret_or_errno(long r)
+{
+    return r < 0 ? neg_errno() : r;
+}
+
+long lso_syscall(long nr, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+    long r;
+
+    switch (nr)
+    {
+    case SYS_read:      r = ret_or_errno(lx_read((int)a1, (void *)a2, (size_t)a3)); break;
+    case SYS_write:     r = ret_or_errno(lx_write((int)a1, (const void *)a2, (size_t)a3)); break;
+    case SYS_open:      r = ret_or_errno(lso_open((const char *)a1, (int)a2, (int)a3)); break;
+    case SYS_openat:
+        if (a1 != LX_AT_FDCWD && ((const char *)a2)[0] != '/')
+        {
+            LSO_DEBUG("openat(dirfd %ld, %s) relative dirfd unsupported", a1, (const char *)a2);
+            r = -LX_ENOTSUP;
+        }
+        else
+            r = ret_or_errno(lso_open((const char *)a2, (int)a3, (int)a4));
+        break;
+    case SYS_close:     r = ret_or_errno(lx_close((int)a1)); break;
+    case SYS_stat:
+    case SYS_lstat:     r = ret_or_errno(lso_stat_to_glibc((const char *)a1, -1, (void *)a2)); break;
+    case SYS_fstat:     r = ret_or_errno(lso_stat_to_glibc(NULL, (int)a1, (void *)a2)); break;
+    case SYS_newfstatat:
+        if ((a4 & LX_AT_EMPTY_PATH) && ((const char *)a2)[0] == 0)
+            r = ret_or_errno(lso_stat_to_glibc(NULL, (int)a1, (void *)a3));
+        else if (a1 != LX_AT_FDCWD && ((const char *)a2)[0] != '/')
+            r = -LX_ENOTSUP;
+        else
+            r = ret_or_errno(lso_stat_to_glibc((const char *)a2, -1, (void *)a3));
+        break;
+    case SYS_lseek:     r = ret_or_errno(lx_lseek64((int)a1, a2, (int)a3)); break;
+    case SYS_pread64:   r = ret_or_errno(lx_pread64((int)a1, (void *)a2, (size_t)a3, a4)); break;
+    case SYS_mmap:
+    {
+        void *p = lx_mmap64((void *)a1, (size_t)a2, (int)a3, (int)a4, (int)a5, a6);
+        r = p == (void *)-1 ? neg_errno() : (long)p;
+        break;
+    }
+    case SYS_munmap:    r = ret_or_errno(lx_munmap((void *)a1, (size_t)a2)); break;
+    case SYS_mprotect:  r = ret_or_errno(lx_mprotect((void *)a1, (size_t)a2, (int)a3)); break;
+    case SYS_madvise:   r = ret_or_errno(lx_madvise((void *)a1, (size_t)a2, (int)a3)); break;
+    case SYS_brk:       r = -LX_ENOMEM; break;
+    case SYS_rt_sigaction:
+    case SYS_rt_sigprocmask:
+    case SYS_sigaltstack:
+    case SYS_set_robust_list:
+        r = 0; break;
+    case SYS_rseq:      r = -LX_ENOSYS; break;
+    case SYS_ioctl:     r = -LX_ENOTTY; break;
+    case SYS_fcntl:
+        switch (a2)
+        {
+        case 1: /* F_GETFD */ r = 0; break;
+        case 2: /* F_SETFD */ r = 0; break;
+        case 3: /* F_GETFL */ r = 0; break;
+        case 4: /* F_SETFL */ r = 0; break;
+        default: r = -LX_EINVAL; break;
+        }
+        break;
+    case SYS_sched_yield: r = 0; sched_yield(); break;
+    case SYS_nanosleep:
+        r = lx_nanosleep((const struct lx_timespec *)a1, (struct lx_timespec *)a2) < 0 ? -LX_EINTR : 0;
+        break;
+    case SYS_clock_nanosleep:
+    {
+        struct lx_timespec req = *(const struct lx_timespec *)a3;
+        if (a2 & LX_TIMER_ABSTIME)
+        {
+            struct timespec now;
+            lso_clock_gettime((int)a1, &now);
+            req.tv_sec -= now.tv_sec;
+            req.tv_nsec -= now.tv_nsec;
+            if (req.tv_nsec < 0) { req.tv_nsec += 1000000000L; req.tv_sec--; }
+            if (req.tv_sec < 0) { r = 0; break; }
+        }
+        r = lx_nanosleep(&req, (struct lx_timespec *)a4) < 0 ? -LX_EINTR : 0;
+        break;
+    }
+    case SYS_getpid:    r = getpid(); break;
+    case SYS_getppid:   r = 1; break;
+    case SYS_gettid:    r = sys_gettid(); break;
+    case SYS_getuid:
+    case SYS_geteuid:   r = geteuid(); break;
+    case SYS_getgid:
+    case SYS_getegid:   r = 1000; break;
+    case SYS_uname:     r = lx_uname((void *)a1); break;
+    case SYS_getcwd:
+        if ((size_t)a2 < 2)
+            r = -LX_ERANGE;
+        else
+        {
+            strcpy((char *)a1, "/");
+            r = 2;
+        }
+        break;
+    case SYS_readlink:
+        LSO_DEBUG("readlink(%s) -> ENOENT", (const char *)a1);
+        r = -LX_ENOENT;
+        break;
+    case SYS_gettimeofday:
+        r = lx_gettimeofday((struct lx_timeval *)a1, NULL) < 0 ? neg_errno() : 0;
+        break;
+    case SYS_clock_gettime:
+        r = lx_clock_gettime((int)a1, (struct lx_timespec *)a2) < 0 ? neg_errno() : 0;
+        break;
+    case SYS_clock_getres:
+        if (a2)
+        {
+            ((struct lx_timespec *)a2)->tv_sec = 0;
+            ((struct lx_timespec *)a2)->tv_nsec = 1000;
+        }
+        r = 0;
+        break;
+    case SYS_getrlimit:  r = lx_getrlimit64((int)a1, (void *)a2); break;
+    case SYS_prlimit64:
+        if (a4)
+            r = lx_getrlimit64((int)a2, (void *)a4);
+        else
+            r = 0;
+        break;
+    case SYS_sysinfo:    r = -LX_ENOSYS; break;
+    case SYS_ptrace:     r = 0; break;   /* PTRACE_TRACEME succeeds: nobody is attached */
+    case SYS_prctl:      r = lx_prctl((int)a1, a2, a3, a4, a5); break;
+    case SYS_arch_prctl:
+        if (a1 == LX_ARCH_GET_FS && trap_KernelBase)
+        {
+            /* rdmsr is supervisor-only; tasks run in user mode on pc-x86_64 */
+            APTR KernelBase = trap_KernelBase;
+            if (KrnIsSuper())
+            {
+                unsigned int lo, hi;
+                __asm__ volatile("rdmsr" : "=a"(lo), "=d"(hi) : "c"(0xc0000100));
+                *(unsigned long *)a2 = ((unsigned long)hi << 32) | lo;
+                r = 0;
+            }
+            else
+                r = -LX_EINVAL;
+        }
+        else
+        {
+            LSO_DEBUG("arch_prctl(%#lx) refused", a1);
+            r = -LX_EINVAL;
+        }
+        break;
+    case SYS_futex:
+        r = sys_futex((volatile int *)a1, (int)a2, (int)a3, (const struct lx_timespec *)a4,
+                      (volatile int *)a5, (unsigned int)a6);
+        break;
+    case SYS_sched_getaffinity:
+        r = lx_sched_getaffinity((int)a1, (size_t)a2, (unsigned long *)a3) < 0 ? -LX_EINVAL
+            : (long)(a2 < 8 ? a2 : 8);
+        break;
+    case SYS_getrandom:  r = lso_getrandom((void *)a1, (size_t)a2); break;
+    case SYS_membarrier: r = 0; break;
+    case SYS_statx:      r = -LX_ENOSYS; break;
+    case SYS_kill:
+    case SYS_tgkill:
+    {
+        long sig = nr == SYS_kill ? a2 : a3;
+        lso_log("guest %s(sig %ld)", nr == SYS_kill ? "kill" : "tgkill", sig);
+        if (sig == LX_SIGABRT || sig == LX_SIGKILL)
+            abort();
+        r = 0;
+        break;
+    }
+    case SYS_exit:
+        LSO_DEBUG("thread exit(%ld)", a1);
+        lx_pthread_exit((void *)a1);
+        r = 0;
+        break;
+    case SYS_exit_group:
+        lso_log("guest exit_group(%ld): aborting the process", a1);
+        abort();
+        break;
+    default:
+        lso_log("syscall %ld(%#lx, %#lx, %#lx, %#lx, %#lx, %#lx) unhandled -> ENOSYS",
+                nr, a1, a2, a3, a4, a5, a6);
+        r = -LX_ENOSYS;
+        break;
+    }
+    if (linuxso_debug_enabled() && nr != SYS_futex && nr != SYS_clock_gettime)
+        lso_log("syscall %ld(%#lx, %#lx, %#lx) -> %ld", nr, a1, a2, a3, r);
+    return r;
+}
diff --git a/compiler/linuxso/lso_syscall_tramp.S b/compiler/linuxso/lso_syscall_tramp.S
new file mode 100644
index 0000000000000000000000000000000000000000..8e007761bb48fe2e796abc2e8d0883d71c5f4da6
--- /dev/null
+++ b/compiler/linuxso/lso_syscall_tramp.S
@@ -0,0 +1,90 @@
+#   Copyright (C) 2026, The AROS Development Team. All rights reserved.
+#
+#   Desc: linuxso native syscall trampoline (x86-64).
+#
+#   IA32_EFER.SCE is off on AROS, so a guest `syscall` instruction raises
+#   #UD.  The kernel.resource exception handler in lso_syscall.c stores the
+#   instruction's return address 136 bytes below the trapped RSP (keeping
+#   the 128-byte red zone intact), points RIP here and returns from the
+#   trap; from then on we run in ordinary task context, so the emulation
+#   may block.  Linux preserves every register except RAX, RCX and R11
+#   across syscall; the C emulation clobbers the SysV caller-saved set and
+#   any SSE state, hence the saves.
+#
+#   Entry:  RAX = nr, RDI RSI RDX R10 R8 R9 = arguments, [RSP] = return RIP
+#   Exit:   RAX = result (negative errno on failure), RSP as before the trap
+
+	.text
+	.align	16
+	.globl	lso_syscall_tramp
+	.type	lso_syscall_tramp, @function
+
+lso_syscall_tramp:
+	push	%rbp
+	mov	%rsp, %rbp
+	push	%rdi
+	push	%rsi
+	push	%rdx
+	push	%r8
+	push	%r9
+	push	%r10
+	and	$-16, %rsp
+	sub	$256, %rsp
+	movups	%xmm0,   0(%rsp)
+	movups	%xmm1,  16(%rsp)
+	movups	%xmm2,  32(%rsp)
+	movups	%xmm3,  48(%rsp)
+	movups	%xmm4,  64(%rsp)
+	movups	%xmm5,  80(%rsp)
+	movups	%xmm6,  96(%rsp)
+	movups	%xmm7, 112(%rsp)
+	movups	%xmm8, 128(%rsp)
+	movups	%xmm9, 144(%rsp)
+	movups	%xmm10, 160(%rsp)
+	movups	%xmm11, 176(%rsp)
+	movups	%xmm12, 192(%rsp)
+	movups	%xmm13, 208(%rsp)
+	movups	%xmm14, 224(%rsp)
+	movups	%xmm15, 240(%rsp)
+
+	# lso_syscall(nr, a1, a2, a3, a4, a5, a6): a6 goes on the stack
+	sub	$8, %rsp
+	push	%r9
+	mov	%r8, %r9
+	mov	%r10, %r8
+	mov	%rdx, %rcx
+	mov	%rsi, %rdx
+	mov	%rdi, %rsi
+	mov	%rax, %rdi
+	call	lso_syscall
+	add	$16, %rsp
+
+	movups	  0(%rsp), %xmm0
+	movups	 16(%rsp), %xmm1
+	movups	 32(%rsp), %xmm2
+	movups	 48(%rsp), %xmm3
+	movups	 64(%rsp), %xmm4
+	movups	 80(%rsp), %xmm5
+	movups	 96(%rsp), %xmm6
+	movups	112(%rsp), %xmm7
+	movups	128(%rsp), %xmm8
+	movups	144(%rsp), %xmm9
+	movups	160(%rsp), %xmm10
+	movups	176(%rsp), %xmm11
+	movups	192(%rsp), %xmm12
+	movups	208(%rsp), %xmm13
+	movups	224(%rsp), %xmm14
+	movups	240(%rsp), %xmm15
+	lea	-48(%rbp), %rsp
+	pop	%r10
+	pop	%r9
+	pop	%r8
+	pop	%rdx
+	pop	%rsi
+	pop	%rdi
+	pop	%rbp
+	# [RSP] = return RIP, stored 136 bytes below the original RSP
+	pop	%r11
+	add	$128, %rsp
+	jmp	*%r11
+	.size	lso_syscall_tramp, .-lso_syscall_tramp
diff --git a/compiler/linuxso/lso_task.c b/compiler/linuxso/lso_task.c
new file mode 100644
index 0000000000000000000000000000000000000000..d68d82e152feba9c3b38544793a6f6735f482646
--- /dev/null
+++ b/compiler/linuxso/lso_task.c
@@ -0,0 +1,206 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    linuxso per-task state: glibc-numbered errno, the guest's TLS blocks
+    (__tls_get_addr) and the errno/return-code translation tables.
+*/
+
+#include <proto/exec.h>
+/* keep the resource base private to the linklib (no exported TaskResBase) */
+#define TaskResBase lso_TaskResBase
+static APTR lso_TaskResBase;
+#include <proto/task.h>
+#include <exec/memory.h>
+
+#include <errno.h>
+#include <string.h>
+
+#include "linuxso_intern.h"
+#include "lso_lx.h"
+
+static LONG lso_slot = -1;
+
+static void slot_init(void)
+{
+    Forbid();
+    if (lso_slot < 0)
+    {
+        if (!TaskResBase)
+            TaskResBase = OpenResource("task.resource");
+        if (TaskResBase)
+            lso_slot = AllocTaskStorageSlot();
+    }
+    Permit();
+}
+
+struct lso_task *lso_task_get(void)
+{
+    struct lso_task *lt;
+
+    if (lso_slot < 0)
+        slot_init();
+    if (lso_slot < 0)
+        return NULL;
+    lt = (struct lso_task *)GetTaskStorageSlot(lso_slot);
+    if (!lt)
+    {
+        lt = AllocMem(sizeof(*lt), MEMF_ANY | MEMF_CLEAR);
+        if (!lt)
+            return NULL;
+        lt->task = FindTask(NULL);
+        SetTaskStorageSlot(lso_slot, (IPTR)lt);
+        LSO_DEBUG("task %p '%s': shim context %p", lt->task, lt->task->tc_Node.ln_Name, lt);
+    }
+    return lt;
+}
+
+void lso_tls_release(struct lso_task *lt)
+{
+    int i;
+
+    for (i = 0; i < LSO_MAX_TLS_MODULES; i++)
+    {
+        if (lt->tls[i])
+        {
+            FreeVec(lt->tls[i]);
+            lt->tls[i] = NULL;
+        }
+    }
+}
+
+/* Called on the exiting task itself (pthread start trampoline). */
+void lso_task_free(struct Task *task)
+{
+    struct lso_task *lt;
+
+    if (lso_slot < 0)
+        return;
+    lt = (struct lso_task *)GetTaskStorageSlot(lso_slot);
+    if (!lt || lt->task != task)
+        return;
+    SetTaskStorageSlot(lso_slot, 0);
+    lso_tls_release(lt);
+    FreeMem(lt, sizeof(*lt));
+}
+
+/* ---- errno ---------------------------------------------------------------- */
+
+int lso_errno_to_linux(int e)
+{
+    switch (e)
+    {
+    case 0:          return 0;
+    case EPERM:      return LX_EPERM;
+    case ENOENT:     return LX_ENOENT;
+    case ESRCH:      return LX_ESRCH;
+    case EINTR:      return LX_EINTR;
+    case EIO:        return LX_EIO;
+    case EBADF:      return LX_EBADF;
+    case EAGAIN:     return LX_EAGAIN;
+    case ENOMEM:     return LX_ENOMEM;
+    case EACCES:     return LX_EACCES;
+    case EFAULT:     return LX_EFAULT;
+    case EBUSY:      return LX_EBUSY;
+    case EEXIST:     return LX_EEXIST;
+    case ENOTDIR:    return LX_ENOTDIR;
+    case EISDIR:     return LX_EISDIR;
+    case EINVAL:     return LX_EINVAL;
+    case ENFILE:     return LX_ENFILE;
+    case EMFILE:     return LX_EMFILE;
+    case ENOSPC:     return LX_ENOSPC;
+    case ESPIPE:     return LX_ESPIPE;
+    case EPIPE:      return LX_EPIPE;
+    case ERANGE:     return LX_ERANGE;
+    case EDEADLK:    return LX_EDEADLK;
+    case ENOSYS:     return LX_ENOSYS;
+    case ENOTSUP:    return LX_ENOTSUP;
+    case ETIMEDOUT:  return LX_ETIMEDOUT;
+    default:         return LX_EIO;
+    }
+}
+
+void lso_set_errno(int lx)
+{
+    struct lso_task *lt = lso_task_get();
+    if (lt)
+        lt->lx_errno = lx;
+}
+
+void lso_set_errno_from_aros(void)
+{
+    lso_set_errno(lso_errno_to_linux(errno));
+}
+
+int lso_pthread_ret(int r)
+{
+    return r ? lso_errno_to_linux(r) : 0;
+}
+
+int *lso_errno_location(void)
+{
+    static int fallback;
+    struct lso_task *lt = lso_task_get();
+    return lt ? &lt->lx_errno : &fallback;
+}
+
+/* ---- TLS ------------------------------------------------------------------ */
+
+struct lso_tls_index {
+    unsigned long module;
+    unsigned long offset;
+};
+
+static struct LinuxSO *module_by_id(unsigned int id)
+{
+    struct LinuxSO *so, *found = NULL;
+
+    ObtainSemaphoreShared(&lso_lock);
+    ForeachNode(&lso_objects, so)
+    {
+        if (so->tls_modid == id)
+        {
+            found = so;
+            break;
+        }
+    }
+    ReleaseSemaphore(&lso_lock);
+    return found;
+}
+
+void *lso_tls_get_addr(struct lso_tls_index *ti)
+{
+    struct lso_task *lt = lso_task_get();
+    unsigned int id = (unsigned int)ti->module;
+    void *block;
+
+    if (!lt || id == 0 || id > LSO_MAX_TLS_MODULES)
+        return NULL;
+    block = lt->tls[id - 1];
+    if (!block)
+    {
+        struct LinuxSO *so = module_by_id(id);
+        size_t align, size;
+        char *raw;
+
+        if (!so)
+            return NULL;
+        align = so->tls_align < 16 ? 16 : so->tls_align;
+        size = so->tls_memsz + align;
+        raw = AllocVec(size, MEMF_ANY | MEMF_CLEAR);
+        if (!raw)
+            return NULL;
+        block = (void *)(((uintptr_t)raw + align - 1) & ~(align - 1));
+        memcpy(block, so->tls_image, so->tls_filesz);
+        /* keep the raw pointer for FreeVec: the aligned block never moves
+           more than align-1 bytes, and AllocVec's own header sits below raw */
+        lt->tls[id - 1] = raw;
+        LSO_DEBUG("task %p: TLS block for module %u at %p (%lu bytes)",
+                  lt->task, id, block, (unsigned long)so->tls_memsz);
+        return (char *)block + ti->offset;
+    }
+    {
+        struct LinuxSO *so = module_by_id(id);
+        size_t align = (so && so->tls_align > 16) ? so->tls_align : 16;
+        return (char *)(((uintptr_t)block + align - 1) & ~(align - 1)) + ti->offset;
+    }
+}
diff --git a/compiler/linuxso/mmakefile.src b/compiler/linuxso/mmakefile.src
new file mode 100644
index 0000000000000000000000000000000000000000..47ee934e7a18625761076e041aa04980e58c546c
--- /dev/null
+++ b/compiler/linuxso/mmakefile.src
@@ -0,0 +1,40 @@
+#   Copyright (C) 2026, The AROS Development Team. All rights reserved.
+#
+#   linuxso: static link library that maps Linux x86-64 ELF shared objects
+#   (ET_DYN) into an AROS process and serves their glibc imports.
+
+include $(SRCDIR)/config/aros.cfg
+
+# x86-64 only: the objects it loads are x86-64 code and lso_syscall_tramp.S
+# is 64-bit assembly, so it cannot be built for any other CPU (the i386
+# regression build failed on it, 2026-09-21). It must not sit under
+# core-linklibs, which every module build depends on; hang it off the
+# per-CPU linklibs metatarget instead (cf. arch/arm-all/arm-aeabi). Users
+# such as cef-blink name it in uselibs and pull linklibs-linuxso directly.
+#MM- linklibs-x86_64 : linklibs-linuxso
+#MM linklibs-linuxso : includes linuxso-includes-copy
+
+#MM- includes-copy : linuxso-includes-copy
+#MM- compiler-includes : linuxso-includes-copy
+
+%copy_includes mmake=linuxso-includes-copy includes="linuxso.h"
+
+LINUXSOFILES := \
+    lso_elf \
+    lso_task \
+    lso_pthread \
+    lso_file \
+    lso_mem \
+    lso_shim \
+    lso_syscall
+
+%build_linklib mmake=linklibs-linuxso \
+    libname=linuxso \
+    files="$(LINUXSOFILES)" \
+    asmfiles="lso_syscall_tramp"
+
+#MM- test-linuxso : linklibs-linuxso linklibs-pthread
+
+%build_prog mmake=test-linuxso \
+    progname=LinuxSO targetdir=$(AROS_TESTS) \
+    files="linuxso_cli" uselibs="linuxso pthread"
diff --git a/rom/dos/internalloadseg_elf.c b/rom/dos/internalloadseg_elf.c
index 307df8bcf05fbf1195ce8529b11c09474f3149ef..0b6bc83c9238aee7d5baf47fbeb4c1432d6b2744 100644
