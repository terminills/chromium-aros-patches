+    Pure-C crypto interface for credentials.library. The default backend
+    (credentials_crypto.c) is self-contained embedded reference crypto --
+    ChaCha20-Poly1305 (RFC 8439) + SHA-256/HMAC/HKDF + RDRAND -- with NO
+    external crypto library, so it links clean into a bare AROS library module.
+    Kept free of AROS headers so the crypto and AROS type worlds never meet in
+    one translation unit; the AROS LVO layer (credentials_keyring.c) calls
+    these plain-C primitives.
+
+    Swap target: an AmiSSL / libcrypto backend can replace credentials_crypto.c
+    behind this same interface with zero change to the keyring layer.
+*/
+#ifndef CREDENTIALS_CRYPTO_H
+#define CREDENTIALS_CRYPTO_H
+
+#include <stddef.h>
+
+#define CRED_SEED_LEN   32
+#define CRED_KEY_LEN    32
+#define CRED_NONCE_LEN  12
+#define CRED_TAG_LEN    16
+/* sealed blob overhead added around the plaintext */
+#define CRED_SEAL_OVERHEAD (CRED_NONCE_LEN + CRED_TAG_LEN)
+
+/* Fill out[0..len) with CSPRNG bytes. Returns 1 on success, 0 on failure. */
+int cred_crypto_random(unsigned char *out, int len);
+
+/* SHA-256 one-shot: md must hold 32 bytes. Returns 1/0. */
+int cred_crypto_sha256(const unsigned char *data, int len, unsigned char *md32);
+
+/* HKDF-SHA256: derive outlen bytes from (seed, info) into out. Returns 1/0. */
+int cred_crypto_hkdf(const unsigned char *seed, int seedlen,
+                     const unsigned char *info, int infolen,
+                     unsigned char *out, int outlen);
+
+/* ChaCha20-Poly1305 seal. blob layout: [nonce(12)][ciphertext(ptlen)][tag(16)].
+   blob must have room for ptlen + CRED_SEAL_OVERHEAD. Returns total blob
+   length, or -1 on failure. */
+int cred_crypto_seal(const unsigned char key[CRED_KEY_LEN],
+                     const unsigned char *pt, int ptlen,
+                     unsigned char *blob, int blobcap);
+
+/* ChaCha20-Poly1305 unseal (verifies the tag). Writes plaintext into pt; ptcap
+   must be >= bloblen - CRED_SEAL_OVERHEAD. Returns plaintext length, or -1
+   on failure / tag mismatch. */
+int cred_crypto_unseal(const unsigned char key[CRED_KEY_LEN],
+                       const unsigned char *blob, int bloblen,
+                       unsigned char *pt, int ptcap);
+
+#endif /* CREDENTIALS_CRYPTO_H */
diff --git a/workbench/libs/credentials/credentials_entropy.c b/workbench/libs/credentials/credentials_entropy.c
new file mode 100644
index 0000000000000000000000000000000000000000..2169e31be0e45680c61f7f96d622f427907b7d52
--- /dev/null
+++ b/workbench/libs/credentials/credentials_entropy.c
@@ -0,0 +1,12 @@
+/* Native entropy source shared by all AROS architectures. */
+#include <proto/exec.h>
+#define __ENTROPY_NOLIBBASE__
+#define __ENTROPY_LIBBASE entropy_base
+#include <proto/entropy.h>
+
+int cred_native_random(unsigned char *out, int len)
+{
+    struct Library *entropy_base = OpenResource("entropy.resource");
+    if (!entropy_base || !out || len < 0) return 0;
+    return GetEntropy(out, (ULONG)len) == (LONG)len;
+}
diff --git a/workbench/libs/credentials/credentials_identity.c b/workbench/libs/credentials/credentials_identity.c
new file mode 100644
index 0000000000000000000000000000000000000000..6a3fe85ca3d122a19a57a2d652edc0fa5c6dce45
--- /dev/null
+++ b/workbench/libs/credentials/credentials_identity.c
@@ -0,0 +1,133 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Identity layer: the single non-NULL source of truth for uv_os_get_passwd,
+    Node os.userInfo and posixc getpwuid.
+*/
+
+#include <aros/symbolsets.h>
+#include <aros/libcall.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/var.h>
+
+#include "credentials_private.h"
+#include LC_LIBDEFS_FILE
+
+extern struct DosLibrary *DOSBase;   /* opened in credentials_init.c */
+
+/* Bounded copy, always NUL-terminated. */
+static void cred_copy(STRPTR buf, ULONG size, CONST_STRPTR src)
+{
+    ULONG i = 0;
+    if (!src) src = "";
+    if (size == 0) return;
+    for (; i + 1 < size && src[i]; i++)
+        buf[i] = src[i];
+    buf[i] = '\0';
+}
+
+/* Fill buf from ENV:<name> (global tier) if set non-empty, else from def. */
+static void cred_from_env(STRPTR buf, ULONG size, CONST_STRPTR name, CONST_STRPTR def)
+{
+    LONG n = -1;
+
+    buf[0] = '\0';
+    if (DOSBase)
+        n = GetVar((STRPTR)name, buf, size, GVF_GLOBAL_ONLY);
+    if (n <= 0 || buf[0] == '\0')
+        cred_copy(buf, size, def);
+    else if (n < (LONG)size)
+        buf[n] = '\0';
+    else
+        buf[size - 1] = '\0';
+}
+
+/* Multi-user path: when MuFS/usergroup is configured the current user's real
+   record is read here. Not yet wired -- returns FALSE so we fall through to
+   the single-user resolution. (JOB-0081 follow-up: usergroup.library.) */
+static BOOL cred_try_usergroup(struct CredentialsBase *CredentialsBase)
+{
+    (void)CredentialsBase;
+    return FALSE;
+}
+
+/* Resolve the identity into the cache once. Precedence:
+   usergroup/MuFS (when configured) -> ENV: overrides -> setup profile
+   (ENVARC: tier of the same GetVar namespace) -> non-synthetic defaults.
+   INVARIANT: on return every ai_* STRPTR is non-NULL. */
+VOID cred_ResolveIdentity(struct CredentialsBase *CredentialsBase)
+{
+    struct ArosIdentity *id = &CredentialsBase->cb_Identity;
+
+    ObtainSemaphore(&CredentialsBase->cb_Lock);
+
+    if (!CredentialsBase->cb_IdentityValid)
+    {
+        if (!cred_try_usergroup(CredentialsBase))
+        {
+            cred_from_env(CredentialsBase->cb_UserBuf,  sizeof(CredentialsBase->cb_UserBuf),  "USER",     CRED_DEFAULT_USER);
+            cred_from_env(CredentialsBase->cb_FullBuf,  sizeof(CredentialsBase->cb_FullBuf),  "REALNAME", "");
+            cred_from_env(CredentialsBase->cb_HomeBuf,  sizeof(CredentialsBase->cb_HomeBuf),  "HOME",     CRED_DEFAULT_HOME);
+            cred_from_env(CredentialsBase->cb_ShellBuf, sizeof(CredentialsBase->cb_ShellBuf), "SHELL",    CRED_DEFAULT_SHELL);
+
+            id->ai_UID = CRED_DEFAULT_UID;
+            id->ai_GID = CRED_DEFAULT_GID;
+        }
+
+        /* Point the record at the backing buffers and enforce non-NULL. */
+        id->ai_UserName = CredentialsBase->cb_UserBuf;
+        id->ai_FullName = CredentialsBase->cb_FullBuf;
+        id->ai_HomeDir  = CredentialsBase->cb_HomeBuf;
+        id->ai_Shell    = CredentialsBase->cb_ShellBuf;
+
+        CredentialsBase->cb_IdentityValid = TRUE;
+    }
+
+    ReleaseSemaphore(&CredentialsBase->cb_Lock);
+}
+
+/*****************************************************************************
+
+    NAME */
+        AROS_LH1(LONG, CredGetIdentity,
+
+/*  SYNOPSIS */
+        AROS_LHA(struct ArosIdentity *, id, A0),
+
+/*  LOCATION */
+        struct CredentialsBase *, CredentialsBase, 5, Credentials)
+
+/*  FUNCTION
+        Fill *id with the current AROS identity. Every string field is
+        guaranteed non-NULL (empty "" for absent optionals). Backs
+        uv_os_get_passwd, Node os.userInfo and posixc getpwuid.
+
+    INPUTS
+        id - caller-supplied struct ArosIdentity to populate.
+
+    RESULT
+        CRED_OK, or CRED_ERR_BADARG if id is NULL.
+
+    NOTES
+        The returned string pointers reference library-owned storage that
+        stays valid for the life of the library; callers must copy strings
+        they intend to keep across an Expunge.
+
+*****************************************************************************/
+{
+    AROS_LIBFUNC_INIT
+
+    if (!id)
+        return CRED_ERR_BADARG;
+
+    cred_ResolveIdentity(CredentialsBase);
+
+    ObtainSemaphoreShared(&CredentialsBase->cb_Lock);
+    *id = CredentialsBase->cb_Identity;
+    ReleaseSemaphore(&CredentialsBase->cb_Lock);
+
+    return CRED_OK;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/credentials/credentials_init.c b/workbench/libs/credentials/credentials_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..40268547c91420d651883eddaefc9f814cc6cd60
--- /dev/null
+++ b/workbench/libs/credentials/credentials_init.c
@@ -0,0 +1,48 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    credentials.library init/expunge.
+*/
+
+#include <aros/symbolsets.h>
+#include <aros/debug.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+
+#include "credentials_private.h"
+#include LC_LIBDEFS_FILE
+
+/* Global dos base used by the identity resolver (GetVar). dos.library may be
+   absent very early; the resolver tolerates a NULL DOSBase and falls back to
+   the non-synthetic defaults, so library init still succeeds. */
+struct DosLibrary *DOSBase = NULL;
+
+static int Credentials_Init(LIBBASETYPEPTR LIBBASE)
+{
+    D(bug("[credentials] Init\n"));
+
+    InitSemaphore(&LIBBASE->cb_Lock);
+    LIBBASE->cb_IdentityValid = FALSE;
+
+    if (!DOSBase)
+        DOSBase = (struct DosLibrary *)OpenLibrary("dos.library", 0);
+
+    return TRUE;
+}
+
+static int Credentials_Expunge(LIBBASETYPEPTR LIBBASE)
+{
+    D(bug("[credentials] Expunge\n"));
+
+    (void)LIBBASE;
+    if (DOSBase)
+    {
+        CloseLibrary((struct Library *)DOSBase);
+        DOSBase = NULL;
+    }
+
+    return TRUE;
+}
+
+ADD2INITLIB(Credentials_Init, 0)
+ADD2EXPUNGELIB(Credentials_Expunge, 0)
diff --git a/workbench/libs/credentials/credentials_keyring.c b/workbench/libs/credentials/credentials_keyring.c
new file mode 100644
index 0000000000000000000000000000000000000000..fd468abfbc0a807883ea7d48db96c217d7d725cc
--- /dev/null
+++ b/workbench/libs/credentials/credentials_keyring.c
@@ -0,0 +1,391 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Keyring layer: derive-don't-store secret storage.
+      * master seed  : machine-transparent MVP -- generated once, persisted at
+                       ENVARC:Keyring/.seed (as safe as the disk; a later pass
+                       seals it under a machine-derived key / adds passphrase mode).
+      * per-entry key: HKDF-SHA256(seed, "cred:v1:" service \0 account) -- derived
+                       on demand, never stored.
+      * sealing      : ChaCha20-Poly1305 (embedded reference crypto via
+                       credentials_crypto.c -- no external crypto library).
+      * backing store: one ciphertext blob per entry at ENVARC:Keyring/<sha256hex>;
+                       only ciphertext + nonce + tag touch the disk.
+    This is the AROS LVO + DOS-store half; the crypto lives entirely behind the
+    plain-C credentials_crypto.h interface so the type worlds never collide.
+*/
+
+#include <aros/symbolsets.h>
+#include <aros/libcall.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <dos/dos.h>
+#include <string.h>
+
+#include "credentials_private.h"
+#include "credentials_crypto.h"
+#include "credentials_names.h"
+#include LC_LIBDEFS_FILE
+
+extern struct DosLibrary *DOSBase;   /* opened in credentials_init.c */
+
+#define CRED_SEED_FILE     "ENVARC:Keyring/.seed"
+#define CRED_DEVICEID_FILE "ENVARC:Keyring/.deviceid"
+#define CRED_MAX_SECRET    65536
+
+/* ---- DOS store helpers ---- */
+
+static void cred_ensure_dir(void)
+{
+    BPTR l = CreateDir((CONST_STRPTR)CRED_KEYRING_DIR);
+    if (l)
+        UnLock(l);   /* if the dir already exists CreateDir just fails, harmless */
+}
+
+static LONG cred_write_file(CONST_STRPTR path, const void *data, LONG len)
+{
+    BPTR fh = Open(path, MODE_NEWFILE);
+    LONG w;
+    if (!fh)
+        return -1;
+    w = Write(fh, (APTR)data, len);
+    Close(fh);
+    return (w == len) ? 0 : -1;
+}
+
+/* -2 means absent, -1 means I/O failure, -3 means oversized. Never treat
+   unreadable/corrupt key material as a missing first-use seed. */
+static LONG cred_read_file(CONST_STRPTR path, void *buf, LONG cap)
+{
+    BPTR fh = Open(path, MODE_OLDFILE);
+    LONG total = 0, got;
+    UBYTE extra;
+    if (!fh) return IoErr() == ERROR_OBJECT_NOT_FOUND ? -2 : -1;
+    while (total < cap) {
+        got = Read(fh, (UBYTE *)buf + total, cap - total);
+        if (got < 0) { Close(fh); return -1; }
+        if (!got) break;
+        total += got;
+    }
+    got = Read(fh, &extra, 1);
+    if (!Close(fh) || got < 0) return -1;
+    return got ? -3 : total;
+}
+
+/* Login preserves SHA-256(service NUL account); named collections include
+   their complete v2 namespace. Callers validate names before entering here. */
+static void cred_entry_path(struct CredKeyring *k, CONST_STRPTR service,
+                            CONST_STRPTR account, STRPTR out, ULONG outsize)
+{
+    static const char hexd[] = "0123456789abcdef";
+    UBYTE info[600], md[32];
+    int n = cred_name_info(k->ck_Collection, service, account, info, sizeof(info));
+    int offset = strcmp(k->ck_Collection, "login") == 0 ? 8 : 0;
+    int i;
+    out[0] = 0;
+    if (n < 0 || outsize < sizeof(CRED_KEYRING_DIR) + 65) return;
+    cred_crypto_sha256(info + offset, n - offset, md);
+    strcpy(out, CRED_KEYRING_DIR "/");
+    for (i = 0; i < 32; ++i) {
+        out[sizeof(CRED_KEYRING_DIR) + i * 2] = hexd[md[i] >> 4];
+        out[sizeof(CRED_KEYRING_DIR) + i * 2 + 1] = hexd[md[i] & 15];
+    }
+    out[sizeof(CRED_KEYRING_DIR) + 64] = 0;
+}
+
+/* Load or (first use) create the master seed; unlock the handle. */
+static LONG cred_ensure_unlocked_locked(struct CredKeyring *k)
+{
+    UBYTE seed[CRED_SEED_LEN];
+    LONG r;
+
+    if (k->ck_ExplicitlyLocked) return CRED_ERR_LOCKED;
+    if (k->ck_Unlocked)
+        return CRED_OK;
+
+    r = cred_read_file((CONST_STRPTR)CRED_SEED_FILE, seed, sizeof(seed));
+    if (r == -2)
+    {
+        if ((k->ck_Flags & CRKF_READONLY) || !(k->ck_Flags & CRKF_CREATE))
+            return CRED_ERR_NOTFOUND;
+        cred_ensure_dir();
+        if (!cred_crypto_random(seed, sizeof(seed)))
+            return CRED_ERR_CRYPTO;
+        if (cred_write_file((CONST_STRPTR)CRED_SEED_FILE, seed, sizeof(seed)) != 0)
+        {
+            memset(seed, 0, sizeof(seed));
+            return CRED_ERR_IO;
+        }
+    }
+    else if (r != CRED_SEED_LEN) {
+        memset(seed, 0, sizeof(seed));
+        return r == -1 ? CRED_ERR_IO : CRED_ERR_CRYPTO;
+    }
+    memcpy(k->ck_Seed, seed, sizeof(seed));
+    memset(seed, 0, sizeof(seed));
+    k->ck_Unlocked = TRUE;
+    return CRED_OK;
+}
+
+static LONG cred_ensure_unlocked(struct CredKeyring *k)
+{
+    LONG result;
+    ObtainSemaphore(&k->ck_Base->cb_Lock);
+    result = cred_ensure_unlocked_locked(k);
+    ReleaseSemaphore(&k->ck_Base->cb_Lock);
+    return result;
+}
+
+/* ---- LVOs ---- */
+
+AROS_LH2(APTR, CredOpenKeyring,
+    AROS_LHA(CONST_STRPTR, collection, A0),
+    AROS_LHA(ULONG, flags, D0),
+    struct CredentialsBase *, CredentialsBase, 6, Credentials)
+{
+    AROS_LIBFUNC_INIT
+
+    struct CredKeyring *k = AllocVec(sizeof(*k), MEMF_PUBLIC | MEMF_CLEAR);
+    CONST_STRPTR c = collection ? collection : (CONST_STRPTR)"login";
+    size_t collection_len;
+    if (!cred_name_length(c, sizeof(k->ck_Collection), &collection_len) ||
+        !collection_len || (flags & ~(CRKF_CREATE | CRKF_READONLY))) {
+        if (k) FreeVec(k);
+        return NULL;
+    }
+    if (!k)
+        return NULL;
+    k->ck_Base = CredentialsBase;
+    k->ck_Flags = flags;
+    memcpy(k->ck_Collection, c, collection_len + 1);
+    k->ck_Unlocked = FALSE;
+    return k;
+
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH6(LONG, CredKeyringStore,
+    AROS_LHA(APTR, kr, A0),
+    AROS_LHA(CONST_STRPTR, service, A1),
+    AROS_LHA(CONST_STRPTR, account, A2),
+    AROS_LHA(CONST APTR, secret, A3),
+    AROS_LHA(ULONG, len, D0),
+    AROS_LHA(CONST_STRPTR, label, D1),
+    struct CredentialsBase *, CredentialsBase, 7, Credentials)
+{
+    AROS_LIBFUNC_INIT
+
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    UBYTE key[CRED_KEY_LEN], info[600];
+    UBYTE *blob;
+    TEXT  path[128];
+    int   ilen, blen, cap;
+    LONG  rc;
+
+    (void)CredentialsBase; (void)label;
+    if (k && (k->ck_Flags & CRKF_READONLY)) return CRED_ERR_LOCKED;
+    if (!k || !service || !account || !secret || len > CRED_MAX_SECRET)
+        return CRED_ERR_BADARG;
+    ilen = cred_name_info(k->ck_Collection, service, account, info, sizeof(info));
+    if (ilen < 0) return CRED_ERR_BADARG;
+    if ((rc = cred_ensure_unlocked(k)) != CRED_OK)
+        return rc;
+
+    ilen = cred_name_info(k->ck_Collection, service, account, info, sizeof(info));
+    if (!cred_crypto_hkdf(k->ck_Seed, CRED_SEED_LEN, info, ilen, key, CRED_KEY_LEN))
+        return CRED_ERR_CRYPTO;
+
+    cap = (int)len + CRED_SEAL_OVERHEAD;
+    blob = AllocVec(cap, MEMF_PUBLIC);
+    if (!blob) { memset(key, 0, sizeof(key)); return CRED_ERR_NOMEM; }
+
+    blen = cred_crypto_seal(key, secret, (int)len, blob, cap);
+    memset(key, 0, sizeof(key));
+    if (blen < 0) { FreeVec(blob); return CRED_ERR_CRYPTO; }
+
+    cred_entry_path(k, service, account, path, sizeof(path));
+    rc = (cred_write_file(path, blob, blen) == 0) ? CRED_OK : CRED_ERR_IO;
+    memset(blob, 0, cap);
+    FreeVec(blob);
+    return rc;
+
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH5(LONG, CredKeyringLookup,
+    AROS_LHA(APTR, kr, A0),
+    AROS_LHA(CONST_STRPTR, service, A1),
+    AROS_LHA(CONST_STRPTR, account, A2),
+    AROS_LHA(APTR *, secretOut, A3),
+    AROS_LHA(ULONG *, lenOut, D0),
+    struct CredentialsBase *, CredentialsBase, 8, Credentials)
+{
+    AROS_LIBFUNC_INIT
+
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    UBYTE key[CRED_KEY_LEN], info[600];
+    UBYTE *blob, *pt;
+    TEXT  path[128];
+    int   ilen, ptlen, cap;
+    LONG  blen, rc;
+
+    (void)CredentialsBase;
+    if (secretOut) *secretOut = NULL;
+    if (lenOut)    *lenOut = 0;
+    if (!k || !service || !account || !secretOut || !lenOut)
+        return CRED_ERR_BADARG;
+    ilen = cred_name_info(k->ck_Collection, service, account, info, sizeof(info));
+    if (ilen < 0) return CRED_ERR_BADARG;
+    if ((rc = cred_ensure_unlocked(k)) != CRED_OK)
+        return rc;
+
+    cap = CRED_MAX_SECRET + CRED_SEAL_OVERHEAD;
+    blob = AllocVec(cap, MEMF_PUBLIC);
+    if (!blob)
+        return CRED_ERR_NOMEM;
+
+    cred_entry_path(k, service, account, path, sizeof(path));
+    blen = cred_read_file(path, blob, cap);
+    if (blen < CRED_SEAL_OVERHEAD) {
+        FreeVec(blob);
+        return blen == -2 ? CRED_ERR_NOTFOUND :
+               blen == -1 ? CRED_ERR_IO : CRED_ERR_CRYPTO;
+    }
+
+    ilen = cred_name_info(k->ck_Collection, service, account, info, sizeof(info));
+    if (!cred_crypto_hkdf(k->ck_Seed, CRED_SEED_LEN, info, ilen, key, CRED_KEY_LEN))
+    { FreeVec(blob); return CRED_ERR_CRYPTO; }
+
+    pt = AllocVec(blen, MEMF_PUBLIC | MEMF_CLEAR);   /* >= plaintext length */
+    if (!pt) { memset(key, 0, sizeof(key)); FreeVec(blob); return CRED_ERR_NOMEM; }
+
+    ptlen = cred_crypto_unseal(key, blob, (int)blen, pt, (int)blen);
+    memset(key, 0, sizeof(key));
+    memset(blob, 0, cap);
+    FreeVec(blob);
+    if (ptlen < 0) { memset(pt, 0, blen); FreeVec(pt); return CRED_ERR_CRYPTO; }
+
+    *secretOut = pt;
+    *lenOut = (ULONG)ptlen;
+    return CRED_OK;
+
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH3(LONG, CredKeyringDelete,
+    AROS_LHA(APTR, kr, A0),
+    AROS_LHA(CONST_STRPTR, service, A1),
+    AROS_LHA(CONST_STRPTR, account, A2),
+    struct CredentialsBase *, CredentialsBase, 9, Credentials)
+{
+    AROS_LIBFUNC_INIT
+
+    TEXT path[128];
+    UBYTE info[600];
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    (void)CredentialsBase;
+    if (!k || !service || !account)
+        return CRED_ERR_BADARG;
+    if ((k->ck_Flags & CRKF_READONLY) || k->ck_ExplicitlyLocked) return CRED_ERR_LOCKED;
+    if (cred_name_info(k->ck_Collection, service, account, info, sizeof(info)) < 0)
+        return CRED_ERR_BADARG;
+    cred_entry_path(k, service, account, path, sizeof(path));
+    if (DeleteFile((CONST_STRPTR)path)) return CRED_OK;
+    return IoErr() == ERROR_OBJECT_NOT_FOUND ? CRED_ERR_NOTFOUND : CRED_ERR_IO;
+
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH2(VOID, CredKeyringFree,
+    AROS_LHA(APTR, secret, A0),
+    AROS_LHA(ULONG, len, D0),
+    struct CredentialsBase *, CredentialsBase, 10, Credentials)
+{
+    AROS_LIBFUNC_INIT
+    (void)CredentialsBase;
+    if (secret)
+    {
+        if (len)
+            memset(secret, 0, len);   /* zeroize before release */
+        FreeVec(secret);
+    }
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH2(LONG, CredKeyringUnlock,
+    AROS_LHA(APTR, kr, A0),
+    AROS_LHA(CONST_STRPTR, passphrase, A1),
+    struct CredentialsBase *, CredentialsBase, 11, Credentials)
+{
+    AROS_LIBFUNC_INIT
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    (void)CredentialsBase;
+    if (!k)
+        return CRED_ERR_BADARG;
+    if (passphrase)
+        return CRED_ERR_NOTIMPL;      /* passphrase mode: follow-up */
+    k->ck_ExplicitlyLocked = FALSE;
+    return cred_ensure_unlocked(k);   /* machine-transparent MVP */
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH1(LONG, CredKeyringLock,
+    AROS_LHA(APTR, kr, A0),
+    struct CredentialsBase *, CredentialsBase, 12, Credentials)
+{
+    AROS_LIBFUNC_INIT
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    (void)CredentialsBase;
+    if (!k)
+        return CRED_ERR_BADARG;
+    memset(k->ck_Seed, 0, sizeof(k->ck_Seed));
+    k->ck_Unlocked = FALSE;
+    k->ck_ExplicitlyLocked = TRUE;
+    return CRED_OK;
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH1(VOID, CredCloseKeyring,
+    AROS_LHA(APTR, kr, A0),
+    struct CredentialsBase *, CredentialsBase, 13, Credentials)
+{
+    AROS_LIBFUNC_INIT
+    struct CredKeyring *k = (struct CredKeyring *)kr;
+    (void)CredentialsBase;
+    if (k)
+    {
+        memset(k->ck_Seed, 0, sizeof(k->ck_Seed));
+        FreeVec(k);
+    }
+    AROS_LIBFUNC_EXIT
+}
+
+AROS_LH1(LONG, CredDeviceID,
+    AROS_LHA(UBYTE *, uuidOut, A0),
+    struct CredentialsBase *, CredentialsBase, 14, Credentials)
+{
+    AROS_LIBFUNC_INIT
+
+    UBYTE id[16];
+    LONG  r;
+    (void)CredentialsBase;
+    if (!uuidOut)
+        return CRED_ERR_BADARG;
+
+    cred_ensure_dir();
+    r = cred_read_file((CONST_STRPTR)CRED_DEVICEID_FILE, id, sizeof(id));
+    if (r == -2)
+    {
+        if (!cred_crypto_random(id, sizeof(id)))
+            return CRED_ERR_CRYPTO;
+        id[6] = (id[6] & 0x0f) | 0x40;   /* RFC4122 version 4 */
+        id[8] = (id[8] & 0x3f) | 0x80;   /* variant           */
+        if (cred_write_file((CONST_STRPTR)CRED_DEVICEID_FILE, id, sizeof(id)) != 0)
+            return CRED_ERR_IO;
+    }
+    else if (r != 16) return r == -1 ? CRED_ERR_IO : CRED_ERR_CRYPTO;
+    memcpy(uuidOut, id, 16);
+    return CRED_OK;
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/workbench/libs/credentials/credentials_names.h b/workbench/libs/credentials/credentials_names.h
new file mode 100644
index 0000000000000000000000000000000000000000..55dea5fd172fbe0837c8d5a75411703153326c7e
--- /dev/null
+++ b/workbench/libs/credentials/credentials_names.h
@@ -0,0 +1,37 @@
+/* Credentials key namespaces. No truncation; preserves existing login keys. */
+#ifndef CREDENTIALS_NAMES_H
+#define CREDENTIALS_NAMES_H
+#include <stddef.h>
+#include <string.h>
+
+static int cred_name_length(const char *s, size_t limit, size_t *length)
+{
+    size_t n = 0;
+    if (!s) return 0;
+    while (n < limit && s[n]) ++n;
+    if (n == limit) return 0;
+    *length = n;
+    return 1;
+}
+
+/* Returns the HKDF info length, or -1 for an invalid/overlong name.
+   Login retains the historical v1 encoding. Other collections use v2 and
+   include their complete name, separating both their files and derived keys. */
+static int cred_name_info(const char *collection, const char *service,
+                          const char *account, unsigned char *out, size_t cap)
+{
+    size_t c, s, a, n = 0;
+    int login;
+    if (!cred_name_length(collection, 64, &c) || !c ||
+        !cred_name_length(service, 512, &s) ||
+        !cred_name_length(account, 512, &a) || s + 1 + a > 512)
+        return -1;
+    login = strcmp(collection, "login") == 0;
+    if (8 + (login ? 0 : c + 1) + s + 1 + a > cap) return -1;
+    memcpy(out, login ? "cred:v1:" : "cred:v2:", 8); n = 8;
+    if (!login) { memcpy(out+n, collection, c); n += c; out[n++] = 0; }
+    memcpy(out+n, service, s); n += s; out[n++] = 0;
+    memcpy(out+n, account, a); n += a;
+    return (int)n;
+}
+#endif
diff --git a/workbench/libs/credentials/credentials_private.h b/workbench/libs/credentials/credentials_private.h
new file mode 100644
index 0000000000000000000000000000000000000000..21a2948a888bfdcba99975d31921535c673d7b34
--- /dev/null
+++ b/workbench/libs/credentials/credentials_private.h
@@ -0,0 +1,57 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Private state for credentials.library.
+*/
+#ifndef CREDENTIALS_PRIVATE_H
+#define CREDENTIALS_PRIVATE_H
+
+#include <exec/libraries.h>
+#include <exec/semaphores.h>
+#include <libraries/credentials.h>
+
+/* AROS-native locations (no Unix dot-directory hiding dependency). */
+#define CRED_IDENTITY_VAR   "Sys/identity"   /* under ENVARC: via GetVar   */
+#define CRED_KEYRING_DIR     "ENVARC:Keyring" /* ciphertext-only blobs      */
+
+/* Non-synthetic single-user defaults (used only as the final floor). */
+#define CRED_DEFAULT_USER    "AROS"
+#define CRED_DEFAULT_HOME    "SYS:Home"
+#define CRED_DEFAULT_SHELL   ""
+#define CRED_DEFAULT_UID     1000            /* NOT 0: ports gate on uid!=0 */
+#define CRED_DEFAULT_GID     1000
+
+struct CredentialsBase
+{
+    struct Library         cb_Lib;
+    struct SignalSemaphore cb_Lock;          /* guards the cached identity  */
+
+    /* Cached identity (resolved once, refreshed on env/profile change).
+       The strings point into cb_IdBuf so the record survives past the
+       resolver call and satisfies the non-NULL invariant. */
+    struct ArosIdentity    cb_Identity;
+    BOOL                   cb_IdentityValid;
+    /* Backing storage for the identity strings (single-user is tiny). */
+    TEXT                   cb_UserBuf[64];
+    TEXT                   cb_FullBuf[128];
+    TEXT                   cb_HomeBuf[256];
+    TEXT                   cb_ShellBuf[256];
+};
+
+/* internal identity resolver (credentials_identity.c) */
+VOID cred_ResolveIdentity(struct CredentialsBase *CredentialsBase);
+
+/* Keyring handle returned by CredOpenKeyring(). Holds the (machine-transparent
+   MVP) master seed after unlock; per-entry keys are HKDF-derived on demand and
+   never stored -- only ciphertext blobs live under ENVARC:Keyring/. */
+struct CredKeyring
+{
+    struct CredentialsBase *ck_Base;
+    UBYTE                   ck_Seed[32];    /* master seed; valid iff ck_Unlocked */
+    BOOL                    ck_Unlocked;
+    BOOL                    ck_ExplicitlyLocked;
+    ULONG                   ck_Flags;       /* CRKF_*                             */
+    TEXT                    ck_Collection[64];
+};
+
+#endif /* CREDENTIALS_PRIVATE_H */
diff --git a/workbench/libs/credentials/include/credentials.h b/workbench/libs/credentials/include/credentials.h
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d8ac1dc44e6cb65b6bb657ecca9a7cd956fce
--- /dev/null
+++ b/workbench/libs/credentials/include/credentials.h
@@ -0,0 +1,55 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    credentials.library -- AROS identity + keyring substrate.
+
+    ONE library, TWO layers:
+      * IDENTITY  -- the passwd-equivalent every port needs (uv_os_get_passwd,
+                     Node os.userInfo, posixc getpwuid). CredGetIdentity() is the
+                     single source of truth; every string field is GUARANTEED
+                     non-NULL (empty "" for absent optionals, NEVER NULL).
+      * KEYRING   -- libsecret-API-compatible secret store keyed by
+                     (service, account). Derive-don't-store: BIP39 seed -> HKDF
+                     per-entry key -> AmiSSL AES-256-GCM seal; only ciphertext is
+                     persisted (ENVARC:Keyring/). uuid.library for handles/device-id.
+*/
+#ifndef LIBRARIES_CREDENTIALS_H
+#define LIBRARIES_CREDENTIALS_H
+
+#include <exec/types.h>
+
+/* -------- Identity layer -------- */
+
+/* The native AROS identity record. Resolution precedence (see
+   CredGetIdentity): (1) usergroup/MuFS current user when configured;
+   (2) ENV:USER / ENV:HOME / ENV:SHELL overrides; (3) the setup-created
+   native profile at ENVARC:Sys/identity; (4) non-synthetic defaults
+   (username "AROS", home "SYS:Home", shell "", uid/gid 1000).
+   INVARIANT: no ai_* STRPTR is ever NULL. */
+struct ArosIdentity
+{
+    STRPTR ai_UserName;     /* login name; never NULL                    */
+    STRPTR ai_FullName;     /* real name / gecos; never NULL ("" ok)     */
+    STRPTR ai_HomeDir;      /* real AROS path (e.g. SYS:Home); never NULL */
+    STRPTR ai_Shell;        /* default shell; never NULL ("" ok)         */
+    ULONG  ai_UID;          /* single-user default 1000 (NOT 0)          */
+    ULONG  ai_GID;          /* single-user default 1000                  */
+};
+
+/* -------- Keyring layer -------- */
+
+/* CredOpenKeyring() flags. */
+#define CRKF_CREATE     (1UL << 0)  /* create the collection if absent   */
+#define CRKF_READONLY   (1UL << 1)  /* open without unlock-for-write     */
+
+/* -------- Result codes (all functions returning LONG) -------- */
+#define CRED_OK          0
+#define CRED_ERR_NOTFOUND 1
+#define CRED_ERR_LOCKED   2
+#define CRED_ERR_IO       3
+#define CRED_ERR_CRYPTO   4
+#define CRED_ERR_NOMEM    5
+#define CRED_ERR_BADARG   6
+#define CRED_ERR_NOTIMPL  7   /* keyring layer stub, pre-AmiSSL wiring   */
+
+#endif /* LIBRARIES_CREDENTIALS_H */
diff --git a/workbench/libs/credentials/mmakefile.src b/workbench/libs/credentials/mmakefile.src
new file mode 100644
index 0000000000000000000000000000000000000000..5996cb97e87504972c88e96524866b45d279ac06
--- /dev/null
+++ b/workbench/libs/credentials/mmakefile.src
@@ -0,0 +1,23 @@
+
+include $(SRCDIR)/config/aros.cfg
+
+FILES := credentials_identity credentials_keyring credentials_crypto credentials_entropy
+
+USER_CPPFLAGS := -DADEBUG=1
+USER_LDFLAGS := -static
+
+# Keyring sealing uses embedded reference crypto (credentials_crypto.c:
+# ChaCha20-Poly1305 + SHA-256/HMAC/HKDF + entropy.resource) -- self-contained, no
+# external crypto library and no C-runtime/relbase baggage, so the module
+# links against nothing beyond the base AROS libs.
+#MM- workbench-libs : workbench-libs-credentials
+#MM- workbench-libs-credentials : kernel-entropy-includes
+%build_module mmake=workbench-libs-credentials \
+    modname=credentials modtype=library \
+    files="credentials_init $(FILES)"
+
+#MM includes-copy
+INCLUDE_FILES := $(call WILDCARD, include/*.h)
+%copy_includes path=libraries dir=include
+
+%common
diff --git a/workbench/libs/credentials/tests/README.md b/workbench/libs/credentials/tests/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..5226da28ae242f850f9c9410fdc6fd9729a2b346
--- /dev/null
+++ b/workbench/libs/credentials/tests/README.md
@@ -0,0 +1,16 @@
+# Credentials validation
+
+`crypto_host.c` compares the embedded primitives against OpenSSL on the host.
+`names_host.c` checks legacy login encoding, collection separation and rejection
+of overlong names; run with address and undefined-behavior sanitizers.
+
+`native_keyring.c` passes on native x86-64 AROS under QEMU with return code 0.
+It checks round-trip storage, collection separation, read-only handles, explicit
+lock/unlock and preservation of a corrupt seed. **Run only with ENVARC assigned
+to a disposable directory**: the final test intentionally writes an invalid
+seed there. No real account material is used or printed.
+
+The machine-transparent seed remains stored on disk as in the existing port.
+Passphrase protection, transactional replacement and concurrent same-handle
+operations require further work. This test is not Chromium profile integration
+or AArch64 runtime proof.
diff --git a/workbench/libs/credentials/tests/crypto_host.c b/workbench/libs/credentials/tests/crypto_host.c
new file mode 100644
index 0000000000000000000000000000000000000000..869b49d630485e8d55dc2531fcf034e9291e14bb
--- /dev/null
+++ b/workbench/libs/credentials/tests/crypto_host.c
@@ -0,0 +1,64 @@
+/* Host differential tests; OpenSSL is a test dependency, not a library dependency. */
+#include <assert.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <openssl/evp.h>
+#include <openssl/kdf.h>
+#include "../credentials_crypto.h"
+
+int main(void)
+{
+    unsigned char key[32], data[4096], blob[4124], decoded[4096], reference[8192];
+    unsigned char digest[32], expected[32];
+    const int lengths[] = {0, 1, 15, 16, 17, 63, 64, 65, 255, 4096};
+    for (int i = 0; i < 32; ++i) key[i] = (unsigned char)i;
+    for (int i = 0; i < 4096; ++i) data[i] = (unsigned char)(i * 37);
+    for (unsigned i = 0; i < sizeof lengths / sizeof *lengths; ++i) {
+        int len = lengths[i], n, tail;
+        unsigned digest_len;
+        assert(cred_crypto_sha256(data, len, digest));
+        assert(EVP_Digest(data, len, expected, &digest_len, EVP_sha256(), NULL));
+        assert(digest_len == 32 && !memcmp(digest, expected, 32));
+        assert(cred_crypto_seal(key, data, len, blob, sizeof blob) == len + 28);
+        EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+        assert(ctx);
+        assert(EVP_DecryptInit_ex(ctx, EVP_chacha20_poly1305(), NULL, key, blob));
+        assert(EVP_DecryptUpdate(ctx, reference, &n, blob + 12, len));
+        assert(EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_AEAD_SET_TAG, 16, blob + 12 + len));
+        assert(EVP_DecryptFinal_ex(ctx, reference + n, &tail) == 1);
+        assert(n + tail == len && !memcmp(data, reference, len));
+        EVP_CIPHER_CTX_free(ctx);
+        assert(cred_crypto_unseal(key, blob, len + 28, decoded, sizeof decoded) == len);
+        assert(!memcmp(data, decoded, len));
+        for (int j = 0; j < len + 28; ++j) {
+            blob[j] ^= 1;
+            memset(decoded, 0x5a, sizeof decoded);
+            assert(cred_crypto_unseal(key, blob, len + 28, decoded, sizeof decoded) == -1);
+            for (unsigned k = 0; k < sizeof decoded; ++k) assert(decoded[k] == 0x5a);
+            blob[j] ^= 1;
+        }
+    }
+    {
+        static const char salt[] = "credentials.library:hkdf:v1";
+        EVP_PKEY_CTX *ctx = EVP_PKEY_CTX_new_id(EVP_PKEY_HKDF, NULL);
+        size_t length = 80;
+        assert(ctx && EVP_PKEY_derive_init(ctx) > 0);
+        assert(EVP_PKEY_CTX_set_hkdf_md(ctx, EVP_sha256()) > 0);
+        assert(EVP_PKEY_CTX_set1_hkdf_salt(ctx, salt, sizeof salt - 1) > 0);
+        assert(EVP_PKEY_CTX_set1_hkdf_key(ctx, key, sizeof key) > 0);
+        assert(EVP_PKEY_CTX_add1_hkdf_info(ctx, data, 64) > 0);
+        assert(EVP_PKEY_derive(ctx, reference, &length) > 0);
+        assert(cred_crypto_hkdf(key, 32, data, 64, decoded, 80));
+        assert(length == 80 && !memcmp(reference, decoded, 80));
+        EVP_PKEY_CTX_free(ctx);
+    }
+    assert(cred_crypto_seal(key, data, INT_MAX, blob, sizeof blob) == -1);
+    assert(cred_crypto_seal(key, data, -1, blob, sizeof blob) == -1);
+    assert(cred_crypto_unseal(key, blob, INT_MIN, decoded, sizeof decoded) == -1);
+    assert(cred_crypto_unseal(key, blob, 27, decoded, sizeof decoded) == -1);
+    assert(!cred_crypto_hkdf(key, 32, data, 513, decoded, 32));
+    assert(!cred_crypto_random(NULL, 32));
+    puts("PASS: SHA256, HKDF, ChaCha20-Poly1305 interoperability and tamper rejection");
+    return 0;
+}
diff --git a/workbench/libs/credentials/tests/names_host.c b/workbench/libs/credentials/tests/names_host.c
new file mode 100644
index 0000000000000000000000000000000000000000..6d251c7336ae581b1b00a452b46ae413e1f42a2b
--- /dev/null
+++ b/workbench/libs/credentials/tests/names_host.c
@@ -0,0 +1,23 @@
+#include <assert.h>
+#include <stdio.h>
+#include "../credentials_names.h"
+int main(void)
+{
+    unsigned char a[600], b[600];
+    char long_name[514];
+    int n = cred_name_info("login", "service", "account", a, sizeof a);
+    static const unsigned char legacy[] = "cred:v1:service\0account";
+    assert(n == sizeof legacy - 1 && !memcmp(a, legacy, n));
+    int m = cred_name_info("other", "service", "account", b, sizeof b);
+    assert(m > 0 && (n != m || memcmp(a, b, n)));
+    n = cred_name_info("other", "a", "bc", a, sizeof a);
+    m = cred_name_info("other", "ab", "c", b, sizeof b);
+    assert(n == m && memcmp(a, b, n));
+    memset(long_name, 'x', sizeof long_name); long_name[513] = 0;
+    assert(cred_name_info("login", long_name, "a", a, sizeof a) == -1);
+    assert(cred_name_info(long_name, "s", "a", a, sizeof a) == -1);
+    assert(cred_name_info("", "s", "a", a, sizeof a) == -1);
+    assert(cred_name_info("login", "s", "a", a, 9) == -1);
+    puts("PASS: legacy login compatibility, collection separation, no truncation");
+    return 0;
+}
diff --git a/workbench/libs/credentials/tests/native_keyring.c b/workbench/libs/credentials/tests/native_keyring.c
new file mode 100644
index 0000000000000000000000000000000000000000..2c756978f5e42e974dd5eef8263401dec970db25
--- /dev/null
+++ b/workbench/libs/credentials/tests/native_keyring.c
@@ -0,0 +1,44 @@
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/credentials.h>
+#include <libraries/credentials.h>
+#include <stdio.h>
+#include <string.h>
+struct Library *CredentialsBase;
+#define CHECK(x) do { if (!(x)) { printf("FAIL line %d\n", __LINE__); return 10; } } while (0)
+int main(void) {
+    APTR a, b, ro, p = NULL;
+    ULONG n = 0;
+    static const char secret[] = "synthetic-test-value";
+    puts("JOB-0254 native credentials isolation probe (synthetic data)");
+    CredentialsBase = OpenLibrary("credentials.library", 1);
+    CHECK(CredentialsBase);
+    a = CredOpenKeyring("login", CRKF_CREATE);
+    b = CredOpenKeyring("other", CRKF_CREATE);
+    ro = CredOpenKeyring("login", CRKF_READONLY);
+    CHECK(a && b && ro);
+    CHECK(CredKeyringStore(a, "probe", "account", secret, sizeof secret, "probe") == CRED_OK);
+    CHECK(CredKeyringLookup(a, "probe", "account", &p, &n) == CRED_OK);
+    CHECK(n == sizeof secret && !memcmp(p, secret, n)); CredKeyringFree(p, n);
+    CHECK(CredKeyringLookup(b, "probe", "account", &p, &n) == CRED_ERR_NOTFOUND);
+    CHECK(CredKeyringStore(ro, "probe", "account", secret, sizeof secret, "probe") == CRED_ERR_LOCKED);
+    CHECK(CredKeyringDelete(ro, "probe", "account") == CRED_ERR_LOCKED);
+    CHECK(CredKeyringLock(a) == CRED_OK);
+    CHECK(CredKeyringLookup(a, "probe", "account", &p, &n) == CRED_ERR_LOCKED);
+    CHECK(CredKeyringUnlock(a, NULL) == CRED_OK);
+    CHECK(CredKeyringLookup(a, "probe", "account", &p, &n) == CRED_OK); CredKeyringFree(p, n);
+    CHECK(CredKeyringDelete(a, "probe", "account") == CRED_OK);
+    CredCloseKeyring(a); CredCloseKeyring(b); CredCloseKeyring(ro);
+    /* ENVARC is an isolated RAM directory set by the test startup script. */
+    BPTR f = Open("ENVARC:Keyring/.seed", MODE_NEWFILE);
+    CHECK(f); CHECK(Write(f, "bad", 3) == 3); CHECK(Close(f));
+    a = CredOpenKeyring("login", CRKF_CREATE); CHECK(a);
+    CHECK(CredKeyringUnlock(a, NULL) == CRED_ERR_CRYPTO);
+    CredCloseKeyring(a);
+    char seed[40] = {0}; f = Open("ENVARC:Keyring/.seed", MODE_OLDFILE);
+    CHECK(f); CHECK(Read(f, seed, sizeof seed) == 3); CHECK(Close(f));
+    CHECK(!memcmp(seed, "bad", 3));
+    CloseLibrary(CredentialsBase);
+    puts("PASS: collections, readonly, explicit lock, corrupt seed preserved");
+    return 0;
+}
