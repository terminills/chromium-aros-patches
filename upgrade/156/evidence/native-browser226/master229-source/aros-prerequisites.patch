-        "msr    spsr_el1, x0         \n"
+        "msr    elr_el1, %[entry]    \n"
+        "mov    x0, %[sys_base]      \n"
+        "mov    x1, #0x4             \n"  /* EL1t, SP_EL0 */
+        "msr    spsr_el1, x1         \n"
