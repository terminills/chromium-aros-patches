diff --git a/src/dawn/native/ArosSystemEvent.h b/src/dawn/native/ArosSystemEvent.h
new file mode 100644
index 0000000000000000000000000000000000000000..5e70892f5b5f6849d6ce76a28aa607cb167d1f33
--- /dev/null
+++ b/src/dawn/native/ArosSystemEvent.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Dawn & Tint Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef SRC_DAWN_NATIVE_AROSSYSTEMEVENT_H_
+#define SRC_DAWN_NATIVE_AROSSYSTEMEVENT_H_
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+namespace dawn::native {
+// One-shot state shared by sender and receiver. The wait-set mutex protects it.
+struct ArosSystemEventState {
+    bool signaled = false;
+};
+
+class ArosSystemEventWaitSet {
+  public:
+    void Signal(ArosSystemEventState& event) {
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            event.signaled = true;
+        }
+        mCondition.notify_all();
+    }
+
+    template <typename Predicate>
+    bool Wait(uint64_t nanoseconds, Predicate ready) {
+        std::unique_lock<std::mutex> lock(mMutex);
+        if (ready()) return true;
+        if (nanoseconds == 0) return false;
+        if (nanoseconds == std::numeric_limits<uint64_t>::max()) {
+            mCondition.wait(lock, ready);
+            return true;
+        }
+        using Clock = std::chrono::steady_clock;
+        const auto now = Clock::now();
+        const auto remaining = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            Clock::time_point::max() - now).count();
+        const auto duration = std::chrono::nanoseconds(
+            std::min(nanoseconds, static_cast<uint64_t>(remaining)));
+        return mCondition.wait_until(lock, now + duration, ready);
+    }
+
+  private:
+    std::mutex mMutex;
+    std::condition_variable mCondition;
+};
+
+inline ArosSystemEventWaitSet& GetArosSystemEventWaitSet() {
+    static ArosSystemEventWaitSet waitSet;
+    return waitSet;
+}
+}  // namespace dawn::native
+#endif
