+#if BUILDFLAG(IS_AROS)
+template <typename T>
+struct IsArosHeapPersistent : std::false_type {};
+template <typename T, typename Weakness, typename Location, typename Checking>
+struct IsArosHeapPersistent<
+    cppgc::internal::BasicPersistent<T, Weakness, Location, Checking>>
+    : std::true_type {};
+
+// Heap roots must belong to the logical renderer that allocated their pointee.
+// The handle wrapper retains static lifetime; its heap clears it on retirement.
+// A distinct call-site tag and monotonic owner identity prevent later renderers
+// or sibling applications from inheriting that cleared root. Ordinary statics
+// and explicitly cross-thread persistent handles keep their existing semantics.
+template <typename Type, typename Tag, typename HeapNew, typename PlacementNew>
+Type& ArosStaticSingletonGet(bool allow_cross_thread, const HeapNew& heap_new,
+                            const PlacementNew& placement_new) {
+  if constexpr (IsArosHeapPersistent<std::remove_cv_t<Type>>::value) {
+    struct OwnerSlot {
+      base::Lock lock;
+      StaticSingleton<Type>* singleton = nullptr;
+    };
+    auto& slot = base::aros::ProcessLocalValue<OwnerSlot, Tag>();
+    // Serialize first construction within this owner, retaining the ordinary
+    // singleton's initialization and thread-use checks.
+    base::AutoLock lock(slot.lock);
+    if (!slot.singleton)
+      slot.singleton = new StaticSingleton<Type>(heap_new, placement_new);
+    return slot.singleton->Get(allow_cross_thread);
+  } else {
+    static StaticSingleton<Type> singleton(heap_new, placement_new);
+    return singleton.Get(allow_cross_thread);
+  }
+}
+#endif
 
