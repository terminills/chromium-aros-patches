+        let (mut a, mut p) = (0u32, 0u16);
+        let fd = unsafe { aros_np_accept(self.0.fd(), &mut a, &mut p) };
+        if fd < 0 {
+            return Err(last_error());
+        }
+        Ok((TcpStream(Socket::from_raw(fd)), SocketAddr::V4(raw_to_v4(a, p))))
+    }
