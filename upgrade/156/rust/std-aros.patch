+//! Randomness from native AROS posixc/entropy.resource.
+//! Fail closed if the OS cannot supply entropy; never substitute a clock PRNG.
+use crate::ffi::c_void;
+
+unsafe extern "C" {
+    fn getentropy(buf: *mut c_void, len: usize) -> i32;
+}
+
+pub fn fill_bytes(bytes: &mut [u8]) {
+    // POSIX getentropy accepts at most 256 bytes per request.
+    for chunk in bytes.chunks_mut(256) {
+        let result = unsafe { getentropy(chunk.as_mut_ptr().cast(), chunk.len()) };
+        if result != 0 {
+            panic!("AROS entropy unavailable: {}", crate::io::Error::last_os_error());
+        }
+    }
+}
