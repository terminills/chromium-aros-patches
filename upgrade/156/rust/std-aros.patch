+    let target = cstr(original)?;
+    let linkpath = cstr(link)?;
+    if unsafe { c::symlink(target.as_ptr(), linkpath.as_ptr()) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
