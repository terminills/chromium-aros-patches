diff --git a/BUILD.gn b/BUILD.gn
index 2018b0dc0401765f44d94a61a8947072519ad413..15b4560cf282d07200562011569daca62c16ae87 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -926,6 +926,20 @@ source_set("libcef_static") {
     "//chrome/app/chrome_main_delegate.h",
   ]
 
+  if (is_aros) {
+    # CEF compiles ChromeMainDelegate directly instead of consuming the
+    # chrome/app target, so include its AROS profile bootstrap alongside it.
+    sources += [
+      "//chrome/app/aros_user_data_dir.cc",
+      "//chrome/app/aros_user_data_dir.h",
+    ]
+
+    # Crashpad is not available on AROS. crash_reporting.cc keeps the public
+    # CEF hooks as no-ops, so do not pull the Crashpad client implementation
+    # (and its unsupported platform base) into the resident archive.
+    sources -= [ "libcef/common/crash_reporter_client.cc" ]
+  }
+
   configs += [
     "libcef/features:config",
     "//build/config:precompiled_headers",
@@ -1017,7 +1031,6 @@ source_set("libcef_static") {
     "//third_party/blink/public:blink",
     "//third_party/brotli:dec",
     "//third_party/cld_3/src/src:cld_3",
-    "//third_party/crashpad/crashpad/handler",
     "//third_party/hunspell",
     "//third_party/leveldatabase",
     "//third_party/libxml:libxml",
@@ -1041,6 +1054,10 @@ source_set("libcef_static") {
     "//v8",
   ]
 
+  if (!is_aros) {
+    deps += [ "//third_party/crashpad/crashpad/handler" ]
+  }
+
   if (is_win) {
     sources += includes_win + [
       "libcef/browser/native/browser_platform_delegate_native_win.cc",
@@ -1098,6 +1115,24 @@ source_set("libcef_static") {
     }
   }
 
+  if (is_aros) {
+    # The non-X11 path in these Aura delegates is platform-neutral. Reuse it
+    # until CEF needs an Alloy-owned native host window on AROS; Chrome runtime
+    # and CEF Views already create their windows through Ozone.
+    sources += [
+      "libcef/browser/native/browser_platform_delegate_native_linux.cc",
+      "libcef/browser/native/browser_platform_delegate_native_linux.h",
+      "libcef/browser/osr/browser_platform_delegate_osr_linux.cc",
+      "libcef/browser/osr/browser_platform_delegate_osr_linux.h",
+      "libcef/common/util_linux.cc",
+      "libcef/common/util_linux.h",
+    ]
+
+    # CefWindowInfo::window is the Intuition window on AROS; the Ozone
+    # platform resolves it from the Aura host's AcceleratedWidget.
+    deps += [ "//ui/ozone/platform/aros" ]
+  }
+
   if (is_mac) {
     sources += includes_mac + [
       "libcef/browser/chrome/chrome_content_browser_client_cef_mac.mm",
@@ -1720,6 +1755,11 @@ action("make_config_header") {
   outputs = [ "$root_gen_dir/cef/include/cef_config.h" ]
 
   args = rebase_path(outputs + inputs, root_build_dir)
+  if (ozone_platform_x11) {
+    args += [ "true" ]
+  } else {
+    args += [ "false" ]
+  }
 }
 
 # Generate cef_color_ids.h.
@@ -1942,10 +1982,21 @@ if (is_mac) {
     info_plist_target = ":cef_framework_plist"
   }
 } else {
-  shared_library("libcef") {
+  # AROS resident libraries are linked from the complete engine archive.
+  if (is_aros) {
+    libcef_target_type = "static_library"
+  } else {
+    libcef_target_type = "shared_library"
+  }
+
+  target(libcef_target_type, "libcef") {
     # Necessary because the libcef_test_support target is testonly.
     testonly = true
 
+    if (is_aros) {
+      complete_static_lib = true
+    }
+
     sources = libcef_sources_common
 
     deps = libcef_deps_common
