+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#if defined(__AROS__)
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/utility.h>
+#include <utility/name.h>
+#include <exec/semaphores.h>
+#include <exec/memory.h>
+#include <stdatomic.h>
+#include <stdint.h>
+
+// One data-only registry shared by native SQLite consumers. No code pointers
+// or client allocator storage may escape into this OS-owned object. Database
+// entries and connections are reclaimed on close; the small registry remains
+// until reboot. Version the name whenever this private data ABI changes.
+struct ArosSqlConnection;
+struct ArosSqlDatabase {
+  struct ArosSqlDatabase *next;
+  BPTR identity;
+  unsigned references, readers;
+  struct ArosSqlConnection *reserved, *pending, *exclusive;
+};
+struct ArosSqlRegistry {
+  struct SignalSemaphore mutex;
+  struct ArosSqlDatabase *databases;
+};
+struct ArosSqlConnection {
+  struct ArosSqlRegistry *registry;
+  struct ArosSqlDatabase *database;
+  int level;
+};
+static _Atomic(uintptr_t) registry_address;
+static struct ArosSqlRegistry *registry(void) {
+  uintptr_t value=atomic_load_explicit(&registry_address,memory_order_acquire);
+  if(value>1)return (void*)value;
+  uintptr_t empty=0;
+  if(atomic_compare_exchange_strong(&registry_address,&empty,1)) {
+    const char *name="AROS.SQLite.NativeLockRegistry.v1";
+    struct NamedObject *object=FindNamedObject(NULL,name,NULL);
+    if(!object) {
+      struct TagItem tags[]={{ANO_UserSpace,sizeof(struct ArosSqlRegistry)},{TAG_DONE,0}};
+      struct NamedObject *candidate=AllocNamedObjectA(name,tags);
+      if(candidate) {
+        struct ArosSqlRegistry *r=candidate->no_Object;
+        r->databases=NULL; InitSemaphore(&r->mutex);
+        if(AddNamedObject(NULL,candidate)) {
+          // Older utility.library versions fail to enforce NSF_NODUPS.
+          // Equal-priority publication is FIFO: always select the oldest,
+          // permanently retained object, including after our own publish.
+          object=FindNamedObject(NULL,name,NULL);
+          if(object && object!=candidate) {
+            ReleaseNamedObject(candidate);
+            RemNamedObject(candidate,NULL);
+            FreeNamedObject(candidate);
+          }
+        } else {FreeNamedObject(candidate);object=FindNamedObject(NULL,name,NULL);}
+      }
+    }
+    value=object?(uintptr_t)object->no_Object:0;
+    // Retain the registry reference. ReleaseNamedObject currently uses Forbid
+    // rather than an SMP lock; this permanent object is never removed.
+    atomic_store_explicit(&registry_address,value,memory_order_release);
+    return (void*)value;
+  }
+  do {Delay(1);value=atomic_load_explicit(&registry_address,memory_order_acquire);}while(value==1);
+  return (void*)value;
+}
+void *chromiumArosLockOpen(const char *path) {
+  struct ArosSqlRegistry *r=registry(); if(!r)return NULL;
+  BPTR identity=Lock(path,SHARED_LOCK); if(!identity)return NULL;
+  struct ArosSqlConnection *c=AllocVec(sizeof(*c),MEMF_PUBLIC|MEMF_CLEAR);
+  struct ArosSqlDatabase *fresh=AllocVec(sizeof(*fresh),MEMF_PUBLIC|MEMF_CLEAR);
+  if(!c || !fresh){if(c)FreeVec(c);if(fresh)FreeVec(fresh);UnLock(identity);return NULL;}
+  ObtainSemaphore(&r->mutex);
+  struct ArosSqlDatabase *d=r->databases;
+  while(d && SameLock(d->identity,identity)!=LOCK_SAME)d=d->next;
+  if(!d){d=fresh;fresh=NULL;d->identity=identity;identity=0;d->next=r->databases;r->databases=d;}
+  ++d->references;c->database=d;c->registry=r;
+  ReleaseSemaphore(&r->mutex);
+  if(fresh)FreeVec(fresh);if(identity)UnLock(identity);
+  return c;
+}
+int chromiumArosLock(void *context,int level) {
+  struct ArosSqlConnection *c=context;struct ArosSqlDatabase *d=c->database;
+  int rc=0; ObtainSemaphore(&c->registry->mutex);
+  if(level>c->level) {
+    if(level==1) {
+      if(d->pending || d->exclusive)rc=5;
+      else {++d->readers;c->level=1;}
+    } else if(level==2) {
+      if(d->reserved && d->reserved!=c)rc=5;
+      else {d->reserved=c;c->level=2;}
+    } else if(level==4) {
+      if((d->pending && d->pending!=c)||(d->reserved && d->reserved!=c))rc=5;
+      else {
+        d->pending=c;c->level=3;
+        if(d->readers!=1)rc=5;
+        else {d->exclusive=c;c->level=4;}
+      }
+    } else rc=10;
+  }
+  ReleaseSemaphore(&c->registry->mutex);return rc;
+}
+int chromiumArosLockLevel(void *context) {return ((struct ArosSqlConnection*)context)->level;}
+int chromiumArosUnlock(void *context,int level) {
+  struct ArosSqlConnection *c=context;struct ArosSqlDatabase *d=c->database;
+  ObtainSemaphore(&c->registry->mutex);
+  if(c->level>level) {
+    if(d->reserved==c)d->reserved=NULL;
+    if(d->pending==c)d->pending=NULL;
+    if(d->exclusive==c)d->exclusive=NULL;
+    if(level==0 && c->level>=1)--d->readers;
+    c->level=level;
+  }
+  ReleaseSemaphore(&c->registry->mutex);return 0;
+}
+int chromiumArosReserved(void *context,int *result) {
+  struct ArosSqlConnection *c=context;
+  ObtainSemaphore(&c->registry->mutex);
+  *result=c->database->reserved || c->database->pending || c->database->exclusive;
+  ReleaseSemaphore(&c->registry->mutex);return 0;
+}
+void chromiumArosLockClose(void *context) {
+  struct ArosSqlConnection *c=context;if(!c)return;
+  chromiumArosUnlock(c,0);
+  struct ArosSqlRegistry *r=c->registry;struct ArosSqlDatabase *d=c->database;
+  ObtainSemaphore(&r->mutex);
+  int last=--d->references==0;
+  if(last){struct ArosSqlDatabase **link=&r->databases;while(*link!=d)link=&(*link)->next;*link=d->next;}
+  ReleaseSemaphore(&r->mutex);
+  if(last){UnLock(d->identity);FreeVec(d);}FreeVec(c);
+}
