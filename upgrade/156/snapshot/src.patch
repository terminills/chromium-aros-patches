index 0000000000000000000000000000000000000000..f5a2ee0350c6acca94bfc6dee30772e6bc517fe6
--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "partition_alloc/shim/allocator_shim_aros_libc.h"
+
+#include <atomic>
+#include <cstdio>
+
+#include <defines/stdc_LVO.h>
+
+// <proto/stdc.h> pulls in the complete C library prototypes, which include
+// C99 complex-number declarations that do not parse in C++. Only the library
+// base getter (provided by libstdc's auto-open code) is needed here.
+extern "C" struct StdCBase* __aros_getbase_StdCBase(void);
+
+// Reached directly rather than through proto/debug.h for the same reason, and
+// because this must stay callable from inside malloc.
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+namespace allocator_shim::internal {
+
+namespace {
+
+// __aros_getbase_StdCBase() resolves the library base PER TASK, and a task that
+// never opened stdc - or whose base was closed under it, as the posixc thread
+// leave hook has been seen to do - gets a stale or freed pointer back. Reading
+// StdCBase->mempool through that lands AllocPooled() with a garbage pool: a
+// #GP whose faulting "pointer" is actually code bytes.
+//
+// That was survivable while this file only served the rare foreign-pointer
+// free. It is not survivable once the shim's default dispatch routes EVERY
+// allocation here, which is what allocator_shim_default_dispatch_to_aros_libc.cc
+// does. So latch the first base that resolves non-null and keep using it: the
+// malloc pool is process-global and MEMF_SEM_PROTECTED (compiler/crt/stdc/
+// malloc.c), so one base serving every thread is exactly as safe as one base
+// per thread, and it cannot be closed out from under an unrelated task.
+//
+// A plain global, not a function-local static: the latter needs a guard
+// variable, and __cxa_guard_acquire is not something to invoke from inside
+// malloc.
+std::atomic<void**> g_stdc_base{nullptr};
+std::atomic<bool> g_stdc_base_logged{false};
+std::atomic<bool> g_stdc_base_mismatch_logged{false};
+
+void** StdCBaseCached() {
+  void** cached = g_stdc_base.load(std::memory_order_acquire);
+  void** current = reinterpret_cast<void**>(__aros_getbase_StdCBase());
+
+  if (cached == nullptr) {
+    if (current == nullptr) {
+      return nullptr;  // Nothing usable yet; the caller reports the failure.
+    }
+    g_stdc_base.store(current, std::memory_order_release);
+    if (!g_stdc_base_logged.exchange(true, std::memory_order_relaxed)) {
+      char line[96];
+      std::snprintf(line, sizeof(line), "[Chromium:stdc] base latched %p\n",
+                    static_cast<void*>(current));
+      ArosKPutStr(line);
+    }
+    return current;
+  }
+
+  // Whether per-task bases actually diverge is the open question behind this
+  // whole change, so say so once rather than silently papering over it.
+  //
+  // This deliberately reports current==nullptr too. An earlier version of this
+  // check read `current != cached && current != nullptr`, which excluded the
+  // ONE case that actually occurs - a Chromium-created thread with no per-task
+  // base at all - so it printed nothing and I misread the silence as "bases
+  // never diverge". Report the case you are hunting.
+  if (current != cached &&
+      !g_stdc_base_mismatch_logged.exchange(true, std::memory_order_relaxed)) {
+    char line[160];
+    std::snprintf(line, sizeof(line),
+                  "[Chromium:stdc] per-task base differs: latched %p, this "
+                  "task %p%s - using the latched one\n",
+                  static_cast<void*>(cached), static_cast<void*>(current),
+                  current == nullptr ? " (NULL: thread never opened stdc)"
+                                     : "");
+    ArosKPutStr(line);
+  }
+  return cached;
+}
+
+}  // namespace
+
+}  // namespace allocator_shim::internal
+
+// stdc.library is a genmodule `peropenerbase` library. Its jump-table entries
+// are NOT plain C functions: each one is the AROS_GM_STACKCALL thunk from
+// arch/x86_64-all/include/aros/genmodule.h, which expects the LIBRARY BASE IN
+// %r11 (the linklib stub AROS_GM_LIBFUNCSTUB loads it there before jumping),
+// calls __aros_setoffsettable(%r11) to make that base the task's current one,
+// and only then jumps to the real free()/malloc(). Calling base[-LVO] through
+// a C function pointer therefore feeds whatever %r11 happens to hold - which
+// on x86_64 is usually the scratch register the compiler just used for the
+// indirect call itself, i.e. the thunk's own address - into the offset table,
+// and the library then reads `StdCBase->mempool` out of code bytes (the
+// `movabs`-opcode "pool pointer" and the NULL-StdCBase-inside-malloc traps).
+//
+// So reach the vectors exactly the way the generated linklib does: a tail
+// jump with %r11 = base, arguments untouched, from a stub that reads the base
+// out of `aros_stdc_shim_base`. The stubs are entered only after the C wrapper
+// has checked that the latched base is non-null.
+extern "C" {
+extern std::atomic<void**> aros_stdc_shim_base;
+}
+std::atomic<void**> aros_stdc_shim_base{nullptr};
+
+#define AROS_STDC_STRINGIZE_(x) #x
+#define AROS_STDC_STRINGIZE(x) AROS_STDC_STRINGIZE_(x)
+#if defined(__x86_64__)
+#define AROS_STDC_LVO_STUB(name, lvo)                              \
+  asm(".text\n"                                                    \
+      "\t.type " #name ", @function\n"                             \
+      #name ":\n"                                                  \
+      "\tmovq aros_stdc_shim_base(%rip), %r11\n"                   \
+      "\tjmp *-(" AROS_STDC_STRINGIZE(lvo) "*8)(%r11)\n"           \
+      "\t.size " #name ", .-" #name "\n");
+#elif defined(__aarch64__)
+// Match AROS_GM_LIBFUNCSTUB: x16 carries the per-opener library base;
+// x17 holds the vector target. Argument registers and LR remain untouched.
+// Use a literal address for the large code model and acquire the published base.
+#define AROS_STDC_LVO_STUB(name, lvo)                              \
+  asm(".text\n"                                                   \
+      "\t.balign 4\n"                                            \
+      "\t.type " #name ", %function\n"                           \
+      #name ":\n"                                                 \
+      "\tldr x16, 1f\n"                                          \
+      "\tldar x16, [x16]\n"                                      \
+      "\tsub x17, x16, #(" AROS_STDC_STRINGIZE(lvo) "*8)\n"      \
+      "\tldr x17, [x17]\n"                                       \
+      "\tbr x17\n"                                               \
+      "\t.size " #name ", .-" #name "\n"                         \
+      "\t.balign 8\n"                                            \
+      "1:\t.quad aros_stdc_shim_base\n");
+#else
+#error "Implement the AROS stdc vector-call ABI for this architecture"
+#endif
+
+extern "C" {
+void aros_stdc_shim_free(void* ptr);
+void* aros_stdc_shim_realloc(void* ptr, size_t size);
+void* aros_stdc_shim_malloc(size_t size);
+void* aros_stdc_shim_calloc(size_t n, size_t size);
+void* aros_stdc_shim_aligned_alloc(size_t alignment, size_t size);
+}
+
+AROS_STDC_LVO_STUB(aros_stdc_shim_free, LVOfree)
+AROS_STDC_LVO_STUB(aros_stdc_shim_realloc, LVOrealloc)
+AROS_STDC_LVO_STUB(aros_stdc_shim_malloc, LVOmalloc)
+AROS_STDC_LVO_STUB(aros_stdc_shim_calloc, LVOcalloc)
+AROS_STDC_LVO_STUB(aros_stdc_shim_aligned_alloc, LVOaligned_alloc)
+
+namespace allocator_shim::internal {
+
+namespace {
+
+// Resolves (and latches) the base the stubs will jump through. A null return
+// means stdc is unreachable and the caller must fail the request itself.
+bool StdCReady() {
+  void** base = StdCBaseCached();
+  if (base == nullptr) {
+    return false;
+  }
+  aros_stdc_shim_base.store(base, std::memory_order_release);
+  return true;
+}
+
+}  // namespace
+
+// Every entry point checks the base rather than jumping through a null. If
+// stdc is genuinely unreachable the allocation has to fail, but it must fail
+// as a null return the caller can handle - not as a jump to address zero from
+// inside malloc, which is unreadable in a crash log.
+void ArosLibcFree(void* ptr) {
+  if (StdCReady()) {
+    aros_stdc_shim_free(ptr);
+  }
+}
+
+void* ArosLibcRealloc(void* ptr, size_t size) {
+  return StdCReady() ? aros_stdc_shim_realloc(ptr, size) : nullptr;
+}
+
+void* ArosLibcMalloc(size_t size) {
+  return StdCReady() ? aros_stdc_shim_malloc(size) : nullptr;
+}
+
+void* ArosLibcCalloc(size_t n, size_t size) {
+  return StdCReady() ? aros_stdc_shim_calloc(n, size) : nullptr;
+}
+
+void* ArosLibcAlignedAlloc(size_t alignment, size_t size) {
+  // C11 aligned_alloc() takes a size that is a multiple of the alignment,
+  // while the memalign() this stands in for does not. Round up rather than
+  // fail, which is what every libc that implements one in terms of the other
+  // does.
+  const size_t rounded = (size + alignment - 1) & ~(alignment - 1);
+  if (rounded < size) {
+    return nullptr;  // Overflowed.
+  }
+  return StdCReady() ? aros_stdc_shim_aligned_alloc(alignment, rounded)
+                     : nullptr;
+}
+
+}  // namespace allocator_shim::internal
