+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "ui/base/base_window.h"
+
+// Report Chromium fullscreen windows across profiles. Native windows belonging
+// to other applications are outside this browser-local query.
+bool IsFullScreenMode() {
+  for (auto* browser : GetAllBrowserWindowInterfaces()) {
+    if (auto* window = browser->GetWindow(); window && window->IsFullscreen())
+      return true;
+  }
+  return false;
+}
