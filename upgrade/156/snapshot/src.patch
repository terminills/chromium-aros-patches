+
+void ArosWindow::HandleNativeEvent(uint32_t message_class,
+                                   uint16_t code,
+                                   uint16_t qualifier,
+                                   int16_t mouse_x,
+                                   int16_t mouse_y) {
+  if (shutting_down_) {
+    return;
+  }
+
+  switch (message_class) {
+    case IDCMP_CLOSEWINDOW:
+      delegate_->OnCloseRequest();
+      break;
+    case IDCMP_NEWSIZE:
+    case IDCMP_CHANGEWINDOW:
+      UpdateBoundsFromNative(/*notify_delegate=*/true);
+      break;
+    case IDCMP_REFRESHWINDOW:
+      if (window_) {
+        BeginRefresh(window_);
+      }
+      if (!BlitNativeBackingStore(gfx::Rect(bounds_.size()))) {
+        delegate_->OnDamageRect(gfx::Rect(bounds_.size()));
+      }
+      if (window_) {
+        EndRefresh(window_, TRUE);
+      }
+      break;
+    case IDCMP_ACTIVEWINDOW:
+      HandleActiveWindow();
+      break;
+    case IDCMP_INACTIVEWINDOW:
+      HandleInactiveWindow();
+      break;
+    case IDCMP_MOUSEMOVE:
+      DispatchMouseMove(qualifier, mouse_x, mouse_y);
+      break;
+    case IDCMP_MOUSEBUTTONS:
+      DispatchMouseButton(code, qualifier, mouse_x, mouse_y);
+      break;
+    case IDCMP_RAWKEY:
+      DispatchRawKey(code, qualifier, mouse_x, mouse_y);
+      break;
+    default:
+      break;
+  }
+}
+
+ArosWindow* ArosWindow::MouseEventTarget(int16_t mouse_x,
+                                         int16_t mouse_y,
+                                         gfx::Point* location,
+                                         gfx::Point* root_location) {
+  *root_location =
+      gfx::Point(window_->LeftEdge + mouse_x, window_->TopEdge + mouse_y);
+
+  // Intuition reports the event to the window under the pointer.  While
+  // another window holds capture (a menu host, for the life of its menu)
+  // the event belongs to it instead, in its own client coordinates and
+  // regardless of its bounds: that is what lets MenuController see the
+  // click outside the menu that dismisses it.
+  ArosWindow* const grabber = manager_->capture_window();
+  if (grabber && grabber != this && grabber->window_) {
+    *location = *root_location -
+                gfx::Vector2d(grabber->window_->LeftEdge +
+                                  grabber->window_->BorderLeft,
+                              grabber->window_->TopEdge +
+                                  grabber->window_->BorderTop);
+    return grabber;
+  }
+
+  *location =
+      gfx::Point(mouse_x - window_->BorderLeft, mouse_y - window_->BorderTop);
+  const gfx::Rect client_bounds(bounds_.size());
+  if (!capture_ && !client_bounds.Contains(*location)) {
+    return nullptr;
+  }
+  return this;
+}
+
+void ArosWindow::DispatchMouseMove(uint16_t qualifier,
+                                   int16_t mouse_x,
+                                   int16_t mouse_y) {
+  if (!window_) {
+    return;
+  }
+
+  gfx::Point location;
+  gfx::Point root_location;
+  ArosWindow* const target =
+      MouseEventTarget(mouse_x, mouse_y, &location, &root_location);
+  if (!target) {
+    return;
+  }
+
+  MouseEvent event(EventType::kMouseMoved, location, root_location, EventTimeForNow(),
+                   ModifierFlagsFromQualifier(qualifier) |
+                       MouseFlagsFromQualifier(qualifier),
+                   EF_NONE);
+  target->delegate_->DispatchEvent(&event);
+}
+
+void ArosWindow::DispatchMouseButton(uint16_t code,
+                                     uint16_t qualifier,
+                                     int16_t mouse_x,
+                                     int16_t mouse_y) {
+  if (!window_) {
+    return;
+  }
+
+  const int changed_button = MouseButtonFlagFromCode(code);
+  if (changed_button == EF_NONE) {
+    return;
+  }
+
+  gfx::Point location;
+  gfx::Point root_location;
+  ArosWindow* const target =
+      MouseEventTarget(mouse_x, mouse_y, &location, &root_location);
+  if (!target) {
+    return;
+  }
+
+  // Button state comes from the qualifier: it is per pointer, not per
+  // window.  A per-window copy is stale from the moment a press and its
+  // release are delivered to different windows (a press on the page whose
+  // release is rerouted to the context menu that opened under capture) until
+  // the next move over the first window resyncs it, and key and wheel events
+  // in between carry the stale buttons.  The qualifier of a release no
+  // longer carries the released button; Chromium expects it in flags, so add
+  // it back.
+  const bool released = (code & IECODE_UP_PREFIX) != 0;
+  MouseEvent event(released ? EventType::kMouseReleased : EventType::kMousePressed, location,
+                   root_location, EventTimeForNow(),
+                   ModifierFlagsFromQualifier(qualifier) |
+                       MouseFlagsFromQualifier(qualifier) | changed_button,
+                   changed_button);
+  event.InitializeNative();
+  target->delegate_->DispatchEvent(&event);
+}
+
+void ArosWindow::DispatchRawKey(uint16_t code,
+                                uint16_t qualifier,
+                                int16_t mouse_x,
+                                int16_t mouse_y) {
+  const bool released = (code & IECODE_UP_PREFIX) != 0;
+  const uint16_t raw_code = code & ~IECODE_UP_PREFIX;
+
+  if (IsMouseWheelRawKey(raw_code)) {
+    if (released || !window_) {
+      return;
+    }
+    gfx::Point location;
+    gfx::Point root_location;
+    ArosWindow* const target =
+        MouseEventTarget(mouse_x, mouse_y, &location, &root_location);
+    if (!target) {
+      return;
+    }
+    gfx::Vector2d offset;
+    switch (raw_code) {
+      case RAWKEY_NM_WHEEL_UP:
+        offset.set_y(MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_DOWN:
+        offset.set_y(-MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_LEFT:
+        offset.set_x(MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_RIGHT:
+        offset.set_x(-MouseWheelEvent::kWheelDelta);
+        break;
+    }
+    MouseWheelEvent event(offset, location, root_location, EventTimeForNow(),
+                          ModifierFlagsFromQualifier(qualifier) |
+                              MouseFlagsFromQualifier(qualifier),
+                          EF_NONE);
+    target->delegate_->DispatchEvent(&event);
+    return;
+  }
+
+  // Alt+F11 is fullscreen on a screen of our own: the browser gets plain
+  // F11, and its fullscreen request then opens the screen. Already
+  // fullscreen on Workbench, it moves the window to its own screen.
+  if (!released && (raw_code == RAWKEY_F11 || raw_code == RAWKEY_HELP) &&
+      (qualifier & (IEQUALIFIER_LALT | IEQUALIFIER_RALT))) {
+    ArosWindow* const top = FocusOwner();
+    if (top->window_state_ != PlatformWindowState::kFullScreen) {
+      top->own_screen_requested_ = true;
+    } else if (top->native_mode_ == NativeMode::kFullscreen) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&ArosWindow::SwitchNativeMode,
+                                    top->weak_factory_.GetWeakPtr(),
+                                    NativeMode::kOwnScreen));
+      return;
+    }
+    qualifier &= ~(IEQUALIFIER_LALT | IEQUALIFIER_RALT);
+  }
+
+  const DomCode dom_code = DomCodeFromRawKey(raw_code);
+  if (dom_code == DomCode::NONE) {
+    VLOG(1) << "[Chromium:Ozone:AROS] unmapped raw key=" << raw_code;
+    return;
+  }
+
+  int flags = ModifierFlagsFromQualifier(qualifier) |
+              MouseFlagsFromQualifier(qualifier);
+  if (qualifier & IEQUALIFIER_REPEAT) {
+    flags |= EF_IS_REPEAT;
+  }
+  DomKey dom_key = DomKey::UNIDENTIFIED;
+  KeyboardCode key_code = DomCodeToUsLayoutKeyboardCode(dom_code);
+  KeyboardCode layout_key_code = key_code;
+  if (DomCodeToUsLayoutDomKey(dom_code, flags, &dom_key, &layout_key_code)) {
+    key_code = layout_key_code;
+  }
+
+  KeyEvent event(released ? EventType::kKeyReleased : EventType::kKeyPressed, key_code,
+                 dom_code, flags, dom_key, EventTimeForNow());
+  event.InitializeNative();
+  // Keys arrive at Intuition's active window; a menu or popup that was
+  // activated by a click delivers them where its keyboard focus lives.
+  ArosWindow* const owner = FocusOwner();
+  if (!released) {
+    VLOG(1) << "[Chromium:Ozone:AROS] key raw=0x" << std::hex << raw_code
+            << std::dec << " widget=" << widget_ << " owner=" << owner->widget_;
+  }
+  owner->delegate_->DispatchEvent(&event);
+}
+
+bool ArosWindow::PresentPixels(const void* pixels,
+                               size_t row_bytes,
+                               const gfx::Size& pixel_size,
+                               const gfx::Rect& damage) {
+  if (!window_ || !window_->RPort || !pixels || row_bytes == 0) {
+    VLOG(1) << "[Chromium:Ozone:AROS] present dropped widget=" << widget_
+            << " native=" << window_ << " pixels=" << pixels;
+    return false;
+  }
+
+  const int client_width =
+      window_->Width - window_->BorderLeft - window_->BorderRight;
+  const int client_height =
+      window_->Height - window_->BorderTop - window_->BorderBottom;
+  gfx::Rect clipped = damage;
+  clipped.Intersect(gfx::Rect(pixel_size));
+  clipped.Intersect(gfx::Rect(client_width, client_height));
+  ++presented_frames_;
+  if (presented_frames_ <= 4 || presented_frames_ % 64 == 0) {
+    VLOG(1) << "[Chromium:Ozone:AROS] present #" << presented_frames_
+            << " widget=" << widget_ << " size=" << pixel_size.ToString()
+            << " damage=" << damage.ToString()
+            << " clipped=" << clipped.ToString() << " client=" << client_width
+            << "x" << client_height;
+  }
+  if (clipped.IsEmpty()) {
+    return true;
+  }
+
+  const bool allocated_backing_store =
+      backing_size_ != pixel_size || !backing_rast_port_;
+  if (!EnsureNativeBackingStore(pixel_size)) {
+    ScopedArosLayerLock layer_lock(window_->RPort);
+    SetDrMd(window_->RPort, JAM1);
+    const LONG written = WritePixelArray(
+        const_cast<void*>(pixels), clipped.x(), clipped.y(), row_bytes,
+        window_->RPort, window_->BorderLeft + clipped.x(),
+        window_->BorderTop + clipped.y(), clipped.width(), clipped.height(),
+        RECTFMT_BGRA32);
+    if (written <= 0) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS] direct WritePixelArray failed "
+                    "widget="
+                 << widget_ << " damage=" << clipped.ToString();
+      return false;
+    }
+    return true;
+  }
+
+  // A newly allocated store has no prior frame to preserve. Seed the complete
+  // visible canvas even if Chromium supplied a smaller damage rectangle.
+  if (allocated_backing_store) {
+    clipped = gfx::Rect(pixel_size);
+    clipped.Intersect(gfx::Rect(client_width, client_height));
+  }
+
+  SetDrMd(backing_rast_port_.get(), JAM1);
+  const LONG written = WritePixelArray(
+      const_cast<void*>(pixels), clipped.x(), clipped.y(), row_bytes,
+      backing_rast_port_.get(), clipped.x(), clipped.y(), clipped.width(),
+      clipped.height(), RECTFMT_BGRA32);
+  if (written <= 0) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS] backing WritePixelArray failed widget="
+               << widget_ << " damage=" << clipped.ToString();
+    return false;
+  }
+  return BlitNativeBackingStore(clipped);
+}
+
+bool ArosWindow::EnsureNativeBackingStore(const gfx::Size& size) {
+  if (!window_ || !window_->RPort || size.IsEmpty()) {
+    return false;
+  }
+  if (backing_bitmap_ && backing_rast_port_ && backing_size_ == size) {
+    return true;
+  }
+
+  ReleaseNativeBackingStore();
+  const ULONG depth = GetBitMapAttr(window_->RPort->BitMap, BMA_DEPTH);
+  backing_bitmap_ = AllocBitMap(size.width(), size.height(), depth,
+                                BMF_CLEAR | BMF_DISPLAYABLE | BMF_MINPLANES,
+                                window_->RPort->BitMap);
+  if (!backing_bitmap_) {
+    LOG(WARNING) << "[Chromium:Ozone:AROS] native backing allocation failed "
+                    "widget="
+                 << widget_ << " size=" << size.ToString()
+                 << "; using direct raster presentation";
+    return false;
+  }
+
+  backing_rast_port_ = std::make_unique<RastPort>();
+  InitRastPort(backing_rast_port_.get());
+  backing_rast_port_->BitMap = backing_bitmap_;
+  backing_size_ = size;
+  LOG(INFO) << "[Chromium:Ozone:AROS] allocated screen-friend native backing "
+               "store widget="
+            << widget_ << " size=" << size.ToString() << " depth=" << depth;
+  return true;
+}
+
+void ArosWindow::ReleaseNativeBackingStore() {
+  backing_rast_port_.reset();
+  if (backing_bitmap_) {
+    FreeBitMap(backing_bitmap_);
+    backing_bitmap_ = nullptr;
+  }
+  backing_size_ = gfx::Size();
+}
+
+bool ArosWindow::BlitNativeBackingStore(const gfx::Rect& damage) {
+  if (!window_ || !window_->RPort || !backing_rast_port_ || !backing_bitmap_) {
+    return false;
+  }
+
+  const int client_width =
+      window_->Width - window_->BorderLeft - window_->BorderRight;
+  const int client_height =
+      window_->Height - window_->BorderTop - window_->BorderBottom;
+  gfx::Rect clipped = damage;
+  clipped.Intersect(gfx::Rect(backing_size_));
+  clipped.Intersect(gfx::Rect(client_width, client_height));
+  if (clipped.IsEmpty()) {
+    return true;
+  }
+
+  ScopedArosLayerLock layer_lock(window_->RPort);
+  ClipBlit(backing_rast_port_.get(), clipped.x(), clipped.y(), window_->RPort,
+           window_->BorderLeft + clipped.x(), window_->BorderTop + clipped.y(),
+           clipped.width(), clipped.height(), 0xC0);
+  return true;
+}
+
+void ArosWindow::UpdateBoundsFromNative(bool notify_delegate) {
+  if (!window_) {
+    return;
+  }
+  // Chromium's bounds are the client area in screen coordinates; Intuition
+  // places a window by its outer box.
+  const gfx::Rect new_bounds(
+      window_->LeftEdge + window_->BorderLeft,
+      window_->TopEdge + window_->BorderTop,
+      std::max<int>(
+          1, window_->Width - window_->BorderLeft - window_->BorderRight),
+      std::max<int>(
+          1, window_->Height - window_->BorderTop - window_->BorderBottom));
+  const bool origin_changed = new_bounds.origin() != bounds_.origin();
+  if (new_bounds != bounds_) {
+    bounds_ = new_bounds;
+    if (notify_delegate) {
+      delegate_->OnBoundsChanged({origin_changed});
+    }
+  }
+}
+
+void ArosWindow::UpdateWindowState(PlatformWindowState state) {
+  if (state == window_state_) {
+    return;
+  }
+  const PlatformWindowState old_state = window_state_;
+  window_state_ = state;
+  delegate_->OnWindowStateChanged(old_state, state);
+}
+
+void ArosWindow::DisableNativeEvents() {
+  if (!window_ || !native_events_enabled_) {
+    return;
+  }
+
+  // This is a shared application port. Detach it before clearing IDCMP so
+  // ModifyIDCMP()/CloseWindow() cannot take ownership and delete it.
+  Forbid();
+  window_->UserPort = nullptr;
+  ModifyIDCMP(window_, 0);
+  Permit();
+  native_events_enabled_ = false;
+
+  // Messages queued before the detach still reference this window. Drain and
+  // reply them while the native-window mapping remains valid.
+  manager_->ProcessNativeEvents();
+}
+
+gfx::Rect ArosWindow::PrimaryScreenWorkArea() const {
+  return GetPrimaryArosScreenGeometry().work_area;
+}
+
+}  // namespace ui
