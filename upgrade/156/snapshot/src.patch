+
+LivePumpRegistry& GetLivePumpRegistry() {
+  static NoDestructor<LivePumpRegistry> registry;
+  return *registry;
+}
+
+void RegisterLivePump(MessagePumpAROS* pump) {
+  LivePumpRegistry& registry = GetLivePumpRegistry();
+  AutoLock auto_lock(registry.lock);
+  registry.pumps.push_back(pump);
+  if (!registry.registered_atexit) {
+    std::atexit(&MessagePumpAROS::CleanupLivePumpsAtExit);
+    registry.registered_atexit = true;
+  }
+}
+
+void UnregisterLivePump(MessagePumpAROS* pump) {
+  LivePumpRegistry& registry = GetLivePumpRegistry();
+  AutoLock auto_lock(registry.lock);
+  auto it = std::find(registry.pumps.begin(), registry.pumps.end(), pump);
+  if (it != registry.pumps.end()) {
+    registry.pumps.erase(it);
+  }
+}
+
+fd_owner_t DescriptorOwner(Library* fd_library, int fd) {
+  return fd_library ? __FD_GetOwner_WB(fd_library, fd) : FD_OWNER_NONE;
+}
+
+void* DescriptorData(Library* fd_library, int fd) {
+  return fd_library ? __FD_GetData_WB(fd_library, fd) : nullptr;
+}
+
+bool GetDosHandle(int fd, BPTR* handle) {
+  long native_handle = 0;
+  if (!handle || __get_default_file(fd, &native_handle) != 0) {
+    return false;
+  }
+  *handle = reinterpret_cast<BPTR>(native_handle);
+  return true;
+}
+
+}  // namespace
+
+MessagePumpAROS::FdWatchController::FdWatchController(const Location& from_here)
+    : FdWatchControllerInterface(from_here) {}
+
+MessagePumpAROS::FdWatchController::~FdWatchController() {
+  CHECK(StopWatchingFileDescriptor());
+  if (was_destroyed_) {
+    DCHECK(!*was_destroyed_);
+    *was_destroyed_ = true;
+  }
+}
+
+bool MessagePumpAROS::FdWatchController::StopWatchingFileDescriptor() {
+  watcher_ = nullptr;
+  if (pump_) {
+    pump_->UnregisterController(this);
+  }
+  fd_ = -1;
+  mode_ = 0;
+  persistent_ = false;
+  generation_ = 0;
+  return true;
+}
+
+MessagePumpAROS::MessagePumpAROS() {
+  pump_task_ = FindTask(nullptr);
+  CHECK(pump_task_);
+
+  fd_library_ = OpenLibrary("fd.library", 50);
+  CHECK(fd_library_) << "fd.library v50 is required by Chromium's AROS pump";
+
+  wakeup_signal_ = AllocSignal(-1);
+  CHECK_GE(wakeup_signal_, 0);
+  wakeup_mask_ = uint32_t{1} << wakeup_signal_;
+
+  timer_port_ = CreateMsgPort();
+  CHECK(timer_port_);
+  timer_request_ = reinterpret_cast<timerequest*>(
+      CreateIORequest(timer_port_, sizeof(*timer_request_)));
+  CHECK(timer_request_);
+  CHECK_EQ(OpenDevice(TIMERNAME, UNIT_MICROHZ,
+                      reinterpret_cast<IORequest*>(timer_request_), 0),
+           0);
+
+  VLOG(1) << "[Chromium:IO] AROS WaitSelect/Exec/timer.device pump task="
+          << pump_task_ << " wake-signal=" << wakeup_signal_
+          << " timer-signal=" << static_cast<int>(timer_port_->mp_SigBit);
+  RegisterLivePump(this);
+}
+
+MessagePumpAROS::~MessagePumpAROS() {
+  UnregisterLivePump(this);
+  ReleaseNativeResources();
+}
+
+void MessagePumpAROS::ReleaseNativeResources() {
+  if (native_resources_released_) {
+    return;
+  }
+  native_resources_released_ = true;
+
+  while (!port_controllers_.empty()) {
+    port_controllers_.back()->StopWatching();
+  }
+  while (!controllers_.empty()) {
+    controllers_.back()->StopWatchingFileDescriptor();
+  }
+  if (timer_request_) {
+    IORequest* const request = reinterpret_cast<IORequest*>(timer_request_);
+    if (timer_pending_) {
+      if (!CheckIO(request)) {
+        AbortIO(request);
+      }
+      WaitIO(request);
+    }
+    CloseDevice(request);
+    DeleteIORequest(request);
+    timer_request_ = nullptr;
+    timer_pending_ = false;
+  }
+  if (timer_port_) {
+    DeleteMsgPort(timer_port_);
+    timer_port_ = nullptr;
+  }
+  if (wakeup_signal_ >= 0) {
+    FreeSignal(wakeup_signal_);
+    wakeup_signal_ = -1;
+    wakeup_mask_ = 0;
+  }
+  if (fd_library_) {
+    CloseLibrary(fd_library_);
+    fd_library_ = nullptr;
+  }
+}
+
+void MessagePumpAROS::CleanupLivePumpsAtExit() {
+  std::vector<MessagePumpAROS*> pumps;
+  {
+    LivePumpRegistry& registry = GetLivePumpRegistry();
+    AutoLock auto_lock(registry.lock);
+    pumps = registry.pumps;
+    registry.pumps.clear();
+  }
+
+  for (MessagePumpAROS* pump : pumps) {
+    if (pump) {
+      LOG(ERROR) << "[Chromium:AROS:MessagePump] releasing live pump native "
+                    "resources at process exit";
+      pump->ReleaseNativeResources();
+    }
+  }
+}
+
+bool MessagePumpAROS::WatchFileDescriptor(int fd,
+                                          bool persistent,
+                                          int mode,
+                                          FdWatchController* controller,
+                                          FdWatcher* delegate) {
+  TRACE_EVENT("base", "MessagePumpAROS::WatchFileDescriptor", "fd", fd,
+              "persistent", persistent, "mode", mode);
+  DCHECK_GE(fd, 0);
+  DCHECK(controller);
+  DCHECK(delegate);
+  DCHECK(mode == WATCH_READ || mode == WATCH_WRITE || mode == WATCH_READ_WRITE);
+  DCHECK(watch_file_descriptor_caller_checker_.CalledOnValidThread());
+
+  if (fd < 0 || fd >= FD_SETSIZE || !controller || !delegate ||
+      (mode != WATCH_READ && mode != WATCH_WRITE && mode != WATCH_READ_WRITE)) {
+    if (controller) {
+      controller->StopWatchingFileDescriptor();
+    }
+    LOG(ERROR) << "[Chromium:IO] invalid AROS socket watch fd=" << fd
+               << " mode=" << mode << " FD_SETSIZE=" << FD_SETSIZE;
+    return false;
+  }
+
+  if (controller->pump_ && controller->pump_ != this) {
+    controller->StopWatchingFileDescriptor();
+  }
+
+  if (controller->pump_ == this) {
+    if (controller->fd_ != fd) {
+      controller->StopWatchingFileDescriptor();
+      return false;
+    }
+    controller->mode_ |= mode;
+    controller->persistent_ = controller->persistent_ || persistent;
+    controller->watcher_ = delegate;
+    controller->generation_ = next_generation_++;
+    wait_select_error_reported_ = false;
+    VLOG(2) << "[Chromium:IO] updated watch task=" << pump_task_
+            << " fd=" << fd << " mode=" << controller->mode_
+            << " persistent=" << controller->persistent_;
+    return true;
+  }
+
+  controller->pump_ = this;
+  controller->watcher_ = delegate;
+  controller->fd_ = fd;
+  controller->mode_ = mode;
+  controller->persistent_ = persistent;
+  controller->generation_ = next_generation_++;
+  controllers_.push_back(controller);
+  wait_select_error_reported_ = false;
+  VLOG(2) << "[Chromium:IO] registered watch task=" << pump_task_
+          << " fd=" << fd << " mode=" << mode << " persistent=" << persistent;
+  return true;
+}
+
+MessagePumpAROS::PortWatchController::~PortWatchController() {
+  StopWatching();
+}
+
+void MessagePumpAROS::PortWatchController::StopWatching() {
+  if (pump_) pump_->StopWatchingPort(this);
+}
+
+bool MessagePumpAROS::WatchMessagePort(MsgPort* port,
+                                      PortWatchController* controller,
+                                      RepeatingClosure callback) {
+  CHECK_EQ(FindTask(nullptr), pump_task_);
+  if (native_resources_released_ || !port || !controller || !callback ||
+      port->mp_Flags != PA_SIGNAL || port->mp_SigTask != pump_task_ ||
+      port->mp_SigBit >= 32) return false;
+  controller->StopWatching();
+  const uint32_t mask = uint32_t{1} << port->mp_SigBit;
+  if (mask & (port_mask_ | wakeup_mask_ |
+              (uint32_t{1} << timer_port_->mp_SigBit))) return false;
+  controller->pump_ = this;
+  controller->mask_ = mask;
+  controller->generation_ = next_generation_++;
+  controller->callback_ = std::move(callback);
+  port_controllers_.push_back(controller);
+  port_mask_ |= mask;
+  // Also drain messages queued before the watch was installed.
+  pending_port_signals_ |= mask;
+  ScheduleWork();
+  return true;
+}
+
+void MessagePumpAROS::StopWatchingPort(PortWatchController* controller) {
+  CHECK_EQ(FindTask(nullptr), pump_task_);
+  std::erase(port_controllers_, controller);
+  port_mask_ &= ~controller->mask_;
+  pending_port_signals_ &= ~controller->mask_;
+  controller->pump_ = nullptr;
+  controller->mask_ = 0;
+  controller->callback_.Reset();
+}
+
+bool MessagePumpAROS::DispatchPortSignals() {
+  if (!port_mask_) return false;
+  const uint32_t signals = pending_port_signals_ |
+      (SetSignal(0, port_mask_) & port_mask_);
+  pending_port_signals_ = 0;
+  std::vector<std::pair<PortWatchController*, uint64_t>> ready;
+  for (auto* controller : port_controllers_) {
+    if (signals & controller->mask_)
+      ready.emplace_back(controller, controller->generation_);
+  }
+  for (const auto& [controller, generation] : ready) {
+    // An earlier callback may remove or replace a later watch.
+    if (std::find(port_controllers_.begin(), port_controllers_.end(), controller)
+            == port_controllers_.end() || controller->generation_ != generation)
+      continue;
+    auto callback = controller->callback_;
+    callback.Run();
+  }
+  return !ready.empty();
+}
+
+void MessagePumpAROS::RebindToRunningTask() {
+  // Exec signals are per-TASK: a signal bit is allocated out of the calling
+  // task's own set, Signal() delivers to one named task, and a MsgPort replies
+  // to the task recorded in mp_SigTask. All of that is captured in the
+  // constructor - which is only correct if the thread that CONSTRUCTS the pump
+  // is also the thread that RUNS it. If it ever is not, the pump waits on a bit
+  // belonging to another task while ScheduleWork() signals that other task, and
+  // cross-thread posts stop waking the loop entirely.
+  //
+  // A guard, not a fix for anything observed: every pump measured so far is
+  // constructed on the thread that runs it, the renderer's main thread
+  // included, so this does not normally fire. It says so loudly if it does,
+  // because that failure is otherwise invisible - the loop simply stops
+  // responding to posts.
+  Task* const running_task = FindTask(nullptr);
+  if (running_task == pump_task_) {
+    return;
+  }
+
+  CHECK(port_controllers_.empty());
+  const int32_t wake_signal = AllocSignal(-1);
+  if (wake_signal < 0) {
+    LOG(ERROR) << "[Chromium:IO] pump runs on task=" << running_task
+               << " but was built on task=" << pump_task_
+               << " and no signal is free to rebind the wake-up";
+    return;
+  }
+
+  LOG(ERROR) << "[Chromium:IO] rebinding pump: built on task=" << pump_task_
+             << " runs on task=" << running_task << " wake-signal="
+             << wake_signal;
+
+  // The bits allocated in the constructor belong to the constructing task and
+  // cannot be freed from here; they are left to it. One pump binds once.
+  pump_task_ = running_task;
+  wakeup_signal_ = wake_signal;
+  wakeup_mask_ = uint32_t{1} << wake_signal;
+
+  // The timer port replies to whoever waits on it, so it moves too. Nothing is
+  // in flight yet: Run() has not armed a timer request.
+  if (timer_port_) {
+    const int32_t timer_signal = AllocSignal(-1);
+
+    if (timer_signal >= 0) {
+      timer_port_->mp_SigBit = static_cast<UBYTE>(timer_signal);
+      timer_port_->mp_SigTask = running_task;
+    } else {
+      LOG(ERROR) << "[Chromium:IO] no signal free to rebind the pump's timer "
+                    "port; delayed work will not wake this thread";
+    }
+  }
+}
+
+void MessagePumpAROS::Run(Delegate* delegate) {
+  RebindToRunningTask();
+
+  RunState run_state(delegate);
+  AutoReset<raw_ptr<RunState>> auto_reset_run_state(&run_state_, &run_state);
+
+  for (;;) {
+    const bool processed_ports = DispatchPortSignals();
+    if (run_state.should_quit) break;
+    Delegate::NextWorkInfo next_work_info = delegate->DoWork();
+    const bool immediate_work_available = next_work_info.is_immediate();
+
+    if (run_state.should_quit) {
+      break;
+    }
+
+    const bool processed_io =
+        !controllers_.empty() && WaitForSocketEvents(TimeDelta(), false);
+    const bool processed_port_io = DispatchPortSignals();
+    if (run_state.should_quit) {
+      break;
+    }
+    if (immediate_work_available || processed_io || processed_ports || processed_port_io) {
+      // Spin detector. Every pass through here skips BeforeWait() and the
+      // blocking wait below, so a long unbroken run of them means the pump has
+      // stopped idling - which is what "busy looping / the mouse pointer is
+      // delayed" looks like from the outside. Legitimate bursts happen under
+      // load, hence a high threshold and a one-shot report.
+      if (++consecutive_nonblocking_passes_ == kSpinReportThreshold &&
+          !spin_reported_) {
+        LOG(ERROR) << "[Chromium:IO] pump has not blocked for "
+                   << kSpinReportThreshold << " consecutive passes"
+                   << " immediate_work=" << immediate_work_available
+                   << " processed_io=" << processed_io
+                   << " dos_write_only=" << last_pass_dos_write_only_
+                   << " watches=" << controllers_.size()
+                   << " - if dos_write_only is 1 this is the always-writable"
+                      " DOS descriptor path, not real work";
+        spin_reported_ = true;
+      }
+      continue;
+    }
+    consecutive_nonblocking_passes_ = 0;
+
+    delegate->DoIdleWork();
+    if (run_state.should_quit) {
+      break;
+    }
+
+    delegate->BeforeWait();
+    const bool wait_indefinitely = next_work_info.delayed_run_time.is_max();
+    const TimeDelta delay =
+        wait_indefinitely ? TimeDelta() : next_work_info.remaining_delay();
+    if (controllers_.empty()) {
+      WaitForIdleEvents(delay, wait_indefinitely);
+    } else {
+      WaitForSocketEvents(delay, wait_indefinitely);
+    }
+  }
+}
+
+void MessagePumpAROS::Quit() {
+  DCHECK(run_state_) << "Quit was called outside of Run!";
+  run_state_->should_quit = true;
+  ScheduleWork();
+}
+
+void MessagePumpAROS::ScheduleWork() {
+  Signal(pump_task_, wakeup_mask_);
+}
+
+void MessagePumpAROS::ScheduleDelayedWork(
+    const Delegate::NextWorkInfo& next_work_info) {
+  // A delayed task may be posted while the pump is blocked indefinitely or
+  // waiting for a later timer deadline. Wake it so Run() can recompute the
+  // earliest deadline and arm timer.device accordingly.
+  (void)next_work_info;
+  ScheduleWork();
+}
+
+void MessagePumpAROS::WaitForIdleEvents(TimeDelta timeout,
+                                        bool wait_indefinitely) {
+  if (wait_indefinitely) {
+    pending_port_signals_ |= Wait(wakeup_mask_ | port_mask_) & port_mask_;
+    return;
+  }
+
+  timeout = std::max(timeout, TimeDelta());
+  const int64_t seconds = std::min<int64_t>(timeout.InSeconds(), 100000000);
+  timer_request_->tr_node.io_Command = TR_ADDREQUEST;
+  timer_request_->tr_node.io_Flags = 0;
+  timer_request_->tr_time.tv_secs = seconds;
+  timer_request_->tr_time.tv_micro =
+      (timeout - Seconds(seconds)).InMicroseconds() %
+      Time::kMicrosecondsPerSecond;
+
+  IORequest* const request = reinterpret_cast<IORequest*>(timer_request_);
+  timer_pending_ = true;
+  SendIO(request);
+
+  const uint32_t timer_mask = uint32_t{1} << timer_port_->mp_SigBit;
+  const uint32_t signals = Wait(wakeup_mask_ | timer_mask | port_mask_);
+  pending_port_signals_ |= signals & port_mask_;
+  if (!(signals & timer_mask) && !CheckIO(request)) {
+    AbortIO(request);
+  }
+  WaitIO(request);
+  SetSignal(0, timer_mask);
+  timer_pending_ = false;
+}
+
+bool MessagePumpAROS::WaitForSocketEvents(TimeDelta timeout,
+                                          bool wait_indefinitely) {
+  fd_set read_fds;
+  fd_set write_fds;
+  FD_ZERO(&read_fds);
+  FD_ZERO(&write_fds);
+
+  bool watch_socket_read = false;
+  bool watch_socket_write = false;
+  bool watch_dos_descriptor = false;
+  // Set when the only readiness this pass came from the synthesised
+  // always-writable DOS path above, rather than from an observed event.
+  bool dos_write_ready = false;
+  bool observed_event = false;
+  int max_socket_fd = -1;
+  for (const auto& controller : controllers_) {
+    DCHECK(controller->pump_ == this);
+    DCHECK_GE(controller->fd_, 0);
+    if (DescriptorOwner(fd_library_, controller->fd_) ==
+        FD_OWNER_BSDSOCKET) {
+      if (controller->mode_ & WATCH_READ) {
+        FD_SET(controller->fd_, &read_fds);
+        watch_socket_read = true;
+      }
+      if (controller->mode_ & WATCH_WRITE) {
+        FD_SET(controller->fd_, &write_fds);
+        watch_socket_write = true;
+      }
+      max_socket_fd = std::max(max_socket_fd, controller->fd_);
+    } else {
+      watch_dos_descriptor = true;
+    }
+  }
+
+  // DOS handlers expose per-handle read readiness through WaitForChar(), but
+  // there is no native wait-many primitive spanning DOS handles and AROSTCP
+  // sockets.  Poll only while a DOS-backed descriptor is registered; socket-
+  // only pumps retain AROSTCP's blocking WaitSelect path.
+  if (watch_dos_descriptor &&
+      (wait_indefinitely || timeout > kDosDescriptorPollInterval)) {
+    timeout = kDosDescriptorPollInterval;
+    wait_indefinitely = false;
+  }
+
+  struct timeval timeout_value = {};
+  struct timeval* timeout_pointer = nullptr;
+  if (!wait_indefinitely) {
+    timeout = std::max(timeout, TimeDelta());
+    const int64_t seconds = std::min<int64_t>(timeout.InSeconds(), 100000000);
+    timeout_value.tv_sec = static_cast<time_t>(seconds);
+    timeout_value.tv_usec = (timeout - Seconds(seconds)).InMicroseconds() %
+                            Time::kMicrosecondsPerSecond;
+    timeout_pointer = &timeout_value;
+  }
+
+  uint32_t signal_mask = wakeup_mask_ | port_mask_;
+  int result = 0;
+  if (max_socket_fd >= 0) {
+    result = aros::SocketWaitSelect(
+        max_socket_fd + 1, watch_socket_read ? &read_fds : nullptr,
+        watch_socket_write ? &write_fds : nullptr, nullptr, timeout_pointer,
+        &signal_mask);
+    pending_port_signals_ |= signal_mask & port_mask_;
+  } else {
+    WaitForIdleEvents(timeout, wait_indefinitely);
+  }
+  if (result < 0) {
+    if (errno != EINTR && !wait_select_error_reported_) {
+      LOG(ERROR) << "[Chromium:IO] WaitSelect failed task=" << pump_task_
+                 << " errno=" << errno << " nfds=" << max_socket_fd + 1
+                 << " watches=" << controllers_.size();
+      for (const auto& controller : controllers_) {
+        LOG(ERROR) << "[Chromium:IO] rejected watch fd=" << controller->fd_
+                   << " mode=" << controller->mode_
+                   << " persistent=" << controller->persistent_
+                   << " owner="
+                   << static_cast<unsigned>(
+                          DescriptorOwner(fd_library_, controller->fd_))
+                   << " data="
+                   << DescriptorData(fd_library_, controller->fd_);
+      }
+      wait_select_error_reported_ = true;
+    }
+    WaitForIdleEvents(Milliseconds(10), false);
+    return false;
+  }
+  wait_select_error_reported_ = false;
+  std::vector<ReadyRegistration> ready;
+  ready.reserve(controllers_.size());
+  for (const auto& controller : controllers_) {
+    int ready_mode = 0;
+    const fd_owner_t owner = DescriptorOwner(fd_library_, controller->fd_);
+    if (owner == FD_OWNER_BSDSOCKET) {
+      if ((controller->mode_ & WATCH_READ) &&
+          FD_ISSET(controller->fd_, &read_fds)) {
+        ready_mode |= WATCH_READ;
+      }
+      if ((controller->mode_ & WATCH_WRITE) &&
+          FD_ISSET(controller->fd_, &write_fds)) {
+        ready_mode |= WATCH_WRITE;
+      }
+      // Socket readiness comes from WaitSelect, i.e. it was observed.
+      if (ready_mode) {
+        observed_event = true;
+      }
+    } else {
+      BPTR handle = BNULL;
+      if (GetDosHandle(controller->fd_, &handle)) {
+        if ((controller->mode_ & WATCH_READ) && WaitForChar(handle, 0)) {
+          ready_mode |= WATCH_READ;
+          // WaitForChar actually asked the handler: observed, not synthesised.
+          observed_event = true;
+        }
+        // DOS writes are synchronous.  This mirrors uv1.library's AROS event
+        // backend: dispatch writable and let the owner perform or retire the
+        // operation instead of feeding a non-socket fd to WaitSelect.
+        if (controller->mode_ & WATCH_WRITE) {
+          ready_mode |= WATCH_WRITE;
+          // Synthesised, not observed: this descriptor is "ready" on every
+          // pass for as long as it stays registered, which is what can stop
+          // Run() ever blocking.  Name it once so a looping machine reports
+          // which descriptor is responsible.
+          dos_write_ready = true;
+          if (!dos_write_watch_reported_) {
+            LOG(ERROR) << "[Chromium:IO] DOS-backed fd watched for WRITE is "
+                          "always-ready: fd=" << controller->fd_
+                       << " mode=" << controller->mode_
+                       << " persistent=" << controller->persistent_
+                       << " watches=" << controllers_.size()
+                       << " - if the pump is spinning, this is why";
+            dos_write_watch_reported_ = true;
+          }
+        }
+      }
+    }
+    if (ready_mode) {
+      ready.push_back({controller.get(), controller->generation_, ready_mode});
+    }
+  }
+
+  bool processed_io = false;
+  for (const ReadyRegistration& registration : ready) {
+    const auto current = std::find(controllers_.begin(), controllers_.end(),
+                                   registration.controller);
+    if (current == controllers_.end() ||
+        registration.controller->generation_ != registration.generation) {
+      continue;
+    }
+    processed_io = true;
+    DispatchController(registration);
+  }
+  // True when this pass reported work purely because a DOS descriptor is
+  // permanently writable - the shape that can keep Run() from ever blocking.
+  last_pass_dos_write_only_ = processed_io && dos_write_ready && !observed_event;
+  return processed_io;
+}
+
+void MessagePumpAROS::DispatchController(const ReadyRegistration& ready) {
+  FdWatchController* const controller = ready.controller;
+  const int fd = controller->fd_;
+  const bool persistent = controller->persistent_;
+
+  bool controller_was_destroyed = false;
+  DCHECK(!controller->was_destroyed_);
+  controller->was_destroyed_ = &controller_was_destroyed;
+
+  if (!persistent) {
+    const auto current =
+        std::find(controllers_.begin(), controllers_.end(), controller);
+    DCHECK(current != controllers_.end());
+    controllers_.erase(current);
+    controller->pump_ = nullptr;
+    controller->fd_ = -1;
+    controller->mode_ = 0;
+    controller->persistent_ = false;
+    controller->generation_ = 0;
+  }
+
+  Delegate::ScopedDoWorkItem scoped_do_work_item;
+  if (run_state_) {
+    scoped_do_work_item = run_state_->delegate->BeginWorkItem();
+  }
+  TRACE_EVENT("toplevel", "MessagePumpAROS::OnSocketReady", "fd", fd, "mode",
+              ready.ready_mode, "controller",
+              reinterpret_cast<uintptr_t>(controller));
+
+  if ((ready.ready_mode & WATCH_WRITE) && controller->watcher_) {
+    controller->watcher_->OnFileCanWriteWithoutBlocking(fd);
+  }
+  if (!controller_was_destroyed && (ready.ready_mode & WATCH_READ) &&
+      controller->watcher_) {
+    controller->watcher_->OnFileCanReadWithoutBlocking(fd);
+  }
+
+  if (!controller_was_destroyed) {
+    controller->was_destroyed_ = nullptr;
+    if (!persistent && !controller->pump_) {
+      controller->watcher_ = nullptr;
+    }
+  }
+}
+
+void MessagePumpAROS::UnregisterController(FdWatchController* controller) {
+  DCHECK(watch_file_descriptor_caller_checker_.CalledOnValidThread());
+  const auto current =
+      std::find(controllers_.begin(), controllers_.end(), controller);
+  if (current != controllers_.end()) {
+    controllers_.erase(current);
+  }
+  controller->pump_ = nullptr;
+}
