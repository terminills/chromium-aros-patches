diff --git a/components/os_crypt/async/browser/aros_key_provider.cc b/components/os_crypt/async/browser/aros_key_provider.cc
new file mode 100644
index 0000000000000000000000000000000000000000..50c534ba5eabf838e061424ba349950e3c8b4376
--- /dev/null
+++ b/components/os_crypt/async/browser/aros_key_provider.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "components/os_crypt/async/browser/aros_key_provider.h"
+#include <array>
+#include <cstring>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/rand_util.h"
+#include "base/uuid.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/synchronization/lock.h"
+#include "base/task/thread_pool.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "crypto/hash.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+#include <proto/exec.h>
+#define __CREDENTIALS_NOLIBBASE__
+#define __CREDENTIALS_LIBBASE credentials_base
+#include <proto/credentials.h>
+#include <libraries/credentials.h>
+
+namespace os_crypt_async {
+namespace {
+constexpr char kTag[] = "a01";
+constexpr char kNamespacePref[] = "os_crypt.aros_key_namespace";
+using KeyResult = base::expected<Encryptor::Key, KeyProvider::KeyError>;
+struct NativeKeyring {
+  Library* credentials_base = OpenLibrary("credentials.library", 1);
+  APTR keyring = credentials_base ? CredOpenKeyring("login", CRKF_CREATE) : nullptr;
+  ~NativeKeyring() {
+    if (keyring) CredCloseKeyring(keyring);
+    if (credentials_base) CloseLibrary(credentials_base);
+  }
+};
+KeyResult LoadKey(const std::string& application_namespace) {
+  const auto unavailable = base::unexpected(KeyProvider::KeyError::kTemporarilyUnavailable);
+  if (application_namespace.empty()) return unavailable;
+  // One resident engine serves all application contexts. Serialize first-use
+  // lookup/create across those contexts; never cache an application's key here.
+  static base::NoDestructor<base::Lock> creation_lock;
+  base::AutoLock lock(*creation_lock);
+  NativeKeyring native;
+  if (!native.keyring) return unavailable;
+  Library* credentials_base = native.credentials_base;
+  const std::string account = base::HexEncode(crypto::hash::Sha256(application_namespace));
+  APTR stored = nullptr;
+  ULONG size = 0;
+  LONG rc = CredKeyringLookup(native.keyring, "Chromium.OSCrypt", account.c_str(), &stored, &size);
+  std::array<uint8_t, 32> bytes{};
+  if (rc == CRED_OK) {
+    if (size != bytes.size()) {
+      CredKeyringFree(stored, size);
+      return unavailable;
+    }
+    memcpy(bytes.data(), stored, bytes.size());
+    CredKeyringFree(stored, size);
+  } else if (rc == CRED_ERR_NOTFOUND) {
+    base::RandBytes(bytes);
+    rc = CredKeyringStore(native.keyring, "Chromium.OSCrypt", account.c_str(),
+                         bytes.data(), bytes.size(), "Chromium encryption key");
+    if (rc != CRED_OK) {
+      OPENSSL_cleanse(bytes.data(), bytes.size());
+      return unavailable;
+    }
+  } else {
+    // Locked, unreadable or corrupt storage must never create a replacement.
+    return unavailable;
+  }
+  Encryptor::Key key(bytes, mojom::Algorithm::kAES256GCM);
+  OPENSSL_cleanse(bytes.data(), bytes.size());
+  return key;
+}
+void PostKeyTask(std::string application_namespace, KeyProvider::KeyCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LoadKey, std::move(application_namespace)),
+      base::BindOnce([](KeyProvider::KeyCallback callback, KeyResult result) {
+        std::move(callback).Run(kTag, std::move(result));
+      }, std::move(callback)));
+}
+}  // namespace
+ArosKeyProvider::ArosKeyProvider(PrefService* local_state)
+    : local_state_(local_state) {}
+ArosKeyProvider::~ArosKeyProvider() = default;
+void ArosKeyProvider::RegisterLocalPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kNamespacePref, "");
+}
+void ArosKeyProvider::GetKey(KeyCallback callback) {
+  std::string application_namespace = local_state_->GetString(kNamespacePref);
+  if (application_namespace.empty()) {
+    if (local_state_->ReadOnly()) {
+      std::move(callback).Run(kTag, base::unexpected(KeyError::kTemporarilyUnavailable));
+      return;
+    }
+    // Keep the identity with Local State so moving a user-data directory does
+    // not orphan its key. Persist it before creating/encrypting with that key.
+    application_namespace = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    local_state_->SetString(kNamespacePref, application_namespace);
+    local_state_->CommitPendingWrite(base::BindOnce(
+        &PostKeyTask, std::move(application_namespace), std::move(callback)));
+    return;
+  }
+  if (!base::Uuid::ParseLowercase(application_namespace).is_valid()) {
+    std::move(callback).Run(kTag, base::unexpected(KeyError::kTemporarilyUnavailable));
+    return;
+  }
+  PostKeyTask(std::move(application_namespace), std::move(callback));
+}
+bool ArosKeyProvider::UseForEncryption() { return true; }
+}  // namespace os_crypt_async
