@@ -0,0 +1,37 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef BASE_AROS_PROCESS_LOCAL_H_
+#define BASE_AROS_PROCESS_LOCAL_H_
+#include <cstdint>
+#include <map>
+#include <memory>
+#include "base/base_export.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+namespace base::aros {
+// Monotonic identity of the initialized command-line owner. Workers inherit
+// their owner's identity; a native child receives a new identity at Init().
+// Zero represents bootstrap before any logical process has been registered.
+BASE_EXPORT uint64_t CurrentProcessIdentity();
+
+// Resident-image replacement for process-local static storage. Tag separates
+// distinct globals with the same value type. Entries intentionally have engine
+// lifetime, matching NoDestructor globals; do not put reclaimable application
+// resources here. LazyInstance values retain their normal AtExit destruction.
+// Monotonic IDs prevent a recycled Task/CommandLine address reusing old state.
+template <typename T, typename Tag>
+T& ProcessLocalValue() {
+  struct Registry {
+    Lock lock;
+    std::map<uint64_t, std::unique_ptr<T>> values;
+  };
+  const uint64_t identity = CurrentProcessIdentity();
+  static NoDestructor<Registry> registry;
+  AutoLock lock(registry->lock);
+  auto& value = registry->values[identity];
+  if (!value) value = std::make_unique<T>();
+  return *value;
+}
+}  // namespace base::aros
+#endif
