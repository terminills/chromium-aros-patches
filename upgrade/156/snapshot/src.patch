+++ b/build/config/aros/blink_library/blink_library.gni
@@ -0,0 +1,30 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # Generate only Chromium's existing blink_platform component boundary for
+  # extraction into an AROS native library. Keep this independent of browser
+  # and test aggregates so the library surface can be measured before any
+  # consumer linkage changes.
+  aros_blink_platform_library_only = false
+
+  # Replace Blink's top-level Platform component implementation with generated
+  # calls into the proven native blink_platform.library. This is intentionally
+  # independent of extraction mode so a focused Core consumer can measure the
+  # remaining constituent and data-object boundary.
+  aros_blink_platform_use_library = false
+
+  # Generate a complete Blink Core archive from the focused AROS graph.
+  aros_blink_core_library_only = false
+
+  # Keep Platform inside the resident Core archive. Blink Core directly refers
+  # to hundreds of Platform/WTF data objects, so this is the ABI-safe mode for
+  # native extraction until those ownership boundaries are refactored.
+  aros_blink_core_embed_platform = false
+
+  # Generate a complete Blink Modules archive for boundary analysis and native
+  # extraction. The first archive deliberately retains its Core closure so the
+  # exact callable and data crossings can be measured before replacement.
+  aros_blink_modules_library_only = false
+}
diff --git a/build/config/aros/blink_platform_library/BUILD.gn b/build/config/aros/blink_platform_library/BUILD.gn
new file mode 100644
