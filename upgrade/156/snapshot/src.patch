diff --git a/build/config/aros/v8_library/BUILD.gn b/build/config/aros/v8_library/BUILD.gn
new file mode 100644
index 0000000000000000000000000000000000000000..bc9f36b7602a9771fe1b5d3e72643610ab0d0639
--- /dev/null
+++ b/build/config/aros/v8_library/BUILD.gn
@@ -0,0 +1,56 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+assert(is_aros)
+
+_generated_imports = "$target_gen_dir/v8_library_imports.S"
+
+action("generate_v8_library_imports") {
+  script = "generate_v8_imports.py"
+
+  inputs = [ "v8_function_imports.txt" ]
+  outputs = [ _generated_imports ]
+
+  args = [
+    "--cpu",
+    current_cpu,
+    "--manifest",
+    rebase_path(inputs[0], root_build_dir),
+    "--output",
+    rebase_path(outputs[0], root_build_dir),
+  ]
+}
+
+# Chromium-facing C++ ABI bridge. Each generated function starts as a jump
+# through a writable slot. The first call preserves the complete SysV argument
+# register set, resolves the exact mangled symbol from v8.library, caches it,
+# and tail-calls the engine implementation. Subsequent calls are one indirect
+# jump.
+source_set("v8_library_imports") {
+  sources = [
+    "v8_import_resolver.cc",
+    _generated_imports,
+  ]
+
+  deps = [
+    ":generate_v8_library_imports",
+    "//v8:v8_headers",
+  ]
+
+  libs = [
+    "debug",
+    "v8",
+  ]
+}
+
+# Consumer-side runtime gate for replacing Chromium's monolithic V8 linkage.
+# It depends on the same generated import target used by the browser and cannot
+# silently fall back to V8 implementation objects in the executable.
+executable("v8_library_consumer_probe") {
+  sources = [ "v8_library_consumer_probe.cc" ]
+  deps = [
+    ":v8_library_imports",
+    "//v8:v8_headers",
+  ]
+}
