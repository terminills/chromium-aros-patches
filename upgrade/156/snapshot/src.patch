+}
+
+KRN_MapAttr GetAccessFlags(PageAccessibilityConfiguration accessibility) {
+  switch (accessibility.permissions) {
+    case PageAccessibilityConfiguration::kRead:
+      return MAP_Readable;
+    case PageAccessibilityConfiguration::kReadWriteTagged:
+    case PageAccessibilityConfiguration::kReadWrite:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable);
+    case PageAccessibilityConfiguration::kReadExecuteProtected:
+    case PageAccessibilityConfiguration::kReadExecute:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Executable);
+    case PageAccessibilityConfiguration::kReadWriteExecuteProtected:
+    case PageAccessibilityConfiguration::kReadWriteExecute:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable |
+                                      MAP_Executable);
+    case PageAccessibilityConfiguration::kInaccessible:
+    case PageAccessibilityConfiguration::kInaccessibleWillJitLater:
+      return static_cast<KRN_MapAttr>(0);
+  }
+  return static_cast<KRN_MapAttr>(0);
+}
+
+void SetProtection(APTR KernelBase,
+                   uintptr_t address,
+                   size_t length,
+                   KRN_MapAttr flags) {
+  constexpr size_t kMaxChunk =
+      static_cast<size_t>(std::numeric_limits<uint32_t>::max()) & ~size_t{4095};
+
+  while (length) {
+    const size_t chunk = std::min(length, kMaxChunk);
+    // Native pc-x86_64 Exec RAM is identity mapped. Its legacy protection
+    // entry point has a fixed 32-table split pool; the mapping API allocates
+    // tables on demand and performs the cross-CPU TLB shootdown. Keep this
+    // workaround inside Chromium and preserve other kernels' backends.
+    const char* architecture = reinterpret_cast<const char*>(
+        KrnGetSystemAttr(KATTR_Architecture));
+    if (architecture && architecture != reinterpret_cast<const char*>(-1) &&
+        std::strcmp(architecture, "pc-x86_64") == 0) {
+      void* page = reinterpret_cast<void*>(address);
+      PA_CHECK(KrnVirtualToPhysical(page) == page);
+      PA_CHECK(KrnMapGlobal(page, page, static_cast<uint32_t>(chunk), flags));
+    } else {
+      KrnSetProtection(reinterpret_cast<void*>(address),
+                       static_cast<uint32_t>(chunk), flags);
+    }
+    address += chunk;
+    length -= chunk;
+  }
+}
+
+struct PageAllocationRecord {
+  PageAllocationRecord* next;
+  uintptr_t exposed_base;
+  size_t exposed_length;
+  uintptr_t protected_base;
+  size_t protected_length;
+  void* allocation_base;
+  size_t allocation_length;
+  bool exec_owned;
+};
+
+enum class PageAllocationReleaseKind {
+  kInvalid,
+  kRetainedSuffix,
+  kWhole,
+};
+
+struct PageAllocationRelease {
+  PageAllocationReleaseKind kind = PageAllocationReleaseKind::kInvalid;
+  PageAllocationRecord* record = nullptr;
+  uintptr_t exposed_base = 0;
+  size_t exposed_length = 0;
+};
+
+// A blocking mutex, not a spin: AROS schedules strictly by task priority and
+// the hosted build has one CPU, so a higher-priority thread spinning on a
+// flag that a preempted lower-priority thread still holds never lets the
+// holder run again (the whole guest sat at 100% in such a loop).  The
+// pthread mutex sleeps on an exec semaphore instead - the same primitive
+// PartitionAlloc's own SpinningMutex uses on this platform.
+pthread_mutex_t s_pageAllocationLock = PTHREAD_MUTEX_INITIALIZER;
+PageAllocationRecord* s_pageAllocations = nullptr;
+
+void LockPageAllocations() {
+  pthread_mutex_lock(&s_pageAllocationLock);
+}
+
+void UnlockPageAllocations() {
+  pthread_mutex_unlock(&s_pageAllocationLock);
+}
+
+bool TrackPageAllocation(uintptr_t exposed_base,
+                         size_t exposed_length,
+                         uintptr_t protected_base,
+                         size_t protected_length,
+                         void* allocation_base,
+                         size_t allocation_length,
+                         bool exec_owned) {
+  auto* record = static_cast<PageAllocationRecord*>(
+      AllocMem(sizeof(PageAllocationRecord), MEMF_PUBLIC | MEMF_CLEAR));
+  if (!record) {
+    return false;
+  }
+
+  record->exposed_base = exposed_base;
+  record->exposed_length = exposed_length;
+  record->protected_base = protected_base;
+  record->protected_length = protected_length;
+  record->allocation_base = allocation_base;
+  record->allocation_length = allocation_length;
+  record->exec_owned = exec_owned;
+
+  LockPageAllocations();
+  record->next = s_pageAllocations;
+  s_pageAllocations = record;
+  UnlockPageAllocations();
+  return true;
+}
+
+PageAllocationRelease PreparePageAllocationRelease(uintptr_t address,
+                                                    size_t length) {
+  PageAllocationRelease release;
+  PageAllocationRecord* record;
+  PageAllocationRecord* previous = nullptr;
+
+  LockPageAllocations();
+  for (record = s_pageAllocations; record; record = record->next) {
+    if (address == record->exposed_base &&
+        length == record->exposed_length) {
+      if (previous) {
+        previous->next = record->next;
+      } else {
+        s_pageAllocations = record->next;
+      }
+      release.kind = PageAllocationReleaseKind::kWhole;
+      release.record = record;
+      break;
+    }
+
+    if (address > record->exposed_base) {
+      const size_t offset = address - record->exposed_base;
+      if (offset < record->exposed_length &&
+          length == record->exposed_length - offset) {
+        record->exposed_length = offset;
+        release.kind = PageAllocationReleaseKind::kRetainedSuffix;
+        release.exposed_base = record->exposed_base;
+        release.exposed_length = record->exposed_length;
+        break;
+      }
+
+      if (offset < record->exposed_length) {
+        break;
+      }
+    }
+
+    if (address == record->exposed_base) {
+      break;
+    }
+    previous = record;
+  }
+  UnlockPageAllocations();
+  return release;
+}
+
+void LogTrimmedExecSlack(uintptr_t result,
+                         size_t trim_length,
+                         size_t released,
+                         void* allocation_base,
+                         size_t allocation_length) {
+  char line[224];
+  std::snprintf(
+      line, sizeof(line),
+      "[Chromium:PA] trim-exec address=%p len=%llu released=%llu "
+      "allocation=%p+%llu\n",
+      reinterpret_cast<void*>(result),
+      static_cast<unsigned long long>(trim_length),
+      static_cast<unsigned long long>(released), allocation_base,
+      static_cast<unsigned long long>(allocation_length));
+  ArosKPutStr(line);
+}
+
+// Exec memory is physically backed, and an aligned pool reservation
+// over-allocates by its alignment (the 2 GiB regular pool asks for 4 GiB and
+// trims to 2 GiB), so the slack is dead weight. It used to be given back the
+// way exec's own LibAllocAligned() does it -- Forbid(); FreeMem(whole);
+// AllocAbs(kept) -- but that idiom cannot be used here:
+//
+//   * Forbid() does not stop the other CPUs on an SMP kernel, so the whole
+//     block is briefly free to every other task.
+//   * It drives exec into tlsf_allocabs(), whose split paths are the least
+//     exercised in the allocator. On the native pc-x86_64-smp guest the
+//     released tail came straight back as a corrupted free-list link: the
+//     5 GiB free block that starts at the released address carried
+//     free_node.next = 0x20, and the next AllocAbs() faulted walking it
+//     (CR2=0x28, rip=tlsf_allocabs+0x99, alert 0x80000003). Because the
+//     fault is raised while the caller holds the MemHeader spinlock, the
+//     alert path deadlocks against itself and the machine freezes with no
+//     output (TRIG-1005/1006).
+//
+// So the slack now stays with the block: the reservation keeps the memory it
+// was given, and the record only remembers which window is exposed. This
+// costs the alignment slack in RSS (2 GiB for the regular pool) until exec
+// grows a real aligned allocator that does not go through AllocAbs.
+void ReleaseTrimmedExecSlack(PageAllocationRecord* record,
+                             uintptr_t result,
+                             size_t trim_length,
+                             PageAccessibilityConfiguration accessibility) {
+  const uintptr_t alloc_base =
+      reinterpret_cast<uintptr_t>(record->allocation_base);
+  const uintptr_t alloc_end = alloc_base + record->allocation_length;
+  if (result == alloc_base && result + trim_length == alloc_end) {
+    return;
+  }
+
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+
+  record->protected_base = result;
+  record->protected_length = trim_length;
+
+  SetProtection(KernelBase, result, trim_length,
+                GetAccessFlags(accessibility));
+  LogTrimmedExecSlack(result, trim_length, 0, record->allocation_base,
+                      record->allocation_length);
+}
+
+bool RetainTrimmedPageAllocation(uintptr_t base_address,
+                                 size_t base_length,
+                                 uintptr_t result,
+                                 size_t trim_length,
+                                 PageAccessibilityConfiguration accessibility) {
+  PageAllocationRecord* found = nullptr;
+
+  LockPageAllocations();
+  for (PageAllocationRecord* record = s_pageAllocations; record;
+       record = record->next) {
+    if (record->exposed_base == base_address &&
+        record->exposed_length == base_length) {
+      record->exposed_base = result;
+      record->exposed_length = trim_length;
+      found = record;
+      break;
+    }
+  }
+  UnlockPageAllocations();
+
+  // The record belongs to the caller's reservation alone, so its backing can
+  // be reshaped outside the list lock.
+  if (found && found->exec_owned) {
+    ReleaseTrimmedExecSlack(found, result, trim_length, accessibility);
+  }
+  return found != nullptr;
+}
+
+void* AllocateExecPages(size_t length,
+                        ULONG flags,
+                        size_t* allocation_length) {
+  const size_t granularity = PageAllocationGranularity();
+  if (length > std::numeric_limits<size_t>::max() - granularity) {
+    return nullptr;
+  }
+
+  *allocation_length = length + granularity;
+  return AllocMem(*allocation_length, flags);
+}
+
+void LogLargePageAllocation(uintptr_t hint,
+                            size_t length,
+                            KRN_MapAttr protection,
+                            IPTR available,
