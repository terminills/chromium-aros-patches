+
+extern "C" {
+// posixc 0.41: pass an open file to another process (SCM_RIGHTS on AROS).
+// Weak until every AROS SDK the Chromium build uses carries these stubs: an
+// executable linked without them keeps the old numeric encoding.
+__attribute__((weak)) void* __posixc_fd_export(int file_descriptor);
+__attribute__((weak)) int __posixc_fd_import(void* token, int fdflags);
+__attribute__((weak)) void __posixc_fd_release(void* token);
+}
+
+namespace mojo {
+
+struct ArosChannelState {
+  static constexpr uint64_t kMagic = 0x41524f534d4f4a4fULL;
+
+  uint64_t magic = kMagic;
+  std::atomic_size_t references{2};
+  std::atomic_size_t side_references[2] = {1, 1};
+  SignalSemaphore lock;
+  MsgPort* ports[2] = {};
+  bool reader_active[2] = {};
+  ArosChannelPacket* pending_head[2] = {};
+  ArosChannelPacket* pending_tail[2] = {};
+};
+
+struct ArosChannelPacket {
+  ::Message message;
+  ArosChannelPacket* pending_next = nullptr;
+  ArosChannelPacketType type = ArosChannelPacketType::kData;
+  size_t allocation_size = 0;
+  size_t data_size = 0;
+  size_t handle_count = 0;
+};
+
+namespace {
+
+ArosChannelState* StateFor(ArosChannelHandle handle) {
+  return static_cast<ArosChannelState*>(handle.state);
+}
+
+bool IsValid(ArosChannelHandle handle) {
+  ArosChannelState* state = StateFor(handle);
+  return state && handle.side < 2 &&
+         state->magic == ArosChannelState::kMagic;
+}
+
+void Lock(ArosChannelState* state) {
+  ObtainSemaphore(&state->lock);
+}
+
+void Unlock(ArosChannelState* state) {
+  ReleaseSemaphore(&state->lock);
+}
+
+void ReleaseStateReference(ArosChannelState* state) {
+  const size_t previous =
+      state->references.fetch_sub(1, std::memory_order_acq_rel);
+  CHECK_GT(previous, 0u);
+  if (previous != 1)
+    return;
+  for (size_t side = 0; side < 2; ++side) {
+    ArosChannelPacket* packet = state->pending_head[side];
+    while (packet) {
+      ArosChannelPacket* next = packet->pending_next;
+      DestroyArosChannelPacket(packet);
+      packet = next;
+    }
+  }
+  state->magic = 0;
+  state->~ArosChannelState();
+  FreeMem(state, sizeof(ArosChannelState));
+}
+
+MojoPlatformHandle* PacketHandles(ArosChannelPacket* packet) {
+  return reinterpret_cast<MojoPlatformHandle*>(packet + 1);
+}
+
+void* PacketData(ArosChannelPacket* packet) {
+  return PacketHandles(packet) + packet->handle_count;
+}
+
+ArosChannelPacket* CreatePacket(ArosChannelPacketType type,
+                                const void* data,
+                                size_t data_size,
+                                const MojoPlatformHandle* handles,
+                                size_t handle_count) {
+  if (handle_count >
+      (std::numeric_limits<size_t>::max() - sizeof(ArosChannelPacket)) /
+          sizeof(MojoPlatformHandle)) {
+    return nullptr;
+  }
+  const size_t handle_bytes = handle_count * sizeof(MojoPlatformHandle);
+  if (data_size > std::numeric_limits<size_t>::max() -
+                      sizeof(ArosChannelPacket) - handle_bytes) {
+    return nullptr;
+  }
+  const size_t allocation_size =
+      sizeof(ArosChannelPacket) + handle_bytes + data_size;
+  void* storage = AllocMem(allocation_size, MEMF_PUBLIC | MEMF_CLEAR);
+  if (!storage)
+    return nullptr;
+  auto* packet = new (storage) ArosChannelPacket;
+  packet->message.mn_Length = sizeof(ArosChannelPacket);
+  packet->type = type;
+  packet->allocation_size = allocation_size;
+  packet->data_size = data_size;
+  packet->handle_count = handle_count;
+  if (handle_count)
+    std::memcpy(PacketHandles(packet), handles, handle_bytes);
+  if (data_size)
+    std::memcpy(PacketData(packet), data, data_size);
+  return packet;
+}
+
+bool QueueOrDeliver(ArosChannelState* state,
+                    uint8_t target,
+                    ArosChannelPacket* packet,
+                    bool require_live_target = false) {
+  Lock(state);
+  if (require_live_target &&
+      state->side_references[target].load(std::memory_order_relaxed) == 0) {
+    Unlock(state);
+    DestroyArosChannelPacket(packet);
+    return false;
+  }
+  MsgPort* const port = state->ports[target];
+  if (port) {
+    PutMsg(port, &packet->message);
+  } else {
+    if (state->pending_tail[target])
+      state->pending_tail[target]->pending_next = packet;
+    else
+      state->pending_head[target] = packet;
+    state->pending_tail[target] = packet;
+  }
+  Unlock(state);
+  return true;
+}
+
+void ReleaseEncodedHandles(ArosChannelPacket* packet) {
+  for (size_t i = 0; i < packet->handle_count; ++i)
+    ReleaseArosTransferHandle(&PacketHandles(packet)[i]);
+}
+
+}  // namespace
+
+void EncodeArosTransferHandle(PlatformHandle handle, MojoPlatformHandle* out) {
+  if (handle.is_fd() && __posixc_fd_export) {
+    // Export the open file, then let |handle| close our descriptor: the
+    // token holds its own reference, so the file stays open for the peer.
+    void* token = __posixc_fd_export(handle.GetFD().get());
+    if (token) {
+      out->struct_size = sizeof(*out);
+      out->type = MOJO_PLATFORM_HANDLE_TYPE_AROS_FILE;
+      out->value = reinterpret_cast<uintptr_t>(token);
+      return;
+    }
+    // Not exportable (a directory, or not a posixc file): fall back to the
+    // number, which is at least no worse than before.
+  }
+  PlatformHandle::ToMojoPlatformHandle(std::move(handle), out);
+}
+
+PlatformHandle DecodeArosTransferHandle(const MojoPlatformHandle* in) {
+  if (in->type == MOJO_PLATFORM_HANDLE_TYPE_AROS_FILE) {
+    void* token = reinterpret_cast<void*>(static_cast<uintptr_t>(in->value));
+    const int fd = __posixc_fd_import(token, 0);
+    if (fd < 0) {
+      __posixc_fd_release(token);
+      return PlatformHandle();
+    }
+    return PlatformHandle(base::ScopedFD(fd));
+  }
+  return PlatformHandle::FromMojoPlatformHandle(in);
+}
+
+void ReleaseArosTransferHandle(const MojoPlatformHandle* in) {
+  if (in->type == MOJO_PLATFORM_HANDLE_TYPE_AROS_FILE) {
+    __posixc_fd_release(
+        reinterpret_cast<void*>(static_cast<uintptr_t>(in->value)));
+    return;
+  }
+  PlatformHandle handle = PlatformHandle::FromMojoPlatformHandle(in);
+}
+
+std::pair<ArosChannelHandle, ArosChannelHandle> CreateArosChannelPair() {
+  void* storage = AllocMem(sizeof(ArosChannelState), MEMF_PUBLIC | MEMF_CLEAR);
+  if (!storage)
+    return {};
+  auto* state = new (storage) ArosChannelState;
+  InitSemaphore(&state->lock);
+  return {{state, 0}, {state, 1}};
+}
+
+void RetainArosChannelHandle(ArosChannelHandle handle) {
+  ArosChannelState* state = StateFor(handle);
+  CHECK(IsValid(handle));
+  state->side_references[handle.side].fetch_add(1, std::memory_order_relaxed);
+  state->references.fetch_add(1, std::memory_order_relaxed);
+}
+
+void ReleaseArosChannelHandle(ArosChannelHandle handle) {
+  ArosChannelState* state = StateFor(handle);
+  if (!state)
+    return;
+  CHECK(IsValid(handle));
+  const size_t previous_side =
+      state->side_references[handle.side].fetch_sub(1, std::memory_order_acq_rel);
+  CHECK_GT(previous_side, 0u);
+  if (previous_side == 1) {
+    if (ArosChannelPacket* packet =
+            CreatePacket(ArosChannelPacketType::kPeerClosed, nullptr, 0,
+                         nullptr, 0)) {
+      QueueOrDeliver(state, handle.side ^ 1, packet);
+    }
+  }
+  ReleaseStateReference(state);
+}
+
+ArosChannelRetirementObserver::ArosChannelRetirementObserver() = default;
+
+ArosChannelRetirementObserver::ArosChannelRetirementObserver(void* state,
+                                                             uint8_t side)
+    : state_(state), side_(side) {}
+
+ArosChannelRetirementObserver::ArosChannelRetirementObserver(
+    ArosChannelRetirementObserver&& other)
+    : state_(std::exchange(other.state_, nullptr)),
+      side_(std::exchange(other.side_, 0)) {}
+
+ArosChannelRetirementObserver& ArosChannelRetirementObserver::operator=(
+    ArosChannelRetirementObserver&& other) {
+  if (this == &other)
+    return *this;
+  if (state_)
+    ReleaseStateReference(static_cast<ArosChannelState*>(state_));
+  state_ = std::exchange(other.state_, nullptr);
+  side_ = std::exchange(other.side_, 0);
+  return *this;
+}
+
+ArosChannelRetirementObserver::~ArosChannelRetirementObserver() {
+  if (state_)
+    ReleaseStateReference(static_cast<ArosChannelState*>(state_));
+}
+
+bool ArosChannelRetirementObserver::IsRetired() const {
+  if (!state_)
+    return true;
+  auto* state = static_cast<ArosChannelState*>(state_);
+  Lock(state);
+  const bool retired =
+      state->side_references[side_].load(std::memory_order_relaxed) == 0 &&
+      !state->reader_active[side_] && !state->ports[side_];
+  Unlock(state);
+  return retired;
+}
+
+ArosChannelRetirementObserver CreateArosChannelRetirementObserver(
+    ArosChannelHandle handle) {
+  if (!IsValid(handle))
+    return {};
+  ArosChannelState* state = StateFor(handle);
+  state->references.fetch_add(1, std::memory_order_relaxed);
+  return ArosChannelRetirementObserver(state, handle.side ^ 1);
+}
+
+MsgPort* StartReceivingArosChannel(ArosChannelHandle handle) {
+  if (!IsValid(handle))
+    return nullptr;
+  MsgPort* port = CreateMsgPort();
+  if (!port)
+    return nullptr;
+
+  ArosChannelState* state = StateFor(handle);
+  Lock(state);
+  CHECK(!state->ports[handle.side]);
+  state->ports[handle.side] = port;
+  state->reader_active[handle.side] = true;
+  ArosChannelPacket* packet = state->pending_head[handle.side];
+  state->pending_head[handle.side] = nullptr;
+  state->pending_tail[handle.side] = nullptr;
+  while (packet) {
+    ArosChannelPacket* next = packet->pending_next;
+    packet->pending_next = nullptr;
+    PutMsg(port, &packet->message);
+    packet = next;
+  }
+  Unlock(state);
+  return port;
+}
+
+void StopReceivingArosChannel(ArosChannelHandle handle, MsgPort* port) {
+  if (!port)
+    return;
+  ArosChannelState* state = StateFor(handle);
+  CHECK(IsValid(handle));
+  Lock(state);
+  CHECK_EQ(state->ports[handle.side], port);
+  state->ports[handle.side] = nullptr;
+  state->reader_active[handle.side] = false;
+  Unlock(state);
+
+  while (auto* message = GetMsg(port))
+    DestroyArosChannelPacket(reinterpret_cast<ArosChannelPacket*>(message));
+  DeleteMsgPort(port);
+}
+
+void MarkArosChannelReaderJoined(ArosChannelHandle handle) {
+  if (!IsValid(handle))
+    return;
+  ArosChannelState* state = StateFor(handle);
+  Lock(state);
+  state->reader_active[handle.side] = false;
+  Unlock(state);
+}
+
+ArosChannelPacket* WaitForArosChannelPacket(MsgPort* port) {
+  CHECK(port);
+  WaitPort(port);
+  return reinterpret_cast<ArosChannelPacket*>(GetMsg(port));
+}
+
+ArosChannelPacketView GetArosChannelPacketView(ArosChannelPacket* packet) {
+  CHECK(packet);
+  return {packet->type, PacketData(packet), packet->data_size,
+          PacketHandles(packet), packet->handle_count};
+}
+
+void MarkArosChannelPacketHandlesConsumed(ArosChannelPacket* packet) {
+  CHECK(packet);
+  packet->handle_count = 0;
+}
+
+void DestroyArosChannelPacket(ArosChannelPacket* packet) {
+  if (!packet)
+    return;
+  ReleaseEncodedHandles(packet);
+  const size_t allocation_size = packet->allocation_size;
+  packet->~ArosChannelPacket();
+  FreeMem(packet, allocation_size);
+}
+
+bool SendArosChannelPacket(ArosChannelHandle handle,
+                           ArosChannelPacketType type,
+                           const void* data,
+                           size_t data_size,
+                           const MojoPlatformHandle* handles,
+                           size_t handle_count) {
+  if (!IsValid(handle))
+    return false;
+  ArosChannelState* state = StateFor(handle);
+  ArosChannelPacket* packet =
+      CreatePacket(type, data, data_size, handles, handle_count);
+  if (!packet)
+    return false;
+  const uint8_t target =
+      type == ArosChannelPacketType::kStop ? handle.side : handle.side ^ 1;
+  return QueueOrDeliver(state, target, packet,
+                        type == ArosChannelPacketType::kData);
+}
+
+}  // namespace mojo
diff --git a/mojo/public/cpp/platform/aros_channel.h b/mojo/public/cpp/platform/aros_channel.h
new file mode 100644
index 0000000000000000000000000000000000000000..75fd8502db9594c91b651284d4bfdad7c9a2c2ce
--- /dev/null
+++ b/mojo/public/cpp/platform/aros_channel.h
@@ -0,0 +1,119 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MOJO_PUBLIC_CPP_PLATFORM_AROS_CHANNEL_H_
+#define MOJO_PUBLIC_CPP_PLATFORM_AROS_CHANNEL_H_
+
+#include <cstdint>
+#include <cstddef>
+#include <utility>
+
+#include "base/component_export.h"
+#include "mojo/public/c/system/platform_handle.h"
+
+struct MsgPort;
+
+namespace mojo {
+
+enum class ArosChannelPacketType : uint8_t {
+  kData,
+  kStop,
+  kPeerClosed,
+};
+
+struct ArosChannelPacket;
+
+struct ArosChannelPacketView {
+  ArosChannelPacketType type = ArosChannelPacketType::kData;
+  const void* data = nullptr;
+  size_t data_size = 0;
+  const MojoPlatformHandle* handles = nullptr;
+  size_t handle_count = 0;
+};
+
+struct ArosChannelHandle {
+  void* state = nullptr;
+  uint8_t side = 0;
+
+  bool is_valid() const { return state != nullptr; }
+};
+
+// Keeps the native channel state observable after both endpoint handles have
+// begun teardown.  This does not retain either endpoint side and therefore
+// cannot keep a peer artificially alive.
+class COMPONENT_EXPORT(MOJO_CPP_PLATFORM) ArosChannelRetirementObserver {
+ public:
+  ArosChannelRetirementObserver();
+  ArosChannelRetirementObserver(ArosChannelRetirementObserver&& other);
+  ArosChannelRetirementObserver& operator=(
+      ArosChannelRetirementObserver&& other);
+  ~ArosChannelRetirementObserver();
+
+  ArosChannelRetirementObserver(const ArosChannelRetirementObserver&) = delete;
+  ArosChannelRetirementObserver& operator=(
+      const ArosChannelRetirementObserver&) = delete;
+
+  bool is_valid() const { return state_ != nullptr; }
+  bool IsRetired() const;
+
+ private:
+  explicit ArosChannelRetirementObserver(void* state, uint8_t side);
+
+  void* state_ = nullptr;
+  uint8_t side_ = 0;
+
+  friend ArosChannelRetirementObserver
+  CreateArosChannelRetirementObserver(ArosChannelHandle handle);
+};
+
+// platform_handle.h includes this header, so only declare the class here.
+class PlatformHandle;
+
+// Handles crossing a channel. A file descriptor is only meaningful in the
+// posixc table of the process that owns it, so it travels as an exported
+// open-file token (MOJO_PLATFORM_HANDLE_TYPE_AROS_FILE) and the receiver
+// imports it into its own table. Every other handle type is encoded as
+// PlatformHandle does. Each encoded handle is consumed by exactly one of
+// Decode (delivered) or Release (dropped).
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void EncodeArosTransferHandle(PlatformHandle handle, MojoPlatformHandle* out);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+PlatformHandle DecodeArosTransferHandle(const MojoPlatformHandle* in);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void ReleaseArosTransferHandle(const MojoPlatformHandle* in);
+
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+std::pair<ArosChannelHandle, ArosChannelHandle> CreateArosChannelPair();
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void RetainArosChannelHandle(ArosChannelHandle handle);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void ReleaseArosChannelHandle(ArosChannelHandle handle);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+ArosChannelRetirementObserver CreateArosChannelRetirementObserver(
+    ArosChannelHandle handle);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+MsgPort* StartReceivingArosChannel(ArosChannelHandle handle);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void StopReceivingArosChannel(ArosChannelHandle handle, MsgPort* port);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void MarkArosChannelReaderJoined(ArosChannelHandle handle);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+ArosChannelPacket* WaitForArosChannelPacket(MsgPort* port);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+ArosChannelPacketView GetArosChannelPacketView(ArosChannelPacket* packet);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void MarkArosChannelPacketHandlesConsumed(ArosChannelPacket* packet);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+void DestroyArosChannelPacket(ArosChannelPacket* packet);
+COMPONENT_EXPORT(MOJO_CPP_PLATFORM)
+bool SendArosChannelPacket(ArosChannelHandle handle,
+                           ArosChannelPacketType type,
+                           const void* data,
+                           size_t data_size,
+                           const MojoPlatformHandle* handles,
+                           size_t handle_count);
+
+}  // namespace mojo
+
+#endif  // MOJO_PUBLIC_CPP_PLATFORM_AROS_CHANNEL_H_
diff --git a/mojo/public/cpp/platform/aros_channel_probe.cc b/mojo/public/cpp/platform/aros_channel_probe.cc
new file mode 100644
index 0000000000000000000000000000000000000000..10da0740220f93650e283b15c8928213776c5bf8
--- /dev/null
+++ b/mojo/public/cpp/platform/aros_channel_probe.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <atomic>
+#include <cstring>
+#include <utility>
+
+#include <aros/debug.h>
+
+#include "base/at_exit.h"
+#include "base/threading/platform_thread.h"
+#include "mojo/public/cpp/platform/aros_channel.h"
+#include "mojo/public/cpp/platform/platform_handle.h"
+
+namespace {
+
+constexpr char kEarlyPayload[] = "queued-before-receiver";
+constexpr char kReplyPayload[] = "duplex-reply";
+constexpr char kHandlePayload[] = "transferred-handle";
+
+bool PayloadEquals(const mojo::ArosChannelPacketView& view,
+                   const char* expected,
+                   size_t expected_size) {
+  return view.type == mojo::ArosChannelPacketType::kData &&
+         view.data_size == expected_size &&
+         std::memcmp(view.data, expected, expected_size) == 0;
+}
+
+class Receiver final : public base::PlatformThread::Delegate {
+ public:
+  explicit Receiver(mojo::ArosChannelHandle channel) : channel_(channel) {}
+
+  void ThreadMain() override {
+    MsgPort* port = mojo::StartReceivingArosChannel(channel_);
+    if (!port) {
+      result_.store(10, std::memory_order_release);
+      return;
+    }
+
+    mojo::ArosChannelPacket* packet =
+        mojo::WaitForArosChannelPacket(port);
+    mojo::ArosChannelPacketView view =
+        mojo::GetArosChannelPacketView(packet);
+    if (!PayloadEquals(view, kEarlyPayload, sizeof(kEarlyPayload)) ||
+        view.handle_count != 1) {
+      mojo::DestroyArosChannelPacket(packet);
+      result_.store(11, std::memory_order_release);
+      return;
+    }
+
+    mojo::PlatformHandle transferred =
+        mojo::PlatformHandle::FromMojoPlatformHandle(&view.handles[0]);
+    mojo::MarkArosChannelPacketHandlesConsumed(packet);
+    mojo::DestroyArosChannelPacket(packet);
+    if (!transferred.is_aros_channel()) {
+      result_.store(12, std::memory_order_release);
+      return;
+    }
+
+    mojo::ArosChannelHandle transferred_channel =
+        transferred.TakeArosChannel();
+    if (!mojo::SendArosChannelPacket(
+            transferred_channel, mojo::ArosChannelPacketType::kData,
+            kHandlePayload, sizeof(kHandlePayload), nullptr, 0)) {
+      mojo::ReleaseArosChannelHandle(transferred_channel);
+      result_.store(13, std::memory_order_release);
+      return;
+    }
+    mojo::ReleaseArosChannelHandle(transferred_channel);
+
+    if (!mojo::SendArosChannelPacket(
+            channel_, mojo::ArosChannelPacketType::kData, kReplyPayload,
+            sizeof(kReplyPayload), nullptr, 0)) {
+      result_.store(14, std::memory_order_release);
+      return;
+    }
+
+    packet = mojo::WaitForArosChannelPacket(port);
+    view = mojo::GetArosChannelPacketView(packet);
+    const bool peer_closed =
+        view.type == mojo::ArosChannelPacketType::kPeerClosed;
+    mojo::DestroyArosChannelPacket(packet);
+    mojo::StopReceivingArosChannel(channel_, port);
+    mojo::ReleaseArosChannelHandle(std::exchange(channel_, {}));
+    result_.store(peer_closed ? 0 : 15, std::memory_order_release);
+  }
+
+  int result() const { return result_.load(std::memory_order_acquire); }
+
+ private:
+  mojo::ArosChannelHandle channel_;
+  std::atomic_int result_{99};
+};
+
+}  // namespace
+
+int main() {
+  base::AtExitManager at_exit_manager;
+
+  auto channel = mojo::CreateArosChannelPair();
+  auto transferred = mojo::CreateArosChannelPair();
+  if (!channel.first.is_valid() || !channel.second.is_valid() ||
+      !transferred.first.is_valid() || !transferred.second.is_valid()) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL allocation\n");
+    return 20;
+  }
+
+  MsgPort* local_port = mojo::StartReceivingArosChannel(channel.first);
+  MsgPort* transferred_port =
+      mojo::StartReceivingArosChannel(transferred.second);
+  if (!local_port || !transferred_port) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL receiver setup\n");
+    return 21;
+  }
+
+  mojo::PlatformHandle attached(transferred.first);
+  transferred.first = {};
+  MojoPlatformHandle encoded = {};
+  mojo::PlatformHandle::ToMojoPlatformHandle(std::move(attached), &encoded);
+  if (!mojo::SendArosChannelPacket(
+          channel.first, mojo::ArosChannelPacketType::kData, kEarlyPayload,
+          sizeof(kEarlyPayload), &encoded, 1)) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL early send\n");
+    return 22;
+  }
+
+  Receiver receiver(channel.second);
+  channel.second = {};
+  base::PlatformThreadHandle receiver_thread;
+  if (!base::PlatformThread::Create(0, &receiver, &receiver_thread)) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL thread create\n");
+    return 23;
+  }
+
+  mojo::ArosChannelPacket* packet =
+      mojo::WaitForArosChannelPacket(transferred_port);
+  mojo::ArosChannelPacketView view =
+      mojo::GetArosChannelPacketView(packet);
+  const bool transferred_ok =
+      PayloadEquals(view, kHandlePayload, sizeof(kHandlePayload));
+  mojo::DestroyArosChannelPacket(packet);
+
+  packet = mojo::WaitForArosChannelPacket(local_port);
+  view = mojo::GetArosChannelPacketView(packet);
+  const bool duplex_ok =
+      PayloadEquals(view, kReplyPayload, sizeof(kReplyPayload));
+  mojo::DestroyArosChannelPacket(packet);
+
+  mojo::StopReceivingArosChannel(transferred.second, transferred_port);
+  mojo::ReleaseArosChannelHandle(std::exchange(transferred.second, {}));
+  mojo::StopReceivingArosChannel(channel.first, local_port);
+  mojo::ReleaseArosChannelHandle(std::exchange(channel.first, {}));
+
+  base::PlatformThread::Join(receiver_thread);
+  const int receiver_result = receiver.result();
+  if (!transferred_ok || !duplex_ok || receiver_result != 0) {
+    bug(
+        "[Mojo:AROS:ChannelProbe] FAIL transferred=%d duplex=%d receiver=%d\n",
+        transferred_ok, duplex_ok, receiver_result);
+    return 24;
+  }
+
+  bug(
+      "[Mojo:AROS:ChannelProbe] PASS queued=1 duplex=1 handles=1 "
+      "peer_close=1\n");
+  return 0;
+}
