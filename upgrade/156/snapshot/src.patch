+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/gl_ozone_egl_aros.h"
+
+#include <stdint.h>
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "ui/gfx/presentation_feedback.h"
+#include "ui/gl/gl_bindings.h"
+#include "ui/gl/gl_surface.h"
+#include "ui/gl/gl_surface_egl.h"
+#include "ui/ozone/platform/aros/aros_egl_library.h"
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+
+#if defined(AROS_OZONE_ANGLE_GL)
+// ANGLE (statically linked) takes the native egl.library entry points from
+// the resolver installed here, and exposes its own through EGL_GetProcAddress.
+// The ANGLE-prefixed name, because the plain egl* names also exist in the
+// egl.library link library.
+extern "C" void ANGLEArosSetNativeEGLResolver(void* (*resolver)(const char*));
+extern "C" __eglMustCastToProperFunctionPointerType EGLAPIENTRY
+EGL_GetProcAddress(const char* procname);
+#endif
+
+namespace ui {
+namespace {
+
+#if defined(AROS_OZONE_ANGLE_GL)
+void* ArosNativeEGLResolverForANGLE(const char* name) {
+  return reinterpret_cast<void*>(GetArosEGLProcAddress(name));
+}
+
+gl::GLFunctionPointerType GL_BINDING_CALL
+ArosANGLEGetProcAddress(const char* name) {
+  return reinterpret_cast<gl::GLFunctionPointerType>(EGL_GetProcAddress(name));
+}
+#endif
+
+constexpr char kArosMissingWindowGLSurface[] = "aros-missing-window-gl-surface";
+constexpr char kArosMissingWindowGLSurfacePbuffer[] = "pbuffer";
+constexpr char kArosMissingWindowGLSurfaceSurfaceless[] = "surfaceless";
+
+class ArosViewGLSurfaceEGL final : public gl::NativeViewGLSurfaceEGL {
+ public:
+  ArosViewGLSurfaceEGL(gl::GLDisplayEGL* display, EGLNativeWindowType window)
+      : NativeViewGLSurfaceEGL(display, window, nullptr) {}
+
+  gfx::SwapResult SwapBuffers(PresentationCallback callback,
+                              gfx::FrameData /*data*/) override {
+    const bool presented = eglSwapBuffers(GetEGLDisplay(), GetHandle());
+    const gfx::SwapResult result =
+        presented ? gfx::SwapResult::SWAP_ACK : gfx::SwapResult::SWAP_FAILED;
+
+    // AROS' EGL window swap synchronously blits the rendered resource into the
+    // Intuition window.  It does not expose frame timestamps, and the generic
+    // EGL GPU-query path never completes under VirGL.  Acknowledge the visible
+    // blit without claiming hardware-vsync timing so compositor callbacks do
+    // not accumulate indefinitely while scrolling.
+    gfx::PresentationFeedback feedback =
+        presented ? gfx::PresentationFeedback(base::TimeTicks::Now(),
+                                              base::TimeDelta(), 0)
+                  : gfx::PresentationFeedback::Failure();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), std::move(feedback)));
+    return result;
+  }
+
+ protected:
+  ~ArosViewGLSurfaceEGL() override = default;
+};
+
+}  // namespace
+
+GLOzoneEGLAros::GLOzoneEGLAros(ArosWindowManager* window_manager)
+    : window_manager_(window_manager) {}
+
+GLOzoneEGLAros::~GLOzoneEGLAros() = default;
+
+scoped_refptr<gl::GLSurface> GLOzoneEGLAros::CreateViewGLSurface(
+    gl::GLDisplay* display,
+    gfx::AcceleratedWidget window) {
+  auto* egl_display = display->GetAs<gl::GLDisplayEGL>();
+  struct Window* native_window = window_manager_->GetNativeWindow(window);
+  if (!native_window) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] no Intuition window for widget="
+               << window;
+    const std::string fallback =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            kArosMissingWindowGLSurface);
+    if (fallback == kArosMissingWindowGLSurfaceSurfaceless) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] using test-only surfaceless "
+                    "fallback for missing widget="
+                 << window;
+      return gl::InitializeGLSurface(
+          base::MakeRefCounted<gl::SurfacelessEGL>(egl_display, gfx::Size(1, 1)));
+    }
+    if (fallback == kArosMissingWindowGLSurfacePbuffer) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] using test-only pbuffer fallback "
+                    "for missing widget="
+                 << window;
+      return gl::InitializeGLSurface(
+          base::MakeRefCounted<gl::PbufferGLSurfaceEGL>(egl_display,
+                                                        gfx::Size(1, 1)));
+    }
+    return nullptr;
+  }
+
+  const EGLNativeWindowType egl_window = static_cast<EGLNativeWindowType>(
+      reinterpret_cast<intptr_t>(native_window));
+  LOG(INFO) << "[Chromium:Ozone:AROS:EGL] creating window surface widget="
+            << window << " native=" << native_window;
+  return gl::InitializeGLSurface(
+      base::MakeRefCounted<ArosViewGLSurfaceEGL>(egl_display, egl_window));
+}
+
+scoped_refptr<gl::GLSurface> GLOzoneEGLAros::CreateOffscreenGLSurface(
+    gl::GLDisplay* display,
+    const gfx::Size& size) {
+  return gl::InitializeGLSurface(base::MakeRefCounted<gl::PbufferGLSurfaceEGL>(
+      display->GetAs<gl::GLDisplayEGL>(), size));
+}
+
+gl::EGLDisplayPlatform GLOzoneEGLAros::GetNativeDisplay() {
+  return gl::EGLDisplayPlatform(EGL_DEFAULT_DISPLAY);
+}
+
+bool GLOzoneEGLAros::LoadGLES2Bindings(
+    const gl::GLImplementationParts& implementation) {
+  if (implementation.gl == gl::kGLImplementationEGLANGLE) {
+#if defined(AROS_OZONE_ANGLE_GL)
+    if (!InitializeArosEGLLibrary() || !GetArosEGLProcAddress("eglGetDisplay")) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] egl.library bindings unavailable"
+                 << " for ANGLE";
+      return false;
+    }
+    ANGLEArosSetNativeEGLResolver(&ArosNativeEGLResolverForANGLE);
+    gl::SetGLGetProcAddressProc(&ArosANGLEGetProcAddress);
+    LOG(INFO) << "[Chromium:Ozone:AROS:EGL] using ANGLE ("
+              << implementation.ToString()
+              << ") over egl.library/gl.library";
+    return true;
+#else
+    LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] ANGLE requested but this build"
+               << " has no ANGLE GL backend (angle_enable_gl=false)";
+    return false;
+#endif
+  }
+
+  if (implementation.gl != gl::kGLImplementationEGLGLES2 ||
+      !InitializeArosEGLLibrary() || !GetArosEGLProcAddress("eglGetDisplay")) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] egl.library bindings unavailable";
+    return false;
+  }
+
+  gl::SetGLGetProcAddressProc(&GetArosEGLProcAddress);
+  LOG(INFO) << "[Chromium:Ozone:AROS:EGL] using egl.library/gl.library stubs"
+            << " base=" << GetArosEGLLibraryBase() << " self="
+            << reinterpret_cast<const void*>(&GetArosEGLProcAddress);
+  return true;
+}
+
+}  // namespace ui
