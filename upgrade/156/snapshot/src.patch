+
+bool GetNetworkList(NetworkInterfaceList* networks, int policy) {
+  if (!networks) {
+    return false;
+  }
+  networks->clear();
+
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  std::vector<base::aros::NetworkInterfaceInfo> native_interfaces;
+  if (!base::aros::GetNetworkInterfaces(&native_interfaces)) {
+    return false;
+  }
+
+  for (const auto& native : native_interfaces) {
+    if (!(native.flags & IFF_UP) || !(native.flags & IFF_DRV_RUNNING) ||
+        (native.flags & IFF_LOOPBACK) ||
+        internal::ShouldIgnoreInterface(native.name, policy)) {
+      continue;
+    }
+
+    const IPAddress address(base::span(native.address).first(
+        native.address_length));
+    if (!address.IsValid() || address.IsZero() || address.IsLoopback()) {
+      continue;
+    }
+
+    uint32_t prefix_length = 0;
+    if (native.has_netmask) {
+      const IPAddress netmask(base::span(native.netmask).first(
+          native.address_length));
+      prefix_length = static_cast<uint32_t>(MaskPrefixLength(netmask));
+    }
+
+    networks->emplace_back(
+        native.name, native.name, native.index,
+        NetworkChangeNotifier::CONNECTION_UNKNOWN, address, prefix_length,
+        IP_ADDRESS_ATTRIBUTE_NONE);
+  }
+  return true;
+}
