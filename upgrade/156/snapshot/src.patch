diff --git a/build/config/aros/v8_library/v8_import_resolver.cc b/build/config/aros/v8_library/v8_import_resolver.cc
new file mode 100644
index 0000000000000000000000000000000000000000..13b818cb8cb68d55c6db2f87779aed8283a93677
--- /dev/null
+++ b/build/config/aros/v8_library/v8_import_resolver.cc
@@ -0,0 +1,41 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <stddef.h>
+
+#include <proto/v8.h>
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+extern "C" {
+extern const size_t g_v8_import_count;
+extern const char* const g_v8_import_names[];
+extern void* g_v8_import_slots[];
+}
+
+namespace {
+
+extern "C" [[noreturn]] void ArosMissingV8Import() {
+  ArosKPutStr("[Chromium:shared-v8] called unresolved V8 import\n");
+  __builtin_trap();
+}
+
+}  // namespace
+
+extern "C" void* ArosResolveV8Import(size_t index) {
+  if (index >= g_v8_import_count)
+    return reinterpret_cast<void*>(&ArosMissingV8Import);
+
+  const char* symbol = g_v8_import_names[index];
+  void* resolved = V8FindEngineSymbol(symbol);
+  if (!resolved) {
+    ArosKPutStr("[Chromium:shared-v8] unresolved import: ");
+    ArosKPutStr(symbol);
+    ArosKPutStr("\n");
+    return reinterpret_cast<void*>(&ArosMissingV8Import);
+  }
+
+  __atomic_store_n(&g_v8_import_slots[index], resolved, __ATOMIC_RELEASE);
+  return resolved;
+}
diff --git a/build/config/aros/v8_library/v8_library_consumer_probe.cc b/build/config/aros/v8_library/v8_library_consumer_probe.cc
