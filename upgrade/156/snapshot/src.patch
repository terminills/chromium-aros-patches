+void ArosWindow::SetFullscreen(bool fullscreen, int64_t target_display_id) {
+  DCHECK_EQ(target_display_id, display::kInvalidDisplayId);
+  // Reached from key dispatch (F11): reopening the Intuition window drains
+  // its IDCMP port, so it must not happen inside that dispatch.
+  auto switch_later = [&](NativeMode mode) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ArosWindow::SwitchNativeMode,
+                                  weak_factory_.GetWeakPtr(), mode));
+  };
+  if (fullscreen) {
+    if (!restored_bounds_) {
+      restored_bounds_ = bounds_;
+    }
+    switch_later(own_screen_requested_ ? NativeMode::kOwnScreen
+                                       : NativeMode::kFullscreen);
+    own_screen_requested_ = false;
+    UpdateWindowState(PlatformWindowState::kFullScreen);
+  } else if (window_state_ == PlatformWindowState::kFullScreen) {
+    switch_later(NativeMode::kNormal);
+    UpdateWindowState(PlatformWindowState::kNormal);
+  }
+}
