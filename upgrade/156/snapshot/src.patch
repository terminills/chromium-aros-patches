+
+uintptr_t SystemAllocPagesInternal(
+    uintptr_t hint,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageTag,
+    int file_descriptor_for_shared_alloc) {
+  if (file_descriptor_for_shared_alloc != -1) {
+    s_allocPageErrorCode = ENOTSUP;
+    return 0;
+  }
+
+  APTR KernelBase = OpenKernelResource();
+  if (!KernelBase) {
+    s_allocPageErrorCode = ENOSYS;
+    return 0;
+  }
+
+  ULONG flags = MEMF_PUBLIC | MEMF_CLEAR;
+  if (accessibility.permissions ==
+          PageAccessibilityConfiguration::kInaccessibleWillJitLater ||
+      (GetAccessFlags(accessibility) & MAP_Executable)) {
+    flags |= MEMF_EXECUTABLE;
+  }
+
+  constexpr size_t kLargePageRequest = 64 * 1024 * 1024;
+  const bool log_request = length >= kLargePageRequest;
+  const IPTR available = log_request ? AvailMem(MEMF_PUBLIC) : 0;
+  const IPTR largest =
+      log_request ? AvailMem(MEMF_PUBLIC | MEMF_LARGEST) : 0;
+  const KRN_MapAttr protection = GetAccessFlags(accessibility);
+  // The transition-era kernel backend cannot yet provide anonymous pages for
+  // large unhinted reservations. Go straight to the tracked Exec bridge for
+  // those requests instead of paying for a known-failing kernel probe.
+  const bool skip_kernel_anonymous_probe = !hint && log_request;
+  void* result = skip_kernel_anonymous_probe
+                     ? nullptr
+                     : KrnAllocPages(reinterpret_cast<void*>(hint), length,
+                                     flags);
+  bool exec_owned = false;
+  void* allocation_base = result;
+  size_t allocation_length = length;
+
+  if (!result) {
+    if (log_request && !skip_kernel_anonymous_probe) {
+      LogLargePageAllocation(hint, length, protection, available, largest,
+                             "kernel", result, ENOMEM);
+    }
+
+    // The transition-era Exec MemHeaders are not initialized for mm_linear,
+    // so KrnAllocPages cannot yet provide anonymous pages. Exact-address
+    // requests must fail, but an unhinted request can use tracked Exec backing.
+    if (hint) {
+      s_allocPageErrorCode = ENOMEM;
+      return 0;
+    }
+
+    // This bridge has physical backing even for inaccessible reservations.
+    // Keep it zeroed so the first accessible slice has anonymous-page commit
+    // semantics without destroying data on later permission-only changes.
+    allocation_base = AllocateExecPages(length, flags, &allocation_length);
+    if (!allocation_base) {
+      s_allocPageErrorCode = ENOMEM;
+      if (log_request) {
+        LogLargePageAllocation(hint, length, protection, available, largest,
+                               "exec", nullptr, ENOMEM);
+      }
+      return 0;
+    }
+
+    const uintptr_t granularity_mask = PageAllocationGranularity() - 1;
+    result = reinterpret_cast<void*>(
+        (reinterpret_cast<uintptr_t>(allocation_base) + granularity_mask) &
+        ~granularity_mask);
+    exec_owned = true;
+  }
+
+  if (!TrackPageAllocation(reinterpret_cast<uintptr_t>(result), length,
+                           reinterpret_cast<uintptr_t>(result), length,
+                           allocation_base, allocation_length, exec_owned)) {
+    if (exec_owned) {
+      FreeMem(allocation_base, allocation_length);
+    } else {
+      KrnFreePages(result, length);
+    }
+    s_allocPageErrorCode = ENOMEM;
+    return 0;
+  }
+
+  SetProtection(KernelBase, reinterpret_cast<uintptr_t>(result), length,
+                protection);
+  s_allocPageErrorCode = 0;
+  TracePageEvent(exec_owned ? "alloc-exec" : "alloc-kernel",
+                 reinterpret_cast<uintptr_t>(result), length, protection);
+  if (log_request) {
+    LogLargePageAllocation(hint, length, protection, available, largest,
+                           exec_owned ? "exec" : "kernel", result, 0);
+  }
+  return reinterpret_cast<uintptr_t>(result);
+}
+
+bool TrySetSystemPagesAccessInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility) {
+  APTR KernelBase = OpenKernelResource();
+  if (!KernelBase) {
+    return false;
+  }
+  SetProtection(KernelBase, address, length, GetAccessFlags(accessibility));
+  TracePageEvent("set-access", address, length, GetAccessFlags(accessibility));
+  return true;
+}
+
+void SetSystemPagesAccessInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility) {
+  PA_CHECK(TrySetSystemPagesAccessInternal(address, length, accessibility));
+}
+
+void FreePagesInternal(uintptr_t address, size_t length) {
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+  TracePageEvent("free", address, length, 0);
+  PageAllocationRelease release = PreparePageAllocationRelease(address, length);
+  if (release.kind == PageAllocationReleaseKind::kRetainedSuffix) {
+    // AROS has no sparse virtual unmap yet. Preserve ownership of the original
+    // contiguous block while making the suffix unavailable to PartitionAlloc;
+    // the exact final free releases all retained physical backing.
+    LogRetainedPageSuffix(address, length, release.exposed_base,
+                          release.exposed_length);
+    return;
+  }
+
+  PageAllocationRecord* record = release.record;
+  if (release.kind != PageAllocationReleaseKind::kWhole || !record) {
+    // Every mapping created by this backend is tracked. Passing an unknown
+    // address to KrnFreePages can mistake an Exec-managed MemHeader for an
+    // mm_linear header, so preserve the caller context with a controlled
+    // PartitionAlloc failure instead of crossing that ownership boundary.
+    LogInvalidPageFree(address, length);
+    PA_CHECK(record);
+    return;
+  }
+
+  // The pages go back to a pool whose memory is executable by default (the
+  // hosted RAM block is mapped RWX, the ELF loader puts code anywhere); leave
+  // them as they were found, or the next program loaded into them faults on
+  // its first instruction.
+  //
+  // For an Exec-backed reservation that must cover the WHOLE block, not just
+  // the window PartitionAlloc kept: the reservation set its (usually
+  // inaccessible) protection over the full aligned result, and a later trim
+  // narrows protected_base/protected_length to the kept window without
+  // touching the slack it cut off. Restoring only the window handed exec
+  // free memory with PROT_NONE pages inside it; the next AllocMem(MEMF_CLEAR)
+  // to land there faulted in the kernel's memset (tlsf_malloc <- AllocMem
+  // <- v8 OS::Allocate on a worker isolate, CR2 = the first slack page).
+  if (record->exec_owned) {
+    const uintptr_t page_mask = PageAllocationGranularity() - 1;
+    const uintptr_t span_base =
+        reinterpret_cast<uintptr_t>(record->allocation_base) & ~page_mask;
+    const uintptr_t span_end =
+        (reinterpret_cast<uintptr_t>(record->allocation_base) +
+         record->allocation_length + page_mask) &
+        ~page_mask;
+    SetProtection(KernelBase, span_base, span_end - span_base,
+                  static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable |
+                                           MAP_Executable));
+  } else {
+    SetProtection(KernelBase, record->protected_base,
+                  record->protected_length,
+                  static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable |
+                                           MAP_Executable));
+  }
+  if (record->exec_owned) {
+    FreeMem(record->allocation_base, record->allocation_length);
+  } else {
+    KrnFreePages(record->allocation_base, record->allocation_length);
+  }
+  FreeMem(record, sizeof(PageAllocationRecord));
+}
+
+uintptr_t TrimMappingInternal(uintptr_t base_address,
+                              size_t base_length,
+                              size_t trim_length,
+                              PageAccessibilityConfiguration accessibility,
+                              size_t pre_slack,
+                              size_t) {
+  const uintptr_t result = base_address + pre_slack;
+  PA_CHECK(RetainTrimmedPageAllocation(base_address, base_length, result,
+                                       trim_length, accessibility));
+  return result;
+}
+
+void DecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityDisposition) {
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+  TracePageEvent("decommit", address, length, 0);
+  SetProtection(KernelBase, address, length,
+                static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
+  std::memset(reinterpret_cast<void*>(address), 0, length);
+  SetProtection(KernelBase, address, length, static_cast<KRN_MapAttr>(0));
+}
+
+bool DecommitAndZeroSystemPagesInternal(uintptr_t address,
+                                        size_t length,
+                                        PageTag) {
+  DecommitSystemPagesInternal(
+      address, length, PageAccessibilityDisposition::kRequireUpdate);
+  return true;
+}
+
+void RecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageAccessibilityDisposition) {
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+  SetProtection(KernelBase, address, length,
+                static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
+  std::memset(reinterpret_cast<void*>(address), 0, length);
+  SetProtection(KernelBase, address, length, GetAccessFlags(accessibility));
+}
+
+bool TryRecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageAccessibilityDisposition) {
+  APTR KernelBase = OpenKernelResource();
+  if (!KernelBase) {
+    return false;
+  }
+  SetProtection(KernelBase, address, length,
+                static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
+  std::memset(reinterpret_cast<void*>(address), 0, length);
+  SetProtection(KernelBase, address, length, GetAccessFlags(accessibility));
+  return true;
+}
+
+void DiscardSystemPagesInternal(uintptr_t, size_t) {
+  // AROS cannot currently discard physical backing while retaining the
+  // virtual address reservation. Decommit still zeroes and protects pages.
+}
+
+bool SealSystemPagesInternal(uintptr_t, size_t) {
+  // Kernel mapping protection can be changed again; it is not an irreversible
+  // seal. Report unsupported, as the other platforms without mseal do.
+  return false;
+}
