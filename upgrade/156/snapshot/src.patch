+// found in the LICENSE file.
+
+#include "base/base_paths.h"
+
+#include <limits.h>
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+
+// AROS headers last: proto/dos.h defines Info, Seek, Read, Write and
+// DeleteFile as inline-call macros, which rewrite the identically named
+// members and functions in base/files/file.h and file_util.h if they are
+// pulled in first. Every other *_aros.cc in this port orders it this way.
+#include <dos/dos.h>
+#include <exec/tasks.h>
+#include <proto/dos.h>
+#include <proto/exec.h>
+
+namespace base {
+namespace {
+
+// RAM: is the one volatile location every AROS system has, and the only place
+// a cache can go when the boot medium is read-only.
+constexpr char kVolatileCacheDirectory[] = "RAM:Chromium/Cache";
+
+bool GetExecutablePath(FilePath* result) {
+  char directory[PATH_MAX];
+  char program[PATH_MAX];
+  const BPTR program_dir = GetProgramDir();
+
+  // Shell sets both ProgramDir and the DOS program name. Workbench startup
+  // instead installs the icon's lock as CurrentDir and names the process task.
+  // Support both launch contracts so FILE_MODULE (and therefore DIR_ASSETS)
+  // resolves to the executable's directory in either case.
+  const bool have_directory =
+      program_dir
+          ? NameFromLock(program_dir, directory, sizeof(directory))
+          : GetCurrentDirName(directory, sizeof(directory));
+  if (!have_directory) {
+    return false;
+  }
+
+  const char* program_name = nullptr;
+  if (GetProgramName(program, sizeof(program))) {
+    program_name = FilePart(program);
+  } else {
+    const Task* task = FindTask(nullptr);
+    if (task)
+      program_name = task->tc_Node.ln_Name;
+  }
+
+  if (!program_name || !*program_name)
+    return false;
+
+  std::string path(directory);
+  if (!path.empty() && path.back() != ':' && path.back() != '/')
+    path.push_back('/');
+  path.append(program_name);
+  *result = FilePath(path);
+  return true;
+}
+
+}  // namespace
+
+bool PathProviderPosix(int key, FilePath* result) {
+  switch (key) {
+    case FILE_EXE:
+    case FILE_MODULE:
+      return GetExecutablePath(result);
+    case DIR_SRC_TEST_DATA_ROOT: {
+      FilePath path;
+      if (!PathService::Get(DIR_EXE, &path))
+        return false;
+      *result = path.DirName().DirName();
+      return true;
+    }
+    case DIR_CACHE: {
+      // The cache sits beside the executable, but PROGDIR: is the boot medium
+      // and a Live CD boot makes that medium read-only: the directory cannot
+      // be created and every cache write fails with
+      // "mkdir failed ... errno=1214" (ERROR_DISK_WRITE_PROTECTED). Probe by
+      // creating it - which succeeds when it already exists - and fall back to
+      // RAM: when it cannot be made. An installed system is unaffected and
+      // keeps a persistent cache beside the executable.
+      //
+      // This mirrors the profile-location policy and belongs in the same place
+      // it does: an AROS launcher that prepares these directories and passes
+      // them in, rather than the browser probing at startup. See
+      // .acd/decisions/ACD-chromium-aros-profile-location.
+      FilePath path;
+      if (GetExecutablePath(&path)) {
+        const FilePath cache = path.DirName().Append("Cache");
+        if (CreateDirectory(cache)) {
+          *result = cache;
+          return true;
+        }
+      }
+      *result = FilePath(kVolatileCacheDirectory);
+      return true;
+    }
+    case DIR_USER_DESKTOP:
+      return false;
+  }
+  return false;
+}
+
+}  // namespace base
