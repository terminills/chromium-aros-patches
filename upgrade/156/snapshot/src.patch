index 0000000000000000000000000000000000000000..56411f373216e573449638a1a82ea7c4e1c38186
--- /dev/null
+++ b/ui/ozone/platform/aros/ozone_platform_aros.cc
@@ -0,0 +1,257 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/ozone_platform_aros.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/task/current_thread.h"
+#include "base/time/time.h"
+#include "ui/base/cursor/cursor_factory.h"
+#include "ui/base/cursor/platform_cursor.h"
+#include "ui/base/ime/input_method_minimal.h"
+#include "ui/display/types/native_display_delegate.h"
+#include "ui/events/ozone/layout/keyboard_layout_engine_manager.h"
+#include "ui/events/ozone/layout/stub/stub_keyboard_layout_engine.h"
+#include "ui/events/platform/platform_event_source.h"
+#include "ui/ozone/common/bitmap_cursor_factory.h"
+#include "ui/ozone/common/stub_overlay_manager.h"
+#include "ui/ozone/platform/aros/aros_screen.h"
+#include "ui/ozone/platform/aros/aros_surface_factory.h"
+#include "ui/ozone/platform/aros/aros_window.h"
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+#include "ui/ozone/public/gpu_platform_support_host.h"
+#include "ui/ozone/public/input_controller.h"
+#include "ui/ozone/public/stub_input_controller.h"
+#include "ui/ozone/public/ozone_platform.h"
+#include "ui/ozone/public/system_input_injector.h"
+#include "ui/platform_window/platform_window_init_properties.h"
+
+namespace ui {
+
+namespace {
+
+constexpr char kEnableArosGpuCompositing[] =
+    "aros-enable-gpu-compositing";
+constexpr char kDisableGpuCompositing[] = "disable-gpu-compositing";
+
+class ArosCursorFactory : public BitmapCursorFactory {
+ public:
+  ArosCursorFactory() = default;
+  ~ArosCursorFactory() override = default;
+
+  scoped_refptr<PlatformCursor> GetDefaultCursor(
+      mojom::CursorType type) override {
+    switch (type) {
+      case mojom::CursorType::kNull:
+      case mojom::CursorType::kPointer:
+      case mojom::CursorType::kNone:
+      case mojom::CursorType::kWait:
+      case mojom::CursorType::kProgress:
+        // These shapes have direct Intuition representations. Preserve the
+        // cursor type without manufacturing an Aura bitmap so ArosWindow can
+        // select the screen pointer, hidden pointer, or busy pointer.
+        return BitmapCursorFactory::GetDefaultCursor(type);
+      default:
+        break;
+    }
+
+    // Intuition has no public lookup API for the remaining standard shapes.
+    // Returning null asks CursorLoader for Chromium's bitmap; ArosWindow then
+    // installs that bitmap through the native AROS pointerclass.
+    return nullptr;
+  }
+};
+
+// Intuition wakes the native Exec pump when IDCMP messages arrive.
+class ArosPlatformEventSource : public PlatformEventSource {
+ public:
+  explicit ArosPlatformEventSource(ArosWindowManager* window_manager)
+      : window_manager_(window_manager) {
+    CHECK(base::CurrentUIThread::Get()->WatchMessagePort(
+        window_manager_->event_port(), &watch_,
+        base::BindRepeating(&ArosPlatformEventSource::ProcessEvents,
+                            base::Unretained(this))));
+  }
+
+  ArosPlatformEventSource(const ArosPlatformEventSource&) = delete;
+  ArosPlatformEventSource& operator=(const ArosPlatformEventSource&) = delete;
+
+  ~ArosPlatformEventSource() override = default;
+
+ private:
+  void ProcessEvents() { window_manager_->ProcessNativeEvents(); }
+
+  raw_ptr<ArosWindowManager> window_manager_;
+  base::MessagePumpForUI::PortWatchController watch_;
+};
+
+class OzonePlatformAros : public OzonePlatform,
+                          public base::CurrentThread::DestructionObserver {
+ public:
+  OzonePlatformAros() = default;
+
+  OzonePlatformAros(const OzonePlatformAros&) = delete;
+  OzonePlatformAros& operator=(const OzonePlatformAros&) = delete;
+
+  ~OzonePlatformAros() override = default;
+
+  SurfaceFactoryOzone* GetSurfaceFactoryOzone() override {
+    return surface_factory_.get();
+  }
+
+  OverlayManagerOzone* GetOverlayManager() override {
+    return overlay_manager_.get();
+  }
+
+  CursorFactory* GetCursorFactory() override { return cursor_factory_.get(); }
+
+  InputController* GetInputController() override {
+    return input_controller_.get();
+  }
+
+  GpuPlatformSupportHost* GetGpuPlatformSupportHost() override {
+    return gpu_platform_support_host_.get();
+  }
+
+  std::unique_ptr<SystemInputInjector> CreateSystemInputInjector() override {
+    return nullptr;
+  }
+
+  std::unique_ptr<PlatformWindow> CreatePlatformWindow(
+      PlatformWindowDelegate* delegate,
+      PlatformWindowInitProperties properties) override {
+    CHECK(window_manager_);
+    return std::make_unique<ArosWindow>(delegate, window_manager_.get(),
+                                        std::move(properties));
+  }
+
+  bool IsWindowCompositingSupported() const override {
+    const base::CommandLine& command_line =
+        *base::CommandLine::ForCurrentProcess();
+    return command_line.HasSwitch(kEnableArosGpuCompositing) &&
+           !command_line.HasSwitch(kDisableGpuCompositing);
+  }
+
+  const PlatformProperties& GetPlatformProperties() override {
+    static base::NoDestructor<OzonePlatform::PlatformProperties> properties;
+    static bool initialised = false;
+    if (!initialised) {
+      // Menus, tooltips and other non-activatable popups are hosted in their
+      // own Intuition windows by DesktopNativeWidgetTopLevelHandler, which
+      // only hands us the owning window as |context|.  Asking views to turn
+      // that context into |parent_widget| is what lets ArosWindow route
+      // Intuition activation back to the owner instead of letting the popup's
+      // activation cancel the very menu the click was meant for.
+      properties->set_parent_for_non_top_level_windows = true;
+      initialised = true;
+    }
+    return *properties;
+  }
+
+  std::unique_ptr<display::NativeDisplayDelegate> CreateNativeDisplayDelegate()
+      override {
+    return nullptr;
+  }
+
+  std::unique_ptr<PlatformScreen> CreateScreen() override {
+    return std::make_unique<ArosScreen>();
+  }
+
+  void InitScreen(PlatformScreen* screen) override {}
+
+  std::unique_ptr<InputMethod> CreateInputMethod(
+      ImeKeyEventDispatcher* ime_key_event_dispatcher,
+      gfx::AcceleratedWidget widget) override {
+    return std::make_unique<InputMethodMinimal>(ime_key_event_dispatcher);
+  }
+
+  bool InitializeUI(const InitParams& params) override {
+    LOG(INFO) << "[Chromium:Ozone:AROS] initializing native Intuition backend";
+    window_manager_ = std::make_unique<ArosWindowManager>();
+    RegisterDestructionObserver();
+    surface_factory_ =
+        std::make_unique<ArosSurfaceFactory>(window_manager_.get());
+    if (!PlatformEventSource::GetInstance()) {
+      platform_event_source_ =
+          std::make_unique<ArosPlatformEventSource>(window_manager_.get());
+    }
+
+    keyboard_layout_engine_ = std::make_unique<StubKeyboardLayoutEngine>();
+    KeyboardLayoutEngineManager::SetKeyboardLayoutEngine(
+        keyboard_layout_engine_.get());
+    overlay_manager_ = std::make_unique<StubOverlayManager>();
+    input_controller_ = std::make_unique<StubInputController>();
+    cursor_factory_ = std::make_unique<ArosCursorFactory>();
+    gpu_platform_support_host_.reset(CreateStubGpuPlatformSupportHost());
+    return true;
+  }
+
+  void InitializeGPU(const InitParams& params) override {
+    if (!window_manager_) {
+      window_manager_ = std::make_unique<ArosWindowManager>();
+      RegisterDestructionObserver();
+    }
+    if (!surface_factory_) {
+      surface_factory_ =
+          std::make_unique<ArosSurfaceFactory>(window_manager_.get());
+    }
+  }
+
+  void WillDestroyCurrentMessageLoop() override { ShutdownNativeResources(); }
+
+ private:
+  void RegisterDestructionObserver() {
+    if (registered_destruction_observer_) {
+      return;
+    }
+    base::CurrentThread::Get()->AddDestructionObserver(this);
+    registered_destruction_observer_ = true;
+  }
+
+  void ShutdownNativeResources() {
+    if (native_shutdown_started_) {
+      return;
+    }
+    native_shutdown_started_ = true;
+
+    if (registered_destruction_observer_) {
+      base::CurrentThread::Get()->RemoveDestructionObserver(this);
+      registered_destruction_observer_ = false;
+    }
+
+    LOG(ERROR) << "[Chromium:Ozone:AROS] releasing native platform resources";
+    platform_event_source_.reset();
+    surface_factory_.reset();
+    if (window_manager_) {
+      window_manager_->ReleaseNativeResources();
+    }
+  }
+
+  std::unique_ptr<ArosWindowManager> window_manager_;
+  std::unique_ptr<ArosSurfaceFactory> surface_factory_;
+  std::unique_ptr<PlatformEventSource> platform_event_source_;
+  std::unique_ptr<KeyboardLayoutEngine> keyboard_layout_engine_;
+  std::unique_ptr<CursorFactory> cursor_factory_;
+  std::unique_ptr<InputController> input_controller_;
+  std::unique_ptr<GpuPlatformSupportHost> gpu_platform_support_host_;
+  std::unique_ptr<OverlayManagerOzone> overlay_manager_;
+  bool registered_destruction_observer_ = false;
+  bool native_shutdown_started_ = false;
+};
+
+}  // namespace
+
+OzonePlatform* CreateOzonePlatformAros() {
+  return new OzonePlatformAros();
+}
+
+}  // namespace ui
