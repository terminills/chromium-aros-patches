diff --git a/chrome/common/chrome_paths_aros.cc b/chrome/common/chrome_paths_aros.cc
new file mode 100644
index 0000000000000000000000000000000000000000..03eb8951546030335126b4181cf4e37a557413db
--- /dev/null
+++ b/chrome/common/chrome_paths_aros.cc
@@ -0,0 +1,120 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/common/chrome_paths_internal.h"
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/path_service.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace chrome {
+namespace {
+
+constexpr char kProfileAssign[] = "PROFILE:";
+constexpr char kProfileUserDataDirectory[] =
+    "PROFILE:Applications/Chromium";
+constexpr char kProfileCacheDirectory[] = "PROFILE:Cache/Chromium";
+constexpr char kLegacyUserDataDirectory[] = "PROGDIR:Profiles";
+constexpr char kVolatileUserDataDirectory[] = "RAM:Chromium";
+constexpr char kVolatileUserDirectory[] = "RAM:";
+
+bool HasUserProfile() {
+  return base::DirectoryExists(base::FilePath(kProfileAssign));
+}
+
+base::FilePath GetUserDirectory(const char* name) {
+  if (HasUserProfile()) {
+    return base::FilePath(kProfileAssign).Append(name);
+  }
+  return base::FilePath(kVolatileUserDirectory).Append(name);
+}
+
+}  // namespace
+
+bool GetDefaultUserDataDirectory(base::FilePath* result) {
+  if (HasUserProfile()) {
+    *result = base::FilePath(kProfileUserDataDirectory);
+    return true;
+  }
+
+  // NOTE: this policy - writable PROGDIR: wins, otherwise somewhere volatile -
+  // is meant to live in an AROS launcher that prepares the profile and passes
+  // --user-data-dir=, not inside the browser. It sits here because it is what
+  // made the Live CD boot work; moving it out is a refactor with no
+  // user-visible change. See .acd/decisions/ACD-chromium-aros-profile-location.
+  //
+  // PROGDIR: is the boot medium, and on a Live CD that medium is read-only:
+  // the profile cannot be created there, DIR_USER_DATA fails outright, and
+  // startup dies in PostEarlyInitialization with
+  // "path_service.cc: Failed to get the path for 1001" before a window is
+  // ever drawn. Probe by creating the directory - it succeeds when it already
+  // exists - and fall back to RAM:, which is the one volatile location every
+  // AROS system has. T: is NOT usable here: a Live CD boot does not assign it,
+  // and merely probing a missing assign pops a "Please insert volume T"
+  // requester in the middle of startup. An installed (writable) system keeps
+  // using PROGDIR:Profiles, so a real profile still persists there.
+  base::FilePath legacy(kLegacyUserDataDirectory);
+  if (base::CreateDirectory(legacy)) {
+    *result = legacy;
+    return true;
+  }
+
+  *result = base::FilePath(kVolatileUserDataDirectory);
+  return true;
+}
+
+void GetUserCacheDirectory(const base::FilePath& profile_dir,
+                           base::FilePath* result) {
+  *result = profile_dir;
+
+  base::FilePath user_data_dir;
+  if (!base::PathService::Get(DIR_USER_DATA, &user_data_dir)) {
+    return;
+  }
+
+  base::FilePath cache_dir;
+  if (HasUserProfile()) {
+    cache_dir = base::FilePath(kProfileCacheDirectory);
+  } else if (!base::PathService::Get(base::DIR_CACHE, &cache_dir)) {
+    return;
+  }
+
+  if (!user_data_dir.AppendRelativePath(profile_dir, &cache_dir)) {
+    return;
+  }
+
+  *result = cache_dir;
+}
+
+bool GetUserDocumentsDirectory(base::FilePath* result) {
+  *result = GetUserDirectory("Documents");
+  return true;
+}
+
+bool GetUserDownloadsDirectory(base::FilePath* result) {
+  *result = GetUserDirectory("Downloads");
+  return true;
+}
+
+bool GetUserMusicDirectory(base::FilePath* result) {
+  *result = GetUserDirectory("Music");
+  return true;
+}
+
+bool GetUserPicturesDirectory(base::FilePath* result) {
+  *result = GetUserDirectory("Pictures");
+  return true;
+}
+
+bool GetUserVideosDirectory(base::FilePath* result) {
+  *result = GetUserDirectory("Videos");
+  return true;
+}
+
+bool ProcessNeedsProfileDir(const std::string& process_type) {
+  return true;
+}
+
+}  // namespace chrome
