+#include <cstdint>
+#include <limits>
+#include <optional>
+
+#pragma push_macro("SCHED_RR")
+#undef SCHED_RR
+#include <aros/kernel.h>
+#pragma pop_macro("SCHED_RR")
+#include <aros/debug.h>
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/kernel.h>
+#undef Allocate
+
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/numerics/checked_math.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "build/build_config.h"
+
+namespace base {
+
+MemoryMappedFile::MemoryMappedFile() = default;
+
+bool MemoryMappedFile::MapFileRegionToMemory(
+    const MemoryMappedFile::Region& region,
+    Access access) {
+  ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  int64_t file_offset = 0;
+  size_t data_size = 0;
+  if (region == MemoryMappedFile::Region::kWholeFile) {
+    const int64_t file_length = file_.GetLength();
+    if (file_length <= 0 ||
+        !IsValueInRangeForNumericType<size_t>(file_length)) {
+      return false;
+    }
+    data_size = static_cast<size_t>(file_length);
+  } else {
+    file_offset = region.offset;
+    data_size = region.size;
+    if (data_size == 0)
+      return false;
+
+    CheckedNumeric<int64_t> region_end(file_offset);
+    region_end += data_size;
+    if (!region_end.IsValid())
+      return false;
+
+    if (access == READ_WRITE_EXTEND) {
+      const bool extended = AllocateFileRegion(&file_, file_offset, data_size);
+      if (!extended)
+        return false;
+    } else if (file_.GetLength() < region_end.ValueOrDie()) {
+      return false;
+    }
+  }
+
+  constexpr size_t granularity = 4096u;
+
+  CheckedNumeric<size_t> allocation_size(data_size);
+  allocation_size += granularity - 1;
+  allocation_size /= granularity;
+  allocation_size *= granularity;
+  if (!allocation_size.IsValid())
+    return false;
+
+  const size_t rounded_size = allocation_size.ValueOrDie();
+  APTR KernelBase = OpenResource("kernel.resource");
+  void* allocation =
+      KernelBase
+          ? KrnAllocPages(nullptr, rounded_size, MEMF_PUBLIC | MEMF_CLEAR)
+          : nullptr;
+  if (allocation && !TypeOfMem(allocation)) {
+    // Hosted KrnAllocPages() is a host mmap outside Exec's MemList.  DOS
+    // validates Read() buffers through TypeOfMem(), so use the tracked Exec
+    // backing below when the page allocation is not visible to Exec.
+    KrnFreePages(allocation, rounded_size);
+    allocation = nullptr;
+  }
+  void* allocation_base = allocation;
+  size_t backing_size = rounded_size;
+  bool uses_kernel_pages = allocation != nullptr;
+
+  if (!allocation) {
+    CheckedNumeric<size_t> exec_allocation_size(rounded_size);
+    exec_allocation_size += granularity - 1;
+    if (!exec_allocation_size.IsValid())
+      return false;
+
+    backing_size = exec_allocation_size.ValueOrDie();
+    allocation_base = AllocMem(backing_size, MEMF_PUBLIC | MEMF_CLEAR);
+    if (!allocation_base)
+      return false;
+
+    const uintptr_t raw_address =
+        reinterpret_cast<uintptr_t>(allocation_base);
+    const uintptr_t aligned_address =
+        (raw_address + granularity - 1) & ~(granularity - 1);
+    allocation = reinterpret_cast<void*>(aligned_address);
+  }
+
+  span<uint8_t> contents(static_cast<uint8_t*>(allocation), data_size);
+  const std::optional<size_t> bytes_read = file_.Read(file_offset, contents);
+  if (!bytes_read || *bytes_read != data_size) {
+    bug("[AROS:MMAP] read failed requested=%llu actual=%lld errno=%d\n",
+        static_cast<unsigned long long>(data_size),
+        bytes_read ? static_cast<long long>(*bytes_read) : -1, errno);
+    if (uses_kernel_pages)
+      KrnFreePages(allocation_base, backing_size);
+    else
+      FreeMem(allocation_base, backing_size);
+    return false;
+  }
+
+  allocation_base_ = allocation_base;
+  allocation_size_ = backing_size;
+  uses_kernel_pages_ = uses_kernel_pages;
+  bytes_ = contents;
+  file_offset_ = file_offset;
+  access_ = access;
+  return true;
+}
+
+bool MemoryMappedFile::Flush(size_t length, bool sync) {
+  if (!IsValid() || access_ == READ_ONLY || access_ == READ_WRITE_COPY)
+    return true;
+
+  const size_t flush_length = std::min(length, bytes_.size());
+  if (!file_.WriteAndCheck(file_offset_,
+                           bytes_.first(flush_length))) {
+    return false;
+  }
+  return !sync || file_.Flush();
+}
+
+void MemoryMappedFile::CloseHandles() {
+  ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  if (allocation_base_) {
+    const bool flushed = Flush(bytes_.size(), true);
+    DPCHECK(flushed);
+
+    if (uses_kernel_pages_) {
+      APTR KernelBase = OpenResource("kernel.resource");
+      DCHECK(KernelBase);
+      if (KernelBase)
+        KrnFreePages(allocation_base_, allocation_size_);
+    } else {
+      FreeMem(allocation_base_, allocation_size_);
+    }
+  }
+
+  allocation_base_ = nullptr;
+  allocation_size_ = 0;
+  uses_kernel_pages_ = false;
+  bytes_ = {};
+  file_offset_ = 0;
+  access_ = READ_ONLY;
+  file_.Close();
+}
+
+}  // namespace base
