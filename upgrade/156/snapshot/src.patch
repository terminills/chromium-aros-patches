+  explicit WidevineDebugScope(const char* stage)
+      : enabled_(WidevineDebugEnabled()), stage_(stage) {
+    if (enabled_) {
+      id_ = next_id_.fetch_add(1, std::memory_order_relaxed);
+      start_ = TimeTicks::Now();
+      LOG(INFO) << "[AROS:Widevine] pid=" << GetCurrentProcId()
+                << " op=" << id_ << " stage=" << stage_ << " begin";
+    }
+  }
+  ~WidevineDebugScope() {
+    if (enabled_) {
+      LOG(INFO) << "[AROS:Widevine] pid=" << GetCurrentProcId()
