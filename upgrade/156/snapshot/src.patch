+        "        pushq %rax",
+        "        pushq %rdi",
+        "        pushq %rsi",
+        "        pushq %rdx",
+        "        pushq %rcx",
+        "        pushq %r8",
+        "        pushq %r9",
+        "        pushq %r10",
+        "        pushq %r11",
+        "        subq $136, %rsp",
+        "        movdqu %xmm0, 0(%rsp)",
+        "        movdqu %xmm1, 16(%rsp)",
+        "        movdqu %xmm2, 32(%rsp)",
+        "        movdqu %xmm3, 48(%rsp)",
+        "        movdqu %xmm4, 64(%rsp)",
+        "        movdqu %xmm5, 80(%rsp)",
+        "        movdqu %xmm6, 96(%rsp)",
+        "        movdqu %xmm7, 112(%rsp)",
+        "        movq 208(%rsp), %rdi",
+        "        call ArosResolveV8Import",
+        "        // Replace the pushed import index with the target. The final",
+        "        // ret is therefore an ABI-transparent tail call.",
+        "        movq %rax, 208(%rsp)",
+        "        movdqu 0(%rsp), %xmm0",
+        "        movdqu 16(%rsp), %xmm1",
+        "        movdqu 32(%rsp), %xmm2",
+        "        movdqu 48(%rsp), %xmm3",
+        "        movdqu 64(%rsp), %xmm4",
+        "        movdqu 80(%rsp), %xmm5",
+        "        movdqu 96(%rsp), %xmm6",
+        "        movdqu 112(%rsp), %xmm7",
+        "        addq $136, %rsp",
+        "        popq %r11",
+        "        popq %r10",
+        "        popq %r9",
+        "        popq %r8",
+        "        popq %rcx",
+        "        popq %rdx",
+        "        popq %rsi",
+        "        popq %rdi",
+        "        popq %rax",
+        "        ret",
+        "        .size ArosV8ImportSlowPath, .-ArosV8ImportSlowPath",
+        "",
+    ]
+
+    for index, symbol in enumerate(symbols):
+        lines.extend(
+            [
+                "        .p2align 4",
+                f"        .globl {symbol}",
+                f"        .type {symbol}, @function",
+                f"{symbol}:",
+                # Chrome's AX and WA LoadSeg hunks may be more than 2 GiB
+                # apart. Materialize the slot address with the large-model
+                # relocation instead of encoding a signed RIP displacement.
+                f"        movabs $g_v8_import_slots+{index * 8}, %r11",
+                "        jmp *(%r11)",
+                f"        .size {symbol}, .-{symbol}",
+                f".Lslow_{index}:",
+                f"        pushq ${index}",
+                "        jmp ArosV8ImportSlowPath",
+                "",
+            ]
+        )
+
+    lines.extend(
+        [
+            "        .section .rodata",
+            "        .p2align 3",
+            "        .globl g_v8_import_count",
+            "        .type g_v8_import_count, @object",
+            "g_v8_import_count:",
+            f"        .quad {len(symbols)}",
+            "        .size g_v8_import_count, 8",
+            "",
+            "        .globl g_v8_import_names",
+            "        .type g_v8_import_names, @object",
+            "g_v8_import_names:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Limport_name_{index}")
+    lines.append(
+        f"        .size g_v8_import_names, {len(symbols) * 8}"
+    )
+    lines.append("")
+    for index, symbol in enumerate(symbols):
+        lines.extend(
+            [
+                f".Limport_name_{index}:",
+                f'        .asciz "{symbol}"',
+            ]
+        )
+
+    for index, (_, value) in enumerate(_DATA_IMPORTS):
+        lines.extend(
+            [
+                f".Ldata_value_{index}:",
+                f'        .asciz "{value}"',
+            ]
+        )
+
+    lines.extend(
+        [
+            "",
+            "        .data",
+            "        .p2align 3",
+            "        .globl g_v8_import_slots",
+            "        .type g_v8_import_slots, @object",
+            "g_v8_import_slots:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Lslow_{index}")
+    lines.append(
+        f"        .size g_v8_import_slots, {len(symbols) * 8}"
+    )
+
+    for index, (symbol, _) in enumerate(_DATA_IMPORTS):
+        lines.extend(
+            [
+                "",
+                "        .p2align 3",
+                f"        .globl {symbol}",
+                f"        .type {symbol}, @object",
+                f"{symbol}:",
+                f"        .quad .Ldata_value_{index}",
+                f"        .size {symbol}, 8",
+            ]
+        )
+
+    lines.extend(
+        [
+            "",
+            '        .section .note.GNU-stack,"",@progbits',
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def _emit_arm64(symbols: list[str]) -> str:
+    # AAPCS64: preserve x0-x7 arguments, x8 indirect-result address, LR and
+    # the full SIMD argument registers. The original stack arguments stay put.
+    lines = [".text", ".p2align 4", ".type ArosV8ImportSlowPath, %function",
+             "ArosV8ImportSlowPath:", "sub sp, sp, #208"]
+    for n in range(0, 8, 2):
+        lines.append(f"stp x{n}, x{n+1}, [sp, #{n*8}]")
+    lines += ["stp x8, x30, [sp, #64]"]
+    for n in range(0, 8, 2):
+        lines.append(f"stp q{n}, q{n+1}, [sp, #{80+n*16}]")
+    lines += ["mov x0, x17", "ldr x16, .Lresolver", "blr x16", "mov x16, x0"]
+    for n in range(0, 8, 2):
+        lines.append(f"ldp q{n}, q{n+1}, [sp, #{80+n*16}]")
+    lines += ["ldp x8, x30, [sp, #64]"]
+    for n in range(0, 8, 2):
+        lines.append(f"ldp x{n}, x{n+1}, [sp, #{n*8}]")
+    lines += ["add sp, sp, #208", "br x16", ".p2align 3",
+              ".Lresolver: .quad ArosResolveV8Import"]
+    for index, symbol in enumerate(symbols):
+        lines += [".p2align 4", f".globl {symbol}", f".type {symbol}, %function",
+                  f"{symbol}:", f"ldr x16, .Lslot_{index}", "ldr x16, [x16]",
+                  "br x16", f".size {symbol}, .-{symbol}", ".p2align 3",
+                  f".Lslot_{index}: .quad g_v8_import_slots+{index*8}",
+                  f".Lslow_{index}:", f"mov x17, #{index}",
+                  "b ArosV8ImportSlowPath"]
+    # Pointer tables and string/data exports have the same 64-bit layout.
+    data = _emit(symbols).split("        .section .rodata", 1)[1]
+    return "\n".join(lines) + "\n.section .rodata" + data.replace("@object", "%object").replace("@progbits", "%progbits")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--manifest", required=True, type=pathlib.Path)
+    parser.add_argument("--output", required=True, type=pathlib.Path)
+    parser.add_argument("--cpu", choices=("x64", "arm64"), default="x64")
+    args = parser.parse_args()
+
+    symbols = _read_manifest(args.manifest)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        _emit_arm64(symbols) if args.cpu == "arm64" else _emit(symbols),
+        encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
