+      # kernels must be able to select SVE/dot-product without changing the
+      # minimum CPU required by the rest of the engine.
+      cc += " -march=armv8-a+crc+simd"
+      cxx += " -march=armv8-a+crc+simd"
+    }
+    ar = "${_toolprefix}ar"
+    ld = cxx
+    readelf = "${_toolprefix}readelf"
+    nm = "${_toolprefix}nm"
+
+    extra_cppflags =
+        _arch_flags +
+        " -fno-asynchronous-unwind-tables -fno-omit-frame-pointer" +
+        _sysroot_flag
