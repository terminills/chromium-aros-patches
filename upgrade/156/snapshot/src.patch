+namespace base {
+std::optional<TimeDelta> PlatformThreadMetrics::GetCumulativeCPUUsage() {
+  APTR TaskResBase = OpenResource("task.resource");
+  if (!TaskResBase)
+    return std::nullopt;
+  TaskList* list = LockTaskList(LTF_ALL);
+  if (!list)
+    return std::nullopt;
+  std::optional<TimeDelta> result;
+  while (Task* task = NextTaskEntry(list, LTF_ALL)) {
+    if (reinterpret_cast<intptr_t>(task) != tid_.raw())
+      continue;
+    if (GetETask(task)) {
+      timeval used{};
+      TagItem tags[] = {
+          {TaskTag_CPUTime, reinterpret_cast<IPTR>(&used)}, {TAG_DONE, 0}};
+      QueryTaskTagList(task, tags);
+      result = Seconds(used.tv_secs) + Microseconds(used.tv_micro);
+    }
+    break;
+  }
+  UnLockTaskList(list, LTF_ALL);
+  return result;
+}
+}  // namespace base
