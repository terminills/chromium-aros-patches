+
+// hostlib.resource only exists on hosted AROS; its base is looked up at run
+// time, so keep the SDK from declaring a global one.
+#define __HOSTLIB_NOLIBBASE__
+#define __HOSTLIB_LIBBASE HostLibBase
+#include <proto/hostlib.h>
+
+// The in-process Linux ET_DYN loader (compiler/linuxso in the AROS tree):
+// maps the object into exec memory and resolves it against a glibc-ABI
+// shim, so a Linux shared object such as the Widevine CDM runs on native
+// AROS where there is no host dynamic linker.
+#if defined(ARCH_CPU_X86_64)
+#include <linuxso.h>
+#endif
+
+namespace base {
+
+namespace {
+
+enum class ArosNativeLibraryKind {
+  kExecLibrary,
+  kLoadSegModule,
+  // A host (Linux) shared object opened through hostlib.resource.  Only
+  // hosted AROS can load these; they run on the host's libc, not AROS's.
+  kHostSharedObject,
+  // A Linux shared object mapped by linuxso and run against its glibc shim
+  // on AROS's own libc.  The path taken on native AROS; hosted AROS takes it
+  // too when AROS_LINUXSO is set, which makes the native loader debuggable
+  // where a debugger can be attached.
+  kLinuxSharedObject,
+};
+
+struct ArosNativeLibrary {
+  ArosNativeLibraryKind kind;
+  std::string name;
+  void* handle;
+  bool module_startup_ran = false;
+};
+
+struct SymbolLookupData {
+  const ArosNativeLibrary* library;
+  const char* symbol_name;
+  void* result;
+};
+
+AROS_UFH3S(IPTR,
+           SymbolLookupHook,
+           AROS_UFHA(struct Hook*, hook, A0),
+           AROS_UFHA(APTR, object, A2),
+           AROS_UFHA(APTR, message, A1)) {
+  AROS_USERFUNC_INIT
+
+  (void)object;
+  auto* data = static_cast<SymbolLookupData*>(hook->h_Data);
+  auto* symbol = static_cast<struct SymbolInfo*>(message);
+  if (!data || data->result || !symbol || !symbol->si_SymbolName) {
+    return 0;
+  }
+
+  if (strcmp(symbol->si_SymbolName, data->symbol_name) == 0) {
+    if (!data->library->name.empty() && symbol->si_ModuleName &&
+        strstr(symbol->si_ModuleName, data->library->name.c_str()) == nullptr) {
+      return 0;
+    }
+
+    data->result = symbol->si_SymbolStart;
+  }
+
+  return 0;
+
+  AROS_USERFUNC_EXIT
+}
+
+// An AROS loadable module is a relocatable ELF object that LoadSeg links in
+// place; a host shared object is a linked ET_DYN image that only the host's
+// dynamic linker can map.  Both carry the .so suffix, so tell them apart by
+// the ELF header.
+enum class ElfObjectType { kUnreadable, kRelocatable, kDynamic, kOther };
+
+ElfObjectType ClassifyElfObject(const FilePath& library_path) {
+  BPTR file = Open(library_path.value().c_str(), MODE_OLDFILE);
+  if (!file)
+    return ElfObjectType::kUnreadable;
+
+  uint8_t header[18] = {};
+  const LONG got = Read(file, header, sizeof(header));
+  Close(file);
+  if (got != static_cast<LONG>(sizeof(header)))
+    return ElfObjectType::kUnreadable;
+
+  if (memcmp(header, "\177ELF", 4) != 0)
+    return ElfObjectType::kOther;
+
+  // e_type is a little-endian half at offset 16 on every AROS target.
+  const uint16_t type = header[16] | (header[17] << 8);
+  switch (type) {
+    case 1:
+      return ElfObjectType::kRelocatable;
+    case 3:
+      return ElfObjectType::kDynamic;
+    default:
+      return ElfObjectType::kOther;
+  }
+}
+
+bool IsArosLoadableModulePath(const FilePath& library_path) {
+  return EndsWith(library_path.value(), ".so", CompareCase::SENSITIVE);
+}
+
+// Translate an AROS path on the boot volume into the host path that the host
+// dynamic linker needs.  Hosted AROS mounts its root volume on the
+// bootstrap's working directory (emul.handler's new_volume() takes
+// GetCurrentDir() for the root), so a path on that volume is the host cwd
+// plus the volume-relative part.  Files on other volumes have no host name
+// this code can learn, and they are not where Chromium stages a CDM.
+bool HostPathForArosPath(APTR HostLibBase,
+                         const std::string& aros_path,
+                         std::string* host_path,
+                         std::string* failure) {
+  char absolute[1024] = {};
+  {
+    BPTR lock = Lock(aros_path.c_str(), SHARED_LOCK);
+    if (!lock) {
+      *failure = StrCat({"Lock failed: ", aros_path});
+      return false;
+    }
+    const BOOL named = NameFromLock(lock, absolute, sizeof(absolute));
+    UnLock(lock);
+    if (!named) {
+      *failure = StrCat({"NameFromLock failed: ", aros_path});
+      return false;
+    }
+  }
+
+  char boot_volume[256] = {};
+  {
+    BPTR lock = Lock("SYS:", SHARED_LOCK);
+    if (!lock) {
+      *failure = "Lock SYS: failed";
+      return false;
+    }
+    const BOOL named = NameFromLock(lock, boot_volume, sizeof(boot_volume));
+    UnLock(lock);
+    if (!named) {
+      *failure = "NameFromLock SYS: failed";
+      return false;
+    }
+  }
+
+  const char* colon = strchr(absolute, ':');
+  const size_t volume_length = colon ? static_cast<size_t>(colon - absolute) + 1
+                                     : 0;
+  // Volume names compare case-insensitively, like every DOS name.
+  if (!colon || CompareCaseInsensitiveASCII(
+                    std::string_view(absolute, volume_length), boot_volume) != 0) {
+    *failure = StrCat({"not on the boot volume: ", absolute});
+    return false;
+  }
+
+  char* error = nullptr;
+  void* libc = HostLib_Open("libc.so.6", &error);
+  if (!libc) {
+    *failure = StrCat({"HostLib_Open libc failed: ", error ? error : "?"});
+    if (error)
+      HostLib_FreeErrorStr(error);
+    return false;
+  }
+  auto* host_getcwd = reinterpret_cast<char* (*)(char*, size_t)>(
+      HostLib_GetPointer(libc, "getcwd", &error));
+  if (!host_getcwd) {
+    *failure =
+        StrCat({"HostLib_GetPointer getcwd failed: ", error ? error : "?"});
+    if (error)
+      HostLib_FreeErrorStr(error);
+    HostLib_Close(libc, nullptr);
+    return false;
+  }
+
+  char cwd[1024] = {};
+  HostLib_Lock();
+  char* got = host_getcwd(cwd, sizeof(cwd));
+  HostLib_Unlock();
+  HostLib_Close(libc, nullptr);
+  if (!got) {
+    *failure = "host getcwd failed";
+    return false;
+  }
+
+  *host_path = StrCat({cwd, "/", absolute + volume_length});
+  return true;
+}
+
+NativeLibrary WrapArosLibrary(ArosNativeLibraryKind kind,
+                              std::string name,
+                              void* handle) {
+  if (!handle) {
+    return nullptr;
+  }
+
+  auto* library = new ArosNativeLibrary;
+  library->kind = kind;
+  library->name = std::move(name);
+  library->handle = handle;
+  return library;
+}
+
+void* LookupLoadSegSymbol(const ArosNativeLibrary* library, const char* name) {
+  if (!library || !name)
+    return nullptr;
+
+  struct Library* debug_base = OpenLibrary("debug.library", 0);
+  if (!debug_base)
+    return nullptr;
+
+  SymbolLookupData data = {library, name, nullptr};
+  struct Hook hook = {};
+  hook.h_Entry = reinterpret_cast<APTR>(SymbolLookupHook);
+  hook.h_Data = &data;
+
+  EnumerateSymbolsA(&hook, nullptr);
+  CloseLibrary(debug_base);
+  return data.result;
+}
+
+using ArosOpenLibrariesListFunc =
+    int (*)(const void* const list[], struct ExecBase* sys_base);
+using ArosCloseLibrariesListFunc =
+    void (*)(const void* const list[], struct ExecBase* sys_base);
+using ArosSetCallFuncsFunc = int (*)(const void* const set[],
+                                     int direction,
+                                     int test_fail,
+                                     struct ExecBase* sys_base);
+
+bool RunLoadSegModuleStartup(ArosNativeLibrary* library,
+                             NativeLibraryLoadError* error) {
+  auto* open_libraries = reinterpret_cast<ArosOpenLibrariesListFunc>(
+      LookupLoadSegSymbol(library, "_set_open_libraries_list"));
+  auto* call_funcs = reinterpret_cast<ArosSetCallFuncsFunc>(
+      LookupLoadSegSymbol(library, "_set_call_funcs"));
+  auto* libs = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__LIBS_LIST__"));
+  auto* init = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__INIT_LIST__"));
+  auto* ctors = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__CTORS_LIST__"));
+  auto* init_array = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__INIT_ARRAY_LIST__"));
+
+  LOG(INFO) << "[Chromium:AROS:NativeLibrary] module startup symbols module="
+            << library->name << " open_libraries="
+            << reinterpret_cast<void*>(open_libraries) << " call_funcs="
+            << reinterpret_cast<void*>(call_funcs) << " libs=" << libs
+            << " init=" << init << " ctors=" << ctors
+            << " init_array=" << init_array;
+
+  if (!open_libraries || !call_funcs || !libs) {
+    if (error) {
+      error->message =
+          StrCat({"AROS module startup symbols missing: ", library->name});
+    }
+    return false;
+  }
+
+  if (!open_libraries(libs, SysBase)) {
+    if (error) {
+      error->message =
+          StrCat({"AROS module failed to open libraries: ", library->name});
+    }
+    return false;
+  }
+
+  library->module_startup_ran = true;
+
+  if (init && !call_funcs(init, 1, 1, SysBase)) {
+    if (error)
+      error->message = StrCat({"AROS module INIT failed: ", library->name});
+    return false;
+  }
+
+  if (ctors)
+    call_funcs(ctors, -1, 0, SysBase);
+  if (init_array)
+    call_funcs(init_array, 1, 0, SysBase);
+
+  LOG(INFO) << "[Chromium:AROS:NativeLibrary] module startup complete module="
+            << library->name;
+  return true;
+}
+
+void RunLoadSegModuleShutdown(ArosNativeLibrary* library) {
+  if (!library || !library->module_startup_ran)
+    return;
+
+  auto* close_libraries = reinterpret_cast<ArosCloseLibrariesListFunc>(
+      LookupLoadSegSymbol(library, "_set_close_libraries_list"));
+  auto* call_funcs = reinterpret_cast<ArosSetCallFuncsFunc>(
+      LookupLoadSegSymbol(library, "_set_call_funcs"));
+  auto* fini_array = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__FINI_ARRAY_LIST__"));
+  auto* dtors = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__DTORS_LIST__"));
+  auto* exit = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__EXIT_LIST__"));
+  auto* libs = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__LIBS_LIST__"));
+
+  if (call_funcs) {
+    if (fini_array)
+      call_funcs(fini_array, -1, 0, SysBase);
+    if (dtors)
+      call_funcs(dtors, 1, 0, SysBase);
+    if (exit)
+      call_funcs(exit, -1, 0, SysBase);
+  }
+
+  if (close_libraries && libs)
+    close_libraries(libs, SysBase);
+
+  library->module_startup_ran = false;
+}
+
+}  // namespace
+
+std::string NativeLibraryLoadError::ToString() const {
+  return message;
+}
+
+NativeLibrary LoadNativeLibrary(const FilePath& library_path,
+                                NativeLibraryLoadError* error) {
+  return LoadNativeLibraryWithOptions(library_path, NativeLibraryOptions(), error);
+}
+
+NativeLibrary LoadNativeLibraryWithOptions(const FilePath& library_path,
+                                           const NativeLibraryOptions& options,
+                                           NativeLibraryLoadError* error) {
+  aros::WidevineDebugScope trace("native.load");
+  (void)options;
+  ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  const bool module = IsArosLoadableModulePath(library_path);
+  const auto elf_type = module ? ClassifyElfObject(library_path)
+                               : ElfObjectType::kOther;
+  trace.Value("elf_type", static_cast<int>(elf_type));
+  if (module && elf_type == ElfObjectType::kDynamic) {
+    APTR HostLibBase = OpenResource("hostlib.resource");
+    trace.Value("host_loader_available", HostLibBase != nullptr);
+    if (!HostLibBase || getenv("AROS_LINUXSO")) {
+      aros::WidevineDebugScope loader_trace("native.linuxso.open");
+#if defined(ARCH_CPU_X86_64)
+      char reason[512] = {};
+      struct LinuxSO* so =
+          linuxso_open(library_path.value().c_str(), reason, sizeof(reason));
+      loader_trace.Value("success", so != nullptr);
+      if (!so) {
+        if (error) {
+          error->message =
+              StrCat({"linuxso_open failed: ", library_path.value(), ": ",
+                      reason});
+        }
+        LOG(ERROR) << "[Chromium:AROS:NativeLibrary] linux shared object "
+                      "failed path="
+                   << library_path.value() << " error=" << reason;
+        return nullptr;
+      }
+
+      LOG(INFO) << "[Chromium:AROS:NativeLibrary] linux shared object loaded "
+                   "path="
+                << library_path.value() << " loader=linuxso";
+      return WrapArosLibrary(ArosNativeLibraryKind::kLinuxSharedObject,
+                             library_path.BaseName().value(), so);
+#else
+      // The SDK Linux ET_DYN mapper currently implements the x86-64 ABI only.
+      // Native AROS modules and hosted hostlib loading remain available.
+      loader_trace.Value("architecture_supported", false);
+      if (error)
+        error->message = "Linux ET_DYN loader is unavailable for this AROS CPU";
+      LOG(ERROR) << "[Chromium:AROS:NativeLibrary] Linux ET_DYN architecture "
+                    "unsupported by the SDK loader";
+      return nullptr;
+#endif
+    }
+
+    std::string host_path;
+    std::string failure;
+    if (!HostPathForArosPath(HostLibBase, library_path.value(), &host_path,
+                             &failure)) {
+      if (error)
+        error->message = failure;
+      LOG(ERROR) << "[Chromium:AROS:NativeLibrary] host path unresolved path="
+                 << library_path.value() << " reason=" << failure;
+      return nullptr;
+    }
+
+    char* host_error = nullptr;
+    aros::WidevineDebugScope loader_trace("native.hostlib.open");
+    void* handle = HostLib_Open(host_path.c_str(), &host_error);
+    loader_trace.Value("success", handle != nullptr);
+    if (!handle) {
+      if (error) {
+        error->message = StrCat({"HostLib_Open failed: ", host_path, ": ",
+                                 host_error ? host_error : "?"});
+      }
+      LOG(ERROR) << "[Chromium:AROS:NativeLibrary] host shared object failed "
+                    "path="
+                 << host_path << " error=" << (host_error ? host_error : "?");
+      if (host_error)
+        HostLib_FreeErrorStr(host_error);
+      return nullptr;
+    }
+
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] host shared object loaded path="
+              << library_path.value() << " host=" << host_path;
+    return WrapArosLibrary(ArosNativeLibraryKind::kHostSharedObject,
+                           library_path.BaseName().value(), handle);
+  }
+
+  if (IsArosLoadableModulePath(library_path)) {
+    aros::WidevineDebugScope loader_trace("native.loadseg.open");
+    BPTR segment = LoadSeg(library_path.value().c_str());
+    loader_trace.Value("success", segment != 0);
+    if (!segment) {
+      if (error)
+        error->message = StrCat({"LoadSeg failed: ", library_path.value()});
+      return nullptr;
+    }
+
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] LoadSeg module loaded path="
+              << library_path.value();
+    NativeLibrary library = WrapArosLibrary(ArosNativeLibraryKind::kLoadSegModule,
+                                            library_path.BaseName().value(),
+                                            reinterpret_cast<void*>(segment));
+    if (!RunLoadSegModuleStartup(static_cast<ArosNativeLibrary*>(library),
+                                 error)) {
+      UnLoadSeg(segment);
+      delete static_cast<ArosNativeLibrary*>(library);
+      return nullptr;
+    }
+
+    return library;
+  }
+
+  struct Library* library = OpenLibrary(library_path.value().c_str(), 0);
+  if (!library) {
+    if (error)
+      error->message = StrCat({"OpenLibrary failed: ", library_path.value()});
+    return nullptr;
+  }
+
+  return WrapArosLibrary(ArosNativeLibraryKind::kExecLibrary,
+                         library_path.BaseName().value(), library);
+}
+
+void UnloadNativeLibrary(NativeLibrary library) {
+  aros::WidevineDebugScope trace("native.unload");
+  auto* aros_library = static_cast<ArosNativeLibrary*>(library);
+  if (!aros_library)
+    return;
+
+  if (aros_library->kind == ArosNativeLibraryKind::kHostSharedObject) {
+    APTR HostLibBase = OpenResource("hostlib.resource");
+    if (HostLibBase)
+      HostLib_Close(aros_library->handle, nullptr);
+  } else if (aros_library->kind == ArosNativeLibraryKind::kLinuxSharedObject) {
+#if defined(ARCH_CPU_X86_64)
+    linuxso_close(static_cast<struct LinuxSO*>(aros_library->handle));
+#endif
+  } else if (aros_library->kind == ArosNativeLibraryKind::kLoadSegModule) {
+    RunLoadSegModuleShutdown(aros_library);
+    UnLoadSeg(reinterpret_cast<BPTR>(aros_library->handle));
+  } else {
+    CloseLibrary(static_cast<struct Library*>(aros_library->handle));
+  }
+
+  delete aros_library;
+}
+
+void* GetFunctionPointerFromNativeLibrary(NativeLibrary library,
+                                          const char* name) {
+  aros::WidevineDebugScope trace("native.symbol");
+  auto* aros_library = static_cast<ArosNativeLibrary*>(library);
+  if (!aros_library || !name)
+    return nullptr;
+
+  if (aros_library->kind == ArosNativeLibraryKind::kHostSharedObject) {
+    APTR HostLibBase = OpenResource("hostlib.resource");
+    if (!HostLibBase)
+      return nullptr;
+    char* host_error = nullptr;
+    void* result = HostLib_GetPointer(aros_library->handle, name, &host_error);
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] host symbol lookup module="
+              << aros_library->name << " name=" << name << " result=" << result;
+    if (host_error)
+      HostLib_FreeErrorStr(host_error);
+    trace.Value("resolved", result != nullptr);
+    return result;
+  }
+
+  if (aros_library->kind == ArosNativeLibraryKind::kLinuxSharedObject) {
+#if defined(ARCH_CPU_X86_64)
+    void* result =
+        linuxso_sym(static_cast<struct LinuxSO*>(aros_library->handle), name);
+#else
+    void* result = nullptr;
+#endif
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] linuxso symbol lookup module="
+              << aros_library->name << " name=" << name << " result=" << result;
+    trace.Value("resolved", result != nullptr);
+    return result;
+  }
+
+  if (aros_library->kind == ArosNativeLibraryKind::kLoadSegModule) {
+    void* result = LookupLoadSegSymbol(aros_library, name);
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] symbol lookup module="
+              << aros_library->name << " name=" << name
+              << " result=" << result;
+    trace.Value("resolved", result != nullptr);
+    return result;
+  }
+
+  // Exec libraries export versioned vectors, not a dlsym-style name table.
+  return nullptr;
+}
+
+std::string GetNativeLibraryName(std::string_view name) {
+  DCHECK(IsStringASCII(name));
+  return StrCat({name, ".library"});
+}
+
+std::string GetLoadableModuleName(std::string_view name) {
+  // Loadable modules are what the toolchain's loadable_module() rule emits:
+  // lib<name>.so, loaded with LoadSeg (or, for a host build, hostlib).
+  DCHECK(IsStringASCII(name));
+  return StrCat({"lib", name, ".so"});
+}
+
+}  // namespace base
