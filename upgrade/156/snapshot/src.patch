+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+
+struct MsgPort;
+struct Window;
+
+namespace ui {
+
+class ArosWindow;
+
+class ArosWindowManager {
+ public:
+  ArosWindowManager();
+
+  ArosWindowManager(const ArosWindowManager&) = delete;
+  ArosWindowManager& operator=(const ArosWindowManager&) = delete;
+
+  ~ArosWindowManager();
+
+  gfx::AcceleratedWidget AddWindow(ArosWindow* window);
+  void RemoveWindow(gfx::AcceleratedWidget widget, ArosWindow* window);
+
+  void AttachNativeWindow(gfx::AcceleratedWidget widget,
+                          ArosWindow* window,
+                          struct Window* native_window);
+  void DetachNativeWindow(gfx::AcceleratedWidget widget,
+                          ArosWindow* window,
+                          struct Window* native_window);
+
+  struct MsgPort* event_port() const { return event_port_; }
+  uint32_t event_signal_mask() const;
+  void ProcessNativeEvents();
+  void ReleaseNativeResources();
+
+  struct Window* GetNativeWindow(gfx::AcceleratedWidget widget);
+  ArosWindow* GetWindow(gfx::AcceleratedWidget widget);
+  ArosWindow* GetWindowForNative(struct Window* native_window);
+  // The ArosWindow owning Intuition's currently active window, if it is
+  // one of ours.
+  ArosWindow* GetIntuitionActiveWindow();
+
+  // ActivateWindow() is asynchronous (Intuition's input task performs it),
+  // so IntuitionBase->ActiveWindow lags our requests.  The widget whose
+  // activation was requested last and has not been seen active yet;
+  // kNullAcceleratedWidget when nothing is in flight.
+  void SetRequestedActivation(gfx::AcceleratedWidget widget);
+  void ClearRequestedActivation();
+  gfx::AcceleratedWidget requested_activation() const;
+
+  // The window holding mouse capture (a menu host while a menu is open).
+  // Intuition delivers mouse events to the window under the pointer, so an
+  // ArosWindow that receives one while another window has capture reroutes
+  // it there (ArosWindow::DispatchMouseButton and friends); that is how a
+  // click outside a menu reaches MenuController and closes it.  At most one
+  // window has capture: taking it releases the previous holder.
+  void SetCaptureWindow(ArosWindow* window);
+  void ClearCaptureWindow(ArosWindow* window);
+  ArosWindow* capture_window() const { return capture_window_; }
+
+#if BUILDFLAG(ENABLE_VULKAN)
+  // Create on the window-owning process while the window is still attached.
+  // AROS Vulkan dispatch uses plain stack-call pointers across native tasks.
+  VkResult CreateVulkanSurface(gfx::AcceleratedWidget widget,
+                               VkInstance instance,
+                               PFN_vkCreateAROSSurfaceAROS create_surface,
+                               VkSurfaceKHR* surface);
+#endif
+
+  bool PresentCanvas(gfx::AcceleratedWidget widget,
+                     const void* pixels,
+                     size_t row_bytes,
+                     const gfx::Size& pixel_size,
+                     const gfx::Rect& damage);
+
+  // PresentCanvas() draws into a window's Intuition window under this lock;
+  // a window that replaces its Intuition window at runtime swaps it under it.
+  base::Lock& presentation_lock() LOCK_RETURNED(lock_) { return lock_; }
+
+ private:
+  base::Lock lock_;
+  gfx::AcceleratedWidget next_widget_ GUARDED_BY(lock_) = 1;
+  std::map<gfx::AcceleratedWidget, raw_ptr<ArosWindow>> windows_
+      GUARDED_BY(lock_);
+  std::map<struct Window*, raw_ptr<ArosWindow>> native_windows_
+      GUARDED_BY(lock_);
+  RAW_PTR_EXCLUSION struct MsgPort* event_port_ = nullptr;
+  RAW_PTR_EXCLUSION struct MsgPort* presentation_port_ = nullptr;
+  RAW_PTR_EXCLUSION struct MsgPort* presentation_reply_port_ = nullptr;
+  base::MessagePumpForUI::PortWatchController presentation_watch_;
+  bool owns_presentation_port_ = false;
+  bool native_resources_released_ = false;
+  gfx::AcceleratedWidget requested_activation_ = gfx::kNullAcceleratedWidget;
+  raw_ptr<ArosWindow> capture_window_ = nullptr;
+  bool logged_received_present_ GUARDED_BY(lock_) = false;
+  bool logged_waiting_present_reply_ GUARDED_BY(lock_) = false;
+  bool logged_forwarded_present_ GUARDED_BY(lock_) = false;
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_AROS_AROS_WINDOW_MANAGER_H_
