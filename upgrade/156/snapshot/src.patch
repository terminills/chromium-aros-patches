new file mode 100644
index 0000000000000000000000000000000000000000..9cf4d791f09a36547f8eacee778a66fa3ba1b9a5
--- /dev/null
+++ b/chrome/browser/notifications/notification_platform_bridge_aros.cc
@@ -0,0 +1,189 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/notifications/notification_platform_bridge.h"
+
+#include <map>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/current_thread.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/notifications/notification_display_service_impl.h"
+#include "chrome/common/notifications/notification_operation.h"
+#include "ui/message_center/public/cpp/notification.h"
+#include "url/origin.h"
+
+#include <exec/libraries.h>
+#include <libraries/application.h>
+#include <proto/exec.h>
+// Resolve the optional library from this bridge, never a shared engine global.
+#define __APPLICATION_LIBBASE (library_)
+#define __aros_getbase_ApplicationBase() (library_)
+#include <proto/application.h>
+
+namespace {
+
+class NotificationPlatformBridgeAros final : public NotificationPlatformBridge {
+ public:
+  NotificationPlatformBridgeAros() {
+    if (!base::CurrentUIThread::IsSet()) return;
+    library_ = OpenLibrary("application.library", 1);
+    if (!library_) return;
+    TagItem registration[] = {
+        {REGAPP_URLIdentifier, reinterpret_cast<IPTR>("org.chromium.browser")},
+        {REGAPP_NoIcon, TRUE}, {TAG_DONE, 0}};
+    app_id_ = RegisterApplicationA("Chromium", registration);
+    if (!app_id_) return;
+    TagItem attributes[] = {
+        {APPATTR_Port, reinterpret_cast<IPTR>(&port_)}, {TAG_DONE, 0}};
+    if (!GetApplicationAttrsA(app_id_, attributes) || !port_) return;
+    ready_ = base::CurrentUIThread::Get()->WatchMessagePort(
+        port_, &watch_,
+        base::BindRepeating(&NotificationPlatformBridgeAros::DrainMessages,
+                            weak_factory_.GetWeakPtr()));
+  }
+
+  ~NotificationPlatformBridgeAros() override {
+    weak_factory_.InvalidateWeakPtrs();
+    watch_.StopWatching();
+    for (const auto& [token, entry] : entries_) Withdraw(token);
+    if (app_id_) UnregisterApplicationA(app_id_, nullptr);
+    if (library_) CloseLibrary(library_);
+  }
+
+  void Display(NotificationHandler::Type type, Profile* profile,
+               const message_center::Notification& notification,
+               std::unique_ptr<NotificationCommon::Metadata> metadata) override {
+    Close(profile, notification.id());
+    if (!ready_) return;
+    const std::string token = "cef:" + base::UnguessableToken::Create().ToString();
+    const std::string title = base::UTF16ToUTF8(notification.title());
+    const std::string body = url::Origin::Create(notification.origin_url()).Serialize() +
+        "\n" + base::UTF16ToUTF8(notification.message());
+    TagItem tags[] = {
+        {APPNOTIFY_Title, reinterpret_cast<IPTR>(title.c_str())},
+        {APPNOTIFY_Text, reinterpret_cast<IPTR>(body.c_str())},
+        {APPNOTIFY_BackMsg, reinterpret_cast<IPTR>(token.c_str())},
+        {APPNOTIFY_ConfirmClose, TRUE}, {APPNOTIFY_CloseOnDC, TRUE},
+        {TAG_DONE, 0}};
+    // The OS copies the strings before returning. Opaque BackMsg tokens cannot
+    // invoke the server's special URL: command path.
+    const ULONG result = NotifyA(app_id_, tags);
+    if (result != APPNOTIFY_OK_MSGQUEUED) {
+      LOG(WARNING) << "Native AROS notification rejected: " << result;
+      return;
+    }
+    entries_.emplace(token, Entry{profile, type, notification.id(),
+                                  notification.origin_url()});
+  }
+
+  void Close(Profile* profile, const std::string& id) override {
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      if (it->second.profile == profile && it->second.id == id) {
+        const std::string token = it->first;
+        it = entries_.erase(it);
+        Withdraw(token);
+      } else {
+        ++it;
+      }
+    }
+  }
+
+  void GetDisplayed(Profile*, GetDisplayedNotificationsCallback callback)
+      const override {
+    // application.library has no query for what the server still displays.
+    // Do not claim synchronization based only on our local token table.
+    std::move(callback).Run({}, false);
+  }
+
+  void GetDisplayedForOrigin(Profile*, const GURL&,
+                             GetDisplayedNotificationsCallback callback)
+      const override {
+    std::move(callback).Run({}, false);
+  }
+
+  void SetReadyCallback(NotificationBridgeReadyCallback callback) override {
+    std::move(callback).Run(ready_);
+  }
+
+  void DisplayServiceShutDown(Profile* profile) override {
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      if (it->second.profile == profile) {
+        const std::string token = it->first;
+        it = entries_.erase(it);
+        Withdraw(token);
+      } else {
+        ++it;
+      }
+    }
+  }
+
+ private:
+  struct Entry {
+    raw_ptr<Profile> profile;
+    NotificationHandler::Type type;
+    std::string id;
+    GURL origin;
+  };
+
+  void Withdraw(const std::string& token) {
+    TagItem tags[] = {
+        {APPNOTIFY_Withdraw, reinterpret_cast<IPTR>(token.c_str())}, {TAG_DONE, 0}};
+    NotifyA(app_id_, tags);
+  }
+
+  void DrainMessages() {
+    auto alive = weak_factory_.GetWeakPtr();
+    while (auto* message = reinterpret_cast<ApplicationMsg*>(GetMsg(port_))) {
+      const ULONG type = message->type;
+      std::string token;
+      if (type == APPLIBMT_CustomMsg || type == APPLIBMT_ConfirmClose) {
+        const char* text = reinterpret_cast<ApplicationCustomMsg*>(message)->customMsg;
+        if (text) token = text;
+      }
+      ReplyMsg(&message->msg);
+      const auto found = entries_.find(token);
+      if (found == entries_.end()) continue;
+      const Entry entry = found->second;
+      const bool closed = type == APPLIBMT_ConfirmClose;
+      if (closed) entries_.erase(found);
+      auto* service = NotificationDisplayServiceImpl::GetForProfile(entry.profile);
+      if (service) {
+        // The native close message does not distinguish timeout from a user
+        // dismissal. Conservatively report false: do not manufacture user intent.
+        service->ProcessNotificationOperation(
+            closed ? NotificationOperation::kClose : NotificationOperation::kClick,
+            entry.type, entry.origin, entry.id, std::nullopt, std::nullopt,
+            closed ? std::optional<bool>(false) : std::nullopt,
+            std::nullopt, base::DoNothing());
+      }
+      if (!alive) return;
+    }
+  }
+
+  RAW_PTR_EXCLUSION Library* library_ = nullptr;
+  RAW_PTR_EXCLUSION MsgPort* port_ = nullptr;
+  ULONG app_id_ = 0;
+  bool ready_ = false;
+  std::map<std::string, Entry> entries_;
+  base::MessagePumpForUI::PortWatchController watch_;
+  base::WeakPtrFactory<NotificationPlatformBridgeAros> weak_factory_{this};
+};
+}  // namespace
+
+std::unique_ptr<NotificationPlatformBridge> NotificationPlatformBridge::Create() {
+  return std::make_unique<NotificationPlatformBridgeAros>();
+}
+
+bool NotificationPlatformBridge::CanHandleType(NotificationHandler::Type type) {
+  return type == NotificationHandler::Type::WEB_PERSISTENT ||
+         type == NotificationHandler::Type::WEB_NON_PERSISTENT;
+}
