+namespace ui {
+
+VulkanImplementationAros::VulkanImplementationAros(
+    ArosWindowManager* window_manager)
+    : gpu::VulkanImplementation(/*use_swiftshader=*/false,
+                                /*allow_protected_memory=*/false,
+                                /*force_native=*/true),
+      window_manager_(window_manager) {}
+
+VulkanImplementationAros::~VulkanImplementationAros() = default;
+
+bool VulkanImplementationAros::InitializeVulkanInstance(bool using_surface) {
+  std::vector<const char*> extensions;
+  if (using_surface) {
+    extensions = {VK_KHR_SURFACE_EXTENSION_NAME, VK_AROS_SURFACE_EXTENSION_NAME};
+  }
+  using_surface_ = using_surface;
+  // VulkanInstance binds libvulkan.a on AROS; it does not dlopen this name.
+  return instance_.Initialize(base::FilePath("vulkan.library"), extensions, {});
+}
+
+gpu::VulkanInstance* VulkanImplementationAros::GetVulkanInstance() {
+  return &instance_;
+}
+
+std::unique_ptr<gpu::VulkanSurface>
+VulkanImplementationAros::CreateViewSurface(gfx::AcceleratedWidget window) {
+  if (!using_surface_ || !instance_.vk_instance()) {
+    return nullptr;
+  }
+  auto create_surface = reinterpret_cast<PFN_vkCreateAROSSurfaceAROS>(
+      gpu::GetVulkanFunctionPointers()->vkGetInstanceProcAddr(
+          instance_.vk_instance(), "vkCreateAROSSurfaceAROS"));
+  if (!create_surface) {
+    LOG(ERROR) << "Vulkan AROS surface extension has no entry point";
+    return nullptr;
+  }
+  VkSurfaceKHR surface = VK_NULL_HANDLE;
+  VkResult result = window_manager_->CreateVulkanSurface(
+      window, instance_.vk_instance(), create_surface, &surface);
+  if (result != VK_SUCCESS) {
+    LOG(ERROR) << "Vulkan AROS surface creation failed: " << result;
+    return nullptr;
+  }
+  return std::make_unique<gpu::VulkanSurface>(instance_.vk_instance(), window,
+                                             surface);
+}
+
+bool VulkanImplementationAros::GetPhysicalDevicePresentationSupport(
+    VkPhysicalDevice device,
+    const std::vector<VkQueueFamilyProperties>& properties,
+    uint32_t queue_family_index) {
+  // VulkanSurface::Initialize checks support against the actual surface.
+  // AROS has no separate platform presentation-support query.
+  return queue_family_index < properties.size() &&
+         (properties[queue_family_index].queueFlags & VK_QUEUE_GRAPHICS_BIT);
+}
+
+std::vector<const char*>
+VulkanImplementationAros::GetRequiredDeviceExtensions() {
+  return using_surface_ ? std::vector<const char*>{VK_KHR_SWAPCHAIN_EXTENSION_NAME}
+                        : std::vector<const char*>{};
+}
+
+std::vector<const char*>
+VulkanImplementationAros::GetOptionalDeviceExtensions() {
+  return {};
+}
+
+// Native display-buffer handles are not POSIX file descriptors. Until their
+// ownership and synchronization are represented by Chromium's GpuFence and
+// NativePixmap types, advertise no cross-API import/export. Native Vulkan
+// images and swapchains do not require this external-handle path.
+VkFence VulkanImplementationAros::CreateVkFenceForGpuFence(VkDevice) {
+  return VK_NULL_HANDLE;
+}
+
+std::unique_ptr<gfx::GpuFence>
+VulkanImplementationAros::ExportVkFenceToGpuFence(VkDevice, VkFence) {
+  return nullptr;
+}
+
+VkExternalSemaphoreHandleTypeFlagBits
+VulkanImplementationAros::GetExternalSemaphoreHandleType() {
+  return static_cast<VkExternalSemaphoreHandleTypeFlagBits>(0);
+}
+
+bool VulkanImplementationAros::IsExternalSemaphoreSupported(
+    gpu::VulkanDeviceQueue*) {
+  return false;
+}
+
+VkSemaphore VulkanImplementationAros::CreateExternalSemaphore(VkDevice) {
+  return VK_NULL_HANDLE;
+}
+
+bool VulkanImplementationAros::CanImportGpuMemoryBuffer(
+    gpu::VulkanDeviceQueue*, gfx::GpuMemoryBufferType) {
+  return false;
+}
+
+std::unique_ptr<gpu::VulkanImage>
+VulkanImplementationAros::CreateImageFromGpuMemoryHandle(
+    gpu::VulkanDeviceQueue*, gfx::GpuMemoryBufferHandle, gfx::Size, VkFormat,
+    const gfx::ColorSpace&) {
+  return nullptr;
+}
