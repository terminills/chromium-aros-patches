+namespace shortcuts {
+
+void CreateShortcutOnUserDesktop(ShortcutMetadata shortcut_metadata,
+                                 ShortcutCreatorCallback complete) {
+  CHECK(shortcut_metadata.IsValid());
+  // Workbench does not expose a filesystem desktop directory (AROS's
+  // DIR_USER_DESKTOP is unavailable). Until native icon/leave-out integration
+  // exists, report the operation as failed rather than publish an unusable
+  // Linux .desktop file or report a shortcut that was never created.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(complete), base::FilePath(),
+                               ShortcutCreatorResult::kError));
+}
+
+scoped_refptr<base::SequencedTaskRunner> GetShortcutsTaskRunner() {
+  return base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+}
+
