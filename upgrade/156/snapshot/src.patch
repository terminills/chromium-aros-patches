+#include "ui/ozone/platform/aros/aros_window_manager.h"
+#include "base/functional/bind.h"
+#include "base/task/current_thread.h"
+#include "ui/ozone/platform/aros/aros_native_window.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "ui/ozone/platform/aros/aros_window.h"
+
+#include <exec/ports.h>
+#include <intuition/intuition.h>
+#include <intuition/intuitionbase.h>
+#include <proto/exec.h>
+#include <proto/intuition.h>
+
+#undef Remove
+
+namespace ui {
+
+namespace {
+
+constexpr char kPresentationPortName[] = "Chromium.Ozone.AROS.Presentation";
+
+// The browser process has one window manager (OzonePlatformAros owns it);
+// GetArosNativeWindow() resolves handles through it.
+ArosWindowManager* g_window_manager = nullptr;
+
+struct ArosPresentMessage {
+  Message message = {};
+  gfx::AcceleratedWidget widget = gfx::kNullAcceleratedWidget;
+  const void* pixels = nullptr;
+  size_t row_bytes = 0;
+  int width = 0;
+  int height = 0;
+  int damage_x = 0;
+  int damage_y = 0;
+  int damage_width = 0;
+  int damage_height = 0;
+  bool result = false;
+#if BUILDFLAG(ENABLE_VULKAN)
+  PFN_vkCreateAROSSurfaceAROS create_vulkan_surface = nullptr;
+  VkInstance vulkan_instance = VK_NULL_HANDLE;
+  VkSurfaceKHR vulkan_surface = VK_NULL_HANDLE;
+  VkResult vulkan_result = VK_ERROR_SURFACE_LOST_KHR;
+#endif
+};
+
+}  // namespace
+
+ArosWindowManager::ArosWindowManager() {
+  DCHECK(!g_window_manager);
+  g_window_manager = this;
+  event_port_ = CreateMsgPort();
+  CHECK(event_port_);
+  LOG(INFO) << "[Chromium:Ozone:AROS] shared IDCMP port=" << event_port_
+            << " signal=" << static_cast<int>(event_port_->mp_SigBit);
+}
+
+ArosWindowManager::~ArosWindowManager() {
+  if (g_window_manager == this) {
+    g_window_manager = nullptr;
+  }
+  {
+    base::AutoLock lock(lock_);
+    DCHECK(native_windows_.empty());
+    DCHECK(windows_.empty());
+  }
+  ReleaseNativeResources();
+}
+
+void ArosWindowManager::ReleaseNativeResources() {
+  if (native_resources_released_) {
+    return;
+  }
+  native_resources_released_ = true;
+
+  {
+    base::AutoLock lock(lock_);
+    if (!native_windows_.empty() || !windows_.empty()) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS] releasing native ports while "
+                    "windows remain native="
+                 << native_windows_.size() << " logical=" << windows_.size();
+    }
+  }
+
+  presentation_watch_.StopWatching();
+  if (owns_presentation_port_ && presentation_port_) {
+    Forbid();
+    RemPort(presentation_port_);
+    Permit();
+    while (auto* message = reinterpret_cast<ArosPresentMessage*>(
+               GetMsg(presentation_port_))) {
+      message->result = false;
+      ReplyMsg(&message->message);
+    }
+    DeleteMsgPort(presentation_port_);
+    presentation_port_ = nullptr;
+    owns_presentation_port_ = false;
+  }
+  if (presentation_reply_port_) {
+    DeleteMsgPort(presentation_reply_port_);
+    presentation_reply_port_ = nullptr;
+  }
+  if (event_port_) {
+    while (auto* message = reinterpret_cast<Message*>(GetMsg(event_port_))) {
+      ReplyMsg(message);
+    }
+    DeleteMsgPort(event_port_);
+    event_port_ = nullptr;
+  }
+}
+
+gfx::AcceleratedWidget ArosWindowManager::AddWindow(ArosWindow* window) {
+  base::AutoLock lock(lock_);
+  if (!presentation_port_) {
+    struct MsgPort* candidate = CreateMsgPort();
+    CHECK(candidate);
+    candidate->mp_Node.ln_Name = const_cast<char*>(kPresentationPortName);
+
+    Forbid();
+    if (!FindPort(kPresentationPortName)) {
+      AddPort(candidate);
+      presentation_port_ = candidate;
+      owns_presentation_port_ = true;
+    }
+    Permit();
+
+    if (!owns_presentation_port_) {
+      DeleteMsgPort(candidate);
+    } else {
+      CHECK(base::CurrentUIThread::Get()->WatchMessagePort(
+          presentation_port_, &presentation_watch_,
+          base::BindRepeating(&ArosWindowManager::ProcessNativeEvents,
+                              base::Unretained(this))));
+      LOG(INFO) << "[Chromium:Ozone:AROS] browser presentation port="
+                << presentation_port_ << " name=" << kPresentationPortName;
+    }
+  }
+
+  const gfx::AcceleratedWidget widget = next_widget_++;
+  CHECK_NE(widget, gfx::kNullAcceleratedWidget);
+  CHECK(windows_.emplace(widget, window).second);
+  return widget;
+}
+
+void ArosWindowManager::RemoveWindow(gfx::AcceleratedWidget widget,
+                                     ArosWindow* window) {
+  base::AutoLock lock(lock_);
+  const auto it = windows_.find(widget);
+  CHECK(it != windows_.end());
+  CHECK_EQ(window, it->second);
+  windows_.erase(it);
+  if (requested_activation_ == widget) {
+    requested_activation_ = gfx::kNullAcceleratedWidget;
+  }
+}
+
+void ArosWindowManager::SetRequestedActivation(gfx::AcceleratedWidget widget) {
+  requested_activation_ = widget;
+}
+
+void ArosWindowManager::ClearRequestedActivation() {
+  requested_activation_ = gfx::kNullAcceleratedWidget;
+}
+
+gfx::AcceleratedWidget ArosWindowManager::requested_activation() const {
+  return requested_activation_;
+}
+
+void ArosWindowManager::SetCaptureWindow(ArosWindow* window) {
+  if (capture_window_ == window) {
+    return;
+  }
+  // The PlatformWindow interface is where ReleaseCapture() is public.
+  PlatformWindow* previous = capture_window_;
+  capture_window_ = window;
+  if (previous) {
+    previous->ReleaseCapture();
+  }
+}
+
+void ArosWindowManager::ClearCaptureWindow(ArosWindow* window) {
+  if (capture_window_ == window) {
+    capture_window_ = nullptr;
+  }
+}
+
+void ArosWindowManager::AttachNativeWindow(gfx::AcceleratedWidget widget,
+                                           ArosWindow* window,
+                                           struct Window* native_window) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  DCHECK(window_it != windows_.end());
+  DCHECK_EQ(window, window_it->second);
+  DCHECK(native_window);
+  const bool inserted = native_windows_.emplace(native_window, window).second;
+  DCHECK(inserted);
+}
+
+void ArosWindowManager::DetachNativeWindow(gfx::AcceleratedWidget widget,
+                                           ArosWindow* window,
+                                           struct Window* native_window) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  DCHECK(window_it != windows_.end());
+  DCHECK_EQ(window, window_it->second);
+  auto it = native_windows_.find(native_window);
+  DCHECK(it != native_windows_.end());
+  DCHECK_EQ(window, it->second);
+  native_windows_.erase(it);
+}
+
+uint32_t ArosWindowManager::event_signal_mask() const {
+  return event_port_ ? uint32_t{1} << event_port_->mp_SigBit : 0;
+}
+
+struct Window* ArosWindowManager::GetNativeWindow(
+    gfx::AcceleratedWidget widget) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  if (window_it == windows_.end()) {
+    return nullptr;
+  }
+
+  for (const auto& native_window : native_windows_) {
+    if (native_window.second == window_it->second) {
+      return native_window.first;
+    }
+  }
+  return nullptr;
+}
+
+struct Window* GetArosNativeWindow(gfx::AcceleratedWidget widget) {
+  return g_window_manager ? g_window_manager->GetNativeWindow(widget)
+                          : nullptr;
+}
+
+ArosWindow* ArosWindowManager::GetWindow(gfx::AcceleratedWidget widget) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  return window_it == windows_.end() ? nullptr : window_it->second.get();
+}
+
+ArosWindow* ArosWindowManager::GetWindowForNative(
+    struct Window* native_window) {
+  if (!native_window) {
+    return nullptr;
+  }
+  base::AutoLock lock(lock_);
+  const auto it = native_windows_.find(native_window);
+  return it == native_windows_.end() ? nullptr : it->second.get();
+}
+
+ArosWindow* ArosWindowManager::GetIntuitionActiveWindow() {
+  // intuitionbase.h: LockIBase() before reading the struct.
+  const ULONG ibase_lock = LockIBase(0);
+  struct Window* const active_window = IntuitionBase->ActiveWindow;
+  UnlockIBase(ibase_lock);
+  return GetWindowForNative(active_window);
+}
+
+void ArosWindowManager::ProcessNativeEvents() {
+  if (event_port_) {
+    while (auto* message =
+               reinterpret_cast<IntuiMessage*>(GetMsg(event_port_))) {
+      struct Window* const native_window = message->IDCMPWindow;
+      const uint32_t message_class = message->Class;
+      const uint16_t code = message->Code;
+      const uint16_t qualifier = message->Qualifier;
+      const int16_t mouse_x = message->MouseX;
+      const int16_t mouse_y = message->MouseY;
+
+      ArosWindow* target = nullptr;
+      {
+        base::AutoLock lock(lock_);
+        const auto it = native_windows_.find(native_window);
+        if (it != native_windows_.end()) {
+          target = it->second;
+        }
+      }
+
+      ReplyMsg(reinterpret_cast<Message*>(message));
+      if (target) {
+        target->HandleNativeEvent(message_class, code, qualifier, mouse_x,
+                                  mouse_y);
+      }
+    }
+  }
+
+  if (presentation_port_) {
+    while (auto* request = reinterpret_cast<ArosPresentMessage*>(
+               GetMsg(presentation_port_))) {
+#if BUILDFLAG(ENABLE_VULKAN)
+      if (request->create_vulkan_surface) {
+        request->vulkan_result = CreateVulkanSurface(
+            request->widget, request->vulkan_instance,
+            request->create_vulkan_surface, &request->vulkan_surface);
+        ReplyMsg(&request->message);
+        continue;
+      }
+#endif
+      bool first_request = false;
+      const gfx::AcceleratedWidget widget = request->widget;
+      {
+        base::AutoLock lock(lock_);
+        first_request = !logged_received_present_;
+        if (first_request) {
+          logged_received_present_ = true;
+          LOG(INFO) << "[Chromium:Ozone:AROS] received first cross-Process "
+                       "canvas present widget="
+                    << request->widget << " pixels=" << request->pixels
+                    << " size=" << request->width << "x" << request->height;
+        }
+        const auto it = windows_.find(request->widget);
+        request->result =
+            it != windows_.end() &&
+            it->second->PresentPixels(
+                request->pixels, request->row_bytes,
+                gfx::Size(request->width, request->height),
+                gfx::Rect(request->damage_x, request->damage_y,
+                          request->damage_width, request->damage_height));
+        if (first_request) {
+          LOG(INFO) << "[Chromium:Ozone:AROS] completed first cross-Process "
+                       "canvas paint widget="
+                    << request->widget << " result=" << request->result;
+        }
+      }
+      ReplyMsg(&request->message);
+      if (first_request) {
+        LOG(INFO) << "[Chromium:Ozone:AROS] replied to first cross-Process "
+                     "canvas present widget="
+                  << widget;
+      }
+    }
+  }
+}
+
+#if BUILDFLAG(ENABLE_VULKAN)
+VkResult ArosWindowManager::CreateVulkanSurface(
+    gfx::AcceleratedWidget widget,
+    VkInstance instance,
+    PFN_vkCreateAROSSurfaceAROS create_surface,
+    VkSurfaceKHR* surface) {
+  *surface = VK_NULL_HANDLE;
+  {
+    base::AutoLock lock(lock_);
+    const auto window = windows_.find(widget);
+    if (window != windows_.end()) {
+      for (const auto& native_window : native_windows_) {
+        if (native_window.second == window->second) {
+          VkAROSSurfaceCreateInfoAROS info = {};
+          info.sType = VK_STRUCTURE_TYPE_AROS_SURFACE_CREATE_INFO_AROS;
+          info.window = native_window.first;
+          return create_surface(instance, &info, nullptr, surface);
+        }
+      }
+      return VK_ERROR_SURFACE_LOST_KHR;
+    }
+    // Never synchronously send to our own UI port for a stale widget.
+    if (owns_presentation_port_ || native_resources_released_) {
+      return VK_ERROR_SURFACE_LOST_KHR;
+    }
+  }
+
+  // A reply port belongs to the requesting task. Do not reuse the canvas
+  // port, which may belong to another compositor thread.
+  MsgPort* reply = CreateMsgPort();
+  if (!reply) {
+    return VK_ERROR_OUT_OF_HOST_MEMORY;
+  }
+  ArosPresentMessage request;
+  request.message.mn_ReplyPort = reply;
+  request.message.mn_Length = sizeof(request);
+  request.widget = widget;
+  request.create_vulkan_surface = create_surface;
+  request.vulkan_instance = instance;
+  Forbid();
+  MsgPort* port = FindPort(kPresentationPortName);
+  if (port) {
+    PutMsg(port, &request.message);
+  }
+  Permit();
+  if (port) {
+    WaitPort(reply);
+    CHECK_EQ(GetMsg(reply), &request.message);
+  }
+  DeleteMsgPort(reply);
+  *surface = request.vulkan_surface;
+  return request.vulkan_result;
+}
+#endif
+
+bool ArosWindowManager::PresentCanvas(gfx::AcceleratedWidget widget,
+                                      const void* pixels,
+                                      size_t row_bytes,
+                                      const gfx::Size& pixel_size,
+                                      const gfx::Rect& damage) {
+  base::AutoLock lock(lock_);
+  const auto it = windows_.find(widget);
+  if (it != windows_.end()) {
+    return it->second->PresentPixels(pixels, row_bytes, pixel_size, damage);
+  }
+  VLOG(1) << "[Chromium:Ozone:AROS] present widget=" << widget
+          << " has no in-process window; forwarding to the presentation port";
+
+  // Initialize this private reply port on the compositor task that actually
+  // waits for presentation completion. CreateMsgPort() records the calling
+  // task in mp_SigTask; constructing it with the manager on the GPU main task
+  // would make ReplyMsg() wake the wrong task.
+  if (!presentation_reply_port_) {
+    presentation_reply_port_ = CreateMsgPort();
+    CHECK(presentation_reply_port_);
+    LOG(INFO) << "[Chromium:Ozone:AROS] canvas reply port="
+              << presentation_reply_port_
+              << " owner=" << presentation_reply_port_->mp_SigTask;
+  }
+
+  ArosPresentMessage request;
+  request.message.mn_ReplyPort = presentation_reply_port_;
+  request.message.mn_Length = sizeof(request);
+  request.widget = widget;
+  request.pixels = pixels;
+  request.row_bytes = row_bytes;
+  request.width = pixel_size.width();
+  request.height = pixel_size.height();
+  request.damage_x = damage.x();
+  request.damage_y = damage.y();
+  request.damage_width = damage.width();
+  request.damage_height = damage.height();
+
+  Forbid();
+  struct MsgPort* const presentation_port = FindPort(kPresentationPortName);
+  if (presentation_port) {
+    PutMsg(presentation_port, &request.message);
+  }
+  Permit();
+  if (!presentation_port) {
+    return false;
+  }
+
+  if (!logged_waiting_present_reply_) {
+    logged_waiting_present_reply_ = true;
+    LOG(INFO) << "[Chromium:Ozone:AROS] waiting for first cross-Process "
+                 "canvas reply widget="
+              << widget;
+  }
+  WaitPort(presentation_reply_port_);
+  CHECK_EQ(GetMsg(presentation_reply_port_), &request.message);
+  if (!logged_forwarded_present_) {
+    logged_forwarded_present_ = true;
+    LOG(INFO) << "[Chromium:Ozone:AROS] first cross-Process canvas present "
+                 "widget="
+              << widget << " result=" << request.result;
+  }
+  return request.result;
+}
+
+}  // namespace ui
