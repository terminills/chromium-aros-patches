+  } else {
+    _toolprefix = "$aros_toolchain_root/x86_64-aros-"
+    _arch_flags = "-m64 -mcmodel=large -mno-red-zone -mno-ms-bitfields"
+  }
+
+  gcc_toolchain(_cpu) {
+    cc = "${_toolprefix}gcc"
+    cxx = "${_toolprefix}g++"
+    if (_cpu == "arm64") {
