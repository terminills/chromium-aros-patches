+#include <dos/dostags.h>
+#include <exec/memory.h>
+#include <exec/tasks.h>
+#include <proto/dos.h>
+#include <proto/exec.h>
+
+namespace base {
+void CheckPThreadStackMinIsSafe() {
+  if constexpr (!__builtin_constant_p(PTHREAD_STACK_MIN)) {
+    [[maybe_unused]] static const bool checked = [] {
+      CHECK_GE(PTHREAD_STACK_MIN_CONST, PTHREAD_STACK_MIN);
+      return true;
+    }();
+  }
+}
+
+namespace {
+
+constexpr ULONG kChromiumChildStackSize = 4 * 1024 * 1024;
+
+Process UnsupportedLaunch(const char* reason, int error = ENOTSUP) {
+  errno = error;
+  LOG(ERROR) << "[Chromium:AROS:Launch] unsupported launch request: "
+             << reason;
+  return Process();
+}
+
+bool UnsupportedOutput(std::string* output, int* exit_code = nullptr) {
+  if (output)
+    output->clear();
+  if (exit_code)
+    *exit_code = EXIT_FAILURE;
+  errno = ENOSYS;
+  return false;
+}
+
+int IoErrToErrno(LONG io_error) {
+  switch (io_error) {
+    case ERROR_NO_FREE_STORE:
+      return ENOMEM;
+    case ERROR_OBJECT_NOT_FOUND:
+    case ERROR_DIR_NOT_FOUND:
+      return ENOENT;
+    case ERROR_OBJECT_WRONG_TYPE:
+      return ENOTDIR;
+    case ERROR_READ_PROTECTED:
+      return EACCES;
+    default:
+      return EIO;
+  }
+}
+
+std::string ToDosPath(const FilePath& path) {
+  const std::string& value = path.value();
+  if (value.empty() || value.find(':') != std::string::npos ||
+      value.front() != '/') {
+    return value;
+  }
+
+  const size_t volume_start = value.find_first_not_of('/');
+  if (volume_start == std::string::npos)
+    return ":";
+
+  const size_t volume_end = value.find('/', volume_start);
+  if (volume_end == std::string::npos)
+    return value.substr(volume_start) + ":";
+
+  std::string dos_path = value.substr(volume_start, volume_end - volume_start);
+  dos_path.push_back(':');
+  dos_path.append(value, volume_end + 1, std::string::npos);
+  return dos_path;
+}
+
+bool AppendQuotedArgument(const std::string& argument,
+                          std::string* command_line) {
+  if (argument.find('\0') != std::string::npos)
+    return false;
+
+  command_line->push_back('"');
+  for (const char character : argument) {
+    switch (character) {
+      case '\n':
+        command_line->append("*N");
+        break;
+      case '"':
+      case '*':
+        command_line->push_back('*');
+        command_line->push_back(character);
+        break;
+      default:
+        command_line->push_back(character);
+        break;
+    }
+  }
+  command_line->append("\" ");
+  return true;
+}
+
+bool BuildArguments(const std::vector<std::string>& argv,
+                    std::string* arguments) {
+  arguments->clear();
+  for (size_t index = 1; index < argv.size(); ++index) {
+    if (!AppendQuotedArgument(argv[index], arguments))
+      return false;
+  }
+
+  if (arguments->empty())
+    arguments->push_back('\n');
+  else
+    arguments->back() = '\n';
+  return true;
+}
+
+std::string ProcessTypeForArguments(const std::vector<std::string>& argv) {
+  constexpr char kTypePrefix[] = "--type=";
+  for (const std::string& argument : argv) {
+    if (argument.rfind(kTypePrefix, 0) == 0)
+      return argument.substr(sizeof(kTypePrefix) - 1);
+  }
+  return "browser";
+}
+
+std::string ProcessDetailForArguments(const std::vector<std::string>& argv) {
+  constexpr const char* kDetailPrefixes[] = {
+      "--utility-sub-type=",
+      "--renderer-client-id=",
+  };
+  for (const char* prefix : kDetailPrefixes) {
+    const size_t prefix_length = strlen(prefix);
+    for (const std::string& argument : argv) {
+      if (argument.rfind(prefix, 0) == 0)
+        return argument.substr(prefix_length);
+    }
+  }
+  return "-";
+}
+
+const char* UnsupportedOption(const LaunchOptions& options) {
+  if (!options.fds_to_remap.empty())
+    return "file descriptor remapping requires native MessagePort handles";
+  if (!options.environment.empty() || options.clear_environment)
+    return "POSIX environment replacement is not implemented";
+  if (options.pre_exec_delegate)
+    return "pre-exec delegates are not valid for CreateNewProc";
+  if (options.maximize_rlimits)
+    return "POSIX resource limits are not available";
+  if (options.new_process_group)
+    return "POSIX process groups are not available";
+  return nullptr;
+}
+
+}  // namespace
+
+Process LaunchProcess(const CommandLine& cmdline, const LaunchOptions& options) {
+  return LaunchProcess(cmdline.argv(), options);
+}
+
+Process LaunchProcess(const std::vector<std::string>& argv,
+                      const LaunchOptions& options) {
+  if (argv.empty() || argv.front().empty())
+    return UnsupportedLaunch("empty executable path", EINVAL);
+
+  if (const char* unsupported = UnsupportedOption(options))
+    return UnsupportedLaunch(unsupported);
+
+  const FilePath executable =
+      options.real_path.empty() ? FilePath(argv.front()) : options.real_path;
+  const std::string dos_executable = ToDosPath(executable);
+  if (dos_executable.empty())
+    return UnsupportedLaunch("empty native executable path", EINVAL);
+
+  std::string arguments;
+  if (!BuildArguments(argv, &arguments))
+    return UnsupportedLaunch("argument contains an embedded NUL", EINVAL);
+  // Keep CDM utility and renderer diagnostics enabled after native launch.
+  if (aros::WidevineDebugEnabled()) {
+    arguments += " --aros-widevine-debug";
+  }
+  const std::string process_type = ProcessTypeForArguments(argv);
+  const std::string process_detail = ProcessDetailForArguments(argv);
+
+  BPTR current_directory = BNULL;
+  if (!options.current_directory.empty()) {
+    const std::string dos_directory = ToDosPath(options.current_directory);
+    current_directory = Lock(dos_directory.c_str(), SHARED_LOCK);
+    if (current_directory == BNULL) {
+      const LONG io_error = IoErr();
+      errno = IoErrToErrno(io_error);
+      LOG(ERROR) << "[Chromium:AROS:Launch] cannot lock working directory '"
+                 << dos_directory << "': IoErr=" << io_error;
+      return Process();
+    }
+  }
+
+  const IPTR available_before = AvailMem(MEMF_ANY);
+  BPTR segment = LoadSeg(dos_executable.c_str());
+  const IPTR available_after = AvailMem(MEMF_ANY);
+  if (segment == BNULL) {
+    const LONG io_error = IoErr();
+    if (current_directory != BNULL)
+      UnLock(current_directory);
+    errno = IoErrToErrno(io_error);
+    LOG(ERROR) << "[Chromium:AROS:Launch] LoadSeg failed for '"
+               << dos_executable << "' type=" << process_type
+               << " detail=" << process_detail
+               << " IoErr=" << io_error
+               << " free-before=" << available_before
+               << " free-after=" << available_after;
+    return Process();
+  }
+
+  struct ::Task* current_task = FindTask(nullptr);
+  const BYTE parent_priority =
+      current_task ? current_task->tc_Node.ln_Pri : static_cast<BYTE>(0);
+  const BYTE launch_priority =
+      parent_priority > std::numeric_limits<BYTE>::min()
+          ? static_cast<BYTE>(parent_priority - 1)
+          : parent_priority;
+
+  const char* process_name = FilePart(dos_executable.c_str());
+  if (!process_name || !*process_name)
+    process_name = dos_executable.c_str();
+
+  // Place the child on a core of its own. A child process inherits its
+  // launcher's CPU exactly as a thread inherits its creator's, so without this
+  // every renderer's main thread lands on CPU 0 next to the browser's - which
+  // is precisely what the multi-process model exists to avoid. (Which thread
+  // is the frame-time bottleneck is UNMEASURED: every number before
+  // 2026-09-20 measured the serial port, see base_switches.cc
+  // kArosNativeThreadPool.)
+  //
+  // nullptr unless --aros-pin-workers is on, and NP_Affinity with a NULL value
+  // is ignored by CreateNewProc (rom/dos/createnewproc.c only diverts to
+  // NewAddTask when the tag carries a mask), so the default path is unchanged.
+  // exec takes ownership of the mask and frees it with the task.
+  void* child_affinity = internal::ArosAllocChildCpuMask();
+
+  struct TagItem tags[] = {
+      {NP_Affinity, reinterpret_cast<IPTR>(child_affinity)},
+      {NP_Seglist, reinterpret_cast<IPTR>(segment)},
+      {NP_FreeSeglist, TRUE},
+      {NP_StackSize, kChromiumChildStackSize},
+      {NP_Name, reinterpret_cast<IPTR>(process_name)},
+      {NP_Priority, static_cast<IPTR>(launch_priority)},
+      {NP_Arguments, reinterpret_cast<IPTR>(arguments.data())},
+      {NP_Cli, TRUE},
+      {TAG_IGNORE, 0},
+      // Chromium observes children from tasks other than the launcher.
+      // Avoid a per-Exec-task death record that those observers cannot reap;
+      // the AROS Process implementation tracks global Task-ID liveness.
+      {NP_NotifyOnDeath, FALSE},
+      {TAG_DONE, 0},
+  };
+
+  if (current_directory != BNULL) {
+    // Index 8, not 7: NP_Affinity was inserted at the front, shifting the
+    // TAG_IGNORE placeholder along by one.
+    tags[8].ti_Tag = NP_CurrentDir;
+    tags[8].ti_Data = reinterpret_cast<IPTR>(current_directory);
+  }
+
+  struct ::Process* child = CreateNewProc(tags);
+  if (!child) {
+    const LONG io_error = IoErr();
+    UnLoadSeg(segment);
+    if (current_directory != BNULL)
+      UnLock(current_directory);
+    errno = IoErrToErrno(io_error);
+    LOG(ERROR) << "[Chromium:AROS:Launch] CreateNewProc failed for '"
+               << dos_executable << "': IoErr=" << io_error;
+    return Process();
+  }
+
+  const ProcessHandle child_id =
+      static_cast<ProcessHandle>(GetETaskID(&child->pr_Task));
+  SetTaskPri(&child->pr_Task, parent_priority);
+
+  LOG(INFO) << "[Chromium:AROS:Launch] spawned pid=" << child_id
+            << " program='" << dos_executable << "' argc=" << argv.size()
+            << " type=" << process_type << " detail=" << process_detail
+            << " stack=" << kChromiumChildStackSize
+            << " free-before=" << available_before
+            << " free-after=" << available_after;
+
+  Process process(child_id);
+  if (options.wait) {
+    ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                            BlockingType::MAY_BLOCK);
+    int exit_code = 0;
+    if (!process.WaitForExit(&exit_code)) {
+      LOG(ERROR) << "[Chromium:AROS:Launch] waitpid failed for pid="
+                 << child_id;
+    }
+  }
+
+  return process;
+}
+
+void CloseSuperfluousFds(const InjectiveMultimap& saved_mapping) {
+  const size_t max_fds = GetMaxFds();
+  for (size_t i = 0; i < max_fds; ++i) {
+    const int fd = static_cast<int>(i);
+    if (fd == STDIN_FILENO || fd == STDOUT_FILENO || fd == STDERR_FILENO)
+      continue;
+
+    bool preserved = false;
+    for (size_t j = 0; j < saved_mapping.size(); ++j) {
+      if (fd == saved_mapping[j].dest) {
+        preserved = true;
+        break;
+      }
+    }
+    if (!preserved)
+      close(fd);
+  }
+}
+
+bool GetAppOutput(const CommandLine& cl, std::string* output) {
+  return UnsupportedOutput(output);
+}
+
+bool GetAppOutput(const std::vector<std::string>& argv, std::string* output) {
+  return UnsupportedOutput(output);
+}
+
+bool GetAppOutputAndError(const CommandLine& cl, std::string* output) {
+  return UnsupportedOutput(output);
+}
+
+bool GetAppOutputAndError(const std::vector<std::string>& argv,
+                          std::string* output) {
+  return UnsupportedOutput(output);
+}
+
+bool GetAppOutputWithExitCode(const CommandLine& cl,
+                              std::string* output,
+                              int* exit_code) {
+  return UnsupportedOutput(output, exit_code);
+}
+
+void RaiseProcessToHighPriority() {}
+
+}  // namespace base
