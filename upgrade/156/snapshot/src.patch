+#include "ui/platform_window/platform_window_init_properties.h"
+
+struct Window;
+struct BitMap;
+struct RastPort;
+struct Screen;
+
+namespace ui {
+
+class ArosWindowManager;
+
+class ArosWindow : public PlatformWindow {
+ public:
+  ArosWindow(PlatformWindowDelegate* delegate,
+             ArosWindowManager* manager,
+             PlatformWindowInitProperties properties);
+
+  ArosWindow(const ArosWindow&) = delete;
+  ArosWindow& operator=(const ArosWindow&) = delete;
+
+  ~ArosWindow() override;
+
+  void HandleNativeEvent(uint32_t message_class,
+                         uint16_t code,
+                         uint16_t qualifier,
+                         int16_t mouse_x,
+                         int16_t mouse_y);
+  bool PresentPixels(const void* pixels,
+                     size_t row_bytes,
+                     const gfx::Size& pixel_size,
+                     const gfx::Rect& damage);
+
+  // Whether this window carries Chromium activation and keyboard focus of
+  // its own.  Menus, tooltips, popups and drag windows do not (the X11
+  // platform makes them override-redirect so the window manager never
+  // focuses them); Intuition still activates whichever window is clicked,
+  // so the activation those windows receive is credited to their focus
+  // owner instead, and the keys they receive are delivered there.
+  bool activatable() const { return activatable_; }
+  ArosWindow* FocusOwner();
+
+ private:
+  void Show(bool inactive) override;
+  void Hide() override;
+  void Close() override;
+  bool IsVisible() const override;
+  void PrepareForShutdown() override;
+  void SetBoundsInPixels(const gfx::Rect& bounds) override;
+  gfx::Rect GetBoundsInPixels() const override;
+  void SetBoundsInDIP(const gfx::Rect& bounds) override;
+  gfx::Rect GetBoundsInDIP() const override;
+  void SetTitle(const std::u16string& title) override;
+  void SetCapture() override;
+  void ReleaseCapture() override;
+  void SetFullscreen(bool fullscreen, int64_t target_display_id) override;
+  bool HasCapture() const override;
+  void Maximize() override;
+  void Minimize() override;
+  void Restore() override;
+  PlatformWindowState GetPlatformWindowState() const override;
+  void Activate() override;
+  void Deactivate() override;
+  void SetUseNativeFrame(bool use_native_frame) override;
+  bool ShouldUseNativeFrame() const override;
+  void SetCursor(scoped_refptr<PlatformCursor> cursor) override;
+  void MoveCursorTo(const gfx::Point& location) override;
+  void ConfineCursorToBounds(const gfx::Rect& bounds) override;
+  void SetRestoredBoundsInDIP(const gfx::Rect& bounds) override;
+  gfx::Rect GetRestoredBoundsInDIP() const override;
+  void SetWindowIcons(const gfx::ImageSkia& window_icon,
+                      const gfx::ImageSkia& app_icon) override;
+  void SizeConstraintsChanged() override;
+
+  // How the Intuition window is shown. F11 fills the Workbench screen with
+  // a borderless window; Alt+F11 opens a screen of Chromium's own, which can
+  // be dragged down or flipped away like any AROS screen. Intuition cannot
+  // change a window's border or screen in place, so a mode change reopens it.
+  enum class NativeMode { kNormal, kFullscreen, kOwnScreen };
+  bool OpenNativeWindow(NativeMode mode);
+  void CloseNativeWindow();
+  void SwitchNativeMode(NativeMode mode);
+  // A menu or popup opens on its parent's screen.
+  struct Screen* ParentScreen() const;
+  // Shows title_ where this mode has a title: the window bar, or the screen
+  // bar of an own screen.
+  void ApplyNativeTitle();
+
+  void UpdateBoundsFromNative(bool notify_delegate);
+  void UpdateWindowState(PlatformWindowState state);
+  bool EnsureNativeBackingStore(const gfx::Size& size);
+  void ReleaseNativeBackingStore();
+  bool BlitNativeBackingStore(const gfx::Rect& damage);
+  void ResetNativeCursor();
+  void DisableNativeEvents();
+  bool OwnsIntuitionActivation();
+  void SetActive(bool active);
+  void HandleActiveWindow();
+  void HandleInactiveWindow();
+  void ReturnIntuitionActivationToOwner();
+  void RequestIntuitionActivation();
+  // The window a mouse event reported to this one (window-relative
+  // mouse_x/mouse_y) is delivered to -- this window, the capture holder, or
+  // nullptr when it falls outside our client area -- and the event's location
+  // in the target's client coordinates plus its screen location.
+  ArosWindow* MouseEventTarget(int16_t mouse_x,
+                               int16_t mouse_y,
+                               gfx::Point* location,
+                               gfx::Point* root_location);
+  void DispatchMouseMove(uint16_t qualifier, int16_t mouse_x, int16_t mouse_y);
+  void DispatchMouseButton(uint16_t code,
+                           uint16_t qualifier,
+                           int16_t mouse_x,
+                           int16_t mouse_y);
+  void DispatchRawKey(uint16_t code,
+                      uint16_t qualifier,
+                      int16_t mouse_x,
+                      int16_t mouse_y);
+  gfx::Rect PrimaryScreenWorkArea() const;
+
+  raw_ptr<PlatformWindowDelegate> delegate_ = nullptr;
+  raw_ptr<ArosWindowManager> manager_ = nullptr;
+  gfx::AcceleratedWidget widget_ = gfx::kNullAcceleratedWidget;
+  RAW_PTR_EXCLUSION struct Window* window_ = nullptr;
+  RAW_PTR_EXCLUSION uint16_t* cursor_sprite_data_ = nullptr;
+  RAW_PTR_EXCLUSION struct BitMap* backing_bitmap_ = nullptr;
+  std::unique_ptr<struct RastPort> backing_rast_port_;
+  gfx::Size backing_size_;
+  // Frames presented into the Intuition window; the first few and every
+  // 64th are logged at VLOG(1) so a window that stops painting shows up.
+  uint64_t presented_frames_ = 0;
+  scoped_refptr<PlatformCursor> cursor_;
+  gfx::Rect bounds_;
+  std::optional<gfx::Rect> restored_bounds_;
+  // The page title in Latin-1, as Intuition draws it.
+  std::string title_;
+  PlatformWindowState window_state_ = PlatformWindowState::kNormal;
+  bool visible_ = false;
+  bool activatable_ = true;
+  gfx::AcceleratedWidget parent_widget_ = gfx::kNullAcceleratedWidget;
+  bool active_ = false;
+  bool capture_ = false;
+  bool shutting_down_ = false;
+  bool native_events_enabled_ = false;
+  bool use_standard_frame_ = false;
+  NativeMode native_mode_ = NativeMode::kNormal;
+  // Set by Alt+F11 so the browser's fullscreen request uses an own screen.
+  bool own_screen_requested_ = false;
+  RAW_PTR_EXCLUSION struct Screen* own_screen_ = nullptr;
+  base::WeakPtrFactory<ArosWindow> weak_factory_{this};
+};
+
+}  // namespace ui
+
+#endif  // UI_OZONE_PLATFORM_AROS_AROS_WINDOW_H_
