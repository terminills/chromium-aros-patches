+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/policy/policy_path_parser.h"
+
+#include <memory>
+#include <string>
+
+#include "base/environment.h"
+
+namespace policy::path_parser {
+
+const char kMachineNamePolicyVarName[] = "${machine_name}";
+const char kUserNamePolicyVarName[] = "${user_name}";
+
+namespace {
+
+void ReplaceVariable(base::FilePath::StringType* value,
+                     const char* variable,
+                     const std::string& replacement) {
+  size_t offset = 0;
+  while ((offset = value->find(variable, offset)) != std::string::npos) {
+    value->replace(offset, std::char_traits<char>::length(variable),
+                   replacement);
+    offset += replacement.size();
+  }
+}
+
+}  // namespace
+
+base::FilePath::StringType ExpandPathVariables(
+    const base::FilePath::StringType& untranslated_string) {
+  base::FilePath::StringType result(untranslated_string);
+  if (result.size() > 1 &&
+      ((result.front() == '"' && result.back() == '"') ||
+       (result.front() == '\'' && result.back() == '\''))) {
+    result = result.substr(1, result.size() - 2);
+  }
+
+  std::unique_ptr<base::Environment> environment(base::Environment::Create());
+  std::string user_name = environment->GetVar("USER").value_or("user");
+  std::string machine_name = environment->GetVar("HOSTNAME").value_or("AROS");
+
+  ReplaceVariable(&result, kUserNamePolicyVarName, user_name);
+  ReplaceVariable(&result, kMachineNamePolicyVarName, machine_name);
+  return result;
+}
+
+}  // namespace policy::path_parser
