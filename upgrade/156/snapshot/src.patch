+namespace base {
+
+// AROS does not expose POSIX fd readiness through posixc select(). AROSTCP's
+// WaitSelect() is the native socket readiness primitive and can atomically wait
+// for an Exec signal, which supplies the cross-task scheduler wakeup.
+class BASE_EXPORT MessagePumpAROS : public MessagePump,
+                                    public WatchableIOMessagePumpPosix {
+ public:
+  class FdWatchController : public FdWatchControllerInterface {
+   public:
+    explicit FdWatchController(const Location& from_here);
+
+    FdWatchController(const FdWatchController&) = delete;
+    FdWatchController& operator=(const FdWatchController&) = delete;
+
+    ~FdWatchController() override;
+
+    bool StopWatchingFileDescriptor() override;
+
+   private:
+    friend class MessagePumpAROS;
+
+    raw_ptr<MessagePumpAROS, DisableDanglingPtrDetection> pump_ = nullptr;
+    raw_ptr<FdWatcher> watcher_ = nullptr;
+    raw_ptr<bool> was_destroyed_ = nullptr;
+    int fd_ = -1;
+    int mode_ = 0;
+    bool persistent_ = false;
+    uint64_t generation_ = 0;
+  };
+
+  // Watches a signal-owning Exec message port on its owning task. The callback
+  // must drain its messages; the controller must stop before the port is freed.
+  class BASE_EXPORT PortWatchController {
+   public:
+    PortWatchController() = default;
+    ~PortWatchController();
+    PortWatchController(const PortWatchController&) = delete;
+    PortWatchController& operator=(const PortWatchController&) = delete;
+    void StopWatching();
+   private:
+    friend class MessagePumpAROS;
+    raw_ptr<MessagePumpAROS> pump_ = nullptr;
+    RepeatingClosure callback_;
+    uint32_t mask_ = 0;
+    uint64_t generation_ = 0;
+  };
+  bool WatchMessagePort(MsgPort* port, PortWatchController* controller,
+                        RepeatingClosure callback);
+
+  MessagePumpAROS();
+
+  MessagePumpAROS(const MessagePumpAROS&) = delete;
+  MessagePumpAROS& operator=(const MessagePumpAROS&) = delete;
+
+  ~MessagePumpAROS() override;
+
+  static void CleanupLivePumpsAtExit();
+
+  bool WatchFileDescriptor(int fd,
+                           bool persistent,
+                           int mode,
+                           FdWatchController* controller,
+                           FdWatcher* delegate);
+
+  void Run(Delegate* delegate) override;
+  void Quit() override;
+  void ScheduleWork() override;
+  void ScheduleDelayedWork(
+      const Delegate::NextWorkInfo& next_work_info) override;
+
+ private:
+  struct RunState {
+    explicit RunState(Delegate* delegate_in) : delegate(delegate_in) {}
+
+    RAW_PTR_EXCLUSION Delegate* const delegate;
+    bool should_quit = false;
+  };
+
+  struct ReadyRegistration {
+    FdWatchController* controller;
+    uint64_t generation;
+    int ready_mode;
+  };
+
+  void StopWatchingPort(PortWatchController* controller);
+  bool DispatchPortSignals();
+  std::vector<PortWatchController*> port_controllers_;
+  uint32_t port_mask_ = 0;
+  uint32_t pending_port_signals_ = 0;
+
+  void RebindToRunningTask();
+  bool WaitForSocketEvents(TimeDelta timeout, bool wait_indefinitely);
+  void WaitForIdleEvents(TimeDelta timeout, bool wait_indefinitely);
+  void DispatchController(const ReadyRegistration& ready);
+  void UnregisterController(FdWatchController* controller);
+  void ReleaseNativeResources();
+
+  raw_ptr<RunState> run_state_ = nullptr;
+  RAW_PTR_EXCLUSION Task* pump_task_ = nullptr;
+  RAW_PTR_EXCLUSION Library* fd_library_ = nullptr;
+  int wakeup_signal_ = -1;
+  uint32_t wakeup_mask_ = 0;
+  RAW_PTR_EXCLUSION MsgPort* timer_port_ = nullptr;
+  RAW_PTR_EXCLUSION timerequest* timer_request_ = nullptr;
+  bool timer_pending_ = false;
+  std::vector<raw_ptr<FdWatchController>> controllers_;
+  uint64_t next_generation_ = 1;
+  bool wait_select_error_reported_ = false;
+  bool native_resources_released_ = false;
+
+  // Diagnostics for the reported "busy looping / delayed mouse pointer".
+  //
+  // A DOS-backed descriptor watched for WATCH_WRITE is reported ready on every
+  // pass (DOS writes are synchronous, so there is nothing to wait on). That
+  // makes Run()'s processed_io permanently true, so it continues without ever
+  // reaching its blocking wait - a full spin, in which the
+  // kDosDescriptorPollInterval clamp below is never reached either.
+  //
+  // Measured on hosted Chromium loading a real page this does NOT happen (the
+  // guest sits at a few percent of one core), so the condition exists but has
+  // not been shown to fire. These two counters make the next report from a
+  // machine that DOES loop answer it directly instead of by inference:
+  // dos_write_watch_reported_ names the descriptor that can cause it, and the
+  // consecutive-pass counter records whether the pump actually stopped
+  // blocking. Both log once.
+  bool dos_write_watch_reported_ = false;
+  bool spin_reported_ = false;
+  uint64_t consecutive_nonblocking_passes_ = 0;
+  bool last_pass_dos_write_only_ = false;
+  ThreadChecker watch_file_descriptor_caller_checker_;
+};
+
+}  // namespace base
+
+#endif  // BASE_MESSAGE_LOOP_MESSAGE_PUMP_AROS_H_
