+ArosWindow::ArosWindow(PlatformWindowDelegate* delegate,
+                       ArosWindowManager* manager,
+                       PlatformWindowInitProperties properties)
+    : delegate_(delegate),
+      manager_(manager),
+      bounds_(properties.bounds),
+      activatable_(properties.activatable &&
+                   properties.type != PlatformWindowType::kMenu &&
+                   properties.type != PlatformWindowType::kTooltip &&
+                   properties.type != PlatformWindowType::kPopup &&
+                   properties.type != PlatformWindowType::kDrag),
+      parent_widget_(properties.parent_widget) {
+  bounds_.set_width(PositiveOrDefault(bounds_.width(), kDefaultWindowWidth));
+  bounds_.set_height(PositiveOrDefault(bounds_.height(), kDefaultWindowHeight));
+  const gfx::Rect work_area = GetPrimaryArosScreenGeometry().work_area;
+  bounds_ = ConstrainClientBoundsToWorkArea(bounds_, work_area, 0, 0, 0, 0);
+
+  use_standard_frame_ = properties.type == PlatformWindowType::kWindow &&
+                       !properties.remove_standard_frame;
+  widget_ = manager_->AddWindow(this);
+  if (OpenNativeWindow(NativeMode::kNormal)) {
+    LOG(INFO) << "[Chromium:Ozone:AROS] opened Intuition window widget="
+              << widget_ << " native=" << window_
+              << " client=" << bounds_.ToString()
+              << " type=" << static_cast<int>(properties.type)
+              << " activatable=" << activatable_
+              << " parent=" << parent_widget_
+              << " standard_frame=" << use_standard_frame_
+              << " work_area=" << work_area.ToString();
+  }
+
+  delegate_->OnAcceleratedWidgetAvailable(widget_);
+}
+
+struct Screen* ArosWindow::ParentScreen() const {
+  if (parent_widget_ == gfx::kNullAcceleratedWidget) {
+    return nullptr;
+  }
+  ArosWindow* const parent = manager_->GetWindow(parent_widget_);
+  if (!parent || !parent->window_ || !parent->window_->WScreen) {
+    return nullptr;
+  }
+  struct Screen* const screen = parent->window_->WScreen;
+  return (screen->Flags & SCREENTYPE) == CUSTOMSCREEN ? screen : nullptr;
+}
+
+bool ArosWindow::OpenNativeWindow(NativeMode mode) {
+  struct Screen* screen = nullptr;
+  if (mode == NativeMode::kOwnScreen) {
+    if (!own_screen_) {
+      own_screen_ = OpenScreenTags(
+          nullptr, SA_LikeWorkbench, TRUE, SA_Type, CUSTOMSCREEN, SA_Title,
+          reinterpret_cast<IPTR>("Chromium"), SA_ShowTitle, TRUE,
+          SA_Draggable, TRUE, TAG_DONE);
+    }
+    if (!own_screen_) {
+      LOG(WARNING) << "[Chromium:Ozone:AROS] cannot open a screen widget="
+                   << widget_ << "; filling the Workbench screen instead";
+      mode = NativeMode::kFullscreen;
+    }
+    screen = own_screen_;
+  } else if (mode == NativeMode::kNormal) {
+    screen = ParentScreen();
+  }
+
+  gfx::Rect client = bounds_;
+  if (mode == NativeMode::kFullscreen) {
+    client = GetPrimaryArosScreenGeometry().bounds;
+  } else if (mode == NativeMode::kOwnScreen) {
+    // Below the screen's title bar, which stays visible to drag the screen.
+    const int top = own_screen_->BarHeight + 1;
+    client = gfx::Rect(0, top, own_screen_->Width,
+                       std::max(1, own_screen_->Height - top));
+  }
+  const bool framed = use_standard_frame_ && mode == NativeMode::kNormal;
+  struct Window* const native = OpenWindowTags(
+      nullptr, screen ? WA_CustomScreen : TAG_IGNORE,
+      reinterpret_cast<IPTR>(screen), WA_Title,
+      reinterpret_cast<IPTR>(framed ? "Chromium" : nullptr), WA_Left,
+      client.x(), WA_Top, client.y(), WA_InnerWidth, client.width(),
+      WA_InnerHeight, client.height(), WA_CloseGadget, framed, WA_DepthGadget,
+      framed, WA_DragBar, framed, WA_SizeGadget, framed, WA_SizeBBottom,
+      framed, framed ? WA_MinWidth : TAG_IGNORE, kMinFramedWidth,
+      framed ? WA_MinHeight : TAG_IGNORE, kMinFramedHeight,
+      framed ? WA_MaxWidth : TAG_IGNORE, static_cast<IPTR>(~0u),
+      framed ? WA_MaxHeight : TAG_IGNORE, static_cast<IPTR>(~0u),
+      WA_Borderless, !framed, WA_Backdrop,
+      mode == NativeMode::kOwnScreen, WA_Activate,
+      visible_ && mode != NativeMode::kNormal, WA_Hidden, !visible_,
+      WA_AutoAdjust, TRUE, WA_SmartRefresh, TRUE, WA_ReportMouse, TRUE,
+      WA_RMBTrap, TRUE, TAG_DONE);
+  if (!native) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS] OpenWindowTags failed widget="
+               << widget_ << " requested=" << client.ToString();
+    return false;
+  }
+  native->UserPort = manager_->event_port();
+  if (!ModifyIDCMP(native, kWindowEventMask)) {
+    native->UserPort = nullptr;
+    CloseWindow(native);
+    LOG(ERROR) << "[Chromium:Ozone:AROS] could not enable IDCMP widget="
+               << widget_;
+    return false;
+  }
+  native_events_enabled_ = true;
+  {
+    base::AutoLock lock(manager_->presentation_lock());
+    window_ = native;
+  }
+  native_mode_ = mode;
+  manager_->AttachNativeWindow(widget_, this, window_);
+  ApplyNativeTitle();
+  UpdateBoundsFromNative(/*notify_delegate=*/false);
+  if (mode == NativeMode::kNormal) {
+    // The window was opened with its outer box at the requested client
+    // origin; its borders were only known once it was open. Move the outer
+    // box so the client area is where it was asked for, within the work area.
+    const gfx::Rect work_area = GetPrimaryArosScreenGeometry().work_area;
+    const gfx::Rect outer = ConstrainClientBoundsToWorkArea(
+        gfx::Rect(client.x() - window_->BorderLeft,
+                  client.y() - window_->BorderTop, bounds_.width(),
+                  bounds_.height()),
+        work_area, window_->BorderLeft, window_->BorderTop,
+        window_->BorderRight, window_->BorderBottom);
+    const int outer_width =
+        outer.width() + window_->BorderLeft + window_->BorderRight;
+    const int outer_height =
+        outer.height() + window_->BorderTop + window_->BorderBottom;
+    if (window_->LeftEdge != outer.x() || window_->TopEdge != outer.y() ||
+        window_->Width != outer_width || window_->Height != outer_height) {
+      ChangeWindowBox(window_, outer.x(), outer.y(), outer_width,
+                      outer_height);
+      UpdateBoundsFromNative(/*notify_delegate=*/false);
+    }
+  }
+  return true;
+}
+
+void ArosWindow::CloseNativeWindow() {
+  if (!window_) {
+    return;
+  }
+  ReturnIntuitionActivationToOwner();
+  DisableNativeEvents();
+  struct Window* const native = window_;
+  manager_->DetachNativeWindow(widget_, this, native);
+  {
+    // The compositor presents into window_ and the backing store under this
+    // lock; neither may disappear under a present in progress.
+    base::AutoLock lock(manager_->presentation_lock());
+    window_ = nullptr;
+    ReleaseNativeBackingStore();
+  }
+  CloseWindow(native);
+}
+
+void ArosWindow::SwitchNativeMode(NativeMode mode) {
+  if (shutting_down_ || !window_ || mode == native_mode_) {
+    return;
+  }
+  const NativeMode old_mode = native_mode_;
+  const gfx::Rect old_bounds = bounds_;
+  scoped_refptr<PlatformCursor> cursor = cursor_;
+  ResetNativeCursor();
+  CloseNativeWindow();
+  if (old_mode == NativeMode::kOwnScreen && own_screen_) {
+    // Fails while a menu or popup is still open on it; the destructor retries.
+    if (CloseScreen(own_screen_)) {
+      own_screen_ = nullptr;
+    }
+  }
+  if (mode == NativeMode::kNormal && restored_bounds_) {
+    bounds_ = *restored_bounds_;
+    restored_bounds_.reset();
+  }
+  if (!OpenNativeWindow(mode) && mode != NativeMode::kNormal) {
+    OpenNativeWindow(NativeMode::kNormal);
+  }
+  if (cursor) {
+    SetCursor(std::move(cursor));
+  }
+  if (visible_ && activatable_) {
+    RequestIntuitionActivation();
+  }
+  LOG(INFO) << "[Chromium:Ozone:AROS] window mode widget=" << widget_ << " "
+            << static_cast<int>(old_mode) << " -> "
+            << static_cast<int>(native_mode_)
+            << " client=" << bounds_.ToString();
+  if (bounds_ != old_bounds) {
+    delegate_->OnBoundsChanged({bounds_.origin() != old_bounds.origin()});
+  }
+}
+
+ArosWindow::~ArosWindow() {
+  shutting_down_ = true;
+  VLOG(1) << "[Chromium:Ozone:AROS] destroying widget=" << widget_
+          << " native=" << window_ << " presented=" << presented_frames_;
+  if (window_) {
+    ResetNativeCursor();
+    CloseNativeWindow();
+  }
+  if (own_screen_) {
+    CloseScreen(own_screen_);
+    own_screen_ = nullptr;
+  }
+  manager_->ClearCaptureWindow(this);
+  manager_->RemoveWindow(widget_, this);
+}
