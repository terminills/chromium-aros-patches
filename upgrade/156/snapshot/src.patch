diff --git a/chrome/app/theme/aros/ChromiumAnyCPU.info.src b/chrome/app/theme/aros/ChromiumAnyCPU.info.src
new file mode 100644
index 0000000000000000000000000000000000000000..91e78916c33c333d01dba29f83cc483180012072
--- /dev/null
+++ b/chrome/app/theme/aros/ChromiumAnyCPU.info.src
@@ -0,0 +1,8 @@
+; Workbench icon for SYS:Applications/Internet/Chromium/Chromium All CPUs.
+;
+; A PROJECT icon run by C:IconX: the launcher is an AmigaDOS script that
+; starts Chromium under SMP-AnyCPU with the tool icon's CHROME_ARG switches
+; (install-layout.sh writes it from Chromium.info.src).
+TYPE = PROJECT
+DEFAULTTOOL = "C:IconX"
+STACK = 10485760
diff --git a/chrome/app/theme/aros/ChromiumDrawer.info.src b/chrome/app/theme/aros/ChromiumDrawer.info.src
new file mode 100644
index 0000000000000000000000000000000000000000..c64e20aafbdfd857998da69f1928e065f4a691c1
--- /dev/null
+++ b/chrome/app/theme/aros/ChromiumDrawer.info.src
@@ -0,0 +1,11 @@
+; Drawer icon for SYS:Applications/Internet/Chromium.
+;
+; Distinct from Chromium.info.src, which is the TOOL icon for the executable
+; *inside* this drawer. Wanderer only shows an object that has its own .info,
+; so without this the Chromium drawer is invisible from Workbench and the
+; program icon inside it cannot be reached at all - the browser is installed
+; and there is no way to get to it without a shell.
+;
+; No tooltypes and no STACK here: those belong to the tool icon. A drawer icon
+; carries only its appearance and the window geometry Wanderer opens it with.
+TYPE = DRAWER
diff --git a/chrome/app/theme/aros/InstallWidevine b/chrome/app/theme/aros/InstallWidevine
new file mode 100644
index 0000000000000000000000000000000000000000..30a6776471547890df9a605e0817acb319e9e269
--- /dev/null
+++ b/chrome/app/theme/aros/InstallWidevine
@@ -0,0 +1,59 @@
+.KEY FROM/A,TO
+.BRA {
+.KET }
+; Copyright (C) 2026, The AROS Development Team. All rights reserved.
+;
+; InstallWidevine - add Google's Widevine CDM to Chromium, so DRM video
+; (Netflix and similar sites) can play.
+;
+; The CDM is Google's and cannot be shipped with AROS. Chromium on AROS
+; uses the Linux x64 CDM unchanged:
+;   1. On a Linux machine with Google Chrome installed, copy the directory
+;      /opt/google/chrome/WidevineCdm to a disk or share AROS can read
+;      (Microsoft Edge's /opt/microsoft/msedge/WidevineCdm works too).
+;   2. On AROS, run:
+;        Execute SYS:Applications/Internet/Chromium/InstallWidevine <dir>
+;      where <dir> is the copied WidevineCdm directory, e.g.
+;        Execute SYS:Applications/Internet/Chromium/InstallWidevine USB0:WidevineCdm
+;   3. Restart Chromium.
+; A second argument installs into another Chromium directory. The Live CD's
+; SYS: is read-only: install AROS to disk first.
+
+FailAt 21
+
+; Default target: the Chromium this script ships next to. (Execute's .DEF
+; left {TO} empty on AROS.)
+IF "{TO}" EQ ""
+    Set dest "SYS:Applications/Internet/Chromium"
+ELSE
+    Set dest "{TO}"
+EndIF
+
+IF NOT EXISTS "{FROM}/manifest.json"
+    Echo "{FROM} is not a WidevineCdm directory (no manifest.json)."
+    Quit 20
+EndIF
+IF NOT EXISTS "{FROM}/_platform_specific/linux_x64/libwidevinecdm.so"
+    Echo "{FROM} has no _platform_specific/linux_x64/libwidevinecdm.so."
+    Echo "Copy WidevineCdm from a 64-bit Linux Chrome, not Windows or macOS."
+    Quit 20
+EndIF
+IF NOT EXISTS "$dest/Chromium"
+    Echo "No Chromium in $dest."
+    Quit 20
+EndIF
+
+IF NOT EXISTS "$dest/WidevineCdm"
+    MakeDir "$dest/WidevineCdm"
+    IF WARN
+        Echo "Cannot create $dest/WidevineCdm (read-only disk?)."
+        Quit 20
+    EndIF
+EndIF
+Copy "{FROM}" TO "$dest/WidevineCdm" ALL CLONE QUIET
+IF WARN
+    Echo "Copying the CDM failed."
+    Quit 20
+EndIF
+
+Echo "Widevine installed in $dest/WidevineCdm. Restart Chromium to use it."
diff --git a/chrome/app/theme/aros/make_workbench_icon.py b/chrome/app/theme/aros/make_workbench_icon.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc47979b6b1d08766a7e79aec992e6cffcd0b92f
--- /dev/null
+++ b/chrome/app/theme/aros/make_workbench_icon.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Renders the AROS Workbench icon image for Chromium.
+
+The Workbench default icon set (Gorilla) draws tools at 64x64 with a dark
+outline and a soft drop shadow, so the Chromium mark is rendered in that
+idiom: the three-segment ring in the Chromium blues, the white inner ring
+and the blue disc, outlined and shadowed.  The image is rasterised at 8x
+and box-filtered down.
+
+    make_workbench_icon.py Chromium.png
+
+`ilbmtoicon Chromium.info.src Chromium.png Chromium.info` turns the result
+into the .info file that the install layout places next to the binary.
+"""
+
+import math
+import sys
+
+from PIL import Image, ImageChops, ImageDraw, ImageFilter
+
+SIZE = 64
+SCALE = 8
+
+# Chromium mark palette.
+SEGMENTS = [(0x0B, 0x57, 0xD0), (0xA8, 0xC7, 0xFA), (0x42, 0x85, 0xF4)]
+INNER = (0x1A, 0x73, 0xE8)
+RING = (0xFF, 0xFF, 0xFF)
+OUTLINE = (0x10, 0x10, 0x10)
+
+
+def polar(cx, cy, r, deg):
+    return (cx + r * math.cos(math.radians(deg)),
+            cy + r * math.sin(math.radians(deg)))
+
+
+def render(size=SIZE, scale=SCALE):
+    px = size * scale
+    cx = cy = px * 0.47
+    outer_r = px * 0.40
+    inner_r = px * 0.165
+    ring_r = px * 0.205
+    outline_w = 1.9 * scale
+
+    img = Image.new("RGBA", (px, px), (0, 0, 0, 0))
+
+    # Drop shadow, offset down-right like the Gorilla tool icons.
+    shadow = Image.new("RGBA", (px, px), (0, 0, 0, 0))
+    ImageDraw.Draw(shadow).ellipse(
+        [cx - outer_r + 3 * scale, cy - outer_r + 4 * scale,
+         cx + outer_r + 3 * scale, cy + outer_r + 4 * scale],
+        fill=(0, 0, 0, 110))
+    shadow = shadow.filter(ImageFilter.GaussianBlur(1.5 * scale))
+    img.alpha_composite(shadow)
+
+    # Three segments: each divider starts on the inner ring and leaves it
+    # tangentially, 120 degrees apart.
+    segments = Image.new("RGBA", (px, px), (0, 0, 0, 0))
+    seg_draw = ImageDraw.Draw(segments)
+    far = px * 3
+    for k in range(3):
+        a0 = 90 + k * 120
+        a1 = a0 + 120
+        t0 = polar(cx, cy, ring_r, a0)
+        t1 = polar(cx, cy, ring_r, a1)
+        d0 = polar(0, 0, 1, a0 + 90)
+        d1 = polar(0, 0, 1, a1 + 90)
+        f0 = (t0[0] + d0[0] * far, t0[1] + d0[1] * far)
+        f1 = (t1[0] + d1[0] * far, t1[1] + d1[1] * far)
+        b0 = math.degrees(math.atan2(f0[1] - cy, f0[0] - cx))
+        b1 = math.degrees(math.atan2(f1[1] - cy, f1[0] - cx))
+        while b1 <= b0:
+            b1 += 360
+        poly = [t0, f0]
+        poly += [polar(cx, cy, far, b0 + (b1 - b0) * i / 24) for i in range(25)]
+        poly += [f1, t1]
+        poly += [polar(cx, cy, ring_r, a1 - 120 * i / 24) for i in range(25)]
+        seg_draw.polygon(poly, fill=SEGMENTS[k] + (255,))
+
+    disc = Image.new("L", (px, px), 0)
+    ImageDraw.Draw(disc).ellipse(
+        [cx - outer_r, cy - outer_r, cx + outer_r, cy + outer_r], fill=255)
+    segments.putalpha(disc)
+
+    # Outline behind the disc.
+    outline = Image.new("RGBA", (px, px), (0, 0, 0, 0))
+    ImageDraw.Draw(outline).ellipse(
+        [cx - outer_r - outline_w, cy - outer_r - outline_w,
+         cx + outer_r + outline_w, cy + outer_r + outline_w],
+        fill=OUTLINE + (255,))
+    img.alpha_composite(outline)
+    img.alpha_composite(segments)
+
+    draw = ImageDraw.Draw(img)
+    draw.ellipse([cx - ring_r, cy - ring_r, cx + ring_r, cy + ring_r],
+                 fill=RING + (255,))
+    draw.ellipse([cx - inner_r, cy - inner_r, cx + inner_r, cy + inner_r],
+                 fill=INNER + (255,))
+
+    # Gloss: a soft highlight across the upper half.
+    gloss = Image.new("RGBA", (px, px), (0, 0, 0, 0))
+    ImageDraw.Draw(gloss).ellipse(
+        [cx - outer_r * 0.85, cy - outer_r * 1.05,
+         cx + outer_r * 0.85, cy - outer_r * 0.05],
+        fill=(255, 255, 255, 70))
+    gloss = gloss.filter(ImageFilter.GaussianBlur(2 * scale))
+    gloss.putalpha(ImageChops.multiply(gloss.getchannel("A"), disc))
+    img.alpha_composite(gloss)
+
+    return img.resize((size, size), Image.BOX)
+
+
+def main(argv):
+    out = argv[1] if len(argv) > 1 else "Chromium.png"
+    render().save(out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
