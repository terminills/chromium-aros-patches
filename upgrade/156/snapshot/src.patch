+namespace base::subtle {
+namespace {
+
+struct SharedRegionData {
+  static constexpr uint64_t kMagic = 0x41524f5353484d31ULL;
+
+  uint64_t magic = kMagic;
+  void* memory = nullptr;
+  void* allocation_base = nullptr;
+  size_t size = 0;
+  size_t allocation_size = 0;
+  size_t allocation_bytes = 0;
+  std::atomic_size_t references{1};
+  bool kernel_pages = false;
+};
+
+struct MappingData {
+  span<uint8_t> mapping;
+  SharedRegionData* region = nullptr;
+  MappingData* next = nullptr;
+};
+
+// A blocking mutex, not a spin: AROS schedules strictly by task priority and
+// the hosted build has one CPU, so a higher-priority thread (the compositor
+// unmapping a frame) spinning on a flag that a preempted lower-priority
+// thread still holds never lets the holder run again - the whole guest sat
+// at 100% in UnmapArosSharedMemory's xchg/test/jne loop.  The pthread mutex
+// sleeps on an exec semaphore instead, the same primitive PartitionAlloc's
+// SpinningMutex uses on this platform.
+pthread_mutex_t g_registry_lock = PTHREAD_MUTEX_INITIALIZER;
+std::atomic_flag g_reported_exec_fallback = ATOMIC_FLAG_INIT;
+MappingData* g_mappings = nullptr;
+
+class RegistryGuard {
+ public:
+  RegistryGuard() { pthread_mutex_lock(&g_registry_lock); }
+  ~RegistryGuard() { pthread_mutex_unlock(&g_registry_lock); }
+};
+
+SharedRegionData* DataFor(ArosSharedMemoryHandle handle) {
+  return static_cast<SharedRegionData*>(handle.region);
+}
+
+bool IsValidRegion(const SharedRegionData* region) {
+  return region && region->magic == SharedRegionData::kMagic &&
+         region->memory && region->size &&
+         region->allocation_size >= region->size;
+}
+
+// Ownership trace from the viz gather_8888 investigation: regions were logged
+// at creation and destruction so a faulting pixel address could be matched to
+// the region that held it. That fault is explained (the exec-slack PROT_NONE
+// memset, fixed in 001f83966d), so the trace is off: every region event was a
+// synchronous serial write, ~200 lines per two-minute run. Set kTraceRegions
+// to re-arm it for the next ownership question.
+constexpr bool kTraceRegions = false;
+
+void TraceRegion(const char* what, const SharedRegionData* region) {
+  if (!kTraceRegions)
+    return;
+  char line[128];
+  snprintf(line, sizeof(line), "[Chromium:shm] %s memory=%p len=%zu refs=%zu\n",
+           what, region->memory, region->allocation_size,
+           region->references.load(std::memory_order_relaxed));
+  ArosKPutStr(line);
+}
+
+void DestroyRegion(SharedRegionData* region) {
+  DCHECK(IsValidRegion(region));
+  TraceRegion("destroy", region);
+  region->magic = 0;
+  if (region->memory) {
+    if (region->kernel_pages) {
+      APTR KernelBase = OpenResource("kernel.resource");
+      if (KernelBase)
+        KrnFreePages(region->memory, region->allocation_size);
+    } else {
+      FreeMem(region->allocation_base, region->allocation_bytes);
+    }
+  }
+  region->~SharedRegionData();
+  FreeMem(region, sizeof(SharedRegionData));
+}
+
+void DropReference(SharedRegionData* region) {
+  DCHECK(region);
+  const size_t previous =
+      region->references.fetch_sub(1, std::memory_order_acq_rel);
+  DCHECK_GT(previous, 0u);
+  if (previous == 1)
+    DestroyRegion(region);
+}
+
+}  // namespace
+
+ArosSharedMemoryHandle CreateArosSharedMemoryHandle(size_t size) {
+  const size_t page_size = GetPageSize();
+  if (size == 0 || size > std::numeric_limits<size_t>::max() - page_size)
+    return {};
+
+  const size_t allocation_size = bits::AlignUp(size, page_size);
+  if (allocation_size > std::numeric_limits<size_t>::max() - page_size + 1)
+    return {};
+
+  APTR KernelBase = OpenResource("kernel.resource");
+  void* memory = KernelBase
+                     ? KrnAllocPages(nullptr, allocation_size,
+                                     MEMF_PUBLIC | MEMF_CLEAR)
+                     : nullptr;
+  const bool kernel_pages = memory != nullptr;
+  void* allocation_base = memory;
+  size_t allocation_bytes = allocation_size;
+  if (!memory) {
+    // Native x86_64 currently exposes kernel.resource before its dynamic page
+    // allocator is enabled. Keep same-address-space sharing functional until
+    // OPAL supplies the MMU-backed region allocator.
+    allocation_bytes = allocation_size + page_size - 1;
+    allocation_base =
+        AllocMem(allocation_bytes, MEMF_PUBLIC | MEMF_CLEAR);
+    if (allocation_base) {
+      const uintptr_t aligned = bits::AlignUp(
+          reinterpret_cast<uintptr_t>(allocation_base), page_size);
+      memory = reinterpret_cast<void*>(aligned);
+    }
+    if (memory && !g_reported_exec_fallback.test_and_set(
+                      std::memory_order_relaxed)) {
+      ArosKPutStr("[Chromium:base] shared memory backend: Exec allocation "
+                  "(kernel pages unavailable)\n");
+    }
+  }
+  if (!memory)
+    return {};
+
+  void* region_storage =
+      AllocMem(sizeof(SharedRegionData), MEMF_PUBLIC | MEMF_CLEAR);
+  if (!region_storage) {
+    if (kernel_pages)
+      KrnFreePages(memory, allocation_size);
+    else
+      FreeMem(allocation_base, allocation_bytes);
+    return {};
+  }
+  auto* region = new (region_storage) SharedRegionData;
+  region->memory = memory;
+  region->allocation_base = allocation_base;
+  region->size = size;
+  region->allocation_size = allocation_size;
+  region->allocation_bytes = allocation_bytes;
+  region->kernel_pages = kernel_pages;
+  TraceRegion("create", region);
+
+  return {region, false};
+}
+
+void RetainArosSharedMemoryHandle(ArosSharedMemoryHandle handle) {
+  if (!handle.region)
+    return;
+  SharedRegionData* region = DataFor(handle);
+  CHECK(IsValidRegion(region));
+  region->references.fetch_add(1, std::memory_order_relaxed);
+}
+
+void ReleaseArosSharedMemoryHandle(ArosSharedMemoryHandle handle) {
+  if (!handle.region)
+    return;
+
+  SharedRegionData* region = DataFor(handle);
+  CHECK(IsValidRegion(region));
+  DropReference(region);
+}
+
+size_t GetArosSharedMemorySize(ArosSharedMemoryHandle handle) {
+  SharedRegionData* region = DataFor(handle);
+  return IsValidRegion(region) ? region->size : 0;
+}
+
+std::optional<span<uint8_t>> MapArosSharedMemory(
+    ArosSharedMemoryHandle handle,
+    bool write_allowed,
+    uint64_t offset,
+    size_t size) {
+  SharedRegionData* region = DataFor(handle);
+  if (!IsValidRegion(region) || size == 0 ||
+      (write_allowed && handle.read_only) || offset > region->size ||
+      size > region->size - static_cast<size_t>(offset)) {
+    return std::nullopt;
+  }
+
+  auto* mapping_data = new (std::nothrow) MappingData;
+  if (!mapping_data)
+    return std::nullopt;
+
+  span<uint8_t> mapping =
+      span(static_cast<uint8_t*>(region->memory) + offset, size);
+  region->references.fetch_add(1, std::memory_order_relaxed);
+  {
+    RegistryGuard guard;
+    mapping_data->mapping = mapping;
+    mapping_data->region = region;
+    mapping_data->next = g_mappings;
+    g_mappings = mapping_data;
+  }
+  return mapping;
+}
+
+void UnmapArosSharedMemory(span<uint8_t> mapping) {
+  if (mapping.empty())
+    return;
+
+  MappingData* found = nullptr;
+  {
+    RegistryGuard guard;
+    MappingData** link = &g_mappings;
+    while (*link && ((*link)->mapping.data() != mapping.data() ||
+                     (*link)->mapping.size() != mapping.size())) {
+      link = &(*link)->next;
+    }
+    if (*link) {
+      found = *link;
+      *link = found->next;
+    }
+  }
+  DCHECK(found);
+  if (!found)
+    return;
+  DropReference(found->region);
+  delete found;
+}
+
+expected<PlatformSharedMemoryRegion, PlatformSharedMemoryRegion::TakeError>
+PlatformSharedMemoryRegion::TakeOrFail(
+    ScopedArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size,
+    const UnguessableToken& guid) {
+  if (!handle.is_valid() || size == 0 ||
+      size > GetArosSharedMemorySize(handle.get()) || !guid) {
+    return {};
+  }
+  auto permissions =
+      CheckPlatformHandlePermissionsCorrespondToMode(handle.get(), mode, size);
+  if (!permissions.has_value())
+    return unexpected(permissions.error());
+  return PlatformSharedMemoryRegion(std::move(handle), mode, size, guid);
+}
+
+ArosSharedMemoryHandle PlatformSharedMemoryRegion::GetPlatformHandle() const {
+  return handle_.get();
+}
+
+bool PlatformSharedMemoryRegion::IsValid() const {
+  return handle_.is_valid();
+}
+
+PlatformSharedMemoryRegion PlatformSharedMemoryRegion::Duplicate() const {
+  if (!IsValid())
+    return {};
+  CHECK_NE(mode_, Mode::kWritable)
+      << "Duplicating a writable shared memory region is prohibited";
+  RetainArosSharedMemoryHandle(handle_.get());
+  return PlatformSharedMemoryRegion(ScopedArosSharedMemoryHandle(handle_.get()),
+                                    mode_, size_, guid_);
+}
+
+bool PlatformSharedMemoryRegion::ConvertToReadOnly() {
+  if (!IsValid())
+    return false;
+  CHECK_EQ(mode_, Mode::kWritable);
+  handle_.set_read_only(true);
+  mode_ = Mode::kReadOnly;
+  return true;
+}
+
+bool PlatformSharedMemoryRegion::ConvertToUnsafe() {
+  if (!IsValid())
+    return false;
+  CHECK_EQ(mode_, Mode::kWritable);
+  handle_.set_read_only(false);
+  mode_ = Mode::kUnsafe;
+  return true;
+}
+
+PlatformSharedMemoryRegion PlatformSharedMemoryRegion::Create(Mode mode,
+                                                              size_t size) {
+  if (size == 0)
+    return {};
+  CHECK_NE(mode, Mode::kReadOnly);
+  ArosSharedMemoryHandle raw = CreateArosSharedMemoryHandle(size);
+  if (!raw.region)
+    return {};
+  return PlatformSharedMemoryRegion(ScopedArosSharedMemoryHandle(raw), mode,
+                                    size, UnguessableToken::Create());
+}
+
+expected<void, PlatformSharedMemoryRegion::TakeError>
+PlatformSharedMemoryRegion::CheckPlatformHandlePermissionsCorrespondToMode(
+    ArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size) {
+  if (!handle.region || size == 0 || size > GetArosSharedMemorySize(handle))
+    return unexpected(TakeError::kInvalidArosRegion);
+  if (mode == Mode::kReadOnly && !handle.read_only)
+    return unexpected(TakeError::kExpectedReadOnlyButNot);
+  if (mode != Mode::kReadOnly && handle.read_only)
+    return unexpected(TakeError::kExpectedWritableButNot);
+  return ok();
+}
+
+PlatformSharedMemoryRegion::PlatformSharedMemoryRegion(
+    ScopedArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size,
+    const UnguessableToken& guid)
+    : handle_(std::move(handle)), mode_(mode), size_(size), guid_(guid) {}
+
+}  // namespace base::subtle
