diff --git a/chrome/app/aros_close_trace.cc b/chrome/app/aros_close_trace.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f0ff06c4b10bffe9e6a36baec96bf6a150bb9179
--- /dev/null
+++ b/chrome/app/aros_close_trace.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "base/threading/platform_thread.h"
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+// Diagnostic: every close() the chrome executable makes goes through here
+// (posixc names it __posixc_close; linked with -Wl,--wrap=__posixc_close). With a global CHROMIUM_CLOSE_TRACE variable
+// (SetEnv), each close of a descriptor above stderr is written to serial
+// with its result, thread and caller, to find who closes a descriptor twice.
+extern "C" int __real___posixc_close(int fd);
+extern "C" int __wrap___posixc_close(int fd) {
+  static int trace = -1;
+  if (trace < 0)
+    // A global AROS variable is a file in ENV:; posixc getenv() only sees
+    // its own per-process environment, so test for the file.
+    trace = access("ENV:CHROMIUM_CLOSE_TRACE", F_OK) == 0 ? 1 : 0;
+  const int ret = __real___posixc_close(fd);
+  if (trace && fd > 2) {
+    const int saved_errno = errno;
+    char line[240];
+    snprintf(line, sizeof(line),
+             "[Chromium:AROS:CloseTrace] pid=%d tid=%lld close(%d)=%d errno=%d "
+             "thread=%s callerrel=%+lld\n",
+             (int)getpid(), (long long)base::PlatformThread::CurrentId(), fd, ret, ret == 0 ? 0 : saved_errno,
+             base::PlatformThread::GetName(),
+             // Relative to this function, so it maps to a symbol in the
+             // unstripped binary whatever address the process loaded at.
+             (long long)((const char*)__builtin_return_address(0) -
+                         (const char*)&__wrap___posixc_close));
+    ArosKPutStr(line);
+    errno = saved_errno;
+  }
+  return ret;
+}
+
+// The open side of the same trace: which task a descriptor was created on,
+// so a close that fails with EBADF can be matched to its open.
+extern "C" int __real___posixc_open(const char* path, int flags, ...);
+extern "C" int __wrap___posixc_open(const char* path, int flags, ...) {
+  int mode = 0;
+  if (flags & O_CREAT) {
+    va_list args;
+    va_start(args, flags);
+    mode = va_arg(args, int);
+    va_end(args);
+  }
+  const int ret = __real___posixc_open(path, flags, mode);
+  static int trace = -1;
+  if (trace < 0)
+    trace = access("ENV:CHROMIUM_CLOSE_TRACE", F_OK) == 0 ? 1 : 0;
+  if (trace) {
+    const int saved_errno = errno;
+    char line[320];
+    snprintf(line, sizeof(line),
+             "[Chromium:AROS:OpenTrace] pid=%d tid=%lld open(%.160s)=%d thread=%s\n",
+             (int)getpid(), (long long)base::PlatformThread::CurrentId(), path ? path : "(null)", ret,
+             base::PlatformThread::GetName());
+    ArosKPutStr(line);
+    errno = saved_errno;
+  }
+  return ret;
+}
diff --git a/chrome/app/aros_codec_threads.cc b/chrome/app/aros_codec_threads.cc
new file mode 100644
index 0000000000000000000000000000000000000000..69c02118524d0a0ea39f37a43b0cd4fbbdb457c1
--- /dev/null
+++ b/chrome/app/aros_codec_threads.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Every pthread_create in the chrome executable comes through here (linked
+// with -Wl,--wrap=pthread_create). PlatformThread's own threads pass straight
+// through - they are placed by MaybePinThreadRoundRobin. Any other thread is
+// one a third-party library started itself (video decoders above all) and is
+// placed by MaybePinForeignThread unless --aros-no-pin-codec-threads is given.
+
+#include <pthread.h>
+#include <stdio.h>
+
+#include "base/threading/platform_thread_internal_posix.h"
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+extern "C" int __real_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg);
+
+extern "C" int __wrap_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg) {
+  if (base::internal::ArosCreatingPlatformThread())
+    return __real_pthread_create(thread, attr, start, arg);
+
+  // Count every foreign thread on serial, placed or not, so a run without
+  // the switch still shows which libraries start threads.
+  {
+    static int foreign = 0;
+    char line[96];
+    snprintf(line, sizeof(line), "[Chromium:SMP] foreign pthread_create #%d\n",
+             ++foreign);
+    ArosKPutStr(line);
+  }
+
+  pthread_attr_t placed;
+  if (attr)
+    placed = *attr;
+  else
+    pthread_attr_init(&placed);
+  base::internal::MaybePinForeignThread(&placed);
+  return __real_pthread_create(thread, &placed, start, arg);
+}
