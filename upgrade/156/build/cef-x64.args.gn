# In-progress full CEF compile configuration; replace the two paths below.
# Rendering/runtime and optimization qualification are still pending.
target_os = "aros"
target_cpu = "x64"
aros_toolchain_root = "/absolute/path/to/gcc16-x64-crosstools"
aros_sysroot = "/absolute/path/to/x64-AROS/Developer"
is_debug = false
symbol_level = 0
is_component_build = false
is_clang = false
use_sysroot = false
use_custom_libcxx = false
enable_rust = true
enable_chromium_prelude = true
treat_warnings_as_errors = false
use_remoteexec = false
use_goma = false
use_ozone = true
ozone_auto_platforms = false
ozone_platform = "aros"
ozone_platform_aros = true
ozone_platform_headless = false
use_aura = true
toolkit_views = true
use_glib = false
use_dbus = false
use_gio = false
use_gtk = false
use_pangocairo = false
use_alsa = false
use_pulseaudio = false
use_bluez = false
use_cups = false
use_udev = false
use_libpci = false
use_nss_certs = false
use_nss_client_certs = false
use_nss_server_certs = false
enable_nacl = false
enable_extensions = true
enable_basic_printing = true
enable_print_preview = true
enable_printing = true
enable_widevine = true
enable_pdf = true
media_use_ffmpeg = false
rtc_use_pipewire = false
icu_use_data_file = false
v8_use_external_startup_data = false
v8_use_aros_library = true
use_v8_context_snapshot = false
enable_base_tracing = true
use_perfetto_client_library = true
enable_perfetto_ipc = false
enable_perfetto_trace_processor_httpd = false
use_perfetto_trace_processor = false
angle_enable_vulkan = true
angle_build_vulkan_system_info = true
angle_shared_libvulkan = false
angle_enable_gl = false
angle_enable_null = true
angle_enable_swiftshader = false
headless_use_embedded_resources = false
headless_enable_commands = true
headless_use_prefs = false
headless_use_policy = false
aros_blink_platform_library_only = false

aros_cef_library_only = true
enable_cef = true
clang_use_chrome_plugins = false
dcheck_always_on = false

# Release builds must not inherit Chromium developer field-trial experiments.
disable_fieldtrial_testing_config = true

# AROS uses the native vulkan.library import library.
angle_use_custom_libvulkan = false
angle_enable_vulkan_validation_layers = false

# Renderer driver-version parsing is built; legacy dynamic system probing is disabled.
angle_enable_vulkan_system_info = false

use_dummy_lastchange = false
