From 51de41664494385b93c5285599b64ecec44bf0b0 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 17 Nov 2026 14:17:06 -0600
Subject: [PATCH] Use native entropy resource for credentials on all
 architectures

---
 workbench/libs/credentials/credentials_crypto.c  | 11 +++++++----
 workbench/libs/credentials/credentials_entropy.c | 12 ++++++++++++
 workbench/libs/credentials/mmakefile.src         |  5 +++--
 3 files changed, 22 insertions(+), 6 deletions(-)
 create mode 100644 workbench/libs/credentials/credentials_entropy.c

diff --git a/workbench/libs/credentials/credentials_crypto.c b/workbench/libs/credentials/credentials_crypto.c
index 816b90a1..bd1f0c9d 100644
--- a/workbench/libs/credentials/credentials_crypto.c
+++ b/workbench/libs/credentials/credentials_crypto.c
@@ -12,7 +12,7 @@
       - SHA-256                (FIPS 180-4)
       - HMAC-SHA256 -> HKDF    (RFC 2104 / RFC 5869)
       - ChaCha20 + Poly1305    (RFC 8439) AEAD for seal/unseal
-      - CSPRNG                 x86_64 RDRAND (hardware RNG)
+      - CSPRNG                 native entropy.resource (host test: RDRAND)
     Poly1305 is the public-domain poly1305-donna (Andrew Moon) 32-bit variant.
 
     NOTE: RFC-8439 / RFC-5869 test-vector self-checks belong in a host unit test
@@ -21,7 +21,7 @@
 
 #include <string.h>
 #include <stdint.h>
-#if defined(__x86_64__) || defined(__i386__)
+#if !defined(__AROS__) && (defined(__x86_64__) || defined(__i386__))
 #include <cpuid.h>
 #endif
 
@@ -337,7 +337,7 @@ int cred_crypto_unseal(const unsigned char key[CRED_KEY_LEN],
 
 /* ============================ CSPRNG (x86_64 RDRAND) ============================ */
 
-#if defined(__x86_64__) || defined(__i386__)
+#if !defined(__AROS__) && (defined(__x86_64__) || defined(__i386__))
 static int rdrand32(uint32_t *v)
 {
     unsigned char ok; int tries = 32;
@@ -352,7 +352,10 @@ static int rdrand32(uint32_t *v)
 int cred_crypto_random(unsigned char *out, int len)
 {
     if (len < 0 || !out) return 0;
-#if defined(__x86_64__) || defined(__i386__)
+#if defined(__AROS__)
+    extern int cred_native_random(unsigned char *, int);
+    return cred_native_random(out, len);
+#elif !defined(__AROS__) && (defined(__x86_64__) || defined(__i386__))
     {
         unsigned int eax, ebx, ecx, edx;
         if (!__get_cpuid(1, &eax, &ebx, &ecx, &edx) || !(ecx & bit_RDRND))
diff --git a/workbench/libs/credentials/credentials_entropy.c b/workbench/libs/credentials/credentials_entropy.c
new file mode 100644
index 00000000..2169e31b
--- /dev/null
+++ b/workbench/libs/credentials/credentials_entropy.c
@@ -0,0 +1,12 @@
+/* Native entropy source shared by all AROS architectures. */
+#include <proto/exec.h>
+#define __ENTROPY_NOLIBBASE__
+#define __ENTROPY_LIBBASE entropy_base
+#include <proto/entropy.h>
+
+int cred_native_random(unsigned char *out, int len)
+{
+    struct Library *entropy_base = OpenResource("entropy.resource");
+    if (!entropy_base || !out || len < 0) return 0;
+    return GetEntropy(out, (ULONG)len) == (LONG)len;
+}
diff --git a/workbench/libs/credentials/mmakefile.src b/workbench/libs/credentials/mmakefile.src
index 5700cc12..5996cb97 100644
--- a/workbench/libs/credentials/mmakefile.src
+++ b/workbench/libs/credentials/mmakefile.src
@@ -1,16 +1,17 @@
 
 include $(SRCDIR)/config/aros.cfg
 
-FILES := credentials_identity credentials_keyring credentials_crypto
+FILES := credentials_identity credentials_keyring credentials_crypto credentials_entropy
 
 USER_CPPFLAGS := -DADEBUG=1
 USER_LDFLAGS := -static
 
 # Keyring sealing uses embedded reference crypto (credentials_crypto.c:
-# ChaCha20-Poly1305 + SHA-256/HMAC/HKDF + RDRAND) -- self-contained, no
+# ChaCha20-Poly1305 + SHA-256/HMAC/HKDF + entropy.resource) -- self-contained, no
 # external crypto library and no C-runtime/relbase baggage, so the module
 # links against nothing beyond the base AROS libs.
 #MM- workbench-libs : workbench-libs-credentials
+#MM- workbench-libs-credentials : kernel-entropy-includes
 %build_module mmake=workbench-libs-credentials \
     modname=credentials modtype=library \
     files="credentials_init $(FILES)"
-- 
2.53.0

