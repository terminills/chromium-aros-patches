+DIR* OpenDirectoryForEnumeration(const FilePath& path) {
+  // AROS opendir selects a free descriptor before acquiring the descriptor
+  // table lock. Another worker can claim that number, and opendir can then
+  // replace its live file. open selects and reserves under the table lock;
+  // fdopendir adopts the already-owned descriptor without allocating another.
+  ScopedFD descriptor(HANDLE_EINTR(
+      open(path.value().c_str(), O_RDONLY | O_DIRECTORY)));
+  if (!descriptor.is_valid())
+    return nullptr;
+  DIR* directory = fdopendir(descriptor.get());
+  if (directory) {
+    descriptor.release();  // closedir now owns the descriptor.
+    return directory;
+  }
+  const int saved_errno = errno;
+  descriptor.reset();
+  errno = saved_errno;
+  return nullptr;
+}
