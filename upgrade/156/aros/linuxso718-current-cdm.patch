+static char *lx_strerror(int error)
+{
+    const char *text = lx_strerror_text(error);
+    struct lso_task *task;
+    if (text) return (char *)text;
+    task = lso_task_get();
+    if (!task) return "Unknown error";
+    snprintf(task->strerror_buffer, sizeof(task->strerror_buffer),
+             "Unknown error %d", error);
+    return task->strerror_buffer;
+}
