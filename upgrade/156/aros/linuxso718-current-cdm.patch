+/* Linux sched_param is one int; do not expose the larger AROS layout. */
+int lx_pthread_getschedparam(unsigned long thread, int *policy, int *priority)
+{
+    struct sched_param native = {0};
+    int native_policy, result;
+    if (!policy || !priority) return LX_EINVAL;
+    result = pthread_getschedparam((pthread_t)thread, &native_policy, &native);
+    if (result) return lso_pthread_ret(result);
+    /* The AROS implementation reports its normal Exec scheduling policy. */
+    *policy = 0; /* Linux SCHED_OTHER */
+    *priority = 0; /* SCHED_OTHER has no realtime scheduling priority. */
+    return 0;
+}
+
+int lx_pthread_getname_np(unsigned long thread, char *name, size_t len)
+{
+    return lso_pthread_ret(pthread_getname_np((pthread_t)thread, name, len));
+}
+
+/* LinuxSO does not deliver POSIX signals. Preserve the guest's per-thread
+ * mask for query/restore operations without modifying AROS Exec signals.
+ * glibc sigset_t is 128 bytes; Linux currently uses its first 64 bits. */
+int lx_pthread_sigmask(int how, const void *set, void *oldset)
+{
+    struct lso_task *task = lso_task_get();
+    uint64_t value = 0, previous;
+    if (!task) return LX_ENOMEM;
+    if (set && (how < 0 || how > 2)) return LX_EINVAL;
+    if (set) memcpy(&value, set, sizeof(value));
+    previous = task->guest_signal_mask;
+    if (set) {
+        value &= ~((1ULL << (9 - 1)) | (1ULL << (19 - 1)));
+        if (how == 0) task->guest_signal_mask |= value;
+        else if (how == 1) task->guest_signal_mask &= ~value;
+        else task->guest_signal_mask = value;
+    }
+    if (oldset) {
+        memset(oldset, 0, 128);
+        memcpy(oldset, &previous, sizeof(previous));
+    }
+    return 0;
+}
