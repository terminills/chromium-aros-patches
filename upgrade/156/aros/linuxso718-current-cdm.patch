+/* fcntl command numbers and status flags differ between Linux and AROS. */
+int lx_fcntl(int fd, int command, ...)
+{
+    int arg = 0, native_command, result, i;
+    if (command == 0 || command == 2 || command == 4 || command == 1030) {
+        __builtin_va_list ap;
+        __builtin_va_start(ap, command);
+        arg = __builtin_va_arg(ap, int);
+        __builtin_va_end(ap);
+    }
+    switch (command) {
+    case 0: native_command = F_DUPFD; break;
+    case 1: native_command = F_GETFD; break;
+    case 2: native_command = F_SETFD; arg = (arg & 1) ? FD_CLOEXEC : 0; break;
+    case 3: native_command = F_GETFL; break;
+    case 4:
+        native_command = F_SETFL;
+        arg = ((arg & LX_O_APPEND) ? O_APPEND : 0) |
+              ((arg & LX_O_NONBLOCK) ? O_NONBLOCK : 0);
+        break;
+    case 1030: native_command = F_DUPFD_CLOEXEC; break;
+    default: lso_set_errno(LX_EINVAL); return -1;
+    }
+    result = fcntl(fd, native_command, arg);
+    if (result < 0) { lso_set_errno_from_aros(); return -1; }
+    if (command == 1) return (result & FD_CLOEXEC) ? 1 : 0;
+    if (command == 3) {
+        int flags = 0;
+        if ((result & O_ACCMODE) == O_WRONLY) flags = LX_O_WRONLY;
+        else if ((result & O_ACCMODE) == O_RDWR) flags = LX_O_RDWR;
+        if (result & O_APPEND) flags |= LX_O_APPEND;
+        if (result & O_NONBLOCK) flags |= LX_O_NONBLOCK;
+        return flags;
+    }
+    if ((command == 0 || command == 1030) && random_slot(fd) >= 0) {
+        for (i = 0; i < LSO_MAX_RANDOM_FDS; ++i) {
+            if (__sync_bool_compare_and_swap(&random_fds[i], 0, result + 1))
+                return result;
+        }
+        close(result); lso_set_errno(LX_EMFILE); return -1;
+    }
+    return result;
+}
