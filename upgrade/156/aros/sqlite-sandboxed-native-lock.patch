 #include "base/numerics/safe_conversions.h"
 #include "sql/sandboxed_vfs.h"
 
+#if BUILDFLAG(IS_AROS)
+#include <errno.h>
+#include <sys/file.h>
+#include "base/posix/eintr_wrapper.h"
+#endif
+
 namespace storage {
+namespace {
+
+base::File::Error SetVfsFileLock(
+    base::File& file, std::optional<base::File::LockMode> mode) {
+#if BUILDFLAG(IS_AROS)
+  // The sandboxed VFS owns this open description until Close(). Use AROS's
+  // description-scoped lock registry; the SDK does not implement F_SETLK.
+  // Keep base::File's record-lock contract unchanged for other consumers.
+  const int operation = !mode ? LOCK_UN
+      : ((*mode == base::File::LockMode::kShared ? LOCK_SH : LOCK_EX) | LOCK_NB);
+  if (HANDLE_EINTR(flock(file.GetPlatformFile(), operation)) == 0) {
+    return base::File::FILE_OK;
+  }
+  return base::File::GetLastFileError();
+#else
+  return mode ? file.Lock(*mode) : file.Unlock();
+#endif
+}
+
+}  // namespace
