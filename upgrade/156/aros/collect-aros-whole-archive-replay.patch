From 492ca54386a621aada129ea3d49763a6118c41c2 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 17 Nov 2026 18:39:18 -0600
Subject: [PATCH] collect-aros: avoid rescanning fully included archives in
 final link

---
 tools/collect-aros/collect-aros.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/tools/collect-aros/collect-aros.c b/tools/collect-aros/collect-aros.c
index f24968ec..fd68f880 100644
--- a/tools/collect-aros/collect-aros.c
+++ b/tools/collect-aros/collect-aros.c
@@ -592,8 +592,28 @@ int main(int argc, char *argv[])
          * duplicate definitions rather than erroring on them.
          */
         libargv[libargc++] = "--allow-multiple-definition";
+        int whole_archive = 0;
+        int state_depth = 0;
+        int *whole_states = xmalloc(sizeof(*whole_states) * argc);
         for (i = 1; i < argc; i++)
         {
+            if (strcmp(argv[i], "--whole-archive") == 0) {
+                whole_archive = 1;
+                continue;
+            }
+            if (strcmp(argv[i], "--no-whole-archive") == 0) {
+                whole_archive = 0;
+                continue;
+            }
+            if (strcmp(argv[i], "--push-state") == 0) {
+                whole_states[state_depth++] = whole_archive;
+                continue;
+            }
+            if (strcmp(argv[i], "--pop-state") == 0) {
+                if (state_depth > 0)
+                    whole_archive = whole_states[--state_depth];
+                continue;
+            }
             if (argv[i][0] != '-')
             {
                 /* re-supply explicit static archives (e.g. libtool convenience
@@ -601,7 +621,8 @@ int main(int argc, char *argv[])
                    by a later -l library may not have been pulled during the plugin
                    stage */
                 size_t l = strlen(argv[i]);
-                if (l > 2 && strcmp(&argv[i][l - 2], ".a") == 0)
+                /* Whole archives are already fully present in tempoutput. */
+                if (!whole_archive && l > 2 && strcmp(&argv[i][l - 2], ".a") == 0)
                     libargv[libargc++] = argv[i];
                 continue;
             }
@@ -616,6 +637,11 @@ int main(int argc, char *argv[])
             }
             else if (argv[i][1] == 'l')
             {
+                if (whole_archive) {
+                    if (argv[i][2] == '\0' && (i + 1) < argc)
+                        ++i;
+                    continue;
+                }
                 /* keep every library, including the separate "-l" "name"
                    form */
                 libargv[libargc++] = argv[i];
@@ -623,6 +649,7 @@ int main(int argc, char *argv[])
                     libargv[libargc++] = argv[++i];
             }
         }
+        free(whole_states);
     }
 
     char **cmdargv;
-- 
2.53.0

