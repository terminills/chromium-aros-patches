@@ -31,6 +31,9 @@
 #include <hidd/gfx.h>
 #include <exec/memory.h>
 #include <proto/exec.h>
+#if defined(__AROSEXEC_SMP__)
+#include <proto/execlock.h>
+#endif
 #include <graphics/scale.h>
 
 #include LC_LIBDEFS_FILE
@@ -296,6 +299,10 @@ struct GfxBase_intern {
      */
     struct MinList              alphapixtabs;
     struct SignalSemaphore      alphapixtabs_sema;
+#if defined(__AROSEXEC_SMP__)
+    struct ExecLockBase          *tof_ExecLockBase;
+    spinlock_t                   tof_lock;
+#endif
 };
 
 struct AlphaPixTabNode
@@ -318,6 +325,24 @@ void internal_QueueDBufInfo(struct DBufInfo *db, struct GfxBase *GfxBase);
 /* Macros */
 
 #define PrivGBase(x)   	    	((struct GfxBase_intern *)x)
+/* Caller disables local interrupts before taking this cross-CPU lock.
+ * Keep stack-based WaitTOF nodes alive throughout interrupt traversal. */
+static inline void gfx_LockTOF(struct GfxBase *base)
+{
+#if defined(__AROSEXEC_SMP__)
+    struct ExecLockBase *ExecLockBase = PrivGBase(base)->tof_ExecLockBase;
+    ObtainLock(&PrivGBase(base)->tof_lock, SPINLOCK_MODE_WRITE, 0);
+#endif
+}
+
+static inline void gfx_UnlockTOF(struct GfxBase *base)
+{
+#if defined(__AROSEXEC_SMP__)
+    struct ExecLockBase *ExecLockBase = PrivGBase(base)->tof_ExecLockBase;
+    ReleaseLock(&PrivGBase(base)->tof_lock, 0);
+#endif
+}
+
