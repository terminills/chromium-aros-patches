diff --git a/rom/graphics/graphics_init.c b/rom/graphics/graphics_init.c
index 8831cb1e..28cc3f69 100644
--- a/rom/graphics/graphics_init.c
+++ b/rom/graphics/graphics_init.c
@@ -45,6 +45,14 @@ static int GfxInit(struct GfxBase *LIBBASE)
 {
     D(bug("[graphics.library] %s()\n", __func__));
 
+#if defined(__AROSEXEC_SMP__)
+    PrivGBase(LIBBASE)->tof_ExecLockBase = OpenResource("execlock.resource");
+    if (!PrivGBase(LIBBASE)->tof_ExecLockBase)
+        return FALSE;
+    PrivGBase(LIBBASE)->tof_lock.lock = SPINLOCK_UNLOCKED;
+    PrivGBase(LIBBASE)->tof_lock.s_Owner = NULL;
+#endif
+
     driver_GetMethodBases(LIBBASE);
 
     D(bug("[graphics.library] %s: obtained method bases\n", __func__));
@@ -190,11 +198,13 @@ AROS_INTH1(TOF_VBlank, struct GfxBase *, GfxBase)
             link = (struct DBufInfo **)&db->dbi_Link1;
     }
 
+    gfx_LockTOF(GfxBase);
     if(!IsListEmpty(&GfxBase->TOF_WaitQ)) {
         ForeachNode(&GfxBase->TOF_WaitQ, tNode) {
             Signal((struct Task *)tNode->ln_Name, SIGF_SINGLE);
         }
     }
+    gfx_UnlockTOF(GfxBase);
 
     return 0;
 
