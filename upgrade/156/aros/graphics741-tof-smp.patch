diff --git a/rom/graphics/waittof.c b/rom/graphics/waittof.c
index 6fac1d75..038f0906 100644
--- a/rom/graphics/waittof.c
+++ b/rom/graphics/waittof.c
@@ -56,9 +56,17 @@
 
     Disable();
 
+    gfx_LockTOF(GfxBase);
     AddTail((struct List *)&GfxBase->TOF_WaitQ, (struct Node *)&wait);
+    gfx_UnlockTOF(GfxBase);
+
+    /* Wait() releases local interrupt exclusion; never hold the spinlock
+     * while sleeping, since the VBlank server needs it to wake us. */
     Wait(SIGF_SINGLE);
+
+    gfx_LockTOF(GfxBase);
     Remove((struct Node *)&wait);
+    gfx_UnlockTOF(GfxBase);
 
     Enable();
 
