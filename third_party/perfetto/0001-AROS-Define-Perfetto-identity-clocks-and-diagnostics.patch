From 0fd560d294f9aaa3c029d41ade8f603344a7d5f2 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 11 Jul 2026 20:01:32 -0500
Subject: [PATCH 1/7] [AROS] Define Perfetto identity, clocks, and diagnostics

AI_PHASE: Chromium Phase 3 tracing substrate
AI_STATUS: Perfetto has an explicit AROS OS identity, monotonic/realtime clock snapshots, and native debug output.
ROOT_CAUSE: Perfetto rejected unknown operating systems and selected clock and stderr contracts that AROS does not provide consistently.
FIX_REASON: Define PERFETTO_OS_AROS, map supported clocks explicitly, and route logs plus pre-crash history through the AROS kernel debug stream.
SCOPE: Perfetto build identity, time primitives, clock snapshots, and logging.
VALIDATION: AROS Perfetto base, clock snapshot, platform, and Chromium tracing objects build in out/aros-headless.
RISK: Thread CPU time remains unavailable and timegm currently uses the process-local mktime fallback.
AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
Continues: ACD-chromium-native-port-roadmap
---
 include/perfetto/base/build_config.h | 15 +++++++++++++++
 include/perfetto/base/time.h         | 28 ++++++++++++++++++++++++++++
 src/base/logging.cc                  | 16 ++++++++++++++++
 src/tracing/core/clock_snapshots.cc  | 18 +++++++++++++++++-
 4 files changed, 76 insertions(+), 1 deletion(-)

diff --git a/include/perfetto/base/build_config.h b/include/perfetto/base/build_config.h
index a0e6bb9..5930c4d 100644
--- a/include/perfetto/base/build_config.h
+++ b/include/perfetto/base/build_config.h
@@ -34,6 +34,17 @@
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_WASM() 0
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_FUCHSIA() 0
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_NACL() 0
+#elif defined(__AROS__)
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_ANDROID() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_LINUX() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_WIN() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_APPLE() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_MAC() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_IOS() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_WASM() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_FUCHSIA() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_NACL() 0
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_AROS() 1
 #elif defined(__APPLE__)
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_ANDROID() 0
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_APPLE() 1
@@ -105,6 +116,10 @@
 #error OS not supported (see build_config.h)
 #endif
 
+#if !defined(PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_AROS)
+#define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_OS_AROS() 0
+#endif
+
 #if defined(__clang__)
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_COMPILER_CLANG() 1
 #define PERFETTO_BUILDFLAG_DEFINE_PERFETTO_COMPILER_GCC() 0
diff --git a/include/perfetto/base/time.h b/include/perfetto/base/time.h
index 3e5b101..73526a7 100644
--- a/include/perfetto/base/time.h
+++ b/include/perfetto/base/time.h
@@ -180,6 +180,32 @@ inline TimeNanos GetBootTimeNs() {
   return TimeNanos(0);
 }
 
+#elif PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+
+constexpr clockid_t kWallTimeClockSource = CLOCK_MONOTONIC;
+
+inline TimeNanos GetTimeInternalNs(clockid_t clk_id) {
+  struct timespec ts = {};
+  PERFETTO_CHECK(clock_gettime(clk_id, &ts) == 0);
+  return FromPosixTimespec(ts);
+}
+
+inline TimeNanos GetBootTimeNs() {
+  return GetTimeInternalNs(kWallTimeClockSource);
+}
+
+inline TimeNanos GetWallTimeNs() {
+  return GetTimeInternalNs(kWallTimeClockSource);
+}
+
+inline TimeNanos GetWallTimeRawNs() {
+  return GetTimeInternalNs(kWallTimeClockSource);
+}
+
+inline TimeNanos GetThreadCPUTimeNs() {
+  return TimeNanos(0);
+}
+
 #else  // posix
 
 constexpr clockid_t kWallTimeClockSource = CLOCK_MONOTONIC;
@@ -249,6 +275,8 @@ inline int64_t TimeGm(struct tm* tms) {
   if (tms)  // Kinda if (true), but avoids "mark as noreturn" errors.
     PERFETTO_FATAL("timegm not supported");
   return -1;
+#elif PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+  return static_cast<int64_t>(mktime(tms));
 #else
   return static_cast<int64_t>(timegm(tms));
 #endif
diff --git a/src/base/logging.cc b/src/base/logging.cc
index fec71db..7858353 100644
--- a/src/base/logging.cc
+++ b/src/base/logging.cc
@@ -33,6 +33,10 @@
 #include "perfetto/ext/base/string_view.h"
 #include "src/base/log_ring_buffer.h"
 
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+#endif
+
 #if PERFETTO_ENABLE_LOG_RING_BUFFER() && PERFETTO_BUILDFLAG(PERFETTO_OS_ANDROID)
 #include <android/set_abort_message.h>
 #endif
@@ -178,6 +182,13 @@ void LogMessage(LogLev level,
   t_sec = t_sec % 1000;
   StackString<32> timestamp("[%03u.%03u] ", t_sec, t_ms);
 
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+  ArosKPutStr(timestamp.c_str());
+  ArosKPutStr(file_and_line.c_str());
+  ArosKPutStr(" ");
+  ArosKPutStr(log_msg);
+  ArosKPutStr("\n");
+#else
   if (use_colors) {
     fprintf(stderr, "%s%s%s%s %s%s%s\n", kLightGray, timestamp.c_str(),
             file_and_line.c_str(), kReset, color, log_msg, kReset);
@@ -185,6 +196,7 @@ void LogMessage(LogLev level,
     fprintf(stderr, "%s%s %s\n", timestamp.c_str(), file_and_line.c_str(),
             log_msg);
   }
+#endif
 
 #if PERFETTO_ENABLE_LOG_RING_BUFFER()
   // Append the message to the ring buffer for crash reporting postmortems.
@@ -222,6 +234,10 @@ void MaybeSerializeLastLogsForCrashReporting() {
   // NOTE: android_set_abort_message() can be called only once. This should
   // be called only when we are sure we are about to crash.
   android_set_abort_message(g_crash_buf);
+#elif PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+  ArosKPutStr("\n-----BEGIN PERFETTO PRE-CRASH LOG-----\n");
+  ArosKPutStr(g_crash_buf);
+  ArosKPutStr("\n-----END PERFETTO PRE-CRASH LOG-----\n");
 #else
   // Print out the message on stderr on Linux/Mac/Win.
   fputs("\n-----BEGIN PERFETTO PRE-CRASH LOG-----\n", stderr);
diff --git a/src/tracing/core/clock_snapshots.cc b/src/tracing/core/clock_snapshots.cc
index 98fe7c5..fb90932 100644
--- a/src/tracing/core/clock_snapshots.cc
+++ b/src/tracing/core/clock_snapshots.cc
@@ -24,7 +24,23 @@ namespace perfetto {
 
 ClockSnapshotVector CaptureClockSnapshots() {
   ClockSnapshotVector snapshot_data;
-#if !PERFETTO_BUILDFLAG(PERFETTO_OS_APPLE) && \
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_AROS)
+  const auto monotonic_ns =
+      static_cast<uint64_t>(base::GetBootTimeNs().count());
+  snapshot_data.push_back(
+      ClockReading(protos::pbzero::BUILTIN_CLOCK_BOOTTIME, monotonic_ns));
+  snapshot_data.push_back(
+      ClockReading(protos::pbzero::BUILTIN_CLOCK_MONOTONIC, monotonic_ns));
+
+  struct timespec realtime = {};
+  if (clock_gettime(CLOCK_REALTIME, &realtime) == 0) {
+    snapshot_data.push_back(ClockReading(
+        protos::pbzero::BUILTIN_CLOCK_REALTIME,
+        static_cast<uint64_t>(base::FromPosixTimespec(realtime).count())));
+  } else {
+    PERFETTO_DLOG("clock_gettime failed for CLOCK_REALTIME");
+  }
+#elif !PERFETTO_BUILDFLAG(PERFETTO_OS_APPLE) && \
     !PERFETTO_BUILDFLAG(PERFETTO_OS_WIN) &&   \
     !PERFETTO_BUILDFLAG(PERFETTO_OS_NACL)
   struct {
