From 9e2ad4e3c6028a464de931fdb9e2cb995efcf31b Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 29 Jul 2026 22:14:19 -0500
Subject: [PATCH 7/7] system_wrappers: query AROS logical CPU count

AI_PHASE: chromium-process-model

AI_STATUS: complete

ROOT_CAUSE: WebRTC treated AROS as an unknown platform and silently forced every media process to one codec core even though kernel.resource exposes the schedulable logical processor count.

FIX_REASON: Query KrnGetCPUCount through the native kernel.resource ABI and retain a one-core fallback only when the resource or reported count is unavailable.

SCOPE: system_wrappers/source/cpu_info.cc

VALIDATION: Chromium chrome rebuild completed 1403/1404 after restoring the interrupted broad-define attempt; subsequent ninja replay reported no work.

RISK: low; other WebRTC platforms are unchanged and AROS now matches Chromium base::SysInfo logical CPU discovery.

AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
---
 system_wrappers/source/cpu_info.cc | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/system_wrappers/source/cpu_info.cc b/system_wrappers/source/cpu_info.cc
index eff7203..a14e1ab 100644
--- a/system_wrappers/source/cpu_info.cc
+++ b/system_wrappers/source/cpu_info.cc
@@ -10,6 +10,8 @@
 
 #include "system_wrappers/include/cpu_info.h"
 
+#include "build/build_config.h"
+
 #if defined(WEBRTC_WIN)
 #include <windows.h>
 #elif defined(WEBRTC_LINUX)
@@ -18,6 +20,9 @@
 #include <sys/sysctl.h>
 #elif defined(WEBRTC_FUCHSIA)
 #include <zircon/syscalls.h>
+#elif BUILDFLAG(IS_AROS)
+#include <proto/exec.h>
+#include <proto/kernel.h>
 #endif
 
 #include "rtc_base/logging.h"
@@ -45,6 +50,13 @@ static int DetectNumberOfCores() {
   }
 #elif defined(WEBRTC_FUCHSIA)
   number_of_cores = zx_system_get_num_cpus();
+#elif BUILDFLAG(IS_AROS)
+  APTR KernelBase = OpenResource("kernel.resource");
+  number_of_cores = KernelBase ? KrnGetCPUCount() : 1;
+  if (number_of_cores <= 0) {
+    RTC_LOG(LS_ERROR) << "Failed to get number of cores";
+    number_of_cores = 1;
+  }
 #else
   RTC_LOG(LS_ERROR) << "No function to get number of cores";
   number_of_cores = 1;
