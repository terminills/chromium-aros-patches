+bool BasicNetworkManager::CreateNetworks(
+    bool include_ignored,
+    std::vector<std::unique_ptr<Network>>* networks) const {
+  std::vector<base::aros::NetworkInterfaceInfo> interfaces;
+  if (!base::aros::GetNetworkInterfaces(&interfaces)) {
+    RTC_LOG_ERR(LS_ERROR) << "AROSTCP failed to gather interface data";
+    return false;
+  }
+
+  std::map<std::string, Network*> current_networks;
+  for (const auto& interface : interfaces) {
+    if (!interface.is_up || !interface.is_running ||
+        (interface.family != AF_INET && interface.family != AF_INET6)) {
+      continue;
+    }
+
+    IPAddress address;
+    IPAddress mask;
+    if (interface.family == AF_INET) {
+      if (interface.address_length != sizeof(in_addr)) {
+        continue;
+      }
+      in_addr native_address = {};
+      memcpy(&native_address, interface.address.data(), sizeof(native_address));
+      address = IPAddress(native_address);
+      if (interface.has_netmask) {
+        in_addr native_mask = {};
+        memcpy(&native_mask, interface.netmask.data(), sizeof(native_mask));
+        mask = IPAddress(native_mask);
+      }
+    } else {
+      if (interface.address_length != sizeof(in6_addr)) {
+        continue;
+      }
+      in6_addr native_address = {};
+      memcpy(&native_address, interface.address.data(), sizeof(native_address));
+      address = IPAddress(native_address);
+      if (IsIgnoredIPv6(allow_mac_based_ipv6_, InterfaceAddress(address))) {
+        continue;
+      }
+      if (interface.has_netmask) {
+        in6_addr native_mask = {};
+        memcpy(&native_mask, interface.netmask.data(), sizeof(native_mask));
+        mask = IPAddress(native_mask);
+      }
+    }
+
+    const int prefix_length =
+        interface.has_netmask ? CountIPMaskBits(mask) : address.Size() * 8;
+    const IPAddress prefix = TruncateIP(address, prefix_length);
+    const InterfaceAddress interface_address(address);
+    const std::string key =
+        MakeNetworkKey(interface.name, prefix, prefix_length);
+    auto existing = current_networks.find(key);
+    if (existing != current_networks.end()) {
+      existing->second->AddIP(interface_address);
+      continue;
+    }
+
+    NetworkMonitorInterface::InterfaceInfo interface_info;
+    if (interface.is_loopback || IPIsLoopback(address)) {
+      interface_info = {
+          .adapter_type = ADAPTER_TYPE_LOOPBACK,
+          .underlying_type_for_vpn = ADAPTER_TYPE_UNKNOWN,
+          .network_preference = NetworkPreference::NEUTRAL,
+          .available = true,
+      };
+    } else if (network_monitor_) {
+      interface_info = network_monitor_->GetInterfaceInfo(interface.name);
+    } else {
+      interface_info = {
+          .adapter_type = GetAdapterTypeFromName(interface.name),
+          .underlying_type_for_vpn = ADAPTER_TYPE_UNKNOWN,
+          .network_preference = NetworkPreference::NEUTRAL,
+          .available = true,
+      };
+    }
+
+    if (interface_info.adapter_type != ADAPTER_TYPE_VPN &&
+        IsConfiguredVpn(prefix, prefix_length)) {
+      interface_info.underlying_type_for_vpn = interface_info.adapter_type;
+      interface_info.adapter_type = ADAPTER_TYPE_VPN;
+    }
+
+    auto network = CreateNetwork(interface.name, interface.name, prefix,
+                                 prefix_length, interface_info.adapter_type);
+    network->set_default_local_address_provider(this);
+    network->set_scope_id(interface.scope_id);
+    network->AddIP(interface_address);
+    network->set_ignored(!interface_info.available || IsIgnoredNetwork(*network));
+    network->set_underlying_type_for_vpn(
+        interface_info.underlying_type_for_vpn);
+    network->set_network_preference(interface_info.network_preference);
+    if (include_ignored || !network->ignored()) {
+      current_networks[key] = network.get();
+      networks->push_back(std::move(network));
+    }
+  }
+  return true;
+}
