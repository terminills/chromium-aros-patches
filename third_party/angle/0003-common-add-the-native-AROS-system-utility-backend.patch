+// system_utils_aros.cpp: Native AROS implementations of system utilities.
+
+#include "common/system_utils.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <time.h>
