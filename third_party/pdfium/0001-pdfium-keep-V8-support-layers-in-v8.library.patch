From b316eb64639d9ea4bb2e7a214c8fede9f40475b6 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 22:34:38 -0500
Subject: [PATCH 1/3] pdfium: keep V8 support layers in v8.library

When AROS consumers select the proven resident V8 import mode, do not pull v8_libplatform (and its v8_libbase dependency) through PDFium FXJS. The v8.library instance owns those support layers together with the engine; PDFium only consumes the V8 ABI.

AI_PHASE: chromium-shared-cef

AI_STATUS: dependency-path-corrected-under-validation

AI_ASSUMPTION: PDFium uses the embedder-supplied v8::Platform and does not require a second local default-platform implementation

AI_VALIDATION: pre-fix gn path showed PDFium FXJS as the sole CEF-to-v8_libplatform path; rejected archive contained exactly 49 V8 support objects

AI_LIMITATIONS: post-change GN generation, zero-V8 archive audit, native cef.library link, and runtime initialization remain pending

AI_EVIDENCE: out/aros-cef-bootstrap/test-artifacts/-coherent-cef-archive-20260725

AI_DECISION_CHAIN:
---
 fxjs/BUILD.gn | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/fxjs/BUILD.gn b/fxjs/BUILD.gn
index e3f62ff..8e46d2a 100644
--- a/fxjs/BUILD.gn
+++ b/fxjs/BUILD.gn
@@ -4,6 +4,7 @@
 
 import("../pdfium.gni")
 import("../testing/test.gni")
+import("//v8/gni/v8.gni")
 
 source_set("fxjs") {
   sources = [
@@ -108,8 +109,10 @@ source_set("fxjs") {
       "../core/fpdfdoc",
       "../core/fxge",
       "//v8",
-      "//v8:v8_libplatform",
     ]
+    if (!is_aros || !v8_use_aros_library) {
+      deps += [ "//v8:v8_libplatform" ]
+    }
     configs += [ "//v8:external_startup_data" ]
     public_deps += [
       "../core/fxcrt",
@@ -232,8 +235,10 @@ if (pdf_enable_v8) {
       configs += [ "../:pdfium_strict_config" ]
       deps = [
         "../core/fxcrt",
-        "//v8:v8_libplatform",
       ]
+      if (!is_aros || !v8_use_aros_library) {
+        deps += [ "//v8:v8_libplatform" ]
+      }
       public_deps = [ "//v8:cppgc" ]
     }
   }
