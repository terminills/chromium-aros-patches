+
+ssize_t CallPread(PlatformFile file,
+                  void* data,
+                  size_t size,
+                  off_t offset) {
+  AutoLock lock(ArosFilePositionLock());
+  const off_t original_offset = HANDLE_EINTR(lseek(file, 0, SEEK_CUR));
+  if (original_offset < 0 || HANDLE_EINTR(lseek(file, offset, SEEK_SET)) < 0)
+    return -1;
