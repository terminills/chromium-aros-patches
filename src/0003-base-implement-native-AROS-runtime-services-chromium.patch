+
+void FormatFrame(char* output,
+                 size_t output_size,
+                 size_t frame,
+                 const void* address,
+                 struct Library* DebugBase) {
+  char* module_name = nullptr;
+  char* symbol_name = nullptr;
+  void* segment_start = nullptr;
+  void* symbol_start = nullptr;
+  struct TagItem tags[] = {
+      {DL_ModuleName, reinterpret_cast<IPTR>(&module_name)},
+      {DL_SegmentStart, reinterpret_cast<IPTR>(&segment_start)},
+      {DL_SymbolName, reinterpret_cast<IPTR>(&symbol_name)},
+      {DL_SymbolStart, reinterpret_cast<IPTR>(&symbol_start)},
+      {TAG_DONE, 0},
+  };
+
+  const bool resolved =
+      DebugBase && DecodeLocationA(const_cast<void*>(address), tags);
+  if (resolved && symbol_name) {
+    const uintptr_t offset =
+        symbol_start ? reinterpret_cast<uintptr_t>(address) -
+                           reinterpret_cast<uintptr_t>(symbol_start)
+                     : 0;
+    std::snprintf(output, output_size, "#%lu %p %s %s+0x%llx\n",
+                  static_cast<unsigned long>(frame), address,
+                  module_name ? module_name : "<unknown>", symbol_name,
+                  static_cast<unsigned long long>(offset));
+    return;
+  }
+
+  if (resolved && module_name) {
+    const uintptr_t offset =
+        segment_start ? reinterpret_cast<uintptr_t>(address) -
+                            reinterpret_cast<uintptr_t>(segment_start)
+                      : 0;
+    std::snprintf(output, output_size, "#%lu %p %s+0x%llx\n",
+                  static_cast<unsigned long>(frame), address, module_name,
+                  static_cast<unsigned long long>(offset));
+    return;
+  }
+
+  std::snprintf(output, output_size, "#%lu %p\n",
+                static_cast<unsigned long>(frame), address);
+}
+
+}  // namespace
+
+bool EnableInProcessStackDumping() {
+  // CPU faults are captured by Exec's unattended alert path. OPAL extends
+  // that path with task, domain, object, and recent-event state.
+  return true;
+}
+
+bool SetStackDumpFirstChanceCallback(bool (*handler)(int,
+                                                      siginfo_t*,
+                                                      void*)) {
+  // Exec owns CPU exception dispatch. Wiring a recoverable first-chance hook
+  // requires an explicit Exec/OPAL trap-handler contract.
+  return false;
+}
+
+size_t CollectStackTrace(const void** trace, size_t count) {
+  if (!trace || count == 0)
+    return 0;
+
+  APTR KernelBase = OpenResource("kernel.resource");
+  if (!KernelBase)
+    return 0;
+
+  APTR frames[StackTrace::kMaxTraces];
+  const ULONG depth = KrnBacktraceFromFrame(
+      __builtin_frame_address(0), frames,
+      static_cast<ULONG>(std::min(count, StackTrace::kMaxTraces)));
+  for (ULONG i = 0; i < depth; ++i)
+    trace[i] = frames[i];
+  return static_cast<size_t>(depth);
+}
+
+void StackTrace::PrintWithPrefix(const char* prefix_string) const {
+  struct Library* DebugBase = OpenLibrary("debug.library", 0);
+  const char* prefix = prefix_string ? prefix_string : "";
+  char line[1024];
+
+  for (size_t i = 0; i < count_; ++i) {
+    if (*prefix)
+      ArosKPutStr(prefix);
+    FormatFrame(line, sizeof(line), i, trace_[i], DebugBase);
+    ArosKPutStr(line);
+  }
+
+  if (DebugBase)
+    CloseLibrary(DebugBase);
+}
+
+void StackTrace::OutputToStreamWithPrefix(std::ostream* os,
+                                          const char* prefix_string) const {
+  struct Library* DebugBase = OpenLibrary("debug.library", 0);
+  const char* prefix = prefix_string ? prefix_string : "";
+  char line[1024];
+
+  for (size_t i = 0; i < count_; ++i) {
+    FormatFrame(line, sizeof(line), i, trace_[i], DebugBase);
+    *os << prefix << line;
+  }
+
+  if (DebugBase)
+    CloseLibrary(DebugBase);
+}
+
+namespace internal {
+
+char* itoa_r(intptr_t value,
+             char* buffer,
+             size_t buffer_size,
+             int base,
+             size_t padding) {
+  if (!buffer || buffer_size == 0 || base < 2 || base > 16)
+    return nullptr;
+
+  char* output = buffer;
+  uintptr_t magnitude = static_cast<uintptr_t>(value);
+  if (value < 0 && base == 10) {
+    if (buffer_size < 2)
+      return nullptr;
+    *output++ = '-';
+    --buffer_size;
+    magnitude = static_cast<uintptr_t>(-(value + 1)) + 1;
+  }
+
+  char reversed[sizeof(uintptr_t) * 8 + 1];
+  size_t digits = 0;
+  do {
+    reversed[digits++] =
+        "0123456789abcdef"[magnitude % static_cast<uintptr_t>(base)];
+    magnitude /= static_cast<uintptr_t>(base);
+  } while (magnitude && digits < sizeof(reversed));
+
+  while (digits < padding && digits < sizeof(reversed))
+    reversed[digits++] = '0';
+  if (digits + 1 > buffer_size) {
+    buffer[0] = '\0';
+    return nullptr;
+  }
+
+  while (digits)
+    *output++ = reversed[--digits];
+  *output = '\0';
+  return buffer;
+}
+
+}  // namespace internal
+}  // namespace base::debug
