new file mode 100644
index 0000000000..01e00d12fe
--- /dev/null
+++ b/base/memory/platform_shared_memory_region_aros.cc
@@ -0,0 +1,292 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/memory/platform_shared_memory_region.h"
+
+#include <atomic>
+#include <limits>
+#include <new>
+
+#pragma push_macro("SCHED_RR")
+#undef SCHED_RR
+#include <aros/kernel.h>
+#pragma pop_macro("SCHED_RR")
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+#include "base/bits.h"
+#include "base/check.h"
+#include "base/memory/page_size.h"
+#include "base/memory/platform_shared_memory_aros.h"
+#include "base/unguessable_token.h"
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+namespace base::subtle {
+namespace {
+
+struct SharedRegionData {
+  void* memory = nullptr;
+  void* allocation_base = nullptr;
+  size_t size = 0;
+  size_t allocation_size = 0;
+  size_t allocation_bytes = 0;
+  size_t references = 1;
+  bool kernel_pages = false;
+  SharedRegionData* next = nullptr;
+};
+
+std::atomic_flag g_registry_lock = ATOMIC_FLAG_INIT;
+std::atomic_flag g_reported_exec_fallback = ATOMIC_FLAG_INIT;
+SharedRegionData* g_regions = nullptr;
+
+class RegistryGuard {
+ public:
+  RegistryGuard() {
+    while (g_registry_lock.test_and_set(std::memory_order_acquire)) {
+    }
+  }
+  ~RegistryGuard() { g_registry_lock.clear(std::memory_order_release); }
+};
+
+SharedRegionData* DataFor(ArosSharedMemoryHandle handle) {
+  return static_cast<SharedRegionData*>(handle.region);
+}
+
+void DestroyRegion(SharedRegionData* region) {
+  if (region->memory) {
+    if (region->kernel_pages) {
+      APTR KernelBase = OpenResource("kernel.resource");
+      if (KernelBase)
+        KrnFreePages(region->memory, region->allocation_size);
+    } else {
+      FreeMem(region->allocation_base, region->allocation_bytes);
+    }
+  }
+  delete region;
+}
+
+SharedRegionData* DropReferenceLocked(SharedRegionData* region) {
+  DCHECK(region);
+  DCHECK_GT(region->references, 0u);
+  if (--region->references)
+    return nullptr;
+
+  SharedRegionData** link = &g_regions;
+  while (*link && *link != region)
+    link = &(*link)->next;
+  if (*link == region)
+    *link = region->next;
+  return region;
+}
+
+}  // namespace
+
+ArosSharedMemoryHandle CreateArosSharedMemoryHandle(size_t size) {
+  const size_t page_size = GetPageSize();
+  if (size == 0 || size > std::numeric_limits<size_t>::max() - page_size)
+    return {};
+
+  const size_t allocation_size = bits::AlignUp(size, page_size);
+  if (allocation_size > std::numeric_limits<size_t>::max() - page_size + 1)
+    return {};
+
+  APTR KernelBase = OpenResource("kernel.resource");
+  void* memory = KernelBase
+                     ? KrnAllocPages(nullptr, allocation_size,
+                                     MEMF_PUBLIC | MEMF_CLEAR)
+                     : nullptr;
+  const bool kernel_pages = memory != nullptr;
+  void* allocation_base = memory;
+  size_t allocation_bytes = allocation_size;
+  if (!memory) {
+    // Native x86_64 currently exposes kernel.resource before its dynamic page
+    // allocator is enabled. Keep same-address-space sharing functional until
+    // OPAL supplies the MMU-backed region allocator.
+    allocation_bytes = allocation_size + page_size - 1;
+    allocation_base =
+        AllocMem(allocation_bytes, MEMF_PUBLIC | MEMF_CLEAR);
+    if (allocation_base) {
+      const uintptr_t aligned = bits::AlignUp(
+          reinterpret_cast<uintptr_t>(allocation_base), page_size);
+      memory = reinterpret_cast<void*>(aligned);
+    }
+    if (memory && !g_reported_exec_fallback.test_and_set(
+                      std::memory_order_relaxed)) {
+      ArosKPutStr("[Chromium:base] shared memory backend: Exec allocation "
+                  "(kernel pages unavailable)\n");
+    }
+  }
+  if (!memory)
+    return {};
+
+  auto* region = new (std::nothrow) SharedRegionData;
+  if (!region) {
+    if (kernel_pages)
+      KrnFreePages(memory, allocation_size);
+    else
+      FreeMem(allocation_base, allocation_bytes);
+    return {};
+  }
+  region->memory = memory;
+  region->allocation_base = allocation_base;
+  region->size = size;
+  region->allocation_size = allocation_size;
+  region->allocation_bytes = allocation_bytes;
+  region->kernel_pages = kernel_pages;
+
+  {
+    RegistryGuard guard;
+    region->next = g_regions;
+    g_regions = region;
+  }
+  return {region, false};
+}
+
+void RetainArosSharedMemoryHandle(ArosSharedMemoryHandle handle) {
+  if (!handle.region)
+    return;
+  RegistryGuard guard;
+  ++DataFor(handle)->references;
+}
+
+void ReleaseArosSharedMemoryHandle(ArosSharedMemoryHandle handle) {
+  if (!handle.region)
+    return;
+
+  SharedRegionData* destroy = nullptr;
+  {
+    RegistryGuard guard;
+    destroy = DropReferenceLocked(DataFor(handle));
+  }
+  if (destroy)
+    DestroyRegion(destroy);
+}
+
+size_t GetArosSharedMemorySize(ArosSharedMemoryHandle handle) {
+  return handle.region ? DataFor(handle)->size : 0;
+}
+
+std::optional<span<uint8_t>> MapArosSharedMemory(
+    ArosSharedMemoryHandle handle,
+    bool write_allowed,
+    uint64_t offset,
+    size_t size) {
+  SharedRegionData* region = DataFor(handle);
+  if (!region || (write_allowed && handle.read_only) || offset > region->size ||
+      size > region->size - static_cast<size_t>(offset)) {
+    return std::nullopt;
+  }
+
+  {
+    RegistryGuard guard;
+    ++region->references;
+  }
+  return make_span(static_cast<uint8_t*>(region->memory) + offset, size);
+}
+
+void UnmapArosSharedMemory(span<uint8_t> mapping) {
+  if (mapping.empty())
+    return;
+
+  const uintptr_t mapping_start =
+      reinterpret_cast<uintptr_t>(mapping.data());
+  const uintptr_t mapping_end = mapping_start + mapping.size();
+  SharedRegionData* destroy = nullptr;
+  {
+    RegistryGuard guard;
+    for (SharedRegionData* region = g_regions; region; region = region->next) {
+      const uintptr_t region_start =
+          reinterpret_cast<uintptr_t>(region->memory);
+      const uintptr_t region_end = region_start + region->allocation_size;
+      if (mapping_start >= region_start && mapping_end <= region_end) {
+        destroy = DropReferenceLocked(region);
+        break;
+      }
+    }
+  }
+  if (destroy)
+    DestroyRegion(destroy);
+}
+
+PlatformSharedMemoryRegion PlatformSharedMemoryRegion::Take(
+    ScopedArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size,
+    const UnguessableToken& guid) {
+  if (!handle.is_valid() || size == 0 ||
+      size > GetArosSharedMemorySize(handle.get()) || !guid) {
+    return {};
+  }
+  CHECK(CheckPlatformHandlePermissionsCorrespondToMode(handle.get(), mode,
+                                                        size));
+  return PlatformSharedMemoryRegion(std::move(handle), mode, size, guid);
+}
+
+ArosSharedMemoryHandle PlatformSharedMemoryRegion::GetPlatformHandle() const {
+  return handle_.get();
+}
+
+bool PlatformSharedMemoryRegion::IsValid() const {
+  return handle_.is_valid();
+}
+
+PlatformSharedMemoryRegion PlatformSharedMemoryRegion::Duplicate() const {
+  if (!IsValid())
+    return {};
+  CHECK_NE(mode_, Mode::kWritable)
+      << "Duplicating a writable shared memory region is prohibited";
+  RetainArosSharedMemoryHandle(handle_.get());
+  return PlatformSharedMemoryRegion(ScopedArosSharedMemoryHandle(handle_.get()),
+                                    mode_, size_, guid_);
+}
+
+bool PlatformSharedMemoryRegion::ConvertToReadOnly() {
+  if (!IsValid())
+    return false;
+  CHECK_EQ(mode_, Mode::kWritable);
+  handle_.set_read_only(true);
+  mode_ = Mode::kReadOnly;
+  return true;
+}
+
+bool PlatformSharedMemoryRegion::ConvertToUnsafe() {
+  if (!IsValid())
+    return false;
+  CHECK_EQ(mode_, Mode::kWritable);
+  handle_.set_read_only(false);
+  mode_ = Mode::kUnsafe;
+  return true;
+}
+
+PlatformSharedMemoryRegion PlatformSharedMemoryRegion::Create(Mode mode,
+                                                              size_t size) {
+  if (size == 0)
+    return {};
+  CHECK_NE(mode, Mode::kReadOnly);
+  ArosSharedMemoryHandle raw = CreateArosSharedMemoryHandle(size);
+  if (!raw.region)
+    return {};
+  return PlatformSharedMemoryRegion(ScopedArosSharedMemoryHandle(raw), mode,
+                                    size, UnguessableToken::Create());
+}
+
+bool PlatformSharedMemoryRegion::CheckPlatformHandlePermissionsCorrespondToMode(
+    ArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size) {
+  if (!handle.region || size == 0 || size > GetArosSharedMemorySize(handle))
+    return false;
+  return mode == Mode::kReadOnly ? handle.read_only : !handle.read_only;
+}
+
+PlatformSharedMemoryRegion::PlatformSharedMemoryRegion(
+    ScopedArosSharedMemoryHandle handle,
+    Mode mode,
+    size_t size,
+    const UnguessableToken& guid)
+    : handle_(std::move(handle)), mode_(mode), size_(size), guid_(guid) {}
+
+}  // namespace base::subtle
