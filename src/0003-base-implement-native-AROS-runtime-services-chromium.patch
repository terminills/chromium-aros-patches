+#include "base/threading/scoped_blocking_call.h"
+
+namespace base {
+
+MemoryMappedFile::MemoryMappedFile() = default;
+
+#if !BUILDFLAG(IS_NACL)
+bool MemoryMappedFile::MapFileRegionToMemory(
+    const MemoryMappedFile::Region& region,
+    Access access) {
+  ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  int64_t file_offset = 0;
+  size_t data_size = 0;
+  if (region == MemoryMappedFile::Region::kWholeFile) {
+    const int64_t file_length = file_.GetLength();
+    if (file_length <= 0 ||
+        !IsValueInRangeForNumericType<size_t>(file_length)) {
+      return false;
+    }
+    data_size = static_cast<size_t>(file_length);
+  } else {
+    file_offset = region.offset;
+    data_size = region.size;
+    if (data_size == 0)
+      return false;
+
+    CheckedNumeric<int64_t> region_end(file_offset);
+    region_end += data_size;
+    if (!region_end.IsValid())
+      return false;
+
+    if (access == READ_WRITE_EXTEND) {
+      if (!AllocateFileRegion(&file_, file_offset, data_size))
+        return false;
+    } else if (file_.GetLength() < region_end.ValueOrDie()) {
+      return false;
+    }
+  }
+
+  const size_t granularity = SysInfo::VMAllocationGranularity();
+  if (granularity == 0)
+    return false;
+
+  CheckedNumeric<size_t> allocation_size(data_size);
+  allocation_size += granularity - 1;
+  allocation_size /= granularity;
+  allocation_size *= granularity;
+  if (!allocation_size.IsValid())
+    return false;
+
+  APTR KernelBase = OpenResource("kernel.resource");
+  if (!KernelBase)
+    return false;
+
+  const size_t rounded_size = allocation_size.ValueOrDie();
+  void* allocation =
+      KrnAllocPages(nullptr, rounded_size, MEMF_PUBLIC | MEMF_CLEAR);
+  if (!allocation)
+    return false;
+
+  span<uint8_t> contents(static_cast<uint8_t*>(allocation), data_size);
+  if (!file_.ReadAndCheck(file_offset, contents)) {
+    KrnFreePages(allocation, rounded_size);
+    return false;
+  }
+
+  allocation_base_ = allocation;
+  allocation_size_ = rounded_size;
+  data_ = static_cast<uint8_t*>(allocation);
+  length_ = data_size;
+  file_offset_ = file_offset;
+  access_ = access;
+  return true;
+}
+#endif
+
+bool MemoryMappedFile::Flush(size_t length, bool sync) {
+  if (!IsValid() || access_ == READ_ONLY || access_ == READ_WRITE_COPY)
+    return true;
+
+  const size_t flush_length = std::min(length, length_);
+  if (!file_.WriteAndCheck(file_offset_,
+                           span<const uint8_t>(data_, flush_length))) {
+    return false;
+  }
+  return !sync || file_.Flush();
+}
+
+void MemoryMappedFile::CloseHandles() {
+  ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  if (allocation_base_) {
+    const bool flushed = Flush(length_, true);
+    DPCHECK(flushed);
+
+    APTR KernelBase = OpenResource("kernel.resource");
+    if (KernelBase)
+      KrnFreePages(allocation_base_, allocation_size_);
+  }
+
+  allocation_base_ = nullptr;
+  allocation_size_ = 0;
+  data_ = nullptr;
+  length_ = 0;
+  file_offset_ = 0;
+  access_ = READ_ONLY;
+  file_.Close();
+}
+
+}  // namespace base
