+                 : EAI_SYSTEM;
+}
+
+bool HaveOnlyLoopbackNetworkInterfaces(bool* only_loopback) {
+  if (!only_loopback) {
+    errno = EINVAL;
+    return false;
+  }
+
+  const int descriptor = Socket(AF_INET, SOCK_DGRAM, 0);
+  if (descriptor < 0) {
+    return false;
+  }
+
+  std::vector<char> buffer(16 * 1024);
+  struct ifconf interfaces = {};
+  interfaces.ifc_len = static_cast<int>(buffer.size());
+  interfaces.ifc_buf = buffer.data();
+  if (SocketIoctl(descriptor, SIOCGIFCONF, &interfaces) < 0) {
+    ArosKPutStr("[Chromium:Net] SIOCGIFCONF interface probe failed\n");
+    SocketClose(descriptor);
+    return false;
+  }
+
+  *only_loopback = true;
+  char* cursor = interfaces.ifc_buf;
+  const char* const end = cursor + interfaces.ifc_len;
+  while (cursor + sizeof(struct ifreq) <= end) {
+    const auto* interface = reinterpret_cast<const struct ifreq*>(cursor);
+    const struct sockaddr* const address = &interface->ifr_addr;
+    size_t entry_size = sizeof(interface->ifr_name) + address->sa_len;
+    entry_size = std::max(entry_size, sizeof(struct ifreq));
+    if (entry_size > static_cast<size_t>(end - cursor)) {
+      break;
+    }
+
+    struct ifreq flags_request = {};
+    std::copy_n(interface->ifr_name, sizeof(flags_request.ifr_name),
+                flags_request.ifr_name);
+    if (SocketIoctl(descriptor, SIOCGIFFLAGS, &flags_request) == 0 &&
+        (flags_request.ifr_flags & IFF_UP) &&
+        !(flags_request.ifr_flags & IFF_LOOPBACK)) {
+      if (address->sa_family == AF_INET) {
+        *only_loopback = false;
+        break;
+      }
+      if (address->sa_family == AF_INET6) {
+        const auto* address_v6 =
+            reinterpret_cast<const struct sockaddr_in6*>(address);
+        if (!IN6_IS_ADDR_LOOPBACK(&address_v6->sin6_addr) &&
+            !IN6_IS_ADDR_LINKLOCAL(&address_v6->sin6_addr)) {
+          *only_loopback = false;
+          break;
+        }
+      }
+    }
+    cursor += entry_size;
+  }
+
+  SocketClose(descriptor);
+  return true;
+}
+
+bool GetNetworkInterfaces(std::vector<NetworkInterfaceInfo>* result) {
+  if (!result) {
+    errno = EINVAL;
+    return false;
+  }
+  result->clear();
+
+  const int descriptor = Socket(AF_INET, SOCK_DGRAM, 0);
+  if (descriptor < 0) {
+    return false;
+  }
+
+  std::vector<char> buffer(64 * 1024);
+  struct ifconf interfaces = {};
+  interfaces.ifc_len = static_cast<int>(buffer.size());
+  interfaces.ifc_buf = buffer.data();
+  if (SocketIoctl(descriptor, SIOCGIFCONF, &interfaces) < 0) {
+    ArosKPutStr("[Chromium:Net] SIOCGIFCONF interface list failed\n");
+    SocketClose(descriptor);
+    return false;
+  }
+
+  char* cursor = interfaces.ifc_buf;
+  const char* const end = cursor + interfaces.ifc_len;
+  while (cursor + sizeof(struct ifreq) <= end) {
+    const auto* native = reinterpret_cast<const struct ifreq*>(cursor);
+    const struct sockaddr* const native_address = &native->ifr_addr;
+    size_t entry_size = sizeof(native->ifr_name) + native_address->sa_len;
+    entry_size = std::max(entry_size, sizeof(struct ifreq));
+    if (entry_size > static_cast<size_t>(end - cursor)) {
+      break;
+    }
+
+    NetworkInterfaceInfo info;
+    info.name.assign(native->ifr_name,
+                     strnlen(native->ifr_name, sizeof(native->ifr_name)));
+
+    struct ifreq query = {};
+    std::copy_n(native->ifr_name, sizeof(query.ifr_name), query.ifr_name);
+    if (SocketIoctl(descriptor, SIOCGIFFLAGS, &query) == 0) {
+      info.flags = static_cast<uint16_t>(query.ifr_flags);
+    }
+
+    query = {};
+    std::copy_n(native->ifr_name, sizeof(query.ifr_name), query.ifr_name);
+    if (SocketIoctl(descriptor, SIOCGIFINDEX, &query) == 0) {
+      info.index = static_cast<uint16_t>(query.ifr_index);
+    }
+
+    info.family = native_address->sa_family;
+    if (info.family == AF_INET) {
+      const auto* address =
+          reinterpret_cast<const struct sockaddr_in*>(native_address);
+      info.address_length = sizeof(address->sin_addr);
+      memcpy(info.address.data(), &address->sin_addr, info.address_length);
+
+      struct ifreq mask_query = {};
+      std::copy_n(native->ifr_name, sizeof(mask_query.ifr_name),
+                  mask_query.ifr_name);
+      if (SocketIoctl(descriptor, SIOCGIFNETMASK, &mask_query) == 0 &&
+          mask_query.ifr_addr.sa_family == AF_INET) {
+        const auto* mask =
+            reinterpret_cast<const struct sockaddr_in*>(&mask_query.ifr_addr);
+        memcpy(info.netmask.data(), &mask->sin_addr, info.address_length);
+        info.has_netmask = true;
+      }
+      result->push_back(std::move(info));
+    } else if (info.family == AF_INET6) {
+      const auto* address =
+          reinterpret_cast<const struct sockaddr_in6*>(native_address);
+      info.address_length = sizeof(address->sin6_addr);
+      memcpy(info.address.data(), &address->sin6_addr, info.address_length);
+
+      struct in6_ifreq mask_query = {};
+      std::copy_n(native->ifr_name, sizeof(mask_query.ifr_name),
+                  mask_query.ifr_name);
+      mask_query.ifr6_addr = *address;
+      if (SocketIoctl(descriptor, SIOCGIFNETMASK_IN6, &mask_query) == 0) {
+        memcpy(info.netmask.data(), &mask_query.ifr6_addr.sin6_addr,
+               info.address_length);
+        info.has_netmask = true;
+      }
+      result->push_back(std::move(info));
+    }
+
+    cursor += entry_size;
+  }
+
+  SocketClose(descriptor);
+  return true;
+}
+
+void ReleaseSocketLibraryForCurrentTask() {
+  Manager().ReleaseForCurrentTask();
+}
+
+}  // namespace base::aros
