+namespace base {
+
+std::unique_ptr<ProcessMetrics> ProcessMetrics::CreateProcessMetrics(
+    ProcessHandle process) {
+  return std::unique_ptr<ProcessMetrics>(new ProcessMetrics(process));
+}
+
+ProcessMetrics::ProcessMetrics(ProcessHandle process) : process_(process) {}
+
+std::optional<TimeDelta> ProcessMetrics::GetCumulativeCPUUsage() {
+  // AROS accounts CPU time per Exec task. Chromium processes include a pool of
+  // tasks, so reporting only the caller would undercount and mislead callers.
+  return std::nullopt;
+}
+
+int ProcessMetrics::GetOpenFdCount() const {
+  if (process_ != GetCurrentProcessHandle())
+    return -1;
+
+  const int limit = GetOpenFdSoftLimit();
+  if (limit < 0)
+    return -1;
+
+  int count = 0;
+  for (int fd = 0; fd < limit; ++fd) {
+    errno = 0;
+    if (fcntl(fd, F_GETFD) >= 0 || errno != EBADF)
+      ++count;
+  }
+  return count;
+}
+
+int ProcessMetrics::GetOpenFdSoftLimit() const {
+  if (process_ != GetCurrentProcessHandle())
+    return -1;
+
+  struct rlimit limit;
+  if (getrlimit(RLIMIT_NOFILE, &limit) != 0)
+    return -1;
+  return saturated_cast<int>(limit.rlim_cur);
+}
+
+Value::Dict SystemMemoryInfoKB::ToDict() const {
+  Value::Dict result;
+  result.Set("total", total);
+  result.Set("free", free);
+  result.Set("swap_total", swap_total);
+  result.Set("swap_free", swap_free);
+  result.Set("swap_used", swap_total - swap_free);
+  return result;
+}
+
+bool GetSystemMemoryInfo(SystemMemoryInfoKB* meminfo) {
+  if (!meminfo)
+    return false;
+
+  meminfo->total = saturated_cast<int>(AvailMem(MEMF_TOTAL) / 1024);
+  meminfo->free = saturated_cast<int>(AvailMem(MEMF_PUBLIC) / 1024);
+  meminfo->swap_total = 0;
+  meminfo->swap_free = 0;
+  return true;
+}
+
+size_t GetSystemCommitCharge() {
+  const size_t total = AvailMem(MEMF_TOTAL);
+  const size_t free = AvailMem(MEMF_PUBLIC);
+  return total > free ? (total - free) / 1024 : 0;
+}
+
+}  // namespace base
