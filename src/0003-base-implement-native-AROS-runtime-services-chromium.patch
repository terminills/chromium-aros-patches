+
+std::unique_ptr<const ModuleCache::Module> ModuleCache::CreateModuleForAddress(
+    uintptr_t address) {
+  struct Library* DebugBase = OpenLibrary("debug.library", 0);
+  if (!DebugBase)
+    return nullptr;
+
+  char* module_name = nullptr;
+  void* segment_start = nullptr;
+  void* segment_end = nullptr;
+  struct TagItem tags[] = {
+      {DL_ModuleName, reinterpret_cast<IPTR>(&module_name)},
+      {DL_SegmentStart, reinterpret_cast<IPTR>(&segment_start)},
+      {DL_SegmentEnd, reinterpret_cast<IPTR>(&segment_end)},
+      {TAG_DONE, 0},
+  };
+
+  const int found = DecodeLocationA(reinterpret_cast<void*>(address), tags);
+  std::unique_ptr<const ModuleCache::Module> module;
+  if (found && segment_start && segment_end && segment_end > segment_start) {
+    module = std::make_unique<ArosModule>(
+        reinterpret_cast<uintptr_t>(segment_start),
+        reinterpret_cast<uintptr_t>(segment_end) -
+            reinterpret_cast<uintptr_t>(segment_start),
+        FilePath(module_name ? module_name : "unknown"));
+  }
+
+  CloseLibrary(DebugBase);
+  return module;
+}
+
+}  // namespace base
