+#include "base/sync_socket.h"
+
+#include <errno.h>
+
+#include "base/files/file_util.h"
+
+namespace base {
+
+bool SyncSocket::CreatePair(SyncSocket* socket_a, SyncSocket* socket_b) {
+  errno = ENOSYS;
+  return false;
+}
+
+void SyncSocket::Close() {
+  handle_.reset();
+}
+
+size_t SyncSocket::Send(span<const uint8_t> data) {
+  if (!IsValid() || data.empty())
+    return 0;
+  return WriteFileDescriptor(handle(), data) ? data.size() : 0;
+}
+
+size_t SyncSocket::Send(const void* buffer, size_t length) {
+  return Send(span<const uint8_t>(static_cast<const uint8_t*>(buffer), length));
+}
+
+size_t SyncSocket::Receive(span<uint8_t> buffer) {
+  if (!IsValid() || buffer.empty())
+    return 0;
+  return ReadFromFD(handle(), as_writable_chars(buffer)) ? buffer.size() : 0;
+}
+
+size_t SyncSocket::Receive(void* buffer, size_t length) {
+  return Receive(span<uint8_t>(static_cast<uint8_t*>(buffer), length));
+}
+
+size_t SyncSocket::ReceiveWithTimeout(span<uint8_t> buffer,
+                                      TimeDelta timeout) {
+  errno = ENOSYS;
+  return 0;
+}
+
+size_t SyncSocket::ReceiveWithTimeout(void* buffer,
+                                      size_t length,
+                                      TimeDelta timeout) {
+  return ReceiveWithTimeout(
+      span<uint8_t>(static_cast<uint8_t*>(buffer), length), timeout);
+}
+
+size_t SyncSocket::Peek() {
+  errno = ENOSYS;
+  return 0;
+}
+
+bool SyncSocket::IsValid() const {
+  return handle_.is_valid();
+}
+
+SyncSocket::Handle SyncSocket::handle() const {
+  return handle_.get();
+}
+
+SyncSocket::Handle SyncSocket::Release() {
+  return handle_.release();
+}
+
+bool CancelableSyncSocket::Shutdown() {
+  if (!IsValid())
+    return false;
+  Close();
+  return true;
+}
+
+size_t CancelableSyncSocket::Send(span<const uint8_t> data) {
+  return SyncSocket::Send(data);
+}
+
+size_t CancelableSyncSocket::Send(const void* buffer, size_t length) {
+  return SyncSocket::Send(buffer, length);
+}
+
+bool CancelableSyncSocket::CreatePair(CancelableSyncSocket* socket_a,
+                                      CancelableSyncSocket* socket_b) {
+  return SyncSocket::CreatePair(socket_a, socket_b);
+}
+
+}  // namespace base
