+typedef time_t SysTime;
+
+SysTime SysTimeFromTimeStruct(struct tm* timestruct, bool is_local) {
+  base::AutoLock locked(*GetSysTimeToTimeStructLock());
+  // AROS mktime() performs the normalized Gregorian-to-UTC conversion. Its
+  // localtime_r() applies the POSIX timezone offset, so add that offset when
+  // converting local broken-down time back to UTC.
+  const time_t utc_fields = mktime(timestruct);
+  if (!is_local)
+    return utc_fields;
+
+  tzset();
+  base::CheckedNumeric<time_t> result = utc_fields;
+  result += timezone;
+  return result.ValueOrDefault(static_cast<time_t>(-1));
+}
+
+void SysTimeToTimeStruct(SysTime t, struct tm* timestruct, bool is_local) {
+  base::AutoLock locked(*GetSysTimeToTimeStructLock());
+  if (is_local)
+    localtime_r(&t, timestruct);
+  else
+    gmtime_r(&t, timestruct);
+}
