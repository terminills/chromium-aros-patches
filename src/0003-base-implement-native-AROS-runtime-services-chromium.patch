+bool GetConfiguredNameServers(std::vector<std::string>* name_servers) {
+  if (!name_servers) {
+    errno = EINVAL;
+    return false;
+  }
+  name_servers->clear();
+
+  Library* const library = CurrentSocketLibrary();
+  if (!library) {
+    return false;
+  }
+  List* const list = __ObtainDomainNameServerList_WB(library);
+  if (!list) {
+    return false;
+  }
+
+  for (Node* node = list->lh_Head; node->ln_Succ; node = node->ln_Succ) {
+    const auto* name_server =
+        reinterpret_cast<const DomainNameServerNode*>(node);
+    if (name_server->dnsn_Address) {
+      name_servers->emplace_back(name_server->dnsn_Address);
+    }
+  }
+  __ReleaseDomainNameServerList_WB(library, list);
+  return true;
+}
+
+int GetAddressInfo(const char* host,
