new file mode 100644
index 0000000000..ce102e66ba
--- /dev/null
+++ b/build/config/aros/base_runtime/base_runtime_probe.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <array>
+#include <cstring>
+
+#include "base/debug/stack_trace.h"
+#include "base/logging.h"
+#include "base/memory/unsafe_shared_memory_region.h"
+#include "base/rand_util.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/time/time.h"
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+namespace {
+
+int Fail(const char* message) {
+  ArosKPutStr("[Chromium:base] FAIL: ");
+  ArosKPutStr(message);
+  ArosKPutStr("\n");
+  return 20;
+}
+
+void Step(const char* message) {
+  ArosKPutStr("[Chromium:base] ");
+  ArosKPutStr(message);
+  ArosKPutStr("\n");
+}
+
+}  // namespace
+
+int main() {
+  Step("native runtime probe started");
+  LOG(INFO) << "Chromium logging is routed through AROS debug output";
+
+  std::array<uint8_t, 32> random_bytes{};
+  base::RandBytes(random_bytes.data(), random_bytes.size());
+  bool any_random_byte = false;
+  for (uint8_t byte : random_bytes)
+    any_random_byte |= byte != 0;
+  if (!any_random_byte)
+    return Fail("entropy.resource returned an all-zero sample");
+  Step("secure random: PASS");
+
+  base::UnsafeSharedMemoryRegion region =
+      base::UnsafeSharedMemoryRegion::Create(8192);
+  if (!region.IsValid())
+    return Fail("shared-memory region creation");
+  base::UnsafeSharedMemoryRegion duplicate = region.Duplicate();
+  if (!duplicate.IsValid())
+    return Fail("shared-memory region duplication");
+
+  auto first_mapping = region.Map();
+  auto second_mapping = duplicate.Map();
+  if (!first_mapping.IsValid() || !second_mapping.IsValid())
+    return Fail("shared-memory region mapping");
+  constexpr char kSharedPayload[] = "AROS shared pages";
+  std::memcpy(first_mapping.memory(), kSharedPayload, sizeof(kSharedPayload));
+  if (std::memcmp(second_mapping.memory(), kSharedPayload,
+                  sizeof(kSharedPayload)) != 0) {
+    return Fail("duplicate mapping did not observe shared writes");
+  }
+  Step("shared-region duplication: PASS");
+
+  base::WaitableEvent event;
+  event.Signal();
+  if (!event.IsSignaled())
+    return Fail("WaitableEvent signal state");
+  event.Reset();
+  if (event.IsSignaled())
+    return Fail("WaitableEvent reset state");
