+namespace base::aros {
+namespace {
+
+struct SocketLibraryEntry {
+  Task* task;
+  Library* library;
+};
+
+class SocketLibraryManager {
+ public:
+  Library* GetForCurrentTask() {
+    Task* const task = FindTask(nullptr);
+    if (!task) {
+      errno = ENETDOWN;
+      return nullptr;
+    }
+
+    AutoLock guard(lock_);
+    const auto existing = std::find_if(
+        entries_.begin(), entries_.end(),
+        [task](const SocketLibraryEntry& entry) { return entry.task == task; });
+    if (existing != entries_.end()) {
+      return existing->library;
+    }
+
+    auto* library = OpenLibrary("bsdsocket.library", 4);
+    if (!library) {
+      errno = ENETDOWN;
+      ArosKPutStr("[Chromium:Net] unable to open bsdsocket.library v4\n");
+      return nullptr;
+    }
+
+    __SetErrnoPtr_WB(library, &errno, sizeof(errno));
+    entries_.push_back({task, library});
+    return library;
+  }
+
+  void ReleaseForCurrentTask() {
+    Task* const task = FindTask(nullptr);
+    Library* library = nullptr;
+    {
+      AutoLock guard(lock_);
+      const auto existing = std::find_if(
+          entries_.begin(), entries_.end(), [task](const SocketLibraryEntry& e) {
+            return e.task == task;
+          });
+      if (existing == entries_.end()) {
+        return;
+      }
+      library = existing->library;
+      entries_.erase(existing);
+    }
+    CloseLibrary(library);
+  }
+
+ private:
+  Lock lock_;
+  std::vector<SocketLibraryEntry> entries_;
+};
+
+SocketLibraryManager& Manager() {
+  static NoDestructor<SocketLibraryManager> manager;
+  return *manager;
+}
+
+Library* CurrentSocketLibrary() {
+  return Manager().GetForCurrentTask();
+}
+
