+bool MatchPattern(const char* pattern, const char* value) {
+  while (*pattern) {
+    if (*pattern == '*') {
+      while (*pattern == '*')
+        ++pattern;
+      if (!*pattern)
+        return true;
+      do {
+        if (MatchPattern(pattern, value))
+          return true;
+      } while (*value++);
+      return false;
+    }
+
+    if (!*value)
+      return false;
+
+    if (*pattern == '?') {
+      ++pattern;
+      ++value;
+      continue;
+    }
+
+    if (*pattern == '[') {
+      const char* class_end = strchr(pattern + 1, ']');
+      if (class_end) {
+        const char* item = pattern + 1;
+        bool negate = false;
+        if (*item == '!' || *item == '^') {
+          negate = true;
+          ++item;
+        }
+
+        bool matched = false;
+        while (item < class_end) {
+          const unsigned char first = static_cast<unsigned char>(*item++);
+          if (item + 1 < class_end && *item == '-') {
+            const unsigned char last =
+                static_cast<unsigned char>(*(item + 1));
+            const unsigned char candidate =
+                static_cast<unsigned char>(*value);
+            matched |= first <= candidate && candidate <= last;
+            item += 2;
+          } else {
+            matched |= first == static_cast<unsigned char>(*value);
+          }
+        }
+
+        if (matched == negate)
+          return false;
+        pattern = class_end + 1;
+        ++value;
+        continue;
+      }
+    }
+
+    if (*pattern++ != *value++)
+      return false;
+  }
+
+  return !*value;
+}
