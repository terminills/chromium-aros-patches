Date: Fri, 24 Jul 2026 14:01:06 -0500
Subject: [PATCH 296/638] cef: apply upstream WebContents embedding hooks

Apply the matching CEF WebContents patch separately. It supplies custom view creation and the observer callbacks that the CEF library source requires.

AI_PHASE: chromium-cef-bootstrap

AI_STATUS: upstream-webcontents-prerequisite-applied

AI_ASSUMPTION: CEF 52dac911 patch files are authoritative for Chromium 124.0.6367.0 integration

AI_VALIDATION: patch_updater.py --reapply --patch=web_contents_1257_1565 completed without rejects

AI_EVIDENCE: test-artifacts/-cef-bootstrap-20260724/10-libcef-static-focused.log

AI_DECISION_CHAIN:; 52dac911; 5ca485f1d7
---
 .../browser/web_contents/web_contents_impl.cc | 22 +++++++++++++++++++
 content/public/browser/web_contents.h         |  6 +++++
 .../public/browser/web_contents_delegate.h    | 10 +++++++++
 .../public/browser/web_contents_observer.h    |  7 ++++++
 4 files changed, 45 insertions(+)

diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index bfb696d170..e1213ba481 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -3521,6 +3521,12 @@ void WebContentsImpl::Init(const WebContents::CreateParams& params,
       params.main_frame_name, GetOpener(), primary_main_frame_policy,
       base::UnguessableToken::Create());
 
+  if (params.view && params.delegate_view) {
+    view_.reset(params.view);
+    render_view_host_delegate_view_ = params.delegate_view;
+  }
+
+  if (!view_) {
   std::unique_ptr<WebContentsViewDelegate> delegate =
       GetContentClient()->browser()->GetWebContentsViewDelegate(this);
 
@@ -3531,6 +3537,7 @@ void WebContentsImpl::Init(const WebContents::CreateParams& params,
     view_ = CreateWebContentsView(this, std::move(delegate),
                                   &render_view_host_delegate_view_);
   }
+  }
   CHECK(render_view_host_delegate_view_);
   CHECK(view_.get());
 
@@ -3726,6 +3733,9 @@ void WebContentsImpl::RenderWidgetCreated(
   OPTIONAL_TRACE_EVENT1("content", "WebContentsImpl::RenderWidgetCreated",
                         "render_widget_host", render_widget_host);
   created_widgets_.insert(render_widget_host);
+
+  observers_.NotifyObservers(
+      &WebContentsObserver::RenderWidgetCreated, render_widget_host);
 }
 
 void WebContentsImpl::RenderWidgetDeleted(
@@ -4549,6 +4559,15 @@ FrameTree* WebContentsImpl::CreateNewWindow(
     create_params.picture_in_picture_options = *(params.pip_options);
   }
 
+  if (delegate_) {
+    delegate_->GetCustomWebContentsView(this,
+                                        params.target_url,
+                                        render_process_id,
+                                        opener->GetRoutingID(),
+                                        &create_params.view,
+                                        &create_params.delegate_view);
+  }
+
   // Check whether there is an available prerendered page for this navigation if
   // this is not for guest. If it exists, take WebContents pre-created for
   // hosting the prerendered page instead of creating new WebContents.
@@ -8820,6 +8839,9 @@ void WebContentsImpl::SetFocusedFrame(FrameTreeNode* node,
   }
 
   CloseListenerManager::DidChangeFocusedFrame(this);
+
+  observers_.NotifyObservers(&WebContentsObserver::OnFrameFocused,
+                             node->current_frame_host());
 }
 
 void WebContentsImpl::DidCallFocus() {
