From 579f13e44c759ff5d7eb3e5f57891c8124ea7688 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 14 Jul 2026 01:29:46 -0500
Subject: [PATCH 202/638] chrome: enable desktop tab helpers on AROS [chromium]
 [aros]

Statement:
The non-Android tab setup already instantiates framebust, browser lookup, HaTS, and shared-highlighting helpers on AROS, but their desktop include group omitted the platform.

Decision:
Admit AROS to the existing Aura desktop helper include set; all corresponding sources already belong to the generic non-Android UI target.

Evidence:
obj/chrome/browser/ui/ui/tab_helpers.o compiles successfully in out/aros-chrome.

Chain:
 first native Chromium window; compile blocker from full Chrome resume 19.
---
 chrome/browser/ui/tab_helpers.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/browser/ui/tab_helpers.cc b/chrome/browser/ui/tab_helpers.cc
index 272366561a..a3081083f3 100644
--- a/chrome/browser/ui/tab_helpers.cc
+++ b/chrome/browser/ui/tab_helpers.cc
@@ -233,7 +233,7 @@
 #endif
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
-    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FUCHSIA)
+    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_AROS)
 #include "chrome/browser/ui/blocked_content/framebust_block_tab_helper.h"
 #include "chrome/browser/ui/browser_finder.h"
 #include "chrome/browser/ui/hats/hats_helper.h"
