 BatchingMediaLog::~BatchingMediaLog() {
+#if BUILDFLAG(IS_AROS)
+  const bool on_task_runner = task_runner_->BelongsToCurrentThread();
+  if (!on_task_runner) {
+    LOG(ERROR) << "[Chromium:AROS:MediaShutdown] BatchingMediaLog destroyed "
+                  "off its task runner during late shutdown; dropping queued "
+                  "events instead of aborting";
+  } else
+#endif
   DCHECK(task_runner_->BelongsToCurrentThread());
   // AddEvent() could be in-flight on some other thread.  Wait for it, and make
   // sure that nobody else calls it.
   InvalidateLog();
 
+#if BUILDFLAG(IS_AROS)
+  if (!on_task_runner) {
+    base::AutoLock auto_lock(lock_);
+    ipc_send_pending_ = false;
+    queued_media_events_.clear();
+    // These handlers own Mojo endpoints that are already past their valid
+    // teardown thread on AROS shutdown.
+    for (auto& handler : event_handlers_) {
+      (void)handler.release();
+    }
+    event_handlers_.clear();
+    last_duration_changed_event_.reset();
+    last_buffering_state_event_.reset();
+    weak_this_.reset();
+    weak_factory_.DetachAndInvalidateOnCurrentSequence();
+    return;
+  }
+#endif
+
   // There's no further chance to handle this, so send them now. This should not
   // be racy since nothing should have a pointer to the media log on another
   // thread by this point.
