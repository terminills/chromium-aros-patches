 #include <devices/timer.h>
@@ -47,6 +51,36 @@ namespace {
 
 constexpr TimeDelta kDosDescriptorPollInterval = Milliseconds(10);
 
+struct LivePumpRegistry {
+  Lock lock;
+  std::vector<MessagePumpAROS*> pumps;
+  bool registered_atexit = false;
+};
+
+LivePumpRegistry& GetLivePumpRegistry() {
+  static NoDestructor<LivePumpRegistry> registry;
+  return *registry;
+}
+
+void RegisterLivePump(MessagePumpAROS* pump) {
+  LivePumpRegistry& registry = GetLivePumpRegistry();
+  AutoLock auto_lock(registry.lock);
+  registry.pumps.push_back(pump);
+  if (!registry.registered_atexit) {
+    std::atexit(&MessagePumpAROS::CleanupLivePumpsAtExit);
+    registry.registered_atexit = true;
+  }
+}
+
+void UnregisterLivePump(MessagePumpAROS* pump) {
+  LivePumpRegistry& registry = GetLivePumpRegistry();
+  AutoLock auto_lock(registry.lock);
+  auto it = std::find(registry.pumps.begin(), registry.pumps.end(), pump);
+  if (it != registry.pumps.end()) {
+    registry.pumps.erase(it);
+  }
+}
+
 fd_owner_t DescriptorOwner(Library* fd_library, int fd) {
   return fd_library ? __FD_GetOwner_WB(fd_library, fd) : FD_OWNER_NONE;
 }
@@ -112,9 +146,20 @@ MessagePumpAROS::MessagePumpAROS() {
   LOG(INFO) << "[Chromium:IO] AROS WaitSelect/Exec/timer.device pump task="
             << pump_task_ << " wake-signal=" << wakeup_signal_
             << " timer-signal=" << static_cast<int>(timer_port_->mp_SigBit);
+  RegisterLivePump(this);
 }
 
 MessagePumpAROS::~MessagePumpAROS() {
+  UnregisterLivePump(this);
+  ReleaseNativeResources();
+}
+
+void MessagePumpAROS::ReleaseNativeResources() {
+  if (native_resources_released_) {
+    return;
+  }
+  native_resources_released_ = true;
+
   while (!controllers_.empty()) {
     controllers_.back()->StopWatchingFileDescriptor();
   }
@@ -128,15 +173,39 @@ MessagePumpAROS::~MessagePumpAROS() {
     }
     CloseDevice(request);
     DeleteIORequest(request);
+    timer_request_ = nullptr;
+    timer_pending_ = false;
   }
   if (timer_port_) {
     DeleteMsgPort(timer_port_);
+    timer_port_ = nullptr;
   }
   if (wakeup_signal_ >= 0) {
     FreeSignal(wakeup_signal_);
+    wakeup_signal_ = -1;
+    wakeup_mask_ = 0;
   }
   if (fd_library_) {
     CloseLibrary(fd_library_);
+    fd_library_ = nullptr;
+  }
+}
+
+void MessagePumpAROS::CleanupLivePumpsAtExit() {
+  std::vector<MessagePumpAROS*> pumps;
+  {
+    LivePumpRegistry& registry = GetLivePumpRegistry();
+    AutoLock auto_lock(registry.lock);
+    pumps = registry.pumps;
+    registry.pumps.clear();
+  }
+
+  for (MessagePumpAROS* pump : pumps) {
+    if (pump) {
+      LOG(ERROR) << "[Chromium:AROS:MessagePump] releasing live pump native "
+                    "resources at process exit";
+      pump->ReleaseNativeResources();
+    }
   }
 }
 
