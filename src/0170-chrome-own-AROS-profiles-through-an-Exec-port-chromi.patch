diff --git a/chrome/browser/process_singleton_aros.cc b/chrome/browser/process_singleton_aros.cc
new file mode 100644
index 0000000000..911a59440e
--- /dev/null
+++ b/chrome/browser/process_singleton_aros.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/process_singleton.h"
+
+#include <cstdint>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "base/strings/stringprintf.h"
+
+#include <exec/ports.h>
+#include <proto/exec.h>
+
+namespace {
+
+uint64_t HashProfilePath(const base::FilePath& path) {
+  uint64_t hash = UINT64_C(14695981039346656037);
+  for (unsigned char byte : path.value()) {
+    hash ^= byte;
+    hash *= UINT64_C(1099511628211);
+  }
+  return hash;
+}
+
+}  // namespace
+
+ProcessSingleton::ProcessSingleton(
+    const base::FilePath& user_data_dir,
+    const NotificationCallback& notification_callback)
+    : notification_callback_(notification_callback),
+      port_name_(base::StringPrintf(
+          "CHROMIUM.SINGLETON.%016llx",
+          static_cast<unsigned long long>(HashProfilePath(user_data_dir)))) {}
+
+ProcessSingleton::~ProcessSingleton() {
+  Cleanup();
+}
+
+ProcessSingleton::NotifyResult ProcessSingleton::NotifyOtherProcessOrCreate() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return Create() ? PROCESS_NONE : PROFILE_IN_USE;
+}
+
+bool ProcessSingleton::Create() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (singleton_port_) {
+    return true;
+  }
+
+  MsgPort* candidate = CreateMsgPort();
+  if (!candidate) {
+    LOG(ERROR) << "[Chromium:AROS] could not allocate browser singleton port";
+    return false;
+  }
+  candidate->mp_Node.ln_Name = const_cast<char*>(port_name_.c_str());
+
+  Forbid();
+  const bool profile_in_use = FindPort(port_name_.c_str()) != nullptr;
+  if (!profile_in_use) {
+    AddPort(candidate);
+    singleton_port_ = candidate;
+  }
+  Permit();
+
+  if (profile_in_use) {
+    candidate->mp_Node.ln_Name = nullptr;
+    DeleteMsgPort(candidate);
+    LOG(ERROR) << "[Chromium:AROS] browser profile already owns port "
+               << port_name_;
+    return false;
+  }
+
+  LOG(INFO) << "[Chromium:AROS] browser profile owns port " << port_name_;
+  return true;
+}
+
+void ProcessSingleton::StartWatching() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // The named port establishes ownership. A later protocol will forward a
+  // second invocation's command line through this same native boundary.
+}
+
+void ProcessSingleton::Cleanup() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!singleton_port_) {
+    return;
+  }
+
+  RemPort(singleton_port_);
+  singleton_port_->mp_Node.ln_Name = nullptr;
+  DeleteMsgPort(singleton_port_);
+  singleton_port_ = nullptr;
+}
+
+ProcessSingleton::NotifyResult ProcessSingleton::NotifyOtherProcess() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  Forbid();
+  const bool profile_in_use = FindPort(port_name_.c_str()) != nullptr;
+  Permit();
+  return profile_in_use ? PROFILE_IN_USE : PROCESS_NONE;
+}
