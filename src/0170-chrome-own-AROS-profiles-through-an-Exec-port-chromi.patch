 chrome/browser/process_singleton.h       |  15 +++-
 chrome/browser/process_singleton_aros.cc | 104 +++++++++++++++++++++++
 3 files changed, 122 insertions(+), 4 deletions(-)
 create mode 100644 chrome/browser/process_singleton_aros.cc

