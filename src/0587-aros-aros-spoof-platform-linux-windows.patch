@@ -445,6 +449,16 @@ std::string GetPlatformForUAMetadata() {
 # else
   return "Chromium OS";
 # endif
+#elif BUILDFLAG(IS_AROS)
+  switch (base::aros::GetSpoofedPlatform()) {
+    case base::aros::SpoofedPlatform::kLinux:
+      return "Linux";
+    case base::aros::SpoofedPlatform::kWindows:
+      return "Windows";
+    case base::aros::SpoofedPlatform::kNone:
+      break;
+  }
+  return std::string(version_info::GetOSType());
 #else
   return std::string(version_info::GetOSType());
 #endif
@@ -508,6 +522,14 @@ blink::UserAgentMetadata GetUserAgentMetadata(const PrefService* pref_service,
   base::SysInfo::OperatingSystemVersionNumbers(&major, &minor, &bugfix);
   metadata.platform_version =
       base::StringPrintf("%d.%d.%d", major, minor, bugfix);
+#if BUILDFLAG(IS_AROS)
+  // A spoofed Windows reports the version Windows 10 does; a spoofed Linux
+  // keeps ours, which is as opaque as any kernel version.
+  if (base::aros::GetSpoofedPlatform() ==
+      base::aros::SpoofedPlatform::kWindows) {
+    metadata.platform_version = "10.0.0";
+  }
+#endif
 #endif
   metadata.architecture = content::GetCpuArchitecture();
   metadata.bitness = content::GetCpuBitness();
