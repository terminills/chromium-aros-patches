 base/aros/platform_spoof.cc                   | 42 +++++++++++++++++++
 base/aros/platform_spoof.h                    | 28 +++++++++++++
 .../embedder_support/user_agent_utils.cc      | 22 ++++++++++
 .../renderer_host/render_process_host_impl.cc |  8 ++++
 content/common/user_agent.cc                  | 29 ++++++++++++-
 .../blink/renderer/core/frame/navigator_id.cc | 15 +++++++
 7 files changed, 145 insertions(+), 1 deletion(-)
 create mode 100644 base/aros/platform_spoof.cc
