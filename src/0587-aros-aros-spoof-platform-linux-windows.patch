diff --git a/base/aros/platform_spoof.cc b/base/aros/platform_spoof.cc
new file mode 100644
index 0000000000..e068b0d174
--- /dev/null
+++ b/base/aros/platform_spoof.cc
@@ -0,0 +1,42 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/aros/platform_spoof.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+
+namespace base::aros {
+
+namespace {
+
+SpoofedPlatform ReadSpoofedPlatform() {
+  const CommandLine* command_line = CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kSpoofPlatformSwitch)) {
+    return SpoofedPlatform::kNone;
+  }
+  const std::string value =
+      ToLowerASCII(command_line->GetSwitchValueASCII(kSpoofPlatformSwitch));
+  if (value == "linux") {
+    return SpoofedPlatform::kLinux;
+  }
+  if (value == "windows") {
+    return SpoofedPlatform::kWindows;
+  }
+  LOG(WARNING) << "Ignored unknown value for flag --" << kSpoofPlatformSwitch
+               << "=" << value << " (linux|windows)";
+  return SpoofedPlatform::kNone;
+}
+
+}  // namespace
+
+SpoofedPlatform GetSpoofedPlatform() {
+  static const SpoofedPlatform platform = ReadSpoofedPlatform();
+  return platform;
+}
+
+}  // namespace base::aros
diff --git a/base/aros/platform_spoof.h b/base/aros/platform_spoof.h
new file mode 100644
index 0000000000..6e7a10f44d
--- /dev/null
+++ b/base/aros/platform_spoof.h
@@ -0,0 +1,28 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_AROS_PLATFORM_SPOOF_H_
+#define BASE_AROS_PLATFORM_SPOOF_H_
+
+#include "base/base_export.h"
+
+namespace base::aros {
+
+// --aros-spoof-platform=linux|windows presents the browser as that OS
+// wherever a site can read the platform: the User-Agent string, the UA
+// client hints (Sec-CH-UA-Platform and navigator.userAgentData) and
+// navigator.platform.  Sites gate features on an allow-list of operating
+// systems, so an honest "AROS" gets a page that never tries; the switch is
+// for testing such pages before they know about us.  Off by default.
+inline constexpr char kSpoofPlatformSwitch[] = "aros-spoof-platform";
+
+enum class SpoofedPlatform { kNone, kLinux, kWindows };
+
+// The switch on this process's command line; read once, so the value is
+// stable for the life of the process.  Unknown values count as kNone.
+BASE_EXPORT SpoofedPlatform GetSpoofedPlatform();
+
+}  // namespace base::aros
+
+#endif  // BASE_AROS_PLATFORM_SPOOF_H_
