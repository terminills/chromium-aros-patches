From 6c22c78c152d7187f7608fe992a8e94d73d53716 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 15:20:53 -0500
Subject: [PATCH 309/638] cef: expose persistent profile thread detach

Apply CEF's upstream metrics_system_profile patch as a discrete prerequisite for Chrome runtime shutdown.

AI_PHASE: chromium-cef-bootstrap

AI_STATUS: upstream-metrics-lifecycle-prerequisite-applied

AI_ASSUMPTION: CEF 52dac911 patch stack is authoritative for Chromium 124.0.6367.0 integration

AI_VALIDATION: libcef_static reported missing GlobalPersistentSystemProfile::DetachFromCurrentThread

AI_EVIDENCE: test-artifacts/-cef-bootstrap-20260724/13-libcef-static-after-core-cef-patches.log

AI_DECISION_CHAIN:; 52dac911; be5a1a4313
---
 components/metrics/persistent_system_profile.cc | 4 ++++
 components/metrics/persistent_system_profile.h  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/components/metrics/persistent_system_profile.cc b/components/metrics/persistent_system_profile.cc
index 2aab2aefb3..7922807fac 100644
--- a/components/metrics/persistent_system_profile.cc
+++ b/components/metrics/persistent_system_profile.cc
@@ -393,6 +393,10 @@ bool PersistentSystemProfile::GetSystemProfile(
   return true;
 }
 
+void PersistentSystemProfile::DetachFromCurrentThread() {
+  DETACH_FROM_THREAD(thread_checker_);
+}
+
 // static
 void PersistentSystemProfile::MergeUpdateRecords(
     const base::PersistentMemoryAllocator& memory_allocator,
diff --git a/components/metrics/persistent_system_profile.h b/components/metrics/persistent_system_profile.h
index fc173051fb..3fcc43880e 100644
--- a/components/metrics/persistent_system_profile.h
+++ b/components/metrics/persistent_system_profile.h
@@ -64,6 +64,10 @@ class PersistentSystemProfile {
       const base::PersistentMemoryAllocator& memory_allocator,
       SystemProfileProto* system_profile);
 
+  // Detaches this object from the current thread in preparation for a move to
+  // a different thread.
+  void DetachFromCurrentThread();
+
  private:
   friend class PersistentSystemProfileTest;
 
