From 3940c07c77138849b8ff7126357a9b329b8c1ad8 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 15:29:33 -0500
Subject: [PATCH 315/638] cef: expose Blink DevTools lifecycle hooks

Apply CEF's upstream webkit_plugin_info_2015 patch as the paired Blink prerequisite for the Content renderer lifecycle hooks.

AI_PHASE: chromium-cef-bootstrap

AI_STATUS: upstream-blink-devtools-prerequisite-applied

AI_ASSUMPTION: CEF content_2015 and webkit_plugin_info_2015 form one required cross-layer API pair

AI_VALIDATION: build 15 stopped only because RendererBlinkPlatformImpl DevTools methods did not override Blink Platform

AI_EVIDENCE: test-artifacts/-cef-bootstrap-20260724/15-libcef-static-after-second-cef-patch-batch.log

AI_DECISION_CHAIN:; 52dac911; 526a58dab6
---
 third_party/blink/public/platform/platform.h                 | 5 +++++
 .../blink/renderer/core/inspector/devtools_session.cc        | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/third_party/blink/public/platform/platform.h b/third_party/blink/public/platform/platform.h
index 165bd4eae9..dd4d7af0a5 100644
--- a/third_party/blink/public/platform/platform.h
+++ b/third_party/blink/public/platform/platform.h
@@ -784,6 +784,11 @@ class BLINK_PLATFORM_EXPORT Platform {
   }
 #endif
 
+  // DevTools ------------------------------------------------------------
+
+  virtual void DevToolsAgentAttached() {}
+  virtual void DevToolsAgentDetached() {}
+
  private:
   static void InitializeMainThreadCommon(
       Platform* platform,
diff --git a/third_party/blink/renderer/core/inspector/devtools_session.cc b/third_party/blink/renderer/core/inspector/devtools_session.cc
index 912eb64343..ae58f9e103 100644
--- a/third_party/blink/renderer/core/inspector/devtools_session.cc
+++ b/third_party/blink/renderer/core/inspector/devtools_session.cc
@@ -11,6 +11,7 @@
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/single_thread_task_runner.h"
 #include "base/trace_event/trace_event.h"
+#include "third_party/blink/public/platform/platform.h"
 #include "third_party/blink/renderer/bindings/core/v8/script_controller.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
 #include "third_party/blink/renderer/core/inspector/devtools_agent.h"
@@ -169,6 +170,7 @@ DevToolsSession::DevToolsSession(
     for (wtf_size_t i = 0; i < agents_.size(); i++)
       agents_[i]->Restore();
   }
+  Platform::Current()->DevToolsAgentAttached();
 }
 
 DevToolsSession::~DevToolsSession() {
@@ -214,6 +216,7 @@ void DevToolsSession::Detach() {
   agents_.clear();
   v8_session_.reset();
   agent_->client_->DebuggerTaskFinished();
+  Platform::Current()->DevToolsAgentDetached();
 }
 
 void DevToolsSession::DetachFromV8() {
