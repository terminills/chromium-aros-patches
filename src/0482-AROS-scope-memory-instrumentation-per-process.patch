From 9a74e147a893c2a4585b7ab8d7e4c88d762d16cf Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 1 Aug 2026 19:28:06 -0500
Subject: [PATCH 482/638] AROS: scope memory instrumentation per process

Key Chromium memory instrumentation singletons by the current process command-line instance on AROS. Multiple native child processes share an address space, so unqualified globals otherwise collide even though each child has its own runtime identity.



---
 .../client_process_impl.cc                    | 35 +++++++++++++++++++
 .../memory_instrumentation.cc                 | 32 +++++++++++++++++
 2 files changed, 67 insertions(+)

diff --git a/services/resource_coordinator/public/cpp/memory_instrumentation/client_process_impl.cc b/services/resource_coordinator/public/cpp/memory_instrumentation/client_process_impl.cc
index 0fc1c14aae..0f92bb32a6 100644
--- a/services/resource_coordinator/public/cpp/memory_instrumentation/client_process_impl.cc
+++ b/services/resource_coordinator/public/cpp/memory_instrumentation/client_process_impl.cc
@@ -4,9 +4,13 @@
 
 #include "services/resource_coordinator/public/cpp/memory_instrumentation/client_process_impl.h"
 
+#include <map>
+
+#include "base/command_line.h"
 #include "base/containers/flat_map.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
 #include "base/strings/string_piece.h"
 #include "base/synchronization/lock.h"
 #include "base/task/single_thread_task_runner.h"
@@ -18,6 +22,33 @@
 #include "services/resource_coordinator/public/mojom/memory_instrumentation/memory_instrumentation.mojom.h"
 
 namespace memory_instrumentation {
+namespace {
+
+#if BUILDFLAG(IS_AROS)
+struct ClientProcessRegistry {
+  base::Lock lock;
+  std::map<const base::CommandLine*, ClientProcessImpl*> instances;
+};
+
+ClientProcessImpl*& GetClientProcessForCurrentProcess() {
+  const base::CommandLine* const process_identity =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? base::CommandLine::ForCurrentProcess()
+          : nullptr;
+  thread_local const base::CommandLine* cached_identity = nullptr;
+  thread_local ClientProcessImpl** cached_instance = nullptr;
+  if (cached_instance && cached_identity == process_identity)
+    return *cached_instance;
+
+  static base::NoDestructor<ClientProcessRegistry> registry;
+  base::AutoLock lock(registry->lock);
+  cached_identity = process_identity;
+  cached_instance = &registry->instances[process_identity];
+  return *cached_instance;
+}
+#endif
+
+}  // namespace
 
 // static
 void ClientProcessImpl::CreateInstance(
@@ -29,7 +60,11 @@ void ClientProcessImpl::CreateInstance(
   if (!is_browser_process)
     coordinator.reset();
 
+#if BUILDFLAG(IS_AROS)
+  ClientProcessImpl*& instance = GetClientProcessForCurrentProcess();
+#else
   static ClientProcessImpl* instance = nullptr;
+#endif
   if (!instance) {
     instance = new ClientProcessImpl(
         std::move(receiver), std::move(coordinator), is_browser_process,
diff --git a/services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.cc b/services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.cc
index 6ee3198d09..da71f3fd3f 100644
--- a/services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.cc
+++ b/services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.cc
@@ -4,12 +4,44 @@
 
 #include "services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.h"
 
+#include <map>
+
+#include "base/command_line.h"
 #include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "build/build_config.h"
 
 namespace memory_instrumentation {
 namespace {
 
+#if BUILDFLAG(IS_AROS)
+struct MemoryInstrumentationRegistry {
+  base::Lock lock;
+  std::map<const base::CommandLine*, MemoryInstrumentation*> instances;
+};
+
+MemoryInstrumentation*& GetMemoryInstrumentationForCurrentProcess() {
+  const base::CommandLine* const process_identity =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? base::CommandLine::ForCurrentProcess()
+          : nullptr;
+  thread_local const base::CommandLine* cached_identity = nullptr;
+  thread_local MemoryInstrumentation** cached_instance = nullptr;
+  if (cached_instance && cached_identity == process_identity)
+    return *cached_instance;
+
+  static base::NoDestructor<MemoryInstrumentationRegistry> registry;
+  base::AutoLock lock(registry->lock);
+  cached_identity = process_identity;
+  cached_instance = &registry->instances[process_identity];
+  return *cached_instance;
+}
+
+#define g_instance GetMemoryInstrumentationForCurrentProcess()
+#else
 MemoryInstrumentation* g_instance = nullptr;
+#endif
 
 void WrapGlobalMemoryDump(
     MemoryInstrumentation::RequestGlobalDumpCallback callback,
