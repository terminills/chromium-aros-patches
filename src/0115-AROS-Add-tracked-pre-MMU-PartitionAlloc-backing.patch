   PA_DCHECK(post_slack < base_length);
-  return internal::TrimMappingInternal(base_address, base_length, trim_length,
-                                       accessibility, pre_slack, post_slack);
+  uintptr_t result = internal::TrimMappingInternal(
+      base_address, base_length, trim_length, accessibility, pre_slack,
+      post_slack);
+#if BUILDFLAG(IS_AROS)
+  // The pre-MMU backend retains alignment slack in the owning Exec block and
+  // releases it with the final trimmed mapping. Keep the logical mapped-space
+  // counter consistent with the address range visible to PartitionAlloc.
+  if (result) {
+    g_total_mapped_address_space.fetch_sub(base_length - trim_length,
+                                           std::memory_order_relaxed);
+  }
+#endif
+  return result;
 }
 
