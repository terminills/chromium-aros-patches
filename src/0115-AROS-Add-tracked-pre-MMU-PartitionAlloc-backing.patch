+struct PageAllocationRecord {
+  PageAllocationRecord* next;
+  uintptr_t exposed_base;
+  size_t exposed_length;
+  uintptr_t protected_base;
+  size_t protected_length;
+  void* allocation_base;
+  size_t allocation_length;
+  bool exec_owned;
+};
+
+std::atomic_flag s_pageAllocationLock = ATOMIC_FLAG_INIT;
+PageAllocationRecord* s_pageAllocations = nullptr;
+
+void LockPageAllocations() {
+  while (s_pageAllocationLock.test_and_set(std::memory_order_acquire)) {
+  }
+}
+
+void UnlockPageAllocations() {
+  s_pageAllocationLock.clear(std::memory_order_release);
+}
+
+bool TrackPageAllocation(uintptr_t exposed_base,
+                         size_t exposed_length,
+                         uintptr_t protected_base,
+                         size_t protected_length,
+                         void* allocation_base,
+                         size_t allocation_length,
+                         bool exec_owned) {
+  auto* record = static_cast<PageAllocationRecord*>(
+      AllocMem(sizeof(PageAllocationRecord), MEMF_PUBLIC | MEMF_CLEAR));
+  if (!record) {
+    return false;
+  }
+
+  record->exposed_base = exposed_base;
+  record->exposed_length = exposed_length;
+  record->protected_base = protected_base;
+  record->protected_length = protected_length;
+  record->allocation_base = allocation_base;
+  record->allocation_length = allocation_length;
+  record->exec_owned = exec_owned;
+
+  LockPageAllocations();
+  record->next = s_pageAllocations;
+  s_pageAllocations = record;
+  UnlockPageAllocations();
+  return true;
+}
+
+PageAllocationRecord* TakePageAllocation(uintptr_t exposed_base) {
+  PageAllocationRecord* record;
+  PageAllocationRecord* previous = nullptr;
+
+  LockPageAllocations();
+  for (record = s_pageAllocations; record; record = record->next) {
+    if (record->exposed_base == exposed_base) {
+      if (previous) {
+        previous->next = record->next;
+      } else {
+        s_pageAllocations = record->next;
+      }
+      break;
+    }
+    previous = record;
+  }
+  UnlockPageAllocations();
+  return record;
+}
+
+bool RetainTrimmedPageAllocation(uintptr_t base_address,
+                                 size_t base_length,
+                                 uintptr_t result,
+                                 size_t trim_length) {
+  bool found = false;
+
+  LockPageAllocations();
+  for (PageAllocationRecord* record = s_pageAllocations; record;
+       record = record->next) {
+    if (record->exposed_base == base_address &&
+        record->exposed_length == base_length) {
+      record->exposed_base = result;
+      record->exposed_length = trim_length;
+      found = true;
+      break;
+    }
+  }
+  UnlockPageAllocations();
+  return found;
+}
+
+void* AllocateExecPages(size_t length,
+                        ULONG flags,
+                        size_t* allocation_length) {
+  const size_t granularity = PageAllocationGranularity();
+  if (length > std::numeric_limits<size_t>::max() - granularity) {
+    return nullptr;
+  }
+
+  *allocation_length = length + granularity;
+  return AllocMem(*allocation_length, flags);
+}
