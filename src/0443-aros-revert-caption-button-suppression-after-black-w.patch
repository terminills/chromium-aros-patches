From 57b750c16f0d5c25e909aeda565176afd1a8a696 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 30 Jul 2026 14:28:37 -0500
Subject: [PATCH 443/638] aros: revert caption-button suppression after black
 window

The integrated hosted replay opened its Intuition window and spawned renderers but never received a first cross-process canvas over 40 minutes. Restore the proven Opaque frame policy while retaining the independent Power HIDD battery backend for isolation.

This deliberately preserves the failed native-caption assumption as commit f1ab42a9f4 and its explicit revert.

---
 chrome/browser/ui/views/frame/opaque_browser_frame_view.cc | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/chrome/browser/ui/views/frame/opaque_browser_frame_view.cc b/chrome/browser/ui/views/frame/opaque_browser_frame_view.cc
index 992c24861d..677e4de829 100644
--- a/chrome/browser/ui/views/frame/opaque_browser_frame_view.cc
+++ b/chrome/browser/ui/views/frame/opaque_browser_frame_view.cc
@@ -485,14 +485,7 @@ gfx::Size OpaqueBrowserFrameView::GetBrowserViewMinimumSize() const {
 }
 
 bool OpaqueBrowserFrameView::ShouldShowCaptionButtons() const {
-#if BUILDFLAG(IS_AROS)
-  // Intuition owns the native close, depth, and zoom gadgets. Keep Chromium's
-  // tab strip and toolbar, but do not duplicate window controls in the client
-  // area or install competing caption-button hit targets.
-  return false;
-#else
   return GetShowWindowTitleBar();
-#endif
 }
 
 bool OpaqueBrowserFrameView::IsRegularOrGuestSession() const {
