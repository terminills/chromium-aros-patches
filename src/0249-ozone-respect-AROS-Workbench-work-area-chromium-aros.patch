From ef946c806c56202f088777b2a05dec41ee170f72 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 16 Jul 2026 18:49:27 -0500
Subject: [PATCH 249/638] ozone: respect AROS Workbench work area [chromium]
 [aros]

AI_PHASE: chromium-phase-4-ozone
AI_STATUS: implemented
ROOT_CAUSE: ArosScreen advertised the physical screen as the usable work area while ArosWindow treated requested dimensions as client bounds and then added the native frame.
FIX_REASON: Separate physical and work-area bounds, then constrain client geometry using the native frame insets.
SCOPE: AROS Ozone screen and window geometry only; manual dragging and the current decorated fullscreen behavior remain unchanged.
VALIDATION: git diff --check; 42,527-step full chrome build; ninja no-work verification.
RISK: Low to medium; the port still exposes one display and has no dynamic display observer.
AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap;
---
 ui/ozone/platform/aros/aros_screen.cc | 28 +++++++---
 ui/ozone/platform/aros/aros_screen.h  |  8 +++
 ui/ozone/platform/aros/aros_window.cc | 80 ++++++++++++++++++++++-----
 ui/ozone/platform/aros/aros_window.h  |  2 +-
 4 files changed, 94 insertions(+), 24 deletions(-)

diff --git a/ui/ozone/platform/aros/aros_screen.cc b/ui/ozone/platform/aros/aros_screen.cc
index dfb454390c..5b53be9d51 100644
--- a/ui/ozone/platform/aros/aros_screen.cc
+++ b/ui/ozone/platform/aros/aros_screen.cc
@@ -4,6 +4,8 @@
 
 #include "ui/ozone/platform/aros/aros_screen.h"
 
+#include <algorithm>
+
 #include "base/logging.h"
 #include "ui/display/display.h"
 
@@ -18,24 +20,34 @@ constexpr int64_t kArosDisplayId = 1;
 constexpr int kFallbackWidth = 1024;
 constexpr int kFallbackHeight = 768;
 
-gfx::Rect GetPrimaryScreenBounds() {
+}  // namespace
+
+ArosScreenGeometry GetPrimaryArosScreenGeometry() {
   struct Screen* screen = LockPubScreen(nullptr);
   if (!screen) {
-    return gfx::Rect(0, 0, kFallbackWidth, kFallbackHeight);
+    const gfx::Rect fallback(0, 0, kFallbackWidth, kFallbackHeight);
+    return {fallback, fallback};
   }
-  const gfx::Rect bounds(0, 0, screen->Width, screen->Height);
+
+  const int width = std::max<int>(1, screen->Width);
+  const int height = std::max<int>(1, screen->Height);
+  const int work_area_top = std::clamp<int>(screen->BarHeight + 1, 0, height);
+  const ArosScreenGeometry geometry{
+      gfx::Rect(0, 0, width, height),
+      gfx::Rect(0, work_area_top, width, height - work_area_top)};
   UnlockPubScreen(nullptr, screen);
-  return bounds;
+  return geometry;
 }
 
-}  // namespace
-
 ArosScreen::ArosScreen() {
+  const ArosScreenGeometry geometry = GetPrimaryArosScreenGeometry();
   display::Display display(kArosDisplayId);
-  display.SetScaleAndBounds(1.0f, GetPrimaryScreenBounds());
+  display.SetScaleAndBounds(1.0f, geometry.bounds);
+  display.set_work_area(geometry.work_area);
   display_list_.AddDisplay(display, display::DisplayList::Type::PRIMARY);
   LOG(INFO) << "[Chromium:Ozone:AROS] primary display="
-            << display.bounds().ToString();
+            << display.bounds().ToString()
+            << " work_area=" << display.work_area().ToString();
 }
 
 ArosScreen::~ArosScreen() = default;
