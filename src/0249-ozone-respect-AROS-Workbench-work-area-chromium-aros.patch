 #include "ui/events/keycodes/dom/dom_code.h"
 #include "ui/events/keycodes/dom/dom_key.h"
 #include "ui/events/keycodes/keyboard_code_conversion.h"
+#include "ui/ozone/platform/aros/aros_screen.h"
 #include "ui/ozone/platform/aros/aros_window_manager.h"
 
 #include <cybergraphx/cybergraphics.h>
@@ -43,6 +44,35 @@ int PositiveOrDefault(int value, int fallback) {
   return value > 0 ? value : fallback;
 }
 
+gfx::Rect ConstrainClientBoundsToWorkArea(const gfx::Rect& requested,
+                                          const gfx::Rect& work_area,
+                                          int border_left,
+                                          int border_top,
+                                          int border_right,
+                                          int border_bottom) {
+  border_left = std::max(0, border_left);
+  border_top = std::max(0, border_top);
+  border_right = std::max(0, border_right);
+  border_bottom = std::max(0, border_bottom);
+
+  const int max_client_width =
+      std::max(1, work_area.width() - border_left - border_right);
+  const int max_client_height =
+      std::max(1, work_area.height() - border_top - border_bottom);
+  const int client_width =
+      std::min(PositiveOrDefault(requested.width(), 1), max_client_width);
+  const int client_height =
+      std::min(PositiveOrDefault(requested.height(), 1), max_client_height);
+  const int outer_width = client_width + border_left + border_right;
+  const int outer_height = client_height + border_top + border_bottom;
+  const int max_x = std::max(work_area.x(), work_area.right() - outer_width);
+  const int max_y = std::max(work_area.y(), work_area.bottom() - outer_height);
+
+  return gfx::Rect(std::clamp(requested.x(), work_area.x(), max_x),
+                   std::clamp(requested.y(), work_area.y(), max_y),
+                   client_width, client_height);
+}
+
 int ModifierFlagsFromQualifier(uint16_t qualifier) {
   int flags = EF_NONE;
   if (qualifier & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT)) {
@@ -318,6 +348,8 @@ ArosWindow::ArosWindow(PlatformWindowDelegate* delegate,
     : delegate_(delegate), manager_(manager), bounds_(requested_bounds) {
   bounds_.set_width(PositiveOrDefault(bounds_.width(), kDefaultWindowWidth));
   bounds_.set_height(PositiveOrDefault(bounds_.height(), kDefaultWindowHeight));
+  const gfx::Rect work_area = GetPrimaryArosScreenGeometry().work_area;
+  bounds_ = ConstrainClientBoundsToWorkArea(bounds_, work_area, 0, 0, 0, 0);
 
   widget_ = manager_->AddWindow(this);
   window_ = OpenWindowTags(
@@ -346,9 +378,21 @@ ArosWindow::ArosWindow(PlatformWindowDelegate* delegate,
   if (window_) {
     manager_->AttachNativeWindow(widget_, this, window_);
     UpdateBoundsFromNative(/*notify_delegate=*/false);
+    const gfx::Rect native_bounds = bounds_;
+    const gfx::Rect constrained = ConstrainClientBoundsToWorkArea(
+        native_bounds, work_area, window_->BorderLeft, window_->BorderTop,
+        window_->BorderRight, window_->BorderBottom);
+    if (constrained != native_bounds) {
+      ChangeWindowBox(
+          window_, constrained.x(), constrained.y(),
+          constrained.width() + window_->BorderLeft + window_->BorderRight,
+          constrained.height() + window_->BorderTop + window_->BorderBottom);
+      UpdateBoundsFromNative(/*notify_delegate=*/false);
+    }
     LOG(INFO) << "[Chromium:Ozone:AROS] opened Intuition window widget="
               << widget_ << " native=" << window_
-              << " client=" << bounds_.ToString();
+              << " client=" << bounds_.ToString()
+              << " work_area=" << work_area.ToString();
   }
 
   delegate_->OnAcceleratedWidgetAvailable(widget_);
@@ -396,9 +440,13 @@ void ArosWindow::PrepareForShutdown() {
 }
 
 void ArosWindow::SetBoundsInPixels(const gfx::Rect& bounds) {
-  bounds_ = bounds;
-  bounds_.set_width(PositiveOrDefault(bounds_.width(), 1));
-  bounds_.set_height(PositiveOrDefault(bounds_.height(), 1));
+  const gfx::Rect old_bounds = bounds_;
+  const gfx::Rect work_area = GetPrimaryArosScreenGeometry().work_area;
+  const gfx::Rect constrained = ConstrainClientBoundsToWorkArea(
+      bounds, work_area, window_ ? window_->BorderLeft : 0,
+      window_ ? window_->BorderTop : 0, window_ ? window_->BorderRight : 0,
+      window_ ? window_->BorderBottom : 0);
+  bounds_ = constrained;
   if (window_) {
     const int outer_width =
         bounds_.width() + window_->BorderLeft + window_->BorderRight;
@@ -406,8 +454,16 @@ void ArosWindow::SetBoundsInPixels(const gfx::Rect& bounds) {
         bounds_.height() + window_->BorderTop + window_->BorderBottom;
     ChangeWindowBox(window_, bounds_.x(), bounds_.y(), outer_width,
                     outer_height);
+    UpdateBoundsFromNative(/*notify_delegate=*/false);
+  }
+  if (bounds_ != old_bounds) {
+    delegate_->OnBoundsChanged({bounds_.origin() != old_bounds.origin()});
+  }
+  if (constrained != bounds) {
+    VLOG(1) << "[Chromium:Ozone:AROS] constrained client bounds requested="
+            << bounds.ToString() << " actual=" << bounds_.ToString()
+            << " work_area=" << work_area.ToString();
   }
-  delegate_->OnBoundsChanged({true});
 }
 
 gfx::Rect ArosWindow::GetBoundsInPixels() const {
@@ -447,7 +503,7 @@ void ArosWindow::SetFullscreen(bool fullscreen, int64_t target_display_id) {
