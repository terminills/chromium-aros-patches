From adc5962c126707aef69c651bddd0ab81f20bb7aa Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 14 Jul 2026 03:03:14 -0500
Subject: [PATCH 214/638] sharing_hub: expose desktop controller contract on
 AROS [chromium] [aros]

Statement:
AROS already builds Chromium's portable desktop Sharing Hub controller and Views bubble, but the shared interface hid their first-party action and weak-pointer methods behind a platform list that omitted AROS. The implementation therefore failed its override contract.

Decision:
Classify AROS with the existing desktop Sharing Hub interface only. This keeps the portable in-Chrome actions available without claiming support for a native OS sharesheet.

Evidence:
Both sharing_hub_bubble_controller_desktop_impl.o and sharing_hub_bubble_view_impl.o compile in out/aros-chrome after the guard change.

Chain:
Advances the full upstream chrome target in after a0d7f30b9a.
---
 .../browser/ui/sharing_hub/sharing_hub_bubble_controller.h   | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/ui/sharing_hub/sharing_hub_bubble_controller.h b/chrome/browser/ui/sharing_hub/sharing_hub_bubble_controller.h
index 172a2bd1cd..a539ba8625 100644
--- a/chrome/browser/ui/sharing_hub/sharing_hub_bubble_controller.h
+++ b/chrome/browser/ui/sharing_hub/sharing_hub_bubble_controller.h
@@ -18,8 +18,7 @@ namespace sharing_hub {
 class SharingHubBubbleView;
 
 // Interface for the controller component of the sharing dialog bubble. Controls
-// the Sharing Hub (Windows/Mac/Linux) or the Sharesheet (CrOS) depending on
-// platform.
+// the desktop Sharing Hub or the Sharesheet (CrOS) depending on platform.
 // Responsible for showing and hiding an associated dialog bubble.
 class SharingHubBubbleController {
  public:
@@ -37,7 +36,7 @@ class SharingHubBubbleController {
   virtual bool ShouldOfferOmniboxIcon() = 0;
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
-    BUILDFLAG(IS_FUCHSIA)
+    BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_AROS)
   // This method returns the set of first-party actions, which are actions
   // internal to Chrome. Third-party actions (those outside Chrome) are
   // currently not supported.
