From 613cf5ff391f03d253376f867eadf6eddbe5b4a5 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 14 Jul 2026 04:42:36 -0500
Subject: [PATCH 226/638] chrome: expose portable desktop resources on AROS
 [chromium] [aros]

AI_PHASE: chromium-phase-4-browser-link

AI_STATUS: done

ROOT_CAUSE: Enabling Chromium's portable desktop UI on AROS pulled in the generic discards WebUI and minor-mode sign-in policy, but their generated resources, URL constants, and feature declarations were still restricted to established desktop platforms.

FIX_REASON: Admit AROS to the existing portable desktop contracts without inventing platform behavior. Package chrome://discards and use Chromium's desktop sign-in latency default so the enabled UI sources and resources agree.

SCOPE: chrome/browser/resources/BUILD.gn, chrome/chrome_paks.gni, chrome/common/webui_url_constants.{cc,h}, and components/signin/public/base/signin_switches.{cc,h}.

VALIDATION: GN regenerated out/aros-chrome; obj/chrome/browser/ui/libui.a completed all 766 build edges; git diff --cached --check passes.

RISK: low; all changes are AROS-only build and declaration gates around existing portable desktop implementations.

AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap;
---
 chrome/browser/resources/BUILD.gn                | 2 +-
 chrome/chrome_paks.gni                           | 3 ++-
 chrome/common/webui_url_constants.cc             | 4 ++--
 chrome/common/webui_url_constants.h              | 2 +-
 components/signin/public/base/signin_switches.cc | 5 +++--
 components/signin/public/base/signin_switches.h  | 2 +-
 6 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/chrome/browser/resources/BUILD.gn b/chrome/browser/resources/BUILD.gn
index 9bd0542092..8f4535f783 100644
--- a/chrome/browser/resources/BUILD.gn
+++ b/chrome/browser/resources/BUILD.gn
@@ -99,7 +99,7 @@ group("resources") {
     public_deps += [ "browser_switch:resources" ]
   }
 
-  if (is_win || is_mac || is_linux || is_chromeos || is_fuchsia) {
+  if (is_win || is_mac || is_linux || is_chromeos || is_fuchsia || is_aros) {
     public_deps += [ "discards:resources" ]
   }
 
diff --git a/chrome/chrome_paks.gni b/chrome/chrome_paks.gni
index 472d9a8340..600c82ffad 100644
--- a/chrome/chrome_paks.gni
+++ b/chrome/chrome_paks.gni
@@ -421,7 +421,8 @@ template("chrome_extra_paks") {
       deps += [ "//chrome/browser/resources/browser_switch:resources" ]
     }
 
-    if (is_win || is_mac || is_linux || is_chromeos || is_fuchsia) {
+    if (is_win || is_mac || is_linux || is_chromeos || is_fuchsia ||
+        is_aros) {
       sources += [ "$root_gen_dir/chrome/discards_resources.pak" ]
       deps += [ "//chrome/browser/resources/discards:resources" ]
     }
diff --git a/chrome/common/webui_url_constants.cc b/chrome/common/webui_url_constants.cc
index 0c12b1c9a3..8c348e0b27 100644
--- a/chrome/common/webui_url_constants.cc
+++ b/chrome/common/webui_url_constants.cc
@@ -529,7 +529,7 @@ const char kChromeUIConnectorsInternalsHost[] = "connectors-internals";
 #endif
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
-    BUILDFLAG(IS_CHROMEOS)
+    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_AROS)
 const char kChromeUIDiscardsHost[] = "discards";
 const char kChromeUIDiscardsURL[] = "chrome://discards/";
 #endif
@@ -803,7 +803,7 @@ const char* const kChromeHostURLs[] = {
     kChromeUIConnectorsInternalsHost,
 #endif
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
-    BUILDFLAG(IS_CHROMEOS)
+    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_AROS)
     kChromeUIDiscardsHost,
 #endif
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
diff --git a/chrome/common/webui_url_constants.h b/chrome/common/webui_url_constants.h
index e7ecefab75..4655adedaa 100644
--- a/chrome/common/webui_url_constants.h
+++ b/chrome/common/webui_url_constants.h
@@ -448,7 +448,7 @@ extern const char kChromeUIConnectorsInternalsHost[];
 #endif
 
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || \
-    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FUCHSIA)
+    BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_AROS)
 extern const char kChromeUIDiscardsHost[];
 extern const char kChromeUIDiscardsURL[];
 #endif
diff --git a/components/signin/public/base/signin_switches.cc b/components/signin/public/base/signin_switches.cc
index 8703d08869..9fe7827476 100644
--- a/components/signin/public/base/signin_switches.cc
+++ b/components/signin/public/base/signin_switches.cc
@@ -125,7 +125,7 @@ bool IsExplicitBrowserSigninUIOnDesktopEnabled(
 }
 
 #if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN) || \
-    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
+    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS) || BUILDFLAG(IS_AROS)
 BASE_FEATURE(kMinorModeRestrictionsForHistorySyncOptIn,
              "MinorModeRestrictionsForHistorySyncOptIn",
              base::FEATURE_DISABLED_BY_DEFAULT);
@@ -134,7 +134,8 @@ constexpr int kMinorModeRestrictionsFetchDeadlineDefaultValueMs =
 #if BUILDFLAG(IS_ANDROID)
     // Based on Signin.AccountCapabilities.UserVisibleLatency
     400;
-#elif BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+#elif BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN) || \
+    BUILDFLAG(IS_AROS)
     // Based on Signin.SyncOptIn.PreSyncConfirmationLatency
     900;
 #elif BUILDFLAG(IS_IOS)
diff --git a/components/signin/public/base/signin_switches.h b/components/signin/public/base/signin_switches.h
index d86b623210..0bc69cf8fc 100644
--- a/components/signin/public/base/signin_switches.h
+++ b/components/signin/public/base/signin_switches.h
@@ -121,7 +121,7 @@ bool IsExplicitBrowserSigninUIOnDesktopEnabled(
 
 // Controls the view mode for (history) sync screen.
 #if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN) || \
-    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS)
+    BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS) || BUILDFLAG(IS_AROS)
 COMPONENT_EXPORT(SIGNIN_SWITCHES)
 BASE_DECLARE_FEATURE(kMinorModeRestrictionsForHistorySyncOptIn);
 
