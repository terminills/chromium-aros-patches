+#ifndef UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_AROS_H_
+#define UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_AROS_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/shell_dialogs_export.h"
+
+namespace ui {
+
+// File open/save dialogs backed by the AROS ASL file requester
+// (asl.library ASL_FileRequest).
+//
+// The requester is modal and blocks the thread it runs on, so it is driven
+// from a MayBlock() thread-pool sequence and the listener is called back on
+// the sequence that asked for the dialog. Nothing here touches Intuition on
+// the UI thread.
+class SHELL_DIALOGS_EXPORT SelectFileDialogAros : public SelectFileDialog {
+ public:
+  SelectFileDialogAros(Listener* listener,
+                       std::unique_ptr<SelectFilePolicy> policy);
+  SelectFileDialogAros(const SelectFileDialogAros&) = delete;
+  SelectFileDialogAros& operator=(const SelectFileDialogAros&) = delete;
+
+  // SelectFileDialog:
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      void* params,
+                      const GURL* caller) override;
+  bool HasMultipleFileTypeChoicesImpl() override;
+  bool IsRunning(gfx::NativeWindow owning_window) const override;
+  void ListenerDestroyed() override;
+
+ private:
+  // Private because SelectFileDialog is ref-counted.
+  ~SelectFileDialogAros() override;
+
+  // What the requester was asked for and what came back. Passed whole between
+  // sequences so the blocking side touches no member state.
+  struct Request {
+    Request();
+    Request(const Request&) = delete;
+    Request& operator=(const Request&) = delete;
+    Request(Request&&);
+    Request& operator=(Request&&);
+    ~Request();
+
+    std::string title;
+    base::FilePath default_path;
+    // ASL pattern such as "(#?.htm|#?.html)", empty for "show everything".
+    std::string pattern;
+    bool save_mode = false;
+    bool multi_select = false;
+    bool drawers_only = false;
+
+    std::vector<base::FilePath> files;
+    bool cancelled = true;
+  };
+
+  // Runs the ASL requester. Blocking; never called on the UI thread.
+  static Request RunRequester(Request request);
+
+  // Delivers the outcome to `listener_` on the calling sequence.
+  void OnRequesterFinished(void* params, int file_type_index, Request request);
+
+  bool has_multiple_file_type_choices_ = false;
+  bool running_ = false;
+};
+
+}  // namespace ui
+
+#endif  // UI_SHELL_DIALOGS_SELECT_FILE_DIALOG_AROS_H_
