+#include "partition_alloc/partition_alloc_base/debug/stack_trace.h"
+
+#include "partition_alloc/partition_alloc_base/debug/debugging_buildflags.h"
+#include "partition_alloc/partition_alloc_base/logging.h"
+#include "partition_alloc/partition_alloc_base/strings/safe_sprintf.h"
+
+namespace partition_alloc::internal::base::debug {
+
+size_t CollectStackTrace(const void** trace, size_t count) {
+#if BUILDFLAG(PA_CAN_UNWIND_WITH_FRAME_POINTERS)
+  return TraceStackFramePointers(trace, count, 0);
+#else
+  return 0;
+#endif
+}
+
+void OutputStackTrace(unsigned index,
+                      uintptr_t address,
+                      uintptr_t,
+                      const char*,
+                      uintptr_t) {
+  char buffer[96];
+  strings::SafeSPrintf(buffer, "#%02d 0x%0x\n", index, address);
+  PA_RAW_LOG(INFO, buffer);
+}
+
+void PrintStackTrace(const void** trace, size_t count) {
+  for (size_t i = 0; i < count; ++i) {
+    OutputStackTrace(i, reinterpret_cast<uintptr_t>(trace[i]), 0, nullptr, 0);
+  }
+}
+
+}  // namespace partition_alloc::internal::base::debug
