+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_PAGE_ALLOCATOR_INTERNALS_AROS_H_
+#define BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_PAGE_ALLOCATOR_INTERNALS_AROS_H_
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+#pragma push_macro("SCHED_RR")
+#undef SCHED_RR
+#include <aros/kernel.h>
+#pragma pop_macro("SCHED_RR")
+#include <exec/memory.h>
+#include <proto/exec.h>
+#include <proto/kernel.h>
+
+#include "partition_alloc/page_allocator.h"
+#include "partition_alloc/page_allocator_constants.h"
+#include "partition_alloc/partition_alloc_check.h"
+
+namespace partition_alloc::internal {
+
+// KrnAllocPages treats a non-null address as an exact physical-page request.
+constexpr bool kHintIsAdvisory = false;
+std::atomic<int32_t> s_allocPageErrorCode{0};
+
+namespace {
+
+APTR OpenKernelResource() {
+  return OpenResource("kernel.resource");
+}
+
+KRN_MapAttr GetAccessFlags(PageAccessibilityConfiguration accessibility) {
+  switch (accessibility.permissions) {
+    case PageAccessibilityConfiguration::kRead:
+      return MAP_Readable;
+    case PageAccessibilityConfiguration::kReadWriteTagged:
+    case PageAccessibilityConfiguration::kReadWrite:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable);
+    case PageAccessibilityConfiguration::kReadExecuteProtected:
+    case PageAccessibilityConfiguration::kReadExecute:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Executable);
+    case PageAccessibilityConfiguration::kReadWriteExecuteProtected:
+    case PageAccessibilityConfiguration::kReadWriteExecute:
+      return static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable |
+                                      MAP_Executable);
+    case PageAccessibilityConfiguration::kInaccessible:
+    case PageAccessibilityConfiguration::kInaccessibleWillJitLater:
+      return static_cast<KRN_MapAttr>(0);
+  }
+  return static_cast<KRN_MapAttr>(0);
+}
+
+void SetProtection(APTR KernelBase,
+                   uintptr_t address,
+                   size_t length,
+                   KRN_MapAttr flags) {
+  constexpr size_t kMaxChunk =
+      static_cast<size_t>(std::numeric_limits<uint32_t>::max()) & ~size_t{4095};
+
+  while (length) {
+    const size_t chunk = std::min(length, kMaxChunk);
+    KrnSetProtection(reinterpret_cast<void*>(address),
+                     static_cast<uint32_t>(chunk), flags);
+    address += chunk;
+    length -= chunk;
+  }
+}
+
+}  // namespace
+
+uintptr_t SystemAllocPagesInternal(
+    uintptr_t hint,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageTag,
+    int file_descriptor_for_shared_alloc) {
+  if (file_descriptor_for_shared_alloc != -1) {
+    s_allocPageErrorCode = ENOTSUP;
+    return 0;
+  }
+
+  APTR KernelBase = OpenKernelResource();
+  if (!KernelBase) {
+    s_allocPageErrorCode = ENOSYS;
+    return 0;
+  }
+
+  ULONG flags = MEMF_PUBLIC | MEMF_CLEAR;
+  if (accessibility.permissions ==
+          PageAccessibilityConfiguration::kInaccessibleWillJitLater ||
+      (GetAccessFlags(accessibility) & MAP_Executable)) {
+    flags |= MEMF_EXECUTABLE;
+  }
+
+  void* result = KrnAllocPages(reinterpret_cast<void*>(hint), length, flags);
+  if (!result) {
+    s_allocPageErrorCode = ENOMEM;
+    return 0;
+  }
+
+  SetProtection(KernelBase, reinterpret_cast<uintptr_t>(result), length,
+                GetAccessFlags(accessibility));
+  s_allocPageErrorCode = 0;
+  return reinterpret_cast<uintptr_t>(result);
+}
+
+bool TrySetSystemPagesAccessInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility) {
+  APTR KernelBase = OpenKernelResource();
+  if (!KernelBase) {
+    return false;
+  }
+  SetProtection(KernelBase, address, length, GetAccessFlags(accessibility));
+  return true;
+}
+
+void SetSystemPagesAccessInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility) {
+  PA_CHECK(TrySetSystemPagesAccessInternal(address, length, accessibility));
+}
+
+void FreePagesInternal(uintptr_t address, size_t length) {
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+  KrnFreePages(reinterpret_cast<void*>(address), length);
+}
+
+uintptr_t TrimMappingInternal(uintptr_t base_address,
+                              size_t,
+                              size_t trim_length,
+                              PageAccessibilityConfiguration,
+                              size_t pre_slack,
+                              size_t post_slack) {
+  uintptr_t result = base_address;
+  if (pre_slack) {
+    FreePages(base_address, pre_slack);
+    result += pre_slack;
+  }
+  if (post_slack) {
+    FreePages(result + trim_length, post_slack);
+  }
+  return result;
+}
+
+void DecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityDisposition) {
+  APTR KernelBase = OpenKernelResource();
+  PA_CHECK(KernelBase);
+  SetProtection(KernelBase, address, length,
+                static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
+  std::memset(reinterpret_cast<void*>(address), 0, length);
+  SetProtection(KernelBase, address, length, static_cast<KRN_MapAttr>(0));
+}
+
+bool DecommitAndZeroSystemPagesInternal(uintptr_t address,
+                                        size_t length,
+                                        PageTag) {
+  DecommitSystemPagesInternal(
+      address, length, PageAccessibilityDisposition::kRequireUpdate);
+  return true;
+}
+
+void RecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageAccessibilityDisposition) {
+  SetSystemPagesAccess(address, length, accessibility);
+}
+
+bool TryRecommitSystemPagesInternal(
+    uintptr_t address,
+    size_t length,
+    PageAccessibilityConfiguration accessibility,
+    PageAccessibilityDisposition) {
+  return TrySetSystemPagesAccess(address, length, accessibility);
+}
+
+void DiscardSystemPagesInternal(uintptr_t, size_t) {
+  // AROS cannot currently discard physical backing while retaining the
+  // virtual address reservation. Decommit still zeroes and protects pages.
+}
+
+}  // namespace partition_alloc::internal
+
+#endif  // BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_PAGE_ALLOCATOR_INTERNALS_AROS_H_
