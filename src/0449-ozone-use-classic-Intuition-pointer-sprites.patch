From 863ab40504defba3beba651303999addf3c4929d Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 30 Jul 2026 17:49:39 -0500
Subject: [PATCH 449/638] ozone: use classic Intuition pointer sprites

Convert Chromium cursor bitmaps into the documented SetPointer raw sprite layout: chip memory, at most 16 pixels wide, two interleaved plane words per row, reserved control words, and the compatibility hotspot correction. ClearPointer now releases Intuition's generated pointer object before the sprite data is freed.



---
 ui/ozone/platform/aros/aros_window.cc | 122 ++++++++++++--------------
 ui/ozone/platform/aros/aros_window.h  |   3 +-
 2 files changed, 56 insertions(+), 69 deletions(-)

diff --git a/ui/ozone/platform/aros/aros_window.cc b/ui/ozone/platform/aros/aros_window.cc
index 315559594d..5617f13fd8 100644
--- a/ui/ozone/platform/aros/aros_window.cc
+++ b/ui/ozone/platform/aros/aros_window.cc
@@ -5,7 +5,6 @@
 #include "ui/ozone/platform/aros/aros_window.h"
 
 #include <algorithm>
-#include <limits>
 
 #include "base/logging.h"
 #include "base/strings/utf_string_conversions.h"
@@ -26,9 +25,7 @@
 #include <cybergraphx/cybergraphics.h>
 #include <devices/inputevent.h>
 #include <devices/rawkeycodes.h>
-#include <intuition/classusr.h>
 #include <intuition/intuition.h>
-#include <intuition/pointerclass.h>
 #include <proto/cybergraphics.h>
 #include <proto/exec.h>
 #include <proto/graphics.h>
@@ -632,8 +629,7 @@ void ArosWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {
       BitmapCursor::FromPlatformCursor(cursor_);
   const mojom::CursorType type = bitmap_cursor->type();
 
-  if (type == mojom::CursorType::kNull ||
-      type == mojom::CursorType::kPointer) {
+  if (type == mojom::CursorType::kNull || type == mojom::CursorType::kPointer) {
     // ResetNativeCursor() already restored the screen's configured pointer.
     VLOG(1) << "[Chromium:Ozone:AROS] installed configured cursor type="
             << type;
@@ -648,73 +644,69 @@ void ArosWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {
   }
 
   if (type == mojom::CursorType::kNone) {
-    // An empty pointerclass object creates a dummy visible sprite. Supply a
-    // cleared two-plane sprite instead so CSS cursor:none and pointer lock
-    // actually hide the native pointer.
-    cursor_bitmap_ =
-        AllocBitMap(16, 1, 2, BMF_CLEAR | BMF_DISPLAYABLE,
-                    window_->WScreen->RastPort.BitMap);
-    if (cursor_bitmap_) {
-      cursor_object_ = NewObject(
-          nullptr,
-          const_cast<UBYTE*>(
-              reinterpret_cast<const UBYTE*>("pointerclass")),
-          POINTERA_BitMap, reinterpret_cast<IPTR>(cursor_bitmap_),
-          POINTERA_WordWidth, 1, POINTERA_XOffset, 0, POINTERA_YOffset, 0,
-          TAG_DONE);
+    constexpr int kHiddenHeight = 1;
+    constexpr size_t kHiddenWords = 2 + (2 * kHiddenHeight) + 2;
+    cursor_sprite_data_ = static_cast<uint16_t*>(
+        AllocVec(kHiddenWords * sizeof(uint16_t), MEMF_CHIP | MEMF_CLEAR));
+    if (cursor_sprite_data_) {
+      SetPointer(window_, cursor_sprite_data_, kHiddenHeight, 1, -1, 0);
     }
   } else if (!bitmap_cursor->bitmaps().empty()) {
     const SkBitmap& bitmap = bitmap_cursor->bitmap();
     if (!bitmap.isNull() && bitmap.width() > 0 && bitmap.height() > 0 &&
         bitmap.width() <= 64 && bitmap.height() <= 64 && bitmap.getPixels()) {
-      // Hosted and older native displays can accept a 32-bit sprite object
-      // without ever presenting it. Quantize Chromium's cursor asset into the
-      // classic two-plane AROS pointer format, which every Intuition display
-      // path supports. Pen zero stays transparent; the other three pens use
-      // the user's configured pointer colors.
-      cursor_bitmap_ = AllocBitMap(bitmap.width(), bitmap.height(), 2,
-                                   BMF_CLEAR | BMF_DISPLAYABLE,
-                                   window_->WScreen->RastPort.BitMap);
-      if (cursor_bitmap_) {
-        struct RastPort cursor_rast_port;
-        InitRastPort(&cursor_rast_port);
-        cursor_rast_port.BitMap = cursor_bitmap_;
-        bool written = true;
-        ULONG active_pen = std::numeric_limits<ULONG>::max();
-        for (int y = 0; y < bitmap.height() && written; ++y) {
-          for (int x = 0; x < bitmap.width(); ++x) {
-            const ULONG pen = ArosPointerPen(bitmap.getColor(x, y));
-            if (pen != active_pen) {
-              SetAPen(&cursor_rast_port, pen);
-              active_pen = pen;
+      // The universal Intuition contract is a <=16-pixel-wide, two-plane
+      // old-format sprite in chip memory, not a graphics.library BitMap.
+      const int sprite_width = std::min(bitmap.width(), 16);
+      const int sprite_height =
+          std::max(1, (bitmap.height() * sprite_width + bitmap.width() / 2) /
+                          bitmap.width());
+      const size_t sprite_words = 2 + (2 * sprite_height) + 2;
+      cursor_sprite_data_ = static_cast<uint16_t*>(
+          AllocVec(sprite_words * sizeof(uint16_t), MEMF_CHIP | MEMF_CLEAR));
+      if (cursor_sprite_data_) {
+        for (int y = 0; y < sprite_height; ++y) {
+          const int source_y = std::min(
+              bitmap.height() - 1,
+              (y * bitmap.height() + sprite_height / 2) / sprite_height);
+          uint16_t plane_lsb = 0;
+          uint16_t plane_msb = 0;
+          for (int x = 0; x < sprite_width; ++x) {
+            const int source_x = std::min(
+                bitmap.width() - 1,
+                (x * bitmap.width() + sprite_width / 2) / sprite_width);
+            const ULONG pen =
+                ArosPointerPen(bitmap.getColor(source_x, source_y));
+            const uint16_t mask = static_cast<uint16_t>(0x8000U >> x);
+            if (pen & 1U) {
+              plane_lsb |= mask;
             }
-            if (WritePixel(&cursor_rast_port, x, y) < 0) {
-              written = false;
-              break;
+            if (pen & 2U) {
+              plane_msb |= mask;
             }
           }
+          // The first two and final two words remain reserved and zero.
+          cursor_sprite_data_[2 + (2 * y)] = plane_lsb;
+          cursor_sprite_data_[3 + (2 * y)] = plane_msb;
         }
-        if (written) {
-          const gfx::Point& hotspot = bitmap_cursor->hotspot();
-          cursor_object_ = NewObject(
-              nullptr,
-              const_cast<UBYTE*>(
-                  reinterpret_cast<const UBYTE*>("pointerclass")),
-              POINTERA_BitMap, reinterpret_cast<IPTR>(cursor_bitmap_),
-              POINTERA_WordWidth, (bitmap.width() + 15) / 16, POINTERA_XOffset,
-              -hotspot.x(), POINTERA_YOffset, -hotspot.y(), TAG_DONE);
-        }
+
+        const gfx::Point& hotspot = bitmap_cursor->hotspot();
+        const int hotspot_x =
+            (hotspot.x() * sprite_width + bitmap.width() / 2) / bitmap.width();
+        const int hotspot_y =
+            (hotspot.y() * sprite_height + bitmap.height() / 2) /
+            bitmap.height();
+        // Classic Intuition defines the hot spot one pixel left of the
+        // desired position.
+        SetPointer(window_, cursor_sprite_data_, sprite_height, sprite_width,
+                   -hotspot_x - 1, -hotspot_y);
       }
     }
   }
 
-  if (cursor_object_) {
-    SetWindowPointer(window_, WA_Pointer, cursor_object_, TAG_DONE);
-    VLOG(1) << "[Chromium:Ozone:AROS] installed pointerclass cursor type="
-            << type << " bitmap="
-            << (cursor_bitmap_ ? GetBitMapAttr(cursor_bitmap_, BMA_WIDTH) : 0)
-            << "x"
-            << (cursor_bitmap_ ? GetBitMapAttr(cursor_bitmap_, BMA_HEIGHT) : 0);
+  if (cursor_sprite_data_) {
+    VLOG(1) << "[Chromium:Ozone:AROS] installed SetPointer sprite type="
+            << type;
   } else {
     LOG(WARNING) << "[Chromium:Ozone:AROS] failed to install cursor type="
                  << type;
@@ -740,15 +732,11 @@ void ArosWindow::SizeConstraintsChanged() {}
 
 void ArosWindow::ResetNativeCursor() {
   if (window_) {
-    SetWindowPointer(window_, TAG_DONE);
-  }
-  if (cursor_object_) {
-    DisposeObject(static_cast<Object*>(cursor_object_));
-    cursor_object_ = nullptr;
+    ClearPointer(window_);
   }
-  if (cursor_bitmap_) {
-    FreeBitMap(cursor_bitmap_);
-    cursor_bitmap_ = nullptr;
+  if (cursor_sprite_data_) {
+    FreeVec(cursor_sprite_data_);
+    cursor_sprite_data_ = nullptr;
   }
   cursor_.reset();
 }
diff --git a/ui/ozone/platform/aros/aros_window.h b/ui/ozone/platform/aros/aros_window.h
index b8be465795..3ee44ed8cd 100644
--- a/ui/ozone/platform/aros/aros_window.h
+++ b/ui/ozone/platform/aros/aros_window.h
@@ -107,8 +107,7 @@ class ArosWindow : public PlatformWindow {
   raw_ptr<ArosWindowManager> manager_ = nullptr;
   gfx::AcceleratedWidget widget_ = gfx::kNullAcceleratedWidget;
   RAW_PTR_EXCLUSION struct Window* window_ = nullptr;
-  RAW_PTR_EXCLUSION struct BitMap* cursor_bitmap_ = nullptr;
-  RAW_PTR_EXCLUSION void* cursor_object_ = nullptr;
+  RAW_PTR_EXCLUSION uint16_t* cursor_sprite_data_ = nullptr;
   RAW_PTR_EXCLUSION struct BitMap* backing_bitmap_ = nullptr;
   std::unique_ptr<struct RastPort> backing_rast_port_;
   gfx::Size backing_size_;
