diff --git a/components/metrics/persistent_histograms.cc b/components/metrics/persistent_histograms.cc
index 20584ff393..842dcef99e 100644
--- a/components/metrics/persistent_histograms.cc
+++ b/components/metrics/persistent_histograms.cc
@@ -106,7 +106,7 @@ base::FilePath GetSpareFilePath(const base::FilePath& metrics_dir) {
 InitResult InitWithMappedFile(const base::FilePath& metrics_dir,
                               const base::FilePath& upload_dir) {
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] mapped-file setup enter";
+  VLOG(1) << "[Chromium:AROS:Histograms] mapped-file setup enter";
 #endif
   // The spare file in the user data dir ("BrowserMetrics-spare.pma") would
   // have been created in the previous session. We will move it to |upload_dir|
@@ -122,8 +122,8 @@ InitResult InitWithMappedFile(const base::FilePath& metrics_dir,
   InitResult result;
   const bool upload_dir_exists = base::PathExists(upload_dir);
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] upload directory exists="
-               << upload_dir_exists;
+  VLOG(1) << "[Chromium:AROS:Histograms] upload directory exists="
+          << upload_dir_exists;
 #endif
   if (!upload_dir_exists) {
     // Handle failure to create the directory.
@@ -131,8 +131,8 @@ InitResult InitWithMappedFile(const base::FilePath& metrics_dir,
   } else {
     const bool active_file_exists = base::PathExists(active_file);
 #if BUILDFLAG(IS_AROS)
-    LOG(WARNING) << "[Chromium:AROS:Histograms] active file exists="
-                 << active_file_exists;
+    VLOG(1) << "[Chromium:AROS:Histograms] active file exists="
+            << active_file_exists;
 #endif
     if (active_file_exists) {
       // "active" filename is supposed to be unique so this shouldn't happen.
@@ -146,26 +146,26 @@ InitResult InitWithMappedFile(const base::FilePath& metrics_dir,
       const bool exclusive_write = true;
       // Move any spare file into the active position.
 #if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:Histograms] spare replacement begin";
+      VLOG(1) << "[Chromium:AROS:Histograms] spare replacement begin";
 #endif
       base::ReplaceFile(spare_file, active_file, nullptr);
 #if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:Histograms] spare replacement complete";
+      VLOG(1) << "[Chromium:AROS:Histograms] spare replacement complete";
 #endif
       // Create global allocator using the |active_file|.
       if (kSpareFileRequired && !base::PathExists(active_file)) {
         result = kNoSpareFile;
       } else {
 #if BUILDFLAG(IS_AROS)
-        LOG(WARNING) << "[Chromium:AROS:Histograms] CreateWithFile begin";
+        VLOG(1) << "[Chromium:AROS:Histograms] CreateWithFile begin";
 #endif
         const bool allocator_created =
             base::GlobalHistogramAllocator::CreateWithFile(
                 active_file, kAllocSize, kAllocId, kBrowserMetricsName,
                 exclusive_write);
 #if BUILDFLAG(IS_AROS)
-        LOG(WARNING) << "[Chromium:AROS:Histograms] CreateWithFile complete="
-                     << allocator_created;
+        VLOG(1) << "[Chromium:AROS:Histograms] CreateWithFile complete="
+                << allocator_created;
 #endif
         result = allocator_created ? kMappedFileSuccess : kMappedFileFailed;
       }
@@ -191,12 +191,12 @@ void InstantiatePersistentHistogramsImpl(const base::FilePath& metrics_dir,
   base::FilePath upload_dir = metrics_dir.AppendASCII(kBrowserMetricsName);
   // TODO(crbug.com/1183166): Only create the dir in kMappedFile mode.
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] upload directory create begin";
+  VLOG(1) << "[Chromium:AROS:Histograms] upload directory create begin";
 #endif
   const bool upload_dir_created = base::CreateDirectory(upload_dir);
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] upload directory create complete="
-               << upload_dir_created;
+  VLOG(1) << "[Chromium:AROS:Histograms] upload directory create complete="
+          << upload_dir_created;
 #endif
 
   InitResult result;
@@ -205,12 +205,12 @@ void InstantiatePersistentHistogramsImpl(const base::FilePath& metrics_dir,
   switch (mode) {
     case kMappedFile:
 #if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:Histograms] mapped-file dispatch begin";
+      VLOG(1) << "[Chromium:AROS:Histograms] mapped-file dispatch begin";
 #endif
       result = InitWithMappedFile(metrics_dir, upload_dir);
 #if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:Histograms] mapped-file dispatch complete result="
-                   << static_cast<int>(result);
+      VLOG(1) << "[Chromium:AROS:Histograms] mapped-file dispatch complete result="
+              << static_cast<int>(result);
 #endif
       break;
     case kLocalMemory:
@@ -245,19 +245,19 @@ void InstantiatePersistentHistogramsImpl(const base::FilePath& metrics_dir,
 
   // Store a copy of the system profile in this allocator.
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] register system profile begin";
+  VLOG(1) << "[Chromium:AROS:Histograms] register system profile begin";
 #endif
   metrics::GlobalPersistentSystemProfile::GetInstance()
       ->RegisterPersistentAllocator(allocator->memory_allocator());
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] register system profile complete";
-  LOG(WARNING) << "[Chromium:AROS:Histograms] tracking histograms begin";
+  VLOG(1) << "[Chromium:AROS:Histograms] register system profile complete";
+  VLOG(1) << "[Chromium:AROS:Histograms] tracking histograms begin";
 #endif
 
   // Create tracking histograms for the allocator and record storage file.
   allocator->CreateTrackingHistograms(kBrowserMetricsName);
 #if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:Histograms] tracking histograms complete";
+  VLOG(1) << "[Chromium:AROS:Histograms] tracking histograms complete";
 #endif
 }
 
