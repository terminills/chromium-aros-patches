From 152b466a176c5b0d373bbd7256ad1ce735beb34c Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 8 Aug 2026 08:24:05 -0500
Subject: [PATCH 540/638] AROS: quiet normal Chromium platform diagnostics

---
 .../browser/chrome_resource_bundle_helper.cc  | 13 +++---
 ...ome_browser_cloud_management_controller.cc |  6 +++
 .../providers/cast/cast_media_source.cc       |  9 +++++
 components/metrics/persistent_histograms.cc   | 40 +++++++++----------
 net/cert/ev_root_ca_metadata.cc               |  8 ++++
 net/proxy_resolution/proxy_config_service.cc  |  4 ++
 .../battery/battery_status_manager_default.cc | 11 ++++-
 ui/gl/gl_context.cc                           | 11 +++--
 .../desktop_window_tree_host_platform.cc      |  2 +
 9 files changed, 70 insertions(+), 34 deletions(-)

diff --git a/chrome/browser/chrome_resource_bundle_helper.cc b/chrome/browser/chrome_resource_bundle_helper.cc
index 1670d527a3..e52bf9998e 100644
--- a/chrome/browser/chrome_resource_bundle_helper.cc
+++ b/chrome/browser/chrome_resource_bundle_helper.cc
@@ -112,13 +112,12 @@ std::string InitResourceBundleAndDetermineLocale(PrefService* local_state,
   const bool have_locales =
       base::PathService::Get(ui::DIR_LOCALES, &locales_path);
   const base::FilePath en_us_path = locales_path.AppendASCII("en-US.pak");
-  LOG(WARNING) << "[Chromium:AROS:Locale] preferred='" << preferred_locale
-               << "' module=" << have_module << " '" << module_path.value()
-               << "' assets=" << have_assets << " '" << assets_path.value()
-               << "' locales=" << have_locales << " '"
-               << locales_path.value() << "' en-US-exists="
-               << base::PathExists(en_us_path) << " '"
-               << en_us_path.value() << "'";
+  VLOG(1) << "[Chromium:AROS:Locale] preferred='" << preferred_locale
+          << "' module=" << have_module << " '" << module_path.value()
+          << "' assets=" << have_assets << " '" << assets_path.value()
+          << "' locales=" << have_locales << " '" << locales_path.value()
+          << "' en-US-exists=" << base::PathExists(en_us_path) << " '"
+          << en_us_path.value() << "'";
 #endif
   // On a POSIX OS other than ChromeOS, the parameter that is passed to the
   // method InitSharedInstance is ignored.
diff --git a/components/enterprise/browser/controller/chrome_browser_cloud_management_controller.cc b/components/enterprise/browser/controller/chrome_browser_cloud_management_controller.cc
index 3c88222d7f..25feb3ae3f 100644
--- a/components/enterprise/browser/controller/chrome_browser_cloud_management_controller.cc
+++ b/components/enterprise/browser/controller/chrome_browser_cloud_management_controller.cc
@@ -158,11 +158,17 @@ void ChromeBrowserCloudManagementController::Init(
     PrefService* local_state,
     scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory) {
   if (!IsEnabled()) {
+#if BUILDFLAG(IS_AROS)
+    VLOG_POLICY(1, CBCM_ENROLLMENT)
+        << "Cloud management controller initialization skipped; CBCM is not "
+           "enabled.";
+#else
     LOG_POLICY(ERROR, CBCM_ENROLLMENT)
         << "Cloud management controller initialization aborted as CBCM is not "
            "enabled. Please use the `--enable-chrome-browser-cloud-management` "
            "command line flag to enable it if you are not using the official "
            "Google Chrome build.";
+#endif
     return;
   }
   LOG_POLICY(INFO, CBCM_ENROLLMENT)
diff --git a/components/media_router/common/providers/cast/cast_media_source.cc b/components/media_router/common/providers/cast/cast_media_source.cc
