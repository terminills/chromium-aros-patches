From 364279328a1d2b08a1c85b609baf878c328f53b3 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sun, 2 Aug 2026 21:45:06 -0500
Subject: [PATCH 491/638] AROS: checkpoint late process-state rollback
 diagnostic

Temporarily restore the pre-August global state for AtExit, work IDs, timing, discardable memory, and memory instrumentation. This preserves a bounded A/B checkpoint for the Fast.com compositor regression; it is diagnostic, not the intended final architecture.



---
 base/at_exit.cc                               | 48 +++++---------
 base/memory/discardable_memory_allocator.cc   | 50 ++-------------
 base/message_loop/work_id_provider.cc         | 45 --------------
 base/time/time.cc                             | 62 +------------------
 base/trace_event/memory_dump_manager.cc       | 33 ----------
 .../queued_request_dispatcher.cc              |  6 +-
 .../client_process_impl.cc                    | 35 -----------
 .../memory_instrumentation.cc                 | 32 ----------
 8 files changed, 22 insertions(+), 289 deletions(-)

diff --git a/base/at_exit.cc b/base/at_exit.cc
index bd51cb5118..00fb35798b 100644
--- a/base/at_exit.cc
+++ b/base/at_exit.cc
@@ -48,41 +48,26 @@ AtExitProcessRegistry& GetAtExitProcessRegistry() {
   return *registry;
 }
 
-AtExitProcessState& GetCurrentTaskState() {
-  auto& registry = GetAtExitProcessRegistry();
-  AutoLock lock(registry.lock);
-  return registry.states[FindTask(nullptr)];
-}
+struct Task* GetCurrentProcessTask() {
+  struct Task* task = FindTask(nullptr);
+  struct Task* const current = task;
 
-AtExitProcessState& GetCurrentProcessState() {
-  auto& registry = GetAtExitProcessRegistry();
-  AutoLock lock(registry.lock);
-  struct Task* const current = FindTask(nullptr);
-  struct Task* task = current;
-
-  // Native child processes and pthread workers do not all expose an
-  // NT_PROCESS node at the same point in their ETask ancestry.  Bind a new
-  // manager to the task that creates it, then let descendants find the first
-  // already-registered owner.  This is the same ownership rule used by the
-  // AROS CommandLine registry and keeps in-process renderer workers attached
-  // to the browser process's AtExitManager.
   for (size_t depth = 0; task && depth < 64; ++depth) {
-    const auto it = registry.states.find(task);
-    if (it != registry.states.end()) {
-      return it->second;
+    if (task->tc_Node.ln_Type == NT_PROCESS) {
+      return task;
     }
 
     struct ETask* etask = GetETask(task);
     task = etask ? static_cast<struct Task*>(etask->et_Parent) : nullptr;
   }
 
-  return registry.states[current];
+  return current;
 }
 
-AtExitManager*& GetTopManagerForNewManager() {
-  // Constructing an AtExitManager defines a new native-process owner.  Do not
-  // inherit an ancestor's manager here: only descendant lookups inherit.
-  return GetCurrentTaskState().top_manager;
+AtExitProcessState& GetCurrentProcessState() {
+  auto& registry = GetAtExitProcessRegistry();
+  AutoLock lock(registry.lock);
+  return registry.states[GetCurrentProcessTask()];
 }
 
 AtExitManager*& GetTopManager() {
@@ -113,16 +98,12 @@ bool& GetDisableManagers() {
   return g_disable_managers;
 }
 
-AtExitManager*& GetTopManagerForNewManager() {
-  return GetTopManager();
-}
-
 #endif
 
 }  // namespace
 
-AtExitManager::AtExitManager() : next_manager_(GetTopManagerForNewManager()) {
-  AtExitManager*& top_manager = GetTopManagerForNewManager();
+AtExitManager::AtExitManager() : next_manager_(GetTopManager()) {
+  AtExitManager*& top_manager = GetTopManager();
 // If multiple modules instantiate AtExitManagers they'll end up living in this
 // module... they have to coexist.
 #if !defined(COMPONENT_BUILD)
@@ -208,9 +189,8 @@ void AtExitManager::DisableAllAtExitManagers() {
   GetDisableManagers() = true;
 }
 
-AtExitManager::AtExitManager(bool shadow)
-    : next_manager_(GetTopManagerForNewManager()) {
-  AtExitManager*& top_manager = GetTopManagerForNewManager();
+AtExitManager::AtExitManager(bool shadow) : next_manager_(GetTopManager()) {
+  AtExitManager*& top_manager = GetTopManager();
   DCHECK(shadow || !top_manager);
   top_manager = this;
 }
