 content/shell/BUILD.gn                   |  4 ++--
 content/shell/app/shell_main_delegate.cc | 18 +++++++++---------
 content/shell/app/shell_main_delegate.h  |  4 ++--
 3 files changed, 13 insertions(+), 13 deletions(-)

