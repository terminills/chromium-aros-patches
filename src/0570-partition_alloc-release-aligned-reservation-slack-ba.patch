From 8610d2822ab4b61bacdfa18da222b68d8d10d2cf Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 7 Sep 2026 12:08:51 -0500
Subject: [PATCH 570/638] partition_alloc: release aligned-reservation slack
 back to exec on AROS

---
 .../page_allocator_internals_aros.h           | 51 +++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h b/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h
index 2f5c59299d..46cf63a2e4 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h
@@ -191,6 +191,10 @@ bool RetainTrimmedPageAllocation(uintptr_t base_address,
                                  uintptr_t result,
                                  size_t trim_length) {
   bool found = false;
+  void* free_head = nullptr;
+  size_t free_head_length = 0;
+  void* free_tail = nullptr;
+  size_t free_tail_length = 0;
 
   LockPageAllocations();
   for (PageAllocationRecord* record = s_pageAllocations; record;
@@ -199,11 +203,58 @@ bool RetainTrimmedPageAllocation(uintptr_t base_address,
         record->exposed_length == base_length) {
       record->exposed_base = result;
       record->exposed_length = trim_length;
+      if (record->exec_owned) {
+        // Exec memory is physically backed, and an aligned pool reservation
+        // over-allocates by its alignment (the 2 GiB regular pool costs
+        // 4 GiB before trimming). Exec's FreeMem() is Deallocate(): any
+        // sub-range of an allocation may go back, so hand the slack on both
+        // sides of the aligned block back to the system and keep only the
+        // trimmed block for the final free.
+        const uintptr_t alloc_base =
+            reinterpret_cast<uintptr_t>(record->allocation_base);
+        const uintptr_t alloc_end = alloc_base + record->allocation_length;
+        const uintptr_t trim_end = result + trim_length;
+        if (result > alloc_base) {
+          free_head = record->allocation_base;
+          free_head_length = result - alloc_base;
+        }
+        if (alloc_end > trim_end) {
+          free_tail = reinterpret_cast<void*>(trim_end);
+          free_tail_length = alloc_end - trim_end;
+        }
+        record->allocation_base = reinterpret_cast<void*>(result);
+        record->allocation_length = trim_length;
+        record->protected_base = result;
+        record->protected_length = trim_length;
+      }
       found = true;
       break;
     }
   }
   UnlockPageAllocations();
+
+  // The reservation was mapped with the caller's (usually inaccessible)
+  // protection over its whole length; the pool the slack goes back to is
+  // executable by default (see FreePagesInternal).
+  if (free_head || free_tail) {
+    APTR KernelBase = OpenKernelResource();
+    PA_CHECK(KernelBase);
+    constexpr KRN_MapAttr kDefault = static_cast<KRN_MapAttr>(
+        MAP_Readable | MAP_Writable | MAP_Executable);
+    // Only [base_address, base_address + base_length) was ever protected;
+    // the Exec allocation's own head/tail padding sits outside it, in pages
+    // this record does not own.
+    if (free_head) {
+      SetProtection(KernelBase, base_address, result - base_address, kDefault);
+      FreeMem(free_head, free_head_length);
+    }
+    if (free_tail) {
+      SetProtection(KernelBase, result + trim_length,
+                    base_address + base_length - (result + trim_length),
+                    kDefault);
+      FreeMem(free_tail, free_tail_length);
+    }
+  }
   return found;
 }
 
