From abf759c2a8e2e9f29a51b7e9f71449363e22c3f3 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 8 Sep 2026 01:08:56 -0500
Subject: [PATCH 598/638] content: run the video capture service in-process on
 AROS

The out-of-process configuration launches a utility process that never
services GetSourceInfos(), so MediaDevicesManager waits on VIDEO_INPUT
forever and navigator.mediaDevices.enumerateDevices() never resolves.
Use the browser-process configuration as Android and ChromeOS do; the
AROS device factory then answers with its empty list at once.
---
 content/public/common/content_features.cc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/content/public/common/content_features.cc b/content/public/common/content_features.cc
index e9a5d6c5ca..edd84d4fdb 100644
--- a/content/public/common/content_features.cc
+++ b/content/public/common/content_features.cc
@@ -1368,7 +1368,9 @@ VideoCaptureServiceConfiguration GetVideoCaptureServiceConfiguration() {
 // On ChromeOS the service must run in the browser process, because parts of the
 // code depend on global objects that are only available in the Browser process.
 // See https://crbug.com/891961.
-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS)
+// AROS runs single-process; the video capture service lives in the browser so
+// device enumeration does not wait on a utility process.
+#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_AROS)
   return VideoCaptureServiceConfiguration::kEnabledForBrowserProcess;
 #else
   return base::FeatureList::IsEnabled(
