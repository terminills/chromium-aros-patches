 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
@@ -30,17 +26,6 @@ namespace cc {
 namespace mojo_embedder {
 
 namespace {
-#if BUILDFLAG(IS_AROS)
-uint32_t ArosByteFingerprint(base::span<const uint8_t> bytes) {
-  uint32_t fingerprint = 2166136261u;
-  for (uint8_t byte : bytes.first(std::min<size_t>(bytes.size(), 256u))) {
-    fingerprint ^= byte;
-    fingerprint *= 16777619u;
-  }
-  return fingerprint;
-}
-#endif
-
