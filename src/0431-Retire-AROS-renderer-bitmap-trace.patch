   using ProtoReason =
       ::perfetto::protos::pbzero::ChromeGraphicsPipeline::FrameSkippedReason;
@@ -297,20 +282,6 @@ void AsyncLayerTreeFrameSink::DidAllocateSharedBitmap(
     base::ReadOnlySharedMemoryRegion region,
     const viz::SharedBitmapId& id) {
   DCHECK(compositor_frame_sink_ptr_);
-#if BUILDFLAG(IS_AROS)
-  static size_t aros_allocated_bitmap_count = 0;
-  if (aros_allocated_bitmap_count < 16) {
-    base::ReadOnlySharedMemoryMapping mapping = region.Map();
-    const base::span<const uint8_t> bytes =
-        mapping.GetMemoryAsSpan<uint8_t>();
-    ++aros_allocated_bitmap_count;
-    LOG(ERROR) << "[AROS renderer-bitmap] seq="
-               << aros_allocated_bitmap_count << " id=" << id.ToDebugString()
-               << " region_size=" << region.GetSize()
-               << " map_valid=" << mapping.IsValid()
-               << " fingerprint=" << ArosByteFingerprint(bytes);
-  }
-#endif
   compositor_frame_sink_ptr_->DidAllocateSharedBitmap(std::move(region), id);
 }
 
