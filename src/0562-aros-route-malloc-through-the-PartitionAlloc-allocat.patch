diff --git a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
new file mode 100644
index 0000000000..7a4573355c
--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
@@ -0,0 +1,36 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "partition_alloc/shim/allocator_shim_aros_libc.h"
+
+#include <defines/stdc_LVO.h>
+
+// <proto/stdc.h> pulls in the complete C library prototypes, which include
+// C99 complex-number declarations that do not parse in C++. Only the library
+// base getter (provided by libstdc's auto-open code) is needed here.
+extern "C" struct StdCBase* __aros_getbase_StdCBase(void);
+
+namespace allocator_shim::internal {
+
+namespace {
+
+// stdc.library function vectors sit below the library base, one pointer per
+// LVO, in the same way <inline/stdc.h> reaches them.
+template <typename Fn>
+Fn StdCVector(int lvo) {
+  void** base = reinterpret_cast<void**>(__aros_getbase_StdCBase());
+  return reinterpret_cast<Fn>(base[-lvo]);
+}
+
+}  // namespace
+
+void ArosLibcFree(void* ptr) {
+  StdCVector<void (*)(void*)>(LVOfree)(ptr);
+}
+
+void* ArosLibcRealloc(void* ptr, size_t size) {
+  return StdCVector<void* (*)(void*, size_t)>(LVOrealloc)(ptr, size);
+}
+
+}  // namespace allocator_shim::internal
diff --git a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.h b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.h
new file mode 100644
index 0000000000..45bac36fcc
--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.h
@@ -0,0 +1,26 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_SHIM_ALLOCATOR_SHIM_AROS_LIBC_H_
+#define BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_SHIM_ALLOCATOR_SHIM_AROS_LIBC_H_
+
+#include <cstddef>
+
+#include "partition_alloc/partition_alloc_base/component_export.h"
+
+// On AROS the shim replaces the malloc family of the executable, but
+// stdc.library keeps allocating on behalf of the program (strdup(), asprintf(),
+// realpath(NULL, ...), scandir(), ...) from its own pool. Pointers handed out
+// that way reach the shim's free()/realloc() and must be routed back to the
+// library. These entry points call stdc.library through its jump table, so
+// they are unaffected by the symbol override.
+namespace allocator_shim::internal {
+
+PA_COMPONENT_EXPORT(ALLOCATOR_SHIM) void ArosLibcFree(void* ptr);
+PA_COMPONENT_EXPORT(ALLOCATOR_SHIM)
+void* ArosLibcRealloc(void* ptr, size_t size);
+
+}  // namespace allocator_shim::internal
+
+#endif  // BASE_ALLOCATOR_PARTITION_ALLOCATOR_SRC_PARTITION_ALLOC_SHIM_ALLOCATOR_SHIM_AROS_LIBC_H_
