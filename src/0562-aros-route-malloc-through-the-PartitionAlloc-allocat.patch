 #endif
@@ -255,6 +259,15 @@ void* PartitionAlignedRealloc(const AllocatorDispatch* dispatch,
                               size_t alignment,
                               void* context) {
   partition_alloc::ScopedDisallowAllocations guard{};
+#if BUILDFLAG(IS_AROS)
+  if (PA_UNLIKELY(!partition_alloc::IsManagedByPartitionAlloc(
+                      reinterpret_cast<uintptr_t>(address)) &&
+                  address)) {
+    // The block belongs to stdc.library; let it resize the block. The library
+    // only guarantees its default alignment for the result.
+    return ArosLibcRealloc(address, size);
+  }
+#endif  // BUILDFLAG(IS_AROS)
   void* new_ptr = nullptr;
   if (size > 0) {
     new_ptr = AllocateAlignedMemory(alignment, size);
@@ -297,6 +310,15 @@ void* PartitionRealloc(const AllocatorDispatch*,
     return realloc(address, size);
   }
 #endif  // BUILDFLAG(IS_APPLE)
+#if BUILDFLAG(IS_AROS)
+  if (PA_UNLIKELY(!partition_alloc::IsManagedByPartitionAlloc(
+                      reinterpret_cast<uintptr_t>(address)) &&
+                  address)) {
+    // A block allocated by stdc.library on the program's behalf (strdup(),
+    // asprintf(), ...) is passed in. Forward it to the library's realloc().
+    return ArosLibcRealloc(address, size);
+  }
+#endif  // BUILDFLAG(IS_AROS)
 
   return Allocator()->Realloc<partition_alloc::AllocFlags::kNoHooks>(address,
                                                                      size, "");
@@ -321,6 +343,15 @@ void PartitionFree(const AllocatorDispatch*, void* object, void* context) {
     return free(object);
   }
 #endif  // BUILDFLAG(IS_APPLE)
+#if BUILDFLAG(IS_AROS)
+  if (PA_UNLIKELY(!partition_alloc::IsManagedByPartitionAlloc(
+                      reinterpret_cast<uintptr_t>(object)) &&
+                  object)) {
+    // A block allocated by stdc.library on the program's behalf is passed in.
+    // Forward it to the library's free().
+    return ArosLibcFree(object);
+  }
+#endif  // BUILDFLAG(IS_AROS)
 
   // On Android Chromecast devices, there is at least one case where a system
   // malloc() pointer can be passed to PartitionAlloc's free(). If we don't own
@@ -369,7 +400,7 @@ size_t PartitionGetSizeEstimate(const AllocatorDispatch*,
     return 0;
   }
 
-#if BUILDFLAG(IS_APPLE)
+#if BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_AROS)
   if (!partition_alloc::IsManagedByPartitionAlloc(
           reinterpret_cast<uintptr_t>(address))) {
     // The object pointed to by `address` is not allocated by the
@@ -377,7 +408,7 @@ size_t PartitionGetSizeEstimate(const AllocatorDispatch*,
     // belong to this malloc zone.
     return 0;
   }
-#endif  // BUILDFLAG(IS_APPLE)
+#endif  // BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_AROS)
 
   // TODO(lizeb): Returns incorrect values for aligned allocations.
   const size_t size =
diff --git a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_internals.h b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_internals.h
index 2c1f2c695c..5cfec939d8 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_internals.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_internals.h
@@ -13,6 +13,14 @@
 #include <sys/cdefs.h>  // for __THROW
 #endif
 
+#if BUILDFLAG(IS_AROS)
+// <aros/system.h> defines __THROW as `throw ()` for C++, but the AROS C
+// library declares the malloc family without an exception specification. The
+// shim definitions must match those declarations.
+#undef __THROW
+#define __THROW
+#endif
+
 #ifndef __THROW   // Not a glibc system
 #ifdef _NOEXCEPT  // LLVM libc++ uses noexcept instead
 #define __THROW _NOEXCEPT
