+struct Window* ArosWindowManager::GetNativeWindow(
+    gfx::AcceleratedWidget widget) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  if (window_it == windows_.end()) {
+    return nullptr;
+  }
+
+  for (const auto& native_window : native_windows_) {
+    if (native_window.second == window_it->second) {
+      return native_window.first;
+    }
+  }
+  return nullptr;
+}
