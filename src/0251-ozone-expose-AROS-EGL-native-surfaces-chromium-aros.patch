+#include <stdint.h>
+
+#include "base/logging.h"
+#include "base/memory/scoped_refptr.h"
+#include "ui/gl/gl_surface.h"
+#include "ui/gl/gl_surface_egl.h"
+#include "ui/ozone/platform/aros/aros_egl_library.h"
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+
+namespace ui {
+
+GLOzoneEGLAros::GLOzoneEGLAros(ArosWindowManager* window_manager)
+    : window_manager_(window_manager) {}
+
+GLOzoneEGLAros::~GLOzoneEGLAros() = default;
+
+scoped_refptr<gl::GLSurface> GLOzoneEGLAros::CreateViewGLSurface(
+    gl::GLDisplay* display,
+    gfx::AcceleratedWidget window) {
+  struct Window* native_window = window_manager_->GetNativeWindow(window);
+  if (!native_window) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] no Intuition window for widget="
+               << window;
+    return nullptr;
+  }
+
+  auto* egl_display = display->GetAs<gl::GLDisplayEGL>();
+  const EGLNativeWindowType egl_window = static_cast<EGLNativeWindowType>(
+      reinterpret_cast<intptr_t>(native_window));
+  LOG(INFO) << "[Chromium:Ozone:AROS:EGL] creating window surface widget="
+            << window << " native=" << native_window;
+  return gl::InitializeGLSurface(
+      base::MakeRefCounted<gl::NativeViewGLSurfaceEGL>(egl_display, egl_window,
+                                                       nullptr));
+}
+
+scoped_refptr<gl::GLSurface> GLOzoneEGLAros::CreateOffscreenGLSurface(
+    gl::GLDisplay* display,
+    const gfx::Size& size) {
+  return gl::InitializeGLSurface(base::MakeRefCounted<gl::PbufferGLSurfaceEGL>(
+      display->GetAs<gl::GLDisplayEGL>(), size));
+}
+
+gl::EGLDisplayPlatform GLOzoneEGLAros::GetNativeDisplay() {
+  return gl::EGLDisplayPlatform(EGL_DEFAULT_DISPLAY);
+}
+
+bool GLOzoneEGLAros::LoadGLES2Bindings(
+    const gl::GLImplementationParts& implementation) {
+  if (implementation.gl != gl::kGLImplementationEGLGLES2 ||
+      !GetArosEGLProcAddress("eglGetDisplay")) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS:EGL] egl.library bindings unavailable";
+    return false;
+  }
+
+  gl::SetGLGetProcAddressProc(&GetArosEGLProcAddress);
+  LOG(INFO) << "[Chromium:Ozone:AROS:EGL] using egl.library entry points";
+  return true;
+}
+
+}  // namespace ui
