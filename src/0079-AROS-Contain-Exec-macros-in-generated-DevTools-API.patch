@@ -9,6 +9,8 @@
 #include "base/functional/bind.h"
 #include "headless/public/util/error_reporter.h"
 
+{% include "aros_macro_hygiene.template" %}
+
 namespace headless {
 
 namespace {{domain.domain | camelcase_to_hacker_style}} {
