--- a/ui/ozone/platform/aros/ozone_platform_aros.cc
+++ b/ui/ozone/platform/aros/ozone_platform_aros.cc
@@ -14,6 +14,7 @@
 #include "base/time/time.h"
 #include "base/timer/timer.h"
 #include "ui/base/cursor/cursor_factory.h"
+#include "ui/base/cursor/platform_cursor.h"
 #include "ui/base/ime/input_method_minimal.h"
 #include "ui/display/types/native_display_delegate.h"
 #include "ui/events/ozone/layout/keyboard_layout_engine_manager.h"
@@ -35,6 +36,24 @@ namespace ui {
 
 namespace {
 
+class ArosCursorFactory : public BitmapCursorFactory {
+ public:
+  ArosCursorFactory() = default;
+  ~ArosCursorFactory() override = default;
+
+  scoped_refptr<PlatformCursor> GetDefaultCursor(
+      mojom::CursorType type) override {
+    if (type == mojom::CursorType::kNone) {
+      return BitmapCursorFactory::GetDefaultCursor(type);
+    }
+
+    // AROS installs custom pointerclass objects rather than looking up
+    // server-side cursor names. Returning null asks CursorLoader to provide
+    // Chromium's Aura bitmap for every standard cursor shape.
+    return nullptr;
+  }
+};
+
 // The first-window slice keeps IDCMP consumption local to Ozone. A subsequent
 // commit will register the port signal directly with MessagePumpAROS.
 class ArosPlatformEventSource : public PlatformEventSource {
@@ -130,7 +149,7 @@ class OzonePlatformAros : public OzonePlatform {
         keyboard_layout_engine_.get());
     overlay_manager_ = std::make_unique<StubOverlayManager>();
     input_controller_ = CreateStubInputController();
-    cursor_factory_ = std::make_unique<BitmapCursorFactory>();
+    cursor_factory_ = std::make_unique<ArosCursorFactory>();
     gpu_platform_support_host_.reset(CreateStubGpuPlatformSupportHost());
     return true;
   }
