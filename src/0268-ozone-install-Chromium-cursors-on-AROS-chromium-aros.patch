 #include <proto/graphics.h>
@@ -410,6 +413,7 @@ ArosWindow::~ArosWindow() {
   shutting_down_ = true;
   if (window_) {
     DisableNativeEvents();
+    ResetNativeCursor();
     manager_->DetachNativeWindow(widget_, this, window_);
     CloseWindow(window_);
     window_ = nullptr;
@@ -572,7 +576,60 @@ bool ArosWindow::ShouldUseNativeFrame() const {
   return true;
 }
 
-void ArosWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {}
+void ArosWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {
+  if (!window_ || cursor_ == cursor) {
+    return;
+  }
+
+  ResetNativeCursor();
+  cursor_ = std::move(cursor);
+  if (!cursor_) {
+    return;
+  }
+
+  scoped_refptr<BitmapCursor> bitmap_cursor =
+      BitmapCursor::FromPlatformCursor(cursor_);
+  if (bitmap_cursor->type() == mojom::CursorType::kNone) {
+    cursor_object_ = NewObject(
+        nullptr,
+        const_cast<UBYTE*>(reinterpret_cast<const UBYTE*>("pointerclass")),
+        TAG_DONE);
+  } else if (!bitmap_cursor->bitmaps().empty()) {
+    const SkBitmap& bitmap = bitmap_cursor->bitmap();
+    if (!bitmap.isNull() && bitmap.width() > 0 && bitmap.height() > 0 &&
+        bitmap.width() <= 64 && bitmap.height() <= 64 && bitmap.getPixels()) {
+      cursor_bitmap_ = AllocBitMap(bitmap.width(), bitmap.height(), 32,
+                                   BMF_CLEAR | BMF_DISPLAYABLE,
+                                   window_->WScreen->RastPort.BitMap);
+      if (cursor_bitmap_) {
+        struct RastPort cursor_rast_port;
+        InitRastPort(&cursor_rast_port);
+        cursor_rast_port.BitMap = cursor_bitmap_;
+        const LONG written =
+            WritePixelArray(const_cast<void*>(bitmap.getPixels()), 0, 0,
+                            bitmap.rowBytes(), &cursor_rast_port, 0, 0,
+                            bitmap.width(), bitmap.height(), RECTFMT_BGRA32);
+        if (written > 0) {
+          const gfx::Point& hotspot = bitmap_cursor->hotspot();
+          cursor_object_ = NewObject(
+              nullptr,
+              const_cast<UBYTE*>(
+                  reinterpret_cast<const UBYTE*>("pointerclass")),
+              POINTERA_BitMap, reinterpret_cast<IPTR>(cursor_bitmap_),
+              POINTERA_WordWidth, (bitmap.width() + 15) / 16, POINTERA_XOffset,
+              -hotspot.x(), POINTERA_YOffset, -hotspot.y(), TAG_DONE);
+        }
+      }
+    }
+  }
+
+  if (cursor_object_) {
+    SetWindowPointer(window_, WA_Pointer, cursor_object_, TAG_DONE);
+  } else if (bitmap_cursor->type() == mojom::CursorType::kWait ||
+             bitmap_cursor->type() == mojom::CursorType::kProgress) {
+    SetWindowPointer(window_, WA_BusyPointer, TRUE, TAG_DONE);
+  }
+}
 
 void ArosWindow::MoveCursorTo(const gfx::Point& location) {}
 
@@ -591,6 +648,21 @@ void ArosWindow::SetWindowIcons(const gfx::ImageSkia& window_icon,
 
 void ArosWindow::SizeConstraintsChanged() {}
 
+void ArosWindow::ResetNativeCursor() {
+  if (window_) {
+    SetWindowPointer(window_, TAG_DONE);
+  }
+  if (cursor_object_) {
+    DisposeObject(static_cast<Object*>(cursor_object_));
+    cursor_object_ = nullptr;
+  }
+  if (cursor_bitmap_) {
+    FreeBitMap(cursor_bitmap_);
+    cursor_bitmap_ = nullptr;
+  }
+  cursor_.reset();
+}
+
 void ArosWindow::HandleNativeEvent(uint32_t message_class,
                                    uint16_t code,
                                    uint16_t qualifier,
