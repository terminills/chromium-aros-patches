From ed0b01b0c4e4158f249a3bf260cb3e6a84955c10 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 29 Jul 2026 03:35:49 -0500
Subject: [PATCH 397/638] [AROS] Separate root and child Viz frame probes

AI_PHASE: chromium-process-model

AI_STATUS: diagnostic

OBSERVED: Runtime 38 proved the global 16-frame counter recorded only FrameSinkId(0,1) root submissions, saturating before it could show whether a non-root web renderer surface ever arrived.

FIX_REASON: Bound telemetry independently to 16 root and 16 non-root frames and record pre-aggregation quad materials plus referenced-surface count, separating missing child submission from Surface activation/aggregation loss.

SCOPE: AROS-only diagnostics in CompositorFrameSinkSupport; no non-AROS or compositor semantics changed.

VALIDATION: git diff --check passed; runtime/build validation follows under with -j32.

AI_DECISION_CHAIN: runtime 38 -> runtime 39 per-sink probe
---
 .../compositor_frame_sink_support.cc          | 49 +++++++++++++++++--
 1 file changed, 46 insertions(+), 3 deletions(-)

diff --git a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
index 2c15e36014..fdfdd4e372 100644
--- a/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
+++ b/components/viz/service/frame_sinks/compositor_frame_sink_support.cc
@@ -30,6 +30,7 @@
 #include "components/viz/common/quads/compositor_frame.h"
 #include "components/viz/common/quads/compositor_frame_metadata.h"
 #include "components/viz/common/quads/compositor_render_pass.h"
+#include "components/viz/common/quads/draw_quad.h"
 #include "components/viz/common/resources/bitmap_allocation.h"
 #include "components/viz/common/surfaces/surface_info.h"
 #include "components/viz/common/surfaces/video_capture_target.h"
@@ -741,23 +742,65 @@ SubmitResult CompositorFrameSinkSupport::MaybeSubmitCompositorFrame(
     uint64_t submit_time,
     mojom::CompositorFrameSink::SubmitCompositorFrameSyncCallback callback) {
 #if BUILDFLAG(IS_AROS)
-  static size_t aros_received_frame_count = 0;
+  static size_t aros_root_frame_count = 0;
+  static size_t aros_child_frame_count = 0;
+  const bool is_root_sink = frame_sink_id_.client_id() == 0;
+  size_t& aros_received_frame_count =
+      is_root_sink ? aros_root_frame_count : aros_child_frame_count;
   if (aros_received_frame_count < 16) {
     size_t quad_count = 0;
     size_t software_resource_count = 0;
-    for (const auto& pass : frame.render_pass_list)
+    size_t render_pass_quad_count = 0;
+    size_t solid_quad_count = 0;
+    size_t surface_quad_count = 0;
+    size_t texture_quad_count = 0;
+    size_t tile_quad_count = 0;
+    size_t other_quad_count = 0;
+    for (const auto& pass : frame.render_pass_list) {
       quad_count += pass->quad_list.size();
+      for (const auto* quad : pass->quad_list) {
+        switch (quad->material) {
+          case DrawQuad::Material::kCompositorRenderPass:
+            ++render_pass_quad_count;
+            break;
+          case DrawQuad::Material::kSolidColor:
+            ++solid_quad_count;
+            break;
+          case DrawQuad::Material::kSurfaceContent:
+            ++surface_quad_count;
+            break;
+          case DrawQuad::Material::kTextureContent:
+            ++texture_quad_count;
+            break;
+          case DrawQuad::Material::kTiledContent:
+            ++tile_quad_count;
+            break;
+          default:
+            ++other_quad_count;
+            break;
+        }
+      }
+    }
     for (const auto& resource : frame.resource_list)
       software_resource_count += resource.is_software ? 1u : 0u;
     ++aros_received_frame_count;
     LOG(ERROR) << "[AROS viz-frame] seq=" << aros_received_frame_count
+               << " role=" << (is_root_sink ? "root" : "child")
                << " sink=" << frame_sink_id_.ToString()
                << " surface=" << local_surface_id.ToString()
                << " size=" << frame.size_in_pixels().ToString()
                << " passes=" << frame.render_pass_list.size()
                << " quads=" << quad_count
+               << " render_pass=" << render_pass_quad_count
+               << " solid=" << solid_quad_count
+               << " surface_quads=" << surface_quad_count
+               << " texture=" << texture_quad_count
+               << " tile=" << tile_quad_count
+               << " other=" << other_quad_count
                << " resources=" << frame.resource_list.size()
-               << " software_resources=" << software_resource_count;
+               << " software_resources=" << software_resource_count
+               << " referenced_surfaces="
+               << frame.metadata.referenced_surfaces.size();
   }
 #endif
 
