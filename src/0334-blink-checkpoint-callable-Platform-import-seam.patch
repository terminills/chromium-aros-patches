--- /dev/null
+++ b/build/config/aros/blink_platform_library/blink_platform_import_resolver.cc
@@ -0,0 +1,43 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <stddef.h>
+
+#include <proto/blink_platform.h>
+
+extern "C" void ArosKPutStr(const char*) asm("KPutStr");
+
+extern "C" {
+extern const size_t g_blink_platform_import_count;
+extern const char* const g_blink_platform_import_names[];
+extern void* g_blink_platform_import_slots[];
+}
+
+namespace {
+
+extern "C" [[noreturn]] void ArosMissingBlinkPlatformImport() {
+  ArosKPutStr(
+      "[Chromium:shared-blink-platform] called unresolved Platform import\n");
+  __builtin_trap();
+}
+
+}  // namespace
+
+extern "C" void* ArosResolveBlinkPlatformImport(size_t index) {
+  if (index >= g_blink_platform_import_count)
+    return reinterpret_cast<void*>(&ArosMissingBlinkPlatformImport);
+
+  const char* symbol = g_blink_platform_import_names[index];
+  void* resolved = BlinkPlatformFindEngineSymbol(symbol);
+  if (!resolved) {
+    ArosKPutStr("[Chromium:shared-blink-platform] unresolved import: ");
+    ArosKPutStr(symbol);
+    ArosKPutStr("\n");
+    return reinterpret_cast<void*>(&ArosMissingBlinkPlatformImport);
+  }
+
+  __atomic_store_n(&g_blink_platform_import_slots[index], resolved,
+                   __ATOMIC_RELEASE);
+  return resolved;
+}
diff --git a/build/config/aros/blink_platform_library/generate_blink_platform_imports.py b/build/config/aros/blink_platform_library/generate_blink_platform_imports.py
new file mode 100644
index 0000000000..700a16c945
--- /dev/null
+++ b/build/config/aros/blink_platform_library/generate_blink_platform_imports.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Generates x86-64 AROS import trampolines for blink_platform.library."""
+
+import argparse
+import pathlib
+import re
+
+
+_SYMBOL_RE = re.compile(r"^[_A-Za-z][_A-Za-z0-9.$]*$")
+
+
+def _read_manifest(path: pathlib.Path) -> list[str]:
+    symbols = []
+    seen = set()
+    for line_number, raw_line in enumerate(
+        path.read_text(encoding="utf-8").splitlines(), start=1
+    ):
+        symbol = raw_line.strip()
+        if not symbol or symbol.startswith("#"):
+            continue
+        if not _SYMBOL_RE.fullmatch(symbol):
+            raise ValueError(
+                f"{path}:{line_number}: invalid assembler symbol {symbol!r}"
+            )
+        if symbol in seen:
+            raise ValueError(
+                f"{path}:{line_number}: duplicate symbol {symbol!r}"
+            )
+        seen.add(symbol)
+        symbols.append(symbol)
+    if not symbols:
+        raise ValueError(f"{path}: import manifest is empty")
+    return symbols
+
+
+def _emit(symbols: list[str]) -> str:
+    lines = [
+        "// Generated by generate_blink_platform_imports.py. Do not edit.",
+        "",
+        "        .text",
+        "        .p2align 4",
+        "        .globl ArosBlinkPlatformImportSlowPath",
+        "        .type ArosBlinkPlatformImportSlowPath, @function",
+        "ArosBlinkPlatformImportSlowPath:",
+        "        // Preserve every SysV x86-64 integer and SSE argument",
+        "        // register, including RAX/AL's variadic-call metadata.",
+        "        pushq %rax",
+        "        pushq %rdi",
+        "        pushq %rsi",
+        "        pushq %rdx",
+        "        pushq %rcx",
+        "        pushq %r8",
+        "        pushq %r9",
+        "        pushq %r10",
+        "        pushq %r11",
+        "        subq $136, %rsp",
+        "        movdqu %xmm0, 0(%rsp)",
+        "        movdqu %xmm1, 16(%rsp)",
+        "        movdqu %xmm2, 32(%rsp)",
+        "        movdqu %xmm3, 48(%rsp)",
+        "        movdqu %xmm4, 64(%rsp)",
+        "        movdqu %xmm5, 80(%rsp)",
+        "        movdqu %xmm6, 96(%rsp)",
+        "        movdqu %xmm7, 112(%rsp)",
+        "        movq 208(%rsp), %rdi",
+        "        call ArosResolveBlinkPlatformImport",
+        "        // Replace the pushed import index with the target. The final",
+        "        // ret is therefore an ABI-transparent tail call.",
+        "        movq %rax, 208(%rsp)",
+        "        movdqu 0(%rsp), %xmm0",
+        "        movdqu 16(%rsp), %xmm1",
+        "        movdqu 32(%rsp), %xmm2",
+        "        movdqu 48(%rsp), %xmm3",
+        "        movdqu 64(%rsp), %xmm4",
+        "        movdqu 80(%rsp), %xmm5",
+        "        movdqu 96(%rsp), %xmm6",
+        "        movdqu 112(%rsp), %xmm7",
+        "        addq $136, %rsp",
+        "        popq %r11",
+        "        popq %r10",
+        "        popq %r9",
+        "        popq %r8",
+        "        popq %rcx",
+        "        popq %rdx",
+        "        popq %rsi",
+        "        popq %rdi",
+        "        popq %rax",
+        "        ret",
+        "        .size ArosBlinkPlatformImportSlowPath, "
+        ".-ArosBlinkPlatformImportSlowPath",
+        "",
+    ]
+
+    for index, symbol in enumerate(symbols):
+        lines.extend(
+            [
+                "        .p2align 4",
+                f"        .globl {symbol}",
+                f"        .type {symbol}, @function",
+                f"{symbol}:",
+                f"        jmp *g_blink_platform_import_slots+{index * 8}(%rip)",
+                f"        .size {symbol}, .-{symbol}",
+                f".Lslow_{index}:",
+                f"        pushq ${index}",
+                "        jmp ArosBlinkPlatformImportSlowPath",
+                "",
+            ]
+        )
+
+    lines.extend(
+        [
+            "        .section .rodata",
+            "        .p2align 3",
+            "        .globl g_blink_platform_import_count",
+            "        .type g_blink_platform_import_count, @object",
+            "g_blink_platform_import_count:",
+            f"        .quad {len(symbols)}",
+            "        .size g_blink_platform_import_count, 8",
+            "",
+            "        .globl g_blink_platform_import_names",
+            "        .type g_blink_platform_import_names, @object",
+            "g_blink_platform_import_names:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Limport_name_{index}")
+    lines.extend(
+        [
+            f"        .size g_blink_platform_import_names, {len(symbols) * 8}",
+            "",
+        ]
+    )
+    for index, symbol in enumerate(symbols):
+        lines.extend(
+            [
+                f".Limport_name_{index}:",
+                f'        .asciz "{symbol}"',
+            ]
+        )
+
+    lines.extend(
+        [
+            "",
+            "        .data",
+            "        .p2align 3",
+            "        .globl g_blink_platform_import_slots",
+            "        .type g_blink_platform_import_slots, @object",
+            "g_blink_platform_import_slots:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Lslow_{index}")
+    lines.extend(
+        [
+            f"        .size g_blink_platform_import_slots, {len(symbols) * 8}",
+            "",
+            '        .section .note.GNU-stack,"",@progbits',
+            "",
+        ]
+    )
+    return "\n".join(lines)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--manifest", required=True, type=pathlib.Path)
+    parser.add_argument("--output", required=True, type=pathlib.Path)
+    args = parser.parse_args()
+
+    symbols = _read_manifest(args.manifest)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(_emit(symbols), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
