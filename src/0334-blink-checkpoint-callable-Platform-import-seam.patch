From 0ed2ce85d63801ff87a61bbcaade4a88257b3cf1 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 19:57:01 -0500
Subject: [PATCH 334/638] blink: checkpoint callable Platform import seam

Generate lazy x86-64 AROS trampolines for the 2,316 strong callable symbols that Blink Core consumes from the proven blink_platform.library closure. The resolver preserves the SysV call ABI and caches exact-build symbol addresses through BlinkPlatformFindEngineSymbol.

Data-object crossings are deliberately excluded: synthesizing a function or pointer for an address-bearing C++ object would violate ABI and identity.

AI_PHASE: chromium-blink-core-library

AI_STATUS: callable-platform-import-surface-checkpoint

AI_ASSUMPTION: Core callable references can use the same exact-build lazy resolver contract proven by Chromium's v8.library bridge

AI_VALIDATION: manifest is sorted and unique with 2316 symbols; generator emits 32499 assembly lines; source diff check passes

AI_EVIDENCE: out/aros-blink-platform/test-artifacts/-blink-platform-library-20260725/17-core-platform-symbol-kind-audit.log

AI_LIMITATIONS: 646 Core-to-Platform data-object references remain intentionally unresolved and the consumer graph has not yet been generated

AI_DECISION_CHAIN:; 9fc61624cf; AROS 82be9578a8
---
 .../aros/blink_platform_library/BUILD.gn      |   39 +
 .../blink_platform_function_imports.txt       | 2316 +++++++++++++++++
 .../blink_platform_import_resolver.cc         |   43 +
 .../generate_blink_platform_imports.py        |  180 ++
 4 files changed, 2578 insertions(+)
 create mode 100644 build/config/aros/blink_platform_library/BUILD.gn
 create mode 100644 build/config/aros/blink_platform_library/blink_platform_function_imports.txt
 create mode 100644 build/config/aros/blink_platform_library/blink_platform_import_resolver.cc
 create mode 100644 build/config/aros/blink_platform_library/generate_blink_platform_imports.py

diff --git a/build/config/aros/blink_platform_library/BUILD.gn b/build/config/aros/blink_platform_library/BUILD.gn
new file mode 100644
index 0000000000..925ad802e5
--- /dev/null
+++ b/build/config/aros/blink_platform_library/BUILD.gn
@@ -0,0 +1,39 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+assert(is_aros)
+
+_generated_imports = "$target_gen_dir/blink_platform_library_imports.S"
+
+action("generate_blink_platform_library_imports") {
+  script = "generate_blink_platform_imports.py"
+
+  inputs = [ "blink_platform_function_imports.txt" ]
+  outputs = [ _generated_imports ]
+
+  args = [
+    "--manifest",
+    rebase_path(inputs[0], root_build_dir),
+    "--output",
+    rebase_path(outputs[0], root_build_dir),
+  ]
+}
+
+# Chromium-facing C++ ABI bridge for callable symbols resident in
+# blink_platform.library. Data objects deliberately are not synthesized here:
+# an address-bearing C++ object cannot be replaced by a function trampoline
+# without breaking its ABI and identity.
+source_set("blink_platform_library_imports") {
+  sources = [
+    "blink_platform_import_resolver.cc",
+    _generated_imports,
+  ]
+
+  deps = [ ":generate_blink_platform_library_imports" ]
+
+  libs = [
+    "blink_platform",
+    "debug",
+  ]
+}
