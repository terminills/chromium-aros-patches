From 0201b9d5faf2de5be17226f9d312c65bb3a131f9 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 13 Jul 2026 14:27:56 -0500
Subject: [PATCH 141/638] base: expose final memory dump shutdown [chromium]
 [aros]

AI_PHASE: chromium-headless-bringup

AI_STATUS: done

ROOT_CAUSE: MemoryDumpManager is a leaky process singleton whose lazily-created MemoryInfra base::Thread is normally terminated by the host process. AROS unloads executable code when the main task returns, and OPAL artifact 50 proved MemoryInfra remained live at that boundary.

FIX_REASON: Factor the destructor's existing stop-and-reset sequence into an idempotent ShutdownForProcessExit method so an AROS embedder can terminate the owned task before pthread's unload-safety hook runs, while preserving destructor behavior.

SCOPE: MemoryDumpManager lifetime API only; no dump scheduling or provider behavior changes before final process teardown.

VALIDATION: memory_dump_manager.o and its affected AROS base dependencies compiled successfully in out/aros-headless (166/166 touched-target build).

RISK: low; the new method reuses the destructor's established locking and Thread::Stop ordering and is inert until explicitly called.

AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
---
 base/trace_event/memory_dump_manager.cc | 6 +++++-
 base/trace_event/memory_dump_manager.h  | 4 ++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/base/trace_event/memory_dump_manager.cc b/base/trace_event/memory_dump_manager.cc
index eaa8333a6e..ddff608985 100644
--- a/base/trace_event/memory_dump_manager.cc
+++ b/base/trace_event/memory_dump_manager.cc
@@ -106,6 +106,11 @@ MemoryDumpManager::CreateInstanceForTesting() {
 MemoryDumpManager::MemoryDumpManager() = default;
 
 MemoryDumpManager::~MemoryDumpManager() {
+  ShutdownForProcessExit();
+  g_memory_dump_manager_for_testing = nullptr;
+}
+
+void MemoryDumpManager::ShutdownForProcessExit() {
   Thread* dump_thread = nullptr;
   {
     AutoLock lock(lock_);
@@ -118,7 +123,6 @@ MemoryDumpManager::~MemoryDumpManager() {
   }
   AutoLock lock(lock_);
   dump_thread_.reset();
-  g_memory_dump_manager_for_testing = nullptr;
 }
 
 void MemoryDumpManager::Initialize(
diff --git a/base/trace_event/memory_dump_manager.h b/base/trace_event/memory_dump_manager.h
index ef12d9df76..3ce00cb61c 100644
--- a/base/trace_event/memory_dump_manager.h
+++ b/base/trace_event/memory_dump_manager.h
@@ -55,6 +55,10 @@ class BASE_EXPORT MemoryDumpManager {
   // state to begin new initialization.
   void ResetForTesting();
 
+  // Stops the optional dump thread after all process clients have shut down.
+  // No new dump work may be submitted after this returns.
+  void ShutdownForProcessExit();
+
   MemoryDumpManager(const MemoryDumpManager&) = delete;
   MemoryDumpManager& operator=(const MemoryDumpManager&) = delete;
 
