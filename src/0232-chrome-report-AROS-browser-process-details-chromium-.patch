diff --git a/chrome/browser/memory_details_aros.cc b/chrome/browser/memory_details_aros.cc
new file mode 100644
index 0000000000..49b774e27a
--- /dev/null
+++ b/chrome/browser/memory_details_aros.cc
@@ -0,0 +1,56 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/memory_details.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/process/process_handle.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/grit/branded_strings.h"
+#include "components/version_info/version_info.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/common/process_type.h"
+#include "ui/base/l10n/l10n_util.h"
+
+MemoryDetails::MemoryDetails() {
+  ProcessData process;
+  process.name = l10n_util::GetStringUTF16(IDS_SHORT_PRODUCT_NAME);
+  process.process_name = u"chrome";
+  process_data_.push_back(process);
+}
+
+ProcessData* MemoryDetails::ChromeBrowser() {
+  return &process_data_[0];
+}
+
+void MemoryDetails::CollectProcessData(
+    const std::vector<ProcessMemoryInformation>& child_info) {
+  ProcessMemoryInformationList& processes = process_data_[0].processes;
+  processes.clear();
+
+  ProcessMemoryInformation browser;
+  browser.pid = base::GetCurrentProcId();
+  browser.num_processes = 1;
+  browser.process_type = content::PROCESS_TYPE_BROWSER;
+  browser.product_name =
+      base::ASCIIToUTF16(version_info::GetProductName());
+  browser.version = base::ASCIIToUTF16(version_info::GetVersionNumber());
+  processes.push_back(browser);
+
+  for (ProcessMemoryInformation child : child_info) {
+    if (child.pid == browser.pid) {
+      continue;
+    }
+    child.num_processes = 1;
+    child.product_name = browser.product_name;
+    child.version = browser.version;
+    processes.push_back(child);
+  }
+
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(&MemoryDetails::CollectChildInfoOnUIThread, this));
+}
