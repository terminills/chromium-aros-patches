+#include "extensions/browser/api/system_cpu/cpu_info_provider.h"
+
+namespace extensions {
+
+bool CpuInfoProvider::QueryCpuTimePerProcessor(
+    std::vector<api::system_cpu::ProcessorInfo>* infos) {
+  DCHECK(infos);
+  // AROS exposes processor identity but not cumulative per-core time through
+  // a stable public API yet. task.resource accounting can supply this later.
+  NOTIMPLEMENTED_LOG_ONCE();
+  return false;
+}
