+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+
+// static
+IconLoader::IconGroup IconLoader::GroupForFilepath(
+    const base::FilePath& file_path) {
+  return base::ToLowerASCII(file_path.Extension());
+}
+
+// static
+scoped_refptr<base::TaskRunner> IconLoader::GetReadIconTaskRunner() {
+  return base::ThreadPool::CreateSequencedTaskRunner(traits());
+}
+
+void IconLoader::ReadIcon() {
+  target_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(std::move(callback_), gfx::Image(), group_));
+  delete this;
+}
diff --git a/chrome/browser/platform_util_aros.cc b/chrome/browser/platform_util_aros.cc
new file mode 100644
index 0000000000..cc0bf9d9fc
--- /dev/null
+++ b/chrome/browser/platform_util_aros.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/platform_util.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/logging.h"
+#include "chrome/browser/platform_util_internal.h"
+#include "content/public/browser/browser_thread.h"
+#include "url/gurl.h"
+
+extern "C" {
+#include <defines/workbench.h>
+#include <exec/libraries.h>
+#define OPENURL_BASE_NAME openurl_base
+#include <defines/openurl.h>
+#include <proto/exec.h>
+#include <utility/tagitem.h>
+}
+
+namespace platform_util {
+namespace {
+
+bool OpenWorkbenchPath(const base::FilePath& path) {
+  struct Library* workbench_base = OpenLibrary("workbench.library", 44);
+  if (!workbench_base) {
+    LOG(ERROR) << "Unable to open workbench.library";
+    return false;
+  }
+
+  std::string native_path = path.value();
+  const bool opened = __OpenWorkbenchObjectA_WB(
+      workbench_base, native_path.data(), nullptr);
+  CloseLibrary(workbench_base);
+  return opened;
+}
+
+}  // namespace
+
+namespace internal {
+
+void PlatformOpenVerifiedItem(const base::FilePath& path, OpenItemType type) {
+  if (!OpenWorkbenchPath(path)) {
+    LOG(ERROR) << "Workbench could not open " << path.value();
+  }
+}
+
+}  // namespace internal
+
+void ShowItemInFolder(Profile* profile, const base::FilePath& full_path) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  OpenItem(profile, full_path.DirName(), OPEN_FOLDER,
+           OpenOperationCallback());
+}
+
+void OpenExternal(const GURL& url) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!internal::AreShellOperationsAllowed()) {
+    return;
+  }
+
+  struct Library* openurl_base = OpenLibrary("openurl.library", 0);
+  if (!openurl_base) {
+    LOG(ERROR) << "Unable to open openurl.library for " << url;
+    return;
+  }
+
+  std::string spec = url.spec();
+  const bool opened = URL_OpenA(spec.data(), nullptr);
+  CloseLibrary(openurl_base);
+  if (!opened) {
+    LOG(ERROR) << "openurl.library could not open " << url;
+  }
+}
+
+}  // namespace platform_util
