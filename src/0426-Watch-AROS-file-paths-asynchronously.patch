 base/files/file_path_watcher.cc      |   2 +-
 base/files/file_path_watcher_aros.cc | 183 +++++++++++++++++++++++++++
 3 files changed, 185 insertions(+), 2 deletions(-)
 create mode 100644 base/files/file_path_watcher_aros.cc

