diff --git a/mojo/core/channel_aros_probe.cc b/mojo/core/channel_aros_probe.cc
new file mode 100644
index 0000000000..a6e7e7e322
--- /dev/null
+++ b/mojo/core/channel_aros_probe.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <cstring>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/at_exit.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_executor.h"
+#include "mojo/core/channel.h"
+#include "mojo/core/connection_params.h"
+#include "mojo/public/cpp/platform/platform_channel.h"
+
+#include <aros/debug.h>
+
+namespace {
+
+constexpr char kLocalPayload[] = "remote-to-local";
+constexpr char kRemotePayload[] = "local-to-remote-with-handle";
+
+struct ProbeState {
+  int messages = 0;
+  bool failed = false;
+  base::RunLoop* run_loop = nullptr;
+
+  void CompleteOne() {
+    if (++messages == 2)
+      run_loop->Quit();
+  }
+
+  void Fail() {
+    failed = true;
+    run_loop->Quit();
+  }
+};
+
+class ProbeDelegate final : public mojo::core::Channel::Delegate {
+ public:
+  ProbeDelegate(ProbeState* state,
+                std::string_view expected,
+                bool expect_handle)
+      : state_(state),
+        expected_(expected),
+        expect_handle_(expect_handle) {}
+
+  void OnChannelMessage(
+      const void* payload,
+      size_t payload_size,
+      std::vector<mojo::PlatformHandle> handles) override {
+    const bool payload_ok =
+        payload_size == expected_.size() + 1 &&
+        std::memcmp(payload, expected_.data(), expected_.size()) == 0 &&
+        static_cast<const char*>(payload)[expected_.size()] == '\0';
+    const bool handles_ok =
+        expect_handle_
+            ? handles.size() == 1 && handles[0].is_aros_channel()
+            : handles.empty();
+    if (!payload_ok || !handles_ok) {
+      state_->Fail();
+      return;
+    }
+    state_->CompleteOne();
+  }
+
+  void OnChannelError(mojo::core::Channel::Error error) override {
+    state_->Fail();
+  }
+
+ private:
+  ProbeState* const state_;
+  const std::string_view expected_;
+  const bool expect_handle_;
+};
+
+mojo::core::Channel::MessagePtr MakeMessage(std::string_view payload) {
+  auto message = mojo::core::Channel::Message::CreateMessage(
+      payload.size() + 1, 1,
+      mojo::core::Channel::Message::MessageType::NORMAL);
+  std::memcpy(message->mutable_payload(), payload.data(), payload.size());
+  static_cast<char*>(message->mutable_payload())[payload.size()] = '\0';
+  return message;
+}
+
+}  // namespace
+
+int main() {
+  base::AtExitManager at_exit_manager;
+  base::SingleThreadTaskExecutor task_executor(base::MessagePumpType::IO);
+
+  mojo::PlatformChannel transport;
+  if (!transport.local_endpoint().is_valid() ||
+      !transport.remote_endpoint().is_valid()) {
+    bug("[Mojo:AROS:CoreChannelProbe] FAIL endpoint creation\n");
+    return 30;
+  }
+
+  base::RunLoop run_loop;
+  ProbeState state{.run_loop = &run_loop};
+  ProbeDelegate local_delegate(&state, kRemotePayload, true);
+  ProbeDelegate remote_delegate(&state, kLocalPayload, false);
+  auto io_runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+
+  scoped_refptr<mojo::core::Channel> local = mojo::core::Channel::Create(
+      &local_delegate,
+      mojo::core::ConnectionParams(transport.TakeLocalEndpoint()),
+      mojo::core::Channel::HandlePolicy::kAcceptHandles, io_runner);
+  scoped_refptr<mojo::core::Channel> remote = mojo::core::Channel::Create(
+      &remote_delegate,
+      mojo::core::ConnectionParams(transport.TakeRemoteEndpoint()),
+      mojo::core::Channel::HandlePolicy::kAcceptHandles, io_runner);
+  local->Start();
+  remote->Start();
+
+  mojo::PlatformChannel transferred_channel;
+  std::vector<mojo::PlatformHandle> handles;
+  handles.push_back(
+      transferred_channel.TakeLocalEndpoint().TakePlatformHandle());
+  auto to_local = MakeMessage(kRemotePayload);
+  to_local->SetHandles(std::move(handles));
+  remote->Write(std::move(to_local));
+  local->Write(MakeMessage(kLocalPayload));
+
+  run_loop.Run();
+  local->ShutDown();
+  remote->ShutDown();
+  base::RunLoop().RunUntilIdle();
+  local = nullptr;
+  remote = nullptr;
+
+  if (state.failed || state.messages != 2) {
+    bug("[Mojo:AROS:CoreChannelProbe] FAIL messages=%ld error=%ld\n",
+        static_cast<long>(state.messages), static_cast<long>(state.failed));
+    return 31;
+  }
+  bug("[Mojo:AROS:CoreChannelProbe] PASS framed=2 duplex=1 handles=1 "
+      "shutdown=1\n");
+  return 0;
+}
