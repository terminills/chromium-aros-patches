 void Scheduler::SetNeedsBeginMainFrame() {
+#if BUILDFLAG(IS_AROS)
+  const bool trace_request =
+      aros_begin_main_frame_request_probe_count_++ < 32;
+  if (trace_request) {
+    LOG(ERROR) << "[AROS_SCHED] scheduler-needs-begin-before scheduler="
+               << this << " host_id=" << layer_tree_host_id_
+               << " blockers=0x" << std::hex
+               << state_machine_.ArosBeginMainFrameBlockersForDiagnostics()
+               << std::dec
+               << " next_action="
+               << static_cast<int>(state_machine_.NextAction())
+               << " begin_frame_needed=" << state_machine_.BeginFrameNeeded();
+  }
+#endif
   state_machine_.SetNeedsBeginMainFrame();
+#if BUILDFLAG(IS_AROS)
+  if (trace_request) {
+    LOG(ERROR) << "[AROS_SCHED] scheduler-needs-begin-after scheduler="
+               << this << " host_id=" << layer_tree_host_id_
+               << " blockers=0x" << std::hex
+               << state_machine_.ArosBeginMainFrameBlockersForDiagnostics()
+               << std::dec
+               << " next_action="
+               << static_cast<int>(state_machine_.NextAction())
+               << " begin_frame_needed=" << state_machine_.BeginFrameNeeded();
+  }
+#endif
   ProcessScheduledActions();
+#if BUILDFLAG(IS_AROS)
+  if (trace_request) {
+    LOG(ERROR) << "[AROS_SCHED] scheduler-needs-begin-return scheduler="
+               << this << " host_id=" << layer_tree_host_id_
+               << " blockers=0x" << std::hex
+               << state_machine_.ArosBeginMainFrameBlockersForDiagnostics()
+               << std::dec
+               << " next_action="
+               << static_cast<int>(state_machine_.NextAction())
+               << " begin_frame_needed=" << state_machine_.BeginFrameNeeded();
+  }
+#endif
 }
 
