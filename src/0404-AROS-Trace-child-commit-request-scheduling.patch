diff --git a/cc/trees/proxy_main.cc b/cc/trees/proxy_main.cc
index 7f195b626b..ac7ac7937a 100644
--- a/cc/trees/proxy_main.cc
+++ b/cc/trees/proxy_main.cc
@@ -873,15 +873,34 @@ bool ProxyMain::SendCommitRequestToImplThreadIfNeeded(
     CommitPipelineStage required_stage) {
   DCHECK(IsMainThread());
   DCHECK_NE(NO_PIPELINE_STAGE, required_stage);
+  const CommitPipelineStage previous_stage = max_requested_pipeline_stage_;
   bool already_posted = max_requested_pipeline_stage_ != NO_PIPELINE_STAGE;
   max_requested_pipeline_stage_ =
       std::max(max_requested_pipeline_stage_, required_stage);
+#if BUILDFLAG(IS_AROS)
+  const bool trace_request = aros_commit_request_probe_count_++ < 32;
+  if (trace_request) {
+    LOG(ERROR) << "[AROS_SCHED] main-commit-request proxy_main=" << this
+               << " host_id=" << layer_tree_host_id_
+               << " required_stage=" << required_stage
+               << " previous_stage=" << previous_stage
+               << " effective_stage=" << max_requested_pipeline_stage_
+               << " already_posted=" << already_posted;
+  }
+#endif
   if (already_posted)
     return false;
   ImplThreadTaskRunner()->PostTask(
       FROM_HERE, base::BindOnce(&ProxyImpl::SetNeedsCommitOnImpl,
                                 base::Unretained(proxy_impl_.get())));
   layer_tree_host_->OnCommitRequested();
+#if BUILDFLAG(IS_AROS)
+  if (trace_request) {
+    LOG(ERROR) << "[AROS_SCHED] main-commit-posted proxy_main=" << this
+               << " host_id=" << layer_tree_host_id_
+               << " effective_stage=" << max_requested_pipeline_stage_;
+  }
+#endif
   return true;
 }
 
