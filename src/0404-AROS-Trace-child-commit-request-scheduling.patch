diff --git a/cc/scheduler/scheduler_state_machine.cc b/cc/scheduler/scheduler_state_machine.cc
index 67abc45f11..2164df7915 100644
--- a/cc/scheduler/scheduler_state_machine.cc
+++ b/cc/scheduler/scheduler_state_machine.cc
@@ -622,6 +622,61 @@ bool SchedulerStateMachine::ShouldSendBeginMainFrame() const {
   return true;
 }
 
+#if BUILDFLAG(IS_AROS)
+uint32_t SchedulerStateMachine::ArosBeginMainFrameBlockersForDiagnostics()
+    const {
+  uint32_t blockers = 0;
+  if (!needs_begin_main_frame_)
+    blockers |= 1u << 0;
+  if (!visible_)
+    blockers |= 1u << 1;
+  if (begin_frame_source_paused_)
+    blockers |= 1u << 2;
+  if (defer_begin_main_frame_)
+    blockers |= 1u << 3;
+  if (pause_rendering_)
+    blockers |= 1u << 4;
+  if (did_send_begin_main_frame_for_current_frame_)
+    blockers |= 1u << 5;
+  if (begin_main_frame_state_ == BeginMainFrameState::SENT)
+    blockers |= 1u << 6;
+  if (begin_main_frame_state_ == BeginMainFrameState::READY_TO_COMMIT &&
+      (!settings_.main_frame_before_commit_enabled ||
+       next_begin_main_frame_state_ != BeginMainFrameState::IDLE)) {
+    blockers |= 1u << 7;
+  }
+
+  const bool can_send_main_frame_with_pending_tree =
+      settings_.main_frame_before_activation_enabled ||
+      current_pending_tree_is_impl_side_;
+  if (has_pending_tree_ && !can_send_main_frame_with_pending_tree)
+    blockers |= 1u << 8;
+  if (settings_.commit_to_active_tree && active_tree_needs_first_draw_)
+    blockers |= 1u << 9;
+  if (settings_.commit_to_active_tree && IsDrawThrottled())
+    blockers |= 1u << 10;
+  if (ImplLatencyTakesPriority() && has_pending_tree_)
+    blockers |= 1u << 11;
+  if (ImplLatencyTakesPriority() && active_tree_needs_first_draw_)
+    blockers |= 1u << 12;
+  if (!settings_.using_synchronous_renderer_compositor &&
+      begin_impl_frame_state_ == BeginImplFrameState::IDLE) {
+    blockers |= 1u << 13;
+  }
+
+  const bool forced_commit =
+      forced_redraw_state_ == ForcedRedrawOnTimeoutState::WAITING_FOR_COMMIT;
+  if (!forced_commit && !HasInitializedLayerTreeFrameSink())
+    blockers |= 1u << 14;
+  const bool just_submitted_in_deadline =
+      begin_impl_frame_state_ == BeginImplFrameState::INSIDE_DEADLINE &&
+      did_submit_in_last_frame_;
+  if (!forced_commit && IsDrawThrottled() && !just_submitted_in_deadline)
+    blockers |= 1u << 15;
+  return blockers;
+}
+#endif
+
 bool SchedulerStateMachine::ShouldCommit() const {
   if (begin_main_frame_state_ != BeginMainFrameState::READY_TO_COMMIT)
     return false;
