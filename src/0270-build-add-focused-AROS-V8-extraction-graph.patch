From 268f0cf7e18236befbc3fbf122533f5514be1ca5 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Thu, 23 Jul 2026 17:01:22 -0500
Subject: [PATCH 270/638] build: add focused AROS V8 extraction graph

Allow an opt-in AROS build to generate Chromium's pinned v8_monolith without traversing unrelated browser test aggregates. Normal Chromium builds remain unchanged.\n\nAI_PHASE: v8-library-convergence\nAI_STATUS: implemented\nAI_ROOT_CAUSE: The normal gn_all graph pulls unrelated ANGLE and media test targets that are incomplete in the AROS port, preventing a reproducible native-library extraction build.\nAI_FIX: Add aros_v8_library_only and restrict gn_all to //v8:v8_monolith when explicitly enabled for AROS.\nAI_VALIDATION: gn gen out/aros-v8-library succeeded; ninja -C out/aros-v8-library v8_monolith completed 5186 actions and produced a 2215-member AROS x86-64 archive.\nAI_RISK: Opt-in only; false by default, so existing Chromium graphs are unchanged.\nAI_CHAIN:
---
 BUILD.gn | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/BUILD.gn b/BUILD.gn
index 4b37258f1b..d600833277 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -62,6 +62,11 @@ declare_args() {
   # checkout to add additional targets without explicitly changing any checked-
   # in files.
   root_extra_deps = []
+
+  # Generate only the Chromium-pinned V8 monolith needed to extract
+  # v8.library. This keeps the native library build independent of unrelated
+  # browser test aggregates while using Chromium's exact V8 source and args.
+  aros_v8_library_only = false
 }
 
 if (is_official_build) {
@@ -83,7 +88,10 @@ if (is_official_build) {
 group("gn_all") {
   testonly = true
 
-  if (is_cronet_build) {
+  if (is_aros && aros_v8_library_only) {
+    assert(v8_monolithic)
+    deps = [ "//v8:v8_monolith" ]
+  } else if (is_cronet_build) {
     if (is_android) {
       deps = [ "//components/cronet/android:cronet_package_android" ]
     } else {
