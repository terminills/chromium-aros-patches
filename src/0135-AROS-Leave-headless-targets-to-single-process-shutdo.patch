From e5411e355b39561aaf24595b549957d93d000030 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 13 Jul 2026 01:28:59 -0500
Subject: [PATCH 135/638] [AROS] Leave headless targets to single-process
 shutdown

---
 components/headless/command_handler/headless_command.js   | 4 +++-
 .../headless/command_handler/headless_command_handler.cc  | 8 ++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/components/headless/command_handler/headless_command.js b/components/headless/command_handler/headless_command.js
index ebe80039e7..6e5cedd01b 100644
--- a/components/headless/command_handler/headless_command.js
+++ b/components/headless/command_handler/headless_command.js
@@ -347,7 +347,9 @@ async function executeCommands(commands) {
     result.pageLoadTimedOut = true;
   }
 
-  await targetPage.close();
+  if (!commands.skipTargetClose) {
+    await targetPage.close();
+  }
 
   return result;
 }
diff --git a/components/headless/command_handler/headless_command_handler.cc b/components/headless/command_handler/headless_command_handler.cc
index 4fd7e97672..4b82c1e9bd 100644
--- a/components/headless/command_handler/headless_command_handler.cc
+++ b/components/headless/command_handler/headless_command_handler.cc
@@ -378,6 +378,14 @@ void HeadlessCommandHandler::DocumentOnLoadCompletedInPrimaryMainFrame() {
   }
 
   commands.Set("targetUrl", target_url_.spec());
+#if BUILDFLAG(IS_AROS)
+  // Closing a child target tears down renderer state shared with the command
+  // harness in single-process mode. Browser shutdown already owns that target.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          ::switches::kSingleProcess)) {
+    commands.Set("skipTargetClose", true);
+  }
+#endif
 
   // Expose DevTools protocol to the target.
   base::Value::Dict expose_params;
