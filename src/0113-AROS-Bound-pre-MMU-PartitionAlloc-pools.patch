From c1a43d15b02cfe095429a9bec54e31dfbbe426e1 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sun, 12 Jul 2026 13:33:36 -0500
Subject: [PATCH 113/638] [AROS] Bound pre-MMU PartitionAlloc pools

AI_PHASE: chromium-phase-3
AI_STATUS: implementation
ROOT_CAUSE: 64-bit PartitionAlloc reserves two 16 GiB core pools, but the current AROS KrnAllocPages backend consumes physically backed Exec memory instead of creating sparse virtual reservations, so the first Blink renderer trapped in HandlePoolAllocFailure.
FIX_REASON: Cap AROS core and configurable pools at 512 MiB while the port uses the pre-MMU backend, preserving power-of-two pool geometry and leaving enough physical memory for hosted bring-up.
SCOPE: base/allocator/partition_allocator/src/partition_alloc/partition_alloc_constants.h; base/allocator/partition_allocator/src/partition_alloc/partition_address_space.h
VALIDATION: partition_address_space.o cross-compiled for AROS; hosted run 0113 cleared entropy and captured PartitionAddressSpace::Init -> HandlePoolAllocFailure with the prior 16 GiB geometry.
RISK: This is a bounded bring-up substrate, not production virtual-memory semantics; pool capacity, sparse commit/decommit, and W^X still require OPAL/MMU-backed address reservations.
AI_DECISION_CHAIN: entropy fixed -> first Blink renderer -> 16 GiB physical pool reservation failure -> bounded pre-MMU AROS geometry
Continues: 8647f1976d
---
 .../src/partition_alloc/partition_address_space.h          | 4 ++++
 .../src/partition_alloc/partition_alloc_constants.h        | 7 ++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/base/allocator/partition_allocator/src/partition_alloc/partition_address_space.h b/base/allocator/partition_allocator/src/partition_alloc/partition_address_space.h
index 0b115ee775..39644800b7 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/partition_address_space.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_address_space.h
@@ -277,7 +277,11 @@ class PA_COMPONENT_EXPORT(PARTITION_ALLOC) PartitionAddressSpace {
   static_assert(std::has_single_bit(kThreadIsolatedPoolSize));
 #endif
   static constexpr size_t kConfigurablePoolMaxSize = kPoolMaxSize;
+#if BUILDFLAG(IS_AROS)
+  static constexpr size_t kConfigurablePoolMinSize = kPoolMaxSize;
+#else
   static constexpr size_t kConfigurablePoolMinSize = 1 * kGiB;
+#endif
   static_assert(kConfigurablePoolMinSize <= kConfigurablePoolMaxSize);
   static_assert(std::has_single_bit(kConfigurablePoolMaxSize));
   static_assert(std::has_single_bit(kConfigurablePoolMinSize));
diff --git a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_constants.h b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_constants.h
index 3322c09fc5..4669e605e9 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_constants.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_constants.h
@@ -312,7 +312,12 @@ constexpr size_t kNumPools = kMaxPoolHandle - 1;
 // When pointer compression is enabled, we cannot use large pools (at most
 // 8GB for each of the glued pools).
 #if BUILDFLAG(HAS_64_BIT_POINTERS)
-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS) || \
+#if BUILDFLAG(IS_AROS)
+// KrnAllocPages() currently provides physically backed pages rather than a
+// sparse virtual reservation. Keep the pre-MMU pools bounded until AROS can
+// reserve and commit address space independently.
+constexpr size_t kPoolMaxSize = kGiB / 2;
+#elif BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_IOS) || \
     BUILDFLAG(ENABLE_POINTER_COMPRESSION)
 constexpr size_t kPoolMaxSize = 8 * kGiB;
 #else
