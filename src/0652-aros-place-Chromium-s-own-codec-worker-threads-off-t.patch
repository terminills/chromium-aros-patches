 base/threading/aros_codec_thread_placement.h  | 38 +++++++++++++++++++
 base/threading/platform_thread_aros.cc        | 15 ++++++++
 .../platform_thread_internal_posix.h          |  6 ++-
 base/threading/platform_thread_posix.cc       |  2 +
 media/base/codec_worker_impl.h                |  8 ++++
 6 files changed, 69 insertions(+), 1 deletion(-)
 create mode 100644 base/threading/aros_codec_thread_placement.h

diff --git a/base/BUILD.gn b/base/BUILD.gn
index c65396828a..1950dc516f 100644
--- a/base/BUILD.gn
+++ b/base/BUILD.gn
@@ -1022,6 +1022,7 @@ component("base") {
         "process/process_iterator_aros.cc",
         "process/process_metrics_aros.cc",
         "system/sys_info_aros.cc",
+        "threading/aros_codec_thread_placement.h",
