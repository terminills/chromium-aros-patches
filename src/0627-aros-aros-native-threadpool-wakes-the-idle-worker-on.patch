+#include <atomic>
+
 #include "base/base_export.h"
 #include "base/compiler_specific.h"
 #include "base/memory/raw_ptr.h"
@@ -191,6 +193,18 @@ class BASE_EXPORT WorkerThread : public RefCountedThreadSafe<WorkerThread>,
 
   size_t sequence_num() const { return sequence_num_; }
 
+#if BUILDFLAG(IS_AROS)
+  // The CPU this worker is running on, or -1 before its thread has entered
+  // ThreadMain() (or if it could not be determined). Sampled once by the worker
+  // thread itself and never changed afterwards, because AROS does not migrate
+  // tasks - so this is a stable property, not a snapshot that goes stale.
+  //
+  // Thread-safe and deliberately relaxed: the thread group reads it to decide
+  // which worker to wake, where a momentarily stale -1 costs at most one
+  // suboptimal placement and never correctness.
+  int aros_cpu() const { return aros_cpu_.load(std::memory_order_relaxed); }
+#endif
+
  protected:
   friend class RefCountedThreadSafe<WorkerThread>;
   class Thread;
@@ -252,6 +266,11 @@ class BASE_EXPORT WorkerThread : public RefCountedThreadSafe<WorkerThread>,
   // Whether the thread should exit. Set by Cleanup().
   AtomicFlag should_exit_;
 
+#if BUILDFLAG(IS_AROS)
+  // See aros_cpu(). Written once by this worker's own thread in ThreadMain().
+  std::atomic<int> aros_cpu_{-1};
+#endif
+
   const TrackedRef<TaskTracker> task_tracker_;
 
   // Optional observer notified when a worker enters and exits its main
