@@ -270,6 +276,23 @@ void WorkerThread::UpdateThreadType(ThreadType desired_thread_type) {
 }
 
 void WorkerThread::ThreadMain() {
+#if BUILDFLAG(IS_AROS)
+  // Record which core this worker actually landed on.
+  //
+  // AROS does not migrate tasks: a task is placed once and stays there
+  // (rom/exec/exec_util.c Exec_InitETask), and when exec does pick a core for a
+  // task that is not running it takes the FIRST bit set in the affinity mask,
+  // never the least-loaded one - rom/exec/signal.c:190-199, whose own comment
+  // reads "Use CPU balancing some day...". So the core a worker runs on is
+  // fixed for its lifetime and nothing will rebalance it.
+  //
+  // That makes "which core is this worker on" a real, stable property that the
+  // thread group can schedule against, and it has to be sampled HERE because
+  // KrnGetCPUNumber() only answers for the thread that calls it. Asking where
+  // the thread ended up is also more honest than assuming where we asked it to
+  // go: if pinning was off, or the mask was ignored, this reports the truth.
+  aros_cpu_.store(ArosCurrentCpu(), std::memory_order_relaxed);
+#endif
 #if (BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_NACL)) || BUILDFLAG(IS_FUCHSIA)
   DCHECK(io_thread_task_runner_);
   FileDescriptorWatcher file_descriptor_watcher(io_thread_task_runner_);
