+#if BUILDFLAG(IS_AROS)
+WorkerThreadWaitableEvent*
+ThreadGroupImpl::TakeIdleWorkerOnLeastLoadedCoreLockRequired() {
+  // Which idle worker we wake IS the placement decision on AROS, because a
+  // task runs on whichever worker picks it up and a worker never leaves its
+  // core. Chromium's default - take whichever worker is at the front of the
+  // idle set - is the right answer on an OS that rebalances. AROS does not:
+  // rom/exec/signal.c:190-199 picks the first set bit of the affinity mask,
+  // never the least-loaded core, and its own comment says "Use CPU balancing
+  // some day...". So waking an arbitrary idle worker piles work onto whatever
+  // core that worker happens to sit on while other cores stay idle, and the
+  // cost lands on the frame-time TAIL rather than on throughput.
+  //
+  // Load is counted as awake (non-idle) workers per core. That is a coarse
+  // proxy - it does not know how long each task will run - but it is the
+  // measure available under `lock_` without adding accounting to every task,
+  // and it is exactly the quantity that produces head-of-line blocking.
+  //
+  // WorkerThreadSet exposes no iteration, only Take/Peek/Insert/Remove, so the
+  // idle set is drained into a small vector, scored, and the losers put back.
+  // The set holds at most max_tasks_ workers (single digits here), so this is
+  // cheap; it is O(k log k) on a set that is normally near-empty, and it runs
+  // only when a task source is enqueued.
+  std::vector<WorkerThreadWaitableEvent*> idle;
+  while (WorkerThreadWaitableEvent* w = idle_workers_set_.Take()) {
+    idle.push_back(w);
+  }
+  if (idle.empty()) {
+    return nullptr;
+  }
+
+  // Awake workers per core. Anything whose core is not yet known (-1, i.e. its
+  // thread has not reached ThreadMain()) is simply not counted.
+  std::map<int, size_t> load;
+  for (const auto& worker : workers_) {
+    const int cpu = worker->aros_cpu();
+    if (cpu < 0) {
+      continue;
+    }
+    load.try_emplace(cpu, 0u);
+    // Every worker in a ThreadGroupImpl is a WorkerThreadWaitableEvent; the
+    // WorkerThread* overload of IsOnIdleSetLockRequired is declared but never
+    // defined, so calling it links to nothing. The rest of this file casts the
+    // same way.
+    if (!IsOnIdleSetLockRequired(
+            static_cast<WorkerThreadWaitableEvent*>(worker.get()))) {
+      ++load[cpu];
+    }
+  }
+
+  // Pure least-loaded, with NO locality bias.
+  //
+  // The reasoning for a locality tiebreak is sound on its face: waking a worker
+  // on another core goes through exec's cross-core IPI path
+  // (rom/exec/signal.c:168-205 - a Hook, a CallIPI claim, an interrupt on the
+  // target core), which costs more than waking one on the current core, so
+  // preferring the local core unless another is meaningfully lighter ought to
+  // cut the tail. It is left out because it is UNMEASURED, not because it was
+  // measured worse: every jank-probe run before 2026-09-20 had all workers on
+  // CPU 0 (the affinity attribute never reached exec - see kArosPinWorkers in
+  // base/base_switches.cc), so aros_cpu() was 0 for every worker, this
+  // function degenerated to "first idle worker", and the numbers that once sat
+  // in this comment compared one policy against itself. Adding a tiebreak
+  // needs repeated pinned runs that actually differ in placement.
+  size_t best = 0;
+  size_t best_load = std::numeric_limits<size_t>::max();
+  for (size_t i = 0; i < idle.size(); ++i) {
+    const int cpu = idle[i]->aros_cpu();
+    // An unknown core sorts last: prefer a worker we can actually reason about.
+    const size_t l = (cpu < 0) ? std::numeric_limits<size_t>::max() - 1
+                               : load[cpu];
+    if (l < best_load) {
+      best_load = l;
+      best = i;
+    }
+  }
+
+  WorkerThreadWaitableEvent* chosen = idle[best];
+  for (size_t i = 0; i < idle.size(); ++i) {
+    if (i != best) {
+      idle_workers_set_.Insert(idle[i]);
+    }
+  }
+  return chosen;
+}
+#endif  // BUILDFLAG(IS_AROS)
+
 void ThreadGroupImpl::EnsureEnoughWorkersLockRequired(
     BaseScopedCommandsExecutor* base_executor) {
   // Don't do anything if the thread group isn't started.
@@ -514,7 +606,15 @@ void ThreadGroupImpl::EnsureEnoughWorkersLockRequired(
   // Wake up the appropriate number of workers.
   for (size_t i = 0; i < num_workers_to_wake_up; ++i) {
     MaintainAtLeastOneIdleWorkerLockRequired(executor);
-    WorkerThreadWaitableEvent* worker_to_wakeup = idle_workers_set_.Take();
+    WorkerThreadWaitableEvent* worker_to_wakeup = nullptr;
+#if BUILDFLAG(IS_AROS)
+    if (internal::ArosNativeThreadPoolEnabled()) {
+      worker_to_wakeup = TakeIdleWorkerOnLeastLoadedCoreLockRequired();
+    }
+#endif
+    if (!worker_to_wakeup) {
+      worker_to_wakeup = idle_workers_set_.Take();
+    }
     DCHECK(worker_to_wakeup);
     executor->ScheduleWakeUp(worker_to_wakeup);
   }
