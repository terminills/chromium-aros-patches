index 0000000000..24b914c229
--- /dev/null
+++ b/media/audio/aros/ahi_input_stream.cc
@@ -0,0 +1,285 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "media/audio/aros/ahi_input_stream.h"
+#include <cstdint>
+#include <memory>
+#include <vector>
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "base/threading/platform_thread.h"
+#include "base/time/time.h"
+#include "media/audio/aros/ahi_capture_buffer.h"
+#include "media/audio/audio_device_description.h"
+#include "media/audio/audio_manager_base.h"
+#include "media/base/audio_bus.h"
+#include "media/base/audio_glitch_info.h"
+
+// AHIBase is owned by each session, not a shared global. Exec macros last.
+#include <aros/asmcall.h>
+#include <devices/ahi.h>
+#include <proto/exec.h>
+#define __NOLIBBASE__
+#include <proto/ahi.h>
+#undef __NOLIBBASE__
+#include <utility/hooks.h>
+
+namespace media {
+namespace {
+struct CaptureState {
+  AhiCaptureBuffer<32768> buffer;
+  bool bad_format = false;
+};
+#if defined(__x86_64__)
+#pragma GCC push_options
+#pragma GCC target("general-regs-only")
+#endif
+AROS_UFH3(void,
+          RecordHook,
+          AROS_UFHA(struct Hook*, hook, A0),
+          AROS_UFHA(struct AHIAudioCtrl*, control, A2),
+          AROS_UFHA(struct AHIRecordMessage*, message, A1)) {
+  AROS_USERFUNC_INIT
+  auto* state = static_cast<CaptureState*>(hook->h_Data);
+  if (!message || !message->ahirm_Buffer) {
+    __atomic_store_n(&state->bad_format, true, __ATOMIC_RELAXED);
+  } else {
+    const int channels =
+        (message->ahirm_Type == AHIST_S8S ||
+         message->ahirm_Type == AHIST_S16S || message->ahirm_Type == AHIST_S32S)
+            ? 2
+            : 1;
+    switch (message->ahirm_Type) {
+      case AHIST_M8S:
+      case AHIST_S8S:
+        state->buffer.Write(static_cast<const int8_t*>(message->ahirm_Buffer),
+                            message->ahirm_Length, channels);
+        break;
+      case AHIST_M16S:
+      case AHIST_S16S:
+        state->buffer.Write(static_cast<const int16_t*>(message->ahirm_Buffer),
+                            message->ahirm_Length, channels);
+        break;
+      case AHIST_M32S:
+      case AHIST_S32S:
+        state->buffer.Write(static_cast<const int32_t*>(message->ahirm_Buffer),
+                            message->ahirm_Length, channels);
+        break;
+      default:
+        __atomic_store_n(&state->bad_format, true, __ATOMIC_RELAXED);
+    }
+  }
+  AROS_USERFUNC_EXIT
+}
+
+#if defined(__x86_64__)
+#pragma GCC pop_options
+#endif
+
+struct Mode {
+  ULONG id;
+  std::string name;
+};
+class AhiSession {
+ public:
+  ~AhiSession() {
+    if (control_) {
+      AHI_ControlAudio(control_, AHIC_Record, FALSE, TAG_DONE);
+      AHI_FreeAudio(control_);
+    }
+    if (AHIBase) {
+      CloseDevice(reinterpret_cast<struct IORequest*>(io_));
+    }
+    if (io_) {
+      DeleteIORequest(reinterpret_cast<struct IORequest*>(io_));
+    }
+    if (port_) {
+      DeleteMsgPort(port_);
+    }
+  }
+  bool Open() {
+    port_ = CreateMsgPort();
+    if (!port_) {
+      return false;
+    }
+    io_ = reinterpret_cast<struct AHIRequest*>(
+        CreateIORequest(port_, sizeof(*io_)));
+    if (!io_) {
+      return false;
+    }
+    io_->ahir_Version = 4;
+    if (OpenDevice(AHINAME, AHI_NO_UNIT,
+                   reinterpret_cast<struct IORequest*>(io_), 0)) {
+      return false;
+    }
+    AHIBase = reinterpret_cast<struct Library*>(io_->ahir_Std.io_Device);
+    return true;
+  }
+  std::vector<Mode> Modes() {
+    std::vector<Mode> modes;
+    ULONG id = AHI_INVALID_ID;
+    while ((id = AHI_NextAudioID(id)) != AHI_INVALID_ID) {
+      char name[128] = {};
+      ULONG record = 0;
+      AHI_GetAudioAttrs(id, nullptr, AHIDB_BufferLen, sizeof(name), AHIDB_Name,
+                        reinterpret_cast<IPTR>(name), AHIDB_Record,
+                        reinterpret_cast<IPTR>(&record), TAG_DONE);
+      if (record) {
+        modes.push_back({id, name});
+      }
+    }
+    return modes;
+  }
+  bool Start(ULONG id, ULONG frequency, struct Hook* hook) {
+    control_ = AHI_AllocAudio(AHIA_AudioID, id, AHIA_MixFreq, frequency,
+                              AHIA_Channels, 1, AHIA_Sounds, 1, AHIA_RecordFunc,
+                              reinterpret_cast<IPTR>(hook), TAG_DONE);
+    if (!control_) {
+      return false;
+    }
+    ULONG actual_frequency = 0;
+    AHI_ControlAudio(control_, AHIC_MixFreq_Query,
+                     reinterpret_cast<IPTR>(&actual_frequency), TAG_DONE);
+    // Never mislabel samples with a different rate. Negotiation/resampling
+    // belongs above this stream; fail rather than changing pitch or A/V timing.
+    if (actual_frequency != frequency) {
+      return false;
+    }
+    return AHI_ControlAudio(control_, AHIC_Record, TRUE, TAG_DONE) == 0;
+  }
+
+ private:
+  struct MsgPort* port_ = nullptr;
+  struct AHIRequest* io_ = nullptr;
+  struct Library* AHIBase = nullptr;
+  struct AHIAudioCtrl* control_ = nullptr;
+};
+}  // namespace
+
+AhiInputStream::AhiInputStream(const AudioParameters& params,
+                               const std::string& device_id,
+                               AudioManagerBase* manager)
+    : params_(params), device_id_(device_id), manager_(manager) {}
+AhiInputStream::~AhiInputStream() {
+  Stop();
+}
+void AhiInputStream::GetDeviceNames(AudioDeviceNames* names) {
+  AhiSession session;
+  if (!session.Open()) {
+    return;
+  }
+  const auto modes = session.Modes();
+  if (!modes.empty()) {
+    names->push_back(AudioDeviceName::CreateDefault());
+  }
+  for (const auto& mode : modes) {
+    names->emplace_back(mode.name, base::StringPrintf("ahi:%08x", mode.id));
+  }
+}
+AudioInputStream::OpenOutcome AhiInputStream::Open() {
+  if (opened_) {
+    return OpenOutcome::kAlreadyOpen;
+  }
+  if (!params_.IsValid() || params_.channels() < 1 || params_.channels() > 2 ||
+      params_.frames_per_buffer() > 32768) {
+    return OpenOutcome::kFailed;
+  }
+  AhiSession session;
+  if (!session.Open()) {
+    return OpenOutcome::kFailed;
+  }
+  const auto modes = session.Modes();
+  if (modes.empty()) {
+    return OpenOutcome::kFailed;
+  }
+  if (device_id_.empty() ||
+      device_id_ == AudioDeviceDescription::kDefaultDeviceId) {
+    mode_id_ = modes.front().id;
+  } else if (device_id_.compare(0, 4, "ahi:") != 0 ||
+             !base::HexStringToUInt(device_id_.substr(4), &mode_id_)) {
+    return OpenOutcome::kFailed;
+  }
+  for (const auto& mode : modes) {
+    if (mode.id == mode_id_) {
+      opened_ = true;
+      return OpenOutcome::kSuccess;
+    }
+  }
+  return OpenOutcome::kFailed;
+}
+void AhiInputStream::Start(AudioInputCallback* callback) {
+  DCHECK(opened_);
+  DCHECK(!thread_);
+  callback_ = callback;
+  stopped_.store(false, std::memory_order_relaxed);
+  thread_ = std::make_unique<base::DelegateSimpleThread>(this, "AHI capture");
+  thread_->Start();
+}
+void AhiInputStream::Stop() {
+  stopped_.store(true, std::memory_order_relaxed);
+  if (thread_) {
+    thread_->Join();
+    thread_.reset();
+  }
+  callback_ = nullptr;
+}
+void AhiInputStream::Close() {
+  Stop();
+  manager_->ReleaseInputStream(this);
+}
+void AhiInputStream::Run() {
+  // Destruction order matters: unregister/quiesce the hook before its state.
+  auto state = std::make_unique<CaptureState>();
+  struct Hook hook = {};
+  hook.h_Entry = reinterpret_cast<decltype(hook.h_Entry)>(RecordHook);
+  hook.h_Data = state.get();
+  AhiSession session;
+  auto bus = AudioBus::Create(params_);
+  if (!session.Open() ||
+      !session.Start(mode_id_, params_.sample_rate(), &hook)) {
+    if (!stopped_.load(std::memory_order_relaxed)) {
+      callback_->OnError();
+    }
+    return;
+  }
+  auto last_data = base::TimeTicks::Now();
+  base::TimeTicks last_timestamp;
+  const auto buffer_duration = base::Seconds(
+      double(params_.frames_per_buffer()) / params_.sample_rate());
+  while (!stopped_.load(std::memory_order_relaxed)) {
+    const auto available = state->buffer.Available();
+    const auto now = base::TimeTicks::Now();
+    if (__atomic_load_n(&state->bad_format, __ATOMIC_RELAXED) ||
+        now - last_data > base::Seconds(3)) {
+      if (!stopped_.load(std::memory_order_relaxed)) {
+        callback_->OnError();
+      }
+      return;
+    }
+    if (state->buffer.Read(bus->channel(0),
+                           params_.channels() == 2 ? bus->channel(1) : nullptr,
+                           params_.frames_per_buffer())) {
+      auto timestamp =
+          now - base::Seconds(double(available) / params_.sample_rate());
+      if (!last_timestamp.is_null() &&
+          timestamp < last_timestamp + buffer_duration) {
+        timestamp = last_timestamp + buffer_duration;
+      }
+      last_timestamp = timestamp;
+      last_data = now;
+      AudioGlitchInfo glitch;
+      const auto dropped = state->buffer.TakeDroppedFrames();
+      if (dropped) {
+        glitch.count = 1;
+        glitch.duration =
+            base::Seconds(double(dropped) / params_.sample_rate());
+      }
+      if (!stopped_.load(std::memory_order_relaxed)) {
+        callback_->OnData(bus.get(), timestamp, 1.0, glitch);
+      }
+    } else {
+      base::PlatformThread::Sleep(base::Milliseconds(2));
+    }
+  }
+}
+}  // namespace media
