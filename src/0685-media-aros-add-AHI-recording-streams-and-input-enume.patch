+// Standalone host regression test: c++ -std=c++20 -pthread -I<source-root>
+// ahi_capture_buffer_test.cc -o ahi_capture_buffer_test
+#include "media/audio/aros/ahi_capture_buffer.h"
+#include <cassert>
+#include <cstdint>
+#include <iostream>
+#include <thread>
+int main() {
+  media::AhiCaptureBuffer<8> ring;
+  const int16_t stereo[] = {-32768, 32767, 16384, -16384};
+  float left[8]{}, right[8]{};
+  assert(ring.Write(stereo, 2, 2));
+  assert(!ring.Read(left, right, 3));
+  assert(ring.Read(left, right, 2));
+  assert(left[0] == -1 && right[0] == 32767.0f / 32768);
+  assert(left[1] == .5f && right[1] == -.5f);
+  const int16_t mono[8] = {1,2,3,4,5,6,7,8};
+  assert(ring.Write(mono, 8, 1));
+  assert(!ring.Write(mono, 1, 1));
+  assert(ring.TakeDroppedFrames() == 1 && ring.TakeDroppedFrames() == 0);
+  assert(ring.Read(left, right, 8));
+  for (int i=0;i<8;i++) assert(left[i] == (i+1)/32768.0f && right[i] == (i+1)/32768.0f);
+  assert(ring.Write(stereo, 2, 2));
+  assert(ring.Read(left, nullptr, 2));
+  assert(left[1] == 0);
+  const int8_t eight[] = {-128, 127};
+  assert(ring.Write(eight, 2, 1));
+  assert(ring.Read(left, right, 2) && left[0] == -1 && right[1] == 127.0f/128);
+  const int32_t thirtytwo[] = {INT32_MIN, 1073741824};
+  assert(ring.Write(thirtytwo, 2, 1));
+  assert(ring.Read(left, right, 2) && left[0] == -1 && right[1] == .5f);
+  media::AhiCaptureBuffer<1024> threaded;
+  constexpr int count = 100000;
+  std::thread producer([&]{for(int i=0;i<count;++i){int32_t sample[2]={i,-i};while(!threaded.Write(sample,1,2))std::this_thread::yield();}});
+  for(int i=0;i<count;++i){while(!threaded.Read(left,right,1))std::this_thread::yield();assert(left[0]==i/2147483648.0f && right[0]==-i/2147483648.0f);}
+  producer.join();assert(threaded.Available()==0);
+  std::cout << "PASS: format conversion, mono/stereo, wrap, overflow, partial reads, 100000 concurrent frames\n";
+}
