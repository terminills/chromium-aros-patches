+#ifndef MEDIA_AUDIO_AROS_AHI_INPUT_STREAM_H_
+#define MEDIA_AUDIO_AROS_AHI_INPUT_STREAM_H_
+#include <atomic>
+#include <memory>
+#include <string>
+#include "base/memory/raw_ptr.h"
+#include "base/threading/simple_thread.h"
+#include "media/audio/audio_device_name.h"
+#include "media/audio/audio_io.h"
+#include "media/base/audio_parameters.h"
+namespace media {
+class AudioManagerBase;
+class AhiInputStream final : public AudioInputStream,
+                             public base::DelegateSimpleThread::Delegate {
+ public:
+  AhiInputStream(const AudioParameters& params,
+                 const std::string& device_id,
+                 AudioManagerBase* manager);
+  ~AhiInputStream() override;
+  static void GetDeviceNames(AudioDeviceNames* names);
+  OpenOutcome Open() override;
+  void Start(AudioInputCallback* callback) override;
+  void Stop() override;
+  void Close() override;
+  double GetMaxVolume() override { return 0.0; }
+  void SetVolume(double volume) override {}
+  double GetVolume() override { return 1.0; }
+  bool SetAutomaticGainControl(bool enabled) override { return !enabled; }
+  bool GetAutomaticGainControl() override { return false; }
+  bool IsMuted() override { return false; }
+  void SetOutputDeviceForAec(const std::string& device_id) override {}
+  void Run() override;
+
+ private:
+  const AudioParameters params_;
+  const std::string device_id_;
+  const raw_ptr<AudioManagerBase> manager_;
+  uint32_t mode_id_ = 0;
+  bool opened_ = false;
+  raw_ptr<AudioInputCallback> callback_ = nullptr;
+  std::atomic<bool> stopped_{false};
+  std::unique_ptr<base::DelegateSimpleThread> thread_;
+};
+}  // namespace media
+#endif
