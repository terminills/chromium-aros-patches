-namespace media::aros {
-
-namespace {
-
-// amdgpu.hidd functions are plain C calls through the library vector table;
-// function n of amdgpu.conf's list sits at slot -(4 + n).
-enum Lvo {
-  kGetDeviceCount = 5,
-  kGetDevice = 6,
-  kBoAlloc = 25,
-  kBoFree = 26,
-  kBoCpuMap = 28,
-  kBoCpuUnmap = 29,
-  kVaRangeAlloc = 31,
-  kVaRangeFree = 32,
-  kBoVaBind = 34,
-  kBoVaUnbind = 35,
-  kVcnSubmitIb = 51,
-  kVcnQueryFence = 52,
-};
-
-constexpr uint32_t kDomainGtt = 2;
-constexpr uint32_t kMinRevision = 15;
-
-template <typename F>
-F Vec(void* base, int lvo) {
-  return reinterpret_cast<F>(reinterpret_cast<void**>(base)[-lvo]);
-}
-
-AmdgpuVcn* g_vcn = nullptr;
-std::once_flag g_once;
-
-}  // namespace
-
-// static
-AmdgpuVcn* AmdgpuVcn::Get() {
-  std::call_once(g_once, [] {
-    struct Library* lib = OpenLibrary("amdgpu.hidd", 0);
-    if (!lib) {
-      return;
-    }
-    if (lib->lib_Version == 0 && lib->lib_Revision < kMinRevision) {
-      CloseLibrary(lib);
-      return;
-    }
-    auto count = Vec<ULONG (*)()>(lib, kGetDeviceCount);
-    auto device = Vec<void* (*)(ULONG)>(lib, kGetDevice);
-    void* ad = count() ? device(0) : nullptr;
-    if (!ad) {
-      CloseLibrary(lib);
-      return;
-    }
-    // Probe that the VCN ring is running: fence 0 always reads complete.
-    ULONG complete = 0;
-    auto query = Vec<LONG (*)(void*, ULONG, ULONG*)>(lib, kVcnQueryFence);
-    if (query(ad, 0, &complete) != 0) {
-      CloseLibrary(lib);
-      return;
-    }
-    g_vcn = new AmdgpuVcn();
-    g_vcn->base_ = lib;
-    g_vcn->device_ = ad;
-  });
-  return g_vcn;
-}
-
-bool AmdgpuVcn::Alloc(size_t size, AmdgpuBuffer* out) {
-  ULONG bo = 0, va = 0;
-  UQUAD address = 0;
-  APTR cpu = nullptr;
-
-  *out = AmdgpuBuffer();
-  size = (size + 4095) & ~static_cast<size_t>(4095);
-  if (Vec<LONG (*)(void*, UQUAD, UQUAD, ULONG, ULONG, ULONG*)>(base_, kBoAlloc)(
-          device_, size, 4096, kDomainGtt, 0, &bo)) {
-    return false;
-  }
-  out->bo = bo;
-  out->size = size;
-  if (Vec<LONG (*)(void*, ULONG, APTR*)>(base_, kBoCpuMap)(device_, bo, &cpu) ||
-      Vec<LONG (*)(void*, UQUAD, UQUAD, UQUAD, ULONG*, UQUAD*)>(
-          base_, kVaRangeAlloc)(device_, size, 4096, 0, &va, &address)) {
-    out->cpu = static_cast<uint8_t*>(cpu);
-    out->va = va;
-    Free(out);
-    return false;
-  }
-  out->cpu = static_cast<uint8_t*>(cpu);
-  out->va = va;
-  if (Vec<LONG (*)(void*, ULONG, ULONG)>(base_, kBoVaBind)(device_, bo, va)) {
-    Free(out);
-    return false;
-  }
-  out->gpu_address = address;
-  memset(out->cpu, 0, size);
-  return true;
-}
-
-void AmdgpuVcn::Free(AmdgpuBuffer* buffer) {
-  if (buffer->gpu_address) {
-    Vec<LONG (*)(void*, ULONG)>(base_, kBoVaUnbind)(device_, buffer->va);
-  }
-  if (buffer->va) {
-    Vec<LONG (*)(void*, ULONG)>(base_, kVaRangeFree)(device_, buffer->va);
-  }
-  if (buffer->cpu) {
-    Vec<LONG (*)(void*, ULONG)>(base_, kBoCpuUnmap)(device_, buffer->bo);
-  }
-  if (buffer->bo) {
-    Vec<LONG (*)(void*, ULONG)>(base_, kBoFree)(device_, buffer->bo);
-  }
-  *buffer = AmdgpuBuffer();
-}
-
-// static
-void AmdgpuVcn::Flush(const AmdgpuBuffer& buffer, size_t size) {
-  CacheClearE(buffer.cpu, size, CACRF_ClearD);
-}
-
-// static
-void AmdgpuVcn::Invalidate(const AmdgpuBuffer& buffer, size_t size) {
-  CacheClearE(buffer.cpu, size, CACRF_InvalidateD);
-}
-
-bool AmdgpuVcn::Submit(uint64_t ib_address, uint32_t dwords, uint32_t* fence) {
-  ULONG f = 0;
-  if (Vec<LONG (*)(void*, UQUAD, ULONG, ULONG*)>(base_, kVcnSubmitIb)(
-          device_, ib_address, dwords, &f)) {
-    return false;
-  }
-  *fence = f;
-  return true;
-}
-
-bool AmdgpuVcn::WaitFence(uint32_t fence) {
-  auto query = Vec<LONG (*)(void*, ULONG, ULONG*)>(base_, kVcnQueryFence);
-  for (int poll = 0; poll < 200000; ++poll) {
-    ULONG complete = 0;
-    if (query(device_, fence, &complete)) {
-      return false;
-    }
-    if (complete) {
-      return true;
-    }
-    if (poll > 2000) {
-      usleep(500);
-    }
-  }
-  return false;
-}
-
-}  // namespace media::aros
