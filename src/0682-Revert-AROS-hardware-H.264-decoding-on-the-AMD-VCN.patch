-void ArosVcnVideoDecoder::Reset(base::OnceClosure closure) {
-  if (decoder_) {
-    decoder_->Reset();
-  }
-  timestamps_.clear();
-  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
-                                                           std::move(closure));
