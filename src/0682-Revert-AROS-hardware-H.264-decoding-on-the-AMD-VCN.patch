-DecoderStatus ArosVcnVideoDecoder::DecodeOne(const DecoderBuffer& buffer) {
-  const int32_t id = next_bitstream_id_++ & 0x3fffffff;
-  timestamps_[id] = buffer.timestamp();
-  decoder_->SetStream(id, buffer);
-  for (;;) {
-    switch (decoder_->Decode()) {
-      case AcceleratedVideoDecoder::DecodeResult::kConfigChange:
-        continue;
-      case AcceleratedVideoDecoder::DecodeResult::kRanOutOfStreamData:
-        return DecoderStatus::Codes::kOk;
-      default:
-        VcnLog("[Chromium:AROS:VCN] H264Decoder reported an error\n");
-        return DecoderStatus::Codes::kFailed;
-    }
-  }
-}
-
-void ArosVcnVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
-                                 DecodeCB decode_cb) {
-  DecoderStatus status = DecoderStatus::Codes::kOk;
-  if (!decoder_) {
-    status = DecoderStatus::Codes::kNotInitialized;
-  } else if (buffer->end_of_stream()) {
-    if (!decoder_->Flush()) {
-      status = DecoderStatus::Codes::kFailed;
-    }
-  } else {
-    status = DecodeOne(*buffer);
-  }
-  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
-      FROM_HERE, base::BindOnce(std::move(decode_cb), status));
-}
