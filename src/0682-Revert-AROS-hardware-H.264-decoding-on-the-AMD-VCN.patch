-#ifndef MEDIA_GPU_AROS_AROS_AMDGPU_H_
-#define MEDIA_GPU_AROS_AROS_AMDGPU_H_
-
-#include <stddef.h>
-#include <stdint.h>
-
-namespace media::aros {
-
-// A GPU buffer from amdgpu.hidd: system memory mapped through the GART,
-// visible to the CPU at |cpu| and to the GPU at |gpu_address|.
-struct AmdgpuBuffer {
-  uint32_t bo = 0;
-  uint32_t va = 0;
-  uint64_t gpu_address = 0;
-  uint8_t* cpu = nullptr;
-  size_t size = 0;
-};
-
-// amdgpu.hidd's VCN submission interface (library 0.15 or later).
-class AmdgpuVcn {
- public:
-  // Opens amdgpu.hidd once; nullptr when there is no VCN-capable device.
-  static AmdgpuVcn* Get();
-
-  bool Alloc(size_t size, AmdgpuBuffer* out);
-  void Free(AmdgpuBuffer* buffer);
-
-  // Write back CPU caches before the GPU reads, drop them before the CPU
-  // reads what the GPU wrote.
-  static void Flush(const AmdgpuBuffer& buffer, size_t size);
-  static void Invalidate(const AmdgpuBuffer& buffer, size_t size);
-
-  bool Submit(uint64_t ib_address, uint32_t dwords, uint32_t* fence);
-  bool WaitFence(uint32_t fence);
-
- private:
-  AmdgpuVcn() = default;
-
-  void* base_ = nullptr;
-  void* device_ = nullptr;
-};
-
-}  // namespace media::aros
-
-#endif  // MEDIA_GPU_AROS_AROS_AMDGPU_H_
