-void ArosVcnVideoDecoder::OutputFrame(scoped_refptr<VideoFrame> frame,
-                                      int32_t bitstream_id,
-                                      const gfx::Rect& visible_rect) {
-  auto it = timestamps_.find(bitstream_id);
-  const base::TimeDelta timestamp =
-      it != timestamps_.end() ? it->second : base::TimeDelta();
-  if (it != timestamps_.end()) {
-    timestamps_.erase(timestamps_.begin(), std::next(it));
-  }
-  gfx::Rect visible = visible_rect.IsEmpty() ? config_.visible_rect()
-                                             : visible_rect;
-  visible.Intersect(gfx::Rect(frame->coded_size()));
-  scoped_refptr<VideoFrame> out = VideoFrame::WrapVideoFrame(
-      frame, frame->format(), visible, config_.natural_size());
-  if (!out) {
-    return;
-  }
-  out->set_timestamp(timestamp);
-  out->set_color_space(config_.color_space_info().ToGfxColorSpace());
-  output_cb_.Run(std::move(out));
-}
