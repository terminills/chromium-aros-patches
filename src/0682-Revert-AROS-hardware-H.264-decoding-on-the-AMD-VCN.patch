-constexpr uint32_t kFeedbackOffset = 0x2000;
-constexpr uint32_t kFeedbackSize = 2048;
-constexpr uint32_t kItSize = 992;
-constexpr uint32_t kNumH264Refs = 17;
-constexpr uint32_t kDbAlignment = 64;
-constexpr uint32_t kDtPitchAlignment = 256;
-
-constexpr uint32_t Align(uint32_t v, uint32_t a) {
-  return (v + a - 1) & ~(a - 1);
-}
-
-std::atomic<uint32_t> g_next_handle{0x41524f00};
-
-}  // namespace
-
-VcnH264Session::VcnH264Session() : vcn_(AmdgpuVcn::Get()) {}
-
-VcnH264Session::~VcnH264Session() {
-  Destroy();
-}
-
-bool VcnH264Session::Create(uint32_t width, uint32_t height,
-                            uint32_t level_idc, uint32_t max_num_ref_frames) {
-  Destroy();
-  if (!vcn_ || !width || !height) {
-    return false;
-  }
-  width_ = width;
-  height_ = height;
-
-  // calc_dpb_size() / calc_ctx_size_h264_perf() in radeon_vcn_dec.c.
-  const uint32_t w_mb = Align(width, 16) / 16;
-  const uint32_t h_mb = Align(Align(height, 16) / 16, 2);
-  const uint32_t fs_in_mb = w_mb * h_mb;
-  uint32_t refs;
-  switch (level_idc) {
-    case 30: refs = 8100 / fs_in_mb; break;
-    case 31: refs = 18000 / fs_in_mb; break;
-    case 32: refs = 20480 / fs_in_mb; break;
-    case 41: refs = 32768 / fs_in_mb; break;
-    case 42: refs = 34816 / fs_in_mb; break;
-    case 50: refs = 110400 / fs_in_mb; break;
-    default: refs = 184320 / fs_in_mb; break;
-  }
-  refs = std::min(refs + 1, kNumH264Refs);
-  refs = std::max(refs, max_num_ref_frames + 1);
-  uint32_t image = Align(width, kDbAlignment) * Align(height, kDbAlignment);
-  image = Align(image + image / 2, 1024);
-  dpb_size_ = image * refs;
-  ctx_size_ = refs * Align(fs_in_mb * 192, 256);
-  dt_pitch_ = Align(width, kDtPitchAlignment);
-  dt_height_ = Align(height, 16);
-
-  if (!vcn_->Alloc(RDECODE_SESSION_CONTEXT_SIZE, &session_) ||
-      !vcn_->Alloc(kFeedbackOffset + kFeedbackSize + kItSize, &msg_) ||
-      !vcn_->Alloc(dpb_size_, &dpb_) || !vcn_->Alloc(ctx_size_, &ctx_) ||
-      !vcn_->Alloc(dt_pitch_ * dt_height_ * 3 / 2, &dt_) ||
-      !vcn_->Alloc(4096, &ib_) ||
-      !vcn_->Alloc(Align(width, 16) * Align(height, 16) * 3 / 2 + 4096,
-                   &bs_)) {
-    Destroy();
-    return false;
-  }
-
-  stream_handle_ = ++g_next_handle;
-  frame_number_ = 0;
-
-  auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
-  auto* create = reinterpret_cast<rvcn_dec_message_create_t*>(
-      msg_.cpu + sizeof(*header));
-  header->header_size = sizeof(*header);
-  header->total_size = sizeof(*header) + sizeof(*create);
-  header->num_buffers = 1;
-  header->msg_type = RDECODE_MSG_CREATE;
-  header->stream_handle = stream_handle_;
-  header->index[0].message_id = RDECODE_MESSAGE_CREATE;
-  header->index[0].offset = sizeof(*header);
-  header->index[0].size = sizeof(*create);
-  create->stream_type = RDECODE_CODEC_H264_PERF;
-  create->width_in_samples = width;
-  create->height_in_samples = height;
-  if (!Submit(false)) {
-    Destroy();
-    return false;
-  }
-  created_ = true;
-  return true;
-}
-
-void VcnH264Session::Destroy() {
-  if (!vcn_) {
-    return;
-  }
-  if (created_) {
-    memset(msg_.cpu, 0, msg_.size);
-    auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
-    header->header_size = sizeof(*header);
-    header->total_size = sizeof(*header);
-    header->msg_type = RDECODE_MSG_DESTROY;
-    header->stream_handle = stream_handle_;
-    Submit(false);
-    created_ = false;
-  }
-  for (AmdgpuBuffer* b : {&session_, &msg_, &dpb_, &ctx_, &bs_, &dt_, &ib_}) {
-    if (b->bo) {
-      vcn_->Free(b);
-    }
-  }
-}
-
-void VcnH264Session::BeginPicture() {
-  bs_bytes_ = 0;
-}
-
-bool VcnH264Session::AddSlice(const uint8_t* data, size_t size) {
-  if (bs_bytes_ + size + 3 + 128 > bs_.size) {
-    return false;
-  }
-  bs_.cpu[bs_bytes_++] = 0;
-  bs_.cpu[bs_bytes_++] = 0;
-  bs_.cpu[bs_bytes_++] = 1;
-  memcpy(bs_.cpu + bs_bytes_, data, size);
-  bs_bytes_ += size;
-  return true;
-}
-
-bool VcnH264Session::Decode(const VcnH264Picture& pic) {
-  if (!created_ || !bs_bytes_) {
-    return false;
-  }
-  const uint32_t bsd_size = Align(bs_bytes_, 128);
-  memset(bs_.cpu + bs_bytes_, 0, bsd_size - bs_bytes_);
-  AmdgpuVcn::Flush(bs_, bsd_size);
-
-  memset(msg_.cpu, 0, msg_.size);
-  auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
-  uint32_t sizes = sizeof(*header);
-  auto* index_codec =
-      reinterpret_cast<rvcn_dec_message_index_t*>(msg_.cpu + sizes);
-  sizes += sizeof(*index_codec);
-  const uint32_t offset_decode = sizes;
-  auto* decode =
-      reinterpret_cast<rvcn_dec_message_decode_t*>(msg_.cpu + sizes);
-  sizes += sizeof(*decode);
-  const uint32_t offset_codec = sizes;
-  auto* avc = reinterpret_cast<rvcn_dec_message_avc_t*>(msg_.cpu + sizes);
-
-  header->header_size = sizeof(*header);
-  header->total_size = sizes + sizeof(*avc);
-  header->msg_type = RDECODE_MSG_DECODE;
-  header->stream_handle = stream_handle_;
-  header->status_report_feedback_number = ++frame_number_;
-  header->num_buffers = 2;
-  header->index[0].message_id = RDECODE_MESSAGE_DECODE;
-  header->index[0].offset = offset_decode;
-  header->index[0].size = sizeof(*decode);
-  index_codec->message_id = RDECODE_MESSAGE_AVC;
-  index_codec->offset = offset_codec;
-  index_codec->size = sizeof(*avc);
-
-  decode->stream_type = RDECODE_CODEC_H264_PERF;
-  decode->width_in_samples = width_;
-  decode->height_in_samples = height_;
-  decode->bsd_size = bsd_size;
-  decode->dpb_size = dpb_size_;
-  decode->dt_size = dt_.size;
-  decode->hw_ctxt_size = ctx_.size;
-  decode->sw_ctxt_size = RDECODE_SESSION_CONTEXT_SIZE;
-  decode->db_pitch = Align(width_, kDbAlignment);
-  decode->db_swizzle_mode = RDECODE_VCN5_256B_D;
-  decode->db_array_mode = RDECODE_ARRAY_MODE_ADDRLIB_SEL_GFX11;
-  decode->dt_pitch = dt_pitch_;
-  decode->dt_uv_pitch = dt_pitch_ / 2;
-  decode->dt_swizzle_mode = RDECODE_SW_MODE_LINEAR;
-  decode->dt_array_mode = RDECODE_ARRAY_MODE_ADDRLIB_SEL_GFX11;
-  decode->dt_chroma_top_offset = dt_pitch_ * dt_height_;
-  decode->dt_chroma_bottom_offset = dt_pitch_ * dt_height_;
-  decode->mif_wrc_en = 1;
-
-  avc->profile = pic.profile_idc == 66   ? RDECODE_H264_PROFILE_BASELINE
-                 : pic.profile_idc == 77 ? RDECODE_H264_PROFILE_MAIN
-                                         : RDECODE_H264_PROFILE_HIGH;
-  avc->level = pic.level_idc;
-  avc->sps_info_flags = pic.sps_info_flags;
-  avc->pps_info_flags = pic.pps_info_flags;
-  avc->chroma_format = pic.chroma_format;
-  avc->bit_depth_luma_minus8 = pic.bit_depth_luma_minus8;
-  avc->bit_depth_chroma_minus8 = pic.bit_depth_chroma_minus8;
-  avc->log2_max_frame_num_minus4 = pic.log2_max_frame_num_minus4;
-  avc->pic_order_cnt_type = pic.pic_order_cnt_type;
-  avc->log2_max_pic_order_cnt_lsb_minus4 =
-      pic.log2_max_pic_order_cnt_lsb_minus4;
-  avc->num_ref_frames = pic.num_ref_frames;
-  avc->pic_init_qp_minus26 = pic.pic_init_qp_minus26;
-  avc->pic_init_qs_minus26 = pic.pic_init_qs_minus26;
-  avc->chroma_qp_index_offset = pic.chroma_qp_index_offset;
-  avc->second_chroma_qp_index_offset = pic.second_chroma_qp_index_offset;
-  avc->num_ref_idx_l0_active_minus1 = pic.num_ref_idx_l0_active_minus1;
-  avc->num_ref_idx_l1_active_minus1 = pic.num_ref_idx_l1_active_minus1;
-  memcpy(avc->scaling_list_4x4, pic.scaling_list_4x4, sizeof(avc->scaling_list_4x4));
-  memcpy(avc->scaling_list_8x8, pic.scaling_list_8x8, sizeof(avc->scaling_list_8x8));
-  uint8_t* it = msg_.cpu + kFeedbackOffset + kFeedbackSize;
-  memcpy(it, pic.scaling_list_4x4, 6 * 16);
-  memcpy(it + 96, pic.scaling_list_8x8, 2 * 64);
-  avc->frame_num = pic.frame_num;
-  avc->curr_field_order_cnt_list[0] = pic.curr_field_order_cnt[0];
-  avc->curr_field_order_cnt_list[1] = pic.curr_field_order_cnt[1];
-  for (uint32_t i = 0; i < pic.num_refs && i < 16; ++i) {
-    avc->frame_num_list[i] = pic.frame_num_list[i];
-    avc->field_order_cnt_list[i][0] = pic.field_order_cnt_list[i][0];
-    avc->field_order_cnt_list[i][1] = pic.field_order_cnt_list[i][1];
-  }
-  avc->decoded_pic_idx = pic.decoded_pic_idx;
-
-  auto* fb = reinterpret_cast<rvcn_dec_feedback_header_t*>(msg_.cpu +
-                                                           kFeedbackOffset);
-  fb->header_size = sizeof(*fb);
-  fb->total_size = sizeof(*fb);
-
-  if (!Submit(true)) {
-    return false;
-  }
-  AmdgpuVcn::Invalidate(dt_, dt_.size);
