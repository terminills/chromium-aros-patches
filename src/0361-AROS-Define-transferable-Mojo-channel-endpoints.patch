+
+#include <cstdint>
+#include <utility>
+
+#include "base/component_export.h"
+
+namespace mojo {
+
+struct ArosChannelHandle {
+  void* state = nullptr;
+  uint8_t side = 0;
+
+  bool is_valid() const { return state != nullptr; }
