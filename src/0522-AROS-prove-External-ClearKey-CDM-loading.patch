diff --git a/base/files/file_enumerator_posix.cc b/base/files/file_enumerator_posix.cc
index 5cdb7c6582..8351fa7255 100644
--- a/base/files/file_enumerator_posix.cc
+++ b/base/files/file_enumerator_posix.cc
@@ -89,10 +89,17 @@ void GetStat(const FilePath& path, bool show_links, stat_wrapper_t* st) {
   const int res = show_links ? File::Lstat(path.value().c_str(), st)
                              : File::Stat(path.value().c_str(), st);
   if (res < 0) {
+#if BUILDFLAG(IS_AROS)
+    // AROS cache cleanup commonly enumerates stale names while another cleanup
+    // pass removes them. ENOENT is still represented as a zeroed stat entry
+    // below; avoid turning those expected races into large ERROR bursts.
+    DPLOG_IF(ERROR, errno != ENOENT) << "Cannot stat '" << path << "'";
+#else
     // Print the stat() error message unless it was ENOENT and we're following
     // symlinks.
     DPLOG_IF(ERROR, errno != ENOENT || show_links)
         << "Cannot stat '" << path << "'";
+#endif
     memset(st, 0, sizeof(*st));
   }
 }
diff --git a/base/native_library_aros.cc b/base/native_library_aros.cc
index 0ef75fb570..96b6b8222e 100644
--- a/base/native_library_aros.cc
+++ b/base/native_library_aros.cc
@@ -4,15 +4,207 @@
 
 #include "base/native_library.h"
 
-#include <exec/libraries.h>
-#include <proto/exec.h>
-
+#include "base/logging.h"
 #include "base/strings/strcat.h"
 #include "base/strings/string_util.h"
 #include "base/threading/scoped_blocking_call.h"
 
+#include <string.h>
+
+#include <dos/dos.h>
+#include <exec/execbase.h>
+#include <exec/libraries.h>
+#include <libraries/debug.h>
+#include <proto/debug.h>
+#include <proto/dos.h>
+#include <proto/exec.h>
+#include <utility/hooks.h>
+
 namespace base {
 
+namespace {
+
+enum class ArosNativeLibraryKind {
+  kExecLibrary,
+  kLoadSegModule,
+};
+
+struct ArosNativeLibrary {
+  ArosNativeLibraryKind kind;
+  std::string name;
+  void* handle;
+  bool module_startup_ran = false;
+};
+
+struct SymbolLookupData {
+  const ArosNativeLibrary* library;
+  const char* symbol_name;
+  void* result;
+};
+
+AROS_UFH3S(IPTR,
+           SymbolLookupHook,
+           AROS_UFHA(struct Hook*, hook, A0),
+           AROS_UFHA(APTR, object, A2),
+           AROS_UFHA(APTR, message, A1)) {
+  AROS_USERFUNC_INIT
+
+  (void)object;
+  auto* data = static_cast<SymbolLookupData*>(hook->h_Data);
+  auto* symbol = static_cast<struct SymbolInfo*>(message);
+  if (!data || data->result || !symbol || !symbol->si_SymbolName) {
+    return 0;
+  }
+
+  if (strcmp(symbol->si_SymbolName, data->symbol_name) == 0) {
+    if (!data->library->name.empty() && symbol->si_ModuleName &&
+        strstr(symbol->si_ModuleName, data->library->name.c_str()) == nullptr) {
+      return 0;
+    }
+
+    data->result = symbol->si_SymbolStart;
+  }
+
+  return 0;
+
+  AROS_USERFUNC_EXIT
+}
+
+bool IsArosLoadSegModule(const FilePath& library_path) {
+  return EndsWith(library_path.value(), ".so", CompareCase::SENSITIVE);
+}
+
+NativeLibrary WrapArosLibrary(ArosNativeLibraryKind kind,
+                              std::string name,
+                              void* handle) {
+  if (!handle) {
+    return nullptr;
+  }
+
+  auto* library = new ArosNativeLibrary;
+  library->kind = kind;
+  library->name = std::move(name);
+  library->handle = handle;
+  return library;
+}
+
+void* LookupLoadSegSymbol(const ArosNativeLibrary* library, const char* name) {
+  if (!library || !name)
+    return nullptr;
+
+  struct Library* debug_base = OpenLibrary("debug.library", 0);
+  if (!debug_base)
+    return nullptr;
+
+  SymbolLookupData data = {library, name, nullptr};
+  struct Hook hook = {};
+  hook.h_Entry = reinterpret_cast<APTR>(SymbolLookupHook);
+  hook.h_Data = &data;
+
+  EnumerateSymbolsA(&hook, nullptr);
+  CloseLibrary(debug_base);
+  return data.result;
+}
+
+using ArosOpenLibrariesListFunc =
+    int (*)(const void* const list[], struct ExecBase* sys_base);
+using ArosCloseLibrariesListFunc =
+    void (*)(const void* const list[], struct ExecBase* sys_base);
+using ArosSetCallFuncsFunc = int (*)(const void* const set[],
+                                     int direction,
+                                     int test_fail,
+                                     struct ExecBase* sys_base);
+
+bool RunLoadSegModuleStartup(ArosNativeLibrary* library,
+                             NativeLibraryLoadError* error) {
+  auto* open_libraries = reinterpret_cast<ArosOpenLibrariesListFunc>(
+      LookupLoadSegSymbol(library, "_set_open_libraries_list"));
+  auto* call_funcs = reinterpret_cast<ArosSetCallFuncsFunc>(
+      LookupLoadSegSymbol(library, "_set_call_funcs"));
+  auto* libs = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__LIBS_LIST__"));
+  auto* init = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__INIT_LIST__"));
+  auto* ctors = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__CTORS_LIST__"));
+  auto* init_array = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__INIT_ARRAY_LIST__"));
+
+  LOG(INFO) << "[Chromium:AROS:NativeLibrary] module startup symbols module="
+            << library->name << " open_libraries="
+            << reinterpret_cast<void*>(open_libraries) << " call_funcs="
+            << reinterpret_cast<void*>(call_funcs) << " libs=" << libs
+            << " init=" << init << " ctors=" << ctors
+            << " init_array=" << init_array;
+
+  if (!open_libraries || !call_funcs || !libs) {
+    if (error) {
+      error->message =
+          StrCat({"AROS module startup symbols missing: ", library->name});
+    }
+    return false;
+  }
+
+  if (!open_libraries(libs, SysBase)) {
+    if (error) {
+      error->message =
+          StrCat({"AROS module failed to open libraries: ", library->name});
+    }
+    return false;
+  }
+
+  library->module_startup_ran = true;
+
+  if (init && !call_funcs(init, 1, 1, SysBase)) {
+    if (error)
+      error->message = StrCat({"AROS module INIT failed: ", library->name});
+    return false;
+  }
+
+  if (ctors)
+    call_funcs(ctors, -1, 0, SysBase);
+  if (init_array)
+    call_funcs(init_array, 1, 0, SysBase);
+
+  LOG(INFO) << "[Chromium:AROS:NativeLibrary] module startup complete module="
+            << library->name;
+  return true;
+}
+
+void RunLoadSegModuleShutdown(ArosNativeLibrary* library) {
+  if (!library || !library->module_startup_ran)
+    return;
+
+  auto* close_libraries = reinterpret_cast<ArosCloseLibrariesListFunc>(
+      LookupLoadSegSymbol(library, "_set_close_libraries_list"));
+  auto* call_funcs = reinterpret_cast<ArosSetCallFuncsFunc>(
+      LookupLoadSegSymbol(library, "_set_call_funcs"));
+  auto* fini_array = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__FINI_ARRAY_LIST__"));
+  auto* dtors = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__DTORS_LIST__"));
+  auto* exit = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__EXIT_LIST__"));
+  auto* libs = reinterpret_cast<const void* const*>(
+      LookupLoadSegSymbol(library, "__LIBS_LIST__"));
+
+  if (call_funcs) {
+    if (fini_array)
+      call_funcs(fini_array, -1, 0, SysBase);
+    if (dtors)
+      call_funcs(dtors, 1, 0, SysBase);
+    if (exit)
+      call_funcs(exit, -1, 0, SysBase);
+  }
+
+  if (close_libraries && libs)
+    close_libraries(libs, SysBase);
+
+  library->module_startup_ran = false;
+}
+
+}  // namespace
+
 std::string NativeLibraryLoadError::ToString() const {
   return message;
 }
@@ -20,21 +212,73 @@ std::string NativeLibraryLoadError::ToString() const {
 NativeLibrary LoadNativeLibraryWithOptions(const FilePath& library_path,
                                            const NativeLibraryOptions& options,
                                            NativeLibraryLoadError* error) {
+  (void)options;
   ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
+
+  if (IsArosLoadSegModule(library_path)) {
+    BPTR segment = LoadSeg(library_path.value().c_str());
+    if (!segment) {
+      if (error)
+        error->message = StrCat({"LoadSeg failed: ", library_path.value()});
+      return nullptr;
+    }
+
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] LoadSeg module loaded path="
+              << library_path.value();
+    NativeLibrary library = WrapArosLibrary(ArosNativeLibraryKind::kLoadSegModule,
+                                            library_path.BaseName().value(),
+                                            reinterpret_cast<void*>(segment));
+    if (!RunLoadSegModuleStartup(static_cast<ArosNativeLibrary*>(library),
+                                 error)) {
+      UnLoadSeg(segment);
+      delete static_cast<ArosNativeLibrary*>(library);
+      return nullptr;
+    }
+
+    return library;
+  }
+
   struct Library* library = OpenLibrary(library_path.value().c_str(), 0);
-  if (!library && error)
-    error->message = StrCat({"OpenLibrary failed: ", library_path.value()});
-  return library;
+  if (!library) {
+    if (error)
+      error->message = StrCat({"OpenLibrary failed: ", library_path.value()});
+    return nullptr;
+  }
+
+  return WrapArosLibrary(ArosNativeLibraryKind::kExecLibrary,
+                         library_path.BaseName().value(), library);
 }
 
 void UnloadNativeLibrary(NativeLibrary library) {
-  if (library)
-    CloseLibrary(static_cast<struct Library*>(library));
+  auto* aros_library = static_cast<ArosNativeLibrary*>(library);
+  if (!aros_library)
+    return;
+
+  if (aros_library->kind == ArosNativeLibraryKind::kLoadSegModule) {
+    RunLoadSegModuleShutdown(aros_library);
+    UnLoadSeg(reinterpret_cast<BPTR>(aros_library->handle));
+  } else {
+    CloseLibrary(static_cast<struct Library*>(aros_library->handle));
+  }
+
+  delete aros_library;
 }
 
 void* GetFunctionPointerFromNativeLibrary(NativeLibrary library,
                                           const char* name) {
-  // AROS exports versioned library vectors, not a dlsym-style name table.
+  auto* aros_library = static_cast<ArosNativeLibrary*>(library);
+  if (!aros_library || !name)
+    return nullptr;
+
+  if (aros_library->kind == ArosNativeLibraryKind::kLoadSegModule) {
+    void* result = LookupLoadSegSymbol(aros_library, name);
+    LOG(INFO) << "[Chromium:AROS:NativeLibrary] symbol lookup module="
+              << aros_library->name << " name=" << name
+              << " result=" << result;
+    return result;
+  }
+
+  // Exec libraries export versioned vectors, not a dlsym-style name table.
   return nullptr;
 }
 
