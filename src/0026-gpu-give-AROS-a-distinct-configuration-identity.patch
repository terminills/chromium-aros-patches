       case kConfigNVidia:
       case kConfigAMD:
       case kConfigARM:
@@ -482,6 +486,7 @@ bool GPUTestExpectationsParser::UpdateTestConfig(GPUTestConfig* config,
     case kConfigLinux:
     case kConfigChromeOS:
     case kConfigAndroid:
+    case kConfigAROS:
       if ((config->os() & kTokenData[token].flag) != 0) {
         PushErrorMessage(kErrorMessage[kErrorEntryWithOsConflicts],
                          line_number);
