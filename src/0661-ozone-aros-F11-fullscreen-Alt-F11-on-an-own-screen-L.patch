+// Intuition draws window and screen titles in Latin-1; page titles are
+// Unicode. Common typographic punctuation becomes its ASCII look-alike and
+// anything else outside Latin-1 becomes '?', instead of UTF-8 bytes drawn as
+// Latin-1 ("Leo’s" showed as "Leoâ..s").
+std::string TitleForIntuition(const std::u16string& title) {
+  std::string out;
+  out.reserve(title.size());
+  for (const char16_t c : title) {
+    switch (c) {
+      case u'\u2018':
+      case u'\u2019':
+      case u'\u201A':
+      case u'\u2032':
+        out += '\'';
+        break;
+      case u'\u201C':
+      case u'\u201D':
+      case u'\u201E':
+      case u'\u2033':
+        out += '"';
+        break;
+      case u'\u2013':
+      case u'\u2014':
+      case u'\u2212':
+        out += '-';
+        break;
+      case u'\u2026':
+        out += "...";
+        break;
+      default:
+        out += c <= 0xFF ? static_cast<char>(c) : '?';
+    }
+  }
+  return out;
+}
