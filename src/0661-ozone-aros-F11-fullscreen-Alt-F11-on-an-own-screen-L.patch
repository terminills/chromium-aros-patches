+void ArosWindow::CloseNativeWindow() {
+  if (!window_) {
+    return;
+  }
+  ReturnIntuitionActivationToOwner();
+  DisableNativeEvents();
+  struct Window* const native = window_;
+  manager_->DetachNativeWindow(widget_, this, native);
+  {
+    // The compositor presents into window_ and the backing store under this
+    // lock; neither may disappear under a present in progress.
+    base::AutoLock lock(manager_->presentation_lock());
+    window_ = nullptr;
+    ReleaseNativeBackingStore();
+  }
+  CloseWindow(native);
+}
+
+void ArosWindow::SwitchNativeMode(NativeMode mode) {
+  if (shutting_down_ || !window_ || mode == native_mode_) {
+    return;
+  }
+  const NativeMode old_mode = native_mode_;
+  const gfx::Rect old_bounds = bounds_;
+  scoped_refptr<PlatformCursor> cursor = cursor_;
+  ResetNativeCursor();
+  CloseNativeWindow();
+  if (old_mode == NativeMode::kOwnScreen && own_screen_) {
+    // Fails while a menu or popup is still open on it; the destructor retries.
+    if (CloseScreen(own_screen_)) {
+      own_screen_ = nullptr;
+    }
+  }
+  if (mode == NativeMode::kNormal && restored_bounds_) {
+    bounds_ = *restored_bounds_;
+    restored_bounds_.reset();
+  }
+  if (!OpenNativeWindow(mode) && mode != NativeMode::kNormal) {
+    OpenNativeWindow(NativeMode::kNormal);
+  }
+  if (cursor) {
+    SetCursor(std::move(cursor));
+  }
+  if (visible_ && activatable_) {
+    RequestIntuitionActivation();
+  }
+  LOG(INFO) << "[Chromium:Ozone:AROS] window mode widget=" << widget_ << " "
+            << static_cast<int>(old_mode) << " -> "
+            << static_cast<int>(native_mode_)
+            << " client=" << bounds_.ToString();
+  if (bounds_ != old_bounds) {
+    delegate_->OnBoundsChanged({bounds_.origin() != old_bounds.origin()});
+  }
 }
 
