+
+void ArosWindow::ApplyNativeTitle() {
+  if (!window_ || title_.empty()) {
+    return;
+  }
+  char* const keep = reinterpret_cast<char*>(~uintptr_t{0});
+  char* const text = const_cast<char*>(title_.c_str());
+  if (native_mode_ == NativeMode::kOwnScreen) {
+    // The window has no title bar there; the screen's shows the page.
+    SetWindowTitles(window_, keep, text);
+  } else if (native_mode_ == NativeMode::kNormal && use_standard_frame_) {
+    SetWindowTitles(window_, text, keep);
   }
 }
 
