From dff0a88f5d0c966882820808a45f2ce31db3cb9a Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sun, 2 Aug 2026 09:16:46 -0500
Subject: [PATCH 483/638] AROS: scope memory dump managers per process

Native Chromium child processes share one address space but retain distinct process command-line identities. Keep one leaky MemoryDumpManager per native process so GPU and renderer startup cannot reinitialize the browser manager.



---
 base/trace_event/memory_dump_manager.cc | 33 +++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/base/trace_event/memory_dump_manager.cc b/base/trace_event/memory_dump_manager.cc
index ddff608985..8e014ea6bf 100644
--- a/base/trace_event/memory_dump_manager.cc
+++ b/base/trace_event/memory_dump_manager.cc
@@ -8,6 +8,7 @@
 #include <stdio.h>
 
 #include <algorithm>
+#include <map>
 #include <memory>
 #include <tuple>
 #include <utility>
@@ -18,6 +19,7 @@
 #include "base/debug/stack_trace.h"
 #include "base/logging.h"
 #include "base/memory/ptr_util.h"
+#include "base/no_destructor.h"
 #include "base/strings/string_util.h"
 #include "base/task/sequenced_task_runner.h"
 #include "base/task/single_thread_task_runner.h"
@@ -55,6 +57,30 @@ namespace {
 
 MemoryDumpManager* g_memory_dump_manager_for_testing = nullptr;
 
+#if BUILDFLAG(IS_AROS)
+struct MemoryDumpManagerRegistry {
+  base::Lock lock;
+  std::map<const base::CommandLine*, MemoryDumpManager*> instances;
+};
+
+MemoryDumpManager*& GetMemoryDumpManagerForCurrentProcess() {
+  const base::CommandLine* const process_identity =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? base::CommandLine::ForCurrentProcess()
+          : nullptr;
+  thread_local const base::CommandLine* cached_identity = nullptr;
+  thread_local MemoryDumpManager** cached_instance = nullptr;
+  if (cached_instance && cached_identity == process_identity)
+    return *cached_instance;
+
+  static base::NoDestructor<MemoryDumpManagerRegistry> registry;
+  base::AutoLock lock(registry->lock);
+  cached_identity = process_identity;
+  cached_instance = &registry->instances[process_identity];
+  return *cached_instance;
+}
+#endif
+
 // Temporary (until scheduler is moved outside of here)
 // trampoline function to match the |request_dump_function| passed to Initialize
 // to the callback expected by MemoryDumpScheduler.
@@ -90,8 +116,15 @@ MemoryDumpManager* MemoryDumpManager::GetInstance() {
   if (g_memory_dump_manager_for_testing)
     return g_memory_dump_manager_for_testing;
 
+#if BUILDFLAG(IS_AROS)
+  MemoryDumpManager*& instance = GetMemoryDumpManagerForCurrentProcess();
+  if (!instance)
+    instance = new MemoryDumpManager();
+  return instance;
+#else
   return Singleton<MemoryDumpManager,
                    LeakySingletonTraits<MemoryDumpManager>>::get();
+#endif
 }
 
 // static
