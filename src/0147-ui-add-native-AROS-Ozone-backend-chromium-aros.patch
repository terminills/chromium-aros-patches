+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/aros_screen.h"
+
+#include "base/logging.h"
+#include "ui/display/display.h"
+
+#include <intuition/intuition.h>
+#include <proto/intuition.h>
+
+namespace ui {
+
+namespace {
+
+constexpr int64_t kArosDisplayId = 1;
+constexpr int kFallbackWidth = 1024;
+constexpr int kFallbackHeight = 768;
+
+gfx::Rect GetPrimaryScreenBounds() {
+  struct Screen* screen = LockPubScreen(nullptr);
+  if (!screen) {
+    return gfx::Rect(0, 0, kFallbackWidth, kFallbackHeight);
+  }
+  const gfx::Rect bounds(0, 0, screen->Width, screen->Height);
+  UnlockPubScreen(nullptr, screen);
+  return bounds;
+}
+
+}  // namespace
+
+ArosScreen::ArosScreen() {
+  display::Display display(kArosDisplayId);
+  display.SetScaleAndBounds(1.0f, GetPrimaryScreenBounds());
+  display_list_.AddDisplay(display, display::DisplayList::Type::PRIMARY);
+  LOG(INFO) << "[Chromium:Ozone:AROS] primary display="
+            << display.bounds().ToString();
+}
+
+ArosScreen::~ArosScreen() = default;
+
+const std::vector<display::Display>& ArosScreen::GetAllDisplays() const {
+  return display_list_.displays();
+}
+
+display::Display ArosScreen::GetPrimaryDisplay() const {
+  const auto it = display_list_.GetPrimaryDisplayIterator();
+  DCHECK(it != display_list_.displays().end());
+  return *it;
+}
+
+display::Display ArosScreen::GetDisplayForAcceleratedWidget(
+    gfx::AcceleratedWidget widget) const {
+  return GetPrimaryDisplay();
+}
+
+gfx::Point ArosScreen::GetCursorScreenPoint() const {
+  struct Screen* screen = LockPubScreen(nullptr);
+  if (!screen) {
+    return gfx::Point();
+  }
+  const gfx::Point point(screen->MouseX, screen->MouseY);
+  UnlockPubScreen(nullptr, screen);
+  return point;
+}
+
+gfx::AcceleratedWidget ArosScreen::GetAcceleratedWidgetAtScreenPoint(
+    const gfx::Point& point) const {
+  return gfx::kNullAcceleratedWidget;
+}
+
+display::Display ArosScreen::GetDisplayNearestPoint(
+    const gfx::Point& point) const {
+  return GetPrimaryDisplay();
+}
+
+display::Display ArosScreen::GetDisplayMatching(
+    const gfx::Rect& match_rect) const {
+  return GetPrimaryDisplay();
+}
+
+void ArosScreen::AddObserver(display::DisplayObserver* observer) {
+  display_list_.AddObserver(observer);
+}
+
+void ArosScreen::RemoveObserver(display::DisplayObserver* observer) {
+  display_list_.RemoveObserver(observer);
+}
+
+}  // namespace ui
