diff --git a/ui/ozone/platform/aros/aros_window.cc b/ui/ozone/platform/aros/aros_window.cc
new file mode 100644
index 0000000000..122fed651f
--- /dev/null
+++ b/ui/ozone/platform/aros/aros_window.cc
@@ -0,0 +1,384 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/aros_window.h"
+
+#include <algorithm>
+#include <limits>
+
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "ui/base/cursor/platform_cursor.h"
+#include "ui/display/types/display_constants.h"
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+
+#include <cybergraphx/cybergraphics.h>
+#include <intuition/intuition.h>
+#include <proto/cybergraphics.h>
+#include <proto/exec.h>
+#include <proto/graphics.h>
+#include <proto/intuition.h>
+
+namespace ui {
+
+namespace {
+
+constexpr int kDefaultWindowWidth = 1024;
+constexpr int kDefaultWindowHeight = 720;
+constexpr ULONG kWindowEventMask = IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE |
+                                   IDCMP_CHANGEWINDOW | IDCMP_REFRESHWINDOW |
+                                   IDCMP_ACTIVEWINDOW | IDCMP_INACTIVEWINDOW;
+
+int PositiveOrDefault(int value, int fallback) {
+  return value > 0 ? value : fallback;
+}
+
+}  // namespace
+
+ArosWindow::ArosWindow(PlatformWindowDelegate* delegate,
+                       ArosWindowManager* manager,
+                       const gfx::Rect& requested_bounds)
+    : delegate_(delegate), manager_(manager), bounds_(requested_bounds) {
+  bounds_.set_width(PositiveOrDefault(bounds_.width(), kDefaultWindowWidth));
+  bounds_.set_height(PositiveOrDefault(bounds_.height(), kDefaultWindowHeight));
+
+  widget_ = manager_->AddWindow(this);
+  window_ = OpenWindowTags(
+      nullptr, WA_Title, reinterpret_cast<IPTR>("Chromium"), WA_Left,
+      bounds_.x(), WA_Top, bounds_.y(), WA_InnerWidth, bounds_.width(),
+      WA_InnerHeight, bounds_.height(), WA_CloseGadget, TRUE, WA_DepthGadget,
+      TRUE, WA_DragBar, TRUE, WA_SizeGadget, TRUE, WA_SizeBBottom, TRUE,
+      WA_Activate, FALSE, WA_Hidden, TRUE, WA_AutoAdjust, TRUE, WA_SmartRefresh,
+      TRUE, TAG_DONE);
+
+  if (!window_) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS] OpenWindowTags failed widget="
+               << widget_ << " requested=" << bounds_.ToString();
+  } else {
+    window_->UserPort = manager_->event_port();
+    native_events_enabled_ = ModifyIDCMP(window_, kWindowEventMask);
+    if (!native_events_enabled_) {
+      window_->UserPort = nullptr;
+      CloseWindow(window_);
+      window_ = nullptr;
+      LOG(ERROR) << "[Chromium:Ozone:AROS] could not enable IDCMP widget="
+                 << widget_;
+    }
+  }
+
+  if (window_) {
+    manager_->AttachNativeWindow(widget_, this, window_);
+    UpdateBoundsFromNative();
+    LOG(INFO) << "[Chromium:Ozone:AROS] opened Intuition window widget="
+              << widget_ << " native=" << window_
+              << " client=" << bounds_.ToString();
+  }
+
+  delegate_->OnAcceleratedWidgetAvailable(widget_);
+}
+
+ArosWindow::~ArosWindow() {
+  shutting_down_ = true;
+  if (window_) {
+    DisableNativeEvents();
+    manager_->DetachNativeWindow(widget_, this, window_);
+    CloseWindow(window_);
+    window_ = nullptr;
+  }
+  manager_->RemoveWindow(widget_, this);
+}
+
+void ArosWindow::Show(bool inactive) {
+  if (window_) {
+    ShowWindow(window_, nullptr);
+    if (!inactive) {
+      ActivateWindow(window_);
+    }
+  }
+  visible_ = true;
+}
+
+void ArosWindow::Hide() {
+  if (window_) {
+    HideWindow(window_);
+  }
+  visible_ = false;
+}
+
+void ArosWindow::Close() {
+  delegate_->OnClosed();
+}
+
+bool ArosWindow::IsVisible() const {
+  return visible_;
+}
+
+void ArosWindow::PrepareForShutdown() {
+  shutting_down_ = true;
+  DisableNativeEvents();
+}
+
+void ArosWindow::SetBoundsInPixels(const gfx::Rect& bounds) {
+  bounds_ = bounds;
+  bounds_.set_width(PositiveOrDefault(bounds_.width(), 1));
+  bounds_.set_height(PositiveOrDefault(bounds_.height(), 1));
+  if (window_) {
+    const int outer_width =
+        bounds_.width() + window_->BorderLeft + window_->BorderRight;
+    const int outer_height =
+        bounds_.height() + window_->BorderTop + window_->BorderBottom;
+    ChangeWindowBox(window_, bounds_.x(), bounds_.y(), outer_width,
+                    outer_height);
+  }
+  delegate_->OnBoundsChanged({true});
+}
+
+gfx::Rect ArosWindow::GetBoundsInPixels() const {
+  return bounds_;
+}
+
+void ArosWindow::SetBoundsInDIP(const gfx::Rect& bounds) {
+  SetBoundsInPixels(delegate_->ConvertRectToPixels(bounds));
+}
+
+gfx::Rect ArosWindow::GetBoundsInDIP() const {
+  return delegate_->ConvertRectToDIP(bounds_);
+}
+
+void ArosWindow::SetTitle(const std::u16string& title) {
+  title_ = base::UTF16ToUTF8(title);
+  if (window_) {
+    SetWindowTitles(window_, const_cast<char*>(title_.c_str()),
+                    reinterpret_cast<char*>(~uintptr_t{0}));
+  }
+}
+
+void ArosWindow::SetCapture() {
+  capture_ = true;
+}
+
+void ArosWindow::ReleaseCapture() {
+  if (capture_) {
+    capture_ = false;
+    delegate_->OnLostCapture();
+  }
+}
+
+void ArosWindow::SetFullscreen(bool fullscreen, int64_t target_display_id) {
+  DCHECK_EQ(target_display_id, display::kInvalidDisplayId);
+  if (fullscreen) {
+    if (!restored_bounds_) {
+      restored_bounds_ = bounds_;
+    }
+    SetBoundsInPixels(PrimaryScreenBounds());
+    UpdateWindowState(PlatformWindowState::kFullScreen);
+  } else if (window_state_ == PlatformWindowState::kFullScreen) {
+    Restore();
+  }
+}
+
+bool ArosWindow::HasCapture() const {
+  return capture_;
+}
+
+void ArosWindow::Maximize() {
+  if (!restored_bounds_) {
+    restored_bounds_ = bounds_;
+  }
+  SetBoundsInPixels(PrimaryScreenBounds());
+  UpdateWindowState(PlatformWindowState::kMaximized);
+}
+
+void ArosWindow::Minimize() {
+  Hide();
+  UpdateWindowState(PlatformWindowState::kMinimized);
+}
+
+void ArosWindow::Restore() {
+  if (restored_bounds_) {
+    const gfx::Rect restored = *restored_bounds_;
+    restored_bounds_.reset();
+    SetBoundsInPixels(restored);
+  }
+  Show(false);
+  UpdateWindowState(PlatformWindowState::kNormal);
+}
+
+PlatformWindowState ArosWindow::GetPlatformWindowState() const {
+  return window_state_;
+}
+
+void ArosWindow::Activate() {
+  if (window_) {
+    ActivateWindow(window_);
+  }
+  if (!active_) {
+    active_ = true;
+    delegate_->OnActivationChanged(true);
+  }
+}
+
+void ArosWindow::Deactivate() {
+  if (active_) {
+    active_ = false;
+    delegate_->OnActivationChanged(false);
+  }
+}
+
+void ArosWindow::SetUseNativeFrame(bool use_native_frame) {}
+
+bool ArosWindow::ShouldUseNativeFrame() const {
+  return true;
+}
+
+void ArosWindow::SetCursor(scoped_refptr<PlatformCursor> cursor) {}
+
+void ArosWindow::MoveCursorTo(const gfx::Point& location) {}
+
+void ArosWindow::ConfineCursorToBounds(const gfx::Rect& bounds) {}
+
+void ArosWindow::SetRestoredBoundsInDIP(const gfx::Rect& bounds) {
+  restored_bounds_ = delegate_->ConvertRectToPixels(bounds);
+}
+
+gfx::Rect ArosWindow::GetRestoredBoundsInDIP() const {
+  return delegate_->ConvertRectToDIP(restored_bounds_.value_or(bounds_));
+}
+
+void ArosWindow::SetWindowIcons(const gfx::ImageSkia& window_icon,
+                                const gfx::ImageSkia& app_icon) {}
+
+void ArosWindow::SizeConstraintsChanged() {}
+
+void ArosWindow::HandleNativeEvent(uint32_t message_class,
+                                   uint16_t code,
+                                   uint16_t qualifier,
+                                   int16_t mouse_x,
+                                   int16_t mouse_y) {
+  if (shutting_down_) {
+    return;
+  }
+
+  switch (message_class) {
+    case IDCMP_CLOSEWINDOW:
+      delegate_->OnCloseRequest();
+      break;
+    case IDCMP_NEWSIZE:
+    case IDCMP_CHANGEWINDOW:
+      UpdateBoundsFromNative();
+      break;
+    case IDCMP_REFRESHWINDOW:
+      if (window_) {
+        BeginRefresh(window_);
+      }
+      delegate_->OnDamageRect(gfx::Rect(bounds_.size()));
+      if (window_) {
+        EndRefresh(window_, TRUE);
+      }
+      break;
+    case IDCMP_ACTIVEWINDOW:
+      if (!active_) {
+        active_ = true;
+        delegate_->OnActivationChanged(true);
+      }
+      break;
+    case IDCMP_INACTIVEWINDOW:
+      if (active_) {
+        active_ = false;
+        delegate_->OnActivationChanged(false);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+bool ArosWindow::PresentPixels(const void* pixels,
+                               size_t row_bytes,
+                               const gfx::Size& pixel_size,
+                               const gfx::Rect& damage) {
+  if (!window_ || !window_->RPort || !pixels || row_bytes == 0) {
+    return false;
+  }
+
+  const int client_width =
+      window_->Width - window_->BorderLeft - window_->BorderRight;
+  const int client_height =
+      window_->Height - window_->BorderTop - window_->BorderBottom;
+  gfx::Rect clipped = damage;
+  clipped.Intersect(gfx::Rect(pixel_size));
+  clipped.Intersect(gfx::Rect(client_width, client_height));
+  if (clipped.IsEmpty()) {
+    return true;
+  }
+
+  SetDrMd(window_->RPort, JAM1);
+  const LONG written = WritePixelArray(
+      const_cast<void*>(pixels), clipped.x(), clipped.y(), row_bytes,
+      window_->RPort, window_->BorderLeft + clipped.x(),
+      window_->BorderTop + clipped.y(), clipped.width(), clipped.height(),
+      RECTFMT_BGRA32);
+  if (written <= 0) {
+    LOG(ERROR) << "[Chromium:Ozone:AROS] WritePixelArray failed widget="
+               << widget_ << " damage=" << clipped.ToString();
+    return false;
+  }
+  return true;
+}
+
+void ArosWindow::UpdateBoundsFromNative() {
+  if (!window_) {
+    return;
+  }
+  const gfx::Rect new_bounds(
+      window_->LeftEdge, window_->TopEdge,
+      std::max<int>(
+          1, window_->Width - window_->BorderLeft - window_->BorderRight),
+      std::max<int>(
+          1, window_->Height - window_->BorderTop - window_->BorderBottom));
+  const bool origin_changed = new_bounds.origin() != bounds_.origin();
+  if (new_bounds != bounds_) {
+    bounds_ = new_bounds;
+    delegate_->OnBoundsChanged({origin_changed});
+  }
+}
+
+void ArosWindow::UpdateWindowState(PlatformWindowState state) {
+  if (state == window_state_) {
+    return;
+  }
+  const PlatformWindowState old_state = window_state_;
+  window_state_ = state;
+  delegate_->OnWindowStateChanged(old_state, state);
+}
+
+void ArosWindow::DisableNativeEvents() {
+  if (!window_ || !native_events_enabled_) {
+    return;
+  }
+
+  // This is a shared application port. Detach it before clearing IDCMP so
+  // ModifyIDCMP()/CloseWindow() cannot take ownership and delete it.
+  Forbid();
+  window_->UserPort = nullptr;
+  ModifyIDCMP(window_, 0);
+  Permit();
+  native_events_enabled_ = false;
+
+  // Messages queued before the detach still reference this window. Drain and
+  // reply them while the native-window mapping remains valid.
+  manager_->ProcessNativeEvents();
+}
+
+gfx::Rect ArosWindow::PrimaryScreenBounds() const {
+  struct Screen* screen = LockPubScreen(nullptr);
+  if (!screen) {
+    return gfx::Rect(0, 0, kDefaultWindowWidth, kDefaultWindowHeight);
+  }
+  const gfx::Rect bounds(0, 0, screen->Width, screen->Height);
+  UnlockPubScreen(nullptr, screen);
+  return bounds;
+}
+
+}  // namespace ui
