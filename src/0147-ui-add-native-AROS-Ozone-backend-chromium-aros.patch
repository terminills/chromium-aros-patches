+namespace {
+
+// The first-window slice keeps IDCMP consumption local to Ozone. A subsequent
+// commit will register the port signal directly with MessagePumpAROS.
+class ArosPlatformEventSource : public PlatformEventSource {
+ public:
+  explicit ArosPlatformEventSource(ArosWindowManager* window_manager)
+      : window_manager_(window_manager) {
+    timer_.Start(FROM_HERE, base::Milliseconds(8), this,
+                 &ArosPlatformEventSource::ProcessEvents);
+  }
+
+  ArosPlatformEventSource(const ArosPlatformEventSource&) = delete;
+  ArosPlatformEventSource& operator=(const ArosPlatformEventSource&) = delete;
+
+  ~ArosPlatformEventSource() override = default;
+
+ private:
+  void ProcessEvents() { window_manager_->ProcessNativeEvents(); }
+
+  raw_ptr<ArosWindowManager> window_manager_;
+  base::RepeatingTimer timer_;
+};
+
+class OzonePlatformAros : public OzonePlatform {
+ public:
+  OzonePlatformAros() = default;
+
+  OzonePlatformAros(const OzonePlatformAros&) = delete;
+  OzonePlatformAros& operator=(const OzonePlatformAros&) = delete;
+
+  ~OzonePlatformAros() override = default;
+
+  SurfaceFactoryOzone* GetSurfaceFactoryOzone() override {
+    return surface_factory_.get();
+  }
+
+  OverlayManagerOzone* GetOverlayManager() override {
+    return overlay_manager_.get();
+  }
+
+  CursorFactory* GetCursorFactory() override { return cursor_factory_.get(); }
+
+  InputController* GetInputController() override {
+    return input_controller_.get();
+  }
+
+  GpuPlatformSupportHost* GetGpuPlatformSupportHost() override {
+    return gpu_platform_support_host_.get();
+  }
+
+  std::unique_ptr<SystemInputInjector> CreateSystemInputInjector() override {
+    return nullptr;
+  }
+
+  std::unique_ptr<PlatformWindow> CreatePlatformWindow(
+      PlatformWindowDelegate* delegate,
+      PlatformWindowInitProperties properties) override {
+    CHECK(window_manager_);
+    return std::make_unique<ArosWindow>(delegate, window_manager_.get(),
+                                        properties.bounds);
+  }
+
+  bool IsWindowCompositingSupported() const override { return false; }
+
+  std::unique_ptr<display::NativeDisplayDelegate> CreateNativeDisplayDelegate()
+      override {
+    return nullptr;
+  }
+
+  std::unique_ptr<PlatformScreen> CreateScreen() override {
+    return std::make_unique<ArosScreen>();
+  }
+
+  void InitScreen(PlatformScreen* screen) override {}
+
+  std::unique_ptr<InputMethod> CreateInputMethod(
+      ImeKeyEventDispatcher* ime_key_event_dispatcher,
+      gfx::AcceleratedWidget widget) override {
+    return std::make_unique<InputMethodMinimal>(ime_key_event_dispatcher);
+  }
+
+  bool InitializeUI(const InitParams& params) override {
+    LOG(INFO) << "[Chromium:Ozone:AROS] initializing native Intuition backend";
+    window_manager_ = std::make_unique<ArosWindowManager>();
+    surface_factory_ =
+        std::make_unique<ArosSurfaceFactory>(window_manager_.get());
+    if (!PlatformEventSource::GetInstance()) {
+      platform_event_source_ =
+          std::make_unique<ArosPlatformEventSource>(window_manager_.get());
+    }
+
+    keyboard_layout_engine_ = std::make_unique<StubKeyboardLayoutEngine>();
+    KeyboardLayoutEngineManager::SetKeyboardLayoutEngine(
+        keyboard_layout_engine_.get());
+    overlay_manager_ = std::make_unique<StubOverlayManager>();
+    input_controller_ = CreateStubInputController();
+    cursor_factory_ = std::make_unique<BitmapCursorFactory>();
+    gpu_platform_support_host_.reset(CreateStubGpuPlatformSupportHost());
+    return true;
+  }
+
+  void InitializeGPU(const InitParams& params) override {
+    if (!window_manager_) {
+      window_manager_ = std::make_unique<ArosWindowManager>();
+    }
+    if (!surface_factory_) {
+      surface_factory_ =
+          std::make_unique<ArosSurfaceFactory>(window_manager_.get());
+    }
+  }
+
+ private:
+  std::unique_ptr<ArosWindowManager> window_manager_;
+  std::unique_ptr<ArosSurfaceFactory> surface_factory_;
+  std::unique_ptr<PlatformEventSource> platform_event_source_;
+  std::unique_ptr<KeyboardLayoutEngine> keyboard_layout_engine_;
+  std::unique_ptr<CursorFactory> cursor_factory_;
+  std::unique_ptr<InputController> input_controller_;
+  std::unique_ptr<GpuPlatformSupportHost> gpu_platform_support_host_;
+  std::unique_ptr<OverlayManagerOzone> overlay_manager_;
+};
+
+}  // namespace
+
+OzonePlatform* CreateOzonePlatformAros() {
+  return new OzonePlatformAros();
+}
