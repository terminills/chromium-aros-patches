@@ -0,0 +1,116 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "ui/ozone/platform/aros/aros_window.h"
+
+#include <exec/ports.h>
+#include <intuition/intuition.h>
+#include <proto/exec.h>
+
+#undef Remove
+
+namespace ui {
+
+ArosWindowManager::ArosWindowManager() {
+  event_port_ = CreateMsgPort();
+  CHECK(event_port_);
+  LOG(INFO) << "[Chromium:Ozone:AROS] shared IDCMP port=" << event_port_
+            << " signal=" << static_cast<int>(event_port_->mp_SigBit);
+}
+
+ArosWindowManager::~ArosWindowManager() {
+  {
+    base::AutoLock lock(lock_);
+    DCHECK(native_windows_.empty());
+    DCHECK(windows_.IsEmpty());
+  }
+  if (event_port_) {
+    DeleteMsgPort(event_port_);
+  }
+}
+
+gfx::AcceleratedWidget ArosWindowManager::AddWindow(ArosWindow* window) {
+  base::AutoLock lock(lock_);
+  return windows_.Add(window);
+}
+
+void ArosWindowManager::RemoveWindow(gfx::AcceleratedWidget widget,
+                                     ArosWindow* window) {
+  base::AutoLock lock(lock_);
+  DCHECK_EQ(window, windows_.Lookup(widget));
+  windows_.Remove(widget);
+}
+
+void ArosWindowManager::AttachNativeWindow(gfx::AcceleratedWidget widget,
+                                           ArosWindow* window,
+                                           struct Window* native_window) {
+  base::AutoLock lock(lock_);
+  DCHECK_EQ(window, windows_.Lookup(widget));
+  DCHECK(native_window);
+  const bool inserted = native_windows_.emplace(native_window, window).second;
+  DCHECK(inserted);
+}
+
+void ArosWindowManager::DetachNativeWindow(gfx::AcceleratedWidget widget,
+                                           ArosWindow* window,
+                                           struct Window* native_window) {
+  base::AutoLock lock(lock_);
+  DCHECK_EQ(window, windows_.Lookup(widget));
+  auto it = native_windows_.find(native_window);
+  DCHECK(it != native_windows_.end());
+  DCHECK_EQ(window, it->second);
+  native_windows_.erase(it);
+}
+
+uint32_t ArosWindowManager::event_signal_mask() const {
+  return event_port_ ? uint32_t{1} << event_port_->mp_SigBit : 0;
+}
+
+void ArosWindowManager::ProcessNativeEvents() {
+  if (!event_port_) {
+    return;
+  }
+
+  while (auto* message = reinterpret_cast<IntuiMessage*>(GetMsg(event_port_))) {
+    struct Window* const native_window = message->IDCMPWindow;
+    const uint32_t message_class = message->Class;
+    const uint16_t code = message->Code;
+    const uint16_t qualifier = message->Qualifier;
+    const int16_t mouse_x = message->MouseX;
+    const int16_t mouse_y = message->MouseY;
+
+    ArosWindow* target = nullptr;
+    {
+      base::AutoLock lock(lock_);
+      const auto it = native_windows_.find(native_window);
+      if (it != native_windows_.end()) {
+        target = it->second;
+      }
+    }
+
+    ReplyMsg(reinterpret_cast<Message*>(message));
+    if (target) {
+      target->HandleNativeEvent(message_class, code, qualifier, mouse_x,
+                                mouse_y);
+    }
+  }
+}
+
+bool ArosWindowManager::PresentCanvas(gfx::AcceleratedWidget widget,
+                                      const void* pixels,
+                                      size_t row_bytes,
+                                      const gfx::Size& pixel_size,
+                                      const gfx::Rect& damage) {
+  base::AutoLock lock(lock_);
+  ArosWindow* const window = windows_.Lookup(widget);
+  return window && window->PresentPixels(pixels, row_bytes, pixel_size, damage);
+}
+
+}  // namespace ui
