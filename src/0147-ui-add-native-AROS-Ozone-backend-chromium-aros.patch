+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/aros/aros_surface_factory.h"
+
+#include <memory>
+
+#include "base/logging.h"
+#include "skia/ext/legacy_display_globals.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+#include "third_party/skia/include/core/SkPixmap.h"
+#include "third_party/skia/include/core/SkSurface.h"
+#include "third_party/skia/include/core/SkSurfaceProps.h"
+#include "ui/gfx/vsync_provider.h"
+#include "ui/ozone/platform/aros/aros_window_manager.h"
+#include "ui/ozone/public/surface_ozone_canvas.h"
+
+namespace ui {
+
+namespace {
+
+class ArosCanvasSurface : public SurfaceOzoneCanvas {
+ public:
+  ArosCanvasSurface(ArosWindowManager* window_manager,
+                    gfx::AcceleratedWidget widget)
+      : window_manager_(window_manager), widget_(widget) {}
+
+  ~ArosCanvasSurface() override = default;
+
+  void ResizeCanvas(const gfx::Size& viewport_size, float scale) override {
+    size_ = viewport_size;
+    const SkImageInfo info =
+        SkImageInfo::Make(viewport_size.width(), viewport_size.height(),
+                          kBGRA_8888_SkColorType, kPremul_SkAlphaType);
+    const SkSurfaceProps props =
+        skia::LegacyDisplayGlobals::GetSkSurfaceProps();
+    surface_ = SkSurfaces::Raster(info, &props);
+    LOG(INFO) << "[Chromium:Ozone:AROS] resized software canvas widget="
+              << widget_ << " size=" << viewport_size.ToString()
+              << " scale=" << scale;
+  }
+
+  SkCanvas* GetCanvas() override {
+    return surface_ ? surface_->getCanvas() : nullptr;
+  }
+
+  void PresentCanvas(const gfx::Rect& damage) override {
+    if (!surface_) {
+      return;
+    }
+    SkPixmap pixels;
+    if (!surface_->peekPixels(&pixels)) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS] cannot access raster canvas widget="
+                 << widget_;
+      return;
+    }
+    if (!window_manager_->PresentCanvas(widget_, pixels.addr(),
+                                        pixels.rowBytes(), size_, damage)) {
+      LOG(ERROR) << "[Chromium:Ozone:AROS] present failed widget=" << widget_
+                 << " damage=" << damage.ToString();
+    }
+  }
+
+  std::unique_ptr<gfx::VSyncProvider> CreateVSyncProvider() override {
+    return nullptr;
+  }
+
+ private:
+  raw_ptr<ArosWindowManager> window_manager_;
+  const gfx::AcceleratedWidget widget_;
+  gfx::Size size_;
+  sk_sp<SkSurface> surface_;
+};
+
+}  // namespace
+
+ArosSurfaceFactory::ArosSurfaceFactory(ArosWindowManager* window_manager)
+    : window_manager_(window_manager) {}
+
+ArosSurfaceFactory::~ArosSurfaceFactory() = default;
+
+std::vector<gl::GLImplementationParts>
+ArosSurfaceFactory::GetAllowedGLImplementations() {
+  return {};
+}
+
+std::unique_ptr<SurfaceOzoneCanvas> ArosSurfaceFactory::CreateCanvasForWidget(
+    gfx::AcceleratedWidget widget) {
+  return std::make_unique<ArosCanvasSurface>(window_manager_, widget);
+}
+
+}  // namespace ui
