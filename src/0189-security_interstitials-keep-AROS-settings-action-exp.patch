From 91648af13b894c4aa20603a529460279b11f1379 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Tue, 14 Jul 2026 00:08:33 -0500
Subject: [PATCH 189/638] security_interstitials: keep AROS settings action
 explicit [chromium] [aros]

Statement:
The portable security interstitial compiled a hard unsupported-platform error for its optional date/time settings launcher.

Decision:
Retain interstitial behavior and route only the unavailable native settings action through Chromium's one-time NOTIMPLEMENTED path on AROS.

Evidence:
obj/components/security_interstitials/content/security_interstitial_page/utils.o builds in out/aros-chrome.

Chain:
Advances without inventing an unstable AROS Prefs command ABI.
---
 components/security_interstitials/content/utils.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/components/security_interstitials/content/utils.cc b/components/security_interstitials/content/utils.cc
index f7a8cf70f6..10de84db2b 100644
--- a/components/security_interstitials/content/utils.cc
+++ b/components/security_interstitials/content/utils.cc
@@ -93,7 +93,7 @@ void LaunchDateAndTimeSettings() {
   options.wait = false;
   base::LaunchProcess(command, options);
 
-#elif BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_IOS)
+#elif BUILDFLAG(IS_FUCHSIA) || BUILDFLAG(IS_IOS) || BUILDFLAG(IS_AROS)
   // TODO(crbug.com/1233494): Send to the platform settings.
   // The iOS Blink port also need to send the platform settings.
   NOTIMPLEMENTED_LOG_ONCE();
