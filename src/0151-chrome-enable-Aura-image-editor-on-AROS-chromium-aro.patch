From 0a0361dde978c7f9a0f3fe8044a8bc6767549e97 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 13 Jul 2026 19:47:52 -0500
Subject: [PATCH 151/638] chrome: enable Aura image editor on AROS [chromium]
 [aros]

AI_PHASE: chromium-phase-4-chrome
AI_STATUS: checkpoint
AI_ROOT_CAUSE: The portable Aura/Views image-editor target used a closed desktop OS assertion that predated the AROS Ozone backend.
AI_FIX_REASON: AROS now supplies Aura, Views, compositor layers, cursor types, and snapshot APIs used by the non-Mac implementation.
AI_SCOPE: chrome/browser/image_editor/BUILD.gn
AI_VALIDATION: //chrome:chrome GN generation advances beyond image_editor to the independent extensions-disabled WebApp dependency assertion.
AI_RISK: Interactive capture depends on forthcoming native mouse event dispatch; compiling the existing component does not claim that interaction is complete.
AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap -> AROS Ozone/Views classification -> upstream Chrome desktop component graph
---
 chrome/browser/image_editor/BUILD.gn | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/browser/image_editor/BUILD.gn b/chrome/browser/image_editor/BUILD.gn
index 3acbdae3dd..5274c84773 100644
--- a/chrome/browser/image_editor/BUILD.gn
+++ b/chrome/browser/image_editor/BUILD.gn
@@ -3,7 +3,7 @@
 # found in the LICENSE file.
 import("//build/config/ui.gni")
 
-assert(is_chromeos || is_linux || is_mac || is_win || is_fuchsia,
+assert(is_chromeos || is_linux || is_mac || is_win || is_fuchsia || is_aros,
        "Image Editor is for desktop plaforms only")
 
 static_library("image_editor_component_util") {
