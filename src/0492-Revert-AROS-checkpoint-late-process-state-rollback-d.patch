diff --git a/base/at_exit.cc b/base/at_exit.cc
index 00fb35798b..bd51cb5118 100644
--- a/base/at_exit.cc
+++ b/base/at_exit.cc
@@ -48,26 +48,41 @@ AtExitProcessRegistry& GetAtExitProcessRegistry() {
   return *registry;
 }
 
-struct Task* GetCurrentProcessTask() {
-  struct Task* task = FindTask(nullptr);
-  struct Task* const current = task;
+AtExitProcessState& GetCurrentTaskState() {
+  auto& registry = GetAtExitProcessRegistry();
+  AutoLock lock(registry.lock);
+  return registry.states[FindTask(nullptr)];
+}
 
+AtExitProcessState& GetCurrentProcessState() {
+  auto& registry = GetAtExitProcessRegistry();
+  AutoLock lock(registry.lock);
+  struct Task* const current = FindTask(nullptr);
+  struct Task* task = current;
+
+  // Native child processes and pthread workers do not all expose an
+  // NT_PROCESS node at the same point in their ETask ancestry.  Bind a new
+  // manager to the task that creates it, then let descendants find the first
+  // already-registered owner.  This is the same ownership rule used by the
+  // AROS CommandLine registry and keeps in-process renderer workers attached
+  // to the browser process's AtExitManager.
   for (size_t depth = 0; task && depth < 64; ++depth) {
-    if (task->tc_Node.ln_Type == NT_PROCESS) {
-      return task;
+    const auto it = registry.states.find(task);
+    if (it != registry.states.end()) {
+      return it->second;
     }
 
     struct ETask* etask = GetETask(task);
     task = etask ? static_cast<struct Task*>(etask->et_Parent) : nullptr;
   }
 
-  return current;
+  return registry.states[current];
 }
 
-AtExitProcessState& GetCurrentProcessState() {
-  auto& registry = GetAtExitProcessRegistry();
-  AutoLock lock(registry.lock);
-  return registry.states[GetCurrentProcessTask()];
+AtExitManager*& GetTopManagerForNewManager() {
+  // Constructing an AtExitManager defines a new native-process owner.  Do not
+  // inherit an ancestor's manager here: only descendant lookups inherit.
+  return GetCurrentTaskState().top_manager;
 }
 
 AtExitManager*& GetTopManager() {
@@ -98,12 +113,16 @@ bool& GetDisableManagers() {
   return g_disable_managers;
 }
 
+AtExitManager*& GetTopManagerForNewManager() {
+  return GetTopManager();
+}
+
 #endif
 
 }  // namespace
 
-AtExitManager::AtExitManager() : next_manager_(GetTopManager()) {
-  AtExitManager*& top_manager = GetTopManager();
+AtExitManager::AtExitManager() : next_manager_(GetTopManagerForNewManager()) {
+  AtExitManager*& top_manager = GetTopManagerForNewManager();
 // If multiple modules instantiate AtExitManagers they'll end up living in this
 // module... they have to coexist.
 #if !defined(COMPONENT_BUILD)
@@ -189,8 +208,9 @@ void AtExitManager::DisableAllAtExitManagers() {
   GetDisableManagers() = true;
 }
 
-AtExitManager::AtExitManager(bool shadow) : next_manager_(GetTopManager()) {
-  AtExitManager*& top_manager = GetTopManager();
+AtExitManager::AtExitManager(bool shadow)
+    : next_manager_(GetTopManagerForNewManager()) {
+  AtExitManager*& top_manager = GetTopManagerForNewManager();
   DCHECK(shadow || !top_manager);
   top_manager = this;
 }
diff --git a/base/memory/discardable_memory_allocator.cc b/base/memory/discardable_memory_allocator.cc
index 9105ad03f7..1669bc1141 100644
--- a/base/memory/discardable_memory_allocator.cc
+++ b/base/memory/discardable_memory_allocator.cc
@@ -4,29 +4,71 @@
 
 #include "base/memory/discardable_memory_allocator.h"
 
+#include <map>
 #include <utility>
 
 #include "base/check.h"
+#include "base/command_line.h"
+#include "base/no_destructor.h"
 #include "base/process/memory.h"
+#include "base/synchronization/lock.h"
+#include "build/build_config.h"
 
 namespace base {
 namespace {
 
+#if BUILDFLAG(IS_AROS)
+struct DiscardableMemoryAllocatorRegistry {
+  base::Lock lock;
+  std::map<const base::CommandLine*, DiscardableMemoryAllocator*> instances;
+};
+
+DiscardableMemoryAllocator*& GetAllocatorForCurrentProcess() {
+  const base::CommandLine* const process_identity =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? base::CommandLine::ForCurrentProcess()
+          : nullptr;
+  thread_local const base::CommandLine* cached_identity = nullptr;
+  thread_local DiscardableMemoryAllocator** cached_instance = nullptr;
+  if (cached_instance && cached_identity == process_identity)
+    return *cached_instance;
+
+  static base::NoDestructor<DiscardableMemoryAllocatorRegistry> registry;
+  base::AutoLock lock(registry->lock);
+  cached_identity = process_identity;
+  cached_instance = &registry->instances[process_identity];
+  return *cached_instance;
+}
+#else
 DiscardableMemoryAllocator* g_discardable_allocator = nullptr;
+#endif
 
 }  // namespace
 
 // static
 void DiscardableMemoryAllocator::SetInstance(
     DiscardableMemoryAllocator* allocator) {
-  DCHECK(!allocator || !g_discardable_allocator);
-  g_discardable_allocator = allocator;
+#if BUILDFLAG(IS_AROS)
+  DiscardableMemoryAllocator*& current_allocator =
+      GetAllocatorForCurrentProcess();
+#else
+  DiscardableMemoryAllocator*& current_allocator = g_discardable_allocator;
+#endif
+  DCHECK(!allocator || !current_allocator);
+  current_allocator = allocator;
 }
 
 // static
 DiscardableMemoryAllocator* DiscardableMemoryAllocator::GetInstance() {
-  DCHECK(g_discardable_allocator);
-  return g_discardable_allocator;
+#if BUILDFLAG(IS_AROS)
+  DiscardableMemoryAllocator* const current_allocator =
+      GetAllocatorForCurrentProcess();
+#else
+  DiscardableMemoryAllocator* const current_allocator =
+      g_discardable_allocator;
+#endif
+  DCHECK(current_allocator);
+  return current_allocator;
 }
 
 std::unique_ptr<base::DiscardableMemory>
