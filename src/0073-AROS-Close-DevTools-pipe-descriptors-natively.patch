From 5f9455932a405c53e271d65138cf4999b4281d91 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 11 Jul 2026 16:07:03 -0500
Subject: [PATCH 073/638] [AROS] Close DevTools pipe descriptors natively

AI_PHASE: Phase 3 - single-process headless shell
AI_STATUS: DevTools remote-debugging pipe teardown compiles against AROS POSIX descriptors.
ROOT_CAUSE: The generic non-Windows path treated inherited DevTools pipe file descriptors as sockets and called shutdown(), which AROS correctly does not expose for POSIX file descriptors.
FIX_REASON: Include unistd and close the read/write descriptors on AROS, reserving socket shutdown for transports that implement that contract.
SCOPE: content/browser/devtools/devtools_pipe_handler.cc only.
VALIDATION: devtools_pipe_handler.o compiled; Ninja dependency database recompacted and repeat build reports no work.
RISK: Runtime cancellation still depends on AROS close() waking blocked pipe I/O and needs native DevTools-pipe validation.
AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
---
 content/browser/devtools/devtools_pipe_handler.cc | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/content/browser/devtools/devtools_pipe_handler.cc b/content/browser/devtools/devtools_pipe_handler.cc
index cba089bbd9..5caac06876 100644
--- a/content/browser/devtools/devtools_pipe_handler.cc
+++ b/content/browser/devtools/devtools_pipe_handler.cc
@@ -10,6 +10,8 @@
 #include <io.h>
 #include <stdlib.h>
 #include <windows.h>
+#elif BUILDFLAG(IS_AROS)
+#include <unistd.h>
 #else
 #include <sys/socket.h>
 #endif
@@ -155,6 +157,9 @@ class PipeReaderBase : public PipeIOBase {
     ScopedInvalidParameterHandlerOverride invalid_parameter_handler_override;
     _close(read_fd_);
     read_handle_ = INVALID_HANDLE_VALUE;
+#elif BUILDFLAG(IS_AROS)
+    close(read_fd_);
+    read_fd_ = -1;
 #else
     shutdown(read_fd_, SHUT_RDWR);
 #endif
@@ -238,6 +243,9 @@ class PipeWriterBase : public PipeIOBase {
     ScopedInvalidParameterHandlerOverride invalid_parameter_handler_override;
     _close(write_fd_);
     write_handle_ = INVALID_HANDLE_VALUE;
+#elif BUILDFLAG(IS_AROS)
+    close(write_fd_);
+    write_fd_ = -1;
 #else
     shutdown(write_fd_, SHUT_RDWR);
 #endif
