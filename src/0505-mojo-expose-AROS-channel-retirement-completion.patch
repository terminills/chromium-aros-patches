+
+bool ArosChannelRetirementObserver::IsRetired() const {
+  if (!state_)
+    return true;
+  auto* state = static_cast<ArosChannelState*>(state_);
+  Lock(state);
+  const bool retired =
+      state->side_references[0].load(std::memory_order_relaxed) == 0 &&
+      state->side_references[1].load(std::memory_order_relaxed) == 0 &&
+      !state->reader_active[0] && !state->reader_active[1] &&
+      !state->ports[0] && !state->ports[1];
+  Unlock(state);
+  return retired;
+}
