+// Keeps the native channel state observable after both endpoint handles have
+// begun teardown.  This does not retain either endpoint side and therefore
+// cannot keep a peer artificially alive.
+class COMPONENT_EXPORT(MOJO_CPP_PLATFORM) ArosChannelRetirementObserver {
+ public:
+  ArosChannelRetirementObserver();
+  ArosChannelRetirementObserver(ArosChannelRetirementObserver&& other);
+  ArosChannelRetirementObserver& operator=(
+      ArosChannelRetirementObserver&& other);
+  ~ArosChannelRetirementObserver();
+
+  ArosChannelRetirementObserver(const ArosChannelRetirementObserver&) = delete;
+  ArosChannelRetirementObserver& operator=(
+      const ArosChannelRetirementObserver&) = delete;
+
+  bool is_valid() const { return state_ != nullptr; }
+  bool IsRetired() const;
+
+ private:
+  explicit ArosChannelRetirementObserver(void* state);
+
+  void* state_ = nullptr;
+
+  friend ArosChannelRetirementObserver
+  CreateArosChannelRetirementObserver(ArosChannelHandle handle);
+};
