+++ b/content/browser/child_process_launcher.h
@@ -246,6 +246,12 @@ class CONTENT_EXPORT ChildProcessLauncher {
   // more discussion of Linux implementation details.
   ChildProcessTerminationInfo GetChildTerminationInfo(bool known_dead);
 
+#if BUILDFLAG(IS_AROS)
+  // True only after both native Mojo endpoints and their reader tasks have
