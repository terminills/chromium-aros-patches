+#include "net/base/ip_endpoint.h"
+#include "net/dns/dns_config.h"
+#include "net/dns/dns_hosts.h"
+
+namespace net::internal {
+
+DnsConfigServiceAros::DnsConfigServiceAros()
+    : DnsConfigService(base::FilePath::StringPieceType()) {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+DnsConfigServiceAros::~DnsConfigServiceAros() = default;
+
+void DnsConfigServiceAros::RefreshConfig() {
+  InvalidateConfig();
+  ReadConfigNow();
+}
+
+void DnsConfigServiceAros::ReadConfigNow() {
+  std::vector<std::string> configured_servers;
+  if (!base::aros::GetConfiguredNameServers(&configured_servers)) {
+    LOG(WARNING) << "Unable to read AROSTCP name servers";
+    return;
+  }
+
+  std::vector<IPEndPoint> name_servers;
+  name_servers.reserve(configured_servers.size());
+  for (const std::string& configured_server : configured_servers) {
+    IPAddress address;
+    if (!address.AssignFromIPLiteral(configured_server)) {
+      LOG(WARNING) << "Ignoring invalid AROSTCP name server: "
+                   << configured_server;
+      continue;
+    }
+    name_servers.emplace_back(address, 53);
+  }
+  if (name_servers.empty()) {
+    LOG(WARNING) << "AROSTCP reported no usable name servers";
+    return;
+  }
+
+  OnConfigRead(DnsConfig(std::move(name_servers)));
+}
+
+void DnsConfigServiceAros::ReadHostsNow() {
+  // AROSTCP owns its host database. Chromium's built-in DNS client starts
+  // with no file-backed overrides; the system resolver remains available for
+  // stack-managed host aliases.
+  OnHostsRead(DnsHosts());
+}
+
+bool DnsConfigServiceAros::StartWatching() {
+  // AROS has no resolv.conf-style file notification. NetworkChangeNotifier
+  // drives RefreshConfig() when interface configuration changes.
+  return true;
+}
+
+}  // namespace net::internal
+
+namespace net {
+
+std::unique_ptr<DnsConfigService> DnsConfigService::CreateSystemService() {
+  return std::make_unique<internal::DnsConfigServiceAros>();
+}
+
+}  // namespace net
