+#if BUILDFLAG(IS_AROS)
+namespace {
+
+content::WebContents* GetFirstArosLifecycleTestTab() {
+  Browser* browser = BrowserList::GetInstance()->GetLastActive();
+  if (!browser || browser->tab_strip_model()->empty()) {
+    return nullptr;
+  }
+  return browser->tab_strip_model()->GetWebContentsAt(0);
+}
+
+void LogArosLifecycleTestCheckpoint(int original_process_id,
+                                    int seconds_after_shutdown) {
+  content::WebContents* contents = GetFirstArosLifecycleTestTab();
+  if (!contents) {
+    LOG(ERROR) << "[Chromium:AROS:LifecycleTest] checkpoint missing tab at="
+               << seconds_after_shutdown << "s";
+    return;
+  }
+
+  content::RenderProcessHost* process =
+      contents->GetPrimaryMainFrame()->GetProcess();
+  LOG(ERROR) << "[Chromium:AROS:LifecycleTest] checkpoint at="
+             << seconds_after_shutdown
+             << "s original_renderer_host=" << original_process_id
+             << " current_renderer_host=" << process->GetID()
+             << " current_live=" << process->IsInitializedAndNotDead();
+}
+
+void RequestArosLifecycleTestRecovery(int original_process_id) {
+  content::WebContents* contents = GetFirstArosLifecycleTestTab();
+  if (!contents) {
+    LOG(ERROR) << "[Chromium:AROS:LifecycleTest] recovery missing tab";
+    return;
+  }
+
+  LOG(ERROR) << "[Chromium:AROS:LifecycleTest] recovery requested"
+             << " original_renderer_host=" << original_process_id;
+  contents->GetController().Reload(content::ReloadType::NORMAL, false);
+}
+
+void CloseFirstTabForArosLifecycleTest() {
+  content::WebContents* contents = GetFirstArosLifecycleTestTab();
+  if (!contents) {
+    LOG(ERROR) << "[Chromium:AROS:LifecycleTest] no active tab";
+    return;
+  }
+
+  content::RenderProcessHost* original_process =
+      contents->GetPrimaryMainFrame()->GetProcess();
+  const int original_process_id = original_process->GetID();
+  LOG(ERROR) << "[Chromium:AROS:LifecycleTest] retiring active renderer_host="
+             << original_process_id;
+  const bool shutdown_dispatched =
+      original_process->Shutdown(content::RESULT_CODE_KILLED);
+  LOG(ERROR) << "[Chromium:AROS:LifecycleTest] renderer shutdown dispatched="
+             << shutdown_dispatched << " renderer_host=" << original_process_id;
+
+  auto task_runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+  task_runner->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&RequestArosLifecycleTestRecovery, original_process_id),
+      base::Seconds(1));
+  for (int checkpoint_seconds : {5, 20, 40}) {
+    task_runner->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&LogArosLifecycleTestCheckpoint, original_process_id,
+                       checkpoint_seconds),
+        base::Seconds(checkpoint_seconds));
+  }
+}
+
+}  // namespace
+#endif  // BUILDFLAG(IS_AROS)
+
 #if BUILDFLAG(IS_WIN) && BUILDFLAG(GOOGLE_CHROME_BRANDING)
 #include "chrome/browser/win/conflicts/incompatible_applications_updater.h"
 #endif
@@ -219,8 +305,18 @@ void StartupBrowserCreatorImpl::Launch(
   // specified a non-sensical combination of options
   // ("--kiosk --no_startup_window"); do nothing in that case.
   Browser* browser = BrowserList::GetInstance()->GetLastActive();
-  if (browser)
+  if (browser) {
     MaybeToggleFullscreen(browser);
+
+#if BUILDFLAG(IS_AROS)
+    if (command_line_->HasSwitch("aros-test-close-first-tab")) {
+      LOG(ERROR) << "[Chromium:AROS:LifecycleTest] close scheduled";
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, base::BindOnce(&CloseFirstTabForArosLifecycleTest),
+          base::Seconds(20));
+    }
+#endif  // BUILDFLAG(IS_AROS)
+  }
 }
 
