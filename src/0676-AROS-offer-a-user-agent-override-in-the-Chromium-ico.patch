From a297b59b9cf5a46bd19810b9b2882eecfccbfe41 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 14 Oct 2026 20:49:48 -0500
Subject: [PATCH 676/689] AROS: offer a user-agent override in the Chromium
 icon

Sites that gate on the Chrome version (Slack requires 137+) reject
Chromium 124. Add a disabled CHROME_ARG tooltype with a current Chrome
user agent so users can enable or update it from the icon's Information
window without a rebuild.
---
 chrome/app/theme/aros/Chromium.info.src | 1 +
 1 file changed, 1 insertion(+)

diff --git a/chrome/app/theme/aros/Chromium.info.src b/chrome/app/theme/aros/Chromium.info.src
index f60195c836..ef257fe3ba 100644
--- a/chrome/app/theme/aros/Chromium.info.src
+++ b/chrome/app/theme/aros/Chromium.info.src
@@ -10,6 +10,7 @@ TOOLTYPE = "CHROME_ARG=--no-default-browser-check"
 TOOLTYPE = "CHROME_ARG=--aros-spoof-platform=linux"
 TOOLTYPE = "CHROME_ARG=--v8-cache-options=none"
 TOOLTYPE = "CHROME_ARG=--disable-features=ConsumeCodeCacheOffThread,ScriptStreaming"
+TOOLTYPE = "(CHROME_ARG=--user-agent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36)"
 TOOLTYPE = "(CHROME_ARG=--aros-pin-workers)"
 TOOLTYPE = "(CHROME_ARG=--user-data-dir=PROGDIR:Profiles)"
 TOOLTYPE = "(CHROME_ARG=--incognito)"
