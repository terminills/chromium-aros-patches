   void ResetNativeCursor();
   void DisableNativeEvents();
   void DispatchMouseMove(uint16_t qualifier, int16_t mouse_x, int16_t mouse_y);
@@ -104,6 +109,9 @@ class ArosWindow : public PlatformWindow {
   RAW_PTR_EXCLUSION struct Window* window_ = nullptr;
   RAW_PTR_EXCLUSION struct BitMap* cursor_bitmap_ = nullptr;
   RAW_PTR_EXCLUSION void* cursor_object_ = nullptr;
+  RAW_PTR_EXCLUSION struct BitMap* backing_bitmap_ = nullptr;
+  std::unique_ptr<struct RastPort> backing_rast_port_;
+  gfx::Size backing_size_;
   scoped_refptr<PlatformCursor> cursor_;
   gfx::Rect bounds_;
   std::optional<gfx::Rect> restored_bounds_;
