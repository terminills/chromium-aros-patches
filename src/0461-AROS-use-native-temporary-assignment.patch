From 7133762a5001fa354391ce84442bd1b2067c83ec Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 1 Aug 2026 07:36:50 -0500
Subject: [PATCH 461/638] AROS: use native temporary assignment

Return T: as Chromium's default temporary directory on AROS instead of the generic POSIX /tmp spelling. Explicit TMPDIR values remain honored.



---
 base/files/file_util_posix.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/base/files/file_util_posix.cc b/base/files/file_util_posix.cc
index b64044cac8..1f283a86e4 100644
--- a/base/files/file_util_posix.cc
+++ b/base/files/file_util_posix.cc
@@ -724,6 +724,11 @@ bool GetTempDir(FilePath* path) {
 
 #if BUILDFLAG(IS_ANDROID)
   return PathService::Get(DIR_CACHE, path);
+#elif BUILDFLAG(IS_AROS)
+  // Use the native temporary assignment instead of routing AROS through the
+  // POSIX compatibility spelling "/tmp".
+  *path = FilePath("T:");
+  return true;
 #else
   *path = FilePath("/tmp");
   return true;
