@@ -0,0 +1,226 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "media/capture/video/aros/video_capture_device_factory_aros.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <memory>
+#include <string>
+#include <utility>
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/threading/platform_thread.h"
+#include "base/threading/simple_thread.h"
+#include "base/time/time.h"
+#include "ui/gfx/color_space.h"
+
+// Exec macros must follow Chromium headers. Each VHI session owns its library
+// base and handle; there is no shared process-global VHIBase.
+#include <aros/libcall.h>
+#include <proto/exec.h>
+#include <vhi/vhi.h>
+
+namespace media {
+namespace {
+constexpr char kIdPrefix[] = "vhi:uvc.library:";
+constexpr unsigned kMaxInputs = 256;
+constexpr unsigned kMaxDimension = 4096;
+
+class VhiSession {
+ public:
+  ~VhiSession() {
+    if (handle_) {
+      Call(VHI_METHOD_CLOSE, 0, nullptr);
+    }
+    if (library_) {
+      CloseLibrary(library_);
+    }
+  }
+  bool Open() {
+    library_ = OpenLibrary("uvc.library", 1);
+    if (!library_) {
+      return false;
+    }
+    handle_ = reinterpret_cast<APTR>(Call(VHI_METHOD_OPEN, 0, nullptr));
+    return handle_ && !error_;
+  }
+  IPTR Call(ULONG method, ULONG submethod, APTR attr) {
+    error_ = 0;
+    return AROS_LC5(IPTR, vhi_api, AROS_LCA(ULONG, method, D2),
+                    AROS_LCA(ULONG, submethod, D3), AROS_LCA(APTR, attr, D4),
+                    AROS_LCA(ULONG*, &error_, D5), AROS_LCA(APTR, handle_, D6),
+                    struct Library*, library_, 5, Vhi);
+  }
+  bool Select(unsigned input, std::string* name, gfx::Size* size) {
+    struct vhi_setoptions option = {VHI_OPT_INPUT, input};
+    Call(VHI_METHOD_SET, VHI_OPTIONS, &option);
+    if (error_) {
+      return false;
+    }
+    auto* text = reinterpret_cast<char*>(
+        Call(VHI_METHOD_GET, VHI_NAME_OF_INPUT, reinterpret_cast<APTR>(input)));
+    if (!text || error_) {
+      if (text) {
+        FreeVec(text);
+      }
+      return false;
+    }
+    *name = text;
+    FreeVec(text);
+    struct vhi_size maximum = {};
+    Call(VHI_METHOD_GET, VHI_MAXIMUM_SIZE, &maximum);
+    if (error_ || !maximum.max_width || !maximum.max_height ||
+        maximum.max_width > kMaxDimension ||
+        maximum.max_height > kMaxDimension) {
+      return false;
+    }
+    *size = gfx::Size(maximum.max_width, maximum.max_height);
+    return true;
+  }
+  ULONG error() const { return error_; }
+
+ private:
+  struct Library* library_ = nullptr;
+  APTR handle_ = nullptr;
+  ULONG error_ = 0;
+};
+
+class VhiCaptureDevice final : public VideoCaptureDevice,
+                               public base::DelegateSimpleThread::Delegate {
+ public:
+  VhiCaptureDevice(unsigned input, std::string name)
+      : input_(input), name_(std::move(name)) {}
+  ~VhiCaptureDevice() override { StopAndDeAllocate(); }
+  void AllocateAndStart(const VideoCaptureParams& params,
+                        std::unique_ptr<Client> client) override {
+    DCHECK(!thread_);
+    client_ = std::move(client);
+    const float fps = params.requested_format.frame_rate;
+    if (!std::isfinite(fps) || fps <= 0) {
+      client_->OnError(
+          VideoCaptureError::
+              kVideoCaptureControllerInvalidOrUnsupportedVideoCaptureParametersRequested,
+          FROM_HERE, "Invalid VHI frame rate");
+      return;
+    }
+    fps_ = std::min(fps, 30.0f);
+    stopped_.store(false, std::memory_order_relaxed);
+    thread_ = std::make_unique<base::DelegateSimpleThread>(this, "VHI capture");
+    thread_->Start();
+  }
+  void StopAndDeAllocate() override {
+    stopped_.store(true, std::memory_order_relaxed);
+    // uvc.library has a bounded capture timeout. Join before releasing client
+    // or driver resources so Stop guarantees there are no later callbacks.
+    if (thread_) {
+      thread_->Join();
+      thread_.reset();
+    }
+    client_.reset();
+  }
+  void Run() override {
+    VhiSession session;
+    std::string name;
+    gfx::Size size;
+    if (!session.Open() || !session.Select(input_, &name, &size) ||
+        name != name_) {
+      Error("VHI camera unavailable or enumeration changed");
+      return;
+    }
+    VideoCaptureFormat format(size, fps_, PIXEL_FORMAT_RGB24);
+    const auto start = base::TimeTicks::Now();
+    const auto interval = base::Seconds(1.0 / fps_);
+    client_->OnStarted();
+    while (!stopped_.load(std::memory_order_relaxed)) {
+      const auto begin = base::TimeTicks::Now();
+      struct vhi_digitize request = {};
+      auto* frame = reinterpret_cast<struct vhi_image*>(
+          session.Call(VHI_METHOD_PERFORM, VHI_DIGITIZE_PICTURE, &request));
+      const bool valid = frame && !session.error() && frame->chunky &&
+                         frame->type == VHI_RGB_24 &&
+                         frame->width == unsigned(size.width()) &&
+                         frame->height == unsigned(size.height());
+      if (valid && !stopped_.load(std::memory_order_relaxed)) {
+        const auto now = base::TimeTicks::Now();
+        client_->OnIncomingCapturedData(
+            static_cast<const uint8_t*>(frame->chunky),
+            size.width() * size.height() * 3, format,
+            gfx::ColorSpace::CreateSRGB(), 0, false, now, now - start, begin);
+      }
+      if (frame) {
+        FreeVec(frame->chunky);
+        FreeVec(frame);
+      }
+      if (!valid) {
+        Error("VHI capture failed or camera disconnected");
+        return;
+      }
+      // Short sleeps let Stop interrupt frame pacing promptly.
+      const auto deadline = begin + interval;
+      while (!stopped_.load(std::memory_order_relaxed) &&
+             base::TimeTicks::Now() < deadline) {
+        base::PlatformThread::Sleep(base::Milliseconds(5));
+      }
+    }
+  }
+
+ private:
+  void Error(const char* message) {
+    if (!stopped_.load(std::memory_order_relaxed)) {
+      client_->OnError(
+          VideoCaptureError::kVideoCaptureManagerDeviceConnectionLost,
+          FROM_HERE, message);
+    }
+  }
+  const unsigned input_;
+  const std::string name_;
+  float fps_ = 30;
+  std::atomic<bool> stopped_{false};
+  std::unique_ptr<Client> client_;
+  std::unique_ptr<base::DelegateSimpleThread> thread_;
+};
+}  // namespace
+
+VideoCaptureErrorOrDevice VideoCaptureDeviceFactoryAros::CreateDevice(
+    const VideoCaptureDeviceDescriptor& descriptor) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  unsigned input = 0;
+  const std::string prefix(kIdPrefix);
+  if (descriptor.device_id.compare(0, prefix.size(), prefix) != 0 ||
+      !base::StringToUint(descriptor.device_id.substr(prefix.size()), &input) ||
+      !input || input >= kMaxInputs) {
+    return VideoCaptureErrorOrDevice(
+        VideoCaptureError::kVideoCaptureSystemDeviceIdNotFound);
+  }
+  return VideoCaptureErrorOrDevice(
+      std::make_unique<VhiCaptureDevice>(input, descriptor.display_name()));
+}
+
+void VideoCaptureDeviceFactoryAros::GetDevicesInfo(
+    GetDevicesInfoCallback callback) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+  std::vector<VideoCaptureDeviceInfo> devices;
+  VhiSession session;
+  if (session.Open()) {
+    const auto count =
+        session.Call(VHI_METHOD_GET, VHI_NUMBER_OF_INPUTS, nullptr);
+    if (!session.error() && count <= kMaxInputs) {
+      // uvc.library input zero is explicitly synthetic, never a real camera.
+      for (unsigned input = 1; input < count; ++input) {
+        std::string name;
+        gfx::Size size;
+        if (!session.Select(input, &name, &size)) {
+          continue;
+        }
+        VideoCaptureDeviceInfo info(VideoCaptureDeviceDescriptor(
+            name, std::string(kIdPrefix) + base::NumberToString(input)));
+        info.supported_formats.emplace_back(size, 30.0f, PIXEL_FORMAT_RGB24);
+        devices.push_back(std::move(info));
+      }
+    }
+  }
+  std::move(callback).Run(std::move(devices));
+}
+}  // namespace media
