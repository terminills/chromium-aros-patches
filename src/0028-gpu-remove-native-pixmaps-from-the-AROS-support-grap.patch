     return client_native_pixmap_factory_.get();
   }
@@ -100,7 +101,7 @@ class GPU_EXPORT GpuMemoryBufferSupport {
       base::span<uint8_t> premapped_memory = base::span<uint8_t>());
 
  private:
-#if BUILDFLAG(IS_OZONE)
