+#ifndef BASE_MESSAGE_LOOP_MESSAGE_PUMP_AROS_H_
+#define BASE_MESSAGE_LOOP_MESSAGE_PUMP_AROS_H_
+
+#include <stdint.h>
+
+#include <vector>
+
+#include "base/base_export.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/raw_ptr_exclusion.h"
+#include "base/message_loop/message_pump.h"
+#include "base/message_loop/watchable_io_message_pump_posix.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/threading/thread_checker.h"
+
+struct Task;
+
+namespace base {
+
+// AROS does not expose POSIX fd readiness through posixc select(). AROSTCP's
+// WaitSelect() is the native socket readiness primitive and can atomically wait
+// for an Exec signal, which supplies the cross-task scheduler wakeup.
+class BASE_EXPORT MessagePumpAROS : public MessagePump,
+                                    public WatchableIOMessagePumpPosix {
+ public:
+  class FdWatchController : public FdWatchControllerInterface {
+   public:
+    explicit FdWatchController(const Location& from_here);
+
+    FdWatchController(const FdWatchController&) = delete;
+    FdWatchController& operator=(const FdWatchController&) = delete;
+
+    ~FdWatchController() override;
+
+    bool StopWatchingFileDescriptor() override;
+
+   private:
+    friend class MessagePumpAROS;
+
+    raw_ptr<MessagePumpAROS, DisableDanglingPtrDetection> pump_ = nullptr;
+    raw_ptr<FdWatcher> watcher_ = nullptr;
+    raw_ptr<bool> was_destroyed_ = nullptr;
+    int fd_ = -1;
+    int mode_ = 0;
+    bool persistent_ = false;
+    uint64_t generation_ = 0;
+  };
+
+  MessagePumpAROS();
+
+  MessagePumpAROS(const MessagePumpAROS&) = delete;
+  MessagePumpAROS& operator=(const MessagePumpAROS&) = delete;
+
+  ~MessagePumpAROS() override;
+
+  bool WatchFileDescriptor(int fd,
+                           bool persistent,
+                           int mode,
+                           FdWatchController* controller,
+                           FdWatcher* delegate);
+
+  void Run(Delegate* delegate) override;
+  void Quit() override;
+  void ScheduleWork() override;
+  void ScheduleDelayedWork(
+      const Delegate::NextWorkInfo& next_work_info) override;
+
+ private:
+  struct RunState {
+    explicit RunState(Delegate* delegate_in) : delegate(delegate_in) {}
+
+    RAW_PTR_EXCLUSION Delegate* const delegate;
+    bool should_quit = false;
+  };
+
+  struct ReadyRegistration {
+    FdWatchController* controller;
+    uint64_t generation;
+    int ready_mode;
+  };
+
+  bool WaitForSocketEvents(TimeDelta timeout, bool wait_indefinitely);
+  void DispatchController(const ReadyRegistration& ready);
+  void UnregisterController(FdWatchController* controller);
+
+  raw_ptr<RunState> run_state_ = nullptr;
+  RAW_PTR_EXCLUSION Task* pump_task_ = nullptr;
+  int wakeup_signal_ = -1;
+  uint32_t wakeup_mask_ = 0;
+  WaitableEvent idle_event_;
+  std::vector<raw_ptr<FdWatchController>> controllers_;
+  uint64_t next_generation_ = 1;
+  ThreadChecker watch_file_descriptor_caller_checker_;
+};
+
+}  // namespace base
+
+#endif  // BASE_MESSAGE_LOOP_MESSAGE_PUMP_AROS_H_
