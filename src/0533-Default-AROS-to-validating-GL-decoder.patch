From f7d26bff49654a6b50e0ab3c4998cdafa9acf8fc Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Sat, 8 Aug 2026 04:26:12 -0500
Subject: [PATCH 533/638] Default AROS to validating GL decoder

---
 ui/gl/gl_features.cc | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/ui/gl/gl_features.cc b/ui/gl/gl_features.cc
index c2d77e8297..7ff2164892 100644
--- a/ui/gl/gl_features.cc
+++ b/ui/gl/gl_features.cc
@@ -80,7 +80,11 @@ bool IsDeviceBlocked(const char* field, const std::string& block_list) {
 // platforms that would otherwise not default to using EGL bindings.
 BASE_FEATURE(kDefaultPassthroughCommandDecoder,
              "DefaultPassthroughCommandDecoder",
+#if BUILDFLAG(IS_AROS)
+             base::FEATURE_DISABLED_BY_DEFAULT
+#else
              base::FEATURE_ENABLED_BY_DEFAULT
+#endif
 );
 #endif  // !defined(PASSTHROUGH_COMMAND_DECODER_LAUNCHED)
 
