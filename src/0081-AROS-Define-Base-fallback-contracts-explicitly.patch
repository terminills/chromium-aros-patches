 base/base_paths_aros.cc               | 61 +++++++++++++++++++++++++++
 base/process/process_aros.cc          | 23 ++++++++++
 base/process/process_iterator_aros.cc | 25 +++++++++++
 4 files changed, 113 insertions(+)
 create mode 100644 base/base_paths_aros.cc
 create mode 100644 base/process/process_iterator_aros.cc

