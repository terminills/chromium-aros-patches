From eaa9e24849022ebd19e86438cafe91351aa470e6 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 24 Jul 2026 15:21:21 -0500
Subject: [PATCH 311/638] cef: expose ResourceBundle UI cleanup

Apply CEF's upstream resource_bundle_2512 patch as a discrete prerequisite for Alloy runtime shutdown.

AI_PHASE: chromium-cef-bootstrap

AI_STATUS: upstream-resource-bundle-prerequisite-applied

AI_ASSUMPTION: CEF 52dac911 patch stack is authoritative for Chromium 124.0.6367.0 integration

AI_VALIDATION: libcef_static reported missing ui::ResourceBundle::CleanupOnUIThread

AI_EVIDENCE: test-artifacts/-cef-bootstrap-20260724/13-libcef-static-after-core-cef-patches.log

AI_DECISION_CHAIN:; 52dac911; 4ed3620e0b
---
 ui/base/resource/resource_bundle.cc | 11 +++++++++++
 ui/base/resource/resource_bundle.h  |  5 +++++
 2 files changed, 16 insertions(+)

diff --git a/ui/base/resource/resource_bundle.cc b/ui/base/resource/resource_bundle.cc
index 630463d838..720685dc47 100644
--- a/ui/base/resource/resource_bundle.cc
+++ b/ui/base/resource/resource_bundle.cc
@@ -944,6 +944,12 @@ ResourceBundle::ResourceBundle(Delegate* delegate)
     : delegate_(delegate),
       locale_resources_data_lock_(new base::Lock),
       max_scale_factor_(k100Percent) {
+  // With CEF's multi-threaded mode the ResourceBundle may be created on the
+  // main thread and then accessed on the UI thread. Allow the SequenceChecker
+  // to re-bind on the UI thread when CalledOnValidSequence() is called for the
+  // first time.
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+
   mangle_localized_strings_ = base::CommandLine::ForCurrentProcess()->HasSwitch(
       switches::kMangleLocalizedStrings);
 }
@@ -953,6 +959,11 @@ ResourceBundle::~ResourceBundle() {
   UnloadLocaleResources();
 }
 
+void ResourceBundle::CleanupOnUIThread() {
+  FreeImages();
+  font_cache_.clear();
+}
+
 // static
 void ResourceBundle::InitSharedInstance(Delegate* delegate) {
   DCHECK(g_shared_instance_ == nullptr) << "ResourceBundle initialized twice";
diff --git a/ui/base/resource/resource_bundle.h b/ui/base/resource/resource_bundle.h
index 607e19286e..61f9569ec6 100644
--- a/ui/base/resource/resource_bundle.h
+++ b/ui/base/resource/resource_bundle.h
@@ -220,6 +220,11 @@ class COMPONENT_EXPORT(UI_BASE) ResourceBundle {
   ResourceBundle(const ResourceBundle&) = delete;
   ResourceBundle& operator=(const ResourceBundle&) = delete;
 
+  // With CEF's multi-threaded mode the ResourceBundle may be created/destroyed
+  // on the main thread but accessed on the UI thread. Call this method on the
+  // UI thread to clean up resources before destruction.
+  void CleanupOnUIThread();
+
   // Loads a secondary locale data pack using the given file region.
   void LoadSecondaryLocaleDataWithPakFileRegion(
       base::File pak_file,
