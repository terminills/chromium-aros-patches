diff --git a/chrome/app/aros_codec_threads.cc b/chrome/app/aros_codec_threads.cc
new file mode 100644
index 0000000000..cbd7b7b149
--- /dev/null
+++ b/chrome/app/aros_codec_threads.cc
@@ -0,0 +1,34 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Every pthread_create in the chrome executable comes through here (linked
+// with -Wl,--wrap=pthread_create). PlatformThread's own threads pass straight
+// through - they are placed by MaybePinThreadRoundRobin. Any other thread is
+// one a third-party library started itself (video decoders above all) and is
+// placed by MaybePinForeignThread when --aros-pin-codec-threads is given.
+
+#include <pthread.h>
+
+#include "base/threading/platform_thread_internal_posix.h"
+
+extern "C" int __real_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg);
+
+extern "C" int __wrap_pthread_create(pthread_t* thread,
+                                     const pthread_attr_t* attr,
+                                     void* (*start)(void*),
+                                     void* arg) {
+  if (base::internal::ArosCreatingPlatformThread())
+    return __real_pthread_create(thread, attr, start, arg);
+
+  pthread_attr_t placed;
+  if (attr)
+    placed = *attr;
+  else
+    pthread_attr_init(&placed);
+  base::internal::MaybePinForeignThread(&placed);
+  return __real_pthread_create(thread, &placed, start, arg);
+}
