@@ -223,9 +223,12 @@ void AsyncLayerTreeFrameSink::SetLocalSurfaceId(
   DCHECK(local_surface_id.is_valid());
   local_surface_id_ = local_surface_id;
 #if BUILDFLAG(IS_AROS)
-  LOG(ERROR) << "[AROS async-sink-surface] instance=" << this
-             << " thread=" << base::PlatformThread::CurrentId()
-             << " surface=" << local_surface_id_.ToString();
+  if (aros_surface_count_++ < 16) {
+    LOG(ERROR) << "[AROS async-sink-surface] instance=" << this
+               << " seq=" << aros_surface_count_
+               << " thread=" << base::PlatformThread::CurrentId()
+               << " surface=" << local_surface_id_.ToString();
+  }
 #endif
 }
 
