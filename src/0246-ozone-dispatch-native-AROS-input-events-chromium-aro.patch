+void ArosWindow::DispatchMouseMove(uint16_t qualifier,
+                                   int16_t mouse_x,
+                                   int16_t mouse_y) {
+  if (!window_) {
+    return;
+  }
+
+  const gfx::Point location(mouse_x - window_->BorderLeft,
+                            mouse_y - window_->BorderTop);
+  const gfx::Rect client_bounds(bounds_.size());
+  if (!capture_ && !client_bounds.Contains(location)) {
+    return;
+  }
+
+  mouse_button_flags_ = MouseFlagsFromQualifier(qualifier);
+  const gfx::Point root_location(window_->LeftEdge + mouse_x,
+                                 window_->TopEdge + mouse_y);
+  MouseEvent event(ET_MOUSE_MOVED, location, root_location, EventTimeForNow(),
+                   ModifierFlagsFromQualifier(qualifier) | mouse_button_flags_,
+                   EF_NONE);
+  delegate_->DispatchEvent(&event);
+}
+
+void ArosWindow::DispatchMouseButton(uint16_t code,
+                                     uint16_t qualifier,
+                                     int16_t mouse_x,
+                                     int16_t mouse_y) {
+  if (!window_) {
+    return;
+  }
+
+  const int changed_button = MouseButtonFlagFromCode(code);
+  if (changed_button == EF_NONE) {
+    return;
+  }
+
+  const bool released = (code & IECODE_UP_PREFIX) != 0;
+  if (released) {
+    mouse_button_flags_ &= ~changed_button;
+  } else {
+    mouse_button_flags_ |= changed_button;
+  }
+
+  const gfx::Point location(mouse_x - window_->BorderLeft,
+                            mouse_y - window_->BorderTop);
+  const gfx::Rect client_bounds(bounds_.size());
+  if (!capture_ && !client_bounds.Contains(location)) {
+    return;
+  }
+
+  const gfx::Point root_location(window_->LeftEdge + mouse_x,
+                                 window_->TopEdge + mouse_y);
+  // Release events still identify the changed button after persistent state
+  // has been cleared.
+  MouseEvent event(released ? ET_MOUSE_RELEASED : ET_MOUSE_PRESSED, location,
+                   root_location, EventTimeForNow(),
+                   ModifierFlagsFromQualifier(qualifier) | mouse_button_flags_ |
+                       changed_button,
+                   changed_button);
+  event.InitializeNative();
+  delegate_->DispatchEvent(&event);
+}
+
+void ArosWindow::DispatchRawKey(uint16_t code,
+                                uint16_t qualifier,
+                                int16_t mouse_x,
+                                int16_t mouse_y) {
+  const bool released = (code & IECODE_UP_PREFIX) != 0;
+  const uint16_t raw_code = code & ~IECODE_UP_PREFIX;
+
+  if (IsMouseWheelRawKey(raw_code)) {
+    if (released || !window_) {
+      return;
+    }
+    const gfx::Point location(mouse_x - window_->BorderLeft,
+                              mouse_y - window_->BorderTop);
+    const gfx::Rect client_bounds(bounds_.size());
+    if (!capture_ && !client_bounds.Contains(location)) {
+      return;
+    }
+    const gfx::Point root_location(window_->LeftEdge + mouse_x,
+                                   window_->TopEdge + mouse_y);
+    gfx::Vector2d offset;
+    switch (raw_code) {
+      case RAWKEY_NM_WHEEL_UP:
+        offset.set_y(MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_DOWN:
+        offset.set_y(-MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_LEFT:
+        offset.set_x(MouseWheelEvent::kWheelDelta);
+        break;
+      case RAWKEY_NM_WHEEL_RIGHT:
+        offset.set_x(-MouseWheelEvent::kWheelDelta);
+        break;
+    }
+    MouseWheelEvent event(
+        offset, location, root_location, EventTimeForNow(),
+        ModifierFlagsFromQualifier(qualifier) | mouse_button_flags_, EF_NONE);
+    delegate_->DispatchEvent(&event);
+    return;
+  }
+
+  const DomCode dom_code = DomCodeFromRawKey(raw_code);
+  if (dom_code == DomCode::NONE) {
+    VLOG(1) << "[Chromium:Ozone:AROS] unmapped raw key=" << raw_code;
+    return;
+  }
+
+  int flags = ModifierFlagsFromQualifier(qualifier) | mouse_button_flags_;
+  if (qualifier & IEQUALIFIER_REPEAT) {
+    flags |= EF_IS_REPEAT;
+  }
+  DomKey dom_key = DomKey::UNIDENTIFIED;
+  KeyboardCode key_code = DomCodeToUsLayoutKeyboardCode(dom_code);
+  KeyboardCode layout_key_code = key_code;
+  if (DomCodeToUsLayoutDomKey(dom_code, flags, &dom_key, &layout_key_code)) {
+    key_code = layout_key_code;
+  }
+
+  KeyEvent event(released ? ET_KEY_RELEASED : ET_KEY_PRESSED, key_code,
+                 dom_code, flags, dom_key, EventTimeForNow());
+  event.InitializeNative();
+  delegate_->DispatchEvent(&event);
+}
