+int ModifierFlagsFromQualifier(uint16_t qualifier) {
+  int flags = EF_NONE;
+  if (qualifier & (IEQUALIFIER_LSHIFT | IEQUALIFIER_RSHIFT)) {
+    flags |= EF_SHIFT_DOWN;
+  }
+  if (qualifier & IEQUALIFIER_CONTROL) {
+    flags |= EF_CONTROL_DOWN;
+  }
+  if (qualifier & (IEQUALIFIER_LALT | IEQUALIFIER_RALT)) {
+    flags |= EF_ALT_DOWN;
+  }
+  if (qualifier & (IEQUALIFIER_LCOMMAND | IEQUALIFIER_RCOMMAND)) {
+    flags |= EF_COMMAND_DOWN;
+  }
+  if (qualifier & IEQUALIFIER_CAPSLOCK) {
+    flags |= EF_CAPS_LOCK_ON;
+  }
+  return flags;
+}
+
+int MouseFlagsFromQualifier(uint16_t qualifier) {
+  int flags = EF_NONE;
+  if (qualifier & IEQUALIFIER_LEFTBUTTON) {
+    flags |= EF_LEFT_MOUSE_BUTTON;
+  }
+  if (qualifier & IEQUALIFIER_MIDBUTTON) {
+    flags |= EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (qualifier & IEQUALIFIER_RBUTTON) {
+    flags |= EF_RIGHT_MOUSE_BUTTON;
+  }
+  return flags;
+}
+
+int MouseButtonFlagFromCode(uint16_t code) {
+  switch (code & ~IECODE_UP_PREFIX) {
+    case IECODE_LBUTTON:
+      return EF_LEFT_MOUSE_BUTTON;
+    case IECODE_MBUTTON:
+      return EF_MIDDLE_MOUSE_BUTTON;
+    case IECODE_RBUTTON:
+      return EF_RIGHT_MOUSE_BUTTON;
+    default:
+      return EF_NONE;
+  }
+}
