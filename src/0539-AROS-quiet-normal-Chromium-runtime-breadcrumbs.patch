diff --git a/base/files/memory_mapped_file_aros.cc b/base/files/memory_mapped_file_aros.cc
index 0162b0cc03..03f265e61a 100644
--- a/base/files/memory_mapped_file_aros.cc
+++ b/base/files/memory_mapped_file_aros.cc
@@ -36,19 +36,10 @@ bool MemoryMappedFile::MapFileRegionToMemory(
     Access access) {
   ScopedBlockingCall scoped_blocking_call(FROM_HERE, BlockingType::MAY_BLOCK);
 
-#if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:MMAP] map enter access="
-               << static_cast<int>(access) << " region_offset="
-               << region.offset << " region_size=" << region.size;
-#endif
-
   int64_t file_offset = 0;
   size_t data_size = 0;
   if (region == MemoryMappedFile::Region::kWholeFile) {
     const int64_t file_length = file_.GetLength();
-#if BUILDFLAG(IS_AROS)
-    LOG(WARNING) << "[Chromium:AROS:MMAP] whole-file length=" << file_length;
-#endif
     if (file_length <= 0 ||
         !IsValueInRangeForNumericType<size_t>(file_length)) {
       return false;
@@ -66,14 +57,7 @@ bool MemoryMappedFile::MapFileRegionToMemory(
       return false;
 
     if (access == READ_WRITE_EXTEND) {
-#if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:MMAP] extend begin offset="
-                   << file_offset << " bytes=" << data_size;
-#endif
       const bool extended = AllocateFileRegion(&file_, file_offset, data_size);
-#if BUILDFLAG(IS_AROS)
-      LOG(WARNING) << "[Chromium:AROS:MMAP] extend complete=" << extended;
-#endif
       if (!extended)
         return false;
     } else if (file_.GetLength() < region_end.ValueOrDie()) {
@@ -91,15 +75,6 @@ bool MemoryMappedFile::MapFileRegionToMemory(
     return false;
 
   const size_t rounded_size = allocation_size.ValueOrDie();
-#if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:MMAP] backing allocation begin bytes="
-               << rounded_size;
-#endif
-  bug("[AROS:MMAP] plan offset=%lld bytes=%llu page=%llu rounded=%llu\n",
-      static_cast<long long>(file_offset),
-      static_cast<unsigned long long>(data_size),
-      static_cast<unsigned long long>(granularity),
-      static_cast<unsigned long long>(rounded_size));
   APTR KernelBase = OpenResource("kernel.resource");
   void* allocation =
       KernelBase
@@ -132,24 +107,10 @@ bool MemoryMappedFile::MapFileRegionToMemory(
     const uintptr_t aligned_address =
         (raw_address + granularity - 1) & ~(granularity - 1);
     allocation = reinterpret_cast<void*>(aligned_address);
-    bug("[AROS:MMAP] backing=exec base=%p data=%p bytes=%llu\n",
-        allocation_base, allocation,
-        static_cast<unsigned long long>(backing_size));
   }
 
-#if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:MMAP] backing allocation complete kernel_pages="
-               << uses_kernel_pages << " bytes=" << backing_size;
-  LOG(WARNING) << "[Chromium:AROS:MMAP] read begin offset=" << file_offset
-               << " bytes=" << data_size;
-#endif
-
   span<uint8_t> contents(static_cast<uint8_t*>(allocation), data_size);
   const std::optional<size_t> bytes_read = file_.Read(file_offset, contents);
-#if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:MMAP] read complete bytes="
-               << (bytes_read ? static_cast<int64_t>(*bytes_read) : -1);
-#endif
   if (!bytes_read || *bytes_read != data_size) {
     bug("[AROS:MMAP] read failed requested=%llu actual=%lld errno=%d\n",
         static_cast<unsigned long long>(data_size),
@@ -168,9 +129,6 @@ bool MemoryMappedFile::MapFileRegionToMemory(
   length_ = data_size;
   file_offset_ = file_offset;
   access_ = access;
-#if BUILDFLAG(IS_AROS)
-  LOG(WARNING) << "[Chromium:AROS:MMAP] map complete bytes=" << data_size;
-#endif
   return true;
 }
 #endif
