From fbfdd3fe23d7e0885889ab4dbd038da7e475b9d4 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 25 Sep 2026 07:58:05 -0500
Subject: [PATCH 646/689] aros: pass open files across mojo channels as posixc
 open-file tokens

A descriptor number means nothing in another process's posixc table, so
the browser opening files for the out-of-process storage service handed it
numbers that failed with EBADF. Encode descriptors as posixc 0.41
open-file tokens (MOJO_PLATFORM_HANDLE_TYPE_AROS_FILE), import them into
the receiver's table, and release tokens in packets that are dropped.
The posixc entry points are weak so executables linked against an older
SDK keep the numeric encoding; chrome links the 0.41 stubs directly for
this experiment.
---
 chrome/BUILD.gn                          |  8 ++++
 mojo/core/channel_aros.cc                | 12 ++----
 mojo/public/c/system/platform_handle.h   |  6 +++
 mojo/public/cpp/platform/aros_channel.cc | 55 ++++++++++++++++++++++--
 mojo/public/cpp/platform/aros_channel.h  | 13 ++++++
 5 files changed, 82 insertions(+), 12 deletions(-)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 935320da79..1b2f45c2fe 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1926,5 +1926,13 @@ if (is_aros) {
   # CHROMIUM_CLOSE_TRACE is set.
   config("aros_close_trace") {
     ldflags = [ "-Wl,--wrap=__posixc_close", "-Wl,--wrap=__posixc_open" ]
+
+    # Experiment only: the posixc 0.41 descriptor-transfer stubs, until the
+    # AROS SDK this out directory is built against carries them.
+    ldflags += [
+      "/home/terminills/Documents/GitHub/aros-adt-websub-x86_64/bin/pc-x86_64-smp/gen/compiler/crt/posixc/posixc/linklib/posixc___posixc_fd_export_stub.o",
+      "/home/terminills/Documents/GitHub/aros-adt-websub-x86_64/bin/pc-x86_64-smp/gen/compiler/crt/posixc/posixc/linklib/posixc___posixc_fd_import_stub.o",
+      "/home/terminills/Documents/GitHub/aros-adt-websub-x86_64/bin/pc-x86_64-smp/gen/compiler/crt/posixc/posixc/linklib/posixc___posixc_fd_release_stub.o",
+    ]
   }
 }
diff --git a/mojo/core/channel_aros.cc b/mojo/core/channel_aros.cc
index 924174c178..6784b4fea1 100644
--- a/mojo/core/channel_aros.cc
+++ b/mojo/core/channel_aros.cc
@@ -154,8 +154,7 @@ void ChannelAros::Write(MessagePtr message) {
     std::vector<PlatformHandleInTransit> handles = message->TakeHandles();
     std::vector<MojoPlatformHandle> encoded_handles(handles.size());
     for (size_t i = 0; i < handles.size(); ++i) {
-      PlatformHandle::ToMojoPlatformHandle(handles[i].TakeHandle(),
-                                           &encoded_handles[i]);
+      EncodeArosTransferHandle(handles[i].TakeHandle(), &encoded_handles[i]);
     }
     if (SendArosChannelPacket(channel_, ArosChannelPacketType::kData,
                               message->data(), message->data_num_bytes(),
@@ -165,10 +164,8 @@ void ChannelAros::Write(MessagePtr message) {
 
     // Encoding relinquished the PlatformHandle wrappers. Reconstitute
     // ownership when allocation failed or the peer was already closed.
-    for (const MojoPlatformHandle& encoded : encoded_handles) {
-      PlatformHandle handle =
-          PlatformHandle::FromMojoPlatformHandle(&encoded);
-    }
+    for (const MojoPlatformHandle& encoded : encoded_handles)
+      ReleaseArosTransferHandle(&encoded);
     reject_writes_ = true;
     write_error = true;
   }
@@ -187,8 +184,7 @@ void ChannelAros::ProcessPacket(ArosChannelPacket* packet) {
   DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
   const ArosChannelPacketView view = GetArosChannelPacketView(packet);
   for (size_t i = 0; i < view.handle_count; ++i) {
-    incoming_handles_.push_back(
-        PlatformHandle::FromMojoPlatformHandle(&view.handles[i]));
+    incoming_handles_.push_back(DecodeArosTransferHandle(&view.handles[i]));
