+// Per-frame VP9 parameters, the content of rvcn_dec_message_vp9_t plus the
+// segmentation table.
+struct VcnVp9Frame {
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t frame_header_flags = 0;
+  uint8_t frame_context_idx = 0;
