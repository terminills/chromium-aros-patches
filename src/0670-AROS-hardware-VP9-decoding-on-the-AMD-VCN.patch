diff --git a/media/gpu/aros/aros_vcn_vp9.cc b/media/gpu/aros/aros_vcn_vp9.cc
new file mode 100644
index 0000000000..080eb06503
--- /dev/null
+++ b/media/gpu/aros/aros_vcn_vp9.cc
@@ -0,0 +1,391 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/gpu/aros/aros_vcn_vp9.h"
+
+#include <string.h>
+
+#include <atomic>
+#include <initializer_list>
+
+#include "media/gpu/aros/vcn_dec_msg.h"
+#include "media/gpu/aros/vcn_vp9_default.h"
+
+namespace media::aros {
+
+namespace {
+
+constexpr uint32_t kFeedbackOffset = 0x2000;
+constexpr uint32_t kFeedbackSize = 2048;
+constexpr uint32_t kProbsOffset = kFeedbackOffset + kFeedbackSize;
+constexpr uint32_t kProbsSize = RDECODE_VP9_PROBS_DATA_SIZE + 256;
+constexpr uint32_t kDbAlignment = 64;
+constexpr uint32_t kDtPitchAlignment = 256;
+constexpr uint32_t kSwizzle256BD = 1;
+
+constexpr uint32_t Align(uint32_t v, uint32_t a) {
+  return (v + a - 1) & ~(a - 1);
+}
+
+std::atomic<uint32_t> g_next_handle{0x41525000};
+
+// ac_vcn_vp9_fill_probs_table() from Mesa.
+void FillProbs(void* ptr) {
+  auto* probs = static_cast<rvcn_dec_vp9_probs_t*>(ptr);
+  memcpy(&probs->coef_probs[0], default_coef_probs_4x4, sizeof(default_coef_probs_4x4));
+  memcpy(&probs->coef_probs[1], default_coef_probs_8x8, sizeof(default_coef_probs_8x8));
+  memcpy(&probs->coef_probs[2], default_coef_probs_16x16, sizeof(default_coef_probs_16x16));
+  memcpy(&probs->coef_probs[3], default_coef_probs_32x32, sizeof(default_coef_probs_32x32));
+  memcpy(probs->y_mode_prob, default_if_y_probs, sizeof(default_if_y_probs));
+  memcpy(probs->uv_mode_prob, default_if_uv_probs, sizeof(default_if_uv_probs));
+  memcpy(probs->single_ref_prob, default_single_ref_p, sizeof(default_single_ref_p));
+  memcpy(probs->switchable_interp_prob, default_switchable_interp_prob,
+         sizeof(default_switchable_interp_prob));
+  memcpy(probs->partition_prob, default_partition_probs, sizeof(default_partition_probs));
+  memcpy(probs->inter_mode_probs, default_inter_mode_probs, sizeof(default_inter_mode_probs));
+  memcpy(probs->mbskip_probs, default_skip_probs, sizeof(default_skip_probs));
+  memcpy(probs->intra_inter_prob, default_intra_inter_p, sizeof(default_intra_inter_p));
+  memcpy(probs->comp_inter_prob, default_comp_inter_p, sizeof(default_comp_inter_p));
+  memcpy(probs->comp_ref_prob, default_comp_ref_p, sizeof(default_comp_ref_p));
+  memcpy(probs->tx_probs_32x32, default_tx_probs_32x32, sizeof(default_tx_probs_32x32));
+  memcpy(probs->tx_probs_16x16, default_tx_probs_16x16, sizeof(default_tx_probs_16x16));
+  memcpy(probs->tx_probs_8x8, default_tx_probs_8x8, sizeof(default_tx_probs_8x8));
+  memcpy(probs->mv_joints, default_nmv_joints, sizeof(default_nmv_joints));
+  memcpy(&probs->mv_comps[0], default_nmv_components, sizeof(default_nmv_components));
+  memset(&probs->nmvc_mask, 0, sizeof(rvcn_dec_vp9_nmv_ctx_mask_t));
+}
+
+uint32_t ContextSize(bool profile2) {
+  uint32_t size = 2304 * 5;
+  size += 32 * 2 * 128 * 68;
+  size += 9 * 64 * 2 * 128 * 68;
+  size += 8 * 2 * 2 * 8192;
+  if (profile2) {
+    size += 8 * 2 * 4096;
+  }
+  return size;
+}
+
+}  // namespace
+
+VcnVp9Session::VcnVp9Session() : vcn_(AmdgpuVcn::Get()) {}
+
+VcnVp9Session::~VcnVp9Session() {
+  Destroy();
+}
+
+bool VcnVp9Session::Create(uint32_t width, uint32_t height, bool profile2) {
+  Destroy();
+  if (!vcn_ || !width || !height) {
+    return false;
+  }
+  profile2_ = profile2;
+  if (!vcn_->Alloc(RDECODE_SESSION_CONTEXT_SIZE, &session_) ||
+      !vcn_->Alloc(kProbsOffset + kProbsSize, &msg_) ||
+      !vcn_->Alloc(ContextSize(profile2), &ctx_) || !vcn_->Alloc(4096, &ib_) ||
+      !EnsureFrameBuffers(width, height)) {
+    Destroy();
+    return false;
+  }
+  FillProbs(msg_.cpu + kProbsOffset);
+  FillProbs(ctx_.cpu);
+  AmdgpuVcn::Flush(ctx_, ctx_.size);
+
+  stream_handle_ = ++g_next_handle;
+  frame_number_ = 0;
+
+  auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
+  auto* create = reinterpret_cast<rvcn_dec_message_create_t*>(
+      msg_.cpu + sizeof(*header));
+  memset(msg_.cpu, 0, kFeedbackOffset);
+  header->header_size = sizeof(*header);
+  header->total_size = sizeof(*header) + sizeof(*create);
+  header->num_buffers = 1;
+  header->msg_type = RDECODE_MSG_CREATE;
+  header->stream_handle = stream_handle_;
+  header->index[0].message_id = RDECODE_MESSAGE_CREATE;
+  header->index[0].offset = sizeof(*header);
+  header->index[0].size = sizeof(*create);
+  create->stream_type = RDECODE_CODEC_VP9;
+  create->width_in_samples = width;
+  create->height_in_samples = height;
+  if (!Submit(false)) {
+    Destroy();
+    return false;
+  }
+  created_ = true;
+  return true;
+}
+
+void VcnVp9Session::Destroy() {
+  if (!vcn_) {
+    return;
+  }
+  if (created_) {
+    memset(msg_.cpu, 0, kFeedbackOffset);
+    auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
+    header->header_size = sizeof(*header);
+    header->total_size = sizeof(*header);
+    header->msg_type = RDECODE_MSG_DESTROY;
+    header->stream_handle = stream_handle_;
+    Submit(false);
+    created_ = false;
+  }
+  for (AmdgpuBuffer* b : {&session_, &msg_, &ctx_, &bs_, &dt_, &ib_}) {
+    if (b->bo) {
+      vcn_->Free(b);
+    }
+  }
+  for (AmdgpuBuffer& b : dpb_) {
+    if (b.bo) {
+      vcn_->Free(&b);
+    }
+  }
+  width_ = height_ = dpb_w_ = dpb_h_ = 0;
+}
+
+bool VcnVp9Session::EnsureFrameBuffers(uint32_t width, uint32_t height) {
+  if (width == width_ && height == height_ && dt_.bo) {
+    return true;
+  }
+  if (dt_.bo) {
+    vcn_->Free(&dt_);
+  }
+  if (bs_.bo) {
+    vcn_->Free(&bs_);
+  }
+  width_ = width;
+  height_ = height;
+  dt_pitch_ = Align(width, kDtPitchAlignment);
+  dt_height_ = Align(height, 16);
+  return vcn_->Alloc(dt_pitch_ * dt_height_ * 3 / 2, &dt_) &&
+         vcn_->Alloc(Align(width, 64) * Align(height, 64) * 3 / 2 + 4096, &bs_);
+}
+
+bool VcnVp9Session::EnsureDpb(int index) {
+  const uint32_t w64 = Align(width_, kDbAlignment);
+  const uint32_t h64 = Align(height_, kDbAlignment);
+  if (w64 != dpb_w_ || h64 != dpb_h_) {
+    for (AmdgpuBuffer& b : dpb_) {
+      if (b.bo) {
+        vcn_->Free(&b);
+      }
+    }
+    dpb_w_ = w64;
+    dpb_h_ = h64;
+  }
+  if (dpb_[index].bo) {
+    return true;
+  }
+  const uint32_t bpe = profile2_ ? 2 : 1;
+  return vcn_->Alloc(w64 * h64 * 3 / 2 * bpe, &dpb_[index]);
+}
+
+const uint8_t* VcnVp9Session::uv_plane() const {
+  return dt_.cpu + dt_pitch_ * dt_height_;
+}
+
+bool VcnVp9Session::Decode(const VcnVp9Frame& f, const uint8_t* data,
+                           size_t size) {
+  if (!created_ || !size || f.curr_pic_idx >= kVcnVp9MaxPictures ||
+      !EnsureFrameBuffers(f.width, f.height) || size + 128 > bs_.size) {
+    return false;
+  }
+  if (!EnsureDpb(f.curr_pic_idx)) {
+    return false;
+  }
+  for (int k = 0; k < 8; ++k) {
+    if (f.ref_frame_map[k] < kVcnVp9MaxPictures &&
+        !dpb_[f.ref_frame_map[k]].bo) {
+      return false;
+    }
+  }
+
+  const uint32_t bsd_size = Align(size, 128);
+  memcpy(bs_.cpu, data, size);
+  memset(bs_.cpu + size, 0, bsd_size - size);
+  AmdgpuVcn::Flush(bs_, bsd_size);
+
+  memset(msg_.cpu, 0, kFeedbackOffset);
+  auto* header = reinterpret_cast<rvcn_dec_message_header_t*>(msg_.cpu);
+  uint32_t sizes = sizeof(*header);
+  auto* index_codec =
+      reinterpret_cast<rvcn_dec_message_index_t*>(msg_.cpu + sizes);
+  sizes += sizeof(*index_codec);
+  auto* index_dpb =
+      reinterpret_cast<rvcn_dec_message_index_t*>(msg_.cpu + sizes);
+  sizes += sizeof(*index_dpb);
+  const uint32_t offset_decode = sizes;
+  auto* decode =
+      reinterpret_cast<rvcn_dec_message_decode_t*>(msg_.cpu + sizes);
+  sizes += sizeof(*decode);
+  const uint32_t offset_dpb = sizes;
+  auto* t2 =
+      reinterpret_cast<rvcn_dec_message_dynamic_dpb_t2_t*>(msg_.cpu + sizes);
+  sizes += sizeof(*t2);
+  const uint32_t offset_codec = sizes;
+  auto* vp9 = reinterpret_cast<rvcn_dec_message_vp9_t*>(msg_.cpu + sizes);
+
+  header->header_size = sizeof(*header);
+  header->total_size = sizes + sizeof(*vp9);
+  header->msg_type = RDECODE_MSG_DECODE;
+  header->stream_handle = stream_handle_;
+  header->status_report_feedback_number = ++frame_number_;
+  header->num_buffers = 3;
+  header->index[0].message_id = RDECODE_MESSAGE_DECODE;
+  header->index[0].offset = offset_decode;
+  header->index[0].size = sizeof(*decode);
+  index_codec->message_id = RDECODE_MESSAGE_VP9;
+  index_codec->offset = offset_codec;
+  index_codec->size = sizeof(*vp9);
+  index_dpb->message_id = RDECODE_MESSAGE_DYNAMIC_DPB;
+  index_dpb->offset = offset_dpb;
+  index_dpb->size = sizeof(*t2);
+
+  decode->stream_type = RDECODE_CODEC_VP9;
+  decode->decode_flags = RDECODE_FLAGS_USE_DYNAMIC_DPB_MASK;
+  decode->width_in_samples = f.width;
+  decode->height_in_samples = f.height;
+  decode->bsd_size = bsd_size;
+  decode->dt_size = dt_.size;
+  decode->hw_ctxt_size = ctx_.size;
+  decode->sw_ctxt_size = RDECODE_SESSION_CONTEXT_SIZE;
+  decode->db_pitch = dpb_w_;
+  decode->db_aligned_height = dpb_h_;
+  decode->db_swizzle_mode = kSwizzle256BD;
+  decode->db_array_mode = RDECODE_ARRAY_MODE_ADDRLIB_SEL_GFX11;
+  decode->dt_pitch = dt_pitch_;
+  decode->dt_uv_pitch = dt_pitch_ / 2;
+  decode->dt_swizzle_mode = RDECODE_SW_MODE_LINEAR;
+  decode->dt_array_mode = RDECODE_ARRAY_MODE_ADDRLIB_SEL_GFX11;
+  decode->dt_chroma_top_offset = dt_pitch_ * dt_height_;
+  decode->dt_chroma_bottom_offset = dt_pitch_ * dt_height_;
+  decode->mif_wrc_en = 1;
+
+  const uint32_t bpe = profile2_ ? 2 : 1;
+  t2->dpbLumaPitch = dpb_w_;
+  t2->dpbLumaAlignedHeight = dpb_h_;
+  t2->dpbLumaAlignedSize = dpb_w_ * dpb_h_ * bpe;
+  t2->dpbChromaPitch = dpb_w_ / 2;
+  t2->dpbChromaAlignedHeight = dpb_h_ / 2;
+  t2->dpbChromaAlignedSize = dpb_w_ * dpb_h_ / 2 * bpe;
+  t2->dpbCurrLo = static_cast<uint32_t>(dpb_[f.curr_pic_idx].gpu_address);
+  t2->dpbCurrHi =
+      static_cast<uint32_t>(dpb_[f.curr_pic_idx].gpu_address >> 32);
+  for (int k = 0; k < 8; ++k) {
+    if (f.ref_frame_map[k] < kVcnVp9MaxPictures) {
+      const uint64_t a = dpb_[f.ref_frame_map[k]].gpu_address;
+      t2->dpbAddrLo[k] = static_cast<uint32_t>(a);
+      t2->dpbAddrHi[k] = static_cast<uint32_t>(a >> 32);
+      ++t2->dpbArraySize;
+    }
+  }
+
+  vp9->frame_header_flags = f.frame_header_flags;
+  vp9->frame_context_idx = f.frame_context_idx;
+  vp9->reset_frame_context = f.reset_frame_context;
+  vp9->curr_pic_idx = f.curr_pic_idx;
+  vp9->interp_filter = f.interp_filter;
+  vp9->filter_level = f.filter_level;
+  vp9->sharpness_level = f.sharpness_level;
+  memcpy(vp9->lf_adj_level, f.lf_adj_level, sizeof(vp9->lf_adj_level));
+  vp9->base_qindex = f.base_qindex;
+  vp9->y_dc_delta_q = f.y_dc_delta_q;
+  vp9->uv_ac_delta_q = f.uv_ac_delta_q;
+  vp9->uv_dc_delta_q = f.uv_dc_delta_q;
+  vp9->log2_tile_cols = f.log2_tile_cols;
+  vp9->log2_tile_rows = f.log2_tile_rows;
+  vp9->chroma_format = 1;
+  memcpy(vp9->ref_frame_map, f.ref_frame_map, sizeof(vp9->ref_frame_map));
+  memcpy(vp9->frame_refs, f.frame_refs, sizeof(vp9->frame_refs));
+  memcpy(vp9->ref_frame_sign_bias, f.ref_frame_sign_bias,
+         sizeof(vp9->ref_frame_sign_bias));
+  vp9->bit_depth_luma_minus8 = vp9->bit_depth_chroma_minus8 = f.bit_depth - 8;
+  if (profile2_) {
+    vp9->luma_10to8 = 1;
+    vp9->chroma_10to8 = 1;
+  }
+  vp9->vp9_frame_size = bsd_size;
+  vp9->compressed_header_size = f.compressed_header_size;
+  vp9->uncompressed_header_size = f.uncompressed_header_size;
+
+  auto* seg = reinterpret_cast<rvcn_dec_vp9_probs_segment_t*>(msg_.cpu +
+                                                             kProbsOffset);
+  if (f.segmentation_enabled) {
+    for (int i = 0; i < 8; ++i) {
+      seg->seg.feature_data[i] = f.seg_feature_data[i];
+      seg->seg.feature_mask[i] = f.seg_feature_mask[i];
+    }
+    memcpy(seg->seg.tree_probs, f.seg_tree_probs, sizeof(seg->seg.tree_probs));
+    memcpy(seg->seg.pred_probs, f.seg_pred_probs, sizeof(seg->seg.pred_probs));
+    seg->seg.abs_delta = f.seg_abs_delta;
+  } else {
+    memset(seg->segment_data, 0, sizeof(seg->segment_data));
+  }
+
+  auto* fb = reinterpret_cast<rvcn_dec_feedback_header_t*>(msg_.cpu +
+                                                           kFeedbackOffset);
+  fb->header_size = sizeof(*fb);
+  fb->total_size = sizeof(*fb);
+  fb->num_buffers = 0;
+
+  if (!Submit(true)) {
+    return false;
+  }
+  AmdgpuVcn::Invalidate(dt_, dt_.size);
+  return true;
+}
+
+bool VcnVp9Session::Submit(bool decode) {
+  uint32_t* dw = reinterpret_cast<uint32_t*>(ib_.cpu);
+  uint32_t n = 0;
+
+  memset(dw, 0, 1024);
+  dw[n++] = RADEON_VCN_ENGINE_INFO_SIZE;
+  dw[n++] = RADEON_VCN_ENGINE_INFO;
+  dw[n++] = RADEON_VCN_ENGINE_TYPE_DECODE;
+  const uint32_t size_slot = n++;
+  auto* pkg = reinterpret_cast<rvcn_decode_ib_package_t*>(&dw[n]);
+  pkg->package_size =
+      sizeof(rvcn_decode_buffer_t) + sizeof(rvcn_decode_ib_package_t);
+  pkg->package_type = RDECODE_IB_PARAM_DECODE_BUFFER;
+  n += 2;
+  auto* db = reinterpret_cast<rvcn_decode_buffer_t*>(&dw[n]);
+  n += sizeof(rvcn_decode_buffer_t) / 4;
+
+  auto set = [db](uint32_t flag, unsigned int* lo, unsigned int* hi,
+                  uint64_t addr) {
+    db->valid_buf_flag |= flag;
+    *hi = static_cast<uint32_t>(addr >> 32);
+    *lo = static_cast<uint32_t>(addr);
+  };
+  set(RDECODE_CMDBUF_FLAGS_SESSION_CONTEXT_BUFFER,
+      &db->session_contex_buffer_address_lo,
+      &db->session_contex_buffer_address_hi, session_.gpu_address);
+  set(RDECODE_CMDBUF_FLAGS_MSG_BUFFER, &db->msg_buffer_address_lo,
+      &db->msg_buffer_address_hi, msg_.gpu_address);
+  if (decode) {
+    set(RDECODE_CMDBUF_FLAGS_CONTEXT_BUFFER, &db->context_buffer_address_lo,
+        &db->context_buffer_address_hi, ctx_.gpu_address);
+    set(RDECODE_CMDBUF_FLAGS_BITSTREAM_BUFFER,
+        &db->bitstream_buffer_address_lo, &db->bitstream_buffer_address_hi,
+        bs_.gpu_address);
+    set(RDECODE_CMDBUF_FLAGS_DECODING_TARGET_BUFFER,
+        &db->target_buffer_address_lo, &db->target_buffer_address_hi,
+        dt_.gpu_address);
+    set(RDECODE_CMDBUF_FLAGS_FEEDBACK_BUFFER, &db->feedback_buffer_address_lo,
+        &db->feedback_buffer_address_hi, msg_.gpu_address + kFeedbackOffset);
+    set(RDECODE_CMDBUF_FLAGS_PROB_TBL_BUFFER,
+        &db->prob_tbl_buffer_address_lo, &db->prob_tbl_buffer_address_hi,
+        msg_.gpu_address + kProbsOffset);
+  }
+  dw[size_slot] = (n - size_slot + 3) * 4;
+
+  AmdgpuVcn::Flush(msg_, msg_.size);
+  AmdgpuVcn::Flush(ib_, ib_.size);
+  uint32_t fence = 0;
+  return vcn_->Submit(ib_.gpu_address, n, &fence) && vcn_->WaitFence(fence);
+}
