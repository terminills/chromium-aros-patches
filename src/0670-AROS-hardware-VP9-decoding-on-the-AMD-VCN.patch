index 4e5e87e710..271a9d9413 100644
--- a/media/gpu/aros/aros_amdgpu.cc
+++ b/media/gpu/aros/aros_amdgpu.cc
@@ -12,6 +12,7 @@
 #include <proto/exec.h>
 
 #include <mutex>
+#include <vector>
 
 namespace media::aros {
 
@@ -45,6 +46,11 @@ F Vec(void* base, int lvo) {
 AmdgpuVcn* g_vcn = nullptr;
 std::once_flag g_once;
 
+// amdgpu.hidd never hands out a GART address twice, so released buffers are
+// kept here and reused rather than given back.
+std::mutex g_cache_lock;
+std::vector<AmdgpuBuffer>* g_cache = nullptr;
+
 }  // namespace
 
 // static
@@ -86,6 +92,25 @@ bool AmdgpuVcn::Alloc(size_t size, AmdgpuBuffer* out) {
 
   *out = AmdgpuBuffer();
   size = (size + 4095) & ~static_cast<size_t>(4095);
+  {
+    std::lock_guard<std::mutex> lock(g_cache_lock);
+    if (g_cache) {
+      size_t best = g_cache->size();
+      for (size_t i = 0; i < g_cache->size(); ++i) {
+        const size_t have = (*g_cache)[i].size;
+        if (have >= size && have <= size * 2 &&
+            (best == g_cache->size() || have < (*g_cache)[best].size)) {
+          best = i;
+        }
+      }
+      if (best != g_cache->size()) {
+        *out = (*g_cache)[best];
+        g_cache->erase(g_cache->begin() + best);
+        memset(out->cpu, 0, out->size);
+        return true;
+      }
+    }
+  }
   if (Vec<LONG (*)(void*, UQUAD, UQUAD, ULONG, ULONG, ULONG*)>(base_, kBoAlloc)(
           device_, size, 4096, kDomainGtt, 0, &bo)) {
     return false;
@@ -97,13 +122,13 @@ bool AmdgpuVcn::Alloc(size_t size, AmdgpuBuffer* out) {
           base_, kVaRangeAlloc)(device_, size, 4096, 0, &va, &address)) {
     out->cpu = static_cast<uint8_t*>(cpu);
     out->va = va;
-    Free(out);
+    Release(out);
     return false;
   }
   out->cpu = static_cast<uint8_t*>(cpu);
   out->va = va;
   if (Vec<LONG (*)(void*, ULONG, ULONG)>(base_, kBoVaBind)(device_, bo, va)) {
-    Free(out);
+    Release(out);
     return false;
   }
   out->gpu_address = address;
@@ -112,6 +137,19 @@ bool AmdgpuVcn::Alloc(size_t size, AmdgpuBuffer* out) {
 }
 
 void AmdgpuVcn::Free(AmdgpuBuffer* buffer) {
+  if (buffer->gpu_address && buffer->cpu) {
+    std::lock_guard<std::mutex> lock(g_cache_lock);
+    if (!g_cache) {
+      g_cache = new std::vector<AmdgpuBuffer>();
+    }
+    g_cache->push_back(*buffer);
+    *buffer = AmdgpuBuffer();
+    return;
+  }
+  Release(buffer);
+}
+
+void AmdgpuVcn::Release(AmdgpuBuffer* buffer) {
   if (buffer->gpu_address) {
     Vec<LONG (*)(void*, ULONG)>(base_, kBoVaUnbind)(device_, buffer->va);
   }
