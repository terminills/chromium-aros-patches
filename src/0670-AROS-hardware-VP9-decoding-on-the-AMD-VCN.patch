+class ArosVP9Picture : public VP9Picture {
+ public:
+  ArosVP9Picture() = default;
+  scoped_refptr<VideoFrame> frame;
+  uint8_t dpb_index = aros::kVcnVp9NoPicture;
+
+ private:
+  ~ArosVP9Picture() override = default;
+};
+
+scoped_refptr<VideoFrame> CopyNV12(const uint8_t* y,
+                                   const uint8_t* uv,
+                                   size_t stride,
+                                   uint32_t width,
+                                   uint32_t height) {
+  const gfx::Size coded(width, height);
+  scoped_refptr<VideoFrame> frame = VideoFrame::CreateFrame(
+      PIXEL_FORMAT_NV12, coded, gfx::Rect(coded), coded, base::TimeDelta());
+  if (!frame) {
+    return nullptr;
+  }
+  for (uint32_t row = 0; row < height; ++row) {
+    memcpy(frame->writable_data(VideoFrame::kYPlane) +
+               row * frame->stride(VideoFrame::kYPlane),
+           y + row * stride, width);
+  }
+  for (uint32_t row = 0; row < (height + 1) / 2; ++row) {
+    memcpy(frame->writable_data(VideoFrame::kUVPlane) +
+               row * frame->stride(VideoFrame::kUVPlane),
+           uv + row * stride, (width + 1) & ~1u);
+  }
+  return frame;
+}
+
+class ArosVcnVP9Accelerator : public VP9Decoder::VP9Accelerator {
+ public:
+  explicit ArosVcnVP9Accelerator(ArosVcnVideoDecoder* owner) : owner_(owner) {}
+
+  scoped_refptr<VP9Picture> CreateVP9Picture() override {
+    return base::MakeRefCounted<ArosVP9Picture>();
+  }
+
+  Status SubmitDecode(scoped_refptr<VP9Picture> pic,
+                      const Vp9SegmentationParams& seg,
+                      const Vp9LoopFilterParams& lf,
+                      const Vp9ReferenceFrameVector& refs) override {
+    const Vp9FrameHeader* hdr = pic->frame_hdr.get();
+    const bool profile2 = hdr->profile == 2;
+    if (!session_.created() || session_.profile2() != profile2) {
+      if (!session_.Create(hdr->frame_width, hdr->frame_height, profile2)) {
+        VcnLog("[Chromium:AROS:VCN] VP9 session %dx%d could not be created\n",
+               hdr->frame_width, hdr->frame_height);
+        return Status::kFail;
+      }
+      VcnLog("[Chromium:AROS:VCN] VP9 session %dx%d profile %d\n",
+             hdr->frame_width, hdr->frame_height, hdr->profile);
+    }
+
+    aros::VcnVp9Frame f;
+    const bool keyframe = hdr->IsKeyframe();
+    uint8_t valid = aros::kVcnVp9NoPicture;
+    for (size_t k = 0; k < 8; ++k) {
+      f.ref_frame_map[k] = aros::kVcnVp9NoPicture;
+      if (keyframe) {
+        continue;
+      }
+      scoped_refptr<VP9Picture> ref = refs.GetFrame(k);
+      if (!ref) {
+        continue;
+      }
+      const uint8_t idx = static_cast<ArosVP9Picture*>(ref.get())->dpb_index;
+      f.ref_frame_map[k] = idx;
+      if (idx < aros::kVcnVp9MaxPictures) {
+        valid = idx;
+      }
+    }
+    for (size_t k = 0; k < 8; ++k) {
+      if (!keyframe && refs.GetFrame(k) &&
+          f.ref_frame_map[k] >= aros::kVcnVp9MaxPictures) {
+        f.ref_frame_map[k] = valid < aros::kVcnVp9MaxPictures ? valid : 0;
+      }
+    }
+    uint8_t curr = 0;
+    for (; curr < aros::kVcnVp9MaxPictures; ++curr) {
+      bool used = false;
+      for (size_t k = 0; k < 8; ++k) {
+        used |= f.ref_frame_map[k] == curr;
+      }
+      if (!used) {
+        break;
+      }
+    }
+    if (curr >= aros::kVcnVp9MaxPictures) {
+      return Status::kFail;
+    }
+    static_cast<ArosVP9Picture*>(pic.get())->dpb_index = curr;
+    f.curr_pic_idx = curr;
+
+    f.width = hdr->frame_width;
+    f.height = hdr->frame_height;
+    const bool use_prev_mvs = prev_show_frame_ && !hdr->error_resilient_mode &&
+                              prev_width_ == hdr->frame_width &&
+                              prev_height_ == hdr->frame_height;
+    uint32_t flags = 0;
+    flags |= (keyframe ? 0u : 1u) << 1;
+    flags |= hdr->error_resilient_mode << 2;
+    flags |= hdr->intra_only << 3;
+    flags |= hdr->allow_high_precision_mv << 4;
+    flags |= hdr->refresh_frame_context << 5;
+    flags |= hdr->frame_parallel_decoding_mode << 6;
+    flags |= seg.enabled << 7;
+    flags |= (seg.enabled && seg.update_map) << 8;
+    flags |= (seg.enabled && seg.temporal_update) << 9;
+    flags |= seg.update_data << 10;
+    flags |= lf.delta_enabled << 11;
+    flags |= lf.delta_update << 12;
+    flags |= use_prev_mvs << 13;
+    flags |= 1u << 14;
+    f.frame_header_flags = flags;
+    f.frame_context_idx = hdr->frame_context_idx_to_save_probs;
+    f.reset_frame_context = hdr->reset_frame_context;
+    f.interp_filter = static_cast<uint8_t>(hdr->interpolation_filter);
+    f.filter_level = lf.level;
+    f.sharpness_level = lf.sharpness;
+    if (lf.level) {
+      for (int i = 0; i < 8; ++i) {
+        for (int r = 0; r < 4; ++r) {
+          for (int m = 0; m < 2; ++m) {
+            f.lf_adj_level[i][r][m] = lf.lvl[i][r][m];
+          }
+        }
+      }
+    }
+    if (!hdr->quant_params.IsLossless()) {
+      f.base_qindex = hdr->quant_params.base_q_idx;
+      f.y_dc_delta_q = hdr->quant_params.delta_q_y_dc;
+      f.uv_ac_delta_q = hdr->quant_params.delta_q_uv_ac;
+      f.uv_dc_delta_q = hdr->quant_params.delta_q_uv_dc;
+    }
+    f.log2_tile_cols = hdr->tile_cols_log2;
+    f.log2_tile_rows = hdr->tile_rows_log2;
+    for (int n = 0; n < 3; ++n) {
+      f.frame_refs[n] = f.ref_frame_map[hdr->ref_frame_idx[n]];
+      f.ref_frame_sign_bias[n] = hdr->ref_frame_sign_bias[n + 1];
+    }
+    f.bit_depth = hdr->bit_depth;
+    f.compressed_header_size = hdr->header_size_in_bytes;
+    f.uncompressed_header_size = hdr->uncompressed_header_size;
+
+    f.segmentation_enabled = seg.enabled;
+    if (seg.enabled) {
+      using S = Vp9SegmentationParams;
+      for (int i = 0; i < 8; ++i) {
+        f.seg_feature_data[i] =
+            (seg.FeatureData(i, S::SEG_LVL_ALT_Q) & 0xffff) |
+            ((seg.FeatureData(i, S::SEG_LVL_ALT_LF) & 0xff) << 16) |
+            ((seg.FeatureData(i, S::SEG_LVL_REF_FRAME) & 0xf) << 24);
+        f.seg_feature_mask[i] =
+            seg.FeatureEnabled(i, S::SEG_LVL_ALT_Q) |
+            (seg.FeatureEnabled(i, S::SEG_LVL_ALT_LF) << 1) |
+            (seg.FeatureEnabled(i, S::SEG_LVL_REF_FRAME) << 2) |
+            (seg.FeatureEnabled(i, S::SEG_LVL_SKIP) << 3);
+      }
+      memcpy(f.seg_tree_probs, seg.tree_probs, sizeof(f.seg_tree_probs));
+      memcpy(f.seg_pred_probs, seg.pred_probs, sizeof(f.seg_pred_probs));
+      f.seg_abs_delta = seg.abs_or_delta_update;
+    }
+
+    prev_show_frame_ = hdr->show_frame;
+    prev_width_ = hdr->frame_width;
+    prev_height_ = hdr->frame_height;
+
+    if (!session_.Decode(f, hdr->data, hdr->frame_size)) {
+      VcnLog("[Chromium:AROS:VCN] VP9 decode failed (%dx%d, picture %d)\n",
+             hdr->frame_width, hdr->frame_height, curr);
+      return Status::kFail;
+    }
+    scoped_refptr<VideoFrame> frame =
+        CopyNV12(session_.y_plane(), session_.uv_plane(), session_.stride(),
+                 hdr->frame_width, hdr->frame_height);
+    if (!frame) {
+      return Status::kFail;
+    }
+    static_cast<ArosVP9Picture*>(pic.get())->frame = std::move(frame);
+    return Status::kOk;
+  }
+
+  bool OutputPicture(scoped_refptr<VP9Picture> pic) override {
+    auto* p = static_cast<ArosVP9Picture*>(pic.get());
+    if (!p->frame) {
+      return false;
+    }
+    owner_->OutputFrame(p->frame, pic->bitstream_id(), pic->visible_rect());
+    return true;
+  }
+
+  bool NeedsCompressedHeaderParsed() const override { return false; }
+
+ private:
+  const raw_ptr<ArosVcnVideoDecoder> owner_;
+  aros::VcnVp9Session session_;
+  bool prev_show_frame_ = false;
+  uint32_t prev_width_ = 0, prev_height_ = 0;
+};
+
