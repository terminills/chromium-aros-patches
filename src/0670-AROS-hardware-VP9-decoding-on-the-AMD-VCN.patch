+  bool segmentation_enabled = false;
+  uint32_t seg_feature_data[8] = {};
+  uint8_t seg_feature_mask[8] = {};
+  uint8_t seg_tree_probs[7] = {};
+  uint8_t seg_pred_probs[3] = {};
+  uint8_t seg_abs_delta = 0;
+};
+
+// One VCN VP9 decoding session with the dynamic (tier 2) DPB: one swizzled
+// DPB buffer per picture index, a linear NV12 target for output.
+class VcnVp9Session {
+ public:
+  VcnVp9Session();
+  ~VcnVp9Session();
+
+  VcnVp9Session(const VcnVp9Session&) = delete;
+  VcnVp9Session& operator=(const VcnVp9Session&) = delete;
+
+  bool Create(uint32_t width, uint32_t height, bool profile2);
+  void Destroy();
+  bool created() const { return created_; }
+  bool profile2() const { return profile2_; }
+
+  // Decodes one frame (uncompressed header, compressed header and tiles).
+  bool Decode(const VcnVp9Frame& frame, const uint8_t* data, size_t size);
+
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  const uint8_t* y_plane() const { return dt_.cpu; }
+  const uint8_t* uv_plane() const;
+  size_t stride() const { return dt_pitch_; }
+
+ private:
+  bool EnsureFrameBuffers(uint32_t width, uint32_t height);
+  bool EnsureDpb(int index);
+  bool Submit(bool decode);
+
+  AmdgpuVcn* vcn_ = nullptr;
+  bool created_ = false;
+  bool profile2_ = false;
+  uint32_t width_ = 0, height_ = 0;
+  uint32_t dt_pitch_ = 0, dt_height_ = 0;
+  uint32_t dpb_w_ = 0, dpb_h_ = 0;
+  uint32_t stream_handle_ = 0;
+  uint32_t frame_number_ = 0;
+  AmdgpuBuffer session_, msg_, ctx_, bs_, dt_, ib_;
+  AmdgpuBuffer dpb_[kVcnVp9MaxPictures];
+};
