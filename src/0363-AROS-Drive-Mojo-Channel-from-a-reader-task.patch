+#ifndef MOJO_CORE_CHANNEL_AROS_H_
+#define MOJO_CORE_CHANNEL_AROS_H_
+
+#include <vector>
+
+#include "base/containers/circular_deque.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/threading/platform_thread.h"
+#include "mojo/core/channel.h"
+#include "mojo/public/cpp/platform/aros_channel.h"
+
+namespace mojo::core {
+
+class ChannelAros final : public Channel,
+                          public base::PlatformThread::Delegate {
+ public:
+  ChannelAros(Channel::Delegate* delegate,
+              ConnectionParams connection_params,
+              HandlePolicy handle_policy,
+              scoped_refptr<base::SingleThreadTaskRunner> io_task_runner);
+
+  ChannelAros(const ChannelAros&) = delete;
+  ChannelAros& operator=(const ChannelAros&) = delete;
+
+  void Start() override;
+  void ShutDownImpl() override;
+  void Write(MessagePtr message) override;
+  void LeakHandle() override;
+  bool GetReadPlatformHandles(const void* payload,
+                              size_t payload_size,
+                              size_t num_handles,
+                              const void* extra_header,
+                              size_t extra_header_size,
+                              std::vector<PlatformHandle>* handles,
+                              bool* deferred) override;
+  bool GetReadPlatformHandlesForIpcz(
+      size_t num_handles,
+      std::vector<PlatformHandle>& handles) override;
+  bool OnControlMessage(Message::MessageType message_type,
+                        const void* payload,
+                        size_t payload_size,
+                        std::vector<PlatformHandle> handles) override;
+
+ private:
+  ~ChannelAros() override;
+
+  // base::PlatformThread::Delegate:
+  void ThreadMain() override;
+
+  void StartOnIOThread();
+  void ShutDownOnIOThread();
+  void ProcessPacket(ArosChannelPacket* packet);
+  void ReaderStopped(bool peer_closed);
+  void FinishShutdown();
+  void ReportWriteError();
+
+  scoped_refptr<Channel> self_;
+  scoped_refptr<base::SingleThreadTaskRunner> io_task_runner_;
+  ArosChannelHandle channel_;
+  base::PlatformThreadHandle reader_thread_;
+
+  base::Lock write_lock_;
+  bool reject_writes_ GUARDED_BY(write_lock_) = false;
+  bool shutdown_started_ = false;
+  bool leak_handle_ = false;
+  bool reader_started_ = false;
+  base::circular_deque<PlatformHandle> incoming_handles_;
+};
+
+}  // namespace mojo::core
+
+#endif  // MOJO_CORE_CHANNEL_AROS_H_
