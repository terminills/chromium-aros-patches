diff --git a/mojo/core/channel_aros.cc b/mojo/core/channel_aros.cc
new file mode 100644
index 0000000000..a073d13807
--- /dev/null
+++ b/mojo/core/channel_aros.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "mojo/core/channel_aros.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/metrics/histogram_macros.h"
+#include "base/task/single_thread_task_runner.h"
+#include "mojo/core/platform_handle_in_transit.h"
+#include "mojo/public/cpp/platform/platform_channel_endpoint.h"
+#include "mojo/public/cpp/platform/platform_handle.h"
+
+namespace mojo::core {
+
+ChannelAros::ChannelAros(
+    Channel::Delegate* delegate,
+    ConnectionParams connection_params,
+    HandlePolicy handle_policy,
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner)
+    : Channel(delegate, handle_policy),
+      self_(this),
+      io_task_runner_(std::move(io_task_runner)) {
+  channel_ = connection_params.TakeEndpoint()
+                 .TakePlatformHandle()
+                 .TakeArosChannel();
+  CHECK(channel_.is_valid());
+}
+
+ChannelAros::~ChannelAros() {
+  CHECK(reader_thread_.is_null());
+  CHECK(!channel_.is_valid() || leak_handle_);
+}
+
+void ChannelAros::Start() {
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ChannelAros::StartOnIOThread, this));
+}
+
+void ChannelAros::StartOnIOThread() {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  if (shutdown_started_)
+    return;
+  reader_started_ =
+      base::PlatformThread::Create(0, this, &reader_thread_);
+  if (!reader_started_) {
+    OnError(Error::kConnectionFailed);
+    FinishShutdown();
+  }
+}
+
+void ChannelAros::ShutDownImpl() {
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ChannelAros::ShutDownOnIOThread, this));
+}
+
+void ChannelAros::ShutDownOnIOThread() {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  if (shutdown_started_)
+    return;
+  shutdown_started_ = true;
+  {
+    base::AutoLock lock(write_lock_);
+    reject_writes_ = true;
+  }
+  if (!reader_started_) {
+    FinishShutdown();
+    return;
+  }
+  if (!SendArosChannelPacket(channel_, ArosChannelPacketType::kStop, nullptr,
+                             0, nullptr, 0)) {
+    // A live endpoint always accepts a self-directed stop packet.
+    CHECK(false);
+  }
+}
+
+void ChannelAros::ThreadMain() {
+  base::PlatformThread::SetName("MojoAROSReader");
+  MsgPort* port = StartReceivingArosChannel(channel_);
+  if (!port) {
+    io_task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ChannelAros::ReaderStopped, this, false));
+    return;
+  }
+
+  bool peer_closed = false;
+  for (;;) {
+    ArosChannelPacket* packet = WaitForArosChannelPacket(port);
+    if (!packet)
+      continue;
+    const ArosChannelPacketView view = GetArosChannelPacketView(packet);
+    if (view.type == ArosChannelPacketType::kStop) {
+      DestroyArosChannelPacket(packet);
+      break;
+    }
+    if (view.type == ArosChannelPacketType::kPeerClosed) {
+      DestroyArosChannelPacket(packet);
+      peer_closed = true;
+      break;
+    }
+    io_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(&ChannelAros::ProcessPacket, this, packet));
+  }
+
+  StopReceivingArosChannel(channel_, port);
+  io_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ChannelAros::ReaderStopped, this, peer_closed));
+}
+
+void ChannelAros::Write(MessagePtr message) {
+  if (ShouldRecordSubsampledHistograms()) {
+    UMA_HISTOGRAM_COUNTS_100000("Mojo.Channel.WriteMessageSize",
+                                message->data_num_bytes());
+    LogHistogramForIPCMetrics(MessageType::kSent);
+  }
+
+  {
+    base::AutoLock lock(write_lock_);
+    if (reject_writes_)
+      return;
+  }
+
+  std::vector<PlatformHandleInTransit> handles = message->TakeHandles();
+  std::vector<MojoPlatformHandle> encoded_handles(handles.size());
+  for (size_t i = 0; i < handles.size(); ++i) {
+    PlatformHandle::ToMojoPlatformHandle(handles[i].TakeHandle(),
+                                         &encoded_handles[i]);
+  }
+
+  if (SendArosChannelPacket(channel_, ArosChannelPacketType::kData,
+                            message->data(), message->data_num_bytes(),
+                            encoded_handles.data(), encoded_handles.size())) {
+    return;
+  }
+
+  // Encoding relinquished the PlatformHandle wrappers. Reconstitute ownership
+  // when the packet could not be allocated or the peer was already closed.
+  for (const MojoPlatformHandle& encoded : encoded_handles) {
+    PlatformHandle handle =
+        PlatformHandle::FromMojoPlatformHandle(&encoded);
+  }
+  {
+    base::AutoLock lock(write_lock_);
+    reject_writes_ = true;
+  }
+  io_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ChannelAros::ReportWriteError, this));
+}
+
+void ChannelAros::ReportWriteError() {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  OnError(Error::kDisconnected);
+}
+
+void ChannelAros::ProcessPacket(ArosChannelPacket* packet) {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  const ArosChannelPacketView view = GetArosChannelPacketView(packet);
+
+  for (size_t i = 0; i < view.handle_count; ++i) {
+    incoming_handles_.push_back(
+        PlatformHandle::FromMojoPlatformHandle(&view.handles[i]));
+  }
+  MarkArosChannelPacketHandlesConsumed(packet);
+
+  size_t offset = 0;
+  bool valid = true;
+  while (offset < view.data_size) {
+    size_t capacity = view.data_size - offset;
+    char* buffer = GetReadBuffer(&capacity);
+    CHECK_GT(capacity, 0u);
+    const size_t chunk = std::min(capacity, view.data_size - offset);
+    std::memcpy(buffer, static_cast<const char*>(view.data) + offset, chunk);
+    offset += chunk;
+    size_t next_read_size = 0;
+    if (!OnReadComplete(chunk, &next_read_size)) {
+      valid = false;
+      break;
+    }
+  }
+  DestroyArosChannelPacket(packet);
+  if (!valid)
+    OnError(Error::kReceivedMalformedData);
+}
+
+void ChannelAros::ReaderStopped(bool peer_closed) {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  if (peer_closed && !shutdown_started_)
+    OnError(Error::kDisconnected);
+  if (!shutdown_started_) {
+    shutdown_started_ = true;
+    base::AutoLock lock(write_lock_);
+    reject_writes_ = true;
+  }
+  FinishShutdown();
+}
+
+void ChannelAros::FinishShutdown() {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  if (!reader_thread_.is_null()) {
+    base::PlatformThread::Join(reader_thread_);
+    reader_thread_ = base::PlatformThreadHandle();
+  }
+  if (channel_.is_valid() && !leak_handle_) {
+    ReleaseArosChannelHandle(channel_);
+    channel_ = {};
+  }
+  self_ = nullptr;
+}
+
+void ChannelAros::LeakHandle() {
+  DCHECK(io_task_runner_->RunsTasksInCurrentSequence());
+  leak_handle_ = true;
+}
+
+bool ChannelAros::GetReadPlatformHandles(
+    const void* payload,
+    size_t payload_size,
+    size_t num_handles,
+    const void* extra_header,
+    size_t extra_header_size,
+    std::vector<PlatformHandle>* handles,
+    bool* deferred) {
+  if (num_handles > std::numeric_limits<uint16_t>::max())
+    return false;
+  return GetReadPlatformHandlesForIpcz(num_handles, *handles);
+}
+
+bool ChannelAros::GetReadPlatformHandlesForIpcz(
+    size_t num_handles,
+    std::vector<PlatformHandle>& handles) {
+  if (incoming_handles_.size() < num_handles)
+    return true;
+  DCHECK(handles.empty());
+  handles.reserve(num_handles);
+  while (num_handles--) {
+    handles.push_back(std::move(incoming_handles_.front()));
+    incoming_handles_.pop_front();
+  }
+  return true;
+}
+
+bool ChannelAros::OnControlMessage(
+    Message::MessageType message_type,
+    const void* payload,
+    size_t payload_size,
+    std::vector<PlatformHandle> handles) {
+  if (message_type != Message::MessageType::UPGRADE_OFFER)
+    return false;
+  Write(Message::CreateMessage(0, 0, Message::MessageType::UPGRADE_REJECT));
+  return true;
+}
+
+// AROS is POSIX-shaped for Chromium source selection, but its Mojo transport is
+// an Exec MessagePort channel and does not have a writev tuning mode.
+void Channel::set_posix_use_writev(bool use_writev) {}
+
+// static
+scoped_refptr<Channel> Channel::Create(
+    Delegate* delegate,
+    ConnectionParams connection_params,
+    HandlePolicy handle_policy,
+    scoped_refptr<base::SingleThreadTaskRunner> io_task_runner) {
+  return new ChannelAros(delegate, std::move(connection_params), handle_policy,
+                         std::move(io_task_runner));
+}
+
+}  // namespace mojo::core
