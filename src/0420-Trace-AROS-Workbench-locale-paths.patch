From 3608df56ab63b7a44a05575669d16a2938290122 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 29 Jul 2026 21:12:37 -0500
Subject: [PATCH 420/638] [AROS] Trace AROS Workbench locale paths

A fresh Workbench profile now crosses directory creation but fails the first locale CHECK. Record module, assets, locales, and en-US existence before ResourceBundle initialization so the next replay discriminates path resolution from pack loading.



---
 .../browser/chrome_resource_bundle_helper.cc  | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/chrome/browser/chrome_resource_bundle_helper.cc b/chrome/browser/chrome_resource_bundle_helper.cc
index 0cfc966050..1670d527a3 100644
--- a/chrome/browser/chrome_resource_bundle_helper.cc
+++ b/chrome/browser/chrome_resource_bundle_helper.cc
@@ -22,6 +22,7 @@
 #include "components/prefs/pref_service.h"
 #include "extensions/buildflags/buildflags.h"
 #include "ui/base/resource/resource_bundle.h"
+#include "ui/base/ui_base_paths.h"
 
 #if BUILDFLAG(IS_ANDROID)
 #include "ui/base/resource/resource_bundle_android.h"
@@ -100,6 +101,25 @@ std::string InitResourceBundleAndDetermineLocale(PrefService* local_state,
 
   TRACE_EVENT0("startup",
                "ChromeBrowserMainParts::InitResourceBundleAndDetermineLocale");
+#if BUILDFLAG(IS_AROS)
+  base::FilePath module_path;
+  base::FilePath assets_path;
+  base::FilePath locales_path;
+  const bool have_module =
+      base::PathService::Get(base::FILE_MODULE, &module_path);
+  const bool have_assets =
+      base::PathService::Get(base::DIR_ASSETS, &assets_path);
+  const bool have_locales =
+      base::PathService::Get(ui::DIR_LOCALES, &locales_path);
+  const base::FilePath en_us_path = locales_path.AppendASCII("en-US.pak");
+  LOG(WARNING) << "[Chromium:AROS:Locale] preferred='" << preferred_locale
+               << "' module=" << have_module << " '" << module_path.value()
+               << "' assets=" << have_assets << " '" << assets_path.value()
+               << "' locales=" << have_locales << " '"
+               << locales_path.value() << "' en-US-exists="
+               << base::PathExists(en_us_path) << " '"
+               << en_us_path.value() << "'";
+#endif
   // On a POSIX OS other than ChromeOS, the parameter that is passed to the
   // method InitSharedInstance is ignored.
   std::string actual_locale = ui::ResourceBundle::InitSharedInstanceWithLocale(
