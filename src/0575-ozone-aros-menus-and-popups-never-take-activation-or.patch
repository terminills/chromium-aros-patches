@@ -53,6 +53,15 @@ class ArosWindow : public PlatformWindow {
                      const gfx::Size& pixel_size,
                      const gfx::Rect& damage);
 
+  // Whether this window carries Chromium activation and keyboard focus of
+  // its own.  Menus, tooltips, popups and drag windows do not (the X11
+  // platform makes them override-redirect so the window manager never
+  // focuses them); Intuition still activates whichever window is clicked,
+  // so the activation those windows receive is credited to their focus
+  // owner instead, and the keys they receive are delivered there.
+  bool activatable() const { return activatable_; }
+  ArosWindow* FocusOwner();
+
  private:
   void Show(bool inactive) override;
   void Hide() override;
@@ -92,6 +101,11 @@ class ArosWindow : public PlatformWindow {
   bool BlitNativeBackingStore(const gfx::Rect& damage);
   void ResetNativeCursor();
   void DisableNativeEvents();
+  bool OwnsIntuitionActivation();
+  void SetActive(bool active);
+  void HandleActiveWindow();
+  void HandleInactiveWindow();
+  void ReturnIntuitionActivationToOwner();
   void DispatchMouseMove(uint16_t qualifier, int16_t mouse_x, int16_t mouse_y);
   void DispatchMouseButton(uint16_t code,
                            uint16_t qualifier,
@@ -117,6 +131,8 @@ class ArosWindow : public PlatformWindow {
   std::string title_;
   PlatformWindowState window_state_ = PlatformWindowState::kNormal;
   bool visible_ = false;
+  bool activatable_ = true;
+  gfx::AcceleratedWidget parent_widget_ = gfx::kNullAcceleratedWidget;
   bool active_ = false;
   bool capture_ = false;
   bool shutting_down_ = false;
diff --git a/ui/ozone/platform/aros/aros_window_manager.cc b/ui/ozone/platform/aros/aros_window_manager.cc
