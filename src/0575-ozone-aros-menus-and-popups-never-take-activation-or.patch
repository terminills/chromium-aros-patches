 #undef Remove
 
@@ -178,6 +180,30 @@ struct Window* ArosWindowManager::GetNativeWindow(
   return nullptr;
 }
 
+ArosWindow* ArosWindowManager::GetWindow(gfx::AcceleratedWidget widget) {
+  base::AutoLock lock(lock_);
+  const auto window_it = windows_.find(widget);
+  return window_it == windows_.end() ? nullptr : window_it->second.get();
+}
+
+ArosWindow* ArosWindowManager::GetWindowForNative(
+    struct Window* native_window) {
+  if (!native_window) {
+    return nullptr;
+  }
+  base::AutoLock lock(lock_);
+  const auto it = native_windows_.find(native_window);
+  return it == native_windows_.end() ? nullptr : it->second.get();
+}
+
+ArosWindow* ArosWindowManager::GetIntuitionActiveWindow() {
+  // intuitionbase.h: LockIBase() before reading the struct.
+  const ULONG ibase_lock = LockIBase(0);
+  struct Window* const active_window = IntuitionBase->ActiveWindow;
+  UnlockIBase(ibase_lock);
+  return GetWindowForNative(active_window);
+}
