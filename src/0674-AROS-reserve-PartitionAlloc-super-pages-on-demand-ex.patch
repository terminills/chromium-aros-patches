From 03ec2573f5263492893470e2decafb3bb8a9af59 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 14 Oct 2026 17:02:24 -0500
Subject: [PATCH 674/689] AROS: reserve PartitionAlloc super pages on demand
 (experiment)

AROS has no reserve-without-commit, so each size-aligned pool is a
physically backed block twice its size: the regular pool is capped at
1 GiB (Linux: 16 GiB) and is committed at startup. slack.com's carousel
of autoplay videos fills it with decoder frame buffers and Chromium
dies in OnNoMemoryInternal with 13 GB free.

Build AROS in PartitionAlloc's non-pool configuration: super pages are
reserved 2 MiB at a time wherever exec has room and tracked in a bitmap,
direct maps are released when freed. For 64-bit addresses: cover 256 GiB
(the bitmap is range-checked instead of spanning every uintptr_t),
uint32_t reservation offsets, count pool usage in place instead of
copying megabyte bitmaps onto the stack.

There is no pool range left to register with v8.library, so register
IsManagedByPartitionAlloc() as an owner check (v8.library 1.2).
---
 .../partition_allocator/partition_alloc.gni   |  5 ++
 .../partition_alloc/address_pool_manager.cc   | 17 +++++
 .../address_pool_manager_bitmap.h             | 19 ++++++
 .../partition_alloc/partition_alloc_config.h  |  2 +-
 .../reservation_offset_table.h                | 62 +++++++++++--------
 chrome/app/aros_v8_heap_owner.cc              | 58 +++++++++++++++++
 6 files changed, 137 insertions(+), 26 deletions(-)

diff --git a/base/allocator/partition_allocator/partition_alloc.gni b/base/allocator/partition_allocator/partition_alloc.gni
index 57e54222a5..56d2ad3681 100644
--- a/base/allocator/partition_allocator/partition_alloc.gni
+++ b/base/allocator/partition_allocator/partition_alloc.gni
@@ -20,6 +20,11 @@ is_clang_or_gcc = is_clang || !is_win
 if (is_nacl) {
   # NaCl targets don't use 64-bit pointers.
   has_64_bit_pointers = false
+} else if (is_aros) {
+  # AROS has no reserve-without-commit: a size-aligned pool is a physically
+  # backed block of twice its size. Take the configuration that reserves
+  # super pages one at a time, on demand, and tracks them in a bitmap.
+  has_64_bit_pointers = false
 } else if (current_cpu == "x64" || current_cpu == "arm64" ||
            current_cpu == "loong64" || current_cpu == "riscv64") {
   has_64_bit_pointers = true
diff --git a/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager.cc b/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager.cc
index d4b6f6af95..3d9b33deb0 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager.cc
+++ b/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager.cc
@@ -378,6 +378,10 @@ void AddressPoolManager::UnreserveAndDecommit(pool_handle handle,
 void AddressPoolManager::MarkUsed(pool_handle handle,
                                   uintptr_t address,
                                   size_t length) {
+#if BUILDFLAG(IS_AROS)
+  // Memory beyond the bitmap would be unmanaged and its bits out of range.
+  PA_CHECK(address + length <= AddressPoolManagerBitmap::kAddressSpaceSize);
+#endif
   ScopedGuard scoped_lock(AddressPoolManagerBitmap::GetLock());
   // When ENABLE_BACKUP_REF_PTR_SUPPORT is off, BRP pool isn't used.
 #if BUILDFLAG(ENABLE_BACKUP_REF_PTR_SUPPORT)
@@ -497,6 +501,18 @@ size_t CountUsedSuperPages(const std::bitset<bitsize>& bitmap,
 }  // namespace
 
 bool AddressPoolManager::GetStats(AddressSpaceStats* stats) {
+#if BUILDFLAG(IS_AROS)
+  // The bitmaps cover all of AROS's RAM, megabytes: count them in place
+  // rather than copy them onto the caller's stack.
+  static_assert(!BUILDFLAG(ENABLE_BACKUP_REF_PTR_SUPPORT));
+  constexpr size_t kBitsPerSuperPage =
+      kSuperPageSize /
+      AddressPoolManagerBitmap::kBytesPer1BitOfRegularPoolBitmap;
+  ScopedGuard scoped_lock(AddressPoolManagerBitmap::GetLock());
+  stats->regular_pool_stats.usage = CountUsedSuperPages(
+      AddressPoolManagerBitmap::regular_pool_bits_, kBitsPerSuperPage);
+  return true;
+#else
   std::bitset<AddressPoolManagerBitmap::kRegularPoolBits> regular_pool_bits;
   std::bitset<AddressPoolManagerBitmap::kBRPPoolBits> brp_pool_bits;
   {
@@ -544,6 +560,7 @@ bool AddressPoolManager::GetStats(AddressSpaceStats* stats) {
           std::memory_order_relaxed);
 #endif  // BUILDFLAG(ENABLE_BACKUP_REF_PTR_SUPPORT)
   return true;
+#endif  // BUILDFLAG(IS_AROS)
 }
 
 #endif  // BUILDFLAG(HAS_64_BIT_POINTERS)
diff --git a/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager_bitmap.h b/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager_bitmap.h
index a6f410269f..2e92628822 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager_bitmap.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/address_pool_manager_bitmap.h
@@ -32,7 +32,14 @@ namespace internal {
 class PA_COMPONENT_EXPORT(PARTITION_ALLOC) AddressPoolManagerBitmap {
  public:
   static constexpr uint64_t kGiB = 1024 * 1024 * 1024ull;
+#if BUILDFLAG(IS_AROS)
+  // AROS hands out addresses anywhere in physical memory: cover the RAM a
+  // machine can have, and check the range instead of relying on the bitmap
+  // spanning every uintptr_t.
+  static constexpr uint64_t kAddressSpaceSize = 256ull * kGiB;
+#else
   static constexpr uint64_t kAddressSpaceSize = 4ull * kGiB;
+#endif
 
   // For BRP pool, we use partition page granularity to eliminate the guard
   // pages from the bitmap at the ends:
@@ -77,11 +84,17 @@ class PA_COMPONENT_EXPORT(PARTITION_ALLOC) AddressPoolManagerBitmap {
 
   // Returns false for nullptr.
   static bool IsManagedByRegularPool(uintptr_t address) {
+#if BUILDFLAG(IS_AROS)
+    if (address >= kAddressSpaceSize) {
+      return false;
+    }
+#else
     static_assert(
         std::numeric_limits<uintptr_t>::max() >> kBitShiftOfRegularPoolBitmap <
             regular_pool_bits_.size(),
         "The bitmap is too small, will result in unchecked out of bounds "
         "accesses.");
+#endif
     // It is safe to read |regular_pool_bits_| without a lock since the caller
     // is responsible for guaranteeing that the address is inside a valid
     // allocation and the deallocation call won't race with this call.
@@ -91,10 +104,16 @@ class PA_COMPONENT_EXPORT(PARTITION_ALLOC) AddressPoolManagerBitmap {
 
   // Returns false for nullptr.
   static bool IsManagedByBRPPool(uintptr_t address) {
+#if BUILDFLAG(IS_AROS)
+    if (address >= kAddressSpaceSize) {
+      return false;
+    }
+#else
     static_assert(std::numeric_limits<uintptr_t>::max() >>
                       kBitShiftOfBRPPoolBitmap < brp_pool_bits_.size(),
                   "The bitmap is too small, will result in unchecked out of "
                   "bounds accesses.");
+#endif
     // It is safe to read |brp_pool_bits_| without a lock since the caller
     // is responsible for guaranteeing that the address is inside a valid
     // allocation and the deallocation call won't race with this call.
diff --git a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
index 7f755aac92..65329613af 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
@@ -32,7 +32,7 @@
 // configurations.
 #if BUILDFLAG(HAS_64_BIT_POINTERS)
 static_assert(sizeof(void*) == 8, "");
-#else
+#elif !BUILDFLAG(IS_AROS)
 static_assert(sizeof(void*) != 8, "");
