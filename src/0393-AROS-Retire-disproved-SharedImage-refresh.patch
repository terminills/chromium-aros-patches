From: terminills <tdeters@gmail.com>
Date: Wed, 29 Jul 2026 02:06:10 -0500
Subject: [PATCH 393/638] [AROS] Retire disproved SharedImage refresh

AI_PHASE: chromium-process-model

AI_STATUS: correction

OBSERVED: Runtime 34 proved that recreating the AROS SharedImage-backed SkImage wrapper on every read lock leaves the solid-red renderer viewport white despite intact renderer, Viz, resource-read, and native-present telemetry.

FIX_REASON: Remove the disproved semantic workaround before instrumenting the later software-renderer boundary, while retaining both the original candidate and its runtime failure in history.

SCOPE: Reverts only Chromium commit 357bff460a in display_resource_provider_software.cc.

VALIDATION: Revert applies cleanly and git diff --check passes; no unrelated dirty paths staged.

AI_DECISION_CHAIN: runtime 34
---
 .../display_resource_provider_software.cc     | 25 +++++--------------
 1 file changed, 6 insertions(+), 19 deletions(-)

diff --git a/components/viz/service/display/display_resource_provider_software.cc b/components/viz/service/display/display_resource_provider_software.cc
index c4d2342da2..771f03b66f 100644
--- a/components/viz/service/display/display_resource_provider_software.cc
+++ b/components/viz/service/display/display_resource_provider_software.cc
@@ -9,7 +9,6 @@
 
 #include "base/feature_list.h"
 #include "base/synchronization/waitable_event.h"
-#include "build/build_config.h"
 #include "components/viz/common/features.h"
 #include "components/viz/service/display/shared_bitmap_manager.h"
 #include "gpu/command_buffer/service/shared_image/shared_image_manager.h"
@@ -171,22 +170,11 @@ DisplayResourceProviderSoftware::ScopedReadLockSkImage::ScopedReadLockSkImage(
   }
   DCHECK(!resource->is_gpu_resource_type());
 
-  // Use cached SkImage if possible. AROS software SharedImages keep the same
-  // resource identity while raster updates mutate the shared pixmap. Reusing
-  // the immutable SkImage wrapper would also reuse its Skia unique identity,
-  // allowing stale sampling caches to hide the updated pixels.
-#if BUILDFLAG(IS_AROS)
-  const bool can_cache_sk_image =
-      !resource->transferable.mailbox_holder.mailbox.IsSharedImage();
-#else
-  const bool can_cache_sk_image = true;
-#endif
-  if (can_cache_sk_image) {
-    auto it = resource_provider_->resource_sk_images_.find(resource_id);
-    if (it != resource_provider_->resource_sk_images_.end()) {
-      sk_image_ = it->second;
-      return;
-    }
+  // Use cached SkImage if possible.
+  auto it = resource_provider_->resource_sk_images_.find(resource_id);
+  if (it != resource_provider_->resource_sk_images_.end()) {
+    sk_image_ = it->second;
+    return;
   }
 
   auto si_image_it =
@@ -202,8 +190,7 @@ DisplayResourceProviderSoftware::ScopedReadLockSkImage::ScopedReadLockSkImage(
   } else if (si_image_it != resource_provider->resource_shared_images_.end()) {
     sk_image_ = SkImages::RasterFromPixmap(
         si_image_it->second->read_access->pixmap(), nullptr, nullptr);
-    if (can_cache_sk_image)
-      resource_provider_->resource_sk_images_[resource_id] = sk_image_;
+    resource_provider_->resource_sk_images_[resource_id] = sk_image_;
   } else {
