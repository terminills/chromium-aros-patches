+                     : std::string("<none>"))
+             << " new_size=" << initial_props.new_size.ToString()
+             << " compositor_viewport="
+             << initial_props.compositor_viewport_pixel_rect.ToString();
+#endif
   return initial_props;
 }
 
@@ -1106,6 +1120,21 @@ blink::VisualProperties RenderWidgetHostImpl::GetVisualProperties() {
     visual_properties.local_surface_id = local_surface_id;
   }
 
+#if BUILDFLAG(IS_AROS)
+  static int aros_visual_properties_count = 0;
+  if (aros_visual_properties_count++ < 32) {
+    LOG(ERROR) << "[AROS_VISUAL] browser generated host=" << this
+               << " routing_id=" << GetRoutingID()
+               << " top_most=" << is_top_most_widget
+               << " child_frame=" << is_child_frame_widget
+               << " view_local_surface_id=" << local_surface_id.ToString()
+               << " local_surface_valid=" << local_surface_id.is_valid()
+               << " new_size=" << visual_properties.new_size.ToString()
+               << " compositor_viewport="
+               << visual_properties.compositor_viewport_pixel_rect.ToString();
+  }
+#endif
+
   if (screen_orientation_type_for_testing_) {
     current_screen_info.orientation_type =
         *screen_orientation_type_for_testing_;
@@ -1192,6 +1221,24 @@ bool RenderWidgetHostImpl::SynchronizeVisualProperties(
   visual_properties->scroll_focused_node_into_view =
       scroll_focused_node_into_view;
 
+#if BUILDFLAG(IS_AROS)
+  static int aros_visual_send_count = 0;
+  if (aros_visual_send_count++ < 32) {
+    LOG(ERROR) << "[AROS_VISUAL] browser send host=" << this
+               << " routing_id=" << GetRoutingID()
+               << " propagate=" << propagate
+               << " local_surface_valid="
+               << visual_properties->local_surface_id.has_value()
+               << " local_surface_id="
+               << (visual_properties->local_surface_id.has_value()
+                       ? visual_properties->local_surface_id->ToString()
+                       : std::string("<none>"))
+               << " new_size=" << visual_properties->new_size.ToString()
+               << " compositor_viewport="
+               << visual_properties->compositor_viewport_pixel_rect.ToString();
+  }
+#endif
+
   if (propagate) {
     blink_widget_->UpdateVisualProperties(*visual_properties);
   }
diff --git a/third_party/blink/renderer/platform/widget/widget_base.cc b/third_party/blink/renderer/platform/widget/widget_base.cc
