@@ -921,6 +922,19 @@ blink::VisualProperties RenderWidgetHostImpl::GetInitialVisualProperties() {
   // will be incorrect with a fresh RenderWidget.
   ResetStateForCreatedRenderWidget(initial_props);
 
+#if BUILDFLAG(IS_AROS)
