From 6bfd640e7c8ac959f5c92c70e110c72cd0e7f21e Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Wed, 29 Jul 2026 05:37:33 -0500
Subject: [PATCH 400/638] [AROS] Trace child surface identity propagation

Runtime 42 proves the regular child CompositorFrameSink route is bound, connected, and bidirectional, but the renderer receives begin frames without ever assigning or submitting a LocalSurfaceId.

Add bounded AROS-only telemetry at browser VisualProperties generation and send, renderer WidgetBase receive and apply, LayerTreeHost parent-ID acceptance, and LayerTreeHostImpl activation. This separates an absent browser allocation from a lost Mojo update or a compositor commit/activation failure.

AI_PHASE: chromium-process-model

AI_STATUS: diagnostic

AI_OBSERVED: The child sink receives 16 begin frames and returns 16 no-frame acknowledgements, with zero SetLocalSurfaceId calls or submissions.

AI_FIX_REASON: Observe the complete LocalSurfaceId handoff before changing visual-property or compositor semantics.

AI_SCOPE: render_widget_host_impl.cc, widget_base.cc, layer_tree_host.cc, and layer_tree_host_impl.cc only.

AI_VALIDATION: git diff --check; build and hosted runtime pending by design.

AI_DECISION_CHAIN: runtime42 working sink route -> browser visual properties -> renderer widget application -> compositor tree activation.
---
 cc/trees/layer_tree_host.cc                   | 13 +++++
 cc/trees/layer_tree_host_impl.cc              | 13 +++++
 .../renderer_host/render_widget_host_impl.cc  | 47 +++++++++++++++++++
 .../renderer/platform/widget/widget_base.cc   | 32 +++++++++++++
 4 files changed, 105 insertions(+)

diff --git a/cc/trees/layer_tree_host.cc b/cc/trees/layer_tree_host.cc
index ecd8ee4fcf..ad99c56fa5 100644
--- a/cc/trees/layer_tree_host.cc
+++ b/cc/trees/layer_tree_host.cc
@@ -1568,6 +1568,19 @@ void LayerTreeHost::SetExternalPageScaleFactor(
 
 void LayerTreeHost::SetLocalSurfaceIdFromParent(
     const viz::LocalSurfaceId& local_surface_id_from_parent) {
+#if BUILDFLAG(IS_AROS)
+  static int aros_parent_surface_count = 0;
+  if (aros_parent_surface_count++ < 32) {
+    LOG(ERROR) << "[AROS_VISUAL] layer host=" << this
+               << " old_local_surface_id="
+               << pending_commit_state()
+                      ->local_surface_id_from_parent.ToString()
+               << " new_local_surface_id="
+               << local_surface_id_from_parent.ToString()
+               << " new_local_surface_valid="
+               << local_surface_id_from_parent.is_valid();
+  }
+#endif
   // If the viz::LocalSurfaceId is invalid we will be hitting the early exit.
   // However creating a hash for tracing of an invalid id throw an error. So
   // exit here. This is either from unit testing where no ids are being setup,
diff --git a/cc/trees/layer_tree_host_impl.cc b/cc/trees/layer_tree_host_impl.cc
index 32c7422453..efe2b831d2 100644
--- a/cc/trees/layer_tree_host_impl.cc
+++ b/cc/trees/layer_tree_host_impl.cc
@@ -3466,6 +3466,19 @@ void LayerTreeHostImpl::ActivateSyncTree() {
     DidModifyTilePriorities();
 
   // Update the child's LocalSurfaceId.
+#if BUILDFLAG(IS_AROS)
+  static int aros_activate_surface_count = 0;
+  if (aros_activate_surface_count++ < 32) {
+    LOG(ERROR) << "[AROS_VISUAL] layer activate host_impl=" << this
+               << " parent_local_surface_id="
+               << active_tree()->local_surface_id_from_parent().ToString()
+               << " parent_local_surface_valid="
+               << active_tree()->local_surface_id_from_parent().is_valid()
+               << " child_local_surface_id="
+               << child_local_surface_id_allocator_.GetCurrentLocalSurfaceId()
+                      .ToString();
+  }
+#endif
   if (active_tree()->local_surface_id_from_parent().is_valid()) {
     child_local_surface_id_allocator_.UpdateFromParent(
         active_tree()->local_surface_id_from_parent());
