+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/common/chrome_paths_internal.h"
+
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace chrome {
+namespace {
+
+constexpr char kUserDataDirectory[] = "ENVARC:Chromium";
+constexpr char kUserCacheDirectory[] = "T:Chromium";
+constexpr char kVolatileUserDirectory[] = "RAM:";
+
+}  // namespace
+
+bool GetDefaultUserDataDirectory(base::FilePath* result) {
+  *result = base::FilePath(kUserDataDirectory);
+  return true;
+}
+
+void GetUserCacheDirectory(const base::FilePath& profile_dir,
+                           base::FilePath* result) {
+  *result = profile_dir;
+
+  base::FilePath user_data_dir;
+  if (!base::PathService::Get(DIR_USER_DATA, &user_data_dir)) {
+    return;
+  }
+
+  base::FilePath cache_dir(kUserCacheDirectory);
+  if (!user_data_dir.AppendRelativePath(profile_dir, &cache_dir)) {
+    return;
+  }
+
+  *result = cache_dir;
+}
+
+bool GetUserDocumentsDirectory(base::FilePath* result) {
+  *result = base::FilePath(kVolatileUserDirectory).Append("Documents");
+  return true;
+}
+
+bool GetUserDownloadsDirectory(base::FilePath* result) {
+  *result = base::FilePath(kVolatileUserDirectory);
+  return true;
+}
+
+bool GetUserMusicDirectory(base::FilePath* result) {
+  *result = base::FilePath(kVolatileUserDirectory);
+  return true;
+}
+
+bool GetUserPicturesDirectory(base::FilePath* result) {
+  *result = base::FilePath(kVolatileUserDirectory);
+  return true;
+}
+
+bool GetUserVideosDirectory(base::FilePath* result) {
+  *result = base::FilePath(kVolatileUserDirectory);
+  return true;
+}
+
+bool ProcessNeedsProfileDir(const std::string& process_type) {
+  return true;
+}
+
+}  // namespace chrome
