+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_AROS_CRASH_ANNOTATIONS_H_
+#define BASE_AROS_CRASH_ANNOTATIONS_H_
+
+#include <stddef.h>
+
+#include "base/base_export.h"
+
+namespace base::aros {
+
+// The process's crash annotation block: a fixed table of key/value strings
+// in public memory, registered with AROS exec under a well-known port name
+// so that the system CrashReporter (SYS:WBStartup/CrashReporter) can copy it
+// into the report when any of this process's tasks reaches Alert(). The
+// layout is CrashReporter's contract (crashreporter/annotations.h in the
+// AROS SDK; the .cc carries a mirror for SDKs that predate it).
+//
+// crash_reporter::CrashKeyString is implemented on top of this table
+// (components/crash/core/common/crash_key_aros.cc), so every crash key
+// Chromium already sets lands in the report without further plumbing.
+//
+// Entries are written without locking, from any thread: CrashReporter reads
+// them from the crashing task with bounded copies and tolerates torn values.
+
+inline constexpr size_t kCrashAnnotationKeySize = 40;    // incl. NUL
+inline constexpr size_t kCrashAnnotationValueSize = 128;  // incl. NUL
+inline constexpr size_t kCrashAnnotationEntries = 200;
+inline constexpr size_t kCrashAnnotationProductLength = 96;
+inline constexpr size_t kCrashAnnotationInvalidIndex = kCrashAnnotationEntries;
+
+// Creates and registers the block on first use. Returns false when exec
+// memory could not be obtained; every other call then becomes a no-op.
+BASE_EXPORT bool EnsureCrashAnnotationBlock();
+
+// "Chromium 124.0.6367.0" — the Product: header of the report.
+BASE_EXPORT void SetCrashAnnotationProduct(const char* product);
+
+// Stores |value| under |key| (both truncated to the slot sizes), reusing the
+// key's existing slot. Returns the slot index, or kCrashAnnotationInvalidIndex
+// when the table is full.
+BASE_EXPORT size_t SetCrashAnnotation(const char* key, const char* value);
+BASE_EXPORT void SetCrashAnnotationAtIndex(size_t index, const char* value);
+BASE_EXPORT void RemoveCrashAnnotationAtIndex(size_t index);
+// nullptr when |key| is not set; the pointer stays valid until the entry
+// is removed (it points into the table).
+BASE_EXPORT const char* GetCrashAnnotation(const char* key);
+
+}  // namespace base::aros
+
+#endif  // BASE_AROS_CRASH_ANNOTATIONS_H_
