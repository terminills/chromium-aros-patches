new file mode 100644
index 0000000000..52173a3e34
--- /dev/null
+++ b/components/crash/core/common/crash_key_aros.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// NOTE: This file is only compiled on AROS. It implements the Breakpad-style
+// crash key interface (crash_key.h) over the AROS CrashReporter annotation
+// block (base/aros/crash_annotations.h), so that crash keys set anywhere in
+// Chromium end up in the [Annotations] section of the system crash report.
+// The chunking logic mirrors crash_key_breakpad.cc.
+
+#include "components/crash/core/common/crash_key.h"
+
+#include "base/aros/crash_annotations.h"
+#include "base/debug/crash_logging.h"
+#include "base/format_macros.h"
+#include "base/strings/string_piece.h"
+#include "base/strings/stringprintf.h"
+#include "build/build_config.h"
+#include "components/crash/core/common/crash_key_base_support.h"
+
+#if !BUILDFLAG(IS_AROS)
+#error "This file is the AROS crash key implementation."
+#endif
+
+namespace crash_reporter {
+namespace internal {
+
+namespace {
+
+// String used to format chunked key names. The __1 through __N syntax is
+// recognized by the crash collector, which will then stitch the numbered
+// parts back into a single string value.
+const char kChunkFormatString[] = "%s__%" PRIuS;
+
+constexpr size_t kUnsetStorageSlotSentinel = kCrashKeyStorageNumEntries;
+
+static_assert(kCrashKeyStorageKeySize == base::aros::kCrashAnnotationKeySize);
+static_assert(kCrashKeyStorageValueSize ==
+              base::aros::kCrashAnnotationValueSize);
+static_assert(kCrashKeyStorageNumEntries ==
+              base::aros::kCrashAnnotationEntries);
+static_assert(kUnsetStorageSlotSentinel ==
+              base::aros::kCrashAnnotationInvalidIndex);
+
+}  // namespace
+
+void CrashKeyStringImpl::Set(base::StringPiece value) {
+  // This check cannot be in the constructor because it is constexpr. Use _LT
+  // rather than _LE to account for the terminating \0.
+  DCHECK_LT(strlen(name_), kCrashKeyStorageKeySize);
+
+  const size_t kValueMaxLength = index_array_count_ * kCrashKeyStorageValueSize;
+
+  value = value.substr(0, kValueMaxLength);
+
+  // If there is only one slot for the value, then handle it directly.
+  if (index_array_count_ == 1) {
+    std::string value_string(value);
+    if (is_set()) {
+      base::aros::SetCrashAnnotationAtIndex(index_array_[0],
+                                            value_string.c_str());
+    } else {
+      index_array_[0] =
+          base::aros::SetCrashAnnotation(name_, value_string.c_str());
+    }
+    return;
+  }
+
+  // If the value fits in a single slot, the name of the key should not
+  // end with the __1 suffix of the chunked format.
+  if (value.length() < kCrashKeyStorageValueSize - 1) {
+    std::string value_string(value);
+    if (index_array_[1] != kUnsetStorageSlotSentinel) {
+      // If switching from chunked to non-chunked, clear all the values.
+      Clear();
+      index_array_[0] =
+          base::aros::SetCrashAnnotation(name_, value_string.c_str());
+    } else if (index_array_[0] != kUnsetStorageSlotSentinel) {
+      // The single entry was previously set.
+      base::aros::SetCrashAnnotationAtIndex(index_array_[0],
+                                            value_string.c_str());
+    } else {
+      // This key was not previously set.
+      index_array_[0] =
+          base::aros::SetCrashAnnotation(name_, value_string.c_str());
+    }
+    return;
+  }
+
+  // If the key was previously set, but only using one slot, then the chunk
+  // name will change (from |name| to |name__1|).
+  if (index_array_[0] != kUnsetStorageSlotSentinel &&
+      index_array_[1] == kUnsetStorageSlotSentinel) {
+    base::aros::RemoveCrashAnnotationAtIndex(index_array_[0]);
+    index_array_[0] = kUnsetStorageSlotSentinel;
+  }
+
+  // Otherwise, break the value into chunks labeled name__1 through name__N,
+  // where N is |index_array_count_|.
+  size_t offset = 0;
+  for (size_t i = 0; i < index_array_count_; ++i) {
+    if (offset < value.length()) {
+      // The storage NUL-terminates the value, so ensure that a byte is
+      // not lost when setting individual chunks.
+      std::string chunk(value.substr(offset, kCrashKeyStorageValueSize - 1));
+      offset += chunk.length();
+
+      if (index_array_[i] == kUnsetStorageSlotSentinel) {
+        std::string chunk_name =
+            base::StringPrintf(kChunkFormatString, name_, i + 1);
+        index_array_[i] =
+            base::aros::SetCrashAnnotation(chunk_name.c_str(), chunk.c_str());
+      } else {
+        base::aros::SetCrashAnnotationAtIndex(index_array_[i], chunk.c_str());
+      }
+    } else {
+      base::aros::RemoveCrashAnnotationAtIndex(index_array_[i]);
+      index_array_[i] = kUnsetStorageSlotSentinel;
+    }
+  }
+}
+
+void CrashKeyStringImpl::Clear() {
+  for (size_t i = 0; i < index_array_count_; ++i) {
+    base::aros::RemoveCrashAnnotationAtIndex(index_array_[i]);
+    index_array_[i] = kUnsetStorageSlotSentinel;
+  }
+}
+
+bool CrashKeyStringImpl::is_set() const {
+  return index_array_[0] != kUnsetStorageSlotSentinel;
+}
+
+}  // namespace internal
+
+void InitializeCrashKeys() {
+  base::aros::EnsureCrashAnnotationBlock();
+  InitializeCrashKeyBaseSupport();
+}
+
+std::string GetCrashKeyValue(const std::string& key_name) {
+  const char* value = base::aros::GetCrashAnnotation(key_name.c_str());
+  if (value)
+    return value;
+  return std::string();
+}
+
+void InitializeCrashKeysForTesting() {
+  InitializeCrashKeys();
+}
+
+void ResetCrashKeysForTesting() {
+  // The block is process-wide and registered with exec; empty it rather
+  // than tear it down.
+  for (size_t i = 0; i < internal::kCrashKeyStorageNumEntries; ++i)
+    base::aros::RemoveCrashAnnotationAtIndex(i);
+  base::debug::SetCrashKeyImplementation(nullptr);
+}
+
+}  // namespace crash_reporter
