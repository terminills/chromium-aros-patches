new file mode 100644
index 0000000000..ed6ca8a3b9
--- /dev/null
+++ b/base/aros/crash_annotations.cc
@@ -0,0 +1,210 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/aros/crash_annotations.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+#include <exec/memory.h>
+#include <exec/nodes.h>
+#include <exec/ports.h>
+#include <exec/tasks.h>
+#include <proto/exec.h>
+
+#if __has_include(<crashreporter/annotations.h>)
+#include <crashreporter/annotations.h>
+#else
+// Mirror of crashreporter/annotations.h (AROS CrashReporter, contract v1).
+// Only ever append fields; the reader validates magic, version and sizes.
+#define CRA_PORTNAME "CrashReporter.annotations"
+#define CRA_MAGIC 0x43524131 /* 'CRA1' */
+#define CRA_VERSION 1
+#define CRA_KEYSIZE 40
+#define CRA_VALUESIZE 128
+#define CRA_PRODUCTLEN 96
+struct CrashAnnotationEntry {
+  TEXT cae_Key[CRA_KEYSIZE];
+  TEXT cae_Value[CRA_VALUESIZE];
+};
+struct CrashAnnotationBlock {
+  struct MsgPort cab_Port;
+  ULONG cab_Magic;
+  ULONG cab_Version;
+  ULONG cab_Size;
+  ULONG cab_Entries;
+  ULONG cab_KeySize;
+  ULONG cab_ValueSize;
+  struct Task* cab_Owner;
+  APTR cab_Reserved;
+  TEXT cab_Product[CRA_PRODUCTLEN];
+  struct CrashAnnotationEntry cab_Entry[0];
+};
+#define CRA_BLOCKSIZE(n) \
+  (sizeof(struct CrashAnnotationBlock) + (n) * sizeof(struct CrashAnnotationEntry))
+#endif
+
+static_assert(CRA_KEYSIZE == base::aros::kCrashAnnotationKeySize);
+static_assert(CRA_VALUESIZE == base::aros::kCrashAnnotationValueSize);
+static_assert(CRA_PRODUCTLEN == base::aros::kCrashAnnotationProductLength);
+
+namespace base::aros {
+
+namespace {
+
+constexpr ULONG kBlockSize = CRA_BLOCKSIZE(kCrashAnnotationEntries);
+
+CrashAnnotationBlock* g_block = nullptr;
+bool g_block_failed = false;
+
+// Serialises slot allocation and removal only; value writes are lock-free
+// by design (see the header).
+Lock& BlockLock() {
+  static NoDestructor<Lock> lock;
+  return *lock;
+}
+
+// TEXT is unsigned char on AROS; the block is byte storage.
+char* Chars(TEXT* p) {
+  return reinterpret_cast<char*>(p);
+}
+
+void CopyBounded(TEXT* dst_text, size_t dst_size, const char* src) {
+  char* dst = Chars(dst_text);
+  size_t n = src ? strnlen(src, dst_size - 1) : 0;
+  // Write the terminator first so a reader racing with a rewrite never
+  // sees a longer stale tail than the new value.
+  dst[n] = 0;
+  memcpy(dst, src, n);
+}
+
+void ReleaseBlock() {
+  CrashAnnotationBlock* block = g_block;
+  if (!block) {
+    return;
+  }
+  g_block = nullptr;
+  g_block_failed = true;
+  RemPort(&block->cab_Port);
+  FreeMem(block, kBlockSize);
+}
+
+CrashAnnotationBlock* Block() {
+  if (g_block || g_block_failed) {
+    return g_block;
+  }
+  AutoLock lock(BlockLock());
+  if (g_block || g_block_failed) {
+    return g_block;
+  }
+  CrashAnnotationBlock* block = static_cast<CrashAnnotationBlock*>(
+      AllocMem(kBlockSize, MEMF_PUBLIC | MEMF_CLEAR));
+  if (!block) {
+    g_block_failed = true;
+    return nullptr;
+  }
+  block->cab_Magic = CRA_MAGIC;
+  block->cab_Version = CRA_VERSION;
+  block->cab_Size = kBlockSize;
+  block->cab_Entries = kCrashAnnotationEntries;
+  block->cab_KeySize = CRA_KEYSIZE;
+  block->cab_ValueSize = CRA_VALUESIZE;
+  block->cab_Owner = FindTask(nullptr);
+  // The port is the registry entry only: nothing is ever PutMsg()'d to it.
+  block->cab_Port.mp_Node.ln_Name = const_cast<char*>(CRA_PORTNAME);
+  block->cab_Port.mp_Node.ln_Type = NT_MSGPORT;
+  block->cab_Port.mp_Node.ln_Pri = 0;
+  block->cab_Port.mp_Flags = PA_IGNORE;
+  block->cab_Port.mp_SigBit = 0;
+  block->cab_Port.mp_SigTask = nullptr;
+  NEWLIST(&block->cab_Port.mp_MsgList);
+  AddPort(&block->cab_Port);
+  atexit(ReleaseBlock);
+  g_block = block;
+  return block;
+}
+
+size_t FindKey(CrashAnnotationBlock* block, const char* key) {
+  for (size_t i = 0; i < kCrashAnnotationEntries; ++i) {
+    if (block->cab_Entry[i].cae_Key[0] &&
+        strncmp(Chars(block->cab_Entry[i].cae_Key), key, CRA_KEYSIZE) == 0) {
+      return i;
+    }
+  }
+  return kCrashAnnotationInvalidIndex;
+}
+
+}  // namespace
+
+bool EnsureCrashAnnotationBlock() {
+  return Block() != nullptr;
+}
+
+void SetCrashAnnotationProduct(const char* product) {
+  CrashAnnotationBlock* block = Block();
+  if (block) {
+    CopyBounded(block->cab_Product, CRA_PRODUCTLEN, product);
+  }
+}
+
+size_t SetCrashAnnotation(const char* key, const char* value) {
+  CrashAnnotationBlock* block = Block();
+  if (!block || !key || !key[0]) {
+    return kCrashAnnotationInvalidIndex;
+  }
+  AutoLock lock(BlockLock());
+  size_t index = FindKey(block, key);
+  if (index == kCrashAnnotationInvalidIndex) {
+    for (size_t i = 0; i < kCrashAnnotationEntries; ++i) {
+      if (!block->cab_Entry[i].cae_Key[0]) {
+        index = i;
+        break;
+      }
+    }
+    if (index == kCrashAnnotationInvalidIndex) {
+      return index;
+    }
+    // Value before key: a reader that sees the key sees a value.
+    CopyBounded(block->cab_Entry[index].cae_Value, CRA_VALUESIZE, value);
+    CopyBounded(block->cab_Entry[index].cae_Key, CRA_KEYSIZE, key);
+    return index;
+  }
+  CopyBounded(block->cab_Entry[index].cae_Value, CRA_VALUESIZE, value);
+  return index;
+}
+
+void SetCrashAnnotationAtIndex(size_t index, const char* value) {
+  CrashAnnotationBlock* block = Block();
+  if (!block || index >= kCrashAnnotationEntries) {
+    return;
+  }
+  CopyBounded(block->cab_Entry[index].cae_Value, CRA_VALUESIZE, value);
+}
+
+void RemoveCrashAnnotationAtIndex(size_t index) {
+  CrashAnnotationBlock* block = Block();
+  if (!block || index >= kCrashAnnotationEntries) {
+    return;
+  }
+  AutoLock lock(BlockLock());
+  block->cab_Entry[index].cae_Key[0] = 0;
+  block->cab_Entry[index].cae_Value[0] = 0;
+}
+
+const char* GetCrashAnnotation(const char* key) {
+  CrashAnnotationBlock* block = Block();
+  if (!block || !key) {
+    return nullptr;
+  }
+  AutoLock lock(BlockLock());
+  size_t index = FindKey(block, key);
+  return index == kCrashAnnotationInvalidIndex
+             ? nullptr
+             : Chars(block->cab_Entry[index].cae_Value);
+}
+
+}  // namespace base::aros
