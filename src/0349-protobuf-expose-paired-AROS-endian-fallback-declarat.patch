+#if !defined(PROTOBUF_LITTLE_ENDIAN) || defined(__AROS__)
   uint8_t* WriteRawLittleEndian32(const void* data, int size, uint8_t* ptr);
   uint8_t* WriteRawLittleEndian64(const void* data, int size, uint8_t* ptr);
 #endif
