+}
+
+void Lock(ArosChannelState* state) {
+  while (state->lock.test_and_set(std::memory_order_acquire)) {
+  }
+}
+
+void Unlock(ArosChannelState* state) {
+  state->lock.clear(std::memory_order_release);
+}
+
+MojoPlatformHandle* PacketHandles(ArosChannelPacket* packet) {
+  return reinterpret_cast<MojoPlatformHandle*>(packet + 1);
+}
+
+void* PacketData(ArosChannelPacket* packet) {
+  return PacketHandles(packet) + packet->handle_count;
+}
+
+ArosChannelPacket* CreatePacket(ArosChannelPacketType type,
+                                const void* data,
+                                size_t data_size,
+                                const MojoPlatformHandle* handles,
+                                size_t handle_count) {
+  if (handle_count >
+      (std::numeric_limits<size_t>::max() - sizeof(ArosChannelPacket)) /
+          sizeof(MojoPlatformHandle)) {
+    return nullptr;
+  }
+  const size_t handle_bytes = handle_count * sizeof(MojoPlatformHandle);
+  if (data_size > std::numeric_limits<size_t>::max() -
+                      sizeof(ArosChannelPacket) - handle_bytes) {
+    return nullptr;
+  }
+  const size_t allocation_size =
+      sizeof(ArosChannelPacket) + handle_bytes + data_size;
+  void* storage = AllocMem(allocation_size, MEMF_PUBLIC | MEMF_CLEAR);
+  if (!storage)
+    return nullptr;
+  auto* packet = new (storage) ArosChannelPacket;
+  packet->message.mn_Length = sizeof(ArosChannelPacket);
+  packet->type = type;
+  packet->allocation_size = allocation_size;
+  packet->data_size = data_size;
+  packet->handle_count = handle_count;
+  if (handle_count)
+    std::memcpy(PacketHandles(packet), handles, handle_bytes);
+  if (data_size)
+    std::memcpy(PacketData(packet), data, data_size);
+  return packet;
+}
+
+bool QueueOrDeliver(ArosChannelState* state,
+                    uint8_t target,
+                    ArosChannelPacket* packet,
+                    bool require_live_target = false) {
+  Lock(state);
+  if (require_live_target &&
+      state->side_references[target].load(std::memory_order_relaxed) == 0) {
+    Unlock(state);
+    DestroyArosChannelPacket(packet);
+    return false;
+  }
+  if (state->ports[target]) {
+    PutMsg(state->ports[target], &packet->message);
+  } else {
+    if (state->pending_tail[target])
+      state->pending_tail[target]->pending_next = packet;
+    else
+      state->pending_head[target] = packet;
+    state->pending_tail[target] = packet;
+  }
+  Unlock(state);
+  return true;
+}
+
+void ReleaseEncodedHandles(ArosChannelPacket* packet) {
+  for (size_t i = 0; i < packet->handle_count; ++i) {
+    PlatformHandle handle =
+        PlatformHandle::FromMojoPlatformHandle(&PacketHandles(packet)[i]);
+  }
 }
 
 }  // namespace
