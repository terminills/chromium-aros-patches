@@ -51,15 +154,117 @@ void ReleaseArosChannelHandle(ArosChannelHandle handle) {
   ArosChannelState* state = StateFor(handle);
   if (!state)
     return;
-  CHECK(IsValid(state));
+  CHECK(IsValid(handle));
+  const size_t previous_side =
+      state->side_references[handle.side].fetch_sub(1, std::memory_order_acq_rel);
+  CHECK_GT(previous_side, 0u);
+  if (previous_side == 1) {
+    if (ArosChannelPacket* packet =
+            CreatePacket(ArosChannelPacketType::kPeerClosed, nullptr, 0,
+                         nullptr, 0)) {
+      QueueOrDeliver(state, handle.side ^ 1, packet);
+    }
+  }
   const size_t previous =
       state->references.fetch_sub(1, std::memory_order_acq_rel);
   CHECK_GT(previous, 0u);
   if (previous != 1)
     return;
+  for (size_t side = 0; side < 2; ++side) {
+    ArosChannelPacket* packet = state->pending_head[side];
+    while (packet) {
+      ArosChannelPacket* next = packet->pending_next;
+      DestroyArosChannelPacket(packet);
+      packet = next;
+    }
+  }
   state->magic = 0;
   state->~ArosChannelState();
   FreeMem(state, sizeof(ArosChannelState));
 }
 
+MsgPort* StartReceivingArosChannel(ArosChannelHandle handle) {
+  if (!IsValid(handle))
+    return nullptr;
+  MsgPort* port = CreateMsgPort();
+  if (!port)
+    return nullptr;
+
+  ArosChannelState* state = StateFor(handle);
+  Lock(state);
+  CHECK(!state->ports[handle.side]);
+  state->ports[handle.side] = port;
+  ArosChannelPacket* packet = state->pending_head[handle.side];
+  state->pending_head[handle.side] = nullptr;
+  state->pending_tail[handle.side] = nullptr;
+  while (packet) {
+    ArosChannelPacket* next = packet->pending_next;
+    packet->pending_next = nullptr;
+    PutMsg(port, &packet->message);
+    packet = next;
+  }
+  Unlock(state);
+  return port;
+}
+
+void StopReceivingArosChannel(ArosChannelHandle handle, MsgPort* port) {
+  if (!port)
+    return;
+  ArosChannelState* state = StateFor(handle);
+  CHECK(IsValid(handle));
+  Lock(state);
+  CHECK_EQ(state->ports[handle.side], port);
+  state->ports[handle.side] = nullptr;
+  Unlock(state);
+
+  while (auto* message = GetMsg(port))
+    DestroyArosChannelPacket(reinterpret_cast<ArosChannelPacket*>(message));
+  DeleteMsgPort(port);
+}
+
+ArosChannelPacket* WaitForArosChannelPacket(MsgPort* port) {
+  CHECK(port);
+  WaitPort(port);
+  return reinterpret_cast<ArosChannelPacket*>(GetMsg(port));
+}
+
+ArosChannelPacketView GetArosChannelPacketView(ArosChannelPacket* packet) {
+  CHECK(packet);
+  return {packet->type, PacketData(packet), packet->data_size,
+          PacketHandles(packet), packet->handle_count};
+}
+
+void MarkArosChannelPacketHandlesConsumed(ArosChannelPacket* packet) {
+  CHECK(packet);
+  packet->handle_count = 0;
+}
+
+void DestroyArosChannelPacket(ArosChannelPacket* packet) {
+  if (!packet)
+    return;
+  ReleaseEncodedHandles(packet);
+  const size_t allocation_size = packet->allocation_size;
+  packet->~ArosChannelPacket();
+  FreeMem(packet, allocation_size);
+}
+
+bool SendArosChannelPacket(ArosChannelHandle handle,
+                           ArosChannelPacketType type,
+                           const void* data,
+                           size_t data_size,
+                           const MojoPlatformHandle* handles,
+                           size_t handle_count) {
+  if (!IsValid(handle))
+    return false;
+  ArosChannelState* state = StateFor(handle);
+  ArosChannelPacket* packet =
+      CreatePacket(type, data, data_size, handles, handle_count);
+  if (!packet)
+    return false;
+  const uint8_t target =
+      type == ArosChannelPacketType::kStop ? handle.side : handle.side ^ 1;
+  return QueueOrDeliver(state, target, packet,
+                        type == ArosChannelPacketType::kData);
+}
+
 }  // namespace mojo
