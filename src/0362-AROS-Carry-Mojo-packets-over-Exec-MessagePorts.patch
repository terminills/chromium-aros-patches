-bool IsValid(const ArosChannelState* state) {
-  return state && state->magic == ArosChannelState::kMagic;
+bool IsValid(ArosChannelHandle handle) {
+  ArosChannelState* state = StateFor(handle);
+  return state && handle.side < 2 &&
