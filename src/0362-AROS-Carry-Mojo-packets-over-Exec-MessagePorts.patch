@@ -0,0 +1,168 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <atomic>
+#include <cstring>
+#include <utility>
+
+#include <aros/debug.h>
+
+#include "base/at_exit.h"
+#include "base/threading/platform_thread.h"
+#include "mojo/public/cpp/platform/aros_channel.h"
+#include "mojo/public/cpp/platform/platform_handle.h"
+
+namespace {
+
+constexpr char kEarlyPayload[] = "queued-before-receiver";
+constexpr char kReplyPayload[] = "duplex-reply";
+constexpr char kHandlePayload[] = "transferred-handle";
+
+bool PayloadEquals(const mojo::ArosChannelPacketView& view,
+                   const char* expected,
+                   size_t expected_size) {
+  return view.type == mojo::ArosChannelPacketType::kData &&
+         view.data_size == expected_size &&
+         std::memcmp(view.data, expected, expected_size) == 0;
+}
+
+class Receiver final : public base::PlatformThread::Delegate {
+ public:
+  explicit Receiver(mojo::ArosChannelHandle channel) : channel_(channel) {}
+
+  void ThreadMain() override {
+    MsgPort* port = mojo::StartReceivingArosChannel(channel_);
+    if (!port) {
+      result_.store(10, std::memory_order_release);
+      return;
+    }
+
+    mojo::ArosChannelPacket* packet =
+        mojo::WaitForArosChannelPacket(port);
+    mojo::ArosChannelPacketView view =
+        mojo::GetArosChannelPacketView(packet);
+    if (!PayloadEquals(view, kEarlyPayload, sizeof(kEarlyPayload)) ||
+        view.handle_count != 1) {
+      mojo::DestroyArosChannelPacket(packet);
+      result_.store(11, std::memory_order_release);
+      return;
+    }
+
+    mojo::PlatformHandle transferred =
+        mojo::PlatformHandle::FromMojoPlatformHandle(&view.handles[0]);
+    mojo::MarkArosChannelPacketHandlesConsumed(packet);
+    mojo::DestroyArosChannelPacket(packet);
+    if (!transferred.is_aros_channel()) {
+      result_.store(12, std::memory_order_release);
+      return;
+    }
+
+    mojo::ArosChannelHandle transferred_channel =
+        transferred.TakeArosChannel();
+    if (!mojo::SendArosChannelPacket(
+            transferred_channel, mojo::ArosChannelPacketType::kData,
+            kHandlePayload, sizeof(kHandlePayload), nullptr, 0)) {
+      mojo::ReleaseArosChannelHandle(transferred_channel);
+      result_.store(13, std::memory_order_release);
+      return;
+    }
+    mojo::ReleaseArosChannelHandle(transferred_channel);
+
+    if (!mojo::SendArosChannelPacket(
+            channel_, mojo::ArosChannelPacketType::kData, kReplyPayload,
+            sizeof(kReplyPayload), nullptr, 0)) {
+      result_.store(14, std::memory_order_release);
+      return;
+    }
+
+    packet = mojo::WaitForArosChannelPacket(port);
+    view = mojo::GetArosChannelPacketView(packet);
+    const bool peer_closed =
+        view.type == mojo::ArosChannelPacketType::kPeerClosed;
+    mojo::DestroyArosChannelPacket(packet);
+    mojo::StopReceivingArosChannel(channel_, port);
+    mojo::ReleaseArosChannelHandle(std::exchange(channel_, {}));
+    result_.store(peer_closed ? 0 : 15, std::memory_order_release);
+  }
+
+  int result() const { return result_.load(std::memory_order_acquire); }
+
+ private:
+  mojo::ArosChannelHandle channel_;
+  std::atomic_int result_{99};
+};
+
+}  // namespace
+
+int main() {
+  base::AtExitManager at_exit_manager;
+
+  auto channel = mojo::CreateArosChannelPair();
+  auto transferred = mojo::CreateArosChannelPair();
+  if (!channel.first.is_valid() || !channel.second.is_valid() ||
+      !transferred.first.is_valid() || !transferred.second.is_valid()) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL allocation\n");
+    return 20;
+  }
+
+  MsgPort* local_port = mojo::StartReceivingArosChannel(channel.first);
+  MsgPort* transferred_port =
+      mojo::StartReceivingArosChannel(transferred.second);
+  if (!local_port || !transferred_port) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL receiver setup\n");
+    return 21;
+  }
+
+  mojo::PlatformHandle attached(transferred.first);
+  transferred.first = {};
+  MojoPlatformHandle encoded = {};
+  mojo::PlatformHandle::ToMojoPlatformHandle(std::move(attached), &encoded);
+  if (!mojo::SendArosChannelPacket(
+          channel.first, mojo::ArosChannelPacketType::kData, kEarlyPayload,
+          sizeof(kEarlyPayload), &encoded, 1)) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL early send\n");
+    return 22;
+  }
+
+  Receiver receiver(channel.second);
+  channel.second = {};
+  base::PlatformThreadHandle receiver_thread;
+  if (!base::PlatformThread::Create(0, &receiver, &receiver_thread)) {
+    bug("[Mojo:AROS:ChannelProbe] FAIL thread create\n");
+    return 23;
+  }
+
+  mojo::ArosChannelPacket* packet =
+      mojo::WaitForArosChannelPacket(transferred_port);
+  mojo::ArosChannelPacketView view =
+      mojo::GetArosChannelPacketView(packet);
+  const bool transferred_ok =
+      PayloadEquals(view, kHandlePayload, sizeof(kHandlePayload));
+  mojo::DestroyArosChannelPacket(packet);
+
+  packet = mojo::WaitForArosChannelPacket(local_port);
+  view = mojo::GetArosChannelPacketView(packet);
+  const bool duplex_ok =
+      PayloadEquals(view, kReplyPayload, sizeof(kReplyPayload));
+  mojo::DestroyArosChannelPacket(packet);
+
+  mojo::StopReceivingArosChannel(transferred.second, transferred_port);
+  mojo::ReleaseArosChannelHandle(std::exchange(transferred.second, {}));
+  mojo::StopReceivingArosChannel(channel.first, local_port);
+  mojo::ReleaseArosChannelHandle(std::exchange(channel.first, {}));
+
+  base::PlatformThread::Join(receiver_thread);
+  const int receiver_result = receiver.result();
+  if (!transferred_ok || !duplex_ok || receiver_result != 0) {
+    bug(
+        "[Mojo:AROS:ChannelProbe] FAIL transferred=%d duplex=%d receiver=%d\n",
+        transferred_ok, duplex_ok, receiver_result);
+    return 24;
+  }
+
+  bug(
+      "[Mojo:AROS:ChannelProbe] PASS queued=1 duplex=1 handles=1 "
+      "peer_close=1\n");
+  return 0;
+}
