diff --git a/third_party/libevent/event-config.h b/third_party/libevent/event-config.h
index 22c4b2e6fb..1f77919ca6 100644
--- a/third_party/libevent/event-config.h
+++ b/third_party/libevent/event-config.h
@@ -17,6 +17,8 @@
 #include "third_party/libevent/solaris/event-config.h"
 #elif defined(_AIX)
 #include "third_party/libevent/aix/event-config.h"
+#elif defined(__AROS__)
+#include "third_party/libevent/aros/event-config.h"
 #else
 #error generate event-config.h for your platform
 #endif
diff --git a/third_party/libevent/evutil.c b/third_party/libevent/evutil.c
index cc6d0f46a9..191175fa06 100644
--- a/third_party/libevent/evutil.c
+++ b/third_party/libevent/evutil.c
@@ -64,7 +64,14 @@
 int
 evutil_socketpair(int family, int type, int protocol, int fd[2])
 {
-#ifndef WIN32
+#if defined(__AROS__)
+	(void)family;
+	(void)type;
+	(void)protocol;
+	(void)fd;
+	errno = ENOSYS;
+	return -1;
+#elif !defined(WIN32)
 	return socketpair(family, type, protocol, fd);
 #else
 	/* This code is originally from Tor.  Used with permission. */
diff --git a/third_party/libevent/signal.c b/third_party/libevent/signal.c
index b8d51ab519..8352480096 100644
--- a/third_party/libevent/signal.c
+++ b/third_party/libevent/signal.c
@@ -85,7 +85,11 @@ evsignal_cb(int fd, short what, void *arg)
 	ssize_t n;
 #endif
 
+#ifdef __AROS__
+	n = read(fd, signals, sizeof(signals));
+#else
 	n = recv(fd, signals, sizeof(signals), 0);
+#endif
 	if (n == -1) {
 		int err = EVUTIL_SOCKET_ERROR();
 		if (! error_is_eagain(err))
@@ -316,7 +320,11 @@ evsignal_handler(int sig)
 #endif
 
 	/* Wake up our notification mechanism */
+#ifdef __AROS__
+	write(evsignal_base->sig.ev_signal_pair[0], "a", 1);
+#else
 	send(evsignal_base->sig.ev_signal_pair[0], "a", 1, 0);
+#endif
 	errno = save_errno;
 }
 
