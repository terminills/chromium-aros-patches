+#endif  /* THIRD_PARTY_LIBEVENT_AROS_CONFIG_H_ */
diff --git a/third_party/libevent/aros/event-config.h b/third_party/libevent/aros/event-config.h
new file mode 100644
index 0000000000..df78e60bd3
--- /dev/null
+++ b/third_party/libevent/aros/event-config.h
@@ -0,0 +1,43 @@
