From c9ea11a5bff330f313337d71e0c36d0240f70ae9 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 10 Jul 2026 13:53:56 -0500
Subject: [PATCH 008/638] third_party/libevent: add an explicit AROS backend
 [chromium] [aros]

AI_PHASE: chromium-headless-bringup

AI_STATUS: done

ROOT_CAUSE: Chromium's bundled libevent selected generic POSIX configuration and signal/socket assumptions that do not match the AROS headers or bsdsocket lifecycle.

FIX_REASON: Add a pinned AROS libevent configuration and isolate the small socket and signal differences instead of pretending AROS is Linux or disabling event handling globally.

SCOPE: third_party/libevent build selection, AROS config headers, evutil socket handling, and signal setup.

VALIDATION: the headless_shell graph compiled the bundled libevent targets and progressed through Mojo and into the Skia graph.

RISK: low; changes are selected only for target_os=aros and retain libevent's existing event model.

AI_DECISION_CHAIN: ACD-chromium-native-port-roadmap
---
 third_party/libevent/BUILD.gn            |  7 +++
 third_party/libevent/aros/config.h       | 61 ++++++++++++++++++++++++
 third_party/libevent/aros/event-config.h | 43 +++++++++++++++++
 third_party/libevent/event-config.h      |  2 +
 third_party/libevent/evutil.c            |  9 +++-
 third_party/libevent/signal.c            |  8 ++++
 6 files changed, 129 insertions(+), 1 deletion(-)
 create mode 100644 third_party/libevent/aros/config.h
 create mode 100644 third_party/libevent/aros/event-config.h

diff --git a/third_party/libevent/BUILD.gn b/third_party/libevent/BUILD.gn
index 97ed48b38a..1e2f232861 100644
--- a/third_party/libevent/BUILD.gn
+++ b/third_party/libevent/BUILD.gn
@@ -51,6 +51,13 @@ static_library("libevent") {
       "epoll.c",
     ]
     include_dirs += [ "android" ]
+  } else if (is_aros) {
+    sources += [
+      "aros/config.h",
+      "aros/event-config.h",
+    ]
+    sources -= [ "poll.c" ]
+    include_dirs += [ "aros" ]
   }
 
   if (!is_debug) {
diff --git a/third_party/libevent/aros/config.h b/third_party/libevent/aros/config.h
new file mode 100644
index 0000000000..35ddda5bcf
--- /dev/null
+++ b/third_party/libevent/aros/config.h
@@ -0,0 +1,61 @@
