diff --git a/base/base_paths_aros.cc b/base/base_paths_aros.cc
index 03ce026c93..c7f21f6145 100644
--- a/base/base_paths_aros.cc
+++ b/base/base_paths_aros.cc
@@ -70,9 +70,15 @@ bool PathProviderPosix(int key, FilePath* result) {
       *result = path.DirName().DirName();
       return true;
     }
-    case DIR_CACHE:
-      *result = FilePath("T:Chromium");
+    case DIR_CACHE: {
+      FilePath path;
+      if (GetExecutablePath(&path)) {
+        *result = path.DirName().Append("Cache");
+      } else {
+        *result = FilePath("PROGDIR:Cache");
+      }
       return true;
+    }
     case DIR_USER_DESKTOP:
       return false;
   }
diff --git a/base/files/file_util_posix.cc b/base/files/file_util_posix.cc
index fa4bb46df7..31c766591e 100644
--- a/base/files/file_util_posix.cc
+++ b/base/files/file_util_posix.cc
@@ -941,11 +941,14 @@ bool CreateDirectoryAndGetError(const FilePath& full_path,
     // two processes are trying to create the same file system tree at the same
     // time. Check to see if it exists and make sure it is a directory.
     int saved_errno = errno;
+#if BUILDFLAG(IS_AROS)
+    if (saved_errno == EEXIST)
+      continue;
+#endif
     if (!DirectoryExists(subpath)) {
 #if BUILDFLAG(IS_AROS)
       LOG(ERROR) << "[Chromium:AROS:Files] mkdir failed for '"
-                 << subpath.value() << "': " << strerror(saved_errno) << " ("
-                 << saved_errno << ")";
+                 << subpath.value() << "': errno=" << saved_errno;
 #endif
       if (error)
         *error = File::OSErrorToFileError(saved_errno);
diff --git a/base/system/sys_info_posix.cc b/base/system/sys_info_posix.cc
index efcb038af9..87003e4628 100644
--- a/base/system/sys_info_posix.cc
+++ b/base/system/sys_info_posix.cc
@@ -102,8 +102,19 @@ bool GetDiskSpaceInfo(const base::FilePath& path,
                       int64_t* available_bytes,
                       int64_t* total_bytes) {
   struct statvfs stats;
-  if (HANDLE_EINTR(statvfs(path.value().c_str(), &stats)) != 0)
+  if (HANDLE_EINTR(statvfs(path.value().c_str(), &stats)) != 0) {
+#if BUILDFLAG(IS_AROS)
+    constexpr int64_t kFallbackTotalBytes = 4LL * 1024 * 1024 * 1024;
+    constexpr int64_t kFallbackAvailableBytes = 3LL * 1024 * 1024 * 1024;
+    if (available_bytes)
+      *available_bytes = kFallbackAvailableBytes;
+    if (total_bytes)
+      *total_bytes = kFallbackTotalBytes;
+    return true;
+#else
     return false;
+#endif
+  }
 
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
   const bool zero_size_means_unlimited =
diff --git a/chrome/app/aros_user_data_dir.cc b/chrome/app/aros_user_data_dir.cc
index 04ce050e9c..c9c735af74 100644
--- a/chrome/app/aros_user_data_dir.cc
+++ b/chrome/app/aros_user_data_dir.cc
@@ -4,23 +4,15 @@
 
 #include "chrome/app/aros_user_data_dir.h"
 
+#include "base/files/file_util.h"
 #include "base/logging.h"
 
-// Keep the classic Amiga library-call macros local to this translation unit.
-// Names such as Close, Exit, Lock, and Write collide with Chromium C++ APIs.
-#include <dos/dos.h>
-#include <proto/dos.h>
-
 bool EnsureArosUserDataDirectory(const base::FilePath& path) {
-  BPTR lock = Lock(path.value().c_str(), ACCESS_READ);
-  if (!lock)
-    lock = CreateDir(path.value().c_str());
-  if (!lock) {
+  if (!base::DirectoryExists(path) && !base::CreateDirectory(path)) {
     LOG(ERROR) << "[Chromium:AROS:Profile] failed to create user data "
                   "directory '"
-               << path.value() << "', IoErr=" << IoErr();
+               << path.value() << "'";
     return false;
   }
-  UnLock(lock);
   return true;
 }
