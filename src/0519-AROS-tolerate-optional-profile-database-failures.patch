+            user_data_dir_is_absolute, false);
+#else
     user_data_dir_override_succeeded =
         base::PathService::OverrideAndCreateIfNeeded(
             chrome::DIR_USER_DATA, user_data_dir,
             user_data_dir_is_absolute, true);
+#endif
 #if BUILDFLAG(IS_AROS)
     if (!user_data_dir_override_succeeded) {
       PLOG(ERROR) << "[Chromium:AROS:Profile] failed to create or override '"
