+#ifndef NET_BASE_NETWORK_CHANGE_NOTIFIER_AROS_H_
+#define NET_BASE_NETWORK_CHANGE_NOTIFIER_AROS_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "net/base/net_export.h"
+#include "net/base/network_change_notifier.h"
+
+namespace net {
+
+// Observes AROSTCP interface and DNS configuration by taking inexpensive,
+// asynchronous snapshots. AROSTCP does not expose a route-socket-style change
+// stream, so polling is the native truthful boundary rather than a passive
+// notifier that never reports changes.
+class NET_EXPORT_PRIVATE NetworkChangeNotifierAros
+    : public NetworkChangeNotifier {
+ public:
+  explicit NetworkChangeNotifierAros(ConnectionType initial_type);
+  NetworkChangeNotifierAros(const NetworkChangeNotifierAros&) = delete;
+  NetworkChangeNotifierAros& operator=(const NetworkChangeNotifierAros&) =
+      delete;
+  ~NetworkChangeNotifierAros() override;
+
+  ConnectionType GetCurrentConnectionType() const override;
+
+ private:
+  struct PollResult {
+    bool interfaces_valid = false;
+    bool dns_valid = false;
+    size_t interface_count = 0;
+    size_t dns_server_count = 0;
+    ConnectionType connection_type = CONNECTION_UNKNOWN;
+    std::string interface_fingerprint;
+    std::string dns_fingerprint;
+  };
+
+  static PollResult CaptureSnapshot();
+
+  void SchedulePoll(base::TimeDelta delay);
+  void Poll();
+  void OnPollResult(PollResult result);
+
+  mutable base::Lock connection_lock_;
+  ConnectionType connection_type_ GUARDED_BY(connection_lock_);
+
+  bool have_interface_snapshot_ = false;
+  bool have_dns_snapshot_ = false;
+  std::string interface_fingerprint_;
+  std::string dns_fingerprint_;
+
+  base::WeakPtrFactory<NetworkChangeNotifierAros> weak_factory_{this};
+};
+
+}  // namespace net
+
+#endif  // NET_BASE_NETWORK_CHANGE_NOTIFIER_AROS_H_
