diff --git a/net/base/network_change_notifier_aros.cc b/net/base/network_change_notifier_aros.cc
new file mode 100644
index 0000000000..1c34a26d2f
--- /dev/null
+++ b/net/base/network_change_notifier_aros.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/base/network_change_notifier_aros.h"
+
+#include <algorithm>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "base/aros/socket_library.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "net/base/ip_address.h"
+
+namespace net {
+
+namespace {
+
+constexpr base::TimeDelta kPollInterval = base::Seconds(2);
+
+template <typename T>
+void AppendValue(std::string* output, const T& value) {
+  output->append(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+
+void AppendString(std::string* output, const std::string& value) {
+  const size_t size = value.size();
+  AppendValue(output, size);
+  output->append(value);
+}
+
+void AppendInterface(std::string* output,
+                     const base::aros::NetworkInterfaceInfo& interface) {
+  AppendString(output, interface.name);
+  AppendValue(output, interface.index);
+  AppendValue(output, interface.flags);
+  AppendValue(output, interface.scope_id);
+  AppendValue(output, interface.family);
+  AppendValue(output, interface.address_length);
+  output->append(reinterpret_cast<const char*>(interface.address.data()),
+                 interface.address.size());
+  AppendValue(output, interface.has_netmask);
+  output->append(reinterpret_cast<const char*>(interface.netmask.data()),
+                 interface.netmask.size());
+  AppendValue(output, interface.is_up);
+  AppendValue(output, interface.is_running);
+  AppendValue(output, interface.is_loopback);
+}
+
+bool InterfaceLess(const base::aros::NetworkInterfaceInfo& left,
+                   const base::aros::NetworkInterfaceInfo& right) {
+  return std::tie(left.name, left.index, left.flags, left.scope_id, left.family,
+                  left.address_length, left.address, left.has_netmask,
+                  left.netmask, left.is_up, left.is_running, left.is_loopback) <
+         std::tie(right.name, right.index, right.flags, right.scope_id,
+                  right.family, right.address_length, right.address,
+                  right.has_netmask, right.netmask, right.is_up,
+                  right.is_running, right.is_loopback);
+}
+
+bool IsConnectedInterface(const base::aros::NetworkInterfaceInfo& interface) {
+  if (!interface.is_up || !interface.is_running || interface.is_loopback ||
+      interface.address_length == 0 ||
+      interface.address_length > interface.address.size()) {
+    return false;
+  }
+
+  const IPAddress address(
+      base::span(interface.address).first(interface.address_length));
+  return address.IsValid() && !address.IsZero() && !address.IsLoopback();
+}
+
+}  // namespace
+
+NetworkChangeNotifierAros::NetworkChangeNotifierAros(
+    ConnectionType initial_type)
+    : connection_type_(initial_type) {
+  SchedulePoll(base::TimeDelta());
+}
+
+NetworkChangeNotifierAros::~NetworkChangeNotifierAros() {
+  weak_factory_.InvalidateWeakPtrs();
+  ClearGlobalPointer();
+}
+
+NetworkChangeNotifier::ConnectionType
+NetworkChangeNotifierAros::GetCurrentConnectionType() const {
+  base::AutoLock lock(connection_lock_);
+  return connection_type_;
+}
+
+// static
+NetworkChangeNotifierAros::PollResult
+NetworkChangeNotifierAros::CaptureSnapshot() {
+  PollResult result;
+
+  std::vector<base::aros::NetworkInterfaceInfo> interfaces;
+  if (base::aros::GetNetworkInterfaces(&interfaces)) {
+    result.interfaces_valid = true;
+    result.interface_count = interfaces.size();
+    std::sort(interfaces.begin(), interfaces.end(), InterfaceLess);
+
+    bool connected = false;
+    for (const auto& interface : interfaces) {
+      AppendInterface(&result.interface_fingerprint, interface);
+      connected |= IsConnectedInterface(interface);
+    }
+    result.connection_type = connected ? CONNECTION_UNKNOWN : CONNECTION_NONE;
+  }
+
+  std::vector<std::string> name_servers;
+  if (base::aros::GetConfiguredNameServers(&name_servers)) {
+    result.dns_valid = true;
+    result.dns_server_count = name_servers.size();
+    std::sort(name_servers.begin(), name_servers.end());
+    for (const std::string& name_server : name_servers) {
+      AppendString(&result.dns_fingerprint, name_server);
+    }
+  }
+
+  return result;
+}
+
+void NetworkChangeNotifierAros::SchedulePoll(base::TimeDelta delay) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&NetworkChangeNotifierAros::Poll,
+                     weak_factory_.GetWeakPtr()),
+      delay);
+}
+
+void NetworkChangeNotifierAros::Poll() {
+  const bool posted = base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&NetworkChangeNotifierAros::CaptureSnapshot),
+      base::BindOnce(&NetworkChangeNotifierAros::OnPollResult,
+                     weak_factory_.GetWeakPtr()));
+  if (!posted) {
+    LOG(WARNING) << "[Chromium:AROS:NetworkChange] poll task rejected";
+  }
+}
+
+void NetworkChangeNotifierAros::OnPollResult(PollResult result) {
+  if (result.interfaces_valid) {
+    bool connection_type_changed = false;
+    {
+      base::AutoLock lock(connection_lock_);
+      connection_type_changed = connection_type_ != result.connection_type;
+      connection_type_ = result.connection_type;
+    }
+
+    if (!have_interface_snapshot_) {
+      LOG(INFO) << "[Chromium:AROS:NetworkChange] initialized interfaces="
+                << result.interface_count
+                << " connection_type=" << result.connection_type;
+      have_interface_snapshot_ = true;
+    } else if (interface_fingerprint_ != result.interface_fingerprint) {
+      LOG(INFO) << "[Chromium:AROS:NetworkChange] interfaces changed count="
+                << result.interface_count
+                << " connection_type=" << result.connection_type;
+      NotifyObserversOfIPAddressChange();
+      if (connection_type_changed) {
+        NotifyObserversOfConnectionTypeChange();
+      }
+    }
+    interface_fingerprint_ = std::move(result.interface_fingerprint);
+  } else {
+    LOG(WARNING) << "[Chromium:AROS:NetworkChange] interface snapshot failed";
+  }
+
+  if (result.dns_valid) {
+    if (!have_dns_snapshot_) {
+      LOG(INFO) << "[Chromium:AROS:NetworkChange] initialized dns_servers="
+                << result.dns_server_count;
+      have_dns_snapshot_ = true;
+    } else if (dns_fingerprint_ != result.dns_fingerprint) {
+      LOG(INFO) << "[Chromium:AROS:NetworkChange] DNS configuration changed";
+      NotifyObserversOfDNSChange();
+    }
+    dns_fingerprint_ = std::move(result.dns_fingerprint);
+  } else {
+    LOG(WARNING) << "[Chromium:AROS:NetworkChange] DNS snapshot failed";
+  }
+
+  SchedulePoll(kPollInterval);
+}
+
+}  // namespace net
