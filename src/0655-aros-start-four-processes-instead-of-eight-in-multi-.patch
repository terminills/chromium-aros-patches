From 886ef9705e33423e430e479f55eb4810970bd400 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Fri, 25 Sep 2026 13:39:48 -0500
Subject: [PATCH 655/689] aros: start four processes instead of eight in
 multi-process mode

Each Chromium child on AROS is a full copy of the executable plus a
physically backed heap pool, so every process that Linux Chrome takes for
granted costs about 1-2 GiB. On a 12 GiB guest the browser ran out of
memory before its first window.

On AROS, by default:
- no component updates (none of the components has an AROS build; the
  Widevine CDM is bundled). Each update was unpacked in its own Unzipper
  utility process, 2-4 of them at startup;
- no spare renderer kept warm for the next tab;
- the network service runs in the browser process, as on Android and as
  in --single-process.

12 GiB guest, 8 CPUs, --aros-multi-process: browser, GPU, storage and
renderer only, with 6.7 GiB free when the renderer starts (was eight
processes and 0.6 GiB), and the same frame rate.

Claude-Session: https://claude.ai/code/session_01QHhVavHvnUWcvCukPGJBkG
---
 chrome/app/chrome_main_delegate.cc        |  8 ++++++++
 content/public/common/content_features.cc | 17 +++++++++++++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index 12a24153cc..c13488bfc2 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -1363,6 +1363,14 @@ std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
     if (!command_line.HasSwitch(switches::kNoDefaultBrowserCheck))
       base::CommandLine::ForCurrentProcess()->AppendSwitch(
           switches::kNoDefaultBrowserCheck);
+    // No component updates on AROS: none of the downloadable components has
+    // an AROS build (the Widevine CDM is bundled), and each update is
+    // unpacked in its own utility process - a full copy of the executable
+    // plus its heap - which at startup cost 2-4 GiB of a 12 GiB machine
+    // before the first window was up.
+    if (!command_line.HasSwitch(switches::kDisableComponentUpdate))
+      base::CommandLine::ForCurrentProcess()->AppendSwitch(
+          switches::kDisableComponentUpdate);
   }
 #endif
 #if BUILDFLAG(IS_WIN)
diff --git a/content/public/common/content_features.cc b/content/public/common/content_features.cc
index edd84d4fdb..31a7f59118 100644
--- a/content/public/common/content_features.cc
+++ b/content/public/common/content_features.cc
@@ -609,9 +609,13 @@ BASE_FEATURE(kNavigationNetworkResponseQueue,
 );
 
 // If the network service is enabled, runs it in process.
+//
+// On by default on AROS, as on Android and for the same reason: a separate
+// network process costs a full copy of the executable plus its heap pool,
+// and AROS has no sandbox for it to run in anyway.
 BASE_FEATURE(kNetworkServiceInProcess,
              "NetworkServiceInProcess2",
-#if BUILDFLAG(IS_ANDROID)
+#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_AROS)
              base::FEATURE_ENABLED_BY_DEFAULT
 #else
              base::FEATURE_DISABLED_BY_DEFAULT
@@ -1071,9 +1075,18 @@ BASE_FEATURE(kDisableProcessReuse,
 // Controls whether SpareRenderProcessHostManager tries to always have a warm
 // spare renderer process around for the most recently requested BrowserContext.
 // This feature is only consulted in site-per-process mode.
+//
+// Off on AROS: a renderer process there is a full copy of the executable plus
+// a physically backed heap pool (about 2 GiB), so a warm spare is a second
+// renderer's worth of memory held for a tab that may never open.
 BASE_FEATURE(kSpareRendererForSitePerProcess,
              "SpareRendererForSitePerProcess",
-             base::FEATURE_ENABLED_BY_DEFAULT);
+#if BUILDFLAG(IS_AROS)
+             base::FEATURE_DISABLED_BY_DEFAULT
+#else
+             base::FEATURE_ENABLED_BY_DEFAULT
+#endif
+);
 
 // Controls whether site isolation should use origins instead of scheme and
 // eTLD+1.
