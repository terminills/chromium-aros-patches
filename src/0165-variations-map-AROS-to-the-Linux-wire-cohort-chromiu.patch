From aac3464b6c6a285a73cafdb9881bf1706b99a9b9 Mon Sep 17 00:00:00 2001
From: terminills <tdeters@gmail.com>
Date: Mon, 13 Jul 2026 21:28:28 -0500
Subject: [PATCH 165/638] variations: map AROS to the Linux wire cohort
 [chromium] [aros]

Statement: Chromium Variations needs an OS name for seed requests, but its wire schema has no AROS identifier.

Decision: Use the existing Linux desktop cohort for AROS, matching ClientFilterableState while preserving AROS as the native build identity.

Evidence: variations_service.cc stopped the content_shell build with #error Unknown platform.

Validation: ninja -C out/aros-windowed -j48 obj/components/variations/service/service/variations_service.o

Chain:; ACD-chromium-aros-browser-services
---
 components/variations/service/variations_service.cc | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/components/variations/service/variations_service.cc b/components/variations/service/variations_service.cc
index e7ba26ff72..1aedc86efe 100644
--- a/components/variations/service/variations_service.cc
+++ b/components/variations/service/variations_service.cc
@@ -99,9 +99,10 @@ std::string GetPlatformString() {
   return "android";
 #elif BUILDFLAG(IS_FUCHSIA)
   return "fuchsia";
-#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_BSD) || BUILDFLAG(IS_SOLARIS)
-  // Default BSD and SOLARIS to Linux to not break those builds, although these
-  // platforms are not officially supported by Chrome.
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_BSD) || BUILDFLAG(IS_SOLARIS) || \
+    BUILDFLAG(IS_AROS)
+  // The Variations wire protocol has no identifiers for these desktop
+  // targets. Use its Linux cohort without changing their native identities.
   return "linux";
 #else
 #error Unknown platform
